        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0a0b0c"
      }
    ]
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ]
  }
}
