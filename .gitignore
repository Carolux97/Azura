# ReXGlue SDK binaries (downloaded per machine, see README)
sdk/

# Your own game files and everything derived from them. None of this may ever be committed.
runtime/game/
runtime/generated/
# Link to the manifest of the build in runtime/game/, created by scripts/build.sh.
runtime/azura_manifest.toml
*.xex
*.iso
# GPU captures and frame dumps (they hold the game's shaders, textures and draw data).
captures/
*.gputrace

# Build output
runtime/out/
launcher/node_modules/
launcher/dist/
launcher/src-tauri/target/

# Run-time files
logs/
saves/
azura.toml
*.log

# macOS
.DS_Store

# Generated from the player's game by scripts/hle/gen_pm4_trace_hooks.py.
runtime/src/hle_gfx/*.gen.cpp
