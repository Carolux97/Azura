{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-amd64",
            "displayName": "Linux x86_64",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v3",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
                "CMAKE_SHARED_LINKER_FLAGS": "-L${sourceDir}/../sdk/compat/lib",
                "CMAKE_EXE_LINKER_FLAGS": "-L${sourceDir}/../sdk/compat/lib",
                "CMAKE_INCLUDE_PATH": "${sourceDir}/../sdk/compat/include",
                "CMAKE_LIBRARY_PATH": "${sourceDir}/../sdk/compat/lib",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_PREFIX_PATH": "${sourceDir}/../sdk/rexglue-0.10.0-linux-amd64/linux-amd64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-arm64",
            "displayName": "Linux ARM64",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_PREFIX_PATH": "${sourceDir}/../sdk/rexglue-0.10.0-linux-arm64/linux-arm64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "mac-arm64",
            "displayName": "macOS on Apple Silicon",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_DEFAULT_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_PREFIX_PATH": "${sourceDir}/../sdk/rexglue-0.10.0-mac-arm64/mac-arm64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "mac-arm64-sdk-source",
            "displayName": "macOS on Apple Silicon, ReXGlue SDK built from source",
            "description": "Builds the SDK from sdk/rexglue-0.10.0-src as part of the runtime, so its code can be traced and patched. Uses its own build folder.",
            "inherits": "mac-arm64",
            "binaryDir": "${sourceDir}/out/build/mac-arm64-sdk-source",
            "cacheVariables": {
                "REXSDK_DIR": "${sourceDir}/../sdk/rexglue-0.10.0-src"
            }
        },
        {
            "name": "linux-amd64-sdk-source",
            "displayName": "Linux x86_64, ReXGlue SDK built from source",
            "description": "Builds the SDK from sdk/rexglue-0.10.0-src as part of the runtime, so its code can be traced and patched. Uses its own build folder.",
            "inherits": "linux-amd64",
            "binaryDir": "${sourceDir}/out/build/linux-amd64-sdk-source",
            "cacheVariables": {
                "REXSDK_DIR": "${sourceDir}/../sdk/rexglue-0.10.0-src",
                "SDL_X11_XSCRNSAVER": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-amd64-debug",
            "configurePreset": "linux-amd64",
            "configuration": "Debug"
        },
        {
            "name": "linux-amd64-relwithdebinfo",
            "configurePreset": "linux-amd64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-amd64-release",
            "configurePreset": "linux-amd64",
            "configuration": "Release"
        },
        {
            "name": "linux-arm64-debug",
            "configurePreset": "linux-arm64",
            "configuration": "Debug"
        },
        {
            "name": "linux-arm64-relwithdebinfo",
            "configurePreset": "linux-arm64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64",
            "configuration": "Release"
        },
        {
            "name": "mac-arm64-debug",
            "configurePreset": "mac-arm64",
            "configuration": "Debug"
        },
        {
            "name": "mac-arm64-relwithdebinfo",
            "configurePreset": "mac-arm64",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "mac-arm64-release",
            "configurePreset": "mac-arm64",
            "configuration": "Release"
        },
        {
            "name": "mac-arm64-sdk-source-debug",
            "configurePreset": "mac-arm64-sdk-source",
            "configuration": "Debug"
        },
        {
            "name": "mac-arm64-sdk-source-relwithdebinfo",
            "configurePreset": "mac-arm64-sdk-source",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "mac-arm64-sdk-source-release",
            "configurePreset": "mac-arm64-sdk-source",
            "configuration": "Release"
        },
        {
            "name": "linux-amd64-sdk-source-debug",
            "configurePreset": "linux-amd64-sdk-source",
            "configuration": "Debug"
        },
        {
            "name": "linux-amd64-sdk-source-relwithdebinfo",
            "configurePreset": "linux-amd64-sdk-source",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "linux-amd64-sdk-source-release",
            "configurePreset": "linux-amd64-sdk-source",
            "configuration": "Release"
        }
    ]
}
