--- a/include/rex/perf/counter.h
+++ b/include/rex/perf/counter.h
@@ -49,6 +49,26 @@ enum class CounterId : uint16_t {
   kPipelineCacheHits,
   kPipelineCacheMisses,
 
+  // Host GPU (Vulkan backend): what one guest frame turns into on the host
+  kHostRenderPasses,      // Render passes begun (vkCmdBeginRenderPass, vkCmdBeginRendering)
+  kHostPipelineBarriers,  // vkCmdPipelineBarrier calls
+  kHostDispatches,        // Compute dispatches
+  kHostDraws,             // Host draws, including the ones the backend adds itself
+  kHostCopies,            // Buffer copies, buffer to image copies and image clears
+  kHostSubmissions,       // vkQueueSubmit calls
+  kHostGpuWaits,          // Times the command processor blocked until the host GPU finished
+  kHostGpuWaitUs,         // Time spent in those waits
+  kMemexportReadbacks,    // Draws whose memexport output was read back to guest memory
+  kResolves,              // Guest resolves (EDRAM to memory copies)
+  // Why the open render pass was ended (each ended pass adds to one of these)
+  kRenderPassEndsTargetChange,  // A draw to other render targets
+  kRenderPassEndsDrawBarriers,  // Barriers pending before a draw
+  kRenderPassEndsResolve,       // A guest resolve
+  kRenderPassEndsTransfer,      // Render target ownership transfers and resolve clears
+  kRenderPassEndsTextureLoad,   // Texture loading and untiling
+  kRenderPassEndsUpload,        // Guest memory uploads to the GPU
+  kRenderPassEndsOther,         // Anything else (swap, end of submission, queries...)
+
   kCount  // sentinel -- must be last
 };
 
