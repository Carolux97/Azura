@@ -0,0 +1,43 @@
+/**
+ * @file        graphics/metal/metal_shared_memory.h
+ * @brief       Guest physical memory as a Metal buffer, without copies on unified memory
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <rex/graphics/shared_memory.h>
+
+#import <Metal/Metal.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+
+class MetalSharedMemory : public SharedMemory {
+ public:
+  MetalSharedMemory(MetalCommandProcessor& command_processor, memory::Memory& memory);
+  ~MetalSharedMemory() override;
+
+  bool Initialize();
+  void Shutdown();
+
+  // The whole 512 MiB of guest physical memory. With unified memory the buffer is created over
+  // the guest memory itself, so the GPU reads what the guest wrote and the guest sees what the
+  // GPU wrote (resolves, memexport) with no upload or readback. With metal_shared_memory_copy, it
+  // is a separate GPU buffer that guest memory is copied into when a range is requested, as in
+  // the Vulkan backend.
+  id<MTLBuffer> buffer() const { return buffer_; }
+
+ protected:
+  bool UploadRanges(const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) override;
+
+ private:
+  MetalCommandProcessor& command_processor_;
+  id<MTLBuffer> buffer_ = nil;
+  bool copy_ = false;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_shared_memory.mm b/src/graphics/metal/metal_shared_memory.mm
new file mode 100644
index 0000000..b09177b
--- /dev/null
+++ b/src/graphics/metal/metal_shared_memory.mm
@@ -0,0 +1,110 @@
+/**
+ * @file        graphics/metal/metal_shared_memory.mm
+ * @brief       Guest physical memory as a Metal buffer, without copies on unified memory
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_shared_memory.h"
+
+#include <cstring>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/perf/counter.h>
+#include <rex/system/xmemory.h>
+
+#include "metal_command_processor.h"
+
+REXCVAR_DEFINE_BOOL(metal_shared_memory_copy, false, "GPU/Metal",
+                    "Copy guest memory into a separate GPU buffer when it is used, as the Vulkan "
+                    "backend does, instead of the GPU reading the guest memory directly")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::graphics::metal {
+
+MetalSharedMemory::MetalSharedMemory(MetalCommandProcessor& command_processor,
+                                     memory::Memory& memory)
+    : SharedMemory(memory), command_processor_(command_processor) {}
+
+MetalSharedMemory::~MetalSharedMemory() { Shutdown(); }
+
+bool MetalSharedMemory::Initialize() {
+  InitializeCommon();
+  id<MTLDevice> device = command_processor_.device();
+  if (!device.hasUnifiedMemory) {
+    REXGPU_ERROR("Metal: the shared memory needs a GPU with unified memory");
+    return false;
+  }
+  copy_ = REXCVAR_GET(metal_shared_memory_copy);
+  if (copy_) {
+    buffer_ = [device newBufferWithLength:kBufferSize options:MTLResourceStorageModePrivate];
+    if (!buffer_) {
+      REXGPU_ERROR("Metal: failed to create the shared memory buffer");
+      return false;
+    }
+    buffer_.label = @"Shared memory (copy)";
+    REXGPU_INFO("Metal: guest memory is copied into the GPU shared memory buffer");
+    return true;
+  }
+  void* guest_memory = memory().TranslatePhysical<void*>(0);
+  if (!guest_memory || (reinterpret_cast<uintptr_t>(guest_memory) & (getpagesize() - 1))) {
+    REXGPU_ERROR("Metal: guest physical memory is not page-aligned");
+    return false;
+  }
+  buffer_ = [device newBufferWithBytesNoCopy:guest_memory
+                                      length:kBufferSize
+                                     options:MTLResourceStorageModeShared |
+                                             MTLResourceHazardTrackingModeTracked
+                                 deallocator:nil];
+  if (!buffer_) {
+    REXGPU_ERROR("Metal: failed to create the shared memory buffer over the guest memory");
+    return false;
+  }
+  buffer_.label = @"Shared memory";
+  return true;
+}
+
+void MetalSharedMemory::Shutdown() {
+  buffer_ = nil;
+  ShutdownCommon();
+}
+
+bool MetalSharedMemory::UploadRanges(
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) {
+  if (!copy_) {
+    // Nothing to copy: the GPU reads the guest memory directly. Marking the pages valid keeps the
+    // invalidation watches (texture cache, shaders) working as with an uploaded copy.
+    for (const std::pair<uint32_t, uint32_t>& range : upload_page_ranges) {
+      MakeRangeValid(range.first << page_size_log2(), range.second << page_size_log2(), false);
+    }
+    return true;
+  }
+  // Snapshot the guest memory now into upload memory, and copy it into the buffer in order with
+  // the rest of the GPU work.
+  const uint8_t* guest_memory = memory().TranslatePhysical<const uint8_t*>(0);
+  for (const std::pair<uint32_t, uint32_t>& range : upload_page_ranges) {
+    size_t start = size_t(range.first) << page_size_log2();
+    size_t length = size_t(range.second) << page_size_log2();
+    MetalCommandProcessor::UploadAllocation upload =
+        command_processor_.RequestUpload(length, 16);
+    if (!upload.mapping) {
+      return false;
+    }
+    std::memcpy(upload.mapping, guest_memory + start, length);
+    id<MTLBlitCommandEncoder> blit =
+        command_processor_.GetBlitEncoder(rex::perf::CounterId::kRenderPassEndsUpload);
+    [blit copyFromBuffer:upload.buffer
+             sourceOffset:upload.offset
+                 toBuffer:buffer_
+        destinationOffset:start
+                     size:length];
+    PERF_counter_inc(kUploads);
+    PERF_counter_add(kUploadBytes, int64_t(length));
+    MakeRangeValid(uint32_t(start), uint32_t(length), false);
+  }
+  return true;
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_spirv.h b/src/graphics/metal/metal_spirv.h
new file mode 100644
index 0000000..a901193
--- /dev/null
+++ b/src/graphics/metal/metal_spirv.h
@@ -0,0 +1,75 @@
+/**
+ * @file        graphics/metal/metal_spirv.h
+ * @brief       SPIR-V to Metal Shading Language conversion for the Metal backend
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#ifdef __OBJC__
+#import <Metal/Metal.h>
+#endif
+
+namespace rex::graphics::metal {
+
+// Shaders are translated to SPIR-V by the same translators the Vulkan backend uses, and converted
+// to MSL with SPIRV-Cross when a pipeline is created. Vulkan descriptor sets and bindings are
+// mapped to Metal argument table indices with these entries.
+struct MslBinding {
+  enum class Kind : uint8_t { kBuffer, kTexture, kSampler };
+  // Descriptor set of the push constant block (SPIRV-Cross's ResourceBindingPushConstant
+  // DescriptorSet), bound as a buffer.
+  static constexpr uint32_t kPushConstantSet = ~uint32_t(0);
+  uint32_t set;
+  uint32_t binding;
+  Kind kind;
+  uint32_t index;
+};
+
+enum class MslStage : uint8_t { kVertex, kFragment, kCompute };
+
+struct MslShader {
+  std::string source;
+  // The entry point name in the MSL source (SPIRV-Cross renames "main" to "main0").
+  std::string entry_point;
+  // Compute only: threads per threadgroup from the SPIR-V LocalSize execution mode.
+  std::array<uint32_t, 3> threadgroup_size = {1, 1, 1};
+  // Whether the shader reads the sizes of its buffers from kMslBufferSizesIndex (for runtime
+  // array lengths).
+  bool needs_buffer_sizes = false;
+  // A preprocessor macro defined for the compilation (empty for none), which selects one of the
+  // entry points of a source that has alternatives.
+  std::string preprocessor_macro;
+};
+
+// Argument table index of SPIRV-Cross's buffer of buffer sizes, the same in every stage.
+constexpr uint32_t kMslBufferSizesIndex = 30;
+
+// Converts SPIR-V to MSL. Returns false and logs the reason on failure. A vertex function for a
+// pipeline without rasterization (only memory export side effects) must return void in Metal,
+// which disable_rasterization produces. A non-empty entry_point_name replaces SPIRV-Cross's
+// "main0", so GPU captures and the shader profiler of Metal traces tell the functions apart.
+bool SpirvToMsl(const uint32_t* words, size_t word_count, MslStage stage,
+                const std::vector<MslBinding>& bindings, MslShader& shader_out,
+                bool disable_rasterization = false, const std::string& entry_point_name = {});
+
+#ifdef __OBJC__
+// Compiles MSL source and returns the function named entry_point, or nil (logging the error).
+id<MTLFunction> CompileMslFunction(id<MTLDevice> device, const MslShader& shader,
+                                   const char* debug_name);
+// SPIR-V to a Metal compute pipeline state in one step, for the backend's own compute shaders.
+id<MTLComputePipelineState> CreateComputePipelineFromSpirv(
+    id<MTLDevice> device, const uint32_t* words, size_t word_count,
+    const std::vector<MslBinding>& bindings, const char* debug_name,
+    std::array<uint32_t, 3>* threadgroup_size_out = nullptr);
+#endif
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_spirv.mm b/src/graphics/metal/metal_spirv.mm
new file mode 100644
index 0000000..c2d1f96
--- /dev/null
+++ b/src/graphics/metal/metal_spirv.mm
@@ -0,0 +1,208 @@
+/**
+ * @file        graphics/metal/metal_spirv.mm
+ * @brief       SPIR-V to Metal Shading Language conversion for the Metal backend
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_spirv.h"
+
+// SPIRV-Cross ships its own spirv.hpp in the spv namespace, so this file includes nothing that
+// pulls the SPIR-V headers of glslang or SPIRV-Tools.
+#include <spirv_msl.hpp>
+
+#include <cctype>
+#include <filesystem>
+#include <fstream>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_STRING(metal_shader_dump_path, "", "GPU",
+                      "Folder to write the MSL source of every shader the Metal backend compiles "
+                      "to, one file per function (profiling and debugging)");
+
+namespace rex::graphics::metal {
+
+namespace {
+
+// A Metal function name from a debug name: letters, digits and underscores only.
+std::string GetFunctionName(const char* prefix, const char* debug_name) {
+  std::string name = prefix;
+  for (const char* c = debug_name; c && *c; ++c) {
+    name += std::isalnum(static_cast<unsigned char>(*c)) ? *c : '_';
+  }
+  return name;
+}
+
+// Writes the MSL source to metal_shader_dump_path, if it is set, as <entry point>.metal.
+void DumpMsl(const MslShader& shader) {
+  std::string dump_path = REXCVAR_GET(metal_shader_dump_path);
+  if (dump_path.empty()) {
+    return;
+  }
+  std::error_code error;
+  std::filesystem::create_directories(dump_path, error);
+  std::filesystem::path file_path =
+      std::filesystem::path(dump_path) / (shader.entry_point + ".metal");
+  if (std::filesystem::exists(file_path, error)) {
+    return;
+  }
+  std::ofstream file(file_path);
+  file << shader.source;
+}
+
+spv::ExecutionModel GetExecutionModel(MslStage stage) {
+  switch (stage) {
+    case MslStage::kVertex:
+      return spv::ExecutionModelVertex;
+    case MslStage::kFragment:
+      return spv::ExecutionModelFragment;
+    case MslStage::kCompute:
+      return spv::ExecutionModelGLCompute;
+  }
+  return spv::ExecutionModelGLCompute;
+}
+
+}  // namespace
+
+bool SpirvToMsl(const uint32_t* words, size_t word_count, MslStage stage,
+                const std::vector<MslBinding>& bindings, MslShader& shader_out,
+                bool disable_rasterization, const std::string& entry_point_name) {
+  try {
+    SPIRV_CROSS_NAMESPACE::CompilerMSL compiler(words, word_count);
+
+    SPIRV_CROSS_NAMESPACE::CompilerMSL::Options options = compiler.get_msl_options();
+    options.platform = SPIRV_CROSS_NAMESPACE::CompilerMSL::Options::macOS;
+    options.set_msl_version(3, 0);
+    options.argument_buffers = false;
+    // Guest shaders index the shared memory as one large buffer of uints.
+    options.enable_decoration_binding = false;
+    options.force_native_arrays = false;
+    // Point size must be written for point primitives only; the translator writes it when needed.
+    options.enable_point_size_builtin = true;
+    // Texel buffers (the gamma ramps) as Metal texture buffers.
+    options.texture_buffer_native = true;
+    options.disable_rasterization = disable_rasterization && stage == MslStage::kVertex;
+    options.buffer_size_buffer_index = kMslBufferSizesIndex;
+    // All SPIR-V here follows Vulkan clip space, where -Y is the top of the framebuffer; in Metal
+    // +Y is, so vertex positions are flipped (as MoltenVK does) and window coordinates, face
+    // winding and everything computed from the viewport stay the same as in the Vulkan backend.
+    compiler.set_msl_options(options);
+    SPIRV_CROSS_NAMESPACE::CompilerGLSL::Options common_options = compiler.get_common_options();
+    common_options.vertex.flip_vert_y = stage == MslStage::kVertex;
+    compiler.set_common_options(common_options);
+
+    spv::ExecutionModel model = GetExecutionModel(stage);
+    if (!entry_point_name.empty()) {
+      auto original_entry_points = compiler.get_entry_points_and_stages();
+      if (!original_entry_points.empty()) {
+        compiler.rename_entry_point(original_entry_points[0].name, entry_point_name,
+                                    original_entry_points[0].execution_model);
+      }
+    }
+    for (const MslBinding& binding : bindings) {
+      SPIRV_CROSS_NAMESPACE::MSLResourceBinding resource_binding;
+      resource_binding.stage = model;
+      resource_binding.desc_set = binding.set;
+      resource_binding.binding = binding.set == MslBinding::kPushConstantSet
+                                     ? SPIRV_CROSS_NAMESPACE::ResourceBindingPushConstantBinding
+                                     : binding.binding;
+      resource_binding.count = 1;
+      switch (binding.kind) {
+        case MslBinding::Kind::kBuffer:
+          resource_binding.msl_buffer = binding.index;
+          break;
+        case MslBinding::Kind::kTexture:
+          resource_binding.msl_texture = binding.index;
+          break;
+        case MslBinding::Kind::kSampler:
+          resource_binding.msl_sampler = binding.index;
+          break;
+      }
+      compiler.add_msl_resource_binding(resource_binding);
+    }
+
+    static_assert(MslBinding::kPushConstantSet ==
+                  SPIRV_CROSS_NAMESPACE::ResourceBindingPushConstantDescriptorSet);
+    shader_out.source = compiler.compile();
+    shader_out.needs_buffer_sizes = compiler.needs_buffer_size_buffer();
+
+    auto entry_points = compiler.get_entry_points_and_stages();
+    if (entry_points.empty()) {
+      REXGPU_ERROR("Metal: SPIR-V module has no entry point");
+      return false;
+    }
+    shader_out.entry_point =
+        compiler.get_cleansed_entry_point_name(entry_points[0].name, entry_points[0].execution_model);
+
+    if (stage == MslStage::kCompute) {
+      for (uint32_t i = 0; i < 3; ++i) {
+        uint32_t size = compiler.get_execution_mode_argument(spv::ExecutionModeLocalSize, i);
+        shader_out.threadgroup_size[i] = size ? size : 1;
+      }
+    }
+    return true;
+  } catch (const std::exception& e) {
+    REXGPU_ERROR("Metal: SPIR-V to MSL conversion failed: {}", e.what());
+    return false;
+  }
+}
+
+id<MTLFunction> CompileMslFunction(id<MTLDevice> device, const MslShader& shader,
+                                   const char* debug_name) {
+  DumpMsl(shader);
+  MTLCompileOptions* options = [MTLCompileOptions new];
+  options.languageVersion = MTLLanguageVersion3_0;
+  options.mathMode = MTLMathModeSafe;
+  if (!shader.preprocessor_macro.empty()) {
+    options.preprocessorMacros = @{@(shader.preprocessor_macro.c_str()) : @"1"};
+  }
+  NSError* error = nil;
+  id<MTLLibrary> library = [device newLibraryWithSource:@(shader.source.c_str())
+                                                options:options
+                                                  error:&error];
+  if (!library) {
+    REXGPU_ERROR("Metal: failed to compile MSL for {}: {}", debug_name ? debug_name : "shader",
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+    REXGPU_DEBUG("Metal: MSL source of {}:\n{}", debug_name ? debug_name : "shader",
+                 shader.source);
+    return nil;
+  }
+  id<MTLFunction> function = [library newFunctionWithName:@(shader.entry_point.c_str())];
+  if (!function) {
+    REXGPU_ERROR("Metal: entry point {} missing in {}", shader.entry_point,
+                 debug_name ? debug_name : "shader");
+  }
+  return function;
+}
+
+id<MTLComputePipelineState> CreateComputePipelineFromSpirv(
+    id<MTLDevice> device, const uint32_t* words, size_t word_count,
+    const std::vector<MslBinding>& bindings, const char* debug_name,
+    std::array<uint32_t, 3>* threadgroup_size_out) {
+  MslShader shader;
+  if (!SpirvToMsl(words, word_count, MslStage::kCompute, bindings, shader, false,
+                  GetFunctionName("cs_", debug_name))) {
+    return nil;
+  }
+  id<MTLFunction> function = CompileMslFunction(device, shader, debug_name);
+  if (!function) {
+    return nil;
+  }
+  NSError* error = nil;
+  id<MTLComputePipelineState> pipeline = [device newComputePipelineStateWithFunction:function
+                                                                               error:&error];
+  if (!pipeline) {
+    REXGPU_ERROR("Metal: failed to create the {} compute pipeline: {}", debug_name,
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+    return nil;
+  }
+  if (threadgroup_size_out) {
+    *threadgroup_size_out = shader.threadgroup_size;
+  }
+  return pipeline;
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_texture_cache.h b/src/graphics/metal/metal_texture_cache.h
new file mode 100644
index 0000000..030fb39
--- /dev/null
+++ b/src/graphics/metal/metal_texture_cache.h
@@ -0,0 +1,309 @@
+/**
+ * @file        graphics/metal/metal_texture_cache.h
+ * @brief       Guest textures as Metal textures, loaded from the shared memory with compute shaders
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <functional>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+
+#include <rex/graphics/pipeline/shader/spirv.h>
+#include <rex/graphics/pipeline/texture/cache.h>
+
+#import <Metal/Metal.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+class MetalSharedMemory;
+
+// Same model as the Vulkan texture cache: guest texture data is untiled and converted into a
+// scratch buffer by the texture_load compute shaders (the same SPIR-V, converted to MSL), then
+// copied into the texture with a blit. Formats, swizzles and samplers follow the Vulkan backend
+// so both render the same; Apple GPUs sample every 16-bit normalized format with filtering, so the
+// float16 fallbacks of the Vulkan backend are not needed.
+class MetalTextureCache final : public TextureCache {
+ public:
+  // Sampler parameters that map directly to a host sampler.
+  union SamplerParameters {
+    uint32_t value;
+    struct {
+      xenos::ClampMode clamp_x : 3;         // 3
+      xenos::ClampMode clamp_y : 3;         // 6
+      xenos::ClampMode clamp_z : 3;         // 9
+      xenos::BorderColor border_color : 2;  // 11
+      uint32_t mag_linear : 1;              // 12
+      uint32_t min_linear : 1;              // 13
+      uint32_t mip_linear : 1;              // 14
+      xenos::AnisoFilter aniso_filter : 3;  // 17
+      uint32_t mip_min_level : 4;           // 21
+      uint32_t mip_base_map : 1;            // 22
+    };
+
+    SamplerParameters() : value(0) { static_assert_size(*this, sizeof(value)); }
+    bool operator==(const SamplerParameters& parameters) const { return value == parameters.value; }
+    bool operator!=(const SamplerParameters& parameters) const { return value != parameters.value; }
+  };
+
+  static std::unique_ptr<MetalTextureCache> Create(const RegisterFile& register_file,
+                                                   MetalSharedMemory& shared_memory,
+                                                   DrawResolutionScale draw_resolution_scale,
+                                                   MetalCommandProcessor& command_processor);
+  ~MetalTextureCache();
+
+  void BeginFrame() override;
+  void EndFrame();
+
+  // Creates and loads the textures the shaders of a draw use. Loading encodes compute and blit
+  // work, so this must be called before the draw's render pass is entered.
+  void RequestTextures(uint32_t used_texture_mask) override;
+
+  // The texture to bind for a texture binding of a guest shader, or a null texture of the needed
+  // type (reads as zero, as a null descriptor in Direct3D 12).
+  id<MTLTexture> GetActiveBindingOrNullTexture(uint32_t fetch_constant_index,
+                                               xenos::FetchOpDimension dimension, bool is_signed);
+
+  SamplerParameters GetSamplerParameters(const SpirvShader::SamplerBinding& binding) const;
+  id<MTLSamplerState> GetSampler(SamplerParameters parameters);
+
+  // The front buffer as a 2D texture with the guest swizzle applied, loading it if needed, or nil.
+  // The size is in host texels (with the draw resolution scale for a resolved front buffer) and in
+  // guest texels.
+  id<MTLTexture> RequestSwapTexture(uint32_t& width_scaled_out, uint32_t& height_scaled_out,
+                                    uint32_t& width_unscaled_out, uint32_t& height_unscaled_out,
+                                    xenos::TextureFormat& format_out);
+
+  // The range of the scaled resolve buffer holding a range of the guest memory, with the length
+  // aligned to 1 << length_scaled_alignment_log2; false if not drawing at a resolution scale or the
+  // range is outside the buffer.
+  bool GetScaledResolveRange(uint32_t start_unscaled, uint32_t length_unscaled,
+                             uint32_t length_scaled_alignment_log2, uint64_t& start_scaled_out,
+                             uint64_t& length_scaled_out) const;
+  // Resolves write here instead of the shared memory when drawing at a whole resolution scale: each
+  // byte of the guest memory has draw_resolution_scale_x * draw_resolution_scale_y bytes here. Only
+  // the pages written or read are backed by physical memory (see InitializeScaledResolveBuffer).
+  // nil at a rational scale, which uses the scaled surfaces below.
+  id<MTLBuffer> scaled_resolve_buffer() const { return scaled_resolve_buffer_; }
+
+  // At a rational draw resolution scale (3/2), where a guest byte has no whole number of bytes for
+  // the scaled resolve buffer's layout, a resolve that a texture may sample at the scale writes its
+  // rectangle at the host resolution to a surface of its own: laid out as a guest texture of the
+  // host size would be (tiled, the resolve's format and endianness), so the unscaled load shaders
+  // read it as such a texture. One surface per destination address, the latest resolve's.
+  // Returns the surface buffer for a resolve of width x height guest pixels (multiples of 8), made
+  // or resized as needed, and its row pitch in host texels (aligned to 32 for the tiling).
+  id<MTLBuffer> RequestRationalScaledSurface(uint32_t dest_base, uint32_t width, uint32_t height,
+                                             uint32_t bytes_per_texel, uint32_t& pitch_out);
+  // A resolve to the address that will not have a scaled surface (one textures load at the guest
+  // resolution): the older surface there is dropped.
+  void DropRationalScaledSurface(uint32_t dest_base) { rational_scaled_surfaces_.erase(dest_base); }
+
+  // gfx = hle: right after a resolve invalidated its destination, for each texture the cache holds
+  // whose base level is exactly the resolve's destination (2D, tiled, one level not in a packed
+  // mip tail, the resolve's size, at the scale when scaled, and a format the direct loads take),
+  // calls write with an integer view of it, its endianness and its load's conversion (see
+  // GetDirectLoad), for the resolve to write the texture as a load from memory would, and marks it
+  // up to date, so it is not loaded back. With metal_texture_load_verify, write gets a texture of
+  // its own instead, compared with the texture's next load from memory. Returns the textures
+  // written.
+  // metal_texture_load_verify: a resolve to dest_base is about to write the memory, so the checks
+  // of what earlier resolves wrote for the textures there no longer apply (their next load reads
+  // this one's data). Called for every resolve; WriteTexturesFromResolve adds its own afterwards.
+  void ForgetResolveTextureChecks(uint32_t dest_base);
+  using ResolveTextureWriter =
+      std::function<void(id<MTLTexture> view, uint32_t endian, uint32_t conversion)>;
+  uint32_t WriteTexturesFromResolve(uint32_t dest_base, uint32_t width, uint32_t height,
+                                    bool scaled, const ResolveTextureWriter& write);
+
+ protected:
+  bool IsSignedVersionSeparateForFormat(TextureKey key) const override;
+  bool IsScaledResolveSupportedForFormat(TextureKey key) const override;
+  uint32_t GetHostFormatSwizzle(TextureKey key) const override;
+
+  uint32_t GetMaxHostTextureWidthHeight(xenos::DataDimension dimension) const override;
+  uint32_t GetMaxHostTextureDepthOrArraySize(xenos::DataDimension dimension) const override;
+
+  std::unique_ptr<Texture> CreateTexture(TextureKey key) override;
+
+  bool LoadTextureDataFromResidentMemoryImpl(Texture& texture, bool load_base,
+                                             bool load_mips) override;
+
+  void UpdateTextureBindingsImpl(uint32_t fetch_constant_mask) override;
+
+  bool EnsureScaledResolveMemoryCommitted(uint32_t start_unscaled, uint32_t length_unscaled,
+                                          uint32_t length_scaled_alignment_log2 = 0) override;
+
+ private:
+  bool InitializeScaledResolveBuffer();
+  void ShutdownScaledResolveBuffer();
+
+  struct HostFormat {
+    LoadShaderIndex load_shader;
+    // Only formats that are sampled as floating-point (normalized or float), as in the Vulkan
+    // backend: guest shaders sample, they never fetch integers.
+    MTLPixelFormat format;
+    // Whether the host format is block-compressed with the guest block size (not decompressed).
+    bool block_compressed;
+    // Set up at initialization from what the device can filter.
+    bool linear_filterable;
+  };
+
+  struct HostFormatPair {
+    HostFormat format_unsigned;
+    HostFormat format_signed;
+    // Mapping of Xenos swizzle components to host format components.
+    uint32_t swizzle;
+    // Whether the unsigned and the signed formats can be views of the same texture data.
+    bool unsigned_signed_compatible;
+  };
+
+  class MetalTexture final : public Texture {
+   public:
+    MetalTexture(MetalTextureCache& texture_cache, const TextureKey& key, id<MTLTexture> texture,
+                 bool track_usage = true);
+    ~MetalTexture();
+
+    id<MTLTexture> texture() const { return texture_; }
+
+    // A view with the format of the signedness and the host swizzle; 1D and 2D textures are 2D
+    // arrays for guest shaders, a single 2D slice when is_array is false.
+    id<MTLTexture> GetView(bool is_signed, uint32_t host_swizzle, bool is_array = true);
+    // A 2D wrapper of a 3D texture for guest shaders fetching it as 2D (gpu_3d_to_2d_texture).
+    id<MTLTexture> GetOrCreate3DAs2DView(bool is_signed, uint32_t host_swizzle);
+
+   private:
+    id<MTLTexture> texture_;
+    // Key: is_signed_separate_view (1 bit), host_swizzle (12 bits), is_array (1 bit).
+    std::unordered_map<uint32_t, id<MTLTexture>> views_;
+    std::unique_ptr<MetalTexture> texture_3d_as_2d_;
+  };
+
+  struct MetalTextureBinding {
+    id<MTLTexture> texture_unsigned = nil;
+    id<MTLTexture> texture_signed = nil;
+    void Reset() {
+      texture_unsigned = nil;
+      texture_signed = nil;
+    }
+  };
+
+  static constexpr bool AreDimensionsCompatible(xenos::FetchOpDimension binding_dimension,
+                                                xenos::DataDimension resource_dimension) {
+    switch (binding_dimension) {
+      case xenos::FetchOpDimension::k1D:
+      case xenos::FetchOpDimension::k2D:
+        return resource_dimension == xenos::DataDimension::k1D ||
+               resource_dimension == xenos::DataDimension::k2DOrStacked ||
+               resource_dimension == xenos::DataDimension::k3D;
+      case xenos::FetchOpDimension::k3DOrStacked:
+        return resource_dimension == xenos::DataDimension::k3D;
+      case xenos::FetchOpDimension::kCube:
+        return resource_dimension == xenos::DataDimension::kCube;
+      default:
+        return false;
+    }
+  }
+
+  MetalTextureCache(const RegisterFile& register_file, MetalSharedMemory& shared_memory,
+                    DrawResolutionScale draw_resolution_scale,
+                    MetalCommandProcessor& command_processor);
+
+  bool Initialize();
+
+  const HostFormatPair& GetHostFormatPair(TextureKey key) const;
+  xenos::ClampMode NormalizeClampMode(xenos::ClampMode clamp_mode) const;
+  id<MTLTexture> CreateNullTexture(MTLTextureType type, const char* label);
+
+  MetalCommandProcessor& command_processor_;
+
+  // metal_texture_load_verify: for each texture a resolve wrote (WriteTexturesFromResolve), the
+  // texture it wrote instead, compared with the texture's next load from memory.
+  struct ResolveTextureCheck {
+    id<MTLTexture> texture;
+    uint32_t dwords_log2;
+  };
+  std::unordered_map<const Texture*, ResolveTextureCheck> resolve_texture_checks_;
+  // The load shader of a texture's host format.
+  LoadShaderIndex GetLoadShader(TextureKey key) const;
+
+  static const HostFormatPair kBestHostFormats[64];
+  static const HostFormatPair kHostFormatGBGRUnaligned;
+  static const HostFormatPair kHostFormatBGRGUnaligned;
+  static const HostFormatPair kHostFormatDXT1Unaligned;
+  static const HostFormatPair kHostFormatDXT2_3Unaligned;
+  static const HostFormatPair kHostFormatDXT4_5Unaligned;
+  static const HostFormatPair kHostFormatDXNUnaligned;
+  static const HostFormatPair kHostFormatDXT5AUnaligned;
+  HostFormatPair host_formats_[64];
+
+  struct LoadPipeline {
+    id<MTLComputePipelineState> pipeline = nil;
+    MTLSize threads_per_threadgroup = {1, 1, 1};
+  };
+  // Loading straight into the texture (metal_texture_load_direct, kTextureLoadDirectShaderSource),
+  // without the load shaders' scratch buffer and the copy from it: the formats a texel is copied
+  // bitwise for (32, 64 and 128 bits per block) and the two depth formats, in 2D textures.
+  LoadPipeline direct_load_pipeline_;
+  // metal_texture_load_verify: compares a direct load with the usual one.
+  LoadPipeline direct_load_compare_pipeline_;
+  // The texel size of a direct load, log2 of dwords (0 to 2), and its conversion (0 bitwise, 1
+  // 24-bit unorm depth, 2 20e4 float depth), for a load shader that has one; false otherwise.
+  static bool GetDirectLoad(LoadShaderIndex load_shader, uint32_t& dwords_log2_out,
+                            uint32_t& conversion_out);
+  // metal_texture_load_verify: compares a level and slice of a texture loaded directly with the
+  // same one loaded the usual way (into reference), and logs the first mismatch of each kind.
+  void CompareDirectLoad(const TextureKey& key, id<MTLTexture> direct, id<MTLTexture> reference,
+                         uint32_t dwords_log2, uint32_t level, uint32_t slice,
+                         const char* what = "Direct texture load check");
+  std::array<LoadPipeline, kLoadShaderCount> load_pipelines_{};
+  // Variants reading the scaled resolve buffer, for the shaders that have one.
+  std::array<LoadPipeline, kLoadShaderCount> load_pipelines_scaled_{};
+
+  // The surfaces of RequestRationalScaledSurface, by destination address. The guest size is the
+  // resolve's; a texture is loaded from the surface only with exactly that size and as many bytes
