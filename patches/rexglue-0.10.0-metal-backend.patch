+MetalTextureCache::~MetalTextureCache() {
+  // Textures refer to this object in their destructors.
+  DestroyAllTextures(true);
+  samplers_.clear();
+  ShutdownScaledResolveBuffer();
+}
+
+bool MetalTextureCache::InitializeScaledResolveBuffer() {
+  assert_true(IsDrawResolutionScaled());
+  // 512 MB of guest memory times the scale area: 2 GB at 2x2, 4.5 GB at 3x3. Reserving the virtual
+  // memory commits nothing; the GPU and the kernel back a page with physical memory the first time
+  // a resolve or a texture load touches it, so only the render to texture targets of the game cost
+  // memory (measured: a 4.5 GB buffer stays at no footprint until written, and writing over 64 MB
+  // of it adds about that much).
+  uint64_t scale_area = uint64_t(draw_resolution_scale_x()) * draw_resolution_scale_y();
+  scaled_resolve_buffer_size_ = uint64_t(SharedMemory::kBufferSize) * scale_area;
+  id<MTLDevice> device = command_processor_.device();
+  if (scaled_resolve_buffer_size_ > device.maxBufferLength) {
+    REXGPU_ERROR("MetalTextureCache: the scaled resolve buffer ({} MB) exceeds the largest Metal "
+                 "buffer ({} MB)",
+                 scaled_resolve_buffer_size_ >> 20, uint64_t(device.maxBufferLength) >> 20);
+    scaled_resolve_buffer_size_ = 0;
+    return false;
+  }
+  void* memory = mmap(nullptr, size_t(scaled_resolve_buffer_size_), PROT_READ | PROT_WRITE,
+                      MAP_PRIVATE | MAP_ANON, -1, 0);
+  if (memory == MAP_FAILED) {
+    REXGPU_ERROR("MetalTextureCache: failed to reserve {} MB for the scaled resolve buffer",
+                 scaled_resolve_buffer_size_ >> 20);
+    scaled_resolve_buffer_size_ = 0;
+    return false;
+  }
+  scaled_resolve_memory_ = memory;
+  scaled_resolve_buffer_ = [device newBufferWithBytesNoCopy:memory
+                                                     length:NSUInteger(scaled_resolve_buffer_size_)
+                                                    options:MTLResourceStorageModeShared |
+                                                            MTLResourceHazardTrackingModeTracked
+                                                deallocator:nil];
+  if (!scaled_resolve_buffer_) {
+    REXGPU_ERROR("MetalTextureCache: failed to create the scaled resolve buffer");
+    ShutdownScaledResolveBuffer();
+    return false;
+  }
+  scaled_resolve_buffer_.label = @"Scaled resolve";
+  REXGPU_INFO("Metal: drawing at {}x{} the guest resolution, {} MB reserved for scaled resolves",
+              draw_resolution_scale_x(), draw_resolution_scale_y(),
+              scaled_resolve_buffer_size_ >> 20);
+  return true;
+}
+
+void MetalTextureCache::ShutdownScaledResolveBuffer() {
+  scaled_resolve_buffer_ = nil;
+  if (scaled_resolve_memory_) {
+    munmap(scaled_resolve_memory_, size_t(scaled_resolve_buffer_size_));
+    scaled_resolve_memory_ = nullptr;
+  }
+  scaled_resolve_buffer_size_ = 0;
+}
+
+bool MetalTextureCache::GetScaledResolveRange(uint32_t start_unscaled, uint32_t length_unscaled,
+                                              uint32_t length_scaled_alignment_log2,
+                                              uint64_t& start_scaled_out,
+                                              uint64_t& length_scaled_out) const {
+  // The scaled resolve buffer exists at whole scales only.
+  if (!IsDrawResolutionScaled() || !draw_resolution_scale().IsWhole()) {
+    return false;
+  }
+  if (length_unscaled == 0) {
+    start_scaled_out = 0;
+    length_scaled_out = 0;
+    return true;
+  }
+  if (start_unscaled > SharedMemory::kBufferSize ||
+      (SharedMemory::kBufferSize - start_unscaled) < length_unscaled) {
+    return false;
+  }
+  uint64_t scale_area = uint64_t(draw_resolution_scale_x()) * draw_resolution_scale_y();
+  uint64_t start_scaled = uint64_t(start_unscaled) * scale_area;
+  uint64_t length_scaled = rex::align(uint64_t(length_unscaled) * scale_area,
+                                      uint64_t(1) << length_scaled_alignment_log2);
+  if (start_scaled > scaled_resolve_buffer_size_ ||
+      length_scaled > scaled_resolve_buffer_size_ - start_scaled) {
+    return false;
+  }
+  start_scaled_out = start_scaled;
+  length_scaled_out = length_scaled;
+  return true;
+}
+
+bool MetalTextureCache::EnsureScaledResolveMemoryCommitted(uint32_t start_unscaled,
+                                                           uint32_t length_unscaled,
+                                                           uint32_t length_scaled_alignment_log2) {
+  // At a rational scale, textures load from the scaled surfaces, whole buffers made by the resolve.
+  if (!draw_resolution_scale().IsWhole()) {
+    return true;
+  }
+  // The whole buffer is mapped, the pages get physical memory on first use: only the range needs
+  // to be within the buffer.
+  uint64_t start_scaled, length_scaled;
+  return scaled_resolve_buffer_ &&
+         GetScaledResolveRange(start_unscaled, length_unscaled, length_scaled_alignment_log2,
+                               start_scaled, length_scaled);
+}
+
+bool MetalTextureCache::GetDirectLoad(LoadShaderIndex load_shader, uint32_t& dwords_log2_out,
+                                      uint32_t& conversion_out) {
+  conversion_out = 0;
+  switch (load_shader) {
+    case kLoadShaderIndex32bpb:
+      dwords_log2_out = 0;
+      return true;
+    case kLoadShaderIndex64bpb:
+      dwords_log2_out = 1;
+      return true;
+    case kLoadShaderIndex128bpb:
+      dwords_log2_out = 2;
+      return true;
+    case kLoadShaderIndexDepthUnorm:
+      dwords_log2_out = 0;
+      conversion_out = 1;
+      return true;
+    case kLoadShaderIndexDepthFloat:
+      dwords_log2_out = 0;
+      conversion_out = 2;
+      return true;
+    default:
+      return false;
+  }
+}
+
+void MetalTextureCache::CompareDirectLoad(const TextureKey& key, id<MTLTexture> direct,
+                                          id<MTLTexture> reference, uint32_t dwords_log2,
+                                          uint32_t level, uint32_t slice, const char* what_kind) {
+  static const MTLPixelFormat kViewFormats[] = {MTLPixelFormatR32Uint, MTLPixelFormatRG32Uint,
+                                                MTLPixelFormatRGBA32Uint};
+  NSRange levels = NSMakeRange(level, 1), slices = NSMakeRange(slice, 1);
+  id<MTLTexture> direct_view = [direct newTextureViewWithPixelFormat:kViewFormats[dwords_log2]
+                                                         textureType:MTLTextureType2D
+                                                              levels:levels
+                                                              slices:slices];
+  id<MTLTexture> reference_view =
+      [reference newTextureViewWithPixelFormat:kViewFormats[dwords_log2]
+                                   textureType:MTLTextureType2D
+                                        levels:levels
+                                        slices:slices];
+  id<MTLBuffer> result = [command_processor_.device() newBufferWithLength:8 * sizeof(uint32_t)
+                                                                  options:MTLResourceStorageModeShared];
+  std::memset(result.contents, 0, result.length);
+  id<MTLComputeCommandEncoder> compute =
+      command_processor_.GetComputeEncoder(rex::perf::CounterId::kRenderPassEndsTextureLoad);
+  [compute setComputePipelineState:direct_load_compare_pipeline_.pipeline];
+  [compute setTexture:direct_view atIndex:0];
+  [compute setTexture:reference_view atIndex:1];
+  [compute setBuffer:result offset:0 atIndex:0];
+  [compute dispatchThreads:MTLSizeMake(direct_view.width, direct_view.height, 1)
+      threadsPerThreadgroup:direct_load_compare_pipeline_.threads_per_threadgroup];
+  std::string what = fmt::format("{}: format {} {}x{} level {} endianness {}{}{}", what_kind,
+                                 uint32_t(key.format), direct_view.width, direct_view.height, level,
+                                 uint32_t(key.endianness), key.tiled ? "" : " linear",
+                                 key.scaled_resolve ? " scaled" : "");
+  command_processor_.AddCompletedHandler(^(id<MTLCommandBuffer>) {
+    const uint32_t* values = static_cast<const uint32_t*>(result.contents);
+    static std::mutex mutex;
+    static std::set<std::string> logged;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (!logged.insert(fmt::format("{} {}", values[0] == 0, what)).second) {
+      return;
+    }
+    if (!values[0]) {
+      REXGPU_INFO("{} matches the usual load", what);
+    } else {
+      REXGPU_WARN("{} differs in {} texels, first at {},{}: direct {:08X} {:08X}, usual "
+                  "{:08X} {:08X}",
+                  what, values[0], values[1], values[2], values[3], values[5], values[4],
+                  values[6]);
+    }
+  });
+}
+
+id<MTLBuffer> MetalTextureCache::RequestRationalScaledSurface(uint32_t dest_base, uint32_t width,
+                                                              uint32_t height,
+                                                              uint32_t bytes_per_texel,
+                                                              uint32_t& pitch_out) {
+  // Tiled textures are stored in 32x32 texel tiles, so the pitch and the rows are whole tiles.
+  uint32_t pitch = rex::align(draw_resolution_scale().ScaleXCeil(width), UINT32_C(32));
+  uint32_t rows = rex::align(draw_resolution_scale().ScaleYCeil(height), UINT32_C(32));
+  NSUInteger size = NSUInteger(pitch) * rows * bytes_per_texel;
+  RationalScaledSurface& surface = rational_scaled_surfaces_[dest_base];
+  if (!surface.buffer || surface.buffer.length < size) {
+    surface.buffer = [command_processor_.device() newBufferWithLength:size
+                                                              options:MTLResourceStorageModePrivate];
+    if (!surface.buffer) {
+      rational_scaled_surfaces_.erase(dest_base);
+      return nil;
+    }
+    surface.buffer.label = [NSString stringWithFormat:@"Scaled surface 0x%08X", dest_base];
+  }
+  surface.width = width;
+  surface.height = height;
+  surface.bytes_per_texel = bytes_per_texel;
+  surface.pitch = pitch;
+  pitch_out = pitch;
+  return surface.buffer;
+}
+
+const MetalTextureCache::RationalScaledSurface* MetalTextureCache::GetRationalScaledSurface(
+    TextureKey key) const {
+  if (key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
+      !key.tiled || key.mip_max_level) {
+    return nullptr;
+  }
+  auto it = rational_scaled_surfaces_.find(key.base_page << 12);
+  if (it == rational_scaled_surfaces_.end()) {
+    return nullptr;
+  }
+  const RationalScaledSurface& surface = it->second;
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  if (format_info->block_width != 1 || format_info->block_height != 1 ||
+      format_info->bytes_per_block() != surface.bytes_per_texel ||
+      key.GetWidth() != surface.width || key.GetHeight() != surface.height) {
+    return nullptr;
+  }
+  // A base level in a packed mip tail is stored elsewhere in its tail.
+  if (key.packed_mips && key.GetGuestLayout().packed_level == 0) {
+    return nullptr;
+  }
+  return &surface;
+}
+
+bool MetalTextureCache::IsScaledResolveSupportedForFormat(TextureKey key) const {
+  if (!IsDrawResolutionScaled()) {
+    return false;
+  }
+  // At a rational scale, only a texture with its own resolve's scaled surface.
+  if (!draw_resolution_scale().IsWhole()) {
+    return GetRationalScaledSurface(key) != nullptr;
+  }
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  bool host_format_is_signed;
+  if (IsSignedVersionSeparateForFormat(key)) {
+    host_format_is_signed = bool(key.signed_separate);
+  } else {
+    host_format_is_signed = host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  }
+  LoadShaderIndex load_shader =
+      (host_format_is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned)
+          .load_shader;
+  return load_shader != kLoadShaderIndexUnknown && load_pipelines_scaled_[load_shader].pipeline;
+}
+
+bool MetalTextureCache::Initialize() {
+  id<MTLDevice> device = command_processor_.device();
+
+  // Formats.
+  for (size_t i = 0; i < rex::countof(host_formats_); ++i) {
+    host_formats_[i] = kBestHostFormats[i];
+  }
+  // Apple GPUs sample BC formats on macOS; without them, decompress as for unaligned sizes.
+  if (!device.supportsBCTextureCompression) {
+    REXGPU_WARN("MetalTextureCache: BC textures are not supported, decompressing them on load");
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXT1)] = kHostFormatDXT1Unaligned;
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXT1_AS_16_16_16_16)] =
+        kHostFormatDXT1Unaligned;
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXT2_3)] = kHostFormatDXT2_3Unaligned;
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXT2_3_AS_16_16_16_16)] =
+        kHostFormatDXT2_3Unaligned;
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXT4_5)] = kHostFormatDXT4_5Unaligned;
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXT4_5_AS_16_16_16_16)] =
+        kHostFormatDXT4_5Unaligned;
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXN)] = kHostFormatDXNUnaligned;
+    host_formats_[uint32_t(xenos::TextureFormat::k_DXT5A)] = kHostFormatDXT5AUnaligned;
+  }
+  // Every format here is filterable on Apple GPUs except 32-bit float, which needs
+  // supports32BitFloatFiltering.
+  bool float32_filterable = device.supports32BitFloatFiltering;
+  auto set_filterable = [float32_filterable](HostFormat& host_format) {
+    switch (host_format.format) {
+      case MTLPixelFormatR32Float:
+      case MTLPixelFormatRG32Float:
+      case MTLPixelFormatRGBA32Float:
+        host_format.linear_filterable = float32_filterable;
+        break;
+      default:
+        host_format.linear_filterable = host_format.format != MTLPixelFormatInvalid;
+        break;
+    }
+  };
+  for (HostFormatPair& host_format_pair : host_formats_) {
+    set_filterable(host_format_pair.format_unsigned);
+    set_filterable(host_format_pair.format_signed);
+  }
+
+  // Load pipelines for the formats in use.
+  std::pair<const uint32_t*, size_t> load_shader_code[kLoadShaderCount] = {};
+  load_shader_code[kLoadShaderIndex8bpb] =
+      std::make_pair(shaders::texture_load_8bpb_cs, sizeof(shaders::texture_load_8bpb_cs));
+  load_shader_code[kLoadShaderIndex16bpb] =
+      std::make_pair(shaders::texture_load_16bpb_cs, sizeof(shaders::texture_load_16bpb_cs));
+  load_shader_code[kLoadShaderIndex32bpb] =
+      std::make_pair(shaders::texture_load_32bpb_cs, sizeof(shaders::texture_load_32bpb_cs));
+  load_shader_code[kLoadShaderIndex64bpb] =
+      std::make_pair(shaders::texture_load_64bpb_cs, sizeof(shaders::texture_load_64bpb_cs));
+  load_shader_code[kLoadShaderIndex128bpb] =
+      std::make_pair(shaders::texture_load_128bpb_cs, sizeof(shaders::texture_load_128bpb_cs));
+  load_shader_code[kLoadShaderIndexR5G5B5A1ToB5G5R5A1] =
+      std::make_pair(shaders::texture_load_r5g5b5a1_b5g5r5a1_cs,
+                     sizeof(shaders::texture_load_r5g5b5a1_b5g5r5a1_cs));
+  load_shader_code[kLoadShaderIndexR5G6B5ToB5G6R5] = std::make_pair(
+      shaders::texture_load_r5g6b5_b5g6r5_cs, sizeof(shaders::texture_load_r5g6b5_b5g6r5_cs));
+  load_shader_code[kLoadShaderIndexR5G5B6ToB5G6R5WithRBGASwizzle] =
+      std::make_pair(shaders::texture_load_r5g5b6_b5g6r5_swizzle_rbga_cs,
+                     sizeof(shaders::texture_load_r5g5b6_b5g6r5_swizzle_rbga_cs));
+  load_shader_code[kLoadShaderIndexRGBA4ToRGBA8] = std::make_pair(
+      shaders::texture_load_r4g4b4a4_rgba8_cs, sizeof(shaders::texture_load_r4g4b4a4_rgba8_cs));
+  load_shader_code[kLoadShaderIndexGBGR8ToRGB8] = std::make_pair(
+      shaders::texture_load_gbgr8_rgb8_cs, sizeof(shaders::texture_load_gbgr8_rgb8_cs));
+  load_shader_code[kLoadShaderIndexBGRG8ToRGB8] = std::make_pair(
+      shaders::texture_load_bgrg8_rgb8_cs, sizeof(shaders::texture_load_bgrg8_rgb8_cs));
+  load_shader_code[kLoadShaderIndexR10G11B11ToRGBA16] = std::make_pair(
+      shaders::texture_load_r10g11b11_rgba16_cs, sizeof(shaders::texture_load_r10g11b11_rgba16_cs));
+  load_shader_code[kLoadShaderIndexR10G11B11ToRGBA16SNorm] =
+      std::make_pair(shaders::texture_load_r10g11b11_rgba16_snorm_cs,
+                     sizeof(shaders::texture_load_r10g11b11_rgba16_snorm_cs));
+  load_shader_code[kLoadShaderIndexR11G11B10ToRGBA16] = std::make_pair(
+      shaders::texture_load_r11g11b10_rgba16_cs, sizeof(shaders::texture_load_r11g11b10_rgba16_cs));
+  load_shader_code[kLoadShaderIndexR11G11B10ToRGBA16SNorm] =
+      std::make_pair(shaders::texture_load_r11g11b10_rgba16_snorm_cs,
+                     sizeof(shaders::texture_load_r11g11b10_rgba16_snorm_cs));
+  load_shader_code[kLoadShaderIndexDXT1ToRGBA8] = std::make_pair(
+      shaders::texture_load_dxt1_rgba8_cs, sizeof(shaders::texture_load_dxt1_rgba8_cs));
+  load_shader_code[kLoadShaderIndexDXT3ToRGBA8] = std::make_pair(
+      shaders::texture_load_dxt3_rgba8_cs, sizeof(shaders::texture_load_dxt3_rgba8_cs));
+  load_shader_code[kLoadShaderIndexDXT5ToRGBA8] = std::make_pair(
+      shaders::texture_load_dxt5_rgba8_cs, sizeof(shaders::texture_load_dxt5_rgba8_cs));
+  load_shader_code[kLoadShaderIndexDXNToRG8] =
+      std::make_pair(shaders::texture_load_dxn_rg8_cs, sizeof(shaders::texture_load_dxn_rg8_cs));
+  load_shader_code[kLoadShaderIndexDXT3A] =
+      std::make_pair(shaders::texture_load_dxt3a_cs, sizeof(shaders::texture_load_dxt3a_cs));
+  load_shader_code[kLoadShaderIndexDXT3AAs1111ToARGB4] =
+      std::make_pair(shaders::texture_load_dxt3aas1111_argb4_cs,
+                     sizeof(shaders::texture_load_dxt3aas1111_argb4_cs));
+  load_shader_code[kLoadShaderIndexDXT5AToR8] =
+      std::make_pair(shaders::texture_load_dxt5a_r8_cs, sizeof(shaders::texture_load_dxt5a_r8_cs));
+  load_shader_code[kLoadShaderIndexCTX1] =
+      std::make_pair(shaders::texture_load_ctx1_cs, sizeof(shaders::texture_load_ctx1_cs));
+  load_shader_code[kLoadShaderIndexDepthUnorm] = std::make_pair(
+      shaders::texture_load_depth_unorm_cs, sizeof(shaders::texture_load_depth_unorm_cs));
+  load_shader_code[kLoadShaderIndexDepthFloat] = std::make_pair(
+      shaders::texture_load_depth_float_cs, sizeof(shaders::texture_load_depth_float_cs));
+
+  bool load_shaders_needed[kLoadShaderCount] = {};
+  auto mark_load_shaders_needed = [&](const HostFormatPair& host_format_pair) {
+    if (host_format_pair.format_unsigned.load_shader != kLoadShaderIndexUnknown) {
+      load_shaders_needed[host_format_pair.format_unsigned.load_shader] = true;
+    }
+    if (host_format_pair.format_signed.load_shader != kLoadShaderIndexUnknown) {
+      load_shaders_needed[host_format_pair.format_signed.load_shader] = true;
+    }
+  };
+  for (const HostFormatPair& host_format_pair : host_formats_) {
+    mark_load_shaders_needed(host_format_pair);
+  }
+  mark_load_shaders_needed(kHostFormatGBGRUnaligned);
+  mark_load_shaders_needed(kHostFormatBGRGUnaligned);
+  mark_load_shaders_needed(kHostFormatDXT1Unaligned);
+  mark_load_shaders_needed(kHostFormatDXT2_3Unaligned);
+  mark_load_shaders_needed(kHostFormatDXT4_5Unaligned);
+  mark_load_shaders_needed(kHostFormatDXNUnaligned);
+  mark_load_shaders_needed(kHostFormatDXT5AUnaligned);
+
+  // Variants reading the scaled resolve buffer, for the formats render targets are resolved to
+  // (block-compressed and subsampled formats are never resolve destinations). Whole scales only: at
+  // a rational scale, the unscaled shaders read the scaled surfaces.
+  std::pair<const uint32_t*, size_t> load_shader_code_scaled[kLoadShaderCount] = {};
+  if (IsDrawResolutionScaled() && draw_resolution_scale().IsWhole()) {
+    load_shader_code_scaled[kLoadShaderIndex8bpb] =
+        std::make_pair(shaders::texture_load_8bpb_scaled_cs,
+                       sizeof(shaders::texture_load_8bpb_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndex16bpb] =
+        std::make_pair(shaders::texture_load_16bpb_scaled_cs,
+                       sizeof(shaders::texture_load_16bpb_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndex32bpb] =
+        std::make_pair(shaders::texture_load_32bpb_scaled_cs,
+                       sizeof(shaders::texture_load_32bpb_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndex64bpb] =
+        std::make_pair(shaders::texture_load_64bpb_scaled_cs,
+                       sizeof(shaders::texture_load_64bpb_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndex128bpb] =
+        std::make_pair(shaders::texture_load_128bpb_scaled_cs,
+                       sizeof(shaders::texture_load_128bpb_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexR5G5B5A1ToB5G5R5A1] =
+        std::make_pair(shaders::texture_load_r5g5b5a1_b5g5r5a1_scaled_cs,
+                       sizeof(shaders::texture_load_r5g5b5a1_b5g5r5a1_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexR5G6B5ToB5G6R5] =
+        std::make_pair(shaders::texture_load_r5g6b5_b5g6r5_scaled_cs,
+                       sizeof(shaders::texture_load_r5g6b5_b5g6r5_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexR5G5B6ToB5G6R5WithRBGASwizzle] =
+        std::make_pair(shaders::texture_load_r5g5b6_b5g6r5_swizzle_rbga_scaled_cs,
+                       sizeof(shaders::texture_load_r5g5b6_b5g6r5_swizzle_rbga_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexRGBA4ToRGBA8] =
+        std::make_pair(shaders::texture_load_r4g4b4a4_rgba8_scaled_cs,
+                       sizeof(shaders::texture_load_r4g4b4a4_rgba8_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexR10G11B11ToRGBA16] =
+        std::make_pair(shaders::texture_load_r10g11b11_rgba16_scaled_cs,
+                       sizeof(shaders::texture_load_r10g11b11_rgba16_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexR10G11B11ToRGBA16SNorm] =
+        std::make_pair(shaders::texture_load_r10g11b11_rgba16_snorm_scaled_cs,
+                       sizeof(shaders::texture_load_r10g11b11_rgba16_snorm_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexR11G11B10ToRGBA16] =
+        std::make_pair(shaders::texture_load_r11g11b10_rgba16_scaled_cs,
+                       sizeof(shaders::texture_load_r11g11b10_rgba16_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexR11G11B10ToRGBA16SNorm] =
+        std::make_pair(shaders::texture_load_r11g11b10_rgba16_snorm_scaled_cs,
+                       sizeof(shaders::texture_load_r11g11b10_rgba16_snorm_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexDepthUnorm] =
+        std::make_pair(shaders::texture_load_depth_unorm_scaled_cs,
+                       sizeof(shaders::texture_load_depth_unorm_scaled_cs));
+    load_shader_code_scaled[kLoadShaderIndexDepthFloat] =
+        std::make_pair(shaders::texture_load_depth_float_scaled_cs,
+                       sizeof(shaders::texture_load_depth_float_scaled_cs));
+  }
+
+  const std::vector<MslBinding> load_bindings = {
+      {0, 0, MslBinding::Kind::kBuffer, kLoadBufferDestination},
+      {1, 0, MslBinding::Kind::kBuffer, kLoadBufferSource},
+      {MslBinding::kPushConstantSet, 0, MslBinding::Kind::kBuffer, kLoadBufferConstants},
+  };
+  for (uint32_t i = 0; i < kLoadShaderCount; ++i) {
+    if (!load_shaders_needed[i]) {
+      continue;
+    }
+    const std::pair<const uint32_t*, size_t>& code = load_shader_code[i];
+    if (!code.first) {
+      REXGPU_ERROR("MetalTextureCache: no code for the texture load shader {}", i);
+      return false;
+    }
+    std::array<uint32_t, 3> threadgroup_size;
+    std::string name = fmt::format("texture load {}", i);
+    id<MTLComputePipelineState> pipeline =
+        CreateComputePipelineFromSpirv(device, code.first, code.second / sizeof(uint32_t),
+                                       load_bindings, name.c_str(), &threadgroup_size);
+    if (!pipeline) {
+      REXGPU_ERROR("MetalTextureCache: failed to create the texture load pipeline {}", i);
+      return false;
+    }
+    load_pipelines_[i].pipeline = pipeline;
+    load_pipelines_[i].threads_per_threadgroup =
+        MTLSizeMake(threadgroup_size[0], threadgroup_size[1], threadgroup_size[2]);
+
+    const std::pair<const uint32_t*, size_t>& code_scaled = load_shader_code_scaled[i];
+    if (code_scaled.first) {
+      std::string name_scaled = fmt::format("texture load {} scaled", i);
+      id<MTLComputePipelineState> pipeline_scaled = CreateComputePipelineFromSpirv(
+          device, code_scaled.first, code_scaled.second / sizeof(uint32_t), load_bindings,
+          name_scaled.c_str(), &threadgroup_size);
+      if (!pipeline_scaled) {
+        REXGPU_ERROR("MetalTextureCache: failed to create the scaled texture load pipeline {}", i);
+        return false;
+      }
+      load_pipelines_scaled_[i].pipeline = pipeline_scaled;
+      load_pipelines_scaled_[i].threads_per_threadgroup =
+          MTLSizeMake(threadgroup_size[0], threadgroup_size[1], threadgroup_size[2]);
+    }
+  }
+
+  // Direct loads (and their check). Without them, every texture is loaded the usual way.
+  if (REXCVAR_GET(metal_texture_load_direct)) {
+    NSError* error = nil;
+    id<MTLLibrary> library = [device newLibraryWithSource:kTextureLoadDirectShaderSource
+                                                  options:nil
+                                                    error:&error];
+    auto make_pipeline = [&](NSString* name, LoadPipeline& pipeline_out) {
+      id<MTLFunction> function = [library newFunctionWithName:name];
+      pipeline_out.pipeline =
+          function ? [device newComputePipelineStateWithFunction:function error:&error] : nil;
+      pipeline_out.threads_per_threadgroup = MTLSizeMake(8, 8, 1);
+      return pipeline_out.pipeline != nil;
+    };
+    if (!library || !make_pipeline(@"texture_load_direct", direct_load_pipeline_) ||
+        !make_pipeline(@"texture_load_compare", direct_load_compare_pipeline_)) {
+      REXGPU_ERROR("MetalTextureCache: Failed to create the direct texture load pipelines ({}); "
+                   "textures are loaded the usual way",
+                   error ? [[error localizedDescription] UTF8String] : "unknown");
+      direct_load_pipeline_ = LoadPipeline();
+      direct_load_compare_pipeline_ = LoadPipeline();
+    }
+  }
+
+  if (IsDrawResolutionScaled() && draw_resolution_scale().IsWhole() &&
+      !InitializeScaledResolveBuffer()) {
+    return false;
+  }
+
+  // Null textures for bindings without a texture, read as (0, 0, 0, 0).
+  null_texture_2d_array_ = CreateNullTexture(MTLTextureType2DArray, "Null 2D array texture");
+  null_texture_3d_ = CreateNullTexture(MTLTextureType3D, "Null 3D texture");
+  null_texture_cube_ = CreateNullTexture(MTLTextureTypeCube, "Null cube texture");
+  if (!null_texture_2d_array_ || !null_texture_3d_ || !null_texture_cube_) {
+    REXGPU_ERROR("MetalTextureCache: failed to create the null textures");
+    return false;
+  }
+
+  return true;
+}
+
+id<MTLTexture> MetalTextureCache::CreateNullTexture(MTLTextureType type, const char* label) {
+  MTLTextureDescriptor* descriptor = [MTLTextureDescriptor new];
+  descriptor.textureType = type;
+  descriptor.pixelFormat = MTLPixelFormatRGBA8Unorm;
+  descriptor.width = 1;
+  descriptor.height = 1;
+  descriptor.depth = 1;
+  descriptor.arrayLength = 1;
+  descriptor.mipmapLevelCount = 1;
+  descriptor.usage = MTLTextureUsageShaderRead;
+  // Filled by the CPU once, never written again.
+  descriptor.storageMode = MTLStorageModeShared;
+  id<MTLTexture> texture = [command_processor_.device() newTextureWithDescriptor:descriptor];
+  if (!texture) {
+    return nil;
+  }
+  texture.label = @(label);
+  const uint32_t zero = 0;
+  uint32_t slice_count = type == MTLTextureTypeCube ? 6 : 1;
+  for (uint32_t slice = 0; slice < slice_count; ++slice) {
+    [texture replaceRegion:MTLRegionMake3D(0, 0, 0, 1, 1, 1)
+               mipmapLevel:0
+                     slice:slice
+                 withBytes:&zero
+               bytesPerRow:sizeof(zero)
+             bytesPerImage:sizeof(zero)];
+  }
+  return texture;
+}
+
+void MetalTextureCache::BeginFrame() {
+  TextureCache::BeginFrame();
+  std::memset(unsupported_format_features_used_, 0, sizeof(unsupported_format_features_used_));
+}
+
+void MetalTextureCache::EndFrame() {
+  bool unsupported_header_written = false;
+  for (uint32_t i = 0; i < 64; ++i) {
+    uint32_t unsupported_features = unsupported_format_features_used_[i];
+    if (!unsupported_features) {
+      continue;
+    }
+    if (!unsupported_header_written) {
+      REXGPU_ERROR("Unsupported texture formats used in the frame:");
+      unsupported_header_written = true;
+    }
+    REXGPU_ERROR("* {}{}{}{}", FormatInfo::Get(xenos::TextureFormat(i))->name,
+                 unsupported_features & kUnsupportedResourceBit ? " resource" : "",
+                 unsupported_features & kUnsupportedUnormBit ? " unsigned" : "",
+                 unsupported_features & kUnsupportedSnormBit ? " signed" : "");
+    unsupported_format_features_used_[i] = 0;
+  }
+}
+
+void MetalTextureCache::RequestTextures(uint32_t used_texture_mask) {
+  TextureCache::RequestTextures(used_texture_mask);
+
+  // Create the 3D-as-2D wrappers while textures may still be loaded, and keep everything the
+  // draw references alive until the submission completes. Metal tracks the hazards between the
+  // loads and the draws, so there are no usage transitions.
+  uint32_t textures_remaining = used_texture_mask;
+  uint32_t index;
+  while (rex::bit_scan_forward(textures_remaining, &index)) {
+    textures_remaining &= ~(uint32_t(1) << index);
+    const TextureBinding* binding = GetValidTextureBinding(index);
+    if (!binding) {
+      continue;
+    }
+    for (Texture* texture : {binding->texture, binding->texture_signed}) {
+      if (!texture) {
+        continue;
+      }
+      texture->MarkAsUsed();
+      if (REXCVAR_GET(gpu_3d_to_2d_texture) &&
+          binding->key.dimension == xenos::DataDimension::k3D) {
+        static_cast<MetalTexture*>(texture)->GetOrCreate3DAs2DView(
+            texture == binding->texture_signed, binding->host_swizzle);
+      }
+    }
+  }
+}
+
+id<MTLTexture> MetalTextureCache::GetActiveBindingOrNullTexture(uint32_t fetch_constant_index,
+                                                                xenos::FetchOpDimension dimension,
+                                                                bool is_signed) {
+  id<MTLTexture> texture = nil;
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (binding && AreDimensionsCompatible(dimension, binding->key.dimension)) {
+    bool force_2d_view =
+        binding->key.dimension == xenos::DataDimension::k3D &&
+        (dimension == xenos::FetchOpDimension::k1D || dimension == xenos::FetchOpDimension::k2D);
+    if (force_2d_view) {
+      bool use_signed = is_signed && texture_util::IsAnySignSigned(binding->swizzled_signs);
+      Texture* binding_texture = use_signed && IsSignedVersionSeparateForFormat(binding->key)
+                                     ? binding->texture_signed
+                                     : binding->texture;
+      if (binding_texture) {
+        texture = static_cast<MetalTexture*>(binding_texture)
+                      ->GetOrCreate3DAs2DView(use_signed, binding->host_swizzle);
+      }
+    } else {
+      const MetalTextureBinding& metal_binding = metal_texture_bindings_[fetch_constant_index];
+      texture = is_signed ? metal_binding.texture_signed : metal_binding.texture_unsigned;
+    }
+  }
+  if (texture) {
+    return texture;
+  }
+  switch (dimension) {
+    case xenos::FetchOpDimension::k3DOrStacked:
+      return null_texture_3d_;
+    case xenos::FetchOpDimension::kCube:
+      return null_texture_cube_;
+    default:
+      return null_texture_2d_array_;
+  }
+}
+
+MetalTextureCache::SamplerParameters MetalTextureCache::GetSamplerParameters(
+    const SpirvShader::SamplerBinding& binding) const {
+  const auto& regs = register_file();
+  xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+
+  SamplerParameters parameters;
+
+  xenos::ClampMode fetch_clamp_x, fetch_clamp_y, fetch_clamp_z;
+  texture_util::GetClampModesForDimension(fetch, fetch_clamp_x, fetch_clamp_y, fetch_clamp_z);
+  parameters.clamp_x = NormalizeClampMode(fetch_clamp_x);
+  parameters.clamp_y = NormalizeClampMode(fetch_clamp_y);
+  parameters.clamp_z = NormalizeClampMode(fetch_clamp_z);
+  if (xenos::ClampModeUsesBorder(parameters.clamp_x) ||
+      xenos::ClampModeUsesBorder(parameters.clamp_y) ||
+      xenos::ClampModeUsesBorder(parameters.clamp_z)) {
+    parameters.border_color = fetch.border_color;
+  } else {
+    parameters.border_color = xenos::BorderColor::k_ABGR_Black;
+  }
+
+  xenos::TextureFilter mag_filter = binding.mag_filter == xenos::TextureFilter::kUseFetchConst
+                                        ? fetch.mag_filter
+                                        : binding.mag_filter;
+  parameters.mag_linear = mag_filter == xenos::TextureFilter::kLinear;
+  xenos::TextureFilter min_filter = binding.min_filter == xenos::TextureFilter::kUseFetchConst
+                                        ? fetch.min_filter
+                                        : binding.min_filter;
+  parameters.min_linear = min_filter == xenos::TextureFilter::kLinear;
+  xenos::TextureFilter mip_filter = binding.mip_filter == xenos::TextureFilter::kUseFetchConst
+                                        ? fetch.mip_filter
+                                        : binding.mip_filter;
+  parameters.mip_linear = mip_filter == xenos::TextureFilter::kLinear;
+  xenos::AnisoFilter aniso_filter = binding.aniso_filter == xenos::AnisoFilter::kUseFetchConst
+                                        ? fetch.aniso_filter
+                                        : binding.aniso_filter;
+  aniso_filter = std::min(aniso_filter, max_anisotropy_);
+  if (parameters.mag_linear || parameters.min_linear || parameters.mip_linear ||
+      aniso_filter != xenos::AnisoFilter::kDisabled) {
+    // Check if the texture is actually filterable on the host.
+    bool linear_filterable = true;
+    TextureKey texture_key;
+    uint8_t texture_swizzled_signs;
+    BindingInfoFromFetchConstant(fetch, texture_key, &texture_swizzled_signs);
+    if (texture_key.is_valid) {
+      const HostFormatPair& host_format_pair = GetHostFormatPair(texture_key);
+      if ((texture_util::IsAnySignNotSigned(texture_swizzled_signs) &&
+           !host_format_pair.format_unsigned.linear_filterable) ||
+          (texture_util::IsAnySignSigned(texture_swizzled_signs) &&
+           !host_format_pair.format_signed.linear_filterable)) {
+        linear_filterable = false;
+      }
+    } else {
+      linear_filterable = false;
+    }
+    if (!linear_filterable) {
+      parameters.mag_linear = 0;
+      parameters.min_linear = 0;
+      parameters.mip_linear = 0;
+      aniso_filter = xenos::AnisoFilter::kDisabled;
+    }
+  }
+  bool min_mag_linear = parameters.mag_linear && parameters.min_linear;
+  bool mip_filter_bilinear_or_trilinear =
+      mip_filter == xenos::TextureFilter::kPoint || mip_filter == xenos::TextureFilter::kLinear;
+  parameters.mip_base_map = mip_filter == xenos::TextureFilter::kBaseMap;
+  uint32_t mip_min_level, mip_max_level;
+  texture_util::GetSubresourcesFromFetchConstant(fetch, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                                 &mip_min_level, &mip_max_level);
+  parameters.mip_min_level = mip_min_level;
+  bool has_mips = mip_max_level > mip_min_level;
+  int32_t anisotropic_override = REXCVAR_GET(anisotropic_override);
+  if (anisotropic_override > -1 && anisotropic_override < 6 && has_mips &&
+      !parameters.mip_base_map && min_mag_linear && mip_filter_bilinear_or_trilinear) {
+    aniso_filter = xenos::AnisoFilter(anisotropic_override);
+  }
+  aniso_filter = std::min(aniso_filter, max_anisotropy_);
+  if (aniso_filter != xenos::AnisoFilter::kDisabled) {
+    // As in Direct3D 12, anisotropic filtering forces linear min, mag and mip filtering.
+    parameters.mag_linear = 1;
+    parameters.min_linear = 1;
+    parameters.mip_linear = 1;
+  }
+  parameters.aniso_filter = aniso_filter;
+
+  return parameters;
+}
+
+id<MTLSamplerState> MetalTextureCache::GetSampler(SamplerParameters parameters) {
+  auto it = samplers_.find(parameters.value);
+  if (it != samplers_.end()) {
+    return it->second;
+  }
+
+  MTLSamplerDescriptor* descriptor = [MTLSamplerDescriptor new];
+  descriptor.magFilter =
+      parameters.mag_linear ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+  descriptor.minFilter =
+      parameters.min_linear ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+  descriptor.mipFilter =
+      parameters.mip_linear ? MTLSamplerMipFilterLinear : MTLSamplerMipFilterNearest;
+  static const MTLSamplerAddressMode kAddressModeMap[] = {
+      // kRepeat
+      MTLSamplerAddressModeRepeat,
+      // kMirroredRepeat
+      MTLSamplerAddressModeMirrorRepeat,
+      // kClampToEdge
+      MTLSamplerAddressModeClampToEdge,
+      // kMirrorClampToEdge
+      MTLSamplerAddressModeMirrorClampToEdge,
+      // kClampToHalfway
+      MTLSamplerAddressModeClampToEdge,
+      // kMirrorClampToHalfway
+      MTLSamplerAddressModeMirrorClampToEdge,
+      // kClampToBorder
+      MTLSamplerAddressModeClampToBorderColor,
+      // kMirrorClampToBorder
+      MTLSamplerAddressModeMirrorClampToEdge,
+  };
+  descriptor.sAddressMode = kAddressModeMap[uint32_t(parameters.clamp_x)];
+  descriptor.tAddressMode = kAddressModeMap[uint32_t(parameters.clamp_y)];
+  descriptor.rAddressMode = kAddressModeMap[uint32_t(parameters.clamp_z)];
+  // LOD biasing is done in the shaders.
+  if (parameters.aniso_filter != xenos::AnisoFilter::kDisabled) {
+    descriptor.maxAnisotropy = NSUInteger(1) << (uint32_t(parameters.aniso_filter) -
+                                                 uint32_t(xenos::AnisoFilter::kMax_1_1));
+  }
+  descriptor.lodMinClamp = float(parameters.mip_min_level);
+  if (parameters.mip_base_map) {
+    assert_false(parameters.mip_linear);
+    descriptor.lodMaxClamp = descriptor.lodMinClamp + 0.25f;
+  } else {
+    descriptor.lodMaxClamp = FLT_MAX;
+  }
+  // Metal has no custom border colors: the YCbCr blacks are transparent black, the fallback of the
+  // Vulkan backend without VK_EXT_custom_border_color.
+  descriptor.borderColor = parameters.border_color == xenos::BorderColor::k_ABGR_White
+                               ? MTLSamplerBorderColorOpaqueWhite
+                               : MTLSamplerBorderColorTransparentBlack;
+
+  id<MTLSamplerState> sampler = [command_processor_.device() newSamplerStateWithDescriptor:descriptor];
+  if (!sampler) {
+    REXGPU_ERROR("MetalTextureCache: failed to create the sampler for parameters 0x{:08X}",
+                 parameters.value);
+    return nil;
+  }
+  samplers_.emplace(parameters.value, sampler);
+  return sampler;
+}
+
+id<MTLTexture> MetalTextureCache::RequestSwapTexture(uint32_t& width_scaled_out,
+                                                     uint32_t& height_scaled_out,
+                                                     uint32_t& width_unscaled_out,
+                                                     uint32_t& height_unscaled_out,
+                                                     xenos::TextureFormat& format_out) {
+  const auto& regs = register_file();
+  xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(0);
+  TextureKey key;
+  BindingInfoFromFetchConstant(fetch, key, nullptr);
+  if (!key.is_valid || key.base_page == 0 || key.dimension != xenos::DataDimension::k2DOrStacked) {
+    return nil;
+  }
+  MetalTexture* texture = static_cast<MetalTexture*>(FindOrCreateTexture(key));
+  if (!texture) {
+    return nil;
+  }
+  uint32_t host_swizzle = GuestToHostSwizzle(fetch.swizzle, GetHostFormatSwizzle(key));
+  id<MTLTexture> view = texture->GetView(false, host_swizzle, false);
+  if (!view) {
+    return nil;
+  }
+  if (!LoadTextureData(*texture)) {
+    return nil;
+  }
+  texture->MarkAsUsed();
+  // Only texture->key, not the result of BindingInfoFromFetchConstant, contains whether the
+  // texture is scaled.
+  key = texture->key();
+  width_unscaled_out = key.GetWidth();
+  height_unscaled_out = key.GetHeight();
+  width_scaled_out = key.scaled_resolve ? draw_resolution_scale().ScaleXCeil(width_unscaled_out)
+                                        : width_unscaled_out;
+  height_scaled_out = key.scaled_resolve ? draw_resolution_scale().ScaleYCeil(height_unscaled_out)
+                                         : height_unscaled_out;
+  format_out = key.format;
+  return view;
+}
+
+bool MetalTextureCache::IsSignedVersionSeparateForFormat(TextureKey key) const {
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  if (host_format_pair.format_unsigned.format == MTLPixelFormatInvalid ||
+      host_format_pair.format_signed.format == MTLPixelFormatInvalid) {
+    // Just one signedness.
+    return false;
+  }
+  return !host_format_pair.unsigned_signed_compatible;
+}
+
+uint32_t MetalTextureCache::GetHostFormatSwizzle(TextureKey key) const {
+  return GetHostFormatPair(key).swizzle;
+}
+
+uint32_t MetalTextureCache::GetMaxHostTextureWidthHeight(xenos::DataDimension dimension) const {
+  // Apple GPUs (Apple7 and later, every Apple silicon Mac).
+  switch (dimension) {
+    case xenos::DataDimension::k1D:
+    case xenos::DataDimension::k2DOrStacked:
+    case xenos::DataDimension::kCube:
+      return 16384;
+    case xenos::DataDimension::k3D:
+      return 2048;
+    default:
+      assert_unhandled_case(dimension);
+      return 0;
+  }
+}
+
+uint32_t MetalTextureCache::GetMaxHostTextureDepthOrArraySize(
+    xenos::DataDimension dimension) const {
+  switch (dimension) {
+    case xenos::DataDimension::k1D:
+    case xenos::DataDimension::k2DOrStacked:
+      return 2048;
+    case xenos::DataDimension::k3D:
+      return 2048;
+    case xenos::DataDimension::kCube:
+      // The Xenos has no cube map arrays.
+      return 6;
+    default:
+      assert_unhandled_case(dimension);
+      return 0;
+  }
+}
+
+std::unique_ptr<TextureCache::Texture> MetalTextureCache::CreateTexture(TextureKey key) {
+  const HostFormatPair& host_format = GetHostFormatPair(key);
+  MTLPixelFormat format = MTLPixelFormatInvalid;
+  bool has_second_format = false;
+  if (host_format.format_signed.format == MTLPixelFormatInvalid) {
+    format = host_format.format_unsigned.format;
+  } else if (host_format.format_unsigned.format == MTLPixelFormatInvalid) {
+    format = host_format.format_signed.format;
+  } else if (IsSignedVersionSeparateForFormat(key)) {
+    format = key.signed_separate ? host_format.format_signed.format
+                                 : host_format.format_unsigned.format;
+  } else {
+    format = host_format.format_unsigned.format;
+    has_second_format = host_format.format_signed.format != host_format.format_unsigned.format;
+  }
+  if (format == MTLPixelFormatInvalid) {
+    unsupported_format_features_used_[uint32_t(key.format)] |= kUnsupportedResourceBit;
+    return nullptr;
+  }
+  (void)has_second_format;
+
+  MTLTextureDescriptor* descriptor = [MTLTextureDescriptor new];
+  uint32_t depth_or_array_size = key.GetDepthOrArraySize();
+  switch (key.dimension) {
+    case xenos::DataDimension::k3D:
+      descriptor.textureType = MTLTextureType3D;
+      descriptor.depth = depth_or_array_size;
+      break;
+    case xenos::DataDimension::kCube:
+      descriptor.textureType = MTLTextureTypeCube;
+      break;
+    default:
+      // 1D and 2D are 2D arrays, as guest shaders declare them.
+      descriptor.textureType = MTLTextureType2DArray;
+      descriptor.arrayLength = depth_or_array_size;
+      break;
+  }
+  descriptor.pixelFormat = format;
+  // Rounded up at a rational scale, for an odd guest size.
+  descriptor.width =
+      key.scaled_resolve ? draw_resolution_scale().ScaleXCeil(key.GetWidth()) : key.GetWidth();
+  descriptor.height =
+      key.scaled_resolve ? draw_resolution_scale().ScaleYCeil(key.GetHeight()) : key.GetHeight();
+  descriptor.mipmapLevelCount = key.mip_max_level + 1;
+  // Views reinterpret the format between the signednesses and apply the guest swizzle.
+  descriptor.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+  // Direct loads write the texture through an integer view, a texel per guest block: not for
+  // block-compressed or subsampled formats (the 64 bits per block load copies DXT1 blocks too).
+  uint32_t direct_dwords_log2, direct_conversion;
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  if (direct_load_pipeline_.pipeline && descriptor.textureType == MTLTextureType2DArray &&
+      format_info->block_width == 1 && format_info->block_height == 1 &&
+      GetDirectLoad((format == host_format.format_signed.format &&
+                     format != host_format.format_unsigned.format)
+                        ? host_format.format_signed.load_shader
+                        : host_format.format_unsigned.load_shader,
+                    direct_dwords_log2, direct_conversion)) {
+    descriptor.usage |= MTLTextureUsageShaderWrite;
+  }
+  descriptor.storageMode = MTLStorageModePrivate;
+  id<MTLTexture> texture = [command_processor_.device() newTextureWithDescriptor:descriptor];
+  if (!texture) {
+    return nullptr;
+  }
+  return std::unique_ptr<Texture>(new MetalTexture(*this, key, texture));
+}
+
+void MetalTextureCache::ForgetResolveTextureChecks(uint32_t dest_base) {
+  for (auto it = resolve_texture_checks_.begin(); it != resolve_texture_checks_.end();) {
+    if ((it->first->key().base_page << 12) == dest_base) {
+      it = resolve_texture_checks_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+MetalTextureCache::LoadShaderIndex MetalTextureCache::GetLoadShader(TextureKey key) const {
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  bool host_format_is_signed;
+  if (IsSignedVersionSeparateForFormat(key)) {
+    host_format_is_signed = bool(key.signed_separate);
+  } else {
+    host_format_is_signed = host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  }
+  return (host_format_is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned)
+      .load_shader;
+}
+
+uint32_t MetalTextureCache::WriteTexturesFromResolve(uint32_t dest_base, uint32_t width,
+                                                     uint32_t height, bool scaled,
+                                                     const ResolveTextureWriter& write) {
+  if (!direct_load_pipeline_.pipeline) {
+    return 0;
+  }
+  static const MTLPixelFormat kViewFormats[] = {MTLPixelFormatR32Uint, MTLPixelFormatRG32Uint,
+                                                MTLPixelFormatRGBA32Uint};
+  bool verify = REXCVAR_GET(metal_texture_load_verify);
+  uint32_t host_width = scaled ? draw_resolution_scale().ScaleXCeil(width) : width;
+  uint32_t host_height = scaled ? draw_resolution_scale().ScaleYCeil(height) : height;
+  uint32_t written = 0;
+  ForEachTextureAtBasePage(
+      dest_base >> 12,
+      [&](Texture& texture, const std::unique_lock<std::recursive_mutex>& global_lock) {
+        const TextureKey& key = texture.key();
+        if (key.dimension != xenos::DataDimension::k2DOrStacked ||
+            key.depth_or_array_size_minus_1 || !key.tiled || key.mip_max_level ||
+            bool(key.scaled_resolve) != scaled || key.width_minus_1 + 1 != width ||
+            key.height_minus_1 + 1 != height || (key.base_page << 12) != dest_base) {
+          return;
+        }
+        // Only a texture this resolve just invalidated: one loaded before, now outdated.
+        if (!texture.base_outdated(global_lock)) {
+          return;
+        }
+        // A base level in a packed mip tail is stored elsewhere in its tail.
+        if (key.packed_mips && key.GetGuestLayout().packed_level == 0) {
+          return;
+        }
+        const FormatInfo* format_info = FormatInfo::Get(key.format);
+        uint32_t dwords_log2, conversion;
+        id<MTLTexture> host_texture = static_cast<MetalTexture&>(texture).texture();
+        if (format_info->block_width != 1 || format_info->block_height != 1 || !host_texture ||
+            !(host_texture.usage & MTLTextureUsageShaderWrite) ||
+            host_texture.width != host_width || host_texture.height != host_height ||
+            !GetDirectLoad(GetLoadShader(key), dwords_log2, conversion)) {
+          return;
+        }
+        id<MTLTexture> target = host_texture;
+        if (verify) {
+          MTLTextureDescriptor* descriptor = [MTLTextureDescriptor new];
+          descriptor.textureType = host_texture.textureType;
+          descriptor.pixelFormat = host_texture.pixelFormat;
+          descriptor.width = host_texture.width;
+          descriptor.height = host_texture.height;
+          descriptor.arrayLength = host_texture.arrayLength;
+          descriptor.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite |
+                             MTLTextureUsagePixelFormatView;
+          descriptor.storageMode = MTLStorageModePrivate;
+          target = [command_processor_.device() newTextureWithDescriptor:descriptor];
+          if (!target) {
+            return;
+          }
+          resolve_texture_checks_[&texture] = {target, dwords_log2};
+        }
+        write([target newTextureViewWithPixelFormat:kViewFormats[dwords_log2]
+                                        textureType:MTLTextureType2D
+                                             levels:NSMakeRange(0, 1)
+                                             slices:NSMakeRange(0, 1)],
+              uint32_t(key.endianness), conversion);
+        if (!verify) {
+          texture.MakeUpToDateAndWatch(global_lock);
+          static_cast<MetalTexture&>(texture).MarkAsUsed();
+          PERF_counter_inc(kResolvesToTextures);
+          ++written;
+        }
+      });
+  return written;
+}
+
+bool MetalTextureCache::LoadTextureDataFromResidentMemoryImpl(Texture& texture, bool load_base,
+                                                              bool load_mips) {
+  MetalTexture& metal_texture = static_cast<MetalTexture&>(texture);
+  TextureKey texture_key = metal_texture.key();
+
+  // Get the pipeline.
+  const HostFormatPair& host_format_pair = GetHostFormatPair(texture_key);
+  bool host_format_is_signed;
+  if (IsSignedVersionSeparateForFormat(texture_key)) {
+    host_format_is_signed = bool(texture_key.signed_separate);
+  } else {
+    host_format_is_signed = host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  }
+  const HostFormat& host_format =
+      host_format_is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned;
+  LoadShaderIndex load_shader = host_format.load_shader;
+  if (load_shader == kLoadShaderIndexUnknown) {
+    return false;
+  }
+  // A texture resolved at a rational scale is loaded from its resolve's scaled surface, read as an
+  // unscaled texture of the host size; at a whole scale, from the scaled resolve buffer.
+  const RationalScaledSurface* rational_surface = nullptr;
+  if (texture_key.scaled_resolve && !draw_resolution_scale().IsWhole()) {
+    rational_surface = GetRationalScaledSurface(texture_key);
+    if (!rational_surface) {
+      return false;
+    }
+  }
+  bool read_scaled_resolve_buffer = texture_key.scaled_resolve && !rational_surface;
+  const LoadPipeline& load_pipeline = read_scaled_resolve_buffer
+                                          ? load_pipelines_scaled_[load_shader]
+                                          : load_pipelines_[load_shader];
+  if (!load_pipeline.pipeline) {
+    return false;
+  }
+  const LoadShaderInfo& load_shader_info = GetLoadShaderInfo(load_shader);
+
+  // Get the guest layout.
+  const texture_util::TextureGuestLayout& guest_layout = metal_texture.guest_layout();
+  xenos::DataDimension dimension = texture_key.dimension;
+  bool is_3d = dimension == xenos::DataDimension::k3D;
+  bool is_3d_tiling = is_3d || metal_texture.force_load_3d_tiling();
+  uint32_t width = rational_surface ? draw_resolution_scale().ScaleXCeil(texture_key.GetWidth())
+                                    : texture_key.GetWidth();
+  uint32_t height = rational_surface ? draw_resolution_scale().ScaleYCeil(texture_key.GetHeight())
+                                     : texture_key.GetHeight();
+  uint32_t depth_or_array_size = texture_key.GetDepthOrArraySize();
+  uint32_t depth = is_3d ? depth_or_array_size : 1;
+  uint32_t array_size = is_3d ? 1 : depth_or_array_size;
+  xenos::TextureFormat guest_format = texture_key.format;
+  const FormatInfo* guest_format_info = FormatInfo::Get(guest_format);
+  uint32_t block_width = guest_format_info->block_width;
+  uint32_t block_height = guest_format_info->block_height;
+  uint32_t bytes_per_block = guest_format_info->bytes_per_block();
+  uint32_t level_first = load_base ? 0 : 1;
+  uint32_t level_last = load_mips ? texture_key.mip_max_level : 0;
+  assert_true(level_first <= level_last);
+  uint32_t level_packed = guest_layout.packed_level;
+  uint32_t level_stored_first = std::min(level_first, level_packed);
+  uint32_t level_stored_last = std::min(level_last, level_packed);
+  // Textures resolved at the draw resolution scale have that many more texels, read from the scaled
+  // resolve buffer.
+  uint32_t texture_resolution_scale_x = read_scaled_resolve_buffer ? draw_resolution_scale_x() : 1;
+  uint32_t texture_resolution_scale_y = read_scaled_resolve_buffer ? draw_resolution_scale_y() : 1;
+  uint32_t texture_resolution_scale_area = texture_resolution_scale_x * texture_resolution_scale_y;
+
+  // The loop counter can mean two things depending on whether the packed mip tail is stored as
+  // mip 0, because in this case, it would be ambiguous since both the base and the mips would be
+  // on "level 0", but stored in separate places.
+  uint32_t loop_level_first, loop_level_last;
+  if (level_packed == 0) {
+    // Packed mip tail is the level 0 - may need to load mip tails for the base, the mips, or
+    // both. Loop iteration 0 - base packed mip tail, 1 - mips packed mip tail.
+    loop_level_first = uint32_t(level_first != 0);
+    loop_level_last = uint32_t(level_last != 0);
+  } else {
+    // Packed mip tail is not the level 0. Loop iteration is the actual level being loaded.
+    loop_level_first = level_stored_first;
+    loop_level_last = level_stored_last;
+  }
+
+  // Get the host layout and the buffer.
+  uint32_t host_block_width = host_format.block_compressed ? block_width : 1;
+  uint32_t host_block_height = host_format.block_compressed ? block_height : 1;
+  uint32_t host_x_blocks_per_thread = UINT32_C(1)
+                                      << load_shader_info.guest_x_blocks_per_thread_log2;
+  if (!host_format.block_compressed) {
+    // Decompressing guest blocks.
+    host_x_blocks_per_thread *= block_width;
+  }
+  size_t host_buffer_size = 0;
+  struct HostLayout {
+    size_t offset_bytes;
+    size_t slice_size_bytes;
+    uint32_t x_pitch_blocks;
+    uint32_t y_pitch_blocks;
+  };
+  HostLayout host_layout_base;
+  // Indexing is the same as for guest stored mips: 1...min(level_last, level_packed) if
+  // level_packed is not 0, or only 0 if level_packed == 0.
+  HostLayout host_layout_mips[xenos::kTextureMaxMips];
+  for (uint32_t loop_level = loop_level_first; loop_level <= loop_level_last; ++loop_level) {
+    bool is_base = loop_level == 0;
+    uint32_t level = (level_packed == 0) ? 0 : loop_level;
+    HostLayout& level_host_layout = is_base ? host_layout_base : host_layout_mips[level];
+    level_host_layout.offset_bytes = host_buffer_size;
+    uint32_t level_guest_x_extent_texels;
+    uint32_t level_guest_y_extent_texels;
+    uint32_t level_guest_z_extent_texels;
+    if (level == level_packed) {
+      // Loading the packed tail for the base or the mips - load the whole tail to copy regions
+      // out of it.
+      const texture_util::TextureGuestLayout::Level& guest_layout_packed =
+          is_base ? guest_layout.base : guest_layout.mips[level];
+      level_guest_x_extent_texels = guest_layout_packed.x_extent_blocks * block_width;
+      level_guest_y_extent_texels = guest_layout_packed.y_extent_blocks * block_height;
+      level_guest_z_extent_texels = guest_layout_packed.z_extent;
+    } else {
+      level_guest_x_extent_texels = std::max(width >> level, UINT32_C(1));
+      level_guest_y_extent_texels = std::max(height >> level, UINT32_C(1));
+      level_guest_z_extent_texels = std::max(depth >> level, UINT32_C(1));
+    }
+    level_host_layout.x_pitch_blocks =
+        rex::round_up((level_guest_x_extent_texels * texture_resolution_scale_x +
+                       (host_block_width - 1)) /
+                          host_block_width,
+                      host_x_blocks_per_thread);
+    level_host_layout.y_pitch_blocks =
+        (level_guest_y_extent_texels * texture_resolution_scale_y + (host_block_height - 1)) /
+        host_block_height;
+    level_host_layout.slice_size_bytes = size_t(load_shader_info.bytes_per_host_block) *
+                                         level_host_layout.x_pitch_blocks *
+                                         level_host_layout.y_pitch_blocks *
+                                         level_guest_z_extent_texels;
+    host_buffer_size += level_host_layout.slice_size_bytes * array_size;
+  }
+  // Source ranges in the shared memory, or in the scaled resolve buffer for a texture resolved at
+  // the draw resolution scale. Aligned because if the data for a vector is provided partially, the
+  // value read may still be (0, 0, 0, 0), and small (especially linear) textures would not be
+  // loaded correctly.
+  uint32_t source_length_alignment_log2 = load_shader_info.source_bpe_log2;
+  uint64_t source_base_start = 0, source_mips_start = 0;
+  if (level_first == 0) {
+    uint64_t source_base_range;
+    if (rational_surface) {
+      source_base_start = 0;
+      source_base_range = rational_surface->buffer.length;
+    } else if (read_scaled_resolve_buffer) {
+      if (!GetScaledResolveRange(texture_key.base_page << 12, metal_texture.GetGuestBaseSize(),
+                                 source_length_alignment_log2, source_base_start,
+                                 source_base_range)) {
+        return false;
+      }
+    } else {
+      source_base_start = uint64_t(texture_key.base_page) << 12;
+      source_base_range = rex::align(uint64_t(metal_texture.GetGuestBaseSize()),
+                                     uint64_t(1) << source_length_alignment_log2);
+      if (source_base_range > uint64_t(SharedMemory::kBufferSize) - source_base_start) {
+        return false;
+      }
+    }
+  }
+  if (level_last != 0) {
+    uint64_t source_mips_range;
+    if (read_scaled_resolve_buffer) {
+      if (!GetScaledResolveRange(texture_key.mip_page << 12, metal_texture.GetGuestMipsSize(),
+                                 source_length_alignment_log2, source_mips_start,
+                                 source_mips_range)) {
+        return false;
+      }
+    } else {
+      source_mips_start = uint64_t(texture_key.mip_page) << 12;
+      source_mips_range = rex::align(uint64_t(metal_texture.GetGuestMipsSize()),
+                                     uint64_t(1) << source_length_alignment_log2);
+      if (source_mips_range > uint64_t(SharedMemory::kBufferSize) - source_mips_start) {
+        return false;
+      }
+    }
+  }
+  id<MTLBuffer> source_buffer = rational_surface ? rational_surface->buffer
+                                : read_scaled_resolve_buffer
+                                    ? scaled_resolve_buffer_
+                                    : static_cast<MetalSharedMemory&>(shared_memory()).buffer();
+
+  // For the encoder labels of GPU traces (gpu_debug_markers): the format, size and address, and
+  // where it is read from.
+  NSString* debug_label = nil;
+  if (command_processor_.debug_labels_enabled()) {
+    debug_label = [NSString
+        stringWithFormat:@"Texture load%s: format %u %ux%u at 0x%08X%s",
+                         rational_surface ? " (scaled surface)"
+                         : read_scaled_resolve_buffer ? " (scaled resolve buffer)"
+                                                      : "",
+                         uint32_t(texture_key.format), texture_key.GetWidth(),
+                         texture_key.GetHeight(), texture_key.base_page << 12,
+                         texture_key.mip_max_level ? " with mips" : ""];
+  }
+
+  // What every load does at the end: the texture is in use, and compared with what a resolve
+  // wrote for it (metal_texture_load_verify, WriteTexturesFromResolve).
+  id<MTLTexture> host_texture = metal_texture.texture();
+  auto finish = [&]() {
+    metal_texture.MarkAsUsed();
+    auto check = resolve_texture_checks_.find(&texture);
+    if (check != resolve_texture_checks_.end()) {
+      if (load_base) {
+        CompareDirectLoad(texture_key, check->second.texture, host_texture,
+                          check->second.dwords_log2, 0, 0, "Resolve to texture check");
+      }
+      resolve_texture_checks_.erase(check);
+    }
+  };
+
+  // Straight into the texture (metal_texture_load_direct): the formats GetDirectLoad has, in a 2D
+  // texture (its usage then has shader writes), for levels none of which is in a packed mip tail
+  // (stored at an offset in the tail's own level).
+  uint32_t direct_dwords_log2 = 0, direct_conversion = 0;
+  bool direct = direct_load_pipeline_.pipeline && block_width == 1 && block_height == 1 &&
+                !host_format.block_compressed &&
+                (host_texture.usage & MTLTextureUsageShaderWrite) &&
+                host_texture.textureType == MTLTextureType2DArray && !is_3d_tiling &&
+                level_last < level_packed &&
+                GetDirectLoad(load_shader, direct_dwords_log2, direct_conversion);
+  bool direct_verify = direct && REXCVAR_GET(metal_texture_load_verify);
+  // The usual load writes the texture, or with metal_texture_load_verify one of its own compared
+  // with the direct load afterwards.
+  id<MTLTexture> usual_texture = host_texture;
+  if (direct) {
+    static const MTLPixelFormat kViewFormats[] = {MTLPixelFormatR32Uint, MTLPixelFormatRG32Uint,
+                                                  MTLPixelFormatRGBA32Uint};
+    id<MTLComputeCommandEncoder> direct_compute = command_processor_.GetComputeEncoder(
+        rex::perf::CounterId::kRenderPassEndsTextureLoad,
+        debug_label ? [debug_label stringByAppendingString:@" (direct)"] : nil);
+    [direct_compute setComputePipelineState:direct_load_pipeline_.pipeline];
+    TextureLoadDirectConstants direct_constants = {};
+    direct_constants.tiled = uint32_t(texture_key.tiled);
+    direct_constants.endian = uint32_t(texture_key.endianness);
+    direct_constants.scale_x = texture_resolution_scale_x;
+    direct_constants.scale_y = texture_resolution_scale_y;
+    direct_constants.conversion = direct_conversion;
+    direct_constants.dwords_log2 = direct_dwords_log2;
+    for (uint32_t level = level_first; level <= level_last; ++level) {
+      bool is_base = level == 0;
+      const texture_util::TextureGuestLayout::Level& level_guest_layout =
+          is_base ? guest_layout.base : guest_layout.mips[level];
+      // As the load shaders take it: texels for a tiled texture (one texel per block for these
+      // formats), bytes for a linear one; a scaled surface has its own.
+      uint32_t guest_pitch = level_guest_layout.row_pitch_bytes;
+      if (texture_key.tiled) {
+        guest_pitch /= bytes_per_block;
+      }
+      if (rational_surface) {
+        guest_pitch = rational_surface->pitch;
+      }
+      direct_constants.guest_pitch = guest_pitch;
+      direct_constants.width = std::max((width * texture_resolution_scale_x) >> level, UINT32_C(1));
+      direct_constants.height =
+          std::max((height * texture_resolution_scale_y) >> level, UINT32_C(1));
+      [direct_compute setBuffer:source_buffer
+                         offset:NSUInteger(is_base ? source_base_start : source_mips_start)
+                        atIndex:0];
+      uint32_t guest_offset =
+          is_base ? 0 : guest_layout.mip_offsets_bytes[level] * texture_resolution_scale_area;
+      for (uint32_t slice = 0; slice < array_size; ++slice) {
+        direct_constants.guest_offset = guest_offset;
+        id<MTLTexture> view =
+            [host_texture newTextureViewWithPixelFormat:kViewFormats[direct_dwords_log2]
+                                            textureType:MTLTextureType2D
+                                                 levels:NSMakeRange(level, 1)
+                                                 slices:NSMakeRange(slice, 1)];
+        [direct_compute setTexture:view atIndex:0];
+        [direct_compute setBytes:&direct_constants length:sizeof(direct_constants) atIndex:1];
+        [direct_compute dispatchThreads:MTLSizeMake(direct_constants.width,
+                                                    direct_constants.height, 1)
+                  threadsPerThreadgroup:direct_load_pipeline_.threads_per_threadgroup];
+        PERF_counter_inc(kHostDispatches);
+        guest_offset += level_guest_layout.array_slice_stride_bytes * texture_resolution_scale_area;
+      }
+    }
+    if (!direct_verify) {
+      finish();
+      return true;
+    }
+    MTLTextureDescriptor* descriptor = [MTLTextureDescriptor new];
+    descriptor.textureType = host_texture.textureType;
+    descriptor.pixelFormat = host_texture.pixelFormat;
+    descriptor.width = host_texture.width;
+    descriptor.height = host_texture.height;
+    descriptor.arrayLength = host_texture.arrayLength;
+    descriptor.mipmapLevelCount = host_texture.mipmapLevelCount;
+    descriptor.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+    descriptor.storageMode = MTLStorageModePrivate;
+    usual_texture = [command_processor_.device() newTextureWithDescriptor:descriptor];
+    if (!usual_texture) {
+      finish();
+      return true;
+    }
+  }
+
+  MetalCommandProcessor::ScratchBuffer scratch_buffer =
+      command_processor_.AcquireScratchBuffer(host_buffer_size);
+  if (!scratch_buffer.buffer) {
+    return false;
+  }
+
+  // Untile and convert into the scratch buffer.
+  id<MTLComputeCommandEncoder> compute = command_processor_.GetComputeEncoder(
+      rex::perf::CounterId::kRenderPassEndsTextureLoad, debug_label);
+  [compute setComputePipelineState:load_pipeline.pipeline];
+  [compute setBuffer:scratch_buffer.buffer
+              offset:scratch_buffer.offset
+             atIndex:kLoadBufferDestination];
+
+  LoadConstants load_constants;
+  // 3 bits for each scale.
+  assert_true(texture_resolution_scale_x <= 7);
+  assert_true(texture_resolution_scale_y <= 7);
+  load_constants.is_tiled_3d_endian_scale = uint32_t(texture_key.tiled) |
+                                            (uint32_t(is_3d_tiling) << 1) |
+                                            (uint32_t(texture_key.endianness) << 2) |
+                                            (texture_resolution_scale_x << 4) |
+                                            (texture_resolution_scale_y << 7);
+
+  uint32_t guest_x_blocks_per_group_log2 = load_shader_info.GetGuestXBlocksPerGroupLog2();
+  for (uint32_t loop_level = loop_level_first; loop_level <= loop_level_last; ++loop_level) {
+    bool is_base = loop_level == 0;
+    uint32_t level = (level_packed == 0) ? 0 : loop_level;
+
+    // The source buffer starts at the base or the mips, offsets are relative to that.
+    [compute setBuffer:source_buffer
+                offset:NSUInteger(is_base ? source_base_start : source_mips_start)
+               atIndex:kLoadBufferSource];
+    load_constants.guest_offset = 0;
+    if (!is_base) {
+      load_constants.guest_offset +=
+          guest_layout.mip_offsets_bytes[level] * texture_resolution_scale_area;
+    }
+    const texture_util::TextureGuestLayout::Level& level_guest_layout =
+        is_base ? guest_layout.base : guest_layout.mips[level];
+    uint32_t level_guest_pitch = level_guest_layout.row_pitch_bytes;
+    if (texture_key.tiled) {
+      // Shaders expect pitch in blocks for tiled textures.
+      level_guest_pitch /= bytes_per_block;
+      assert_zero(level_guest_pitch & (xenos::kTextureTileWidthHeight - 1));
+    }
+    if (rational_surface) {
+      // The surface's own pitch, in texels (one texel per block).
+      level_guest_pitch = rational_surface->pitch;
+    }
+    load_constants.guest_pitch_aligned = level_guest_pitch;
+    load_constants.guest_z_stride_block_rows_aligned = level_guest_layout.z_slice_stride_block_rows;
+    assert_true(!is_3d_tiling || !(load_constants.guest_z_stride_block_rows_aligned &
+                                   (xenos::kTextureTileWidthHeight - 1)));
+
+    uint32_t level_width, level_height, level_depth;
+    if (level == level_packed) {
+      // This is the packed mip tail, containing not only the specified level, but also other
+      // levels at different offsets - load the entire needed extents.
+      level_width = level_guest_layout.x_extent_blocks * block_width;
+      level_height = level_guest_layout.y_extent_blocks * block_height;
+      level_depth = level_guest_layout.z_extent;
+    } else {
+      level_width = std::max(width >> level, UINT32_C(1));
+      level_height = std::max(height >> level, UINT32_C(1));
+      level_depth = std::max(depth >> level, UINT32_C(1));
+    }
+    load_constants.size_blocks[0] =
+        (level_width + (block_width - 1)) / block_width * texture_resolution_scale_x;
+    load_constants.size_blocks[1] =
+        (level_height + (block_height - 1)) / block_height * texture_resolution_scale_y;
+    load_constants.size_blocks[2] = level_depth;
+    load_constants.height_texels = level_height;
+
+    uint32_t group_count_x =
+        (load_constants.size_blocks[0] + ((UINT32_C(1) << guest_x_blocks_per_group_log2) - 1)) >>
+        guest_x_blocks_per_group_log2;
+    uint32_t group_count_y =
+        (load_constants.size_blocks[1] + ((UINT32_C(1) << kLoadGuestYBlocksPerGroupLog2) - 1)) >>
+        kLoadGuestYBlocksPerGroupLog2;
+
+    const HostLayout& level_host_layout = is_base ? host_layout_base : host_layout_mips[level];
+    load_constants.host_offset = uint32_t(level_host_layout.offset_bytes);
+    load_constants.host_pitch =
+        load_shader_info.bytes_per_host_block * level_host_layout.x_pitch_blocks;
+
+    for (uint32_t slice = 0; slice < array_size; ++slice) {
+      [compute setBytes:&load_constants length:sizeof(load_constants) atIndex:kLoadBufferConstants];
+      [compute dispatchThreadgroups:MTLSizeMake(group_count_x, group_count_y,
+                                                load_constants.size_blocks[2])
+              threadsPerThreadgroup:load_pipeline.threads_per_threadgroup];
+      PERF_counter_inc(kHostDispatches);
+      load_constants.guest_offset +=
+          level_guest_layout.array_slice_stride_bytes * texture_resolution_scale_area;
+      load_constants.host_offset += uint32_t(level_host_layout.slice_size_bytes);
+    }
+  }
+
+  // Copy from the scratch buffer to the texture.
+  id<MTLBlitCommandEncoder> blit = command_processor_.GetBlitEncoder(
+      rex::perf::CounterId::kRenderPassEndsTextureLoad,
+      debug_label ? [debug_label stringByAppendingString:@" (copy to texture)"] : nil);
+  for (uint32_t level = level_first; level <= level_last; ++level) {
+    const HostLayout& level_host_layout =
+        level != 0 ? host_layout_mips[std::min(level, level_packed)] : host_layout_base;
+    size_t level_offset = level_host_layout.offset_bytes;
+    if (level >= level_packed) {
+      uint32_t level_offset_blocks_x, level_offset_blocks_y, level_offset_z;
+      texture_util::GetPackedMipOffset(width, height, depth, guest_format, level,
+                                       level_offset_blocks_x, level_offset_blocks_y,
+                                       level_offset_z);
+      uint32_t level_offset_host_blocks_x = texture_resolution_scale_x * level_offset_blocks_x;
+      uint32_t level_offset_host_blocks_y = texture_resolution_scale_y * level_offset_blocks_y;
+      if (!host_format.block_compressed) {
+        level_offset_host_blocks_x *= block_width;
+        level_offset_host_blocks_y *= block_height;
+      }
+      level_offset += size_t(load_shader_info.bytes_per_host_block) *
+                      (level_offset_host_blocks_x +
+                       level_host_layout.x_pitch_blocks *
+                           (level_offset_host_blocks_y +
+                            level_host_layout.y_pitch_blocks * size_t(level_offset_z)));
+    }
+    size_t bytes_per_row =
+        size_t(load_shader_info.bytes_per_host_block) * level_host_layout.x_pitch_blocks;
+    size_t bytes_per_image = bytes_per_row * level_host_layout.y_pitch_blocks;
+    MTLSize level_size =
+        MTLSizeMake(std::max((width * texture_resolution_scale_x) >> level, UINT32_C(1)),
+                    std::max((height * texture_resolution_scale_y) >> level, UINT32_C(1)),
+                    std::max(depth >> level, UINT32_C(1)));
+    for (uint32_t slice = 0; slice < array_size; ++slice) {
+      [blit copyFromBuffer:scratch_buffer.buffer
+                 sourceOffset:scratch_buffer.offset + level_offset +
+                              level_host_layout.slice_size_bytes * slice
+            sourceBytesPerRow:bytes_per_row
+          sourceBytesPerImage:host_texture.textureType == MTLTextureType3D ? bytes_per_image : 0
+                   sourceSize:level_size
+                    toTexture:usual_texture
+             destinationSlice:slice
+             destinationLevel:level
+            destinationOrigin:MTLOriginMake(0, 0, 0)];
+      PERF_counter_inc(kHostCopies);
+    }
+  }
+  if (direct_verify) {
+    for (uint32_t level = level_first; level <= level_last; ++level) {
+      for (uint32_t slice = 0; slice < array_size; ++slice) {
+        CompareDirectLoad(texture_key, host_texture, usual_texture, direct_dwords_log2, level,
+                          slice);
+      }
+    }
+  }
+  finish();
+  return true;
+}
+
+void MetalTextureCache::UpdateTextureBindingsImpl(uint32_t fetch_constant_mask) {
+  uint32_t bindings_remaining = fetch_constant_mask;
+  uint32_t binding_index;
+  while (rex::bit_scan_forward(bindings_remaining, &binding_index)) {
+    bindings_remaining &= ~(UINT32_C(1) << binding_index);
+    MetalTextureBinding& metal_binding = metal_texture_bindings_[binding_index];
+    metal_binding.Reset();
+    const TextureBinding* binding = GetValidTextureBinding(binding_index);
+    if (!binding) {
+      continue;
+    }
+    const HostFormatPair& host_format_pair = GetHostFormatPair(binding->key);
+    bool uses_unsigned = texture_util::IsAnySignNotSigned(binding->swizzled_signs);
+    bool uses_signed = texture_util::IsAnySignSigned(binding->swizzled_signs);
+    xenos::TextureFormat format = binding->key.format;
+    if (uses_unsigned && host_format_pair.format_unsigned.format == MTLPixelFormatInvalid) {
+      unsupported_format_features_used_[uint32_t(format)] |= kUnsupportedUnormBit;
+    }
+    if (uses_signed && host_format_pair.format_signed.format == MTLPixelFormatInvalid) {
+      unsupported_format_features_used_[uint32_t(format)] |= kUnsupportedSnormBit;
+    }
+    if (IsSignedVersionSeparateForFormat(binding->key)) {
+      if (binding->texture && uses_unsigned &&
+          host_format_pair.format_unsigned.format != MTLPixelFormatInvalid) {
+        metal_binding.texture_unsigned =
+            static_cast<MetalTexture*>(binding->texture)->GetView(false, binding->host_swizzle);
+      }
+      if (binding->texture_signed && uses_signed &&
+          host_format_pair.format_signed.format != MTLPixelFormatInvalid) {
+        metal_binding.texture_signed =
+            static_cast<MetalTexture*>(binding->texture_signed)->GetView(true, binding->host_swizzle);
+      }
+    } else {
+      MetalTexture* texture = static_cast<MetalTexture*>(binding->texture);
+      if (texture) {
+        if (uses_unsigned && host_format_pair.format_unsigned.format != MTLPixelFormatInvalid) {
+          metal_binding.texture_unsigned = texture->GetView(false, binding->host_swizzle);
+        }
+        if (uses_signed && host_format_pair.format_signed.format != MTLPixelFormatInvalid) {
+          metal_binding.texture_signed = texture->GetView(true, binding->host_swizzle);
+        }
+      }
+    }
+  }
+}
+
+const MetalTextureCache::HostFormatPair& MetalTextureCache::GetHostFormatPair(
+    TextureKey key) const {
+  const HostFormatPair& host_format_pair = host_formats_[uint32_t(key.format)];
+  if (!host_format_pair.format_unsigned.block_compressed &&
+      !host_format_pair.format_signed.block_compressed) {
+    return host_format_pair;
+  }
+  // Decompress only when the block alignment is actually violated, as Direct3D 12 does.
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  if (!(key.GetWidth() & (format_info->block_width - 1)) &&
+      !(key.GetHeight() & (format_info->block_height - 1))) {
+    return host_format_pair;
+  }
+  switch (key.format) {
+    case xenos::TextureFormat::k_Cr_Y1_Cb_Y0_REP:
+      return kHostFormatGBGRUnaligned;
+    case xenos::TextureFormat::k_Y1_Cr_Y0_Cb_REP:
+      return kHostFormatBGRGUnaligned;
+    case xenos::TextureFormat::k_DXT1:
+    case xenos::TextureFormat::k_DXT1_AS_16_16_16_16:
+      return kHostFormatDXT1Unaligned;
+    case xenos::TextureFormat::k_DXT2_3:
+    case xenos::TextureFormat::k_DXT2_3_AS_16_16_16_16:
+      return kHostFormatDXT2_3Unaligned;
+    case xenos::TextureFormat::k_DXT4_5:
+    case xenos::TextureFormat::k_DXT4_5_AS_16_16_16_16:
+      return kHostFormatDXT4_5Unaligned;
+    case xenos::TextureFormat::k_DXN:
+      return kHostFormatDXNUnaligned;
+    case xenos::TextureFormat::k_DXT5A:
+      return kHostFormatDXT5AUnaligned;
+    default:
+      return host_format_pair;
+  }
+}
+
+xenos::ClampMode MetalTextureCache::NormalizeClampMode(xenos::ClampMode clamp_mode) const {
+  if (clamp_mode == xenos::ClampMode::kClampToHalfway) {
+    // No GL_CLAMP (clamp to half edge, half border) equivalent, and there's no Direct3D 9
+    // equivalent anyway.
+    return xenos::ClampMode::kClampToEdge;
+  }
+  if (clamp_mode == xenos::ClampMode::kMirrorClampToHalfway ||
+      clamp_mode == xenos::ClampMode::kMirrorClampToBorder) {
+    // Metal has only mirror clamp to edge.
+    return xenos::ClampMode::kMirrorClampToEdge;
+  }
+  return clamp_mode;
+}
