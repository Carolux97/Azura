+}
+
+void VulkanCommandProcessor::ShutdownGpuCheckpoints() {
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+  if (gpu_checkpoint_marker_mapping_) {
+    dfn.vkUnmapMemory(device, gpu_checkpoint_marker_memory_);
+    gpu_checkpoint_marker_mapping_ = nullptr;
+  }
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device,
+                                         gpu_checkpoint_marker_buffer_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, gpu_checkpoint_marker_memory_);
+  gpu_checkpoints_.clear();
+  gpu_checkpoints_enabled_ = false;
+}
+
+void VulkanCommandProcessor::RecordGpuCheckpoint(const char* kind, uint64_t vertex_shader_hash,
+                                                 uint64_t pixel_shader_hash, uint32_t vertex_count,
+                                                 uint32_t primitive_type,
+                                                 uint32_t index_buffer_type,
+                                                 uint32_t guest_index_base) {
+  if (!gpu_checkpoints_enabled_ || !submission_open_) {
+    return;
+  }
+  uint32_t marker = gpu_checkpoint_next_marker_++;
+  GpuCheckpoint& checkpoint = gpu_checkpoints_[marker % kGpuCheckpointCount];
+  checkpoint.kind = kind;
+  checkpoint.vertex_shader_hash = vertex_shader_hash;
+  checkpoint.pixel_shader_hash = pixel_shader_hash;
+  checkpoint.submission = GetCurrentSubmission();
+  checkpoint.marker = marker;
+  checkpoint.vertex_count = vertex_count;
+  checkpoint.primitive_type = primitive_type;
+  checkpoint.index_buffer_type = index_buffer_type;
+  checkpoint.guest_index_base = guest_index_base;
+  deferred_command_buffer_.CmdGpuCheckpoint(marker, gpu_checkpoint_marker_buffer_);
+}
+
+void VulkanCommandProcessor::LogHostGpuLoss() {
+  if (!gpu_checkpoints_enabled_) {
+    return;
+  }
+  // The marks before each piece of work: the GPU finished everything before the last mark at the
+  // bottom of the pipeline, and started everything before the last mark at the top, so the work
+  // from the bottom mark up to the top mark is what did not finish.
+  uint32_t top = 0;
+  uint32_t bottom = 0;
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  if (dfn.vkGetQueueCheckpointDataNV) {
+    ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+        vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+    uint32_t count = 0;
+    dfn.vkGetQueueCheckpointDataNV(queue_acquisition.queue(), &count, nullptr);
+    VkCheckpointDataNV checkpoint = {};
+    checkpoint.sType = VK_STRUCTURE_TYPE_CHECKPOINT_DATA_NV;
+    std::vector<VkCheckpointDataNV> data(count, checkpoint);
+    dfn.vkGetQueueCheckpointDataNV(queue_acquisition.queue(), &count, data.data());
+    for (uint32_t i = 0; i < count; ++i) {
+      uint32_t marker = uint32_t(reinterpret_cast<uintptr_t>(data[i].pCheckpointMarker));
+      REXGPU_ERROR("GPU checkpoints: NV checkpoint {} reached at stage 0x{:X}", marker,
+                   uint32_t(data[i].stage));
+      if (data[i].stage & VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT) {
+        top = std::max(top, marker);
+      }
+      if (data[i].stage & VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT) {
+        bottom = bottom ? std::min(bottom, marker) : marker;
+      }
+    }
+  } else if (gpu_checkpoint_marker_mapping_) {
+    top = gpu_checkpoint_marker_mapping_[0];
+    bottom = gpu_checkpoint_marker_mapping_[1];
+    REXGPU_ERROR("GPU checkpoints: AMD buffer markers top {} bottom {}", top, bottom);
+  }
+  uint32_t last = gpu_checkpoint_next_marker_ - 1;
+  REXGPU_ERROR("GPU checkpoints: last mark recorded {}, last started {}, last finished {}", last,
+               top, bottom);
+  if (!bottom) {
+    bottom = top;
+  }
+  if (!top || !bottom) {
+    return;
+  }
+  // The work after the last finished mark (the one that did not finish) and a few after it.
+  uint32_t first = bottom;
+  uint32_t end = std::min(std::max(top, bottom) + 4, last + 1);
+  if (end - first > 32) {
+    end = first + 32;
+  }
+  for (uint32_t marker = first; marker < end; ++marker) {
+    const GpuCheckpoint& checkpoint = gpu_checkpoints_[marker % kGpuCheckpointCount];
+    if (checkpoint.marker != marker) {
+      continue;
+    }
+    REXGPU_ERROR(
+        "GPU checkpoints: mark {}{}: {} (submission {}) VS {:016X} PS {:016X} vertices {} "
+        "primitive {} index buffer type {} guest index base 0x{:08X}",
+        marker, marker == bottom ? " (not finished)" : "", checkpoint.kind ? checkpoint.kind : "?",
+        checkpoint.submission, checkpoint.vertex_shader_hash, checkpoint.pixel_shader_hash,
+        checkpoint.vertex_count, checkpoint.primitive_type, checkpoint.index_buffer_type,
+        checkpoint.guest_index_base);
+  }
+}
