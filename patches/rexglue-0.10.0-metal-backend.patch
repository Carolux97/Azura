+    return 0u;
+  }
+  uint mantissa = f24 & 0xFFFFFu;
+  uint exponent = f24 >> 20;
+  if (exponent == 0u) {
+    uint mantissa_lzcnt = clz(mantissa) - (32u - 21u);
+    exponent = uint(1 - int(mantissa_lzcnt));
+    mantissa = (mantissa << mantissa_lzcnt) & 0xFFFFFu;
+  }
+  return ((exponent + 112u) << 23) | (mantissa << 3);
