+void VulkanCommandProcessor::InitializeGpuTimeQueries() {
+  gpu_time_query_pool_ = VK_NULL_HANDLE;
+  gpu_time_last_end_ticks_ = 0;
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  if (!vulkan_device->properties().timestampValidBitsGraphicsCompute) {
+    REXGPU_INFO("VulkanCommandProcessor: the queue has no timestamps, host_gpu_time_us stays 0");
+    return;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkQueryPoolCreateInfo pool_info = {};
+  pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+  pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+  pool_info.queryCount = kGpuTimeQuerySubmissionSlots * 2;
+  if (dfn.vkCreateQueryPool(vulkan_device->device(), &pool_info, nullptr,
+                            &gpu_time_query_pool_) != VK_SUCCESS) {
+    REXGPU_WARN("VulkanCommandProcessor: failed to create the GPU time query pool");
+    gpu_time_query_pool_ = VK_NULL_HANDLE;
+  }
+}
+
+void VulkanCommandProcessor::ShutdownGpuTimeQueries() {
+  if (gpu_time_query_pool_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+    vulkan_device->functions().vkDestroyQueryPool(vulkan_device->device(), gpu_time_query_pool_,
+                                                  nullptr);
+    gpu_time_query_pool_ = VK_NULL_HANDLE;
+  }
+}
+
+void VulkanCommandProcessor::AccountGpuTimeOfCompletedSubmissions(uint64_t first_submission,
+                                                                  uint64_t last_submission) {
+  if (gpu_time_query_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  uint32_t valid_bits = vulkan_device->properties().timestampValidBitsGraphicsCompute;
+  uint64_t mask = valid_bits >= 64 ? ~uint64_t(0) : (uint64_t(1) << valid_bits) - 1;
+  double period_us = double(vulkan_device->properties().timestampPeriod) * 0.001;
+  for (uint64_t submission = first_submission; submission <= last_submission; ++submission) {
+    uint32_t first_query = uint32_t(submission % kGpuTimeQuerySubmissionSlots) * 2;
+    uint64_t timestamps[2];
+    // The submission's fence has signalled, so the results are available without waiting.
+    if (dfn.vkGetQueryPoolResults(vulkan_device->device(), gpu_time_query_pool_, first_query, 2,
+                                  sizeof(timestamps), timestamps, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    uint64_t start = timestamps[0] & mask;
+    uint64_t end = timestamps[1] & mask;
+    if (end < start) {
+      continue;
+    }
+    // Count the part overlapping the previous submissions once.
+    start = std::max(start, gpu_time_last_end_ticks_);
+    if (end > start) {
+      PERF_counter_add(kHostGpuTimeUs, int64_t(double(end - start) * period_us));
+    }
+    gpu_time_last_end_ticks_ = std::max(gpu_time_last_end_ticks_, end);
+  }
+}
