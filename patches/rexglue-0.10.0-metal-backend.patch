+namespace {
+
+// The position a vertex shader exports, for EstimateVertexRectangle.
+class PositionExportSink : public ShaderInterpreter::ExportSink {
+ public:
+  void Export(ucode::ExportRegister export_register, const float* value,
+              uint32_t value_mask) override {
+    if (export_register == ucode::ExportRegister::kVSPosition) {
+      for (uint32_t i = 0; i < 4; ++i) {
+        if (value_mask & (uint32_t(1) << i)) {
+          position_[i] = value[i];
+          written_ |= uint32_t(1) << i;
+        }
+      }
+    }
+  }
+  void Reset() { written_ = 0; }
+  bool has(uint32_t mask) const { return (written_ & mask) == mask; }
+  float operator[](uint32_t i) const { return position_[i]; }
+
+ private:
+  float position_[4] = {};
+  uint32_t written_ = 0;
+};
