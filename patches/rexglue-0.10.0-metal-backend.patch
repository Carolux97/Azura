+void MetalCommandProcessor::PrepareForWait() {
+  // The guest may be waiting for work that is still only encoded.
+  if (accurate_fences_ && submission_open_ && submission_has_work_) {
+    EndSubmission(false);
+  }
+}
+
+void MetalCommandProcessor::EndEncoder(rex::perf::CounterId render_pass_end_reason) {
+  switch (encoder_type_) {
+    case EncoderType::kRender:
+      [render_encoder_ endEncoding];
+      render_encoder_ = nil;
+      if (render_pass_end_reason == rex::perf::CounterId::kRenderPassEndsResolve) {
+        render_pass_ended_by_resolve_ = current_render_pass_;
+        render_pass_ended_by_native_resolve_ = in_native_resolve_;
+      }
+      current_render_pass_ = MetalRenderPass();
+#ifdef REXGLUE_ENABLE_PERF_COUNTERS
+      rex::perf::IncrementCounter(render_pass_end_reason);
+#else
+      (void)render_pass_end_reason;
+#endif
+      break;
+    case EncoderType::kCompute:
+      [compute_encoder_ endEncoding];
+      compute_encoder_ = nil;
+      break;
+    case EncoderType::kBlit:
+      [blit_encoder_ endEncoding];
+      blit_encoder_ = nil;
+      break;
+    case EncoderType::kNone:
+      break;
+  }
+  encoder_type_ = EncoderType::kNone;
+}
+
+id<MTLComputeCommandEncoder> MetalCommandProcessor::GetComputeEncoder(
+    rex::perf::CounterId end_reason, NSString* debug_label) {
+  BeginSubmission(false);
+  // Compute work may read the render targets: pending clears go first.
+  ApplyPendingClears(end_reason);
+  bool labelled = debug_label && debug_labels_enabled_;
+  if (encoder_type_ == EncoderType::kCompute && !labelled) {
+    return compute_encoder_;
+  }
+  EndEncoder(end_reason);
+  compute_encoder_ = [command_buffer_ computeCommandEncoder];
+  compute_encoder_.label = labelled ? debug_label : GetEncoderLabel(end_reason);
+  encoder_type_ = EncoderType::kCompute;
+  submission_has_work_ = true;
+  return compute_encoder_;
+}
