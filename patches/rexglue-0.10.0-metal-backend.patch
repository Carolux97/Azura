+
+#include "metal_presenter.h"
+
+#include "metal_immediate_drawer.h"
+#include "metal_spirv.h"
+
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+#include <rex/assert.h>
+#include <rex/logging.h>
+#include <rex/ui/surface_mac.h>
+
+namespace rex::graphics::metal {
+
+// AMD FidelityFX CAS as the SDK prebuilds it for the Vulkan presenter (MIT licensed, see the
+// SDK's shader sources), converted to MSL at initialization.
+namespace shaders {
+#include "../../ui/shaders/vulkan_spirv/guest_output_ffx_cas_resample_ps.h"
+#include "../../ui/shaders/vulkan_spirv/guest_output_ffx_cas_sharpen_ps.h"
+}  // namespace shaders
+
+namespace {
+
+// In the push constants of the prebuilt guest output shaders, the effect constants come after the
+// Vulkan presenter's GuestOutputPaintRectangleConstants for its vertex shader (offset and size, 4
+// floats), which the Metal presenter's own vertex function does not need.
+constexpr size_t kEffectConstantsOffset = sizeof(float) * 4;
+// The largest effect constants (CasResampleConstants).
+constexpr size_t kEffectConstantsMaxSize = 32;
+
+// Draws the guest output into the letterboxed rectangle with bilinear filtering.
+NSString* const kPaintShaderSource = @R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct PaintVertexOut { float4 position [[position]]; float2 uv; };
+vertex PaintVertexOut paint_vertex(uint vertex_id [[vertex_id]]) {
+  float2 uv = float2((vertex_id << 1) & 2, vertex_id & 2);
+  PaintVertexOut out;
+  out.position = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+  out.uv = uv;
+  return out;
+}
+fragment float4 paint_fragment(PaintVertexOut in [[stage_in]],
+                               texture2d<float> guest_output [[texture(0)]],
+                               sampler guest_output_sampler [[sampler(0)]]) {
+  return float4(guest_output.sample(guest_output_sampler, in.uv).rgb, 1.0);
+}
+)MSL";
+
+}  // namespace
+
+std::unique_ptr<MetalPresenter> MetalPresenter::Create(HostGpuLossCallback host_gpu_loss_callback,
+                                                       id<MTLDevice> device,
+                                                       id<MTLCommandQueue> queue) {
+  auto presenter =
+      std::unique_ptr<MetalPresenter>(new MetalPresenter(host_gpu_loss_callback, device, queue));
+  if (!presenter->InitializeSurfaceIndependent()) {
+    return nullptr;
+  }
+  return presenter;
+}
+
+MetalPresenter::~MetalPresenter() = default;
+
+bool MetalPresenter::InitializeSurfaceIndependent() {
+  NSError* error = nil;
+  id<MTLLibrary> library = [device_ newLibraryWithSource:kPaintShaderSource
+                                                 options:nil
+                                                   error:&error];
+  if (!library) {
+    REXLOG_ERROR("MetalPresenter: failed to compile the paint shaders: {}",
+                 error.localizedDescription.UTF8String);
+    return false;
+  }
+  MTLRenderPipelineDescriptor* descriptor = [MTLRenderPipelineDescriptor new];
+  descriptor.label = @"Guest output paint";
+  descriptor.vertexFunction = [library newFunctionWithName:@"paint_vertex"];
+  descriptor.fragmentFunction = [library newFunctionWithName:@"paint_fragment"];
+  descriptor.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
+  paint_pipeline_ = [device_ newRenderPipelineStateWithDescriptor:descriptor error:&error];
+  if (!paint_pipeline_) {
+    REXLOG_ERROR("MetalPresenter: failed to create the paint pipeline: {}",
+                 error.localizedDescription.UTF8String);
+    return false;
+  }
+  MTLSamplerDescriptor* sampler_descriptor = [MTLSamplerDescriptor new];
+  sampler_descriptor.minFilter = MTLSamplerMinMagFilterLinear;
+  sampler_descriptor.magFilter = MTLSamplerMinMagFilterLinear;
+  sampler_descriptor.sAddressMode = MTLSamplerAddressModeClampToEdge;
+  sampler_descriptor.tAddressMode = MTLSamplerAddressModeClampToEdge;
+  paint_sampler_ = [device_ newSamplerStateWithDescriptor:sampler_descriptor];
+  if (!InitializeCas(library)) {
+    REXLOG_WARN("MetalPresenter: CAS is not available, it is drawn as bilinear");
+  }
+  metalfx_supported_ = [MTLFXSpatialScalerDescriptor supportsDevice:device_];
+  if (!metalfx_supported_) {
+    REXLOG_WARN("MetalPresenter: MetalFX spatial upscaling is not supported by this GPU, it is "
+                "drawn as bilinear");
+  }
+  return InitializeCommonSurfaceIndependent();
+}
+
+bool MetalPresenter::InitializeCas(id<MTLLibrary> paint_library) {
+  // The prebuilt shaders take the guest output texture (set 0 binding 0, read with texel fetches)
+  // and their constants as push constants, and work out the output pixel from the fragment
+  // position and the output offset.
+  const std::vector<MslBinding> bindings = {
+      {0, 0, MslBinding::Kind::kTexture, 0},
+      {0, 1, MslBinding::Kind::kSampler, 0},
+      {MslBinding::kPushConstantSet, 0, MslBinding::Kind::kBuffer, 0},
+  };
+  auto create_pipeline = [&](const uint32_t* code, size_t code_size, const char* name,
+                             MTLPixelFormat format) -> id<MTLRenderPipelineState> {
+    MslShader shader;
+    if (!SpirvToMsl(code, code_size / sizeof(uint32_t), MslStage::kFragment, bindings, shader,
+                    false, name)) {
+      return nil;
+    }
+    id<MTLFunction> fragment = CompileMslFunction(device_, shader, name);
+    if (!fragment) {
+      return nil;
+    }
+    MTLRenderPipelineDescriptor* descriptor = [MTLRenderPipelineDescriptor new];
+    descriptor.label = @(name);
+    descriptor.vertexFunction = [paint_library newFunctionWithName:@"paint_vertex"];
+    descriptor.fragmentFunction = fragment;
+    descriptor.colorAttachments[0].pixelFormat = format;
+    NSError* error = nil;
+    id<MTLRenderPipelineState> pipeline = [device_ newRenderPipelineStateWithDescriptor:descriptor
+                                                                                  error:&error];
+    if (!pipeline) {
+      REXLOG_ERROR("MetalPresenter: failed to create the {} pipeline: {}", name,
+                   error ? error.localizedDescription.UTF8String : "unknown error");
+    }
+    return pipeline;
+  };
+  cas_sharpen_pipeline_ =
+      create_pipeline(shaders::guest_output_ffx_cas_sharpen_ps,
+                      sizeof(shaders::guest_output_ffx_cas_sharpen_ps), "cas_sharpen",
+                      MTLPixelFormatBGRA8Unorm);
+  cas_resample_pipeline_ =
+      create_pipeline(shaders::guest_output_ffx_cas_resample_ps,
+                      sizeof(shaders::guest_output_ffx_cas_resample_ps), "cas_resample",
+                      MTLPixelFormatBGRA8Unorm);
+  cas_resample_intermediate_pipeline_ =
+      create_pipeline(shaders::guest_output_ffx_cas_resample_ps,
+                      sizeof(shaders::guest_output_ffx_cas_resample_ps),
+                      "cas_resample_intermediate", kGuestOutputFormat);
+  if (!cas_sharpen_pipeline_ || !cas_resample_pipeline_ || !cas_resample_intermediate_pipeline_) {
+    cas_sharpen_pipeline_ = nil;
+    cas_resample_pipeline_ = nil;
+    cas_resample_intermediate_pipeline_ = nil;
+    return false;
+  }
+  return true;
+}
+
+void MetalPresenter::EncodeEffect(id<MTLRenderCommandEncoder> encoder,
+                                  id<MTLRenderPipelineState> pipeline, id<MTLTexture> source,
+                                  int32_t x, int32_t y, uint32_t width, uint32_t height,
+                                  const void* constants, size_t constants_size) {
+  MTLViewport viewport = {double(x), double(y), double(width), double(height), 0.0, 1.0};
+  [encoder setViewport:viewport];
+  [encoder setRenderPipelineState:pipeline];
+  [encoder setFragmentTexture:source atIndex:0];
+  [encoder setFragmentSamplerState:paint_sampler_ atIndex:0];
+  if (constants) {
+    assert_true(constants_size <= kEffectConstantsMaxSize);
+    uint8_t push_constants[kEffectConstantsOffset + kEffectConstantsMaxSize] = {};
+    std::memcpy(push_constants + kEffectConstantsOffset, constants,
+                std::min(constants_size, kEffectConstantsMaxSize));
+    [encoder setFragmentBytes:push_constants
+                       length:kEffectConstantsOffset + constants_size
+                      atIndex:0];
+  }
+  [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+}
+
+id<MTLTexture> MetalPresenter::GetIntermediateTexture(id<MTLTexture> __strong& texture,
+                                                      uint32_t width, uint32_t height,
+                                                      MTLTextureUsage usage, NSString* label) {
+  if (!texture || texture.width != width || texture.height != height) {
+    MTLTextureDescriptor* descriptor =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:kGuestOutputFormat
+                                                           width:width
+                                                          height:height
+                                                       mipmapped:NO];
+    descriptor.usage = usage;
+    descriptor.storageMode = MTLStorageModePrivate;
+    texture = [device_ newTextureWithDescriptor:descriptor];
+    texture.label = label;
+  }
+  return texture;
+}
+
+ui::Surface::TypeFlags MetalPresenter::GetSupportedSurfaceTypes() const {
+  return ui::Surface::kTypeFlag_CAMetalLayer;
+}
+
+bool MetalPresenter::CaptureGuestOutput(ui::RawImage& image_out) {
+  id<MTLTexture> texture = nil;
+  {
+    uint32_t mailbox_index;
+    std::unique_lock<std::mutex> lock(ConsumeGuestOutput(mailbox_index, nullptr, nullptr));
+    if (mailbox_index == UINT32_MAX) {
+      return false;
+    }
+    texture = guest_output_textures_[mailbox_index];
+  }
+  if (!texture) {
+    return false;
+  }
+  uint32_t width = uint32_t(texture.width), height = uint32_t(texture.height);
+  id<MTLBuffer> readback = [device_ newBufferWithLength:size_t(width) * height * 4
+                                                options:MTLResourceStorageModeShared];
+  id<MTLCommandBuffer> command_buffer = [queue_ commandBuffer];
+  id<MTLBlitCommandEncoder> blit = [command_buffer blitCommandEncoder];
+  [blit copyFromTexture:texture
+                   sourceSlice:0
+                   sourceLevel:0
+                  sourceOrigin:MTLOriginMake(0, 0, 0)
+                    sourceSize:MTLSizeMake(width, height, 1)
+                      toBuffer:readback
+             destinationOffset:0
+        destinationBytesPerRow:size_t(width) * 4
+      destinationBytesPerImage:size_t(width) * height * 4];
+  [blit endEncoding];
+  [command_buffer commit];
+  [command_buffer waitUntilCompleted];
+  image_out.width = width;
+  image_out.height = height;
+  image_out.stride = size_t(width) * 4;
+  image_out.data.resize(image_out.stride * height);
+  const uint32_t* source = static_cast<const uint32_t*>(readback.contents);
+  uint32_t* dest = reinterpret_cast<uint32_t*>(image_out.data.data());
+  for (size_t i = 0; i < size_t(width) * height; ++i) {
+    dest[i] = Packed10bpcRGBTo8bpcBytes(source[i]);
+  }
+  return true;
+}
+
+MetalPresenter::SurfacePaintConnectResult
+MetalPresenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(
+    ui::Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+    bool was_paintable, bool& is_vsync_implicit_out) {
+  if (new_surface.GetType() != ui::Surface::kTypeIndex_CAMetalLayer) {
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  CAMetalLayer* layer =
+      (__bridge CAMetalLayer*)static_cast<ui::CAMetalLayerSurface&>(new_surface).layer();
+  if (!layer) {
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  bool unchanged = was_paintable && layer == layer_ && new_surface_width == layer_width_ &&
+                   new_surface_height == layer_height_;
+  layer_ = layer;
+  layer_width_ = new_surface_width;
+  layer_height_ = new_surface_height;
+  layer_.device = device_;
+  layer_.pixelFormat = MTLPixelFormatBGRA8Unorm;
+  layer_.framebufferOnly = YES;
+  // Presents follow the display: the presenter paints on the UI thread when asked to.
+  layer_.displaySyncEnabled = YES;
+  layer_.drawableSize = CGSizeMake(new_surface_width, new_surface_height);
+  is_vsync_implicit_out = true;
+  return unchanged ? SurfacePaintConnectResult::kSuccessUnchanged
+                   : SurfacePaintConnectResult::kSuccess;
+}
+
+void MetalPresenter::DisconnectPaintingFromSurfaceFromUIThreadImpl() {
+  layer_ = nil;
+  layer_width_ = 0;
+  layer_height_ = 0;
+}
+
+bool MetalPresenter::RefreshGuestOutputImpl(
+    uint32_t mailbox_index, uint32_t frontbuffer_width, uint32_t frontbuffer_height,
+    std::function<bool(GuestOutputRefreshContext& context)> refresher, bool& is_8bpc_out_ref) {
+  id<MTLTexture> texture = guest_output_textures_[mailbox_index];
+  if (!texture || texture.width != frontbuffer_width || texture.height != frontbuffer_height) {
+    MTLTextureDescriptor* descriptor =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:kGuestOutputFormat
+                                                           width:frontbuffer_width
+                                                          height:frontbuffer_height
+                                                       mipmapped:NO];
+    // Written by the gamma ramp compute shader of the command processor.
+    descriptor.usage = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead;
+    descriptor.storageMode = MTLStorageModePrivate;
+    // Painting and capturing hold their own reference until their GPU work is done, so the old
+    // texture can be replaced right away.
+    texture = [device_ newTextureWithDescriptor:descriptor];
+    if (!texture) {
+      return false;
+    }
+    texture.label = @"Guest output";
+    guest_output_textures_[mailbox_index] = texture;
+  }
+  MetalGuestOutputRefreshContext context(is_8bpc_out_ref, texture);
+  return refresher(context);
+}
+
+MetalPresenter::PaintResult MetalPresenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  @autoreleasepool {
+    if (!layer_) {
+      return PaintResult::kNotPresentedConnectionOutdated;
+    }
+    id<CAMetalDrawable> drawable = [layer_ nextDrawable];
+    if (!drawable) {
+      return PaintResult::kNotPresented;
+    }
+    uint32_t width = uint32_t(drawable.texture.width);
+    uint32_t height = uint32_t(drawable.texture.height);
+
+    id<MTLTexture> guest_output = nil;
+    GuestOutputPaintFlow flow = {};
+    GuestOutputPaintConfig paint_config;
+    {
+      uint32_t mailbox_index;
+      GuestOutputProperties properties;
+      std::unique_lock<std::mutex> lock(
+          ConsumeGuestOutput(mailbox_index, &properties, &paint_config));
+      if (mailbox_index != UINT32_MAX) {
+        guest_output = guest_output_textures_[mailbox_index];
+        flow = GetGuestOutputPaintFlow(properties, width, height, 16384, 16384, paint_config);
+      }
+    }
+
+    id<MTLCommandBuffer> command_buffer = [queue_ commandBuffer];
+    command_buffer.label = @"Present";
+
+    // The effects before the last one, which draws to the drawable, over the output rectangle of
+    // the paint flow. The paint flow itself only has bilinear stretching here: the upscaling
+    // effects are the Metal presenter's own.
+    id<MTLTexture> final_source = guest_output;
+    id<MTLRenderPipelineState> final_pipeline = paint_pipeline_;
+    CasSharpenConstants cas_sharpen_constants;
+    CasResampleConstants cas_resample_constants;
+    const void* final_constants = nullptr;
+    size_t final_constants_size = 0;
+    int32_t output_x = 0, output_y = 0;
+    uint32_t output_width = 0, output_height = 0;
+    if (guest_output && flow.effect_count) {
+      output_x = flow.output_x;
+      output_y = flow.output_y;
+      output_width = flow.effect_output_sizes[flow.effect_count - 1].first;
+      output_height = flow.effect_output_sizes[flow.effect_count - 1].second;
+      uint32_t input_width = uint32_t(guest_output.width);
+      uint32_t input_height = uint32_t(guest_output.height);
+      GuestOutputPaintConfig::Effect effect = paint_config.GetEffect();
+      if (effect == GuestOutputPaintConfig::Effect::kMetalFx && metalfx_supported_ &&
+          (output_width > input_width || output_height > input_height)) {
+        // MetalFX only upscales; downscaling (a draw resolution scale above the display) stays
+        // bilinear.
+        if (!metalfx_scaler_ || metalfx_scaler_.inputWidth != input_width ||
+            metalfx_scaler_.inputHeight != input_height ||
+            metalfx_scaler_.outputWidth != output_width ||
+            metalfx_scaler_.outputHeight != output_height) {
+          MTLFXSpatialScalerDescriptor* descriptor = [MTLFXSpatialScalerDescriptor new];
+          descriptor.inputWidth = input_width;
+          descriptor.inputHeight = input_height;
+          descriptor.outputWidth = output_width;
+          descriptor.outputHeight = output_height;
+          descriptor.colorTextureFormat = kGuestOutputFormat;
+          descriptor.outputTextureFormat = kGuestOutputFormat;
+          // The guest output is gamma-encoded, after the gamma ramp.
+          descriptor.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+          metalfx_scaler_ = [descriptor newSpatialScalerWithDevice:device_];
+          metalfx_output_texture_ = nil;
+          if (metalfx_scaler_) {
+            GetIntermediateTexture(metalfx_output_texture_, output_width, output_height,
+                                   metalfx_scaler_.outputTextureUsage | MTLTextureUsageShaderRead,
+                                   @"MetalFX output");
+          } else {
+            REXLOG_ERROR("MetalPresenter: failed to create the MetalFX spatial scaler for "
+                         "{}x{} to {}x{}",
+                         input_width, input_height, output_width, output_height);
+          }
+        }
+        if (metalfx_scaler_ && metalfx_output_texture_) {
+          metalfx_scaler_.colorTexture = guest_output;
+          metalfx_scaler_.inputContentWidth = input_width;
+          metalfx_scaler_.inputContentHeight = input_height;
+          metalfx_scaler_.outputTexture = metalfx_output_texture_;
+          [metalfx_scaler_ encodeToCommandBuffer:command_buffer];
+          // Copied 1:1 to the drawable by the bilinear pass.
+          final_source = metalfx_output_texture_;
+        }
+      } else if (effect == GuestOutputPaintConfig::Effect::kCas && cas_sharpen_pipeline_) {
+        float sharpness =
+            CalculateCasPostSetupSharpness(paint_config.GetCasAdditionalSharpness());
+        if (output_width == input_width && output_height == input_height) {
+          cas_sharpen_constants.output_offset[0] = output_x;
+          cas_sharpen_constants.output_offset[1] = output_y;
+          cas_sharpen_constants.sharpness_post_setup = sharpness;
+          final_pipeline = cas_sharpen_pipeline_;
+          final_constants = &cas_sharpen_constants;
+          final_constants_size = sizeof(cas_sharpen_constants);
+        } else {
+          // CAS is designed for up to 2x along each axis, as in the FidelityFX paint flow.
+          uint32_t resample_width = std::min(input_width * 2, output_width);
+          uint32_t resample_height = std::min(input_height * 2, output_height);
+          cas_resample_constants.input_output_size_ratio[0] =
+              float(input_width) / float(resample_width);
+          cas_resample_constants.input_output_size_ratio[1] =
+              float(input_height) / float(resample_height);
+          cas_resample_constants.sharpness_post_setup = sharpness;
+          if (resample_width == output_width && resample_height == output_height) {
+            cas_resample_constants.output_offset[0] = output_x;
+            cas_resample_constants.output_offset[1] = output_y;
+            final_pipeline = cas_resample_pipeline_;
+            final_constants = &cas_resample_constants;
+            final_constants_size = sizeof(cas_resample_constants);
+          } else {
+            // Resampled to an intermediate texture, stretched the rest of the way bilinearly.
+            cas_resample_constants.output_offset[0] = 0;
+            cas_resample_constants.output_offset[1] = 0;
+            id<MTLTexture> intermediate = GetIntermediateTexture(
+                cas_intermediate_texture_, resample_width, resample_height,
+                MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead, @"CAS output");
+            MTLRenderPassDescriptor* intermediate_pass =
+                [MTLRenderPassDescriptor renderPassDescriptor];
+            intermediate_pass.colorAttachments[0].texture = intermediate;
+            intermediate_pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+            intermediate_pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+            id<MTLRenderCommandEncoder> intermediate_encoder =
+                [command_buffer renderCommandEncoderWithDescriptor:intermediate_pass];
+            EncodeEffect(intermediate_encoder, cas_resample_intermediate_pipeline_, guest_output,
+                         0, 0, resample_width, resample_height, &cas_resample_constants,
+                         sizeof(cas_resample_constants));
+            [intermediate_encoder endEncoding];
+            final_source = intermediate;
+          }
+        }
+      }
+    }
+
+    MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = drawable.texture;
+    pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+    pass.colorAttachments[0].clearColor = MTLClearColorMake(0.0, 0.0, 0.0, 1.0);
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> encoder = [command_buffer renderCommandEncoderWithDescriptor:pass];
+    if (guest_output && flow.effect_count) {
+      EncodeEffect(encoder, final_pipeline, final_source, output_x, output_y, output_width,
+                   output_height, final_constants, final_constants_size);
+    }
+    // The UI drawers (ImGui overlays) over the guest output, in the same pass.
+    if (execute_ui_drawers) {
+      MetalUIDrawContext ui_draw_context(*this, width, height, encoder, layer_.pixelFormat);
+      ExecuteUIDrawersFromUIThread(ui_draw_context);
+    }
+    [encoder endEncoding];
+    [command_buffer presentDrawable:drawable];
+    [command_buffer commit];
+    return PaintResult::kPresented;
+  }
+}
+
+}  // namespace rex::graphics::metal
