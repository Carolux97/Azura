diff --git a/include/rex/system/xam/player_identity.h b/include/rex/system/xam/player_identity.h
new file mode 100644
index 0000000..1d7d7fb
--- /dev/null
+++ b/include/rex/system/xam/player_identity.h
@@ -0,0 +1,74 @@
+/**
+ * @file        system/xam/player_identity.h
+ * @brief       The identity of an installation: its players' XUID and its machine on the network
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     Games tell players and consoles apart by XUID and by the console's network address
+ *              (XNADDR), so two installations that play together (System Link, online) need values
+ *              of their own. Each one makes them the first time it runs and keeps them in
+ *              identity.toml, in the user data folder:
+ *              - the XUID of player 1, a random offline one (0xE000 followed by 48 random bits);
+ *                players 2 to 4 are the next three;
+ *              - a machine ID, a random locally administered MAC address for the XNADDR (never the
+ *                computer's own);
+ *              - the 32-byte seed of an Ed25519 key, for signing what the installation sends
+ *                online later on.
+ *              The saves stay in the folder they always had (kContentFolderXuid), whatever the
+ *              XUID: see ContentManager::ContentFolderXuid.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <random>
+#include <string>
+#include <string_view>
+
+namespace rex::system::xam {
+
+// Player 1's XUID before installations had an identity. Saves are still kept under it (and the
+// next three for players 2 to 4), so they stay where they always were.
+constexpr uint64_t kContentFolderXuid = 0xB13EBABEBABEBABE;
+
+// File name of the identity, in the user data folder.
+constexpr std::string_view kPlayerIdentityFileName = "identity.toml";
+
+struct PlayerIdentity {
+  uint64_t xuid = 0;
+  std::array<uint8_t, 6> machine_id{};
+  std::array<uint8_t, 32> key_seed{};
+};
+
+// Whether `xuid` can be player 1's: an offline XUID (0xE000 in its top 16 bits) whose next three
+// are offline too. The top 16 bits being 0xE000 also keeps clear the bits some games check before
+// letting a profile play (0x00C0000000000000).
+bool IsValidPlayerXuid(uint64_t xuid);
+
+// Whether `machine_id` is a locally administered unicast MAC address.
+bool IsValidMachineId(const std::array<uint8_t, 6>& machine_id);
+
+// A new identity from `random`.
+PlayerIdentity GeneratePlayerIdentity(std::random_device& random);
+
+// identity.toml's text for `identity`.
+std::string SerializePlayerIdentity(const PlayerIdentity& identity);
+
+// The identity in identity.toml's `text`, or nothing when it is not a valid one.
+std::optional<PlayerIdentity> ParsePlayerIdentity(std::string_view text);
+
+// The identity kept in `user_data_root`, made and saved there the first time. A file that cannot
+// be read is kept aside as identity.toml.bad and replaced. With no folder, the identity is made
+// for this run only.
+PlayerIdentity LoadOrCreatePlayerIdentity(const std::filesystem::path& user_data_root);
+
+// The identity kept in `user_data_root` if there is a valid one, or one for this run only. Writes
+// nothing: for tools (code generation, achievement export, content install) that start the
+// runtime on folders that are not the player's saves.
+PlayerIdentity LoadPlayerIdentity(const std::filesystem::path& user_data_root);
+
+}  // namespace rex::system::xam
diff --git a/include/rex/system/xam/system_link.h b/include/rex/system/xam/system_link.h
new file mode 100644
index 0000000..77ffaeb
--- /dev/null
+++ b/include/rex/system/xam/system_link.h
@@ -0,0 +1,103 @@
+/**
+ * @file        system/xam/system_link.h
+ * @brief       System Link: the local network as XNet and the session services show it to a title
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     On the console, System Link games find each other with broadcasts on the local
+ *              network and then talk directly. A title sees the other consoles through XNet: each
+ *              one has an XNADDR (its IP address and network card address), turned into an IN_ADDR
+ *              the title can send to with XNetXnAddrToInAddr, and the host of a session hands its
+ *              XNADDR, the session's ID (XNKID) and key (XNKEY) to the others in its
+ *              XSESSION_INFO.
+ *
+ *              Here every installation is one console, with the machine ID of its player identity
+ *              (player_identity.h) as its network card address. On a local network the IN_ADDR of
+ *              an XNADDR is the computer's own IP address: there is no secure association or
+ *              encryption between installations. The address book below remembers the XNADDRs
+ *              seen, so that the reverse conversion (XNetInAddrToXnAddr) can answer for them.
+ *
+ *              Everything here is off unless network_mode is system_link: the title then sees no
+ *              network link, as before.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <random>
+
+namespace rex::system::xam {
+
+// Size of an XNADDR in guest memory: IP, online IP, online port, network card address, online ID.
+constexpr size_t kXnAddrSize = 36;
+using XnAddrBytes = std::array<uint8_t, kXnAddrSize>;
+// Offsets inside an XNADDR.
+constexpr size_t kXnAddrIpOffset = 0;    // IN_ADDR, network byte order
+constexpr size_t kXnAddrEnetOffset = 10;  // 6-byte network card address
+
+// A session's ID (XNKID) and key exchange key (XNKEY).
+using XnKid = std::array<uint8_t, 8>;
+using XnKey = std::array<uint8_t, 16>;
+
+// Whether System Link is on (network_mode = system_link).
+bool SystemLinkEnabled();
+
+// IPv4 address (as a number: 192.168.1.2 is 0xC0A80102) of the interface that reaches the local
+// network, found once; 0 when there is none.
+uint32_t LanAddress();
+
+// The XNADDR of an installation with IPv4 address `ip` (as LanAddress) and `machine_id`.
+XnAddrBytes MakeXnAddr(uint32_t ip, const std::array<uint8_t, 6>& machine_id);
+
+// The IPv4 address (as LanAddress) in an XNADDR.
+uint32_t XnAddrIp(const XnAddrBytes& xnaddr);
+
+// --- Address book ---------------------------------------------------------------------------------
+
+// Remembers `xnaddr`, replacing any other with the same IP address.
+void RememberXnAddr(const XnAddrBytes& xnaddr);
+// The XNADDR remembered for `ip`, if any.
+std::optional<XnAddrBytes> FindXnAddr(uint32_t ip);
+
+// --- Sessions ---------------------------------------------------------------------------------------
+
+// A new System Link session ID: random, with the System Link type in its top bits.
+XnKid MakeSystemLinkKid(std::random_device& random);
+// A new key exchange key.
+XnKey MakeKey(std::random_device& random);
+// Whether `kid` is a System Link session ID.
+bool IsSystemLinkKid(const XnKid& kid);
+
+struct SystemLinkSession {
+  XnKid kid{};
+  XnKey key{};
+  XnAddrBytes host{};
+  bool hosting = false;  // this installation is its host
+};
+
+// The session the title knows by `handle` (its session object), until RemoveSession.
+void AddSession(uint32_t handle, const SystemLinkSession& session);
+void RemoveSession(uint32_t handle);
+// Whether this installation hosts a System Link session now.
+bool HostingSystemLinkSession();
+// The ID of the session whose host has IP address `ip`, or of any session when none matches.
+std::optional<XnKid> FindSessionKid(uint32_t ip);
+
+// --- Ports ------------------------------------------------------------------------------------------
+
+// The console let titles use any port, and Unreal Engine 3 titles bind ports 1000 to 1019 for their
+// game traffic (VDP sockets). Hosts reserve the ports below 1024 for privileged programs, so those
+// ports are used this much higher on every platform, by the one binding and by the one sending,
+// so installations on different systems still reach each other: 1000 is 11000 on the network.
+constexpr uint16_t kFirstUnprivilegedPort = 1024;
+constexpr uint16_t kPrivilegedPortOffset = 10000;
+
+// The network's port for a port a title uses.
+uint16_t NetworkPort(uint16_t title_port);
+// The port a title uses for a port on the network.
+uint16_t TitlePort(uint16_t network_port);
+
+}  // namespace rex::system::xam
