+/**
+ * @file        graphics/metal/metal_primitive_processor.h
+ * @brief       Index buffers for the Metal backend's primitive processing
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include <rex/graphics/primitive_processor.h>
+
+#import <Metal/Metal.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+
+class MetalPrimitiveProcessor final : public PrimitiveProcessor {
+ public:
+  MetalPrimitiveProcessor(const RegisterFile& register_file, memory::Memory& memory,
+                          SharedMemory& shared_memory, MetalCommandProcessor& command_processor)
+      : PrimitiveProcessor(register_file, memory, shared_memory),
+        command_processor_(command_processor) {}
+  ~MetalPrimitiveProcessor();
+
+  bool Initialize();
+  void Shutdown(bool from_destructor = false);
+
+  void BeginFrame();
+  void EndFrame();
+
+  std::pair<id<MTLBuffer>, size_t> GetBuiltinIndexBuffer(size_t handle) const {
+    return std::make_pair(builtin_index_buffer_, GetBuiltinIndexBufferOffsetBytes(handle));
+  }
+  std::pair<id<MTLBuffer>, size_t> GetConvertedIndexBuffer(size_t handle) const {
+    return frame_index_buffers_[handle];
+  }
+
+ protected:
+  bool InitializeBuiltinIndexBuffer(size_t size_bytes,
+                                    std::function<void(void*)> fill_callback) override;
+  void* RequestHostConvertedIndexBufferForCurrentFrame(xenos::IndexFormat format,
+                                                       uint32_t index_count, bool coalign_for_simd,
+                                                       uint32_t coalignment_original_address,
+                                                       size_t& backend_handle_out) override;
+
+ private:
+  // Converted indices are written by the CPU into shared buffers, suballocated per frame and
+  // reused once the GPU has completed the frame that last used them.
+  struct IndexChunk {
+    id<MTLBuffer> buffer;
+    size_t used;
+    uint64_t last_frame;
+  };
+  static constexpr size_t kIndexChunkSize = size_t(4) << 20;
+
+  MetalCommandProcessor& command_processor_;
+  id<MTLBuffer> builtin_index_buffer_ = nil;
+  std::vector<IndexChunk> index_chunks_;
+  std::vector<std::pair<id<MTLBuffer>, size_t>> frame_index_buffers_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_primitive_processor.mm b/src/graphics/metal/metal_primitive_processor.mm
new file mode 100644
index 0000000..d45db08
--- /dev/null
+++ b/src/graphics/metal/metal_primitive_processor.mm
@@ -0,0 +1,112 @@
+/**
+ * @file        graphics/metal/metal_primitive_processor.mm
+ * @brief       Index buffers for the Metal backend's primitive processing
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_primitive_processor.h"
+
+#include <algorithm>
+
+#include <rex/logging.h>
+#include <rex/math.h>
+
+#include "metal_command_processor.h"
+
+namespace rex::graphics::metal {
+
+MetalPrimitiveProcessor::~MetalPrimitiveProcessor() { Shutdown(true); }
+
+bool MetalPrimitiveProcessor::Initialize() {
+  // Metal has 32-bit indices, but no triangle fans, line loops, quads, geometry shaders or
+  // point sprites: fans, loops and quads become lists, and point sprites and rectangles are
+  // expanded in the vertex shader.
+  if (!InitializeCommon(true, false, false, false, false, false)) {
+    Shutdown();
+    return false;
+  }
+  return true;
+}
+
+void MetalPrimitiveProcessor::Shutdown(bool from_destructor) {
+  frame_index_buffers_.clear();
+  index_chunks_.clear();
+  builtin_index_buffer_ = nil;
+  if (!from_destructor) {
+    ShutdownCommon();
+  }
+}
+
+void MetalPrimitiveProcessor::BeginFrame() {
+  uint64_t completed_frame = command_processor_.GetCompletedFrame();
+  for (IndexChunk& chunk : index_chunks_) {
+    if (chunk.last_frame <= completed_frame) {
+      chunk.used = 0;
+    }
+  }
+}
+
+void MetalPrimitiveProcessor::EndFrame() {
+  ClearPerFrameCache();
+  frame_index_buffers_.clear();
+}
+
+bool MetalPrimitiveProcessor::InitializeBuiltinIndexBuffer(
+    size_t size_bytes, std::function<void(void*)> fill_callback) {
+  builtin_index_buffer_ = [command_processor_.device()
+      newBufferWithLength:size_bytes
+                  options:MTLResourceStorageModeShared | MTLResourceCPUCacheModeWriteCombined];
+  if (!builtin_index_buffer_) {
+    REXGPU_ERROR("Metal primitive processor: failed to create the {}-byte built-in index buffer",
+                 size_bytes);
+    return false;
+  }
+  builtin_index_buffer_.label = @"Built-in indices";
+  fill_callback(builtin_index_buffer_.contents);
+  return true;
+}
+
+void* MetalPrimitiveProcessor::RequestHostConvertedIndexBufferForCurrentFrame(
+    xenos::IndexFormat format, uint32_t index_count, bool coalign_for_simd,
+    uint32_t coalignment_original_address, size_t& backend_handle_out) {
+  size_t index_size = format == xenos::IndexFormat::kInt16 ? sizeof(uint16_t) : sizeof(uint32_t);
+  size_t size = index_size * index_count +
+                (coalign_for_simd ? XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE : 0);
+  uint64_t current_frame = command_processor_.GetCurrentFrame();
+  IndexChunk* chunk = nullptr;
+  for (IndexChunk& candidate : index_chunks_) {
+    size_t offset = rex::align(candidate.used, size_t(16));
+    if ((candidate.last_frame == current_frame || !candidate.used) &&
+        offset + size <= candidate.buffer.length) {
+      chunk = &candidate;
+      break;
+    }
+  }
+  if (!chunk) {
+    id<MTLBuffer> buffer = [command_processor_.device()
+        newBufferWithLength:std::max(kIndexChunkSize, size)
+                    options:MTLResourceStorageModeShared | MTLResourceCPUCacheModeWriteCombined];
+    if (!buffer) {
+      return nullptr;
+    }
+    buffer.label = @"Converted indices";
+    index_chunks_.push_back({buffer, 0, current_frame});
+    chunk = &index_chunks_.back();
+  }
+  size_t offset = rex::align(chunk->used, size_t(16));
+  chunk->used = offset + size;
+  chunk->last_frame = current_frame;
+  uint8_t* mapping = static_cast<uint8_t*>(chunk->buffer.contents) + offset;
+  if (coalign_for_simd) {
+    ptrdiff_t coalignment_offset = GetSimdCoalignmentOffset(mapping, coalignment_original_address);
+    mapping += coalignment_offset;
+    offset += size_t(coalignment_offset);
+  }
+  backend_handle_out = frame_index_buffers_.size();
+  frame_index_buffers_.emplace_back(chunk->buffer, offset);
+  return mapping;
+}
+
+}  // namespace rex::graphics::metal
