+/**
+ * @file        graphics/metal/metal_command_processor.h
+ * @brief       Xenos command processing with Metal
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/perf/counter.h>
+
+#import <Metal/Metal.h>
+
+#include "metal_pipeline_cache.h"
+#include "metal_primitive_processor.h"
+#include "metal_render_target_cache.h"
+#include "metal_shared_memory.h"
+#include "metal_texture_cache.h"
+
+namespace rex::graphics::metal {
+
+class MetalGraphicsSystem;
+
+// Records the guest GPU work of a submission into one MTLCommandBuffer. Encoders are opened as the
+// work needs them: guest draws go to a render encoder that stays open while the render targets
+// don't change, and texture loads, resolves and render target transfers end it only when they
+// need a compute or blit encoder or another render pass. Metal tracks the hazards between them,
+// so there are no barriers.
+class MetalCommandProcessor final : public CommandProcessor {
+ public:
+  // Guest frames whose GPU work may be in flight at once.
+  static constexpr uint32_t kMaxFramesInFlight = 3;
+
+  // GPU-only memory for one submission (texture load staging).
+  struct ScratchBuffer {
+    id<MTLBuffer> buffer = nil;
+    size_t offset = 0;
+  };
+  // CPU-written memory for one submission (constants, transfer vertices, gamma ramps).
+  struct UploadAllocation {
+    id<MTLBuffer> buffer = nil;
+    size_t offset = 0;
+    void* mapping = nullptr;
+  };
+
+  MetalCommandProcessor(MetalGraphicsSystem* graphics_system, system::KernelState* kernel_state);
+  ~MetalCommandProcessor();
+
+  void ClearCaches() override;
+  void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
+                               bool blocking) override;
+  void InvalidateGpuMemory() override;
+
+  void IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                 uint32_t frontbuffer_height) override;
+
+  id<MTLDevice> device() const { return device_; }
+  GraphicsSystem* graphics_system() const { return graphics_system_; }
+
+  uint64_t GetCurrentSubmission() const { return submission_current_; }
+  uint64_t GetCompletedSubmission() const { return submission_completed_; }
+  uint64_t GetCurrentFrame() const { return frame_current_; }
+  uint64_t GetCompletedFrame() const { return frame_completed_; }
+
+  // The encoder of the kind, ending the open one of another kind. A render encoder ended for this
+  // is counted with end_reason. With gpu_debug_markers, a debug_label gives the work an encoder of
+  // its own with that label, so GPU traces can attribute its time (debug_labels_enabled() says
+  // whether to build one).
+  id<MTLComputeCommandEncoder> GetComputeEncoder(rex::perf::CounterId end_reason,
+                                                 NSString* debug_label = nil);
+  id<MTLBlitCommandEncoder> GetBlitEncoder(rex::perf::CounterId end_reason,
+                                           NSString* debug_label = nil);
+  bool debug_labels_enabled() const { return debug_labels_enabled_; }
+  // A render encoder for the render pass, continuing the open one if it has the same attachments,
+  // for draws of the backend itself (transfers, clears): the guest draw state is set again before
+  // the next guest draw.
+  id<MTLRenderCommandEncoder> BeginExternalRenderPass(const MetalRenderPass& render_pass,
+                                                      rex::perf::CounterId end_reason);
+
+  // Runs the handler when the GPU completes the current submission's command buffer (opening the
+  // submission if needed).
+  void AddCompletedHandler(MTLCommandBufferHandler handler);
+  // Set while a resolve written from the render target (gfx = hle) gets its encoder, so a render
+  // pass it ends is told apart in the perf counters.
+  void SetInNativeResolve(bool in_native_resolve) { in_native_resolve_ = in_native_resolve; }
+  // The open render pass's encoder when the texture is one of its color attachments (its index in
+  // index_out), or nil. The caller's work in it changes the state the guest draws track, which is
+  // set again for the next draw.
+  id<MTLRenderCommandEncoder> GetOpenRenderEncoderWithColor(id<MTLTexture> texture,
+                                                            uint32_t& index_out);
+  // The attachments of the open render pass (empty when none is open).
+  const MetalRenderPass& current_render_pass() const { return current_render_pass_; }
+
+  ScratchBuffer AcquireScratchBuffer(size_t size);
+  UploadAllocation RequestUpload(size_t size, size_t alignment = 256);
+
+ protected:
+  bool SetupContext() override;
+  void ShutdownContext() override;
+
+  void WriteRegister(uint32_t index, uint32_t value) override;
+  void WriteRegistersFromMem(uint32_t start_index, uint32_t* base,
+                             uint32_t num_registers) override;
+
+  void OnGammaRamp256EntryTableValueWritten() override {}
+  void OnGammaRampPWLValueWritten() override {}
+
+  void PrepareForWait() override;
+  void WriteGuestFence(uint32_t address, uint32_t value) override;
+  bool ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* reader, uint32_t packet,
+                                          uint32_t count) override;
+
+  Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                     const uint32_t* host_address, uint32_t dword_count) override;
+
+  bool IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                 IndexBufferInfo* index_buffer_info, bool major_mode_explicit) override;
+  bool IssueCopy() override;
+
+ private:
+  enum class EncoderType {
+    kNone,
+    kRender,
+    kCompute,
+    kBlit,
+  };
+
+  // Guest draw state set on the open render encoder, to skip redundant state changes.
+  struct RenderEncoderState {
+    id<MTLRenderPipelineState> pipeline = nil;
+    id<MTLDepthStencilState> depth_stencil_state = nil;
+    MTLCullMode cull_mode = MTLCullModeNone;
+    MTLWinding winding = MTLWindingClockwise;
+    MTLTriangleFillMode fill_mode = MTLTriangleFillModeFill;
+    MTLDepthClipMode depth_clip_mode = MTLDepthClipModeClip;
+    MTLViewport viewport = {};
+    MTLScissorRect scissor = {};
+    float depth_bias_constant = 0.0f;
+    float depth_bias_slope = 0.0f;
+    std::array<float, 4> blend_constants = {};
+    uint32_t stencil_reference_front = 0;
+    uint32_t stencil_reference_back = 0;
+    // Constant buffers bound in the vertex and the fragment stage.
+    uint32_t vertex_constant_buffers_bound = 0;
+    uint32_t fragment_constant_buffers_bound = 0;
+    bool shared_memory_bound = false;
+    // The visibility result slot the encoder counts the guest draws' samples in for the active
+    // occlusion query, or UINT32_MAX if not counting.
+    uint32_t occlusion_slot = UINT32_MAX;
+    // False after an encoder change or draws of the backend itself: everything is set again.
+    bool valid = false;
+  };
+
+  // Pages of buffers suballocated linearly within a submission and reused once it completes.
+  class TransientBufferPool {
+   public:
+    TransientBufferPool(id<MTLDevice> device, MTLResourceOptions options, size_t page_size,
+                        NSString* label)
+        : device_(device), options_(options), page_size_(page_size), label_(label) {}
+    // Returns the buffer and the offset in it, or nil if failed to allocate.
+    id<MTLBuffer> Request(uint64_t submission, uint64_t completed_submission, size_t size,
+                          size_t alignment, size_t& offset_out);
+    void Clear() { pages_.clear(); }
+
+   private:
+    struct Page {
+      id<MTLBuffer> buffer;
+      size_t used;
+      uint64_t last_submission;
+    };
+    id<MTLDevice> device_;
+    MTLResourceOptions options_;
+    size_t page_size_;
+    NSString* label_;
+    std::vector<Page> pages_;
+    size_t current_page_ = SIZE_MAX;
+  };
+
+  // A guest fence write waiting for its submission to complete on the GPU.
+  struct PendingGuestFence {
+    uint64_t submission;
+    uint32_t address;
+    uint32_t value;
+  };
+
+  bool BeginSubmission(bool is_guest_command);
+  // Called from Metal's completion thread: writes the guest fences of the submissions up to this
+  // one.
+  void OnSubmissionCompletedByGpu(uint64_t submission);
+  bool EndSubmission(bool is_swap);
+  // Waits until the submission (or the latest one if it's the current or a future one) completes.
+  void AwaitSubmission(uint64_t submission);
+  void UpdateCompletedSubmission();
+
+  void EndEncoder(rex::perf::CounterId render_pass_end_reason);
+  id<MTLRenderCommandEncoder> BeginRenderPass(const MetalRenderPass& render_pass,
+                                              rex::perf::CounterId end_reason);
+
+  // The guest's clears as render pass load actions (hle_clear_load_actions, gfx = hle).
+  // A clear of one render target texture, waiting for the next render pass on it.
+  struct PendingClear {
+    id<MTLTexture> texture = nil;
+    bool is_depth = false;
+    MTLClearColor color = {};
+    double depth = 0.0;
+    uint32_t stencil = 0;
+  };
+  // The load action clears of the last update's draw if it is the guest's clear of whole surfaces
+  // and every target it writes can be cleared that way, appended to clears_out; false otherwise.
+  bool GetGuestClearLoadActions(reg::RB_DEPTHCONTROL normalized_depth_control,
+                                std::vector<PendingClear>& clears_out) const;
+  // Makes the last update's draw, a guest clear, a pending clear of its targets instead of a
+  // draw, if possible (not in the middle of a render pass on the same targets). Returns whether it
+  // did; then the draw is skipped.
+  bool DeferGuestClear(const MetalRenderPass& render_pass,
+                       reg::RB_DEPTHCONTROL normalized_depth_control);
+  // Clears every pending clear's texture in a render pass of its own: before anything reads the
+  // render targets outside a render pass on them. Ends the open encoder first.
+  void ApplyPendingClears(rex::perf::CounterId end_reason);
+  // hle_verify_clears: compares the first texel of each target the guest's clear just drew with
+  // what its load action would have written (clears_to_verify_), and logs mismatches.
+  void VerifyGuestClears();
+
+  void UpdateDynamicState(id<MTLRenderCommandEncoder> encoder,
+                          const draw_util::ViewportInfo& viewport_info, bool primitive_polygonal,
+                          reg::RB_DEPTHCONTROL normalized_depth_control,
+                          const MetalRenderPass& render_pass);
+  void UpdateSystemConstantValues(bool primitive_polygonal,
+                                  const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+                                  const draw_util::ViewportInfo& viewport_info,
+                                  uint32_t used_texture_mask,
+                                  reg::RB_DEPTHCONTROL normalized_depth_control,
+                                  uint32_t normalized_color_mask);
+  bool UpdateBindings(id<MTLRenderCommandEncoder> encoder, const MetalShader* vertex_shader,
+                      const MetalShader* pixel_shader,
+                      const MetalShader::MetalTranslation* vertex_translation,
+                      const MetalShader::MetalTranslation* pixel_translation);
+
+  bool InitializeSwapPipelines();
+
+  MetalGraphicsSystem* metal_graphics_system_;
+  id<MTLDevice> device_ = nil;
+  id<MTLCommandQueue> queue_ = nil;
+
+  std::unique_ptr<MetalSharedMemory> shared_memory_;
+  std::unique_ptr<MetalPrimitiveProcessor> primitive_processor_;
+  std::unique_ptr<MetalRenderTargetCache> render_target_cache_;
+  std::unique_ptr<MetalPipelineCache> pipeline_cache_;
+  std::unique_ptr<MetalTextureCache> texture_cache_;
+
+  std::unique_ptr<TransientBufferPool> scratch_buffer_pool_;
+  std::unique_ptr<TransientBufferPool> upload_buffer_pool_;
+
+  // Submissions.
+  bool submission_open_ = false;
+  id<MTLCommandBuffer> command_buffer_ = nil;
+  // Command buffers committed and not known to be completed, with their submission indices.
+  std::deque<std::pair<uint64_t, id<MTLCommandBuffer>>> submissions_in_flight_;
+  // Submissions are numbered from 1: the open one, or the next one if none is open.
+  uint64_t submission_current_ = 1;
+  uint64_t submission_completed_ = 0;
+  // Whether the open submission has any GPU work encoded.
+  // gpu_debug_markers, read once: encoders of their own for labelled work (GetComputeEncoder).
+  bool debug_labels_enabled_ = false;
+  bool submission_has_work_ = false;
+
+  // Guest fences written when the GPU is done (metal_gpu_accurate_fences): the command processor
+  // runs ahead of the GPU, and the guest reuses memory once it sees a fence, so a fence written
+  // early lets the guest change memory the GPU still reads or will still write.
+  bool accurate_fences_ = true;
+  std::mutex guest_fence_mutex_;
+  // Guarded by guest_fence_mutex_.
+  std::deque<PendingGuestFence> pending_guest_fences_;
+  uint64_t submission_completed_by_gpu_ = 0;
+  // Completion handlers registered and not finished yet, awaited at shutdown.
+  std::atomic<uint32_t> completion_handlers_in_flight_{0};
+
+  // Occlusion queries (occlusion_query_enable): the samples of the guest draws between a query's
+  // begin and end are counted by the GPU in visibility result slots, one per render encoder the
+  // draws are in, and the sum is written to guest memory when the submission with them completes.
+  // The guest waits for the result to replace the marker its driver wrote at the end.
+  void CountOcclusionSamples();
+  void StopCountingOcclusionSamples();
+  void WriteGuestOcclusionResult(uint32_t address, uint64_t samples);
+  // Metal writes visibility results only at offsets below 256 KiB of the buffer (the API
+  // validation rejects larger offsets, and without it the GPU writes nothing there).
+  static constexpr size_t kOcclusionBufferMaxSize = size_t(256) << 10;
+  static constexpr uint32_t kOcclusionSlotCount =
+      uint32_t(kOcclusionBufferMaxSize / sizeof(uint64_t));
+  // kOcclusionSlotCount 64-bit counters, reused in turn.
+  id<MTLBuffer> occlusion_buffer_ = nil;
+  uint32_t occlusion_slot_next_ = 0;
+  struct ActiveOcclusionQuery {
+    bool valid = false;
+    uint32_t address = 0;
+    std::vector<uint32_t> slots;
+  };
+  ActiveOcclusionQuery active_occlusion_query_;
+  struct PendingOcclusionResult {
+    uint64_t submission;
+    uint32_t address;
+    std::vector<uint32_t> slots;
+  };
+  // Guarded by guest_fence_mutex_.
+  std::deque<PendingOcclusionResult> pending_occlusion_results_;
+  bool device_lost_ = false;
+
+  // xsc_debug_color_range: the per-shader counters of out-of-range pixel shader colors, written by
+  // the GPU and logged by the command processor every kXscDebugCounterLogFrames frames.
+  static constexpr uint64_t kXscDebugCounterLogFrames = 300;
+  void LogXscDebugCounters();
+  id<MTLBuffer> xsc_debug_counters_ = nil;
+
+  // metal_gpu_capture_frames: a Metal GPU capture of the next frames when the bound key is pressed
+  // (requested from the UI thread, started and stopped at frame boundaries).
+  void UpdateGpuCapture();
+  std::atomic<bool> gpu_capture_requested_{false};
+  uint32_t gpu_capture_frames_remaining_ = 0;
+
+  // metal_frame_history_frames: the last guest front buffers kept in a ring of textures, saved as
+  // images when the bound key is pressed (after something was seen on screen).
+  void RecordFrameHistory(id<MTLTexture> swap_texture, uint32_t width, uint32_t height);
+  void SaveFrameHistory();
+  std::vector<id<MTLTexture>> frame_history_;
+  std::vector<uint64_t> frame_history_guest_frames_;
+  uint32_t frame_history_next_ = 0;
+  std::atomic<bool> frame_history_save_requested_{false};
+
+  // metal_pixel_history: in the frame after bind_metal_frame_history, after every draw, a grid of
+  // render target 0 is sampled, and the state of the draw is logged, to find which draw changes a
+  // region of the screen.
+  void RecordPixelHistory(const MetalRenderPass& render_pass, const Shader* vertex_shader,
+                          const Shader* pixel_shader, uint32_t normalized_color_mask);
+  void SavePixelHistory();
+  enum class PixelHistoryState { kOff, kArmed, kRecording };
+  PixelHistoryState pixel_history_state_ = PixelHistoryState::kOff;
+  id<MTLComputePipelineState> pixel_history_pipeline_ = nil;
+  id<MTLBuffer> pixel_history_buffer_ = nil;
+  uint32_t pixel_history_draws_ = 0;
+  std::string pixel_history_log_;
+
+  // Frames.
+  bool frame_open_ = false;
+  uint64_t frame_current_ = 1;
+  uint64_t frame_completed_ = 0;
+  std::array<uint64_t, kMaxFramesInFlight> closed_frame_submissions_{};
+  bool cache_clear_requested_ = false;
+
+  // Encoders.
+  EncoderType encoder_type_ = EncoderType::kNone;
+  id<MTLRenderCommandEncoder> render_encoder_ = nil;
+  id<MTLComputeCommandEncoder> compute_encoder_ = nil;
+  id<MTLBlitCommandEncoder> blit_encoder_ = nil;
+  MetalRenderPass current_render_pass_;
+  // The attachments of the render pass the last resolve ended, until the next render pass begins
+  // (for kRenderPassesResumedAfterResolve).
+  MetalRenderPass render_pass_ended_by_resolve_;
+  bool render_pass_ended_by_native_resolve_ = false;
+  bool in_native_resolve_ = false;
+  RenderEncoderState render_encoder_state_;
+  std::vector<PendingClear> pending_clears_;
+  std::vector<PendingClear> clears_to_verify_;
+  // hle_verify_clears: 1x1 textures cleared with the expected values, by pixel format.
+  std::unordered_map<NSUInteger, id<MTLTexture>> clear_verify_textures_;
+
+  // Constants.
+  SpirvShaderTranslator::SystemConstants system_constants_;
+  uint64_t current_float_constant_map_vertex_[4] = {};
+  uint64_t current_float_constant_map_pixel_[4] = {};
+  // Bits are SpirvShaderTranslator::ConstantBuffer.
+  uint32_t current_constant_buffers_up_to_date_ = 0;
+  std::array<UploadAllocation, SpirvShaderTranslator::kConstantBufferCount>
+      current_constant_buffers_{};
+
+  // Temporary storage for the texture and sampler bindings of a draw.
+  std::vector<id<MTLTexture>> binding_textures_;
+  std::vector<id<MTLSamplerState>> binding_samplers_;
+
+  // Memory export ranges of the current draw.
+  std::vector<draw_util::MemExportRange> memexport_ranges_;
+
+  // Swap: gamma ramp application into the presenter's guest output.
+  id<MTLComputePipelineState> swap_apply_gamma_table_pipeline_ = nil;
+  id<MTLComputePipelineState> swap_apply_gamma_pwl_pipeline_ = nil;
+  MTLSize swap_apply_gamma_threads_per_threadgroup_ = {16, 8, 1};
+  // FXAA: the gamma ramp pass also stores the luma in alpha (into swap_fxaa_source_), then the
+  // FXAA pass, written in MSL for Apple GPUs, filters it into the guest output.
+  id<MTLComputePipelineState> swap_apply_gamma_table_fxaa_luma_pipeline_ = nil;
+  id<MTLComputePipelineState> swap_apply_gamma_pwl_fxaa_luma_pipeline_ = nil;
+  id<MTLComputePipelineState> swap_fxaa_pipeline_ = nil;
+  id<MTLComputePipelineState> swap_fxaa_extreme_pipeline_ = nil;
+  id<MTLSamplerState> swap_fxaa_sampler_ = nil;
+  id<MTLTexture> swap_fxaa_source_ = nil;
+};
+
+}  // namespace rex::graphics::metal
