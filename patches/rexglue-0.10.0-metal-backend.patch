+bool DrawExtentEstimator::EstimateVertexRectangle(const Shader& vertex_shader, float& left,
+                                                  float& top, float& right, float& bottom,
+                                                  float* depth_out) {
+  const RegisterFile& regs = register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  // A clear is a rectangle of 3 vertices or a quad of 4; more is not what this is for.
+  constexpr uint32_t kMaxVertices = 8;
+  if (!vgt_draw_initiator.num_indices || vgt_draw_initiator.num_indices > kMaxVertices ||
+      vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+    return false;
+  }
+  if (xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type) &&
+      regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+          xenos::VGTOutputPath::kTessellationEnable) {
+    return false;
+  }
+  if (!vertex_shader.is_ucode_analyzed() || !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return false;
+  }
+
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float scale[] = {
+      pa_cl_vte_cntl.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f,
+      pa_cl_vte_cntl.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f,
+  };
+  float offset[] = {
+      pa_cl_vte_cntl.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f,
+      pa_cl_vte_cntl.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f,
+  };
+  if (regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+    offset[0] += 0.5f;
+    offset[1] += 0.5f;
+  }
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+    auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    offset[0] += float(pa_sc_window_offset.window_x_offset);
+    offset[1] += float(pa_sc_window_offset.window_y_offset);
+  }
+  float scale_z =
+      pa_cl_vte_cntl.vport_z_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE) : 1.0f;
+  float offset_z =
+      pa_cl_vte_cntl.vport_z_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET) : 0.0f;
+  float depth = NAN;
+  bool depth_same = true;
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+
+  left = top = FLT_MAX;
+  right = bottom = -FLT_MAX;
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionExportSink sink;
+  shader_interpreter_.SetExportSink(&sink);
+  bool complete = true;
+  for (uint32_t i = 0; i < vgt_draw_initiator.num_indices; ++i) {
+    uint32_t vertex_index = std::min(max_index, std::max(min_index, (i + index_offset) & 0xFFFFFF));
+    sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if (!sink.has(0b0011) || (!pa_cl_vte_cntl.vtx_xy_fmt && !sink.has(0b1000))) {
+      complete = false;
+      break;
+    }
+    float position[] = {sink[0], sink[1]};
+    for (uint32_t axis = 0; axis < 2; ++axis) {
+      if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+        position[axis] /= sink[3];
+      }
+      position[axis] = position[axis] * scale[axis] + offset[axis];
+    }
+    if (!std::isfinite(position[0]) || !std::isfinite(position[1])) {
+      complete = false;
+      break;
+    }
+    if (depth_out) {
+      float z = sink.has(0b0100) ? sink[2] : NAN;
+      if (!pa_cl_vte_cntl.vtx_z_fmt && sink.has(0b1000)) {
+        z /= sink[3];
+      }
+      z = z * scale_z + offset_z;
+      if (i == 0) {
+        depth = z;
+      } else if (!(z == depth)) {
+        depth_same = false;
+      }
+    }
+    left = std::min(left, position[0]);
+    right = std::max(right, position[0]);
+    top = std::min(top, position[1]);
+    bottom = std::max(bottom, position[1]);
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (depth_out) {
+    *depth_out = depth_same ? depth : NAN;
+  }
+  return complete;
+}
