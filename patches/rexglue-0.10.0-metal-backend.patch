+        } break;
+      }
+    } else {
+      assert_true(source_depth_texture != spv::NoResult);
+      assert_true(source_stencil_texture != spv::NoResult);
+      spv::Id depth_offset = builder.makeUintConstant(8);
+      spv::Id depth_width = builder.makeUintConstant(24);
