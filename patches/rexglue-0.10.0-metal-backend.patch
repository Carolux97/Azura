+float SpirvShaderTranslator::GetPointSamplingRoundingOffset(uint64_t ucode_data_hash) {
+  // Gears of War 3 (4D5308AB) makes the half-resolution depth its occlusion queries are tested
+  // against with this shader: it point-samples the scene depth with offsets (0,0), (1,0), (0,1)
+  // and (1,1) from coordinates that fall exactly on the corner shared by the 4 full-resolution
+  // texels under each half-resolution pixel (a full-screen rectangle with texture coordinates 0 to
+  // 1 and pixel centers at .5), keeps the farthest and subtracts a bias. Only rounding to the
+  // left/upper texel reads the 4 texels under the pixel; rounding to the right/lower one shifts
+  // the block by a texel, so flat objects on distant floors fail their own occlusion query every
+  // other frame and flicker. Public documentation of the Xenos does not say how it rounds there
+  // (AMD's R600 family rounds point sampling coordinates to 6 fractional bits by default).
+  constexpr uint64_t kRoundLeftUpper[] = {0x9E098197F6FAC270ull};
+  for (uint64_t hash : kRoundLeftUpper) {
+    if (hash == ucode_data_hash) {
+      return -1.5f / 1024.0f;
+    }
+  }
+  return 1.5f / 1024.0f;
+}
+
 }  // namespace rex::graphics
