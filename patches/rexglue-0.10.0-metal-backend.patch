+namespace {
+
+// Argument table of the gamma ramp shaders: the SPIR-V descriptor sets 0 (ramp texel buffer),
+// 1 (source) and 2 (destination), and the push constants (output size).
+constexpr uint32_t kSwapTextureRamp = 0;
+constexpr uint32_t kSwapTextureSource = 1;
+constexpr uint32_t kSwapTextureDestination = 2;
+constexpr uint32_t kSwapBufferConstants = 0;
+
+// Pixel history (metal_pixel_history): a grid of points of a render target, read after a draw.
+constexpr uint32_t kPixelHistoryGridWidth = 64;
+constexpr uint32_t kPixelHistoryGridHeight = 36;
+constexpr uint32_t kPixelHistoryMaxDraws = 8192;
+NSString* const kPixelHistoryShaderSource = @R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+// params: render target width and height, grid width and height.
+kernel void pixel_history_sample(uint2 point [[thread_position_in_grid]],
+                                 constant uint4& params [[buffer(0)]],
+                                 device half4* samples [[buffer(1)]],
+                                 texture2d<float, access::read> source [[texture(0)]]) {
+  if (point.x >= params.z || point.y >= params.w) {
+    return;
+  }
+  uint2 pixel = uint2((point.x * 2 + 1) * params.x / (params.z * 2),
+                      (point.y * 2 + 1) * params.y / (params.w * 2));
+  samples[point.y * params.z + point.x] = half4(source.read(pixel));
+}
+)MSL";
+
+// FXAA 3.11 console-style filter over the gamma-corrected output, with the luma of each pixel in
+// alpha, with the constants of the Vulkan backend's FXAA so both look the same. Colors and lumas
+// are half precision, coordinates single precision (half is too coarse for 720p positions), and
+// the quality is a function constant, so each variant is compiled without the other's branches.
+NSString* const kSwapFxaaShaderSource = @R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+constant bool kExtremeQuality [[function_constant(0)]];
+struct FxaaConstants {
+  uint2 size;
+  float2 size_inv;
+};
+kernel void swap_fxaa(uint2 pixel [[thread_position_in_grid]],
+                      constant FxaaConstants& constants [[buffer(0)]],
+                      texture2d<half> source [[texture(0)]],
+                      sampler source_sampler [[sampler(0)]],
+                      texture2d<half, access::write> dest [[texture(1)]]) {
+  if (any(pixel >= constants.size)) {
+    return;
+  }
+  const half edge_threshold = kExtremeQuality ? 0.063h : 0.166h;
+  const half edge_threshold_min = kExtremeQuality ? 0.0312h : 0.0833h;
+  const float span_max = kExtremeQuality ? 12.0 : 8.0;
+  const half dir_reduce_mul = 0.125h;
+  const half dir_reduce_min = 1.0h / 128.0h;
+  const half3 luma_weights = half3(0.299h, 0.587h, 0.114h);
+
+  float2 texel = constants.size_inv;
+  float2 uv = (float2(pixel) + 0.5) * texel;
+  half4 rgbm = source.sample(source_sampler, uv, level(0.0));
+  half luma_m = rgbm.a;
+  half luma_nw = source.sample(source_sampler, uv + float2(-texel.x, -texel.y), level(0.0)).a;
+  half luma_ne = source.sample(source_sampler, uv + float2(texel.x, -texel.y), level(0.0)).a;
+  half luma_sw = source.sample(source_sampler, uv + float2(-texel.x, texel.y), level(0.0)).a;
+  half luma_se = source.sample(source_sampler, uv + float2(texel.x, texel.y), level(0.0)).a;
+
+  half luma_min = min(luma_m, min(min(luma_nw, luma_ne), min(luma_sw, luma_se)));
+  half luma_max = max(luma_m, max(max(luma_nw, luma_ne), max(luma_sw, luma_se)));
+  half3 result = rgbm.rgb;
+  if (luma_max - luma_min >= max(edge_threshold_min, luma_max * edge_threshold)) {
+    float2 dir = float2(-((luma_nw + luma_ne) - (luma_sw + luma_se)),
+                        (luma_nw + luma_sw) - (luma_ne + luma_se));
+    float dir_reduce = float(max((luma_nw + luma_ne + luma_sw + luma_se) *
+                                     (0.25h * dir_reduce_mul),
+                                 dir_reduce_min));
+    float rcp_dir_min = 1.0 / (min(abs(dir.x), abs(dir.y)) + dir_reduce);
+    dir = clamp(dir * rcp_dir_min, float2(-span_max), float2(span_max)) * texel;
+    half3 rgb_a = 0.5h * (source.sample(source_sampler, uv + dir * (1.0 / 3.0 - 0.5),
+                                        level(0.0)).rgb +
+                          source.sample(source_sampler, uv + dir * (2.0 / 3.0 - 0.5),
+                                        level(0.0)).rgb);
+    half3 rgb_b = rgb_a * 0.5h +
+                  0.25h * (source.sample(source_sampler, uv + dir * -0.5, level(0.0)).rgb +
+                           source.sample(source_sampler, uv + dir * 0.5, level(0.0)).rgb);
+    half luma_b = dot(rgb_b, luma_weights);
+    result = (luma_b < luma_min || luma_b > luma_max) ? rgb_a : rgb_b;
+  }
+  dest.write(half4(result, 1.0h), pixel);
+}
+)MSL";
+
+// Adds the GPU time of a completed command buffer to the host_gpu_time_us counter, counting the
+// part that overlaps the previous completed command buffers once. Called from Metal's completion
+// handler threads.
+void AccountGpuTime(CFTimeInterval start, CFTimeInterval end) {
+  static std::mutex mutex;
+  static CFTimeInterval last_end = 0;
+  std::lock_guard<std::mutex> lock(mutex);
+  start = std::max(start, last_end);
+  if (end > start) {
+    PERF_counter_add(kHostGpuTimeUs, int64_t((end - start) * 1e6));
+  }
+  last_end = std::max(last_end, end);
+}
+
+NSString* GetEncoderLabel(rex::perf::CounterId reason) {
+  switch (reason) {
+    case rex::perf::CounterId::kRenderPassEndsResolve:
+      return @"Resolve";
+    case rex::perf::CounterId::kRenderPassEndsTransfer:
+      return @"Render target transfer";
+    case rex::perf::CounterId::kRenderPassEndsTextureLoad:
+      return @"Texture load";
+    default:
+      return @"Other";
+  }
+}
+
+// Label of a pass of guest draws for GPU captures and traces: the render targets it draws to, by
+// the names of their textures (the render target keys), so the cost of each pass of the game's
+// frame can be told apart.
+NSString* GetGuestDrawsLabel(const MetalRenderPass& render_pass) {
+  NSMutableString* label = [NSMutableString stringWithString:@"Guest draws:"];
+  auto append = [label](id<MTLTexture> texture) {
+    id<MTLTexture> named = texture.parentTexture ? texture.parentTexture : texture;
+    [label appendFormat:@" [%@]", named.label ? named.label : @"?"];
+  };
+  for (id<MTLTexture> color : render_pass.color) {
+    if (color) {
+      append(color);
+    }
+  }
+  if (render_pass.depth_stencil) {
+    append(render_pass.depth_stencil);
+  }
+  return label;
+}
