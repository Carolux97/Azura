+
+void GraphicsSystem::AddShaderCompilationQueued(uint32_t count) {
+  if (!count) {
+    return;
+  }
+  std::function<void()> started_callback;
+  {
+    std::lock_guard<std::mutex> lock(shader_compilation_mutex_);
+    if (shader_compilation_.queued == shader_compilation_.done) {
+      started_callback = shader_compilation_started_callback_;
+    }
+    shader_compilation_.queued += count;
+    shader_compilation_.total_queued += count;
+  }
+  if (started_callback) {
+    started_callback();
+  }
+}
+
+void GraphicsSystem::AddShaderCompilationDone(uint32_t count) {
+  std::lock_guard<std::mutex> lock(shader_compilation_mutex_);
+  const uint32_t done = std::min(shader_compilation_.done + count, shader_compilation_.queued);
+  shader_compilation_.total_done += done - shader_compilation_.done;
+  shader_compilation_.done = done;
+  if (shader_compilation_.done == shader_compilation_.queued) {
+    shader_compilation_.queued = 0;
+    shader_compilation_.done = 0;
+  }
+}
+
+void GraphicsSystem::SetShaderCompilationStartedCallback(std::function<void()> callback) {
+  std::lock_guard<std::mutex> lock(shader_compilation_mutex_);
+  shader_compilation_started_callback_ = std::move(callback);
+}
