+MetalCommandProcessor::ScratchBuffer MetalCommandProcessor::AcquireScratchBuffer(size_t size) {
+  ScratchBuffer scratch;
+  UpdateCompletedSubmission();
+  scratch.buffer = scratch_buffer_pool_->Request(GetCurrentSubmission(), GetCompletedSubmission(),
+                                                 std::max(size, size_t(16)), 256, scratch.offset);
+  return scratch;
+}
