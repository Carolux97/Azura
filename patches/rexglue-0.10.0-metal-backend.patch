+/**
+ * @file        graphics/metal/metal_provider.h
+ * @brief       Metal graphics provider: the device and queue shared by the GPU emulation and the
+ *              presenter
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <memory>
+
+#include <rex/ui/graphics_provider.h>
+
+#ifdef __OBJC__
+#import <Metal/Metal.h>
+#endif
+
+namespace rex::graphics::metal {
+
+class MetalProvider final : public ui::GraphicsProvider {
+ public:
+  static std::unique_ptr<MetalProvider> Create();
+  ~MetalProvider() override;
+
+  std::unique_ptr<ui::Presenter> CreatePresenter(
+      ui::Presenter::HostGpuLossCallback host_gpu_loss_callback =
+          ui::Presenter::FatalErrorHostGpuLossCallback) override;
+  // The Dear ImGui overlays (F4 settings, debug overlay) are not drawn with Metal yet.
+  // For the UI drawers (ImGui overlays) the presenter runs over the guest output.
+  std::unique_ptr<ui::ImmediateDrawer> CreateImmediateDrawer() override;
+
+#ifdef __OBJC__
+  id<MTLDevice> device() const { return device_; }
+  // One queue for the GPU emulation and presentation, so work committed earlier runs earlier.
+  id<MTLCommandQueue> queue() const { return queue_; }
+#endif
+
+ private:
+  MetalProvider() = default;
+#ifdef __OBJC__
+  id<MTLDevice> device_ = nil;
+  id<MTLCommandQueue> queue_ = nil;
+#else
+  void* device_ = nullptr;
+  void* queue_ = nullptr;
+#endif
+};
+
+}  // namespace rex::graphics::metal
