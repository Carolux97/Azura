+#include "metal_render_target_cache.h"
+#include "metal_spirv.h"
+
+namespace rex::graphics::metal {
+
+namespace {
+
+// Microseconds since start, for the shader and pipeline compilation counters.
+[[maybe_unused]] int64_t MicrosecondsSince(std::chrono::steady_clock::time_point start) {
+  return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                               start)
+      .count();
+}
+
+// Vulkan descriptor sets of the translated shaders to Metal argument table indices. Textures come
+// first in the texture sets, then samplers (the translator numbers samplers after textures).
+std::vector<MslBinding> GetGuestShaderBindings(const MetalShader& shader) {
+  std::vector<MslBinding> bindings;
+  bindings.push_back({SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram, 0,
+                      MslBinding::Kind::kBuffer, kMetalBufferSharedMemory});
+  for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+    bindings.push_back({SpirvShaderTranslator::kDescriptorSetConstants, i,
+                        MslBinding::Kind::kBuffer, kMetalBufferConstantsFirst + i});
+  }
+  uint32_t texture_set = shader.type() == xenos::ShaderType::kVertex
+                             ? SpirvShaderTranslator::kDescriptorSetTexturesVertex
+                             : SpirvShaderTranslator::kDescriptorSetTexturesPixel;
+  uint32_t texture_count = uint32_t(shader.GetTextureBindingsAfterTranslation().size());
+  uint32_t sampler_count = uint32_t(shader.GetSamplerBindingsAfterTranslation().size());
+  for (uint32_t i = 0; i < texture_count; ++i) {
+    bindings.push_back({texture_set, i, MslBinding::Kind::kTexture, i});
+  }
+  for (uint32_t i = 0; i < sampler_count; ++i) {
+    bindings.push_back({texture_set, texture_count + i, MslBinding::Kind::kSampler, i});
+  }
+  return bindings;
+}
+
+MTLBlendFactor GetBlendFactor(xenos::BlendFactor factor) {
+  switch (factor) {
+    case xenos::BlendFactor::kZero:
+      return MTLBlendFactorZero;
+    case xenos::BlendFactor::kOne:
+      return MTLBlendFactorOne;
+    case xenos::BlendFactor::kSrcColor:
+      return MTLBlendFactorSourceColor;
+    case xenos::BlendFactor::kOneMinusSrcColor:
+      return MTLBlendFactorOneMinusSourceColor;
+    case xenos::BlendFactor::kSrcAlpha:
+      return MTLBlendFactorSourceAlpha;
+    case xenos::BlendFactor::kOneMinusSrcAlpha:
+      return MTLBlendFactorOneMinusSourceAlpha;
+    case xenos::BlendFactor::kDstColor:
+      return MTLBlendFactorDestinationColor;
+    case xenos::BlendFactor::kOneMinusDstColor:
+      return MTLBlendFactorOneMinusDestinationColor;
+    case xenos::BlendFactor::kDstAlpha:
+      return MTLBlendFactorDestinationAlpha;
+    case xenos::BlendFactor::kOneMinusDstAlpha:
+      return MTLBlendFactorOneMinusDestinationAlpha;
+    case xenos::BlendFactor::kConstantColor:
+      return MTLBlendFactorBlendColor;
+    case xenos::BlendFactor::kOneMinusConstantColor:
+      return MTLBlendFactorOneMinusBlendColor;
+    case xenos::BlendFactor::kConstantAlpha:
+      return MTLBlendFactorBlendAlpha;
+    case xenos::BlendFactor::kOneMinusConstantAlpha:
+      return MTLBlendFactorOneMinusBlendAlpha;
+    case xenos::BlendFactor::kSrcAlphaSaturate:
+      return MTLBlendFactorSourceAlphaSaturated;
+    default:
+      return MTLBlendFactorZero;
+  }
+}
+
+MTLBlendOperation GetBlendOperation(xenos::BlendOp op) {
+  switch (op) {
+    case xenos::BlendOp::kAdd:
+      return MTLBlendOperationAdd;
+    case xenos::BlendOp::kSubtract:
+      return MTLBlendOperationSubtract;
+    case xenos::BlendOp::kMin:
+      return MTLBlendOperationMin;
+    case xenos::BlendOp::kMax:
+      return MTLBlendOperationMax;
+    case xenos::BlendOp::kRevSubtract:
+      return MTLBlendOperationReverseSubtract;
+    default:
+      return MTLBlendOperationAdd;
+  }
+}
+
+// The Xenos and Metal compare functions and stencil operations have the same order.
+MTLCompareFunction GetCompareFunction(xenos::CompareFunction function) {
+  return MTLCompareFunction(uint32_t(function));
+}
+MTLStencilOperation GetStencilOperation(xenos::StencilOp op) {
+  return MTLStencilOperation(uint32_t(op));
+}
+
+// Blend state of one color target packed in 32 bits for the pipeline key: write mask (4),
+// factors (5 each) and operations (3 each). Zero write mask means not written at all.
+uint32_t PackBlend(reg::RB_BLENDCONTROL blend_control, uint32_t write_mask) {
+  if (!write_mask) {
+    return 0;
+  }
+  return write_mask | (uint32_t(blend_control.color_srcblend) << 4) |
+         (uint32_t(blend_control.color_destblend) << 9) |
+         (uint32_t(blend_control.color_comb_fcn) << 14) |
+         (uint32_t(blend_control.alpha_srcblend) << 17) |
+         (uint32_t(blend_control.alpha_destblend) << 22) |
+         (uint32_t(blend_control.alpha_comb_fcn) << 27);
+}
+
+}  // namespace
+
+id<MTLFunction> MetalShader::MetalTranslation::GetOrCreateFunction(id<MTLDevice> device,
+                                                                   bool rasterization_disabled) {
+  const MetalShader& metal_shader = static_cast<const MetalShader&>(shader());
+  // Only vertex shaders have the variant.
+  size_t variant = rasterization_disabled && metal_shader.type() == xenos::ShaderType::kVertex;
+  std::lock_guard<std::mutex> lock(function_mutex_);
+  if (functions_[variant] || functions_failed_[variant]) {
+    return functions_[variant];
+  }
+  if (!is_valid()) {
+    functions_failed_[variant] = true;
+    return nil;
+  }
+  MslShader msl;
+  std::string name;
+  if (is_xsc_) {
+    // The Xenos shader compiler's binary is the MSL source, with a second entry point for vertex
+    // shaders in pipelines without rasterization, built instead of the first with its macro.
+    const std::vector<uint8_t>& source = translated_binary();
+    msl.source.assign(source.begin(), source.end());
+    msl.entry_point = xsc::XscShaderTranslator::GetEntryPointName(metal_shader, modification());
+    if (variant) {
+      msl.entry_point += "_norast";
+      msl.preprocessor_macro = xsc::kMslNoRasterizationMacro;
+    }
+    name = msl.entry_point;
+  } else {
+    const std::vector<uint8_t>& spirv = translated_binary();
+    MslStage stage =
+        metal_shader.type() == xenos::ShaderType::kVertex ? MslStage::kVertex : MslStage::kFragment;
+    name = fmt::format("{} {:016X} modification {:016X}{}",
+                       stage == MslStage::kVertex ? "vertex shader" : "pixel shader",
+                       metal_shader.ucode_data_hash(), modification(),
+                       variant ? " without rasterization" : "");
+    // Named by the guest shader and its modification, as in the Metal traces and GPU captures.
+    // Pixel shaders also carry what affects hidden surface removal: e (early depth and stencil
+    // tests), k (kill instructions), z (depth written by the shader).
+    std::string flags;
+    if (stage == MslStage::kFragment) {
+      if (SpirvShaderTranslator::Modification(modification()).pixel.depth_stencil_mode ==
+          SpirvShaderTranslator::Modification::DepthStencilMode::kEarlyHint) {
+        flags += 'e';
+      }
+      if (metal_shader.kills_pixels()) {
+        flags += 'k';
+      }
+      if (metal_shader.writes_depth()) {
+        flags += 'z';
+      }
+    }
+    std::string entry_point_name =
+        fmt::format("{}_{:016x}_{:016x}{}{}{}", stage == MslStage::kVertex ? "vs" : "ps",
+                    metal_shader.ucode_data_hash(), modification(), flags.empty() ? "" : "_", flags,
+                    variant ? "_norast" : "");
+    [[maybe_unused]] auto conversion_start = std::chrono::steady_clock::now();
+    bool converted = SpirvToMsl(reinterpret_cast<const uint32_t*>(spirv.data()),
+                                spirv.size() / sizeof(uint32_t), stage,
+                                GetGuestShaderBindings(metal_shader), msl, variant != 0,
+                                entry_point_name);
+    // The second half of the SPIR-V translator's translation to MSL.
+    PERF_counter_add(kShaderTranslationUs, MicrosecondsSince(conversion_start));
+    if (!converted) {
+      REXGPU_ERROR("Metal: failed to convert the {} to MSL", name);
+      functions_failed_[variant] = true;
+      return nil;
+    }
+    needs_buffer_sizes_ = needs_buffer_sizes_ || msl.needs_buffer_sizes;
+  }
+  [[maybe_unused]] auto compile_start = std::chrono::steady_clock::now();
+  functions_[variant] = CompileMslFunction(device, msl, name.c_str());
+  PERF_counter_inc(kShaderLibraryCompiles);
+  PERF_counter_add(kShaderLibraryCompileUs, MicrosecondsSince(compile_start));
+  if (!functions_[variant]) {
+    functions_failed_[variant] = true;
+  }
+  return functions_[variant];
+}
+
+Shader::Translation* MetalShader::CreateTranslationInstance(uint64_t modification) {
+  return new MetalTranslation(*this, modification);
+}
