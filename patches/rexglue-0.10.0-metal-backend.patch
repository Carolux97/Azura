+MetalPipelineCache::MetalPipelineCache(MetalCommandProcessor& command_processor,
+                                       const RegisterFile& register_file,
+                                       MetalRenderTargetCache& render_target_cache)
+    : command_processor_(command_processor),
+      register_file_(register_file),
+      render_target_cache_(render_target_cache) {}
+
+MetalPipelineCache::~MetalPipelineCache() { Shutdown(); }
+
+bool MetalPipelineCache::Initialize() {
+  // What Metal on Apple GPUs supports, in Vulkan terms.
+  SpirvShaderTranslator::Features features(true);
+  features.cull_distance = false;
+  features.fragment_shader_sample_interlock = false;
+  features.signed_zero_inf_nan_preserve_float32 = false;
+  features.denorm_flush_to_zero_float32 = false;
+  features.rounding_mode_rte_float32 = false;
+  // The draw resolution scale as a ratio (3/2 for 1920x1080).
+  DrawResolutionScale scale = render_target_cache_.draw_resolution_scale();
+  shader_translator_ = std::make_unique<SpirvShaderTranslator>(
+      features, true, true, false, scale.numerator_x, scale.numerator_y, scale.denominator);
+  if (REXCVAR_GET(shader_compiler) == "xsc") {
+    xsc_translator_ = std::make_unique<xsc::XscShaderTranslator>(
+        xsc::XscShaderTranslator::Target::kMsl, features, true, scale.numerator_x,
+        scale.numerator_y, scale.denominator);
+    if (REXCVAR_GET(xsc_debug_color_range)) {
+      xsc_translator_->set_debug_color_range(true);
+      REXGPU_INFO("Metal: XSC paints out-of-range pixel shader colors (xsc_debug_color_range)");
+    }
+    REXGPU_INFO("Metal: shaders translated by the Xenos shader compiler (XSC)");
+  }
+
+  // Creation threads for the storage preload and async_shader_compilation. The Metal compiler runs
+  // in its own service processes, so these mostly wait for it.
+  uint32_t creation_thread_count =
+      std::clamp(rex::thread::logical_processor_count() * 3 / 4, uint32_t(1), uint32_t(8));
+  creation_threads_shutdown_ = false;
+  for (uint32_t i = 0; i < creation_thread_count; ++i) {
+    std::unique_ptr<rex::thread::Thread> thread =
+        rex::thread::Thread::Create({}, [this]() { CreationThread(); });
+    if (!thread) {
+      break;
+    }
+    thread->set_name("Metal Pipelines");
+    creation_threads_.push_back(std::move(thread));
+  }
+  return true;
+}
+
+void MetalPipelineCache::Shutdown() {
+  {
+    std::lock_guard<std::mutex> lock(creation_queue_mutex_);
+    creation_threads_shutdown_ = true;
+    translation_queue_.clear();
+    creation_queue_for_draws_.clear();
+    function_queue_.clear();
+    creation_queue_preload_.clear();
+  }
+  creation_queue_condition_.notify_all();
+  for (const auto& thread : creation_threads_) {
+    rex::thread::Wait(thread.get(), false);
+  }
+  creation_threads_.clear();
+  ShutdownShaderStorage();
+  pipelines_.clear();
+  depth_stencil_states_.clear();
+  for (auto& shader : shaders_) {
+    delete shader.second;
+  }
+  shaders_.clear();
+  shader_translator_.reset();
+  xsc_translator_.reset();
+}
+
+MetalShader* MetalPipelineCache::LoadShader(xenos::ShaderType shader_type,
+                                            const uint32_t* host_address, uint32_t dword_count) {
+  uint64_t data_hash = XXH3_64bits(host_address, dword_count * sizeof(uint32_t));
+  auto it = shaders_.find(data_hash);
+  if (it != shaders_.end()) {
+    return it->second;
+  }
+  auto* shader = new MetalShader(shader_type, data_hash, host_address, dword_count);
+  shaders_.emplace(data_hash, shader);
+  return shader;
+}
+
+SpirvShaderTranslator::Modification MetalPipelineCache::GetCurrentVertexShaderModification(
+    const Shader& shader, Shader::HostVertexShaderType host_vertex_shader_type,
+    uint32_t interpolator_mask, bool ps_param_gen_used) const {
+  const auto& regs = register_file_;
+  SpirvShaderTranslator::Modification modification(
+      shader_translator_->GetDefaultVertexShaderModification(
+          shader.GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().vs_num_reg),
+          host_vertex_shader_type));
+  modification.vertex.interpolator_mask = interpolator_mask;
+  modification.vertex.tessellation_mode =
+      Shader::IsHostVertexShaderTypeDomain(host_vertex_shader_type)
+          ? uint32_t(regs.Get<reg::VGT_HOS_CNTL>().tess_mode)
+          : 0;
+  // Metal has clip distances but no cull distances.
+  auto pa_cl_clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  uint32_t user_clip_planes = pa_cl_clip_cntl.clip_disable ? 0 : pa_cl_clip_cntl.ucp_ena;
+  modification.vertex.user_clip_plane_cull = 0;
+  modification.vertex.user_clip_plane_count = rex::bit_count(user_clip_planes);
+  modification.vertex.point_ps_ucp_mode = pa_cl_clip_cntl.ps_ucp_mode;
+  if (host_vertex_shader_type == Shader::HostVertexShaderType::kPointListAsTriangleStrip) {
+    modification.vertex.output_point_parameters = uint32_t(ps_param_gen_used);
+  } else {
+    modification.vertex.output_point_parameters =
+        uint32_t((shader.writes_point_size_edge_flag_kill_vertex() & 0b001) &&
+                 regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type == xenos::PrimitiveType::kPointList);
+  }
+  modification.vertex.vertex_kill_and = 0;
+  return modification;
+}
+
+SpirvShaderTranslator::Modification MetalPipelineCache::GetCurrentPixelShaderModification(
+    const Shader& shader, uint32_t interpolator_mask, uint32_t param_gen_pos,
+    reg::RB_DEPTHCONTROL normalized_depth_control) const {
+  const auto& regs = register_file_;
+  SpirvShaderTranslator::Modification modification(
+      shader_translator_->GetDefaultPixelShaderModification(
+          shader.GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().ps_num_reg)));
+  modification.pixel.interpolator_mask = interpolator_mask;
+  modification.pixel.interpolators_centroid =
+      interpolator_mask & ~xenos::GetInterpolatorSamplingPattern(
+                              regs.Get<reg::RB_SURFACE_INFO>().msaa_samples,
+                              regs.Get<reg::SQ_CONTEXT_MISC>().sc_sample_cntl,
+                              regs.Get<reg::SQ_INTERPOLATOR_CNTL>().sampling_pattern);
+  if (param_gen_pos < xenos::kMaxInterpolators) {
+    modification.pixel.param_gen_enable = 1;
+    modification.pixel.param_gen_interpolator = param_gen_pos;
+    modification.pixel.param_gen_point =
+        uint32_t(regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type == xenos::PrimitiveType::kPointList);
+  } else {
+    modification.pixel.param_gen_enable = 0;
+    modification.pixel.param_gen_interpolator = 0;
+    modification.pixel.param_gen_point = 0;
+  }
+  // With sample-space render targets, the guest pixel position is the host one divided by the
+  // host pixels per guest pixel of the guest MSAA mode.
+  xenos::MsaaSamples guest_msaa_samples = regs.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+  modification.pixel.sample_space_x_log2 =
+      render_target_cache_.GetSampleSpaceXLog2(guest_msaa_samples);
+  modification.pixel.sample_space_y_log2 =
+      render_target_cache_.GetSampleSpaceYLog2(guest_msaa_samples);
+  // Draws computing data rather than an image are evaluated at the guest pixel centers.
+  modification.pixel.guest_pixel_center = uint32_t(render_target_cache_.IsCurrentDrawData());
+  using DepthStencilMode = SpirvShaderTranslator::Modification::DepthStencilMode;
+  if (render_target_cache_.depth_float24_convert_in_pixel_shader() &&
+      normalized_depth_control.z_enable &&
+      regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8) {
+    modification.pixel.depth_stencil_mode = render_target_cache_.depth_float24_round()
+                                                ? DepthStencilMode::kFloat24Rounding
+                                                : DepthStencilMode::kFloat24Truncating;
+  } else if (shader.implicit_early_z_write_allowed() &&
+             (!shader.writes_color_target(0) ||
+              !draw_util::DoesCoverageDependOnAlpha(regs.Get<reg::RB_COLORCONTROL>()))) {
+    modification.pixel.depth_stencil_mode = DepthStencilMode::kEarlyHint;
+  } else {
+    modification.pixel.depth_stencil_mode = DepthStencilMode::kNoModifiers;
+  }
+  return modification;
+}
+
+bool MetalPipelineCache::EnsureTranslated(MetalShader::MetalTranslation& translation,
+                                          bool compile_function) {
+  using TranslationState = MetalShader::MetalTranslation::TranslationState;
+  if (translation.translation_state().load(std::memory_order_acquire) ==
+      TranslationState::kTranslated) {
+    return translation.is_valid();
+  }
+  std::lock_guard<std::mutex> lock(translation_mutex_);
+  if (!translation.is_translated()) {
+    [[maybe_unused]] auto translation_start = std::chrono::steady_clock::now();
+    // A no-op for the shaders of draws, which the command processor thread analyzes first; the
+    // preloaded ones are analyzed here, on that thread.
+    translation.shader().AnalyzeUcode(ucode_disasm_buffer_);
+    // The Xenos shader compiler first if enabled; what it does not support yet goes to the
+    // SPIR-V translator. Both fill the same texture and sampler bindings.
+    bool translated_by_xsc = xsc_translator_ && xsc_translator_->TranslateAnalyzedShader(translation);
+    translation.set_is_xsc(translated_by_xsc);
+    bool translated = translated_by_xsc || shader_translator_->TranslateAnalyzedShader(translation);
+    PERF_counter_inc(kShaderTranslations);
+    PERF_counter_add(kShaderTranslationUs, MicrosecondsSince(translation_start));
+    if (!translated) {
+      REXGPU_ERROR("Metal: shader {:016X} translation failed",
+                   translation.shader().ucode_data_hash());
+    }
+    // The first compilation of a new shader costs tens of milliseconds, so it starts now rather
+    // than when a pipeline needs the function (on the command processor thread, for draws that
+    // cannot be skipped).
+    if (compile_function && translation.is_valid()) {
+      QueueFunctionCompilation(translation);
+    }
+  }
+  translation.translation_state().store(TranslationState::kTranslated, std::memory_order_release);
+  return translation.is_valid();
+}
+
+bool MetalPipelineCache::PrepareShadersForDraw(MetalShader::MetalTranslation* vertex_shader,
+                                               MetalShader::MetalTranslation* pixel_shader,
+                                               bool allow_async, bool& pending_out) {
+  using TranslationState = MetalShader::MetalTranslation::TranslationState;
+  pending_out = false;
+  bool async = allow_async && !creation_threads_.empty();
+  for (MetalShader::MetalTranslation* translation : {vertex_shader, pixel_shader}) {
+    if (!translation) {
+      continue;
+    }
+    TranslationState state = translation->translation_state().load(std::memory_order_acquire);
+    if (state == TranslationState::kTranslated) {
+      if (!translation->is_valid()) {
+        return false;
+      }
+      continue;
+    }
+    if (async) {
+      // Queued once; the draws that need it meanwhile are skipped.
+      if (state == TranslationState::kNotTranslated &&
+          translation->translation_state().compare_exchange_strong(state,
+                                                                   TranslationState::kQueued)) {
+        QueueTranslation(*translation);
+      }
+      pending_out = true;
+      continue;
+    }
+    // Needed now: translated here, or after a creation thread that is translating it.
+    if (!EnsureTranslated(*translation)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool MetalPipelineCache::ConfigurePipeline(
+    MetalShader::MetalTranslation* vertex_shader, MetalShader::MetalTranslation* pixel_shader,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    const MetalRenderPassFormats& formats, bool allow_async,
+    __strong id<MTLRenderPipelineState>& pipeline_out, MetalDrawState& state_out,
+    bool& pending_out) {
+  const RegisterFile& regs = register_file_;
+  state_out = MetalDrawState();
+  pipeline_out = nil;
+  pending_out = false;
+
+  // Primitive type. Fans, quads, points and rectangles are converted or expanded before here.
+  MTLPrimitiveTopologyClass topology_class = MTLPrimitiveTopologyClassTriangle;
+  switch (primitive_processing_result.host_primitive_type) {
+    case xenos::PrimitiveType::kPointList:
+      state_out.primitive_type = MTLPrimitiveTypePoint;
+      topology_class = MTLPrimitiveTopologyClassPoint;
+      break;
+    case xenos::PrimitiveType::kLineList:
+      state_out.primitive_type = MTLPrimitiveTypeLine;
+      topology_class = MTLPrimitiveTopologyClassLine;
+      break;
+    case xenos::PrimitiveType::kLineStrip:
+      state_out.primitive_type = MTLPrimitiveTypeLineStrip;
+      topology_class = MTLPrimitiveTopologyClassLine;
+      break;
+    case xenos::PrimitiveType::kTriangleList:
+    case xenos::PrimitiveType::kRectangleList:
+      state_out.primitive_type = MTLPrimitiveTypeTriangle;
+      break;
+    case xenos::PrimitiveType::kTriangleStrip:
+      state_out.primitive_type = MTLPrimitiveTypeTriangleStrip;
+      break;
+    default:
+      REXGPU_ERROR("Metal: unsupported host primitive type {}",
+                   uint32_t(primitive_processing_result.host_primitive_type));
+      return false;
+  }
+
+  bool primitive_polygonal = draw_util::IsPrimitivePolygonal(regs);
+  bool rasterization_enabled = draw_util::IsRasterizationPotentiallyDone(regs, primitive_polygonal);
+  state_out.rasterization_disabled = !rasterization_enabled;
+
+  PipelineDescription key;
+  std::memset(&key, 0, sizeof(key));
+  // Attachment formats must match the render pass even when nothing is rasterized.
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    key.color_formats[i] = uint32_t(formats.color[i]);
+  }
+  key.depth_format = uint32_t(formats.depth);
+  key.stencil_format = formats.depth_has_stencil ? uint32_t(formats.depth) : 0;
+  key.vertex_shader_hash = vertex_shader->shader().ucode_data_hash();
+  key.vertex_shader_modification = vertex_shader->modification();
+  if (pixel_shader) {
+    key.pixel_shader_hash = pixel_shader->shader().ucode_data_hash();
+    key.pixel_shader_modification = pixel_shader->modification();
+  }
+  key.sample_count = formats.sample_count;
+  key.rasterization_disabled = state_out.rasterization_disabled;
+  key.topology_class = uint32_t(topology_class);
+
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (rasterization_enabled) {
+    if (primitive_polygonal) {
+      bool cull_front = pa_su_sc_mode_cntl.cull_front;
+      bool cull_back = pa_su_sc_mode_cntl.cull_back;
+      if (cull_front && cull_back) {
+        // Nothing would be drawn; Metal can cull only one side, discard everything instead.
+        state_out.rasterization_disabled = true;
+        key.rasterization_disabled = 1;
+      } else if (cull_front) {
+        state_out.cull_mode = MTLCullModeFront;
+      } else if (cull_back) {
+        state_out.cull_mode = MTLCullModeBack;
+      }
+      state_out.winding =
+          pa_su_sc_mode_cntl.face ? MTLWindingClockwise : MTLWindingCounterClockwise;
+      xenos::PolygonType polygon_type = xenos::PolygonType::kTriangles;
+      if (pa_su_sc_mode_cntl.poly_mode == xenos::PolygonModeEnable::kDualMode) {
+        if (!cull_front) {
+          polygon_type = std::min(polygon_type, pa_su_sc_mode_cntl.polymode_front_ptype);
+        }
+        if (!cull_back) {
+          polygon_type = std::min(polygon_type, pa_su_sc_mode_cntl.polymode_back_ptype);
+        }
+      }
+      if (polygon_type != xenos::PolygonType::kTriangles) {
+        state_out.fill_mode = MTLTriangleFillModeLines;
+      }
+    }
+    if (regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+      state_out.depth_clip_mode = MTLDepthClipModeClamp;
+    }
+
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (formats.color[i] == MTLPixelFormatInvalid || !pixel_shader) {
+        continue;
+      }
+      key.blend[i] = PackBlend(
+          regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]),
+          (normalized_color_mask >> (i * 4)) & 0b1111);
+    }
+    key.alpha_to_coverage = pixel_shader && formats.sample_count > 1 &&
+                            regs.Get<reg::RB_COLORCONTROL>().alpha_to_mask_enable;
+  } else {
+    // Only the vertex shader's side effects (memexport) matter.
+    key.pixel_shader_hash = 0;
+    key.pixel_shader_modification = 0;
+  }
+
+  // Depth and stencil.
+  if (formats.depth != MTLPixelFormatInvalid && rasterization_enabled) {
+    DepthStencilKey ds_key;
+    std::memset(&ds_key, 0, sizeof(ds_key));
+    if (normalized_depth_control.z_enable) {
+      ds_key.depth_compare = uint32_t(normalized_depth_control.zfunc);
+      ds_key.depth_write = normalized_depth_control.z_write_enable;
+    } else {
+      ds_key.depth_compare = uint32_t(xenos::CompareFunction::kAlways);
+    }
+    if (normalized_depth_control.stencil_enable && formats.depth_has_stencil) {
+      ds_key.stencil_enable = 1;
+      auto pack_face = [](xenos::CompareFunction func, xenos::StencilOp fail,
+                          xenos::StencilOp depth_fail, xenos::StencilOp pass) {
+        return uint32_t(func) | (uint32_t(fail) << 3) | (uint32_t(depth_fail) << 6) |
+               (uint32_t(pass) << 9);
+      };
+      ds_key.front = pack_face(normalized_depth_control.stencilfunc,
+                               normalized_depth_control.stencilfail,
+                               normalized_depth_control.stencilzfail,
+                               normalized_depth_control.stencilzpass);
+      if (primitive_polygonal && normalized_depth_control.backface_enable) {
+        ds_key.back = pack_face(normalized_depth_control.stencilfunc_bf,
+                                normalized_depth_control.stencilfail_bf,
+                                normalized_depth_control.stencilzfail_bf,
+                                normalized_depth_control.stencilzpass_bf);
+      } else {
+        ds_key.back = ds_key.front;
+      }
+      auto stencil_ref_mask = regs.Get<reg::RB_STENCILREFMASK>();
+      ds_key.read_mask_front = stencil_ref_mask.stencilmask;
+      ds_key.write_mask_front = stencil_ref_mask.stencilwritemask;
+      if (primitive_polygonal && normalized_depth_control.backface_enable) {
+        auto stencil_ref_mask_bf =
+            regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF);
+        ds_key.read_mask_back = stencil_ref_mask_bf.stencilmask;
+        ds_key.write_mask_back = stencil_ref_mask_bf.stencilwritemask;
+      } else {
+        ds_key.read_mask_back = ds_key.read_mask_front;
+        ds_key.write_mask_back = ds_key.write_mask_front;
+      }
+    }
+    state_out.depth_stencil_state = GetDepthStencilState(ds_key);
+  }
+
+  uint64_t key_hash = XXH3_64bits(&key, sizeof(key));
+  auto it = pipelines_.find(key_hash);
+  Pipeline* pipeline;
+  if (it != pipelines_.end()) {
+    pipeline = it->second.get();
+  } else {
+    auto new_pipeline = std::make_unique<Pipeline>();
+    new_pipeline->description = key;
+    new_pipeline->vertex_shader = vertex_shader;
+    new_pipeline->pixel_shader = key.pixel_shader_hash ? pixel_shader : nullptr;
+    pipeline = new_pipeline.get();
+    pipelines_.emplace(key_hash, std::move(new_pipeline));
+    StorePipeline(*pipeline);
+  }
+  switch (pipeline->state.load(std::memory_order_acquire)) {
+    case Pipeline::State::kReady:
+      pipeline_out = pipeline->state_object;
+      return true;
+    case Pipeline::State::kFailed:
+      return false;
+    case Pipeline::State::kPending:
+      break;
+  }
+  if (allow_async && !creation_threads_.empty()) {
+    if (!pipeline->queued_for_draw) {
+      QueuePipelineCreation(*pipeline, true);
+    }
+    pending_out = true;
+    return true;
+  }
+  // Needed now: created here, or waited for if a creation thread has already started it.
+  if (!EnsurePipelineCreated(*pipeline)) {
+    return false;
+  }
+  pipeline_out = pipeline->state_object;
+  return true;
+}
+
+bool MetalPipelineCache::EnsurePipelineCreated(Pipeline& pipeline) {
+  Pipeline::State state = pipeline.state.load(std::memory_order_acquire);
+  if (state == Pipeline::State::kPending) {
+    std::lock_guard<std::mutex> lock(pipeline.creation_mutex);
+    state = pipeline.state.load(std::memory_order_acquire);
+    if (state == Pipeline::State::kPending) {
+      id<MTLRenderPipelineState> state_object =
+          CreatePipeline(pipeline.description, pipeline.vertex_shader, pipeline.pixel_shader);
+      pipeline.state_object = state_object;
+      state = state_object ? Pipeline::State::kReady : Pipeline::State::kFailed;
+      pipeline.state.store(state, std::memory_order_release);
+    }
+  }
+  // Whoever gets here first after the creation reports it to the progress display.
+  if (pipeline.counted_in_progress.exchange(false)) {
+    if (GraphicsSystem* graphics_system = command_processor_.graphics_system()) {
+      graphics_system->AddShaderCompilationDone(1);
+    }
+  }
+  return state == Pipeline::State::kReady;
+}
+
+void MetalPipelineCache::QueuePipelineCreation(Pipeline& pipeline, bool for_draw) {
+  // Counted before a creation thread can take it.
+  if (!pipeline.counted_in_progress.exchange(true)) {
+    if (GraphicsSystem* graphics_system = command_processor_.graphics_system()) {
+      graphics_system->AddShaderCompilationQueued(1);
+    }
+  }
+  {
+    std::lock_guard<std::mutex> lock(creation_queue_mutex_);
+    // A preloaded pipeline a draw is now waiting for is queued again, ahead; the creation threads
+    // skip whichever copy they reach after it is created.
+    (for_draw ? creation_queue_for_draws_ : creation_queue_preload_).push_back(&pipeline);
+  }
+  if (for_draw) {
+    pipeline.queued_for_draw = true;
+  }
+  creation_queue_condition_.notify_one();
+}
+
+void MetalPipelineCache::QueueTranslation(MetalShader::MetalTranslation& translation) {
+  {
+    std::lock_guard<std::mutex> lock(creation_queue_mutex_);
+    translation_queue_.push_back(&translation);
+  }
+  creation_queue_condition_.notify_one();
+}
+
+void MetalPipelineCache::QueueFunctionCompilation(MetalShader::MetalTranslation& translation) {
+  {
+    std::lock_guard<std::mutex> lock(creation_queue_mutex_);
+    function_queue_.push_back(&translation);
+  }
+  creation_queue_condition_.notify_one();
+}
+
+void MetalPipelineCache::CreationThread() {
+  while (true) {
+    MetalShader::MetalTranslation* translation = nullptr;
+    MetalShader::MetalTranslation* function_translation = nullptr;
+    Pipeline* pipeline = nullptr;
+    {
+      std::unique_lock<std::mutex> lock(creation_queue_mutex_);
+      creation_queue_condition_.wait(lock, [this] {
+        return creation_threads_shutdown_ || !translation_queue_.empty() ||
+               !creation_queue_for_draws_.empty() || !function_queue_.empty() ||
+               !creation_queue_preload_.empty();
+      });
+      if (creation_threads_shutdown_) {
+        return;
+      }
+      if (!translation_queue_.empty()) {
+        translation = translation_queue_.front();
+        translation_queue_.pop_front();
+      } else if (!creation_queue_for_draws_.empty()) {
+        pipeline = creation_queue_for_draws_.front();
+        creation_queue_for_draws_.pop_front();
+      } else if (!function_queue_.empty()) {
+        function_translation = function_queue_.front();
+        function_queue_.pop_front();
+      } else {
+        pipeline = creation_queue_preload_.front();
+        creation_queue_preload_.pop_front();
+      }
+    }
+    if (translation) {
+      // Queues its function's compilation when done.
+      EnsureTranslated(*translation);
+    } else if (function_translation) {
+      // Vertex shaders in pipelines without rasterization use a variant made when needed.
+      function_translation->GetOrCreateFunction(command_processor_.device());
+    } else {
+      EnsurePipelineCreated(*pipeline);
+    }
+  }
+}
+
+namespace {
+// Storage file headers: 'XESH' for the guest shaders shared with the Vulkan backend, 'XEPS' with
+// 'MTL ' for this backend's pipelines.
+constexpr uint32_t kShaderStorageMagic = 0x48534558;
+constexpr uint32_t kPipelineStorageMagic = 0x53504558;
+constexpr uint32_t kPipelineStorageMagicApi = 0x204C544D;
+struct ShaderStorageFileHeader {
+  uint32_t magic;
+  uint32_t version_swapped;
+};
+struct PipelineStorageFileHeader {
+  uint32_t magic;
+  uint32_t magic_api;
+  uint32_t version;
+};
+}  // namespace
+
+void MetalPipelineCache::InitializeShaderStorage(const std::filesystem::path& cache_root,
+                                                 uint32_t title_id) {
+  ShutdownShaderStorage();
+  auto storage_root = cache_root / "shaders" / "shareable";
+  std::error_code error_code;
+  std::filesystem::create_directories(storage_root, error_code);
+
+  // Guest shaders, in the format of the Vulkan backend's storage: a header, then for each shader
+  // its hash, type and size, and its ucode in guest byte order (what the hash is computed on).
+  auto shader_storage_path = storage_root / fmt::format("{:08X}.xsh", title_id);
+  shader_storage_file_ = rex::filesystem::OpenFile(shader_storage_path, "a+b");
+  if (!shader_storage_file_) {
+    REXGPU_ERROR("Metal: failed to open the shader storage {}, shaders will not be stored",
+                 rex::path_to_utf8(shader_storage_path));
+    return;
+  }
+  // "a+" leaves the read position at the end on macOS (BSD), and at the start on Linux (glibc).
+  rex::filesystem::Seek(shader_storage_file_, 0, SEEK_SET);
+  ShaderStorageFileHeader shader_file_header;
+  if (std::fread(&shader_file_header, sizeof(shader_file_header), 1, shader_storage_file_) &&
+      shader_file_header.magic == kShaderStorageMagic &&
+      rex::byte_swap(shader_file_header.version_swapped) == ShaderStoredHeader::kVersion) {
+    uint64_t valid_bytes = sizeof(shader_file_header);
+    ShaderStoredHeader shader_header;
+    std::vector<uint32_t> ucode_dwords;
+    // Until the end, or until a record is cut short or corrupted.
+    while (std::fread(&shader_header, sizeof(shader_header), 1, shader_storage_file_)) {
+      size_t ucode_byte_count = shader_header.ucode_dword_count * sizeof(uint32_t);
+      ucode_dwords.resize(shader_header.ucode_dword_count);
+      if (ucode_byte_count &&
+          !std::fread(ucode_dwords.data(), ucode_byte_count, 1, shader_storage_file_)) {
+        break;
+      }
+      if (XXH3_64bits(ucode_dwords.data(), ucode_byte_count) != shader_header.ucode_data_hash) {
+        break;
+      }
+      valid_bytes += sizeof(shader_header) + ucode_byte_count;
+      LoadShader(shader_header.type, ucode_dwords.data(), shader_header.ucode_dword_count);
+      stored_shaders_.insert(shader_header.ucode_data_hash);
+    }
+    rex::filesystem::TruncateStdioFile(shader_storage_file_, valid_bytes);
+  } else {
+    rex::filesystem::TruncateStdioFile(shader_storage_file_, 0);
+    shader_file_header.magic = kShaderStorageMagic;
+    shader_file_header.version_swapped = rex::byte_swap(ShaderStoredHeader::kVersion);
+    std::fwrite(&shader_file_header, sizeof(shader_file_header), 1, shader_storage_file_);
+    std::fflush(shader_storage_file_);
+  }
+
+  // Pipelines: the descriptions, which name their shaders by hash and modification. The version
+  // covers the description layout and the meaning of the modification bits.
+  auto pipeline_storage_path = storage_root / fmt::format("{:08X}.mtl.xpso", title_id);
+  pipeline_storage_file_ = rex::filesystem::OpenFile(pipeline_storage_path, "a+b");
+  if (!pipeline_storage_file_) {
+    REXGPU_ERROR("Metal: failed to open the pipeline storage {}, pipelines will not be stored",
+                 rex::path_to_utf8(pipeline_storage_path));
+    return;
+  }
+  const uint32_t pipeline_storage_version =
+      (PipelineDescription::kVersion << 16) | SpirvShaderTranslator::Modification::kVersion;
+  std::vector<PipelineDescription> descriptions;
+  rex::filesystem::Seek(pipeline_storage_file_, 0, SEEK_SET);
+  PipelineStorageFileHeader pipeline_file_header;
+  if (std::fread(&pipeline_file_header, sizeof(pipeline_file_header), 1,
+                 pipeline_storage_file_) &&
+      pipeline_file_header.magic == kPipelineStorageMagic &&
+      pipeline_file_header.magic_api == kPipelineStorageMagicApi &&
+      pipeline_file_header.version == pipeline_storage_version) {
+    PipelineDescription description;
+    while (std::fread(&description, sizeof(description), 1, pipeline_storage_file_)) {
+      descriptions.push_back(description);
+    }
+    rex::filesystem::TruncateStdioFile(
+        pipeline_storage_file_,
+        sizeof(pipeline_file_header) + sizeof(PipelineDescription) * descriptions.size());
+  } else {
+    rex::filesystem::TruncateStdioFile(pipeline_storage_file_, 0);
+    pipeline_file_header.magic = kPipelineStorageMagic;
+    pipeline_file_header.magic_api = kPipelineStorageMagicApi;
+    pipeline_file_header.version = pipeline_storage_version;
+    std::fwrite(&pipeline_file_header, sizeof(pipeline_file_header), 1, pipeline_storage_file_);
+    std::fflush(pipeline_storage_file_);
+  }
+
+  // Translate the stored pipelines' shaders here, and leave the Metal compilation to the creation
+  // threads, so the game starts meanwhile.
+  auto start = std::chrono::steady_clock::now();
+  auto get_translation = [this](uint64_t hash,
+                                uint64_t modification) -> MetalShader::MetalTranslation* {
+    auto shader_it = shaders_.find(hash);
+    if (shader_it == shaders_.end()) {
+      return nullptr;
+    }
+    auto* translation = static_cast<MetalShader::MetalTranslation*>(
+        shader_it->second->GetOrCreateTranslation(modification));
+    // Its pipelines compile its functions, queued right after.
+    return EnsureTranslated(*translation, false) ? translation : nullptr;
+  };
+  uint32_t queued = 0;
+  for (const PipelineDescription& description : descriptions) {
+    uint64_t key_hash = XXH3_64bits(&description, sizeof(description));
+    if (pipelines_.count(key_hash)) {
+      continue;
+    }
+    MetalShader::MetalTranslation* vertex_shader =
+        get_translation(description.vertex_shader_hash, description.vertex_shader_modification);
+    MetalShader::MetalTranslation* pixel_shader = nullptr;
+    if (description.pixel_shader_hash) {
+      pixel_shader =
+          get_translation(description.pixel_shader_hash, description.pixel_shader_modification);
+    }
+    if (!vertex_shader || (description.pixel_shader_hash && !pixel_shader)) {
+      continue;
+    }
+    auto pipeline = std::make_unique<Pipeline>();
+    pipeline->description = description;
+    pipeline->vertex_shader = vertex_shader;
+    pipeline->pixel_shader = pixel_shader;
+    QueuePipelineCreation(*pipeline, false);
+    pipelines_.emplace(key_hash, std::move(pipeline));
+    ++queued;
+  }
+  REXGPU_INFO(
+      "Metal: {} shaders and {} pipelines in the shader storage, {} pipelines translated in {} ms "
+      "and queued for creation",
+      stored_shaders_.size(), descriptions.size(), queued, MicrosecondsSince(start) / 1000);
+}
+
+void MetalPipelineCache::ShutdownShaderStorage() {
+  if (pipeline_storage_file_) {
+    std::fclose(pipeline_storage_file_);
+    pipeline_storage_file_ = nullptr;
+  }
+  if (shader_storage_file_) {
+    std::fclose(shader_storage_file_);
+    shader_storage_file_ = nullptr;
+  }
+  stored_shaders_.clear();
+}
+
+void MetalPipelineCache::StorePipeline(const Pipeline& pipeline) {
+  if (!pipeline_storage_file_ || !shader_storage_file_) {
+    return;
+  }
+  // The shaders first, so a pipeline is never stored without them.
+  std::vector<uint32_t> ucode_guest_endian;
+  for (MetalShader::MetalTranslation* translation : {pipeline.vertex_shader, pipeline.pixel_shader}) {
+    if (!translation) {
+      continue;
+    }
+    const Shader& shader = translation->shader();
+    if (!stored_shaders_.insert(shader.ucode_data_hash()).second) {
+      continue;
+    }
+    ShaderStoredHeader shader_header;
+    std::memset(&shader_header, 0, sizeof(shader_header));
+    shader_header.ucode_data_hash = shader.ucode_data_hash();
+    shader_header.ucode_dword_count = uint32_t(shader.ucode_dword_count());
+    shader_header.type = shader.type();
+    std::fwrite(&shader_header, sizeof(shader_header), 1, shader_storage_file_);
+    if (shader_header.ucode_dword_count) {
+      // The hash is of the ucode in guest byte order.
+      ucode_guest_endian.resize(shader_header.ucode_dword_count);
+      memory::copy_and_swap(ucode_guest_endian.data(), shader.ucode_dwords(),
+                            shader_header.ucode_dword_count);
+      std::fwrite(ucode_guest_endian.data(), shader_header.ucode_dword_count * sizeof(uint32_t), 1,
+                  shader_storage_file_);
+    }
+    std::fflush(shader_storage_file_);
+  }
+  std::fwrite(&pipeline.description, sizeof(pipeline.description), 1, pipeline_storage_file_);
+  std::fflush(pipeline_storage_file_);
+}
+
+id<MTLRenderPipelineState> MetalPipelineCache::CreatePipeline(
+    const PipelineDescription& key, MetalShader::MetalTranslation* vertex_shader,
+    MetalShader::MetalTranslation* pixel_shader) {
+  id<MTLDevice> device = command_processor_.device();
+  MTLRenderPipelineDescriptor* descriptor = [MTLRenderPipelineDescriptor new];
+  descriptor.vertexFunction =
+      vertex_shader->GetOrCreateFunction(device, key.rasterization_disabled != 0);
+  if (!descriptor.vertexFunction) {
+    return nil;
+  }
+  if (key.pixel_shader_hash && pixel_shader) {
+    descriptor.fragmentFunction = pixel_shader->GetOrCreateFunction(device);
+    if (!descriptor.fragmentFunction) {
+      return nil;
+    }
+  }
+  descriptor.rasterizationEnabled = !key.rasterization_disabled;
+  descriptor.rasterSampleCount = std::max(key.sample_count, uint32_t(1));
+  descriptor.inputPrimitiveTopology = MTLPrimitiveTopologyClass(key.topology_class);
+  descriptor.alphaToCoverageEnabled = key.alpha_to_coverage != 0;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    MTLRenderPipelineColorAttachmentDescriptor* attachment = descriptor.colorAttachments[i];
+    attachment.pixelFormat = MTLPixelFormat(key.color_formats[i]);
+    if (attachment.pixelFormat == MTLPixelFormatInvalid) {
+      continue;
+    }
+    uint32_t blend = key.blend[i];
+    uint32_t write_mask = blend & 0b1111;
+    MTLColorWriteMask metal_write_mask = MTLColorWriteMaskNone;
+    if (write_mask & 0b0001) metal_write_mask |= MTLColorWriteMaskRed;
+    if (write_mask & 0b0010) metal_write_mask |= MTLColorWriteMaskGreen;
+    if (write_mask & 0b0100) metal_write_mask |= MTLColorWriteMaskBlue;
+    if (write_mask & 0b1000) metal_write_mask |= MTLColorWriteMaskAlpha;
+    attachment.writeMask = metal_write_mask;
+    if (!write_mask) {
+      continue;
+    }
+    auto color_src = xenos::BlendFactor((blend >> 4) & 0x1F);
+    auto color_dst = xenos::BlendFactor((blend >> 9) & 0x1F);
+    auto color_op = xenos::BlendOp((blend >> 14) & 0x7);
+    auto alpha_src = xenos::BlendFactor((blend >> 17) & 0x1F);
+    auto alpha_dst = xenos::BlendFactor((blend >> 22) & 0x1F);
+    auto alpha_op = xenos::BlendOp((blend >> 27) & 0x7);
+    bool blending = !(color_src == xenos::BlendFactor::kOne &&
+                      color_dst == xenos::BlendFactor::kZero &&
+                      color_op == xenos::BlendOp::kAdd &&
+                      alpha_src == xenos::BlendFactor::kOne &&
+                      alpha_dst == xenos::BlendFactor::kZero && alpha_op == xenos::BlendOp::kAdd);
+    attachment.blendingEnabled = blending;
+    if (blending) {
+      attachment.sourceRGBBlendFactor = GetBlendFactor(color_src);
+      attachment.destinationRGBBlendFactor = GetBlendFactor(color_dst);
+      attachment.rgbBlendOperation = GetBlendOperation(color_op);
+      attachment.sourceAlphaBlendFactor = GetBlendFactor(alpha_src);
+      attachment.destinationAlphaBlendFactor = GetBlendFactor(alpha_dst);
+      attachment.alphaBlendOperation = GetBlendOperation(alpha_op);
+    }
+  }
+  descriptor.depthAttachmentPixelFormat = MTLPixelFormat(key.depth_format);
+  descriptor.stencilAttachmentPixelFormat = MTLPixelFormat(key.stencil_format);
+
+  NSError* error = nil;
+  [[maybe_unused]] auto creation_start = std::chrono::steady_clock::now();
+  id<MTLRenderPipelineState> pipeline = [device newRenderPipelineStateWithDescriptor:descriptor
+                                                                               error:&error];
+  PERF_counter_inc(kPipelineCreations);
+  PERF_counter_add(kPipelineCreationUs, MicrosecondsSince(creation_start));
+  if (!pipeline) {
+    REXGPU_ERROR("Metal: failed to create a pipeline for vertex shader {:016X} pixel shader "
+                 "{:016X}: {}",
+                 vertex_shader->shader().ucode_data_hash(),
+                 pixel_shader ? pixel_shader->shader().ucode_data_hash() : 0,
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+  }
+  return pipeline;
+}
+
+id<MTLDepthStencilState> MetalPipelineCache::GetDepthStencilState(const DepthStencilKey& key) {
+  uint64_t key_hash = XXH3_64bits(&key, sizeof(key));
+  auto it = depth_stencil_states_.find(key_hash);
+  if (it != depth_stencil_states_.end()) {
+    return it->second;
+  }
+  MTLDepthStencilDescriptor* descriptor = [MTLDepthStencilDescriptor new];
+  descriptor.depthCompareFunction = GetCompareFunction(xenos::CompareFunction(key.depth_compare));
+  descriptor.depthWriteEnabled = key.depth_write != 0;
+  if (key.stencil_enable) {
+    auto make_face = [](uint32_t face, uint32_t read_mask, uint32_t write_mask) {
+      MTLStencilDescriptor* stencil = [MTLStencilDescriptor new];
+      stencil.stencilCompareFunction = GetCompareFunction(xenos::CompareFunction(face & 0x7));
+      stencil.stencilFailureOperation = GetStencilOperation(xenos::StencilOp((face >> 3) & 0x7));
+      stencil.depthFailureOperation = GetStencilOperation(xenos::StencilOp((face >> 6) & 0x7));
+      stencil.depthStencilPassOperation = GetStencilOperation(xenos::StencilOp((face >> 9) & 0x7));
+      stencil.readMask = read_mask;
+      stencil.writeMask = write_mask;
+      return stencil;
+    };
+    descriptor.frontFaceStencil = make_face(key.front, key.read_mask_front, key.write_mask_front);
+    descriptor.backFaceStencil = make_face(key.back, key.read_mask_back, key.write_mask_back);
+  }
+  id<MTLDepthStencilState> state =
+      [command_processor_.device() newDepthStencilStateWithDescriptor:descriptor];
+  depth_stencil_states_.emplace(key_hash, state);
+  return state;
+}
