+  return blit_encoder_;
+}
+
+id<MTLRenderCommandEncoder> MetalCommandProcessor::BeginRenderPass(
+    const MetalRenderPass& render_pass, rex::perf::CounterId end_reason) {
+  BeginSubmission(false);
+  if (encoder_type_ == EncoderType::kRender && current_render_pass_ == render_pass) {
+    return render_encoder_;
+  }
+  EndEncoder(end_reason);
+
+  MTLRenderPassDescriptor* descriptor = [MTLRenderPassDescriptor renderPassDescriptor];
+  bool has_attachments = false;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!render_pass.color[i]) {
+      continue;
+    }
+    MTLRenderPassColorAttachmentDescriptor* attachment = descriptor.colorAttachments[i];
+    attachment.texture = render_pass.color[i];
+    attachment.loadAction = MTLLoadActionLoad;
+    attachment.storeAction = MTLStoreActionStore;
+    has_attachments = true;
+  }
+  if (render_pass.depth_stencil) {
+    descriptor.depthAttachment.texture = render_pass.depth_stencil;
+    descriptor.depthAttachment.loadAction = MTLLoadActionLoad;
+    descriptor.depthAttachment.storeAction = MTLStoreActionStore;
+    descriptor.stencilAttachment.texture = render_pass.depth_stencil;
+    descriptor.stencilAttachment.loadAction = MTLLoadActionLoad;
+    descriptor.stencilAttachment.storeAction = MTLStoreActionStore;
+    has_attachments = true;
+  }
+  // Pending guest clears of these attachments become their load actions.
+  for (auto it = pending_clears_.begin(); it != pending_clears_.end();) {
+    bool applied = false;
+    if (it->is_depth) {
+      if (render_pass.depth_stencil == it->texture) {
+        descriptor.depthAttachment.loadAction = MTLLoadActionClear;
+        descriptor.depthAttachment.clearDepth = it->depth;
+        descriptor.stencilAttachment.loadAction = MTLLoadActionClear;
+        descriptor.stencilAttachment.clearStencil = it->stencil;
+        applied = true;
+      }
+    } else {
+      for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+        if (render_pass.color[i] == it->texture) {
+          descriptor.colorAttachments[i].loadAction = MTLLoadActionClear;
+          descriptor.colorAttachments[i].clearColor = it->color;
+          applied = true;
+        }
+      }
+    }
+    it = applied ? pending_clears_.erase(it) : it + 1;
+  }
+  descriptor.renderTargetWidth = render_pass.width;
+  descriptor.renderTargetHeight = render_pass.height;
+  // Each pass counts into a slot of its own, written at the end of the pass (the default,
+  // MTLVisibilityResultTypeReset); a query sums the slots of the passes it spans.
+  if (occlusion_buffer_) {
+    descriptor.visibilityResultBuffer = occlusion_buffer_;
+  }
+  if (!has_attachments) {
+    descriptor.defaultRasterSampleCount = 1;
+  }
+  render_encoder_ = [command_buffer_ renderCommandEncoderWithDescriptor:descriptor];
+  encoder_type_ = EncoderType::kRender;
+  submission_has_work_ = true;
+  current_render_pass_ = render_pass;
+  render_encoder_state_ = RenderEncoderState();
+  PERF_counter_inc(kHostRenderPasses);
+  if (has_attachments && render_pass == render_pass_ended_by_resolve_) {
+    PERF_counter_inc(kRenderPassesResumedAfterResolve);
+    if (render_pass_ended_by_native_resolve_) {
+      PERF_counter_inc(kRenderPassesResumedAfterNativeResolve);
+    }
+  }
+  render_pass_ended_by_resolve_ = MetalRenderPass();
+  return render_encoder_;
+}
+
+id<MTLRenderCommandEncoder> MetalCommandProcessor::BeginExternalRenderPass(
+    const MetalRenderPass& render_pass, rex::perf::CounterId end_reason) {
+  // The backend's own passes (transfers) may sample the render targets: pending clears go first.
+  ApplyPendingClears(end_reason);
+  id<MTLRenderCommandEncoder> encoder = BeginRenderPass(render_pass, end_reason);
+  if (encoder.label == nil) {
+    encoder.label = GetEncoderLabel(end_reason);
+  }
+  // The backend's own draws are not counted in occlusion queries.
+  StopCountingOcclusionSamples();
+  // The backend's own draws change the state that the guest draws track.
+  render_encoder_state_.valid = false;
+  return encoder;
+}
+
+id<MTLRenderCommandEncoder> MetalCommandProcessor::GetOpenRenderEncoderWithColor(
+    id<MTLTexture> texture, uint32_t& index_out) {
+  if (encoder_type_ != EncoderType::kRender || !texture) {
+    return nil;
+  }
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (current_render_pass_.color[i] == texture) {
+      index_out = i;
+      render_encoder_state_.valid = false;
+      return render_encoder_;
+    }
+  }
+  return nil;
+}
