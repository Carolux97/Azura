+void resolve_texture_write(uint2 pixel, uint4 memory_dwords, texture2d<uint, access::write> texture,
+                           constant ResolveFromRenderTargetConstants& constants) {
+  uint4 texel = uint4(resolve_swap_endian(memory_dwords.x, constants.texture_endian),
+                      resolve_swap_endian(memory_dwords.y, constants.texture_endian),
+                      resolve_swap_endian(memory_dwords.z, constants.texture_endian),
+                      resolve_swap_endian(memory_dwords.w, constants.texture_endian));
