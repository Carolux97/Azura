@@ -0,0 +1,56 @@
+/**
+ * @file        graphics/metal/metal_provider.mm
+ * @brief       Metal graphics provider
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_provider.h"
+
+#include <cstdlib>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include "metal_immediate_drawer.h"
+#include "metal_presenter.h"
+
+REXCVAR_DECLARE(int32_t, metal_gpu_capture_frames);
+
+namespace rex::graphics::metal {
+
+std::unique_ptr<MetalProvider> MetalProvider::Create() {
+  // GPU captures to a document outside Xcode need this before the device is created.
+  if (REXCVAR_GET(metal_gpu_capture_frames) > 0) {
+    setenv("MTL_CAPTURE_ENABLED", "1", 1);
+  }
+  auto provider = std::unique_ptr<MetalProvider>(new MetalProvider());
+  provider->device_ = MTLCreateSystemDefaultDevice();
+  if (!provider->device_) {
+    REXLOG_ERROR("Metal: no Metal device available");
+    return nullptr;
+  }
+  provider->queue_ = [provider->device_ newCommandQueue];
+  if (!provider->queue_) {
+    REXLOG_ERROR("Metal: failed to create the command queue");
+    return nullptr;
+  }
+  provider->queue_.label = @"Azura GPU";
+  REXLOG_INFO("Metal: using {} (unified memory: {})", provider->device_.name.UTF8String,
+              provider->device_.hasUnifiedMemory ? "yes" : "no");
+  return provider;
+}
+
+MetalProvider::~MetalProvider() = default;
+
+std::unique_ptr<ui::Presenter> MetalProvider::CreatePresenter(
+    ui::Presenter::HostGpuLossCallback host_gpu_loss_callback) {
+  return MetalPresenter::Create(host_gpu_loss_callback, device_, queue_);
+}
+
+std::unique_ptr<ui::ImmediateDrawer> MetalProvider::CreateImmediateDrawer() {
+  return MetalImmediateDrawer::Create(device_);
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_render_target_cache.h b/src/graphics/metal/metal_render_target_cache.h
new file mode 100644
index 0000000..cbb3964
--- /dev/null
+++ b/src/graphics/metal/metal_render_target_cache.h
@@ -0,0 +1,677 @@
+/**
+ * @file        graphics/metal/metal_render_target_cache.h
+ * @brief       EDRAM emulation with sample-space host render targets for the Metal backend
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/flags.h>
+#include <rex/graphics/pipeline/render_target/cache.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/graphics/xenos.h>
+
+#import <Metal/Metal.h>
+
+#include "metal_pipeline_cache.h"
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+class MetalSharedMemory;
+class MetalTextureCache;
+
+// The attachments of a render pass. Render passes managed by the render target cache may be
+// ended and resumed (with their contents loaded) at any time.
+struct MetalRenderPass {
+  std::array<id<MTLTexture>, xenos::kMaxColorRenderTargets> color = {};
+  id<MTLTexture> depth_stencil = nil;
+  uint32_t width = 0;
+  uint32_t height = 0;
+
+  bool operator==(const MetalRenderPass& other) const {
+    return color == other.color && depth_stencil == other.depth_stencil &&
+           width == other.width && height == other.height;
+  }
+  bool operator!=(const MetalRenderPass& other) const { return !(*this == other); }
+};
+
+// Host render targets in EDRAM sample space only (one texel per EDRAM sample, IsSampleSpace), so
+// every host render target is single-sampled and switching an EDRAM region between MSAA modes
+// needs no transfer. The rest follows the host render target path of the Vulkan backend, using
+// the same SPIR-V for ownership transfers, host depth storing, dumping and resolving, converted to
+// MSL: transfers for format and pitch changes, dumps of render targets into the EDRAM buffer for
+// resolves, and clears in resolves.
+//
+// Apple GPUs have no 24-bit depth format, so both guest depth formats are 32-bit float depth on
+// the host, and the host depth is kept alongside the guest bits as in the Vulkan backend on such
+// devices (IsHostDepthEncodingDifferent).
+class MetalRenderTargetCache final : public RenderTargetCache {
+ public:
+  MetalRenderTargetCache(const RegisterFile& register_file, const memory::Memory& memory,
+                         DrawResolutionScale draw_resolution_scale,
+                         MetalCommandProcessor& command_processor);
+  ~MetalRenderTargetCache();
+
+  bool Initialize();
+  void Shutdown(bool from_destructor = false);
+  void ClearCache() override;
+
+  Path GetPath() const override { return Path::kHostRenderTargets; }
+  bool IsSampleSpaceRequired() const override { return true; }
+
+  id<MTLBuffer> edram_buffer() const { return edram_buffer_; }
+
+  // Render to texture results at most this many guest pixels wide or tall are data the game
+  // computes (lookup tables, luminance), not images of the scene: rendering them at a draw
+  // resolution scale would only sample them at other positions, and textures made from them would
+  // be filtered differently. So at a scale, their draws are evaluated at the guest pixel centers
+  // (SpirvShaderTranslator::Modification::pixel.guest_pixel_center) and their resolves are reduced
+  // to the guest resolution in the guest memory, holding what the console computes.
+  static constexpr uint32_t kDataTargetMaxSize = 32;
+  // Whether the current draw computes data (see kDataTargetMaxSize): its viewport is at most
+  // kDataTargetMaxSize guest pixels wide or tall while drawing at a resolution scale.
+  bool IsCurrentDrawData() const;
+
+  // How a resolve at a rational draw resolution scale is written (ResolveFromRenderTarget).
+  enum class RationalResolveMode { kNone, kGuestResolution, kScaledSurface };
+  // gfx = hle: after a resolve written from the render targets (owners, the native path), the
+  // textures the texture cache holds for exactly its destination are written from them too, as a
+  // load from the memory the resolve wrote would (MetalTextureCache::WriteTexturesFromResolve), so
+  // they are not loaded back. rational_mode gives the constants at a rational scale
+  // (kScaledSurface: host pixels); scaled says the textures are at the draw resolution scale.
+  // Only for a resolve to the start of its destination. Returns the textures written.
+  uint32_t UpdateResolvedTextures(const draw_util::ResolveInfo& resolve_info,
+                                  const std::vector<RangeOwner>& owners,
+                                  MetalTextureCache& texture_cache,
+                                  RationalResolveMode rational_mode, bool scaled);
+
+  bool Resolve(const memory::Memory& memory, MetalSharedMemory& shared_memory,
+               MetalTextureCache& texture_cache, uint32_t& written_address_out,
+               uint32_t& written_length_out);
+
+  bool Update(bool is_rasterization_done, reg::RB_DEPTHCONTROL normalized_depth_control,
+              uint32_t normalized_color_mask, const Shader& vertex_shader) override;
+  // The render pass and its formats for the last successful update.
+  const MetalRenderPass& last_update_render_pass() const { return last_update_render_pass_; }
+  const MetalRenderPassFormats& last_update_render_pass_formats() const {
+    return last_update_render_pass_formats_;
+  }
+
+  // Using RG16Snorm and RGBA16Snorm, which are -1...1, not the needed -32...32.
+  bool IsFixedRG16TruncatedToMinus1To1() const {
+    return !REXCVAR_GET(snorm16_render_target_full_range);
+  }
+  bool IsFixedRGBA16TruncatedToMinus1To1() const {
+    return !REXCVAR_GET(snorm16_render_target_full_range);
+  }
+  bool gamma_render_target_as_unorm16() const { return gamma_render_target_as_unorm16_; }
+  // Whether the drawing format of a 16-bit-per-component format is floating-point (only the
+  // _FLOAT formats here: the fixed-point ones are always SNORM).
+  bool IsColor16FormatFloatLike(xenos::ColorRenderTargetFormat format) const {
+    return format == xenos::ColorRenderTargetFormat::k_16_16_FLOAT ||
+           format == xenos::ColorRenderTargetFormat::k_16_16_16_16_FLOAT;
+  }
+
+  bool depth_float24_round() const { return depth_float24_round_; }
+  bool depth_float24_convert_in_pixel_shader() const {
+    return depth_float24_convert_in_pixel_shader_;
+  }
+
+  // The texture of the render target the last successful update's draw uses (0 depth, 1 + i
+  // color i), or nil.
+  id<MTLTexture> GetLastUpdateUsedTexture(uint32_t index) const;
+
+  MTLPixelFormat GetDepthMetalFormat(xenos::DepthRenderTargetFormat format) const;
+  MTLPixelFormat GetColorMetalFormat(xenos::ColorRenderTargetFormat format) const;
+  // The format of the views ownership transfers and clears use: integer for formats where
+  // floating-point or signed normalized values could be changed by conversion (NaNs, -1).
+  MTLPixelFormat GetColorOwnershipTransferMetalFormat(
+      xenos::ColorRenderTargetFormat format,
+      xenos::MsaaSamples msaa_samples = xenos::MsaaSamples::k1X,
+      bool* is_integer_out = nullptr) const;
+
+ protected:
+  uint32_t GetMaxRenderTargetWidth() const override;
+  uint32_t GetMaxRenderTargetHeight() const override;
+
+  RenderTarget* CreateRenderTarget(RenderTargetKey key) override;
+
+  bool IsHostDepthEncodingDifferent(xenos::DepthRenderTargetFormat format) const override;
+
+  bool IsGammaFormatHostStorageSeparate() const override;
+
+ private:
+  class MetalRenderTarget final : public RenderTarget {
+   public:
+    MetalRenderTarget(RenderTargetKey key, id<MTLTexture> texture, id<MTLTexture> transfer_view,
+                      id<MTLTexture> stencil_view)
+        : RenderTarget(key),
+          texture_(texture),
+          transfer_view_(transfer_view),
+          stencil_view_(stencil_view) {}
+
+    // In the drawing format: the attachment of guest draws, and the depth / color source of
+    // transfers and dumps for formats without a separate transfer format.
+    id<MTLTexture> texture() const { return texture_; }
+    // In the ownership transfer format: the attachment of color transfers and clears, and the
+    // color source of transfers and dumps.
+    id<MTLTexture> transfer_view() const { return transfer_view_; }
+    // Depth only: the stencil aspect as an integer texture.
+    id<MTLTexture> stencil_view() const { return stencil_view_; }
+
+    uint32_t temporary_sort_index() const { return temporary_sort_index_; }
+    void SetTemporarySortIndex(uint32_t index) { temporary_sort_index_ = index; }
+
+   private:
+    id<MTLTexture> texture_;
+    id<MTLTexture> transfer_view_;
+    id<MTLTexture> stencil_view_;
+    // Temporary storage for indices in operations like transfers and dumps.
+    uint32_t temporary_sort_index_ = 0;
+  };
+
+  enum TransferUsedDescriptorSet : uint32_t {
+    // Ordered from the least to the most frequently changed.
+    kTransferUsedDescriptorSetHostDepthBuffer,
+    kTransferUsedDescriptorSetHostDepthStencilTextures,
+    kTransferUsedDescriptorSetDepthStencilTextures,
+    // Mutually exclusive with kTransferUsedDescriptorSetDepthStencilTextures.
+    kTransferUsedDescriptorSetColorTexture,
+
+    kTransferUsedDescriptorSetCount,
+
+    kTransferUsedDescriptorSetHostDepthBufferBit = uint32_t(1)
+                                                   << kTransferUsedDescriptorSetHostDepthBuffer,
+    kTransferUsedDescriptorSetHostDepthStencilTexturesBit =
+        uint32_t(1) << kTransferUsedDescriptorSetHostDepthStencilTextures,
+    kTransferUsedDescriptorSetDepthStencilTexturesBit =
+        uint32_t(1) << kTransferUsedDescriptorSetDepthStencilTextures,
+    kTransferUsedDescriptorSetColorTextureBit = uint32_t(1)
+                                                << kTransferUsedDescriptorSetColorTexture,
+  };
+
+  // 32-bit push constants (for simplicity of size calculation and to avoid
+  // std140 packing issues).
+  enum TransferUsedPushConstantDword : uint32_t {
+    kTransferUsedPushConstantDwordHostDepthAddress,
+    kTransferUsedPushConstantDwordAddress,
+    // Changed 8 times per transfer.
+    kTransferUsedPushConstantDwordStencilMask,
+
+    kTransferUsedPushConstantDwordCount,
+
+    kTransferUsedPushConstantDwordHostDepthAddressBit =
+        uint32_t(1) << kTransferUsedPushConstantDwordHostDepthAddress,
+    kTransferUsedPushConstantDwordAddressBit = uint32_t(1) << kTransferUsedPushConstantDwordAddress,
+    kTransferUsedPushConstantDwordStencilMaskBit = uint32_t(1)
+                                                   << kTransferUsedPushConstantDwordStencilMask,
+  };
+
+  enum class TransferPipelineLayoutIndex {
+    kColor,
+    kDepth,
+    kColorToStencilBit,
+    kDepthToStencilBit,
+    kColorAndHostDepthTexture,
+    kColorAndHostDepthBuffer,
+    kDepthAndHostDepthTexture,
+    kDepthAndHostDepthBuffer,
+
+    kCount,
+  };
+
+  struct TransferPipelineLayoutInfo {
+    uint32_t used_descriptor_sets;
+    uint32_t used_push_constant_dwords;
+  };
+
+  static const TransferPipelineLayoutInfo
+      kTransferPipelineLayoutInfos[size_t(TransferPipelineLayoutIndex::kCount)];
+
+  enum class TransferMode : uint32_t {
+    kColorToDepth,
+    kColorToColor,
+
+    kDepthToDepth,
+    kDepthToColor,
+
+    kColorToStencilBit,
+    kDepthToStencilBit,
+
+    // Two-source modes, using the host depth if it, when converted to the guest
+    // format, matches what's in the owner source (not modified, keep host
+    // precision), or the guest data otherwise (significantly modified, possibly
+    // cleared). Stencil for FragStencilRef is always taken from the guest
+    // source.
+
+    kColorAndHostDepthToDepth,
+    // When using different source and destination depth formats.
+    kDepthAndHostDepthToDepth,
+
+    // If host depth is fetched, but it's the same image as the destination,
+    // it's copied to the EDRAM buffer (but since it's just a scratch buffer,
+    // with tiles laid out linearly with the same pitch as in the original
+    // render target; also no swapping of 40-sample columns as opposed to the
+    // host render target - this is done only for the color source) and fetched
+    // from there instead of the host depth texture.
+    kColorAndHostDepthCopyToDepth,
+    kDepthAndHostDepthCopyToDepth,
+
+    kCount,
+  };
+
+  enum class TransferOutput {
+    kColor,
+    kDepth,
+    kStencilBit,
+  };
+
+  struct TransferModeInfo {
+    TransferOutput output;
+    TransferPipelineLayoutIndex pipeline_layout;
+  };
+
+  static const TransferModeInfo kTransferModes[size_t(TransferMode::kCount)];
+
+  union TransferShaderKey {
+    uint32_t key;
+    struct {
+      xenos::MsaaSamples dest_msaa_samples : xenos::kMsaaSamplesBits;
+      uint32_t dest_color_rt_index : xenos::kColorRenderTargetIndexBits;
+      uint32_t dest_resource_format : xenos::kRenderTargetFormatBits;
+      xenos::MsaaSamples source_msaa_samples : xenos::kMsaaSamplesBits;
+      // Always 1x when the host depth is a copy from a buffer rather than an
+      // image, not to create the same pipeline for different MSAA sample counts
+      // as it doesn't matter in this case.
+      xenos::MsaaSamples host_depth_source_msaa_samples : xenos::kMsaaSamplesBits;
+      uint32_t source_resource_format : xenos::kRenderTargetFormatBits;
+
+      // Last bits because this affects the pipeline layout - after sorting,
+      // only change it as fewer times as possible. Depth buffers have an
+      // additional stencil texture.
+      static_assert(size_t(TransferMode::kCount) <= (size_t(1) << 4));
+      TransferMode mode : 4;
+    };
+
+    TransferShaderKey() : key(0) { static_assert_size(*this, sizeof(key)); }
+
+    struct Hasher {
+      size_t operator()(const TransferShaderKey& key) const {
+        return std::hash<uint32_t>{}(key.key);
+      }
+    };
+    bool operator==(const TransferShaderKey& other_key) const { return key == other_key.key; }
+    bool operator!=(const TransferShaderKey& other_key) const { return !(*this == other_key); }
+    bool operator<(const TransferShaderKey& other_key) const { return key < other_key.key; }
+  };
+
+  union TransferAddressConstant {
+    uint32_t constant;
+    struct {
+      // All in tiles.
+      uint32_t dest_pitch : xenos::kEdramPitchTilesBits;
+      uint32_t source_pitch : xenos::kEdramPitchTilesBits;
+      // Destination base in tiles minus source base in tiles (not vice versa
+      // because this is a transform of the coordinate system, not addresses
+      // themselves).
+      // + 1 bit because this is a signed difference between two EDRAM bases.
+      // 0 for host_depth_source_is_copy (ignored in this case anyway as
+      // destination == source anyway).
+      int32_t source_to_dest : xenos::kEdramBaseTilesBits + 1;
+    };
+    TransferAddressConstant() : constant(0) { static_assert_size(*this, sizeof(constant)); }
+    bool operator==(const TransferAddressConstant& other_constant) const {
+      return constant == other_constant.constant;
+    }
+    bool operator!=(const TransferAddressConstant& other_constant) const {
+      return !(*this == other_constant);
+    }
+  };
+
+  struct TransferInvocation {
+    Transfer transfer;
+    TransferShaderKey shader_key;
+    TransferInvocation(const Transfer& transfer, const TransferShaderKey& shader_key)
+        : transfer(transfer), shader_key(shader_key) {}
+    bool operator<(const TransferInvocation& other_invocation) const {
+      // TODO(Triang3l): See if it may be better to sort by the source in the
+      // first place, especially when reading the same data multiple times (like
+      // to write the stencil bits after depth) for better read locality.
+      // Sort by the shader key primarily to reduce pipeline state (context)
+      // switches.
+      if (shader_key != other_invocation.shader_key) {
+        return shader_key < other_invocation.shader_key;
+      }
+      // Host depth render targets are changed rarely if they exist, won't save
+      // many binding changes, ignore them for simplicity (their existence is
+      // caught by the shader key change).
+      assert_not_null(transfer.source);
+      assert_not_null(other_invocation.transfer.source);
+      uint32_t source_index =
+          static_cast<const MetalRenderTarget*>(transfer.source)->temporary_sort_index();
+      uint32_t other_source_index =
+          static_cast<const MetalRenderTarget*>(other_invocation.transfer.source)
+              ->temporary_sort_index();
+      if (source_index != other_source_index) {
+        return source_index < other_source_index;
+      }
+      return transfer.start_tiles < other_invocation.transfer.start_tiles;
+    }
+    bool CanBeMergedIntoOneDraw(const TransferInvocation& other_invocation) const {
+      return shader_key == other_invocation.shader_key &&
+             transfer.AreSourcesSame(other_invocation.transfer);
+    }
+  };
+
+  union DumpPipelineKey {
+    uint32_t key;
+    struct {
+      xenos::MsaaSamples msaa_samples : 2;
+      uint32_t resource_format : 4;
+      // At a rational draw resolution scale: dumping to edram_buffer_guest_ at the guest
+      // resolution, each guest sample read from the host pixel at its centre.
+      uint32_t guest_resolution : 1;
+      // Last bit because this affects the pipeline - after sorting, only change
+      // it at most once. Depth buffers have an additional stencil SRV.
+      uint32_t is_depth : 1;
+    };
+
+    DumpPipelineKey() : key(0) { static_assert_size(*this, sizeof(key)); }
+
+    struct Hasher {
+      size_t operator()(const DumpPipelineKey& key) const { return std::hash<uint32_t>{}(key.key); }
+    };
+    bool operator==(const DumpPipelineKey& other_key) const { return key == other_key.key; }
+    bool operator!=(const DumpPipelineKey& other_key) const { return !(*this == other_key); }
+    bool operator<(const DumpPipelineKey& other_key) const { return key < other_key.key; }
+
+    xenos::ColorRenderTargetFormat GetColorFormat() const {
+      assert_false(is_depth);
+      return xenos::ColorRenderTargetFormat(resource_format);
+    }
+    xenos::DepthRenderTargetFormat GetDepthFormat() const {
+      assert_true(is_depth);
+      return xenos::DepthRenderTargetFormat(resource_format);
+    }
+  };
+
+  // There's no strict dependency on the group size in dumping. The only restriction is that an
+  // integer multiple of it must be 80x16 samples (and no larger than that) for 32bpp, or 40x16
+  // samples for 64bpp (because only a half of the pair of tiles may need to be dumped). 8x16, as
+  // in the Vulkan backend.
+  static constexpr uint32_t kDumpSamplesPerGroupX = 8;
+  static constexpr uint32_t kDumpSamplesPerGroupY = 16;
+
+  union DumpPitches {
+    uint32_t pitches;
+    struct {
+      // Both in tiles.
+      uint32_t dest_pitch : xenos::kEdramPitchTilesBits;
+      uint32_t source_pitch : xenos::kEdramPitchTilesBits;
+    };
+    DumpPitches() : pitches(0) { static_assert_size(*this, sizeof(pitches)); }
+    bool operator==(const DumpPitches& other_pitches) const {
+      return pitches == other_pitches.pitches;
+    }
+    bool operator!=(const DumpPitches& other_pitches) const { return !(*this == other_pitches); }
+  };
+
+  union DumpOffsets {
+    uint32_t offsets;
+    struct {
+      // May be beyond the EDRAM tile count in case of EDRAM addressing
+      // wrapping, thus + 1 bit.
+      uint32_t dispatch_first_tile : xenos::kEdramBaseTilesBits + 1;
+      uint32_t source_base_tiles : xenos::kEdramBaseTilesBits;
+    };
+    DumpOffsets() : offsets(0) { static_assert_size(*this, sizeof(offsets)); }
+    bool operator==(const DumpOffsets& other_offsets) const {
+      return offsets == other_offsets.offsets;
+    }
+    bool operator!=(const DumpOffsets& other_offsets) const { return !(*this == other_offsets); }
+  };
+
+  enum DumpDescriptorSet : uint32_t {
+    // Never changes. Same in both color and depth pipeline layouts, keep the
+    // first for pipeline layout compatibility, to only have to set it once.
+    kDumpDescriptorSetEdram,
+    // One resolve may need multiple sources. Different descriptor set layouts
+    // for color and depth.
+    kDumpDescriptorSetSource,
+
+    kDumpDescriptorSetCount,
+  };
+
+  enum DumpPushConstant : uint32_t {
+    // May be different for different sources.
+    kDumpPushConstantPitches,
+    // May be changed multiple times for the same source.
+    kDumpPushConstantOffsets,
+
+    kDumpPushConstantCount,
+  };
+
+  struct DumpInvocation {
+    ResolveCopyDumpRectangle rectangle;
+    DumpPipelineKey pipeline_key;
+    DumpInvocation(const ResolveCopyDumpRectangle& rectangle, const DumpPipelineKey& pipeline_key)
+        : rectangle(rectangle), pipeline_key(pipeline_key) {}
+    bool operator<(const DumpInvocation& other_invocation) const {
+      // Sort by the pipeline key primarily to reduce pipeline state (context)
+      // switches.
+      if (pipeline_key != other_invocation.pipeline_key) {
+        return pipeline_key < other_invocation.pipeline_key;
+      }
+      assert_not_null(rectangle.render_target);
+      uint32_t render_target_index =
+          static_cast<const MetalRenderTarget*>(rectangle.render_target)->temporary_sort_index();
+      const ResolveCopyDumpRectangle& other_rectangle = other_invocation.rectangle;
+      uint32_t other_render_target_index =
+          static_cast<const MetalRenderTarget*>(other_rectangle.render_target)
+              ->temporary_sort_index();
+      if (render_target_index != other_render_target_index) {
+        return render_target_index < other_render_target_index;
+      }
+      if (rectangle.row_first != other_rectangle.row_first) {
+        return rectangle.row_first < other_rectangle.row_first;
+      }
+      return rectangle.row_first_start < other_rectangle.row_first_start;
+    }
+  };
+
+  // Argument table indices of the transfer fragment shaders.
+  static constexpr uint32_t kTransferTextureSource = 0;
+  static constexpr uint32_t kTransferTextureSourceStencil = 1;
+  static constexpr uint32_t kTransferTextureHostDepth = 2;
+  static constexpr uint32_t kTransferBufferHostDepth = 0;
+  static constexpr uint32_t kTransferBufferConstants = 1;
+  // Argument table indices of the dump, host depth store and resolve compute shaders.
+  static constexpr uint32_t kComputeBufferEdram = 0;
+  static constexpr uint32_t kComputeBufferDest = 1;
+  static constexpr uint32_t kComputeBufferConstants = 2;
+  // The mismatch counts of the resolves written from render targets, when verifying them.
+  static constexpr uint32_t kComputeBufferVerifyResult = 3;
+  // The scratch copy resolve_compare compares the memory with.
+  static constexpr uint32_t kComputeBufferVerifyScratch = 4;
+  static constexpr uint32_t kComputeTextureSource = 0;
+  static constexpr uint32_t kComputeTextureSourceStencil = 1;
+  // The texture a resolve writes instead of the memory (resolve_to_texture).
+  static constexpr uint32_t kComputeTextureDest = 2;
+
+  struct ComputePipeline {
+    id<MTLComputePipelineState> pipeline = nil;
+    MTLSize threads_per_threadgroup = {1, 1, 1};
+  };
+
+  // The render pass with a single attachment of a transfer or resolve clear destination.
+  MetalRenderPass GetTransferRenderPass(const MetalRenderTarget& dest_rt) const;
+
+  // The fragment function of an ownership transfer, from the SPIR-V the Vulkan backend generates.
+  id<MTLFunction> GetTransferShader(TransferShaderKey key);
+  // nil if failed to create.
+  id<MTLRenderPipelineState> GetTransferPipeline(TransferShaderKey key);
+
+  // Do ownership transfers for render targets - each render target / vector may be null / empty in
+  // case there's nothing to do for them. resolve_clear_rectangle is expected to be provided by
+  // PrepareHostRenderTargetsResolveClear which should do all the needed size bound checks.
+  void PerformTransfersAndResolveClears(
+      uint32_t render_target_count, RenderTarget* const* render_targets,
+      const std::vector<Transfer>* render_target_transfers,
+      const uint64_t* render_target_resolve_clear_values = nullptr,
+      const Transfer::Rectangle* resolve_clear_rectangle = nullptr);
+  // Clears a rectangle of the current transfer render pass of the destination render target.
+  void ClearRectangle(const MetalRenderTarget& dest_rt, uint64_t clear_value,
+                      const Transfer::Rectangle& rectangle);
+
+  const ComputePipeline* GetDumpPipeline(DumpPipelineKey key);
+
+  // Writes contents of host render targets within rectangles from
+  // ResolveInfo::GetCopyEdramTileSpan to edram_buffer_, or with guest_resolution (at a rational
+  // draw resolution scale) to edram_buffer_guest_.
+  bool DumpRenderTargets(uint32_t dump_base, uint32_t dump_row_length_used, uint32_t dump_rows,
+                         uint32_t dump_pitch, bool guest_resolution = false);
+
+  MetalCommandProcessor& command_processor_;
+
+  bool gamma_render_target_as_unorm16_ = false;
+  bool depth_float24_round_ = false;
+  bool depth_float24_convert_in_pixel_shader_ = false;
+  // Kept for the shared transfer and dump shader generators: all host render targets here are
+  // single-sampled.
+  bool msaa_2x_attachments_supported_ = false;
+
+  id<MTLBuffer> edram_buffer_ = nil;
+  // At a rational draw resolution scale, where the copy shaders have no scaled variant: the EDRAM
+  // at the guest resolution, for the resolves the native path does not handle, dumped there and
+  // copied by the unscaled shaders to the guest memory.
+  id<MTLBuffer> edram_buffer_guest_ = nil;
+
+  std::array<ComputePipeline, size_t(draw_util::ResolveCopyShaderIndex::kCount)>
+      resolve_copy_pipelines_{};
+  // 1x only, as host render targets are single-sampled.
+  ComputePipeline host_depth_store_pipeline_;
+  // At a draw resolution scale, reduces resolves of data (kDataTargetMaxSize) from the scaled
+  // resolve buffer to the guest memory.
+  ComputePipeline resolve_reduce_pipeline_;
+  // gfx = hle: resolves written to memory straight from a render target (32 bits per pixel), read
+  // through a floating-point view (8_8_8_8) or an integer one (16_16_FLOAT, 32_FLOAT).
+  ComputePipeline resolve_from_render_target_float_pipeline_;
+  ComputePipeline resolve_from_render_target_uint_pipeline_;
+  // 16_16_16_16 and 16_16_16_16_FLOAT, with the conversions of the full 64bpp resolve copy.
+  ComputePipeline resolve_from_render_target_64bpp_pipeline_;
+  // hle_verify_resolves with hle_resolve_in_render_pass: compares the in-pass scratch copy.
+  ComputePipeline resolve_compare_pipeline_;
+  // Depth targets (D24S8 and D24FS8), for depth resolves and bitwise color resolves of their EDRAM.
+  ComputePipeline resolve_from_render_target_depth_pipeline_;
+  // The same four writing a texture of the texture cache instead (resolve_to_texture,
+  // UpdateResolvedTextures).
+  ComputePipeline resolve_to_texture_float_pipeline_;
+  ComputePipeline resolve_to_texture_uint_pipeline_;
+  ComputePipeline resolve_to_texture_64bpp_pipeline_;
+  ComputePipeline resolve_to_texture_depth_pipeline_;
+  // Tile pipelines of ResolveInRenderPass, by packing, color index and the pass's color formats
+  // (nil when one failed to build).
+  std::unordered_map<uint64_t, id<MTLRenderPipelineState>> resolve_in_render_pass_pipelines_;
+
+  // gfx = hle: the render target that alone holds the whole source of a 1x resolve of
+  // sample 0 the native path handles, at the resolve's base, pitch and format; nullptr otherwise.
+  // Handled: the bitwise copies (the fast 32bpp copy) of 8_8_8_8 (with or without a red and blue
+  // swap), 2_10_10_10, 16_16_FLOAT and 32_FLOAT to the same format, from a render target of any of
+  // those formats, 2_10_10_10_FLOAT or a depth format (the EDRAM bits it holds), depth copies of a
+  // depth target, and the conversions (the full
+  // 64bpp copy) of 16_16_16_16 and 16_16_16_16_FLOAT to 16_16_16_16 or 16_16_16_16_FLOAT, with any
+  // exponent bias and swap; endianness at most 16 in 32, no array destination.
+  MetalRenderTarget* GetNativeResolveSource(const draw_util::ResolveInfo& resolve_info,
+                                            draw_util::ResolveCopyShaderIndex copy_shader) const;
+  // The render targets owning the source of a resolve the native path handles (the formats of
+  // GetNativeResolveSource), each with the EDRAM tiles of the source it owns; false (and none)
+  // otherwise. Owners may have other bases and pitches than the resolve.
+  bool GetNativeResolveOwners(const draw_util::ResolveInfo& resolve_info,
+                              draw_util::ResolveCopyShaderIndex copy_shader,
+                              std::vector<RangeOwner>& owners_out) const;
+  // Writes the pixels of a resolve's destination whose EDRAM tiles one native owner holds (see
+  // GetNativeResolveOwners) straight from it, as the resolve copy would from the EDRAM dump: to dest bound at dest_offset, with dest_base the
+  // destination's address in it (the shared memory, or at a draw resolution scale the scaled
+  // resolve buffer bound at the destination's scaled base, with dest_base 0). With
+  // verify, nothing is written: the values already in the memory (written by the usual path) are
+  // compared with the ones the native path computes, and a mismatch is logged.
+  // At a rational draw resolution scale (rational_mode), the destination is either the guest
+  // memory at the guest resolution (each guest pixel reads the host pixel at its centre) or a
+  // scaled surface of the texture cache (MetalTextureCache::RequestRationalScaledSurface, bound at
+  // its start with dest_base 0, surface_pitch texels per row) at the host resolution.
+  void ResolveFromRenderTarget(const draw_util::ResolveInfo& resolve_info,
+                               const RangeOwner& owner, id<MTLBuffer> dest,
+                               NSUInteger dest_offset, uint32_t dest_base, bool verify,
+                               RationalResolveMode rational_mode = RationalResolveMode::kNone,
+                               uint32_t surface_pitch = 0, id<MTLTexture> dest_texture = nil,
+                               uint32_t texture_endian = 0, uint32_t texture_conversion = 0);
+  // The copy of a resolve at a rational draw resolution scale, where there is no scaled resolve
+  // buffer and no scaled copy shader: written straight from the render targets (the native path)
+  // to the guest memory at the guest resolution, and, for a resolve textures may sample at the
+  // scale (not data, see kDataTargetMaxSize, and from the start of its destination), to a scaled
+  // surface too. A resolve the native path does not handle is dumped at the guest resolution to
+  // edram_buffer_guest_ and copied from there as at 1x.
+  bool ResolveCopyAtRationalScale(const draw_util::ResolveInfo& resolve_info,
+                                  MetalSharedMemory& shared_memory,
+                                  MetalTextureCache& texture_cache,
+                                  uint32_t& written_address_out, uint32_t& written_length_out);
+  // gfx = hle (hle_resolve_in_render_pass): writes a resolve of a native source (see
+  // GetNativeResolveSource) with a tile function inside the open render pass, when the source is
+  // one of the pass's color attachments; false, with nothing done, otherwise. dest is the shared
+  // memory, or a scratch buffer written at the destination addresses minus dest_bias.
+  bool ResolveInRenderPass(const draw_util::ResolveInfo& resolve_info, MetalRenderTarget& source,
+                           id<MTLBuffer> dest, uint32_t dest_bias);
+  // The tile pipeline of ResolveInRenderPass for the open pass's color formats, or nil.
+  id<MTLRenderPipelineState> GetResolveInRenderPassPipeline(uint32_t packing,
+                                                            uint32_t color_index);
+  // hle_verify_resolves: compares a scratch copy ResolveInRenderPass wrote (with dest_bias the
+  // resolve's extent start) with what the usual path wrote to the memory, and logs mismatches.
+  void CompareResolveInRenderPass(const draw_util::ResolveInfo& resolve_info,
+                                  MetalRenderTarget& source, MetalSharedMemory& shared_memory,
+                                  id<MTLBuffer> scratch);
+
+  id<MTLFunction> transfer_vertex_function_ = nil;
+  std::unordered_map<TransferShaderKey, id<MTLFunction>, TransferShaderKey::Hasher>
+      transfer_shaders_;
+  // nil if failed to create.
+  std::unordered_map<TransferShaderKey, id<MTLRenderPipelineState>, TransferShaderKey::Hasher>
+      transfer_pipelines_;
+  // Depth and stencil written by depth transfers. Metal has stencil export, so stencil is written
+  // by the depth transfer itself and the stencil bit modes are never used.
+  id<MTLDepthStencilState> transfer_depth_stencil_state_depth_ = nil;
+
+  // Resolve clears draw a rectangle of the clear value, as Metal render passes can only clear
+  // whole attachments when they begin. Keyed by the attachment format.
+  id<MTLFunction> clear_vertex_function_ = nil;
+  id<MTLFunction> clear_fragment_function_float_ = nil;
+  id<MTLFunction> clear_fragment_function_uint_ = nil;
+  std::unordered_map<uint32_t, id<MTLRenderPipelineState>> clear_pipelines_;
+  id<MTLDepthStencilState> clear_depth_stencil_state_ = nil;
+
+  // nil if failed to create.
+  std::unordered_map<DumpPipelineKey, ComputePipeline, DumpPipelineKey::Hasher> dump_pipelines_;
+
+  MetalRenderPass last_update_render_pass_;
+  MetalRenderPassFormats last_update_render_pass_formats_;
+
+  // Temporary storage for Resolve.
+  std::vector<Transfer> clear_transfers_[2];
+
+  // Temporary storage for PerformTransfersAndResolveClears.
+  std::vector<TransferInvocation> current_transfer_invocations_;
+
+  // Temporary storage for DumpRenderTargets.
+  std::vector<ResolveCopyDumpRectangle> dump_rectangles_;
+  std::vector<DumpInvocation> dump_invocations_;
+};
+
+}  // namespace rex::graphics::metal
