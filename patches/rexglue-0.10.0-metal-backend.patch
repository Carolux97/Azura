+/**
+ * @file        graphics/metal/metal_presenter.h
+ * @brief       Presents the guest output to a CAMetalLayer with Metal
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+
+#include <rex/ui/presenter.h>
+
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+namespace rex::graphics::metal {
+
+class MetalPresenter final : public ui::Presenter {
+ public:
+  // Format of the guest output images the refresher draws into, as in the Vulkan backend
+  // (A2B10G10R10).
+  static constexpr MTLPixelFormat kGuestOutputFormat = MTLPixelFormatRGB10A2Unorm;
+
+  // Handed to the guest output refresher (the command processor's swap).
+  class MetalGuestOutputRefreshContext final : public GuestOutputRefreshContext {
+   public:
+    MetalGuestOutputRefreshContext(bool& is_8bpc_out_ref, id<MTLTexture> texture)
+        : GuestOutputRefreshContext(is_8bpc_out_ref), texture_(texture) {}
+    // kGuestOutputFormat, shader write and shader read usage.
+    id<MTLTexture> texture() const { return texture_; }
+
+   private:
+    id<MTLTexture> texture_;
+  };
+
+  static std::unique_ptr<MetalPresenter> Create(HostGpuLossCallback host_gpu_loss_callback,
+                                                id<MTLDevice> device, id<MTLCommandQueue> queue);
+  ~MetalPresenter() override;
+
+  ui::Surface::TypeFlags GetSupportedSurfaceTypes() const override;
+  // CAS when its pipelines were created, and MetalFX where this GPU supports its spatial scaler.
+  bool SupportsGuestOutputEffect(GuestOutputPaintConfig::Effect effect) const override {
+    switch (effect) {
+      case GuestOutputPaintConfig::Effect::kBilinear:
+        return true;
+      case GuestOutputPaintConfig::Effect::kCas:
+        return cas_sharpen_pipeline_ != nil;
+      case GuestOutputPaintConfig::Effect::kMetalFx:
+        return metalfx_supported_;
+      default:
+        return false;
+    }
+  }
+  bool CaptureGuestOutput(ui::RawImage& image_out) override;
+
+ protected:
+  SurfacePaintConnectResult ConnectOrReconnectPaintingToSurfaceFromUIThread(
+      ui::Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+      bool was_paintable, bool& is_vsync_implicit_out) override;
+  void DisconnectPaintingFromSurfaceFromUIThreadImpl() override;
+  bool RefreshGuestOutputImpl(uint32_t mailbox_index, uint32_t frontbuffer_width,
+                              uint32_t frontbuffer_height,
+                              std::function<bool(GuestOutputRefreshContext& context)> refresher,
+                              bool& is_8bpc_out_ref) override;
+  PaintResult PaintAndPresentImpl(bool execute_ui_drawers) override;
+
+ private:
+  MetalPresenter(HostGpuLossCallback host_gpu_loss_callback, id<MTLDevice> device,
+                 id<MTLCommandQueue> queue)
+      : Presenter(host_gpu_loss_callback), device_(device), queue_(queue) {}
+  bool InitializeSurfaceIndependent();
+  // The AMD CAS pipelines (the SDK's prebuilt shaders converted to MSL), nil if unavailable.
+  bool InitializeCas(id<MTLLibrary> paint_library);
+  // A render pass drawing a guest output effect over the viewport of a target.
+  void EncodeEffect(id<MTLRenderCommandEncoder> encoder, id<MTLRenderPipelineState> pipeline,
+                    id<MTLTexture> source, int32_t x, int32_t y, uint32_t width, uint32_t height,
+                    const void* constants, size_t constants_size);
+  // A texture an effect renders into for the next one, kept while its size stays the same.
+  id<MTLTexture> GetIntermediateTexture(id<MTLTexture> __strong& texture, uint32_t width,
+                                        uint32_t height, MTLTextureUsage usage, NSString* label);
+
+  id<MTLDevice> device_;
+  id<MTLCommandQueue> queue_;
+  id<MTLRenderPipelineState> paint_pipeline_ = nil;
+  id<MTLSamplerState> paint_sampler_ = nil;
+
+  // present_effect = "cas": sharpening at the same size, or resampling (up to 2x along each axis,
+  // the rest is bilinear) to the drawable or to an intermediate texture.
+  id<MTLRenderPipelineState> cas_sharpen_pipeline_ = nil;
+  id<MTLRenderPipelineState> cas_resample_pipeline_ = nil;
+  id<MTLRenderPipelineState> cas_resample_intermediate_pipeline_ = nil;
+  id<MTLTexture> cas_intermediate_texture_ = nil;
+
+  // present_effect = "metalfx": MetalFX spatial upscaling to an intermediate texture of the output
+  // size, then copied to the drawable. Recreated when the sizes change.
+  id<MTLFXSpatialScaler> metalfx_scaler_ = nil;
+  id<MTLTexture> metalfx_output_texture_ = nil;
+  bool metalfx_supported_ = false;
+  std::array<id<MTLTexture>, kGuestOutputMailboxSize> guest_output_textures_ = {};
+
+  CAMetalLayer* layer_ = nil;
+  uint32_t layer_width_ = 0;
+  uint32_t layer_height_ = 0;
+};
+
