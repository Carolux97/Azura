diff --git a/include/rex/input/pad_remap.h b/include/rex/input/pad_remap.h
new file mode 100644
index 0000000..a146aa8
--- /dev/null
+++ b/include/rex/input/pad_remap.h
@@ -0,0 +1,87 @@
+/**
+ * @file        rex/input/pad_remap.h
+ * @brief       Controller buttons acting as other buttons
+ *
+ * A player's own layout for controllers: each physical control (a button, a trigger, a stick
+ * press) can act as another one. It applies to every controller, before the guest reads it, only
+ * while pad_custom is on (the game's own control schemes are its profile's business) and only in
+ * play: the game's menus keep the controller's own buttons (SetPadLayoutQuery). The keyboard and
+ * mouse have their own binds and are not remapped here.
+ *
+ * pad_remap lists, for each physical control in PadControl order, the name of the control it acts
+ * as: "a,b,x,y,lb,rb,lt,rt,l3,r3,back,start,up,down,left,right" is the controller as it is.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include <rex/input/device.h>
+#include <rex/input/input.h>
+
+namespace rex::input {
+
+/// The controls a controller's layout can move, in pad_remap's order.
+enum class PadControl : uint8_t {
+  kA,
+  kB,
+  kX,
+  kY,
+  kLeftShoulder,
+  kRightShoulder,
+  kLeftTrigger,
+  kRightTrigger,
+  kLeftThumb,
+  kRightThumb,
+  kBack,
+  kStart,
+  kDpadUp,
+  kDpadDown,
+  kDpadLeft,
+  kDpadRight,
+  kCount,
+};
+
+constexpr size_t kPadControlCount = static_cast<size_t>(PadControl::kCount);
+
+/// For each physical control, the control it acts as.
+using PadLayout = std::array<PadControl, kPadControlCount>;
+
+/// The controller as it is: every control acts as itself.
+PadLayout IdentityPadLayout();
+
+/// pad_remap's name of a control ("a", "lb", "up", ...).
+std::string_view PadControlName(PadControl control);
+
+/// A layout from pad_remap's text; controls it does not name, or names wrongly, act as
+/// themselves.
+PadLayout ParsePadLayout(std::string_view text);
+
+/// pad_remap's text for a layout.
+std::string FormatPadLayout(const PadLayout& layout);
+
+/// The layout in use: pad_remap while pad_custom is on, otherwise the identity.
+PadLayout CurrentPadLayout();
+
+/// Applies a layout to a controller's state: each pressed physical control presses the one it acts
+/// as. A trigger moved to a trigger keeps its travel; a trigger moved to a button presses it past
+/// XInput's trigger threshold, and a button moved to a trigger pulls it all the way. The sticks
+/// and the guide button are left as they are.
+void ApplyPadLayout(const PadLayout& layout, X_INPUT_GAMEPAD& pad);
+
+/// Asked whenever a controller is read whether the game is being played: the layout applies only
+/// then, and menus get the controller's own buttons. Null (the default) applies it always.
+void SetPadLayoutQuery(bool (*in_play)());
+
+/// Applies `layout` to controller `id`'s state as the game is being played or not
+/// (SetPadLayoutQuery). Each control keeps what it acted as when pressed until it is released, so
+/// a button held while a menu opens or closes does not turn into another one.
+void ApplyPadLayoutInPlay(DeviceId id, const PadLayout& layout, X_INPUT_GAMEPAD& pad);
+
+}  // namespace rex::input
