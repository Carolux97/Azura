+    rexglue_apply_target_settings(${target_name})
+endfunction()
+
+#==========================================================
+# rexglue_configure_target(<target> [GPU_PLUGINS ...] [HOST_OBJECTS <objlib>])
+#   - Host application
+#
+# Adds:
+#   - the SDK host sources (rexglue_add_host_sources), or, with HOST_OBJECTS,
+#     links the object library that already has them
+#   - $ORIGIN RPATH on UNIX so the host finds librexruntime.so next to itself
+#   - Windows POST_BUILD copy of TARGET_RUNTIME_DLLS and the FidelityFX DLLs.
+#     Guest modules colocate with the host (see rexglue_configure_module_target),
+#     so this single copy handles them transitively.
+#==========================================================
+function(rexglue_configure_target target_name)
+    cmake_parse_arguments(ARG "" "HOST_OBJECTS" "GPU_PLUGINS" ${ARGN})
+
+    if(ARG_HOST_OBJECTS)
+        # Linked as object files, not as an archive: the linker keeps every
+        # object, including those whose only role is to replace a weak
+        # function of the generated code.
+        target_link_libraries(${target_name} PRIVATE ${ARG_HOST_OBJECTS})
+    else()
+        rexglue_add_host_sources(${target_name})
+    endif()
+
     if(UNIX AND NOT APPLE)
         set_target_properties(${target_name} PROPERTIES
             INSTALL_RPATH "$ORIGIN"
