+namespace {
+
+// Why a range changes owner: what differs between the source and the destination keys.
+const char* GetTransferReason(uint32_t source_key, uint32_t dest_key) {
+  union Key {
+    uint32_t key;
+    struct {
+      uint32_t base_tiles : xenos::kEdramBaseTilesBits;
+      uint32_t pitch_tiles_at_32bpp : 8;
+      uint32_t msaa_samples : xenos::kMsaaSamplesBits;
+      uint32_t is_depth : 1;
+      uint32_t resource_format : xenos::kRenderTargetFormatBits;
+    };
+  };
+  Key source, dest;
+  source.key = source_key;
+  dest.key = dest_key;
+  if (source.is_depth != dest.is_depth) {
+    return "depth/color";
+  }
+  if (source.base_tiles != dest.base_tiles) {
+    return "other base";
+  }
+  if (source.pitch_tiles_at_32bpp != dest.pitch_tiles_at_32bpp) {
+    return "pitch";
+  }
+  if (source.msaa_samples != dest.msaa_samples) {
+    return "msaa";
+  }
+  return "format";
+}
