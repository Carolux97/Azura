+/**
+ * @file        graphics/metal/metal_pipeline_cache.mm
+ * @brief       Guest shader translation and render pipeline states for the Metal backend
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_pipeline_cache.h"
+
+#include <algorithm>
