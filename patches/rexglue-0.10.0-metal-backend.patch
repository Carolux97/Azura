+
+bool MetalCommandProcessor::SetupContext() {
+  auto* provider = static_cast<MetalProvider*>(graphics_system_->provider());
+  if (!provider) {
+    REXGPU_ERROR("Metal: no graphics provider");
+    return false;
+  }
+  device_ = provider->device();
+  queue_ = provider->queue();
+  accurate_fences_ = REXCVAR_GET(metal_gpu_accurate_fences);
+  debug_labels_enabled_ = REXCVAR_GET(gpu_debug_markers);
+  if (accurate_fences_) {
+    REXGPU_INFO("Metal: guest fences are written when the GPU finishes the work before them");
+  }
+  // Occlusion query counters are read by the CPU when the submissions complete, so shared.
+  occlusion_buffer_ = [device_ newBufferWithLength:size_t(kOcclusionSlotCount) * sizeof(uint64_t)
+                                           options:MTLResourceStorageModeShared];
+  occlusion_buffer_.label = @"Occlusion query results";
+
+  scratch_buffer_pool_ = std::make_unique<TransientBufferPool>(
+      device_, MTLResourceStorageModePrivate, size_t(16) << 20, @"Scratch");
+  upload_buffer_pool_ = std::make_unique<TransientBufferPool>(
+      device_, MTLResourceStorageModeShared | MTLResourceCPUCacheModeWriteCombined,
+      size_t(4) << 20, @"Upload");
+
+  shared_memory_ = std::make_unique<MetalSharedMemory>(*this, *memory_);
+  if (!shared_memory_->Initialize()) {
+    REXGPU_ERROR("Metal: failed to initialize the shared memory");
+    return false;
+  }
+
+  primitive_processor_ =
+      std::make_unique<MetalPrimitiveProcessor>(*register_file_, *memory_, *shared_memory_, *this);
+  if (!primitive_processor_->Initialize()) {
+    REXGPU_ERROR("Metal: failed to initialize the primitive processor");
+    return false;
+  }
+
+  // The configured scale as a ratio (3/2 for 1920x1080). A rational scale needs gfx = hle: its
+  // resolves are written straight from the render targets (the native path), and only those give
+  // textures at the scale; without it, it falls back to its whole part.
+  DrawResolutionScale draw_resolution_scale;
+  TextureCache::GetConfigDrawResolutionScale(draw_resolution_scale);
+  if (!draw_resolution_scale.IsWhole() && !hle::HleGraphicsEnabled()) {
+    DrawResolutionScale whole_part = DrawResolutionScale::Whole(
+        std::max(draw_resolution_scale.numerator_x / draw_resolution_scale.denominator,
+                 UINT32_C(1)),
+        std::max(draw_resolution_scale.numerator_y / draw_resolution_scale.denominator,
+                 UINT32_C(1)));
+    REXGPU_WARN("Metal: the draw resolution scale {}/{} x {}/{} needs gfx = hle; drawing at "
+                "{}x{}",
+                draw_resolution_scale.numerator_x, draw_resolution_scale.denominator,
+                draw_resolution_scale.numerator_y, draw_resolution_scale.denominator,
+                whole_part.numerator_x, whole_part.numerator_y);
+    draw_resolution_scale = whole_part;
+  }
+
+  render_target_cache_ = std::make_unique<MetalRenderTargetCache>(*register_file_, *memory_,
+                                                                   draw_resolution_scale, *this);
+  if (!render_target_cache_->Initialize()) {
+    REXGPU_ERROR("Metal: failed to initialize the render target cache");
+    return false;
+  }
+
+  pipeline_cache_ =
+      std::make_unique<MetalPipelineCache>(*this, *register_file_, *render_target_cache_);
+  if (!pipeline_cache_->Initialize()) {
+    REXGPU_ERROR("Metal: failed to initialize the pipeline cache");
+    return false;
+  }
+  if (REXCVAR_GET(metal_gpu_capture_frames) > 0) {
+    if (![[MTLCaptureManager sharedCaptureManager]
+            supportsDestination:MTLCaptureDestinationGPUTraceDocument]) {
+      REXGPU_ERROR("Metal: GPU capture to a document is not available (MTL_CAPTURE_ENABLED)");
+    } else {
+      rex::ui::RegisterBind("bind_metal_gpu_capture", "RBracket",
+                            "Save a Metal GPU capture of the next metal_gpu_capture_frames frames",
+                            [this] { gpu_capture_requested_.store(true); });
+      REXGPU_INFO("Metal: GPU capture of {} frames on bind_metal_gpu_capture, into {}",
+                  REXCVAR_GET(metal_gpu_capture_frames), REXCVAR_GET(metal_gpu_capture_path));
+    }
+  }
+  if (REXCVAR_GET(metal_frame_history_frames) > 0) {
+    rex::ui::RegisterBind("bind_metal_frame_history", "LBracket",
+                          "Save the last metal_frame_history_frames guest frames as images",
+                          [this] { frame_history_save_requested_.store(true); });
+    REXGPU_INFO("Metal: the last {} frames are kept, saved on bind_metal_frame_history into {}",
+                REXCVAR_GET(metal_frame_history_frames), REXCVAR_GET(metal_gpu_capture_path));
+  }
+  if (pipeline_cache_->xsc_translator() && REXCVAR_GET(xsc_debug_color_range)) {
+    size_t size = sizeof(uint32_t) * xsc::XscShaderTranslator::kDebugCountersPerShader *
+                  xsc::XscShaderTranslator::kDebugCounterMaxShaders;
+    xsc_debug_counters_ = [device_ newBufferWithLength:size options:MTLResourceStorageModeShared];
+    std::memset(xsc_debug_counters_.contents, 0, size);
+    xsc_debug_counters_.label = @"XSC debug counters";
+  }
+
+  texture_cache_ = MetalTextureCache::Create(*register_file_, *shared_memory_,
+                                             draw_resolution_scale, *this);
+  if (!texture_cache_) {
+    REXGPU_ERROR("Metal: failed to initialize the texture cache");
+    return false;
+  }
+
+  if (!InitializeSwapPipelines()) {
+    return false;
+  }
+
+  REXGPU_INFO("Metal: command processor ready (sample-space render targets)");
+  return true;
+}
+
+bool MetalCommandProcessor::InitializeSwapPipelines() {
+  const std::vector<MslBinding> bindings = {
+      {0, 0, MslBinding::Kind::kTexture, kSwapTextureRamp},
+      {1, 0, MslBinding::Kind::kTexture, kSwapTextureSource},
+      {2, 0, MslBinding::Kind::kTexture, kSwapTextureDestination},
+      {MslBinding::kPushConstantSet, 0, MslBinding::Kind::kBuffer, kSwapBufferConstants},
+  };
+  std::array<uint32_t, 3> threadgroup_size;
+  swap_apply_gamma_table_pipeline_ = CreateComputePipelineFromSpirv(
+      device_, shaders::apply_gamma_table_cs, sizeof(shaders::apply_gamma_table_cs) / 4, bindings,
+      "apply gamma table", &threadgroup_size);
+  swap_apply_gamma_pwl_pipeline_ = CreateComputePipelineFromSpirv(
+      device_, shaders::apply_gamma_pwl_cs, sizeof(shaders::apply_gamma_pwl_cs) / 4, bindings,
+      "apply gamma PWL", &threadgroup_size);
+  if (!swap_apply_gamma_table_pipeline_ || !swap_apply_gamma_pwl_pipeline_) {
+    REXGPU_ERROR("Metal: failed to create the gamma ramp pipelines");
+    return false;
+  }
+  swap_apply_gamma_threads_per_threadgroup_ =
+      MTLSizeMake(threadgroup_size[0], threadgroup_size[1], threadgroup_size[2]);
+
+  // FXAA. Without it the game still runs, presenting without the filter.
+  swap_apply_gamma_table_fxaa_luma_pipeline_ = CreateComputePipelineFromSpirv(
+      device_, shaders::apply_gamma_table_fxaa_luma_cs,
+      sizeof(shaders::apply_gamma_table_fxaa_luma_cs) / 4, bindings, "apply gamma table FXAA luma");
+  swap_apply_gamma_pwl_fxaa_luma_pipeline_ = CreateComputePipelineFromSpirv(
+      device_, shaders::apply_gamma_pwl_fxaa_luma_cs,
+      sizeof(shaders::apply_gamma_pwl_fxaa_luma_cs) / 4, bindings, "apply gamma PWL FXAA luma");
+  NSError* error = nil;
+  id<MTLLibrary> fxaa_library = [device_ newLibraryWithSource:kSwapFxaaShaderSource
+                                                      options:nil
+                                                        error:&error];
+  if (fxaa_library) {
+    for (bool extreme_quality : {false, true}) {
+      MTLFunctionConstantValues* constant_values = [MTLFunctionConstantValues new];
+      [constant_values setConstantValue:&extreme_quality type:MTLDataTypeBool atIndex:0];
+      id<MTLFunction> function = [fxaa_library newFunctionWithName:@"swap_fxaa"
+                                                    constantValues:constant_values
+                                                             error:&error];
+      id<MTLComputePipelineState> pipeline =
+          function ? [device_ newComputePipelineStateWithFunction:function error:&error] : nil;
+      (extreme_quality ? swap_fxaa_extreme_pipeline_ : swap_fxaa_pipeline_) = pipeline;
+    }
+  }
+  if (!swap_fxaa_pipeline_ || !swap_fxaa_extreme_pipeline_ ||
+      !swap_apply_gamma_table_fxaa_luma_pipeline_ || !swap_apply_gamma_pwl_fxaa_luma_pipeline_) {
+    REXGPU_ERROR("Metal: failed to create the FXAA pipelines: {}",
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+  }
+  if (REXCVAR_GET(metal_pixel_history)) {
+    id<MTLLibrary> pixel_history_library =
+        [device_ newLibraryWithSource:kPixelHistoryShaderSource options:nil error:&error];
+    id<MTLFunction> function =
+        [pixel_history_library newFunctionWithName:@"pixel_history_sample"];
+    pixel_history_pipeline_ =
+        function ? [device_ newComputePipelineStateWithFunction:function error:&error] : nil;
+    pixel_history_buffer_ =
+        [device_ newBufferWithLength:size_t(kPixelHistoryMaxDraws) * kPixelHistoryGridWidth *
+                                     kPixelHistoryGridHeight * 8
+                             options:MTLResourceStorageModeShared];
+    if (!pixel_history_pipeline_ || !pixel_history_buffer_) {
+      REXGPU_ERROR("Metal: failed to create the pixel history pipeline: {}",
+                   error ? error.localizedDescription.UTF8String : "unknown error");
+    }
+  }
+  MTLSamplerDescriptor* sampler_descriptor = [MTLSamplerDescriptor new];
+  sampler_descriptor.minFilter = MTLSamplerMinMagFilterLinear;
+  sampler_descriptor.magFilter = MTLSamplerMinMagFilterLinear;
+  sampler_descriptor.sAddressMode = MTLSamplerAddressModeClampToEdge;
+  sampler_descriptor.tAddressMode = MTLSamplerAddressModeClampToEdge;
+  swap_fxaa_sampler_ = [device_ newSamplerStateWithDescriptor:sampler_descriptor];
+  return true;
+}
+
+void MetalCommandProcessor::ShutdownContext() {
+  if (REXCVAR_GET(metal_frame_history_frames) > 0) {
+    rex::ui::UnregisterBind("bind_metal_frame_history");
+  }
+  frame_history_.clear();
+  if (REXCVAR_GET(metal_gpu_capture_frames) > 0) {
+    rex::ui::UnregisterBind("bind_metal_gpu_capture");
+    if (gpu_capture_frames_remaining_) {
+      [[MTLCaptureManager sharedCaptureManager] stopCapture];
+      gpu_capture_frames_remaining_ = 0;
+    }
+  }
+  AwaitSubmission(UINT64_MAX);
+  // Completion handlers may still be finishing after the command buffers report completion.
+  while (completion_handlers_in_flight_.load(std::memory_order_acquire)) {
+    rex::thread::MaybeYield();
+  }
+
+  swap_fxaa_source_ = nil;
+  swap_fxaa_sampler_ = nil;
+  swap_fxaa_extreme_pipeline_ = nil;
+  swap_fxaa_pipeline_ = nil;
+  swap_apply_gamma_pwl_fxaa_luma_pipeline_ = nil;
+  swap_apply_gamma_table_fxaa_luma_pipeline_ = nil;
+  swap_apply_gamma_pwl_pipeline_ = nil;
+  swap_apply_gamma_table_pipeline_ = nil;
+
+  texture_cache_.reset();
+  pipeline_cache_.reset();
+  render_target_cache_.reset();
+  primitive_processor_.reset();
+  shared_memory_.reset();
+
+  upload_buffer_pool_.reset();
+  scratch_buffer_pool_.reset();
+
+  command_buffer_ = nil;
+  render_encoder_ = nil;
+  compute_encoder_ = nil;
+  blit_encoder_ = nil;
+  queue_ = nil;
+  xsc_debug_counters_ = nil;
+  device_ = nil;
+}
+
+void MetalCommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
+  CommandProcessor::WriteRegister(index, value);
+
+  if (index >= XE_GPU_REG_SHADER_CONSTANT_000_X && index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
+    if (frame_open_) {
+      uint32_t float_constant_index = (index - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2;
+      if (float_constant_index >= 256) {
+        float_constant_index -= 256;
+        if (current_float_constant_map_pixel_[float_constant_index >> 6] &
+            (1ull << (float_constant_index & 63))) {
+          current_constant_buffers_up_to_date_ &=
+              ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatPixel);
+        }
+      } else {
+        if (current_float_constant_map_vertex_[float_constant_index >> 6] &
+            (1ull << (float_constant_index & 63))) {
+          current_constant_buffers_up_to_date_ &=
+              ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatVertex);
+        }
+      }
+    }
+  } else if (index >= XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 &&
+             index <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31) {
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferBoolLoop);
+  } else if (index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+             index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFetch);
+    if (texture_cache_) {
+      texture_cache_->TextureFetchConstantWritten((index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0) /
+                                                  6);
+    }
+  }
+}
+
+void MetalCommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t* base,
+                                                  uint32_t num_registers) {
+  if (!num_registers) {
+    return;
+  }
+  uint32_t end_index = start_index + num_registers - 1;
+  // Constant ranges are copied directly and invalidate their buffers once, instead of going
+  // through WriteRegister for every register.
+  if (start_index >= XE_GPU_REG_SHADER_CONSTANT_000_X &&
+      end_index <= XE_GPU_REG_SHADER_CONSTANT_511_W) {
+    memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
+    if (frame_open_) {
+      uint32_t first_float_constant = (start_index - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2;
+      uint32_t last_float_constant = (end_index - XE_GPU_REG_SHADER_CONSTANT_000_X) >> 2;
+      if (first_float_constant < 256) {
+        current_constant_buffers_up_to_date_ &=
+            ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatVertex);
+      }
+      if (last_float_constant >= 256) {
+        current_constant_buffers_up_to_date_ &=
+            ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatPixel);
+      }
+    }
+    return;
+  }
+  if (start_index >= XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031 &&
+      end_index <= XE_GPU_REG_SHADER_CONSTANT_LOOP_31) {
+    memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferBoolLoop);
+    return;
+  }
+  if (start_index >= XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 &&
+      end_index <= XE_GPU_REG_SHADER_CONSTANT_FETCH_31_5) {
+    memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFetch);
+    if (texture_cache_) {
+      uint32_t first_fetch_dword = start_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
+      uint32_t last_fetch_dword = end_index - XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0;
+      texture_cache_->TextureFetchConstantsWritten(first_fetch_dword / 6, last_fetch_dword / 6);
+    }
+    return;
+  }
+  CommandProcessor::WriteRegistersFromMem(start_index, base, num_registers);
+}
+
+Shader* MetalCommandProcessor::LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                                          const uint32_t* host_address, uint32_t dword_count) {
+  return pipeline_cache_->LoadShader(shader_type, host_address, dword_count);
+}
+
+void MetalCommandProcessor::UpdateCompletedSubmission() {
+  while (!submissions_in_flight_.empty()) {
+    const auto& submission = submissions_in_flight_.front();
+    MTLCommandBufferStatus status = submission.second.status;
+    if (status != MTLCommandBufferStatusCompleted && status != MTLCommandBufferStatusError) {
+      break;
+    }
+    if (status == MTLCommandBufferStatusError && !device_lost_) {
+      NSError* error = submission.second.error;
+      REXGPU_ERROR("Metal: a command buffer failed: {}",
+                   error ? error.localizedDescription.UTF8String : "unknown error");
+      if (error && (error.code == MTLCommandBufferErrorDeviceRemoved ||
+                    error.code == MTLCommandBufferErrorNotPermitted)) {
+        device_lost_ = true;
+        if (graphics_system_) {
+          graphics_system_->OnHostGpuLossFromAnyThread(true);
+        }
+      }
+    }
+    submission_completed_ = submission.first;
+    submissions_in_flight_.pop_front();
+  }
+}
+
+void MetalCommandProcessor::AwaitSubmission(uint64_t submission) {
+  if (submission >= submission_current_ && submission_open_) {
+    EndSubmission(false);
+  }
+  submission = std::min(submission, submission_current_ - 1);
+  UpdateCompletedSubmission();
+  if (submission_completed_ >= submission) {
+    return;
+  }
+#ifdef REXGLUE_ENABLE_PERF_COUNTERS
+  const auto wait_start = std::chrono::steady_clock::now();
+#endif
+  for (const auto& in_flight : submissions_in_flight_) {
+    if (in_flight.first > submission) {
+      break;
+    }
+    [in_flight.second waitUntilCompleted];
+  }
+#ifdef REXGLUE_ENABLE_PERF_COUNTERS
+  PERF_counter_inc(kHostGpuWaits);
+  PERF_counter_add(kHostGpuWaitUs, std::chrono::duration_cast<std::chrono::microseconds>(
+                                       std::chrono::steady_clock::now() - wait_start)
+                                       .count());
+#endif
+  UpdateCompletedSubmission();
+}
+
+bool MetalCommandProcessor::BeginSubmission(bool is_guest_command) {
+  if (device_lost_) {
+    return false;
+  }
+
+  bool is_opening_frame = is_guest_command && !frame_open_;
+  if (submission_open_ && !is_opening_frame) {
+    return true;
+  }
+
+  // Throttle to kMaxFramesInFlight frames.
+  uint64_t await_submission =
+      is_opening_frame ? closed_frame_submissions_[frame_current_ % kMaxFramesInFlight] : 0;
+  AwaitSubmission(await_submission);
+  if (device_lost_) {
+    return false;
+  }
+
+  if (is_opening_frame) {
+    frame_completed_ = std::max(frame_current_, uint64_t(kMaxFramesInFlight)) - kMaxFramesInFlight;
+    for (uint64_t frame = frame_completed_ + 1; frame < frame_current_; ++frame) {
+      if (closed_frame_submissions_[frame % kMaxFramesInFlight] > submission_completed_) {
+        break;
+      }
+      frame_completed_ = frame;
+    }
+  }
+
+  if (!submission_open_) {
+    submission_open_ = true;
+    command_buffer_ = [queue_ commandBuffer];
+    if (!command_buffer_) {
+      REXGPU_ERROR("Metal: failed to create a command buffer");
+      submission_open_ = false;
+      return false;
+    }
+    command_buffer_.label = @"Guest GPU";
+    submission_has_work_ = false;
+    encoder_type_ = EncoderType::kNone;
+    current_render_pass_ = MetalRenderPass();
+    render_encoder_state_ = RenderEncoderState();
+    texture_cache_->BeginSubmission(GetCurrentSubmission());
+  }
+
+  if (is_opening_frame) {
+    frame_open_ = true;
+    std::memset(current_float_constant_map_vertex_, 0, sizeof(current_float_constant_map_vertex_));
+    std::memset(current_float_constant_map_pixel_, 0, sizeof(current_float_constant_map_pixel_));
+    current_constant_buffers_up_to_date_ = 0;
+    primitive_processor_->BeginFrame();
+    texture_cache_->BeginFrame();
+  }
+
+  return true;
+}
+
+bool MetalCommandProcessor::EndSubmission(bool is_swap) {
+  bool is_closing_frame = is_swap && frame_open_;
+  if (is_closing_frame) {
+    texture_cache_->EndFrame();
+    primitive_processor_->EndFrame();
+  }
+
+  if (submission_open_) {
+    ApplyPendingClears(rex::perf::CounterId::kRenderPassEndsOther);
+    EndEncoder(rex::perf::CounterId::kRenderPassEndsOther);
+    if (accurate_fences_ || occlusion_buffer_) {
+      uint64_t submission = submission_current_;
+      completion_handlers_in_flight_.fetch_add(1, std::memory_order_relaxed);
+      [command_buffer_ addCompletedHandler:^(id<MTLCommandBuffer>) {
+        OnSubmissionCompletedByGpu(submission);
+        completion_handlers_in_flight_.fetch_sub(1, std::memory_order_release);
+      }];
+    }
+    [command_buffer_ addCompletedHandler:^(id<MTLCommandBuffer> buffer) {
+      AccountGpuTime(buffer.GPUStartTime, buffer.GPUEndTime);
+    }];
+    [command_buffer_ commit];
+    PERF_counter_inc(kHostSubmissions);
+    submissions_in_flight_.emplace_back(submission_current_, command_buffer_);
+    command_buffer_ = nil;
+    ++submission_current_;
+    submission_open_ = false;
+    // Constants live in the upload pages of the submission.
+    current_constant_buffers_up_to_date_ = 0;
+  }
+
+  if (is_closing_frame) {
+    frame_open_ = false;
+    closed_frame_submissions_[(frame_current_++) % kMaxFramesInFlight] = submission_current_ - 1;
+
+    if (xsc_debug_counters_ && frame_current_ % kXscDebugCounterLogFrames == 0) {
+      LogXscDebugCounters();
+    }
+    UpdateGpuCapture();
+    if (pixel_history_state_ == PixelHistoryState::kRecording) {
+      pixel_history_state_ = PixelHistoryState::kOff;
+      SavePixelHistory();
+    } else if (pixel_history_state_ == PixelHistoryState::kArmed) {
+      pixel_history_state_ = PixelHistoryState::kRecording;
+      pixel_history_draws_ = 0;
+      pixel_history_log_.clear();
+    }
+    if (frame_history_save_requested_.exchange(false)) {
+      SaveFrameHistory();
+      if (pixel_history_pipeline_ && pixel_history_state_ == PixelHistoryState::kOff) {
+        pixel_history_state_ = PixelHistoryState::kArmed;
+      }
+    }
+
+    if (cache_clear_requested_) {
+      cache_clear_requested_ = false;
+      AwaitSubmission(UINT64_MAX);
+      texture_cache_->ClearCache();
+      render_target_cache_->ClearCache();
+    }
+  }
+
+  return true;
+}
+
+void MetalCommandProcessor::RecordFrameHistory(id<MTLTexture> swap_texture, uint32_t width,
+                                               uint32_t height) {
+  uint32_t count = uint32_t(REXCVAR_GET(metal_frame_history_frames));
+  if (frame_history_.size() != count || !frame_history_[0] ||
+      frame_history_[0].pixelFormat != swap_texture.pixelFormat ||
+      frame_history_[0].width != width || frame_history_[0].height != height) {
+    // Shared storage, read by the CPU when saving.
+    MTLTextureDescriptor* descriptor =
+        [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:swap_texture.pixelFormat
+                                                           width:width
+                                                          height:height
+                                                       mipmapped:NO];
+    descriptor.storageMode = MTLStorageModeShared;
+    descriptor.usage = MTLTextureUsageShaderRead;
+    frame_history_.assign(count, nil);
+    frame_history_guest_frames_.assign(count, 0);
+    for (size_t i = 0; i < frame_history_.size(); ++i) {
+      frame_history_[i] = [device_ newTextureWithDescriptor:descriptor];
+    }
+    frame_history_next_ = 0;
+  }
+  id<MTLBlitCommandEncoder> blit = GetBlitEncoder(rex::perf::CounterId::kRenderPassEndsOther);
+  [blit copyFromTexture:swap_texture
+            sourceSlice:0
+            sourceLevel:0
+           sourceOrigin:MTLOriginMake(0, 0, 0)
+             sourceSize:MTLSizeMake(width, height, 1)
+              toTexture:frame_history_[frame_history_next_]
+       destinationSlice:0
+       destinationLevel:0
+      destinationOrigin:MTLOriginMake(0, 0, 0)];
+  frame_history_guest_frames_[frame_history_next_] = frame_current_;
+  frame_history_next_ = (frame_history_next_ + 1) % count;
+}
+
+void MetalCommandProcessor::SaveFrameHistory() {
+  if (frame_history_.empty()) {
+    return;
+  }
+  // Everything recorded must have reached the textures.
+  AwaitSubmission(UINT64_MAX);
+  auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+  char name[64];
+  std::strftime(name, sizeof(name), "frames_%Y%m%d-%H%M%S", std::localtime(&now));
+  std::filesystem::path folder = std::filesystem::path(REXCVAR_GET(metal_gpu_capture_path)) / name;
+  std::error_code error_code;
+  std::filesystem::create_directories(folder, error_code);
+  uint32_t count = uint32_t(frame_history_.size());
+  uint32_t saved = 0;
+  std::vector<uint8_t> texels, rgb;
+  for (uint32_t i = 0; i < count; ++i) {
+    // Oldest first.
+    uint32_t slot = (frame_history_next_ + i) % count;
+    id<MTLTexture> texture = frame_history_[slot];
+    if (!frame_history_guest_frames_[slot]) {
+      continue;
+    }
+    uint32_t width = uint32_t(texture.width), height = uint32_t(texture.height);
+    texels.resize(size_t(width) * height * 4);
+    [texture getBytes:texels.data()
+          bytesPerRow:width * 4
+           fromRegion:MTLRegionMake2D(0, 0, width, height)
+          mipmapLevel:0];
+    rgb.resize(size_t(width) * height * 3);
+    MTLPixelFormat format = texture.pixelFormat;
+    for (size_t p = 0; p < size_t(width) * height; ++p) {
+      const uint8_t* t = &texels[p * 4];
+      uint8_t* o = &rgb[p * 3];
+      uint32_t packed;
+      std::memcpy(&packed, t, sizeof(packed));
+      switch (format) {
+        case MTLPixelFormatBGRA8Unorm:
+        case MTLPixelFormatBGRA8Unorm_sRGB:
+          o[0] = t[2], o[1] = t[1], o[2] = t[0];
+          break;
+        case MTLPixelFormatRGB10A2Unorm:
+          o[0] = uint8_t((packed & 0x3FF) >> 2);
+          o[1] = uint8_t(((packed >> 10) & 0x3FF) >> 2);
+          o[2] = uint8_t(((packed >> 20) & 0x3FF) >> 2);
+          break;
+        case MTLPixelFormatBGR10A2Unorm:
+          o[2] = uint8_t((packed & 0x3FF) >> 2);
+          o[1] = uint8_t(((packed >> 10) & 0x3FF) >> 2);
+          o[0] = uint8_t(((packed >> 20) & 0x3FF) >> 2);
+          break;
+        default:
+          // RGBA8 and anything else with 8-bit RGB first.
+          o[0] = t[0], o[1] = t[1], o[2] = t[2];
+          break;
+      }
+    }
+    // Binary PPM: no image library needed; sips or Preview convert it.
+    char file_name[64];
+    std::snprintf(file_name, sizeof(file_name), "frame_%03u_%llu.ppm", i,
+                  (unsigned long long)frame_history_guest_frames_[slot]);
+    FILE* file = std::fopen((folder / file_name).c_str(), "wb");
+    if (!file) {
+      continue;
+    }
+    std::fprintf(file, "P6\n%u %u\n255\n", width, height);
+    std::fwrite(rgb.data(), 1, rgb.size(), file);
+    std::fclose(file);
+    ++saved;
+  }
+  REXGPU_INFO("Metal: saved {} frames (pixel format {}) to {}", saved,
+              uint32_t(frame_history_[0].pixelFormat), folder.string());
+}
+
+void MetalCommandProcessor::RecordPixelHistory(const MetalRenderPass& render_pass,
+                                               const Shader* vertex_shader,
+                                               const Shader* pixel_shader,
+                                               uint32_t normalized_color_mask) {
+  if (pixel_history_draws_ >= kPixelHistoryMaxDraws) {
+    return;
+  }
+  const RegisterFile& regs = *register_file_;
+  uint32_t draw = pixel_history_draws_++;
+  id<MTLTexture> target = render_pass.color[0];
+  // Only single-sampled 2D float and normalized targets can be read as float.
+  bool sampled = false;
+  if (target && target.textureType == MTLTextureType2D && target.sampleCount == 1) {
+    switch (target.pixelFormat) {
+      case MTLPixelFormatRGBA8Unorm:
+      case MTLPixelFormatBGRA8Unorm:
+      case MTLPixelFormatRGB10A2Unorm:
+      case MTLPixelFormatRGBA16Float:
+      case MTLPixelFormatRGBA16Unorm:
+      case MTLPixelFormatRGBA16Snorm:
+      case MTLPixelFormatRG16Float:
+      case MTLPixelFormatR32Float:
+      case MTLPixelFormatRG32Float:
+      case MTLPixelFormatRGBA32Float:
+      case MTLPixelFormatRG11B10Float:
+        sampled = true;
+        break;
+      default:
+        break;
+    }
+  }
+  if (sampled) {
+    // Ends the render pass: the next draw starts a new one, loading what this one stored.
+    id<MTLComputeCommandEncoder> compute =
+        GetComputeEncoder(rex::perf::CounterId::kRenderPassEndsOther);
+    // Host render targets are as tall as the EDRAM allows; the grid covers the 16:9 top of it,
+    // where this game's screen-sized targets are.
+    uint32_t params[4] = {render_pass.width,
+                          std::min(render_pass.height, render_pass.width * 9 / 16),
+                          kPixelHistoryGridWidth, kPixelHistoryGridHeight};
+    [compute setComputePipelineState:pixel_history_pipeline_];
+    [compute setBytes:params length:sizeof(params) atIndex:0];
+    [compute setBuffer:pixel_history_buffer_
+                offset:size_t(draw) * kPixelHistoryGridWidth * kPixelHistoryGridHeight * 8
+               atIndex:1];
+    [compute setTexture:target atIndex:0];
+    [compute dispatchThreads:MTLSizeMake(kPixelHistoryGridWidth, kPixelHistoryGridHeight, 1)
+        threadsPerThreadgroup:MTLSizeMake(8, 4, 1)];
+  }
+  auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]);
+  auto blend_control =
+      regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[0]);
+  auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  pixel_history_log_ += fmt::format(
+      "draw {} sampled {} rt0 {}x{} fmt {} base {} colormask {:04X} blend {:08X} depth {:08X} "
+      "vs {:016X} ps {:016X}",
+      draw, sampled ? 1 : 0, render_pass.width, render_pass.height,
+      uint32_t(color_info.color_format), uint32_t(color_info.color_base),
+      normalized_color_mask & 0xFFFF, blend_control.value, depth_control.value,
+      vertex_shader->ucode_data_hash(), pixel_shader ? pixel_shader->ucode_data_hash() : 0);
+  if (pixel_shader) {
+    for (const Shader::TextureBinding& binding : pixel_shader->texture_bindings()) {
+      xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+      // exp: the result exponent bias; lod: the LOD bias in 1/32.
+      pixel_history_log_ += fmt::format(
+          " tex{}:fmt{},addr{:08X},{}x{},dim{},tiled{},exp{},lod{}", binding.fetch_constant,
+          uint32_t(fetch.format), fetch.base_address << 12, fetch.size_2d.width + 1,
+          fetch.size_2d.height + 1, uint32_t(fetch.dimension), uint32_t(fetch.tiled),
+          int32_t(fetch.exp_adjust), int32_t(fetch.lod_bias));
+    }
+  }
+  pixel_history_log_ += '\n';
+}
+
+void MetalCommandProcessor::SavePixelHistory() {
+  AwaitSubmission(UINT64_MAX);
+  auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+  char name[64];
+  std::strftime(name, sizeof(name), "pixels_%Y%m%d-%H%M%S", std::localtime(&now));
+  std::filesystem::path base = std::filesystem::path(REXCVAR_GET(metal_gpu_capture_path)) / name;
+  // Draw log, and the grids as raw half4 (64x36 per draw, in draw order).
+  if (FILE* file = std::fopen((base.string() + ".txt").c_str(), "wb")) {
+    std::fwrite(pixel_history_log_.data(), 1, pixel_history_log_.size(), file);
+    std::fclose(file);
+  }
+  if (FILE* file = std::fopen((base.string() + ".half4").c_str(), "wb")) {
+    std::fwrite(pixel_history_buffer_.contents, 1,
+                size_t(pixel_history_draws_) * kPixelHistoryGridWidth * kPixelHistoryGridHeight * 8,
+                file);
+    std::fclose(file);
+  }
+  REXGPU_INFO("Metal: saved the pixel history of {} draws to {}", pixel_history_draws_,
+              base.string());
+}
+
+void MetalCommandProcessor::UpdateGpuCapture() {
+  MTLCaptureManager* capture_manager = [MTLCaptureManager sharedCaptureManager];
+  if (gpu_capture_frames_remaining_) {
+    if (--gpu_capture_frames_remaining_ == 0) {
+      [capture_manager stopCapture];
+      REXGPU_INFO("Metal: GPU capture finished");
+    }
+    return;
+  }
+  if (!gpu_capture_requested_.exchange(false)) {
+    return;
+  }
+  // Between frames: every command buffer of the next frames is in the capture.
+  std::filesystem::path folder(REXCVAR_GET(metal_gpu_capture_path));
+  std::error_code error_code;
+  std::filesystem::create_directories(folder, error_code);
+  auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+  char name[64];
+  std::strftime(name, sizeof(name), "azura_%Y%m%d-%H%M%S.gputrace", std::localtime(&now));
+  std::filesystem::path path = folder / name;
+  MTLCaptureDescriptor* descriptor = [MTLCaptureDescriptor new];
+  descriptor.captureObject = queue_;
+  descriptor.destination = MTLCaptureDestinationGPUTraceDocument;
+  descriptor.outputURL = [NSURL fileURLWithPath:@(path.c_str())];
+  NSError* error = nil;
+  if (![capture_manager startCaptureWithDescriptor:descriptor error:&error]) {
+    REXGPU_ERROR("Metal: failed to start the GPU capture: {}",
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+    return;
+  }
+  gpu_capture_frames_remaining_ = uint32_t(REXCVAR_GET(metal_gpu_capture_frames));
+  REXGPU_INFO("Metal: GPU capture of {} frames started: {}", gpu_capture_frames_remaining_,
+              path.string());
+}
+
+void MetalCommandProcessor::LogXscDebugCounters() {
+  using Translator = xsc::XscShaderTranslator;
+  const std::vector<Translator::DebugCounterShader>& shaders =
+      pipeline_cache_->xsc_translator()->debug_counter_shaders();
+  // The GPU may still be adding to the counters: a debugging aid, the counts are approximate.
+  auto* counters = static_cast<uint32_t*>(xsc_debug_counters_.contents);
+  struct Entry {
+    size_t slot;
+    uint32_t out_of_range;
+  };
+  std::vector<Entry> entries;
+  for (size_t slot = 0; slot < shaders.size(); ++slot) {
+    const uint32_t* slot_counters = counters + slot * Translator::kDebugCountersPerShader;
+    uint32_t out_of_range = slot_counters[Translator::kDebugCounterNonFinite] +
+                            slot_counters[Translator::kDebugCounterAbove7e3] +
+                            slot_counters[Translator::kDebugCounterNegative7e3];
+    if (out_of_range) {
+      entries.push_back({slot, out_of_range});
+    }
+  }
+  std::sort(entries.begin(), entries.end(),
+            [](const Entry& a, const Entry& b) { return a.out_of_range > b.out_of_range; });
+  if (!entries.empty()) {
+    REXGPU_INFO("XSC color range: {} pixel shaders wrote out-of-range colors in the last {} frames",
+                entries.size(), kXscDebugCounterLogFrames);
+  }
+  for (size_t i = 0; i < std::min(entries.size(), size_t(16)); ++i) {
+    const uint32_t* slot_counters = counters + entries[i].slot * Translator::kDebugCountersPerShader;
+    const Translator::DebugCounterShader& shader = shaders[entries[i].slot];
+    REXGPU_INFO(
+        "XSC color range: ps {:016X} modification {:016X}: non-finite {}, above 31.875 {}, "
+        "negative {}, of {} pixels on 7e3 render targets",
+        shader.ucode_data_hash, shader.modification, slot_counters[Translator::kDebugCounterNonFinite],
+        slot_counters[Translator::kDebugCounterAbove7e3],
+        slot_counters[Translator::kDebugCounterNegative7e3],
+        slot_counters[Translator::kDebugCounter7e3]);
+  }
+  std::memset(counters, 0, xsc_debug_counters_.length);
+}
+
+void MetalCommandProcessor::OnSubmissionCompletedByGpu(uint64_t submission) {
+  std::lock_guard<std::mutex> lock(guest_fence_mutex_);
+  submission_completed_by_gpu_ = std::max(submission_completed_by_gpu_, submission);
+  while (!pending_guest_fences_.empty() &&
+         pending_guest_fences_.front().submission <= submission_completed_by_gpu_) {
+    const PendingGuestFence& fence = pending_guest_fences_.front();
+    memory::store(memory_->TranslatePhysical(fence.address), fence.value);
+    pending_guest_fences_.pop_front();
+  }
+  const uint64_t* counters = static_cast<const uint64_t*>(occlusion_buffer_.contents);
+  while (!pending_occlusion_results_.empty() &&
+         pending_occlusion_results_.front().submission <= submission_completed_by_gpu_) {
+    const PendingOcclusionResult& result = pending_occlusion_results_.front();
+    uint64_t samples = 0;
+    for (uint32_t slot : result.slots) {
+      samples += counters[slot];
+    }
+    WriteGuestOcclusionResult(result.address, samples);
+    pending_occlusion_results_.pop_front();
+  }
+}
+
+bool MetalCommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(memory::RingBuffer* reader,
+                                                               uint32_t packet, uint32_t count) {
+  if (!REXCVAR_GET(occlusion_query_enable) || !occlusion_buffer_) {
+    StopCountingOcclusionSamples();
+    active_occlusion_query_ = ActiveOcclusionQuery();
+    return CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(reader, packet, count);
+  }
+  assert_true(count == 1);
+  uint32_t initiator = reader->ReadAndSwap<uint32_t>();
+  WriteRegister(XE_GPU_REG_VGT_EVENT_INITIATOR, initiator & 0x3F);
+
+  uint32_t address = register_file_->values[XE_GPU_REG_RB_SAMPLE_COUNT_ADDR];
+  auto* sample_counts = memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(address);
+  if (!sample_counts) {
+    StopCountingOcclusionSamples();
+    active_occlusion_query_ = ActiveOcclusionQuery();
+    return true;
+  }
+  // The packet comes at the begin and at the end of a query, each with sample counts of its own
+  // (the end's are 0x20 bytes before the begin's). The guest's driver marks the end by writing
+  // 0xFFFFFEED to its sample counts, and waits for the result to replace it; the begin's counts
+  // are zero, as nothing is counted before the begin.
+  const uint32_t kQueryFinished = rex::byte_swap(0xFFFFFEED);
+  bool is_end = sample_counts->ZPass_A == kQueryFinished ||
+                sample_counts->ZPass_B == kQueryFinished ||
+                sample_counts->ZFail_A == kQueryFinished || sample_counts->ZFail_B == kQueryFinished;
+  if (!is_end) {
+    // Begin. Another query still open is dropped: the guest has not ended it, so nothing waits for
+    // it.
+    StopCountingOcclusionSamples();
+    std::memset(sample_counts, 0, sizeof(*sample_counts));
+    active_occlusion_query_ = ActiveOcclusionQuery();
+    active_occlusion_query_.valid = true;
+    active_occlusion_query_.address = address;
+    return true;
+  }
+  if (!active_occlusion_query_.valid) {
+    // An end without its begin: nothing was counted.
+    WriteGuestOcclusionResult(address, 0);
+    return true;
+  }
+  StopCountingOcclusionSamples();
+  PendingOcclusionResult result;
+  result.address = address;
+  result.slots = std::move(active_occlusion_query_.slots);
+  active_occlusion_query_ = ActiveOcclusionQuery();
+  if (result.slots.empty()) {
+    // No draw between the begin and the end.
+    std::lock_guard<std::mutex> lock(guest_fence_mutex_);
+    for (auto it = pending_occlusion_results_.begin(); it != pending_occlusion_results_.end();) {
+      it = it->address == address ? pending_occlusion_results_.erase(it) : std::next(it);
+    }
+    WriteGuestOcclusionResult(address, 0);
+    return true;
+  }
+  // The counted draws are in the open submission, or in the last one if none is open.
+  result.submission = submission_open_ ? submission_current_ : submission_current_ - 1;
+  std::lock_guard<std::mutex> lock(guest_fence_mutex_);
+  // An earlier result of the same query not written yet would overwrite this end's marker late.
+  for (auto it = pending_occlusion_results_.begin(); it != pending_occlusion_results_.end();) {
+    it = it->address == address ? pending_occlusion_results_.erase(it) : std::next(it);
+  }
+  if (submission_completed_by_gpu_ >= result.submission) {
+    const uint64_t* counters = static_cast<const uint64_t*>(occlusion_buffer_.contents);
+    uint64_t samples = 0;
+    for (uint32_t slot : result.slots) {
+      samples += counters[slot];
+    }
+    WriteGuestOcclusionResult(address, samples);
+    return true;
+  }
+  pending_occlusion_results_.push_back(std::move(result));
+  return true;
+}
+
+void MetalCommandProcessor::CountOcclusionSamples() {
+  if (!active_occlusion_query_.valid || encoder_type_ != EncoderType::kRender ||
+      render_encoder_state_.occlusion_slot != UINT32_MAX) {
+    return;
+  }
+  // A slot of its own for each encoder, so every count the GPU writes is of one render pass.
+  uint32_t slot = occlusion_slot_next_;
+  occlusion_slot_next_ = (occlusion_slot_next_ + 1) % kOcclusionSlotCount;
+  // The slot was last used kOcclusionSlotCount slots ago, by work long completed.
+  static_cast<uint64_t*>(occlusion_buffer_.contents)[slot] = 0;
+  [render_encoder_ setVisibilityResultMode:MTLVisibilityResultModeCounting
+                                    offset:sizeof(uint64_t) * slot];
+  render_encoder_state_.occlusion_slot = slot;
+  active_occlusion_query_.slots.push_back(slot);
+}
+
+void MetalCommandProcessor::StopCountingOcclusionSamples() {
+  if (encoder_type_ == EncoderType::kRender &&
+      render_encoder_state_.occlusion_slot != UINT32_MAX) {
+    [render_encoder_ setVisibilityResultMode:MTLVisibilityResultModeDisabled offset:0];
+  }
+  render_encoder_state_.occlusion_slot = UINT32_MAX;
+}
+
+void MetalCommandProcessor::WriteGuestOcclusionResult(uint32_t address, uint64_t samples) {
+  auto* sample_counts = memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(address);
+  if (!sample_counts) {
+    return;
+  }
+  // Render targets at a draw resolution scale have that many more samples than the guest's (2.25
+  // times at 3/2).
+  DrawResolutionScale draw_resolution_scale = render_target_cache_->draw_resolution_scale();
+  uint64_t scale_numerator =
+      uint64_t(draw_resolution_scale.numerator_x) * draw_resolution_scale.numerator_y;
+  uint64_t scale_denominator =
+      uint64_t(draw_resolution_scale.denominator) * draw_resolution_scale.denominator;
+  if (scale_numerator > scale_denominator) {
+    samples = (samples * scale_denominator + scale_numerator / 2) / scale_numerator;
+  }
+  uint32_t clamped = uint32_t(std::min(samples, uint64_t(UINT32_MAX)));
+  PERF_counter_inc(kOcclusionQueries);
+  if (!clamped) {
+    PERF_counter_inc(kOcclusionQueriesZero);
+  }
+  std::memset(sample_counts, 0, sizeof(*sample_counts));
+  sample_counts->Total_A = clamped;
+  sample_counts->ZPass_A = clamped;
+}
+
+void MetalCommandProcessor::WriteGuestFence(uint32_t address, uint32_t value) {
+  if (!accurate_fences_) {
+    CommandProcessor::WriteGuestFence(address, value);
+    return;
+  }
+  // Send the work before the fence to the GPU, so the fence doesn't wait for the rest of the
+  // frame, and write it when the last submission with that work completes.
+  if (submission_open_ && submission_has_work_) {
+    EndSubmission(false);
+  }
+  uint64_t submission = submission_current_ - 1;
+  std::lock_guard<std::mutex> lock(guest_fence_mutex_);
+  if (submission_completed_by_gpu_ >= submission) {
+    memory::store(memory_->TranslatePhysical(address), value);
+    return;
+  }
+  pending_guest_fences_.push_back({submission, address, value});
+}
