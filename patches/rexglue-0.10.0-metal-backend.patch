+MTLPixelFormat MetalRenderTargetCache::GetDepthMetalFormat(
+    xenos::DepthRenderTargetFormat format) const {
+  // Apple GPUs have no 24-bit depth.
+  (void)format;
+  return MTLPixelFormatDepth32Float_Stencil8;
+}
