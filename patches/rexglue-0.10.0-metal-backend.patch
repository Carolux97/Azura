+MetalCommandProcessor::UploadAllocation MetalCommandProcessor::RequestUpload(size_t size,
+                                                                             size_t alignment) {
+  UploadAllocation allocation;
+  allocation.buffer = upload_buffer_pool_->Request(GetCurrentSubmission(), GetCompletedSubmission(),
+                                                   std::max(size, size_t(16)), alignment,
+                                                   allocation.offset);
+  if (allocation.buffer) {
+    allocation.mapping = static_cast<uint8_t*>(allocation.buffer.contents) + allocation.offset;
+  }
+  return allocation;
+}
+
+bool MetalCommandProcessor::GetGuestClearLoadActions(reg::RB_DEPTHCONTROL normalized_depth_control,
+                                                     std::vector<PendingClear>& clears_out) const {
+  (void)normalized_depth_control;
+  if (!REXCVAR_GET(hle_clear_load_actions) || !hle::InWholeSurfaceClear()) {
+    return false;
+  }
+  // Only a draw that writes every target it uses completely (the transfers into them were skipped
+  // for the same reason) can become load actions.
+  uint32_t overwritten = render_target_cache_->last_update_overwritten_by_clear();
+  if (!overwritten) {
+    return false;
+  }
+  const RegisterFile& regs = *register_file_;
+  size_t first = clears_out.size();
+  auto fail = [&clears_out, first] {
+    clears_out.resize(first);
+    return false;
+  };
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    id<MTLTexture> texture = render_target_cache_->GetLastUpdateUsedTexture(i);
+    if (!texture) {
+      continue;
+    }
+    if (!(overwritten & (uint32_t(1) << i))) {
+      return fail();
+    }
+    PendingClear clear;
+    clear.texture = texture;
+    if (i == 0) {
+      // Host depth is 32-bit float: it holds any 24-bit fixed-point depth the clear writes, and
+      // the 0 and 1 of 24-bit floating-point depth exactly (other values would need the guest's
+      // rounding).
+      // What the clear's vertices write (its depth argument may go through the viewport's depth
+      // transform first).
+      float depth = render_target_cache_->last_update_clear_vertex_depth();
+      if (!(depth >= 0.0f && depth <= 1.0f) ||
+          (regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8 &&
+           depth != 0.0f && depth != 1.0f)) {
+        return fail();
+      }
+      clear.is_depth = true;
+      clear.depth = depth;
+      // The clear replaces the stencil with the reference value.
+      clear.stencil = regs.Get<reg::RB_STENCILREFMASK>().stencilref;
+    } else {
+      const float* color = hle::ClearColor();
+      bool zero = color[0] == 0.0f && color[1] == 0.0f && color[2] == 0.0f && color[3] == 0.0f;
+      switch (regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i - 1])
+                  .color_format) {
+        // Host formats that store what the pixel shader writes as is.
+        case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+        case xenos::ColorRenderTargetFormat::k_16_16_FLOAT:
+        case xenos::ColorRenderTargetFormat::k_16_16_16_16_FLOAT:
+        case xenos::ColorRenderTargetFormat::k_32_FLOAT:
+        case xenos::ColorRenderTargetFormat::k_32_32_FLOAT:
+          break;
+        // Signed normalized on the host with a scale (-32 to 32 in -1 to 1, unless
+        // snorm16_render_target_full_range): only 0 is the same value in both.
+        case xenos::ColorRenderTargetFormat::k_16_16:
+        case xenos::ColorRenderTargetFormat::k_16_16_16_16:
+          if (!zero) {
+            return fail();
+          }
+          break;
+        // Gamma and the 2_10_10_10 formats go through conversions in the pixel shader.
+        default:
+          return fail();
+      }
+      clear.color = MTLClearColorMake(color[0], color[1], color[2], color[3]);
+    }
+    clears_out.push_back(clear);
+  }
+  return clears_out.size() > first;
+}
+
+bool MetalCommandProcessor::DeferGuestClear(const MetalRenderPass& render_pass,
+                                            reg::RB_DEPTHCONTROL normalized_depth_control) {
+  if (REXCVAR_GET(hle_verify_clears)) {
+    // Draw as before; VerifyGuestClears checks the result against these after the draw.
+    clears_to_verify_.clear();
+    GetGuestClearLoadActions(normalized_depth_control, clears_to_verify_);
+    return false;
+  }
+  size_t first = pending_clears_.size();
+  if (!GetGuestClearLoadActions(normalized_depth_control, pending_clears_)) {
+    return false;
+  }
+  // In the middle of a render pass on the same targets, the draw keeps the pass going: a load
+  // action would need a new pass.
+  if (encoder_type_ == EncoderType::kRender && current_render_pass_ == render_pass) {
+    pending_clears_.resize(first);
+    return false;
+  }
+  // An open pass with any of these textures ends here (as before, since this draw needed another
+  // pass), so that the next pass on them starts with the clear.
+  if (encoder_type_ == EncoderType::kRender) {
+    for (size_t i = first; i < pending_clears_.size(); ++i) {
+      id<MTLTexture> texture = pending_clears_[i].texture;
+      bool attached = current_render_pass_.depth_stencil == texture;
+      for (id<MTLTexture> color : current_render_pass_.color) {
+        attached |= color == texture;
+      }
+      if (attached) {
+        EndEncoder(rex::perf::CounterId::kRenderPassEndsTargetChange);
+        break;
+      }
+    }
+  }
+  // A newer clear of a texture replaces its pending one.
+  for (size_t i = first; i < pending_clears_.size(); ++i) {
+    for (size_t j = 0; j < first; ++j) {
+      if (pending_clears_[j].texture == pending_clears_[i].texture) {
+        pending_clears_[j].texture = nil;
+      }
+    }
+  }
+  pending_clears_.erase(std::remove_if(pending_clears_.begin(), pending_clears_.end(),
+                                       [](const PendingClear& clear) { return !clear.texture; }),
+                        pending_clears_.end());
+  PERF_counter_inc(kClearsAsLoadActions);
+  return true;
+}
+
+void MetalCommandProcessor::ApplyPendingClears(rex::perf::CounterId end_reason) {
+  if (pending_clears_.empty()) {
+    return;
+  }
+  EndEncoder(end_reason);
+  for (const PendingClear& clear : pending_clears_) {
+    MTLRenderPassDescriptor* descriptor = [MTLRenderPassDescriptor renderPassDescriptor];
+    if (clear.is_depth) {
+      descriptor.depthAttachment.texture = clear.texture;
+      descriptor.depthAttachment.loadAction = MTLLoadActionClear;
+      descriptor.depthAttachment.storeAction = MTLStoreActionStore;
+      descriptor.depthAttachment.clearDepth = clear.depth;
+      descriptor.stencilAttachment.texture = clear.texture;
+      descriptor.stencilAttachment.loadAction = MTLLoadActionClear;
+      descriptor.stencilAttachment.storeAction = MTLStoreActionStore;
+      descriptor.stencilAttachment.clearStencil = clear.stencil;
+    } else {
+      descriptor.colorAttachments[0].texture = clear.texture;
+      descriptor.colorAttachments[0].loadAction = MTLLoadActionClear;
+      descriptor.colorAttachments[0].storeAction = MTLStoreActionStore;
+      descriptor.colorAttachments[0].clearColor = clear.color;
+    }
+    descriptor.renderTargetWidth = clear.texture.width;
+    descriptor.renderTargetHeight = clear.texture.height;
+    id<MTLRenderCommandEncoder> encoder =
+        [command_buffer_ renderCommandEncoderWithDescriptor:descriptor];
+    encoder.label = @"Guest clear";
+    [encoder endEncoding];
+    PERF_counter_inc(kHostRenderPasses);
+#ifdef REXGLUE_ENABLE_PERF_COUNTERS
+    rex::perf::IncrementCounter(end_reason);
+#endif
+  }
+  submission_has_work_ = true;
+  pending_clears_.clear();
+}
+
+namespace {
+
+// Bytes of one texel of the render target formats a guest clear can become a load action of.
+size_t ClearVerifyTexelBytes(MTLPixelFormat format) {
+  switch (format) {
+    case MTLPixelFormatRGBA8Unorm:
+    case MTLPixelFormatRG16Float:
+    case MTLPixelFormatR32Float:
+    case MTLPixelFormatRG16Snorm:
+      return 4;
+    case MTLPixelFormatRGBA16Float:
+    case MTLPixelFormatRG32Float:
+    case MTLPixelFormatRGBA16Snorm:
+      return 8;
+    default:
+      return 0;
+  }
+}
+
+}  // namespace
+
+void MetalCommandProcessor::VerifyGuestClears() {
+  std::vector<PendingClear> clears;
+  clears.swap(clears_to_verify_);
+  EndEncoder(rex::perf::CounterId::kRenderPassEndsOther);
+  // Per clear, the first texel of the target (what the draw wrote) and of a 1x1 texture of the
+  // same format cleared with the load action's values, in 16-byte slots; depth and stencil
+  // separately.
+  struct Check {
+    std::string what;
+    size_t actual;
+    size_t expected;
+    size_t size;
+  };
+  constexpr size_t kSlot = 16;
+  std::vector<Check> checks;
+  size_t slots = 0;
+  for (const PendingClear& clear : clears) {
+    slots += (clear.is_depth ? 4 : 2) * 2;
+  }
+  id<MTLBuffer> readback = [device_ newBufferWithLength:std::max(slots, size_t(1)) * kSlot
+                                                options:MTLResourceStorageModeShared];
+  size_t slot = 0;
+  for (const PendingClear& clear : clears) {
+    MTLPixelFormat format = clear.texture.pixelFormat;
+    id<MTLTexture> expected = clear_verify_textures_[NSUInteger(format)];
+    if (!expected) {
+      MTLTextureDescriptor* texture_descriptor =
+          [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:format
+                                                             width:1
+                                                            height:1
+                                                         mipmapped:NO];
+      texture_descriptor.usage = MTLTextureUsageRenderTarget;
+      texture_descriptor.storageMode = MTLStorageModePrivate;
+      expected = [device_ newTextureWithDescriptor:texture_descriptor];
+      clear_verify_textures_[NSUInteger(format)] = expected;
+    }
+    MTLRenderPassDescriptor* descriptor = [MTLRenderPassDescriptor renderPassDescriptor];
+    if (clear.is_depth) {
+      descriptor.depthAttachment.texture = expected;
+      descriptor.depthAttachment.loadAction = MTLLoadActionClear;
+      descriptor.depthAttachment.storeAction = MTLStoreActionStore;
+      descriptor.depthAttachment.clearDepth = clear.depth;
+      descriptor.stencilAttachment.texture = expected;
+      descriptor.stencilAttachment.loadAction = MTLLoadActionClear;
+      descriptor.stencilAttachment.storeAction = MTLStoreActionStore;
+      descriptor.stencilAttachment.clearStencil = clear.stencil;
+    } else {
+      descriptor.colorAttachments[0].texture = expected;
+      descriptor.colorAttachments[0].loadAction = MTLLoadActionClear;
+      descriptor.colorAttachments[0].storeAction = MTLStoreActionStore;
+      descriptor.colorAttachments[0].clearColor = clear.color;
+    }
+    [[command_buffer_ renderCommandEncoderWithDescriptor:descriptor] endEncoding];
+    id<MTLBlitCommandEncoder> blit = [command_buffer_ blitCommandEncoder];
+    // The texel in the top left corner and one inside the surface.
+    for (uint32_t texel : {0u, 8u}) {
+    auto copy = [&](id<MTLTexture> texture, size_t bytes, MTLBlitOption options) {
+      uint32_t at = texture == expected ? 0 : texel;
+      [blit copyFromTexture:texture
+                       sourceSlice:0
+                       sourceLevel:0
+                      sourceOrigin:MTLOriginMake(at, at, 0)
+                        sourceSize:MTLSizeMake(1, 1, 1)
+                          toBuffer:readback
+                 destinationOffset:slot * kSlot
+            destinationBytesPerRow:bytes
+          destinationBytesPerImage:bytes
+                           options:options];
+      return slot++ * kSlot;
+    };
+    if (clear.is_depth) {
+      size_t actual = copy(clear.texture, 4, MTLBlitOptionDepthFromDepthStencil);
+      checks.push_back({fmt::format("texel {} depth {} (argument {})", texel, clear.depth,
+                                    hle::ClearDepth()),
+                        actual,
+                        copy(expected, 4, MTLBlitOptionDepthFromDepthStencil), 4});
+      actual = copy(clear.texture, 1, MTLBlitOptionStencilFromDepthStencil);
+      checks.push_back({fmt::format("texel {} stencil {}", texel, clear.stencil), actual,
+                        copy(expected, 1, MTLBlitOptionStencilFromDepthStencil), 1});
+    } else if (size_t bytes = ClearVerifyTexelBytes(format)) {
+      size_t actual = copy(clear.texture, bytes, MTLBlitOptionNone);
+      checks.push_back({fmt::format("texel {} color format {} ({} {} {} {})", texel, uint32_t(format),
+                                    clear.color.red, clear.color.green, clear.color.blue,
+                                    clear.color.alpha),
+                        actual, copy(expected, bytes, MTLBlitOptionNone), bytes});
+    }
+    }
+    [blit endEncoding];
+  }
+  submission_has_work_ = true;
+  [command_buffer_ addCompletedHandler:^(id<MTLCommandBuffer>) {
+    const uint8_t* data = static_cast<const uint8_t*>(readback.contents);
+    static std::mutex mutex;
+    static std::set<std::string> logged;
+    std::lock_guard<std::mutex> lock(mutex);
+    for (const Check& check : checks) {
+      bool match = !std::memcmp(data + check.actual, data + check.expected, check.size);
+      std::string bytes;
+      for (size_t i = 0; i < check.size; ++i) {
+        bytes += fmt::format("{:02X}", data[check.actual + i]);
+      }
+      std::string expected_bytes;
+      for (size_t i = 0; i < check.size; ++i) {
+        expected_bytes += fmt::format("{:02X}", data[check.expected + i]);
+      }
+      if (logged.insert(fmt::format("{} {}", match, check.what)).second) {
+        if (match) {
+          REXGPU_INFO("HLE clear check: {} matches the draw ({})", check.what, bytes);
+        } else {
+          REXGPU_WARN("HLE clear check: {} differs: the draw wrote {}, the load action {}",
+                      check.what, bytes, expected_bytes);
+        }
+      }
+    }
+  }];
+}
+
+bool MetalCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                                      IndexBufferInfo* index_buffer_info,
+                                      bool major_mode_explicit) {
+  (void)prim_type;
+  (void)index_count;
+  (void)index_buffer_info;
+  (void)major_mode_explicit;
+  const RegisterFile& regs = *register_file_;
+
+  xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode == xenos::EdramMode::kCopy) {
+    // Special copy handling.
+    return IssueCopy();
+  }
+
+  bool surface_pitch_is_zero = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch == 0;
+
+  memexport_ranges_.clear();
+
+  // Vertex shader analysis.
+  auto vertex_shader = static_cast<MetalShader*>(active_vertex_shader());
+  if (!vertex_shader) {
+    // Always need a vertex shader.
+    return false;
+  }
+  pipeline_cache_->AnalyzeShaderUcode(*vertex_shader);
+  bool memexport_used_vertex = vertex_shader->memexport_eM_written() != 0;
+  if (memexport_used_vertex) {
+    draw_util::AddMemExportRanges(regs, *vertex_shader, memexport_ranges_);
+  }
+
+  // Pixel shader analysis.
+  bool primitive_polygonal = draw_util::IsPrimitivePolygonal(regs);
+  bool is_rasterization_done = draw_util::IsRasterizationPotentiallyDone(regs, primitive_polygonal);
+  if (surface_pitch_is_zero && is_rasterization_done) {
+    // Doesn't actually draw.
+    return true;
+  }
+  MetalShader* pixel_shader = nullptr;
+  if (is_rasterization_done) {
+    // See xenos::EdramMode for explanation why the pixel shader is only used when it's
+    // kColorDepth here.
+    if (edram_mode == xenos::EdramMode::kColorDepth) {
+      pixel_shader = static_cast<MetalShader*>(active_pixel_shader());
+      if (pixel_shader) {
+        pipeline_cache_->AnalyzeShaderUcode(*pixel_shader);
+        if (!draw_util::IsPixelShaderNeededWithRasterization(*pixel_shader, regs)) {
+          pixel_shader = nullptr;
+        }
+      }
+    }
+  } else {
+    if (!memexport_used_vertex) {
+      // This draw has no effect.
+      return true;
+    }
+  }
+  bool memexport_used_pixel = pixel_shader && (pixel_shader->memexport_eM_written() != 0);
+  if (memexport_used_pixel) {
+    draw_util::AddMemExportRanges(regs, *pixel_shader, memexport_ranges_);
+  }
+  bool memexport_writes_possible = memexport_used_vertex || memexport_used_pixel;
+  reg::RB_DEPTHCONTROL normalized_depth_control = draw_util::GetNormalizedDepthControl(regs);
+
+  uint32_t ps_param_gen_pos = UINT32_MAX;
+  uint32_t interpolator_mask =
+      pixel_shader ? (vertex_shader->writes_interpolators() &
+                      pixel_shader->GetInterpolatorInputMask(regs.Get<reg::SQ_PROGRAM_CNTL>(),
+                                                             regs.Get<reg::SQ_CONTEXT_MISC>(),
+                                                             ps_param_gen_pos))
+                   : 0;
+
+  if (!BeginSubmission(true)) {
+    return false;
+  }
+
+  // Process primitives.
+  PrimitiveProcessor::ProcessingResult primitive_processing_result;
+  if (!primitive_processor_->Process(primitive_processing_result)) {
+    return false;
+  }
+  if (!primitive_processing_result.host_draw_vertex_count) {
+    // Nothing to draw.
+    return true;
+  }
+  Shader::HostVertexShaderType host_vertex_shader_type =
+      primitive_processing_result.host_vertex_shader_type;
+  if (host_vertex_shader_type != Shader::HostVertexShaderType::kVertex &&
+      host_vertex_shader_type != Shader::HostVertexShaderType::kPointListAsTriangleStrip &&
+      host_vertex_shader_type != Shader::HostVertexShaderType::kRectangleListAsTriangleStrip) {
+    // Tessellation needs domain shaders, which the Metal backend doesn't have yet.
+    static bool tessellation_logged = false;
+    if (!tessellation_logged) {
+      tessellation_logged = true;
+      REXGPU_WARN("Metal: host vertex shader type {} is not supported, skipping such draws",
+                  uint32_t(host_vertex_shader_type));
+    }
+    return true;
+  }
+
+  // Shader modifications and translations.
+  SpirvShaderTranslator::Modification vertex_shader_modification =
+      pipeline_cache_->GetCurrentVertexShaderModification(
+          *vertex_shader, host_vertex_shader_type, interpolator_mask,
+          ps_param_gen_pos != UINT32_MAX);
+  SpirvShaderTranslator::Modification pixel_shader_modification =
+      pixel_shader ? pipeline_cache_->GetCurrentPixelShaderModification(
+                         *pixel_shader, interpolator_mask, ps_param_gen_pos,
+                         normalized_depth_control)
+                   : SpirvShaderTranslator::Modification(0);
+  auto vertex_shader_translation = static_cast<MetalShader::MetalTranslation*>(
+      vertex_shader->GetOrCreateTranslation(vertex_shader_modification.value));
+  auto pixel_shader_translation =
+      pixel_shader ? static_cast<MetalShader::MetalTranslation*>(
+                         pixel_shader->GetOrCreateTranslation(pixel_shader_modification.value))
+                   : nullptr;
+  // With async_shader_compilation, a draw whose shaders or pipeline are not ready yet is skipped
+  // while the creation threads make them, unless skipping would lose side effects (memexport) or
+  // it has no pixel shader (depth-only draws whose absence would show).
+  bool pipeline_async = REXCVAR_GET(async_shader_compilation) && pixel_shader != nullptr &&
+                        !memexport_writes_possible;
+  bool shaders_pending = false;
+  {
+    ScopedCounterMicroseconds timer(rex::perf::CounterId::kDrawShaderTranslationUs);
+    if (!pipeline_cache_->PrepareShadersForDraw(vertex_shader_translation,
+                                                pixel_shader_translation, pipeline_async,
+                                                shaders_pending)) {
+      return false;
+    }
+  }
+
+  uint32_t normalized_color_mask =
+      pixel_shader ? draw_util::GetNormalizedColorMask(regs, pixel_shader->writes_color_targets())
+                   : 0;
+
+  if (shaders_pending) {
+    // Skipped like a draw whose pipeline is pending, after the render targets are set up as that
+    // one would be. Its textures, which need the translation, are not requested.
+    if (!render_target_cache_->Update(is_rasterization_done, normalized_depth_control,
+                                      normalized_color_mask, *vertex_shader)) {
+      return false;
+    }
+    PERF_counter_inc(kDrawsSkippedForPipelines);
+    return true;
+  }
+
+  // Load the textures before the render pass is entered (may dispatch and copy).
+  uint32_t used_texture_mask =
+      vertex_shader->GetUsedTextureMaskAfterTranslation() |
+      (pixel_shader != nullptr ? pixel_shader->GetUsedTextureMaskAfterTranslation() : 0);
+  {
+    ScopedCounterMicroseconds timer(rex::perf::CounterId::kDrawTextureLoadUs);
+    texture_cache_->RequestTextures(used_texture_mask);
+  }
+
+  // Set up the render targets - this may perform transfers.
+  if (!render_target_cache_->Update(is_rasterization_done, normalized_depth_control,
+                                    normalized_color_mask, *vertex_shader)) {
+    return false;
+  }
+  const MetalRenderPass& render_pass = render_target_cache_->last_update_render_pass();
+
+  // gfx = hle: the guest's clear of whole surfaces becomes the load action of the next render pass
+  // on its targets instead of this full-screen draw.
+  if (DeferGuestClear(render_pass, normalized_depth_control)) {
+    return true;
+  }
+
+  // Create the pipeline, or skip the draw while it is made (pipeline_async above).
+  id<MTLRenderPipelineState> pipeline;
+  MetalDrawState draw_state;
+  bool pipeline_pending = false;
+  {
+    ScopedCounterMicroseconds timer(rex::perf::CounterId::kDrawPipelineUs);
+    if (!pipeline_cache_->ConfigurePipeline(
+            vertex_shader_translation, pixel_shader_translation, primitive_processing_result,
+            normalized_depth_control, normalized_color_mask,
+            render_target_cache_->last_update_render_pass_formats(), pipeline_async, pipeline,
+            draw_state, pipeline_pending)) {
+      return false;
+    }
+  }
+  if (pipeline_pending) {
+    PERF_counter_inc(kDrawsSkippedForPipelines);
+    // A clear skipped this way wrote nothing to compare.
+    clears_to_verify_.clear();
+    return true;
+  }
+
+  // Ensure the vertex buffers and the memory export destinations are resident (with the shared
+  // memory over the guest memory, this keeps the invalidation watches up to date).
+  const Shader::ConstantRegisterMap& constant_map_vertex = vertex_shader->constant_register_map();
+  for (uint32_t i = 0; i < rex::countof(constant_map_vertex.vertex_fetch_bitmap); ++i) {
+    uint32_t vfetch_bits_remaining = constant_map_vertex.vertex_fetch_bitmap[i];
+    uint32_t j;
+    while (rex::bit_scan_forward(vfetch_bits_remaining, &j)) {
+      vfetch_bits_remaining &= ~(uint32_t(1) << j);
+      uint32_t vfetch_index = i * 32 + j;
+      xenos::xe_gpu_vertex_fetch_t vfetch_constant = regs.GetVertexFetch(vfetch_index);
+      switch (vfetch_constant.type) {
+        case xenos::FetchConstantType::kVertex:
+          break;
+        case xenos::FetchConstantType::kInvalidVertex:
+          if (REXCVAR_GET(gpu_allow_invalid_fetch_constants)) {
+            break;
+          }
+          REXGPU_WARN("Vertex fetch constant {} ({:08X} {:08X}) has \"invalid\" type!",
+                      vfetch_index, vfetch_constant.dword_0, vfetch_constant.dword_1);
+          return false;
+        default:
+          REXGPU_WARN("Vertex fetch constant {} ({:08X} {:08X}) is completely invalid!",
+                      vfetch_index, vfetch_constant.dword_0, vfetch_constant.dword_1);
+          return false;
+      }
+      if (!shared_memory_->RequestRange(vfetch_constant.address << 2, vfetch_constant.size << 2)) {
+        REXGPU_ERROR("Failed to request vertex buffer at 0x{:08X} (size {}) in the shared memory",
+                     vfetch_constant.address << 2, vfetch_constant.size << 2);
+        return false;
+      }
+    }
+  }
+  for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+    if (!shared_memory_->RequestRange(memexport_range.base_address_dwords << 2,
+                                      memexport_range.size_bytes)) {
+      REXGPU_ERROR("Failed to request memexport stream at 0x{:08X} (size {}) in the shared memory",
+                   memexport_range.base_address_dwords << 2, memexport_range.size_bytes);
+      return false;
+    }
+  }
+
+  // Enter the render pass.
+  id<MTLRenderCommandEncoder> encoder =
+      BeginRenderPass(render_pass, rex::perf::CounterId::kRenderPassEndsTargetChange);
+  if (encoder.label == nil) {
+    encoder.label = GetGuestDrawsLabel(render_pass);
+  } else if ([encoder.label
+                 isEqualToString:GetEncoderLabel(rex::perf::CounterId::kRenderPassEndsTransfer)]) {
+    // The draw could continue the pass a render target transfer began (same targets), and then
+    // GPU traces would count its time as a transfer. With gpu_debug_markers it gets a pass of its
+    // own instead, so traces count it as a draw.
+    PERF_counter_inc(kDrawsInTransferPasses);
+    if (REXCVAR_GET(gpu_debug_markers)) {
+      EndEncoder(rex::perf::CounterId::kRenderPassEndsOther);
+      encoder = BeginRenderPass(render_pass, rex::perf::CounterId::kRenderPassEndsTargetChange);
+      encoder.label = GetGuestDrawsLabel(render_pass);
+    }
+  }
+
+  // Viewport, scissor and the rest of the dynamic state, in host pixels: with sample-space render
+  // targets, a multisampled guest surface has a host pixel per sample.
+  xenos::MsaaSamples guest_msaa_samples = regs.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+  DrawResolutionScale host_pixel_scale = render_target_cache_->draw_resolution_scale().ShiftedBy(
+      render_target_cache_->GetSampleSpaceXLog2(guest_msaa_samples),
+      render_target_cache_->GetSampleSpaceYLog2(guest_msaa_samples));
+  draw_util::ViewportInfo viewport_info;
+  draw_util::GetHostViewportInfo(regs, host_pixel_scale, false, 16384, 16384, true,
+                                 normalized_depth_control,
+                                 render_target_cache_->depth_float24_convert_in_pixel_shader(),
+                                 true, pixel_shader && pixel_shader->writes_depth(),
+                                 viewport_info);
+  if (!render_encoder_state_.valid) {
+    render_encoder_state_ = RenderEncoderState();
+  }
+  UpdateDynamicState(encoder, viewport_info, primitive_polygonal, normalized_depth_control,
+                     render_pass);
+
+  // Pipeline and fixed-function state.
+  if (render_encoder_state_.pipeline != pipeline || !render_encoder_state_.valid) {
+    [encoder setRenderPipelineState:pipeline];
+    render_encoder_state_.pipeline = pipeline;
+  }
+  if (draw_state.depth_stencil_state &&
+      (render_encoder_state_.depth_stencil_state != draw_state.depth_stencil_state ||
+       !render_encoder_state_.valid)) {
+    [encoder setDepthStencilState:draw_state.depth_stencil_state];
+    render_encoder_state_.depth_stencil_state = draw_state.depth_stencil_state;
+  }
+  if (render_encoder_state_.cull_mode != draw_state.cull_mode || !render_encoder_state_.valid) {
+    [encoder setCullMode:draw_state.cull_mode];
+    render_encoder_state_.cull_mode = draw_state.cull_mode;
+  }
+  if (render_encoder_state_.winding != draw_state.winding || !render_encoder_state_.valid) {
+    [encoder setFrontFacingWinding:draw_state.winding];
+    render_encoder_state_.winding = draw_state.winding;
+  }
+  if (render_encoder_state_.fill_mode != draw_state.fill_mode || !render_encoder_state_.valid) {
+    [encoder setTriangleFillMode:draw_state.fill_mode];
+    render_encoder_state_.fill_mode = draw_state.fill_mode;
+  }
+  if (render_encoder_state_.depth_clip_mode != draw_state.depth_clip_mode ||
+      !render_encoder_state_.valid) {
+    [encoder setDepthClipMode:draw_state.depth_clip_mode];
+    render_encoder_state_.depth_clip_mode = draw_state.depth_clip_mode;
+  }
+
+  // Constants, textures and samplers.
+  UpdateSystemConstantValues(primitive_polygonal, primitive_processing_result, viewport_info,
+                             used_texture_mask, normalized_depth_control, normalized_color_mask);
+  if (!UpdateBindings(encoder, vertex_shader, pixel_shader, vertex_shader_translation,
+                      pixel_shader_translation)) {
+    return false;
+  }
+  render_encoder_state_.valid = true;
+
+  // The draw's samples count for the active occlusion query, if any.
+  CountOcclusionSamples();
+
+  // Draw.
+  PROFILE_DRAW_CALL();
+  PROFILE_VERTICES(primitive_processing_result.host_draw_vertex_count);
+  PERF_counter_inc(kHostDraws);
+  if (pixel_shader) {
+    if (pixel_shader_modification.pixel.depth_stencil_mode ==
+        SpirvShaderTranslator::Modification::DepthStencilMode::kEarlyHint) {
+      PERF_counter_inc(kHostDrawsEarlyDepth);
+    }
+    if ((normalized_color_mask & 0b1111) &&
+        draw_util::DoesCoverageDependOnAlpha(regs.Get<reg::RB_COLORCONTROL>())) {
+      PERF_counter_inc(kHostDrawsAlphaTested);
+    }
+    if (pixel_shader->kills_pixels()) {
+      PERF_counter_inc(kHostDrawsShaderKill);
+    }
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (!((normalized_color_mask >> (4 * i)) & 0b1111)) {
+        continue;
+      }
+      auto blend_control =
+          regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+      if (blend_control.color_srcblend != xenos::BlendFactor::kOne ||
+          blend_control.color_destblend != xenos::BlendFactor::kZero ||
+          blend_control.color_comb_fcn != xenos::BlendOp::kAdd ||
+          blend_control.alpha_srcblend != xenos::BlendFactor::kOne ||
+          blend_control.alpha_destblend != xenos::BlendFactor::kZero ||
+          blend_control.alpha_comb_fcn != xenos::BlendOp::kAdd) {
+        PERF_counter_inc(kHostDrawsBlended);
+        break;
+      }
+    }
+  }
+  if (primitive_processing_result.index_buffer_type ==
+      PrimitiveProcessor::ProcessedIndexBufferType::kNone) {
+    [encoder drawPrimitives:draw_state.primitive_type
+                vertexStart:0
+                vertexCount:primitive_processing_result.host_draw_vertex_count];
+  } else {
+    std::pair<id<MTLBuffer>, size_t> index_buffer;
+    switch (primitive_processing_result.index_buffer_type) {
+      case PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA:
+        index_buffer.first = shared_memory_->buffer();
+        index_buffer.second = primitive_processing_result.guest_index_base;
+        break;
+      case PrimitiveProcessor::ProcessedIndexBufferType::kHostConverted:
+        index_buffer = primitive_processor_->GetConvertedIndexBuffer(
+            primitive_processing_result.host_index_buffer_handle);
+        break;
+      case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForAuto:
+      case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForDMA:
+        index_buffer = primitive_processor_->GetBuiltinIndexBuffer(
+            primitive_processing_result.host_index_buffer_handle);
+        break;
+      default:
+        assert_unhandled_case(primitive_processing_result.index_buffer_type);
+        return false;
+    }
+    [encoder drawIndexedPrimitives:draw_state.primitive_type
+                        indexCount:primitive_processing_result.host_draw_vertex_count
+                         indexType:primitive_processing_result.host_index_format ==
+                                           xenos::IndexFormat::kInt16
+                                       ? MTLIndexTypeUInt16
+                                       : MTLIndexTypeUInt32
+                       indexBuffer:index_buffer.first
+                 indexBufferOffset:index_buffer.second];
+  }
+
+  if (!clears_to_verify_.empty()) {
+    VerifyGuestClears();
+  }
+
+  if (pixel_history_state_ == PixelHistoryState::kRecording) {
+    RecordPixelHistory(render_pass, vertex_shader, pixel_shader, normalized_color_mask);
+  }
+
+  // Invalidate textures in memexported memory and watch for changes.
+  if (!memexport_ranges_.empty()) {
+    for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+      shared_memory_->RangeWrittenByGpu(memexport_range.base_address_dwords << 2,
+                                        memexport_range.size_bytes);
+    }
+  } else if (memexport_writes_possible) {
+    // Stream constants can be invalid or dynamic, so exact destinations may be unknown.
+    shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize);
+  }
+
+  return true;
+}
+
+void MetalCommandProcessor::UpdateDynamicState(id<MTLRenderCommandEncoder> encoder,
+                                               const draw_util::ViewportInfo& viewport_info,
+                                               bool primitive_polygonal,
+                                               reg::RB_DEPTHCONTROL normalized_depth_control,
+                                               const MetalRenderPass& render_pass) {
+  const RegisterFile& regs = *register_file_;
+  RenderEncoderState& state = render_encoder_state_;
+  bool force = !state.valid;
+  xenos::MsaaSamples guest_msaa_samples = regs.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+  DrawResolutionScale host_pixel_scale = render_target_cache_->draw_resolution_scale().ShiftedBy(
+      render_target_cache_->GetSampleSpaceXLog2(guest_msaa_samples),
+      render_target_cache_->GetSampleSpaceYLog2(guest_msaa_samples));
+
+  // Viewport.
+  MTLViewport viewport;
+  if (viewport_info.xy_extent[0] && viewport_info.xy_extent[1]) {
+    viewport.originX = double(viewport_info.xy_offset[0]);
+    viewport.originY = double(viewport_info.xy_offset[1]);
+    viewport.width = double(viewport_info.xy_extent[0]);
+    viewport.height = double(viewport_info.xy_extent[1]);
+  } else {
+    // The viewport may be empty for various reasons - make it a pixel outside the render target.
+    viewport.originX = -1.0;
+    viewport.originY = -1.0;
+    viewport.width = 1.0;
+    viewport.height = 1.0;
+  }
+  viewport.znear = viewport_info.z_min;
+  viewport.zfar = viewport_info.z_max;
+  if (force || std::memcmp(&state.viewport, &viewport, sizeof(viewport))) {
+    [encoder setViewport:viewport];
+    state.viewport = viewport;
+  }
+
+  // Scissor, within the render pass as Metal requires.
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  // The edges rounded to the nearest host pixel at a rational scale, as the viewport's.
+  uint32_t scissor_x0 = std::min(host_pixel_scale.RoundX(scissor.offset[0]), render_pass.width);
+  uint32_t scissor_y0 = std::min(host_pixel_scale.RoundY(scissor.offset[1]), render_pass.height);
+  uint32_t scissor_x1 = std::min(host_pixel_scale.RoundX(scissor.offset[0] + scissor.extent[0]),
+                                 render_pass.width);
+  uint32_t scissor_y1 = std::min(host_pixel_scale.RoundY(scissor.offset[1] + scissor.extent[1]),
+                                 render_pass.height);
+  MTLScissorRect scissor_rect;
+  scissor_rect.x = scissor_x0;
+  scissor_rect.y = scissor_y0;
+  scissor_rect.width = scissor_x1 - scissor_x0;
+  scissor_rect.height = scissor_y1 - scissor_y0;
+  if (force || std::memcmp(&state.scissor, &scissor_rect, sizeof(scissor_rect))) {
+    [encoder setScissorRect:scissor_rect];
+    state.scissor = scissor_rect;
+  }
+
+  // Depth bias.
+  float depth_bias_constant_factor, depth_bias_slope_factor;
+  draw_util::GetPreferredFacePolygonOffset(regs, primitive_polygonal, depth_bias_slope_factor,
+                                           depth_bias_constant_factor);
+  depth_bias_constant_factor *=
+      regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24S8
+          ? draw_util::kD3D10PolygonOffsetFactorUnorm24
+          : draw_util::kD3D10PolygonOffsetFactorFloat24;
+  // With non-square resolution scaling, make sure the worst-case impact is reverted (slope only
+  // along the scaled axis), thus max.
+  depth_bias_slope_factor *= xenos::kPolygonOffsetScaleSubpixelUnit *
+                             std::max(host_pixel_scale.x(), host_pixel_scale.y());
+  // std::memcmp instead of != so in case of NaN, every draw won't be invalidating it.
+  if (force ||
+      std::memcmp(&state.depth_bias_constant, &depth_bias_constant_factor, sizeof(float)) ||
+      std::memcmp(&state.depth_bias_slope, &depth_bias_slope_factor, sizeof(float))) {
+    [encoder setDepthBias:depth_bias_constant_factor slopeScale:depth_bias_slope_factor clamp:0.0f];
+    state.depth_bias_constant = depth_bias_constant_factor;
+    state.depth_bias_slope = depth_bias_slope_factor;
+  }
+
+  // Blend constants.
+  std::array<float, 4> blend_constants = {
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_RED),
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_GREEN),
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_BLUE),
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA),
+  };
+  if (force || std::memcmp(state.blend_constants.data(), blend_constants.data(),
+                           sizeof(float) * 4)) {
+    [encoder setBlendColorRed:blend_constants[0]
+                        green:blend_constants[1]
+                         blue:blend_constants[2]
+                        alpha:blend_constants[3]];
+    state.blend_constants = blend_constants;
+  }
+
+  // Stencil references (the masks are in the depth / stencil state).
+  if (normalized_depth_control.stencil_enable) {
+    uint32_t reference_front = regs.Get<reg::RB_STENCILREFMASK>().stencilref;
+    uint32_t reference_back = reference_front;
+    if (primitive_polygonal && normalized_depth_control.backface_enable) {
+      reference_back =
+          regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF).stencilref;
+    }
+    if (force || state.stencil_reference_front != reference_front ||
+        state.stencil_reference_back != reference_back) {
+      [encoder setStencilFrontReferenceValue:reference_front backReferenceValue:reference_back];
+      state.stencil_reference_front = reference_front;
+      state.stencil_reference_back = reference_back;
+    }
+  }
+}
+
+void MetalCommandProcessor::UpdateSystemConstantValues(
+    bool primitive_polygonal,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    const draw_util::ViewportInfo& viewport_info, uint32_t used_texture_mask,
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask) {
+  (void)normalized_depth_control;
+  (void)normalized_color_mask;
+  const RegisterFile& regs = *register_file_;
+  auto pa_cl_clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  auto rb_alpha_ref = regs.Get<float>(XE_GPU_REG_RB_ALPHA_REF);
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  auto rb_depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  auto vgt_indx_offset = regs.Get<int32_t>(XE_GPU_REG_VGT_INDX_OFFSET);
+  auto vgt_max_vtx_indx = regs.Get<uint32_t>(XE_GPU_REG_VGT_MAX_VTX_INDX);
+  auto vgt_min_vtx_indx = regs.Get<uint32_t>(XE_GPU_REG_VGT_MIN_VTX_INDX);
+
+  // Host pixels per guest pixel, including a pixel per sample with sample-space render targets.
+  DrawResolutionScale host_pixel_scale = render_target_cache_->draw_resolution_scale().ShiftedBy(
+      render_target_cache_->GetSampleSpaceXLog2(rb_surface_info.msaa_samples),
+      render_target_cache_->GetSampleSpaceYLog2(rb_surface_info.msaa_samples));
+
+  reg::RB_COLOR_INFO color_infos[xenos::kMaxColorRenderTargets];
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    color_infos[i] = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+  }
+
+  bool dirty = false;
+
+  // Flags.
+  uint32_t flags = 0;
+  if (primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForDMA ||
+      primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA ||
+      primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kHostConverted) {
+    flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt32) {
+      flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+    }
+    // Point and rectangle expansion uses primitive restart only in the host built-in strip index
+    // buffer; guest indices are not reset-based there.
+    if (primitive_processing_result.host_primitive_reset_enabled &&
+        primitive_processing_result.host_vertex_shader_type !=
+            Shader::HostVertexShaderType::kPointListAsTriangleStrip &&
+        primitive_processing_result.host_vertex_shader_type !=
+            Shader::HostVertexShaderType::kRectangleListAsTriangleStrip) {
+      flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset;
+    }
+  }
+  // W0 division control.
+  if (pa_cl_vte_cntl.vtx_xy_fmt) {
+    flags |= SpirvShaderTranslator::kSysFlag_XYDividedByW;
+  }
+  if (pa_cl_vte_cntl.vtx_z_fmt) {
+    flags |= SpirvShaderTranslator::kSysFlag_ZDividedByW;
+  }
+  if (pa_cl_vte_cntl.vtx_w0_fmt) {
+    flags |= SpirvShaderTranslator::kSysFlag_WNotReciprocal;
+  }
+  // Whether the primitive is polygonal, and gl_FrontFacing matters.
+  if (primitive_polygonal) {
+    flags |= SpirvShaderTranslator::kSysFlag_PrimitivePolygonal;
+  }
+  // Primitive type.
+  if (draw_util::IsPrimitiveLine(regs)) {
+    flags |= SpirvShaderTranslator::kSysFlag_PrimitiveLine;
+  }
+  // MSAA sample count.
+  flags |= uint32_t(rb_surface_info.msaa_samples)
+           << SpirvShaderTranslator::kSysFlag_MsaaSamples_Shift;
+  // Depth format.
+  if (rb_depth_info.depth_format == xenos::DepthRenderTargetFormat::kD24FS8) {
+    flags |= SpirvShaderTranslator::kSysFlag_DepthFloat24;
+  }
+  // Alpha test.
+  xenos::CompareFunction alpha_test_function = rb_colorcontrol.alpha_test_enable
+                                                   ? rb_colorcontrol.alpha_func
+                                                   : xenos::CompareFunction::kAlways;
+  flags |= uint32_t(alpha_test_function) << SpirvShaderTranslator::kSysFlag_AlphaPassIfLess_Shift;
+  // Gamma writing: as in Direct3D 12, gamma render targets are converted with the Xenos PWL gamma
+  // in shaders rather than with host sRGB.
+  if (!render_target_cache_->gamma_render_target_as_unorm16()) {
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (color_infos[i].color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA) {
+        flags |= SpirvShaderTranslator::kSysFlag_ConvertColor0ToGamma << i;
+      }
+    }
+  }
+  dirty |= system_constants_.flags != flags;
+  system_constants_.flags = flags;
+
+  // Index buffer address for loading in the shaders.
+  if (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad) {
+    dirty |=
+        system_constants_.vertex_index_load_address != primitive_processing_result.guest_index_base;
+    system_constants_.vertex_index_load_address = primitive_processing_result.guest_index_base;
+  }
+
+  // Primitive reset index for shader-side index loading.
+  uint32_t vertex_index_reset =
+      (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset)
+          ? regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx
+          : 0;
+  dirty |= system_constants_.vertex_index_reset != vertex_index_reset;
+  system_constants_.vertex_index_reset = vertex_index_reset;
+  dirty |= system_constants_.compute_memexport_vertex_count != 0;
+  system_constants_.compute_memexport_vertex_count = 0;
+
+  // Index or tessellation edge factor buffer endianness.
+  xenos::Endian guest_index_endian = vgt_dma_size.swap_mode;
+  if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16 &&
+      guest_index_endian != xenos::Endian::kNone && guest_index_endian != xenos::Endian::k8in16) {
+    guest_index_endian =
+        guest_index_endian == xenos::Endian::k8in32 ? xenos::Endian::k8in16 : xenos::Endian::kNone;
+  }
+  xenos::Endian index_endian =
+      (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad)
+          ? guest_index_endian
+          : primitive_processing_result.host_shader_index_endian;
+  dirty |= system_constants_.vertex_index_endian != index_endian;
+  system_constants_.vertex_index_endian = index_endian;
+
+  dirty |= system_constants_.line_loop_closing_index !=
+           primitive_processing_result.line_loop_closing_index;
+  system_constants_.line_loop_closing_index = primitive_processing_result.line_loop_closing_index;
+
+  // Vertex index offset.
+  dirty |= system_constants_.vertex_base_index != vgt_indx_offset;
+  system_constants_.vertex_base_index = vgt_indx_offset;
+
+  // Vertex index range.
+  dirty |= system_constants_.vertex_index_min != vgt_min_vtx_indx;
+  dirty |= system_constants_.vertex_index_max != vgt_max_vtx_indx;
+  system_constants_.vertex_index_min = vgt_min_vtx_indx;
+  system_constants_.vertex_index_max = vgt_max_vtx_indx;
+
+  // User clip planes (UCP_ENA_#), when not CLIP_DISABLE. The shader knows only the total count -
+  // tightly packing the user clip planes that are actually used.
+  if (!pa_cl_clip_cntl.clip_disable) {
+    float* user_clip_plane_write_ptr = system_constants_.user_clip_planes[0];
+    uint32_t user_clip_planes_remaining = pa_cl_clip_cntl.ucp_ena;
+    uint32_t user_clip_plane_index;
+    while (rex::bit_scan_forward(user_clip_planes_remaining, &user_clip_plane_index)) {
+      user_clip_planes_remaining &= ~(UINT32_C(1) << user_clip_plane_index);
+      const void* user_clip_plane_regs =
+          &regs[XE_GPU_REG_PA_CL_UCP_0_X + user_clip_plane_index * 4];
+      if (std::memcmp(user_clip_plane_write_ptr, user_clip_plane_regs, 4 * sizeof(float))) {
+        dirty = true;
+        std::memcpy(user_clip_plane_write_ptr, user_clip_plane_regs, 4 * sizeof(float));
+      }
+      user_clip_plane_write_ptr += 4;
+    }
+  }
+
+  // Tessellation factor range, plus 1.0.
+  float tessellation_factor_min = regs.Get<float>(XE_GPU_REG_VGT_HOS_MIN_TESS_LEVEL) + 1.0f;
+  float tessellation_factor_max = regs.Get<float>(XE_GPU_REG_VGT_HOS_MAX_TESS_LEVEL) + 1.0f;
+  dirty |= system_constants_.tessellation_factor_range_min != tessellation_factor_min;
+  dirty |= system_constants_.tessellation_factor_range_max != tessellation_factor_max;
+  system_constants_.tessellation_factor_range_min = tessellation_factor_min;
+  system_constants_.tessellation_factor_range_max = tessellation_factor_max;
+
+  // Conversion to host normalized device coordinates.
+  for (uint32_t i = 0; i < 3; ++i) {
+    dirty |= system_constants_.ndc_scale[i] != viewport_info.ndc_scale[i];
+    dirty |= system_constants_.ndc_offset[i] != viewport_info.ndc_offset[i];
+    system_constants_.ndc_scale[i] = viewport_info.ndc_scale[i];
+    system_constants_.ndc_offset[i] = viewport_info.ndc_offset[i];
+  }
+
+  // Point size.
+  if (vgt_draw_initiator.prim_type == xenos::PrimitiveType::kPointList) {
+    auto pa_su_point_minmax = regs.Get<reg::PA_SU_POINT_MINMAX>();
+    auto pa_su_point_size = regs.Get<reg::PA_SU_POINT_SIZE>();
+    float point_vertex_diameter_min = float(pa_su_point_minmax.min_size) * (2.0f / 16.0f);
+    float point_vertex_diameter_max = float(pa_su_point_minmax.max_size) * (2.0f / 16.0f);
+    float point_constant_diameter_x = float(pa_su_point_size.width) * (2.0f / 16.0f);
+    float point_constant_diameter_y = float(pa_su_point_size.height) * (2.0f / 16.0f);
+    dirty |= system_constants_.point_vertex_diameter_min != point_vertex_diameter_min;
+    dirty |= system_constants_.point_vertex_diameter_max != point_vertex_diameter_max;
+    dirty |= system_constants_.point_constant_diameter[0] != point_constant_diameter_x;
+    dirty |= system_constants_.point_constant_diameter[1] != point_constant_diameter_y;
+    system_constants_.point_vertex_diameter_min = point_vertex_diameter_min;
+    system_constants_.point_vertex_diameter_max = point_vertex_diameter_max;
+    system_constants_.point_constant_diameter[0] = point_constant_diameter_x;
+    system_constants_.point_constant_diameter[1] = point_constant_diameter_y;
+    // 2 because 1 in the NDC is half of the viewport's axis, 0.5 for diameter to radius
+    // conversion to avoid multiplying the per-vertex diameter by an additional constant in the
+    // shader.
+    float point_screen_diameter_to_ndc_radius_x =
+        host_pixel_scale.x() / std::max(viewport_info.xy_extent[0], uint32_t(1));
+    float point_screen_diameter_to_ndc_radius_y =
+        host_pixel_scale.y() / std::max(viewport_info.xy_extent[1], uint32_t(1));
+    dirty |= system_constants_.point_screen_diameter_to_ndc_radius[0] !=
+             point_screen_diameter_to_ndc_radius_x;
+    dirty |= system_constants_.point_screen_diameter_to_ndc_radius[1] !=
+             point_screen_diameter_to_ndc_radius_y;
+    system_constants_.point_screen_diameter_to_ndc_radius[0] =
+        point_screen_diameter_to_ndc_radius_x;
+    system_constants_.point_screen_diameter_to_ndc_radius[1] =
+        point_screen_diameter_to_ndc_radius_y;
+  }
+
+  // Texture signedness.
+  uint32_t textures_resolution_scaled = 0;
+  {
+    uint32_t textures_remaining = used_texture_mask;
+    uint32_t texture_index;
+    while (rex::bit_scan_forward(textures_remaining, &texture_index)) {
+      textures_remaining &= ~(UINT32_C(1) << texture_index);
+      uint32_t& texture_signs_uint = system_constants_.texture_swizzled_signs[texture_index >> 2];
+      uint32_t texture_signs_shift = 8 * (texture_index & 3);
+      uint8_t texture_signs = texture_cache_->GetActiveTextureSwizzledSigns(texture_index);
+      uint32_t texture_signs_shifted = uint32_t(texture_signs) << texture_signs_shift;
+      uint32_t texture_signs_mask = ((UINT32_C(1) << 8) - 1) << texture_signs_shift;
+      dirty |= (texture_signs_uint & texture_signs_mask) != texture_signs_shifted;
+      texture_signs_uint = (texture_signs_uint & ~texture_signs_mask) | texture_signs_shifted;
+      textures_resolution_scaled |=
+          uint32_t(texture_cache_->IsActiveTextureResolutionScaled(texture_index)) << texture_index;
+    }
+  }
+  dirty |= system_constants_.textures_resolution_scaled != textures_resolution_scaled;
+  system_constants_.textures_resolution_scaled = textures_resolution_scaled;
+
+  // Alpha test and alpha to coverage.
+  dirty |= system_constants_.alpha_test_reference != rb_alpha_ref;
+  system_constants_.alpha_test_reference = rb_alpha_ref;
+  uint32_t alpha_to_mask =
+      rb_colorcontrol.alpha_to_mask_enable ? (rb_colorcontrol.value >> 24) | (UINT32_C(1) << 8) : 0;
+  dirty |= system_constants_.alpha_to_mask != alpha_to_mask;
+  system_constants_.alpha_to_mask = alpha_to_mask;
+
+  // Color exponent bias.
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    reg::RB_COLOR_INFO color_info = color_infos[i];
+    // Exponent bias is in bits 20:25 of RB_COLOR_INFO.
+    int32_t color_exp_bias = color_info.color_exp_bias;
+    if ((color_info.color_format == xenos::ColorRenderTargetFormat::k_16_16 &&
+         !render_target_cache_->IsFixedRG16TruncatedToMinus1To1()) ||
+        (color_info.color_format == xenos::ColorRenderTargetFormat::k_16_16_16_16 &&
+         !render_target_cache_->IsFixedRGBA16TruncatedToMinus1To1())) {
+      // Remap from -32...32 to -1...1 by dividing the output values by 32, losing blending
+      // correctness, but getting the full range.
+      color_exp_bias -= 5;
+    }
+    float color_exp_bias_scale;
+    *reinterpret_cast<int32_t*>(&color_exp_bias_scale) =
+        UINT32_C(0x3F800000) + (color_exp_bias << 23);
+    dirty |= system_constants_.color_exp_bias[i] != color_exp_bias_scale;
+    system_constants_.color_exp_bias[i] = color_exp_bias_scale;
+    // Metal has no pixel shader interlock path; XSC pixel shaders read the render target formats
+    // to clamp the color to the range of a 7e3 render target.
+    uint32_t format_flags = RenderTargetCache::AddPSIColorFormatFlags(color_info.color_format);
+    dirty |= system_constants_.edram_rt_format_flags[i] != format_flags;
+    system_constants_.edram_rt_format_flags[i] = format_flags;
+  }
+
+  if (dirty) {
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferSystem);
+  }
+}
+
+bool MetalCommandProcessor::UpdateBindings(id<MTLRenderCommandEncoder> encoder,
+                                           const MetalShader* vertex_shader,
+                                           const MetalShader* pixel_shader,
+                                           const MetalShader::MetalTranslation* vertex_translation,
+                                           const MetalShader::MetalTranslation* pixel_translation) {
+  const RegisterFile& regs = *register_file_;
+  RenderEncoderState& state = render_encoder_state_;
+
+  // Float constant layouts.
+  const Shader::ConstantRegisterMap& float_constant_map_vertex =
+      vertex_shader->constant_register_map();
+  uint32_t float_constant_count_vertex = float_constant_map_vertex.float_count;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (current_float_constant_map_vertex_[i] != float_constant_map_vertex.float_bitmap[i]) {
+      current_float_constant_map_vertex_[i] = float_constant_map_vertex.float_bitmap[i];
+      if (float_constant_count_vertex) {
+        current_constant_buffers_up_to_date_ &=
+            ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatVertex);
+      }
+    }
+  }
+  uint32_t float_constant_count_pixel = 0;
+  if (pixel_shader) {
+    const Shader::ConstantRegisterMap& float_constant_map_pixel =
+        pixel_shader->constant_register_map();
+    float_constant_count_pixel = float_constant_map_pixel.float_count;
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (current_float_constant_map_pixel_[i] != float_constant_map_pixel.float_bitmap[i]) {
+        current_float_constant_map_pixel_[i] = float_constant_map_pixel.float_bitmap[i];
+        if (float_constant_count_pixel) {
+          current_constant_buffers_up_to_date_ &=
+              ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatPixel);
+        }
+      }
+    }
+  } else {
+    std::memset(current_float_constant_map_pixel_, 0, sizeof(current_float_constant_map_pixel_));
+  }
+
+  // Write the outdated constant buffers to the upload memory of the submission.
+  auto write_constant_buffer = [&](uint32_t buffer_index, size_t size,
+                                   const std::function<void(uint8_t*)>& write) -> bool {
+    if (current_constant_buffers_up_to_date_ & (UINT32_C(1) << buffer_index)) {
+      return true;
+    }
+    UploadAllocation allocation = RequestUpload(size);
+    if (!allocation.mapping) {
+      return false;
+    }
+    write(static_cast<uint8_t*>(allocation.mapping));
+    current_constant_buffers_[buffer_index] = allocation;
+    current_constant_buffers_up_to_date_ |= UINT32_C(1) << buffer_index;
+    state.vertex_constant_buffers_bound &= ~(UINT32_C(1) << buffer_index);
+    state.fragment_constant_buffers_bound &= ~(UINT32_C(1) << buffer_index);
+    return true;
+  };
+  auto write_float_constants = [&regs](uint8_t* mapping, const uint64_t* map,
+                                       uint32_t register_base) {
+    for (uint32_t i = 0; i < 4; ++i) {
+      uint64_t float_constant_map_entry = map[i];
+      uint32_t float_constant_index;
+      while (rex::bit_scan_forward(float_constant_map_entry, &float_constant_index)) {
+        float_constant_map_entry &= ~(1ull << float_constant_index);
+        std::memcpy(mapping, &regs[register_base + (i << 8) + (float_constant_index << 2)],
+                    sizeof(float) * 4);
+        mapping += sizeof(float) * 4;
+      }
+    }
+  };
+  if (!write_constant_buffer(SpirvShaderTranslator::kConstantBufferSystem,
+                             sizeof(SpirvShaderTranslator::SystemConstants), [&](uint8_t* mapping) {
+                               std::memcpy(mapping, &system_constants_, sizeof(system_constants_));
+                             }) ||
+      !write_constant_buffer(
+          SpirvShaderTranslator::kConstantBufferFloatVertex,
+          sizeof(float) * 4 * std::max(float_constant_count_vertex, UINT32_C(1)),
+          [&](uint8_t* mapping) {
+            write_float_constants(mapping, current_float_constant_map_vertex_,
+                                  XE_GPU_REG_SHADER_CONSTANT_000_X);
+          }) ||
+      !write_constant_buffer(
+          SpirvShaderTranslator::kConstantBufferFloatPixel,
+          sizeof(float) * 4 * std::max(float_constant_count_pixel, UINT32_C(1)),
+          [&](uint8_t* mapping) {
+            write_float_constants(mapping, current_float_constant_map_pixel_,
+                                  XE_GPU_REG_SHADER_CONSTANT_256_X);
+          }) ||
+      !write_constant_buffer(SpirvShaderTranslator::kConstantBufferBoolLoop,
+                             sizeof(uint32_t) * (8 + 32),
+                             [&](uint8_t* mapping) {
+                               std::memcpy(mapping, &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031],
+                                           sizeof(uint32_t) * (8 + 32));
+                             }) ||
+      !write_constant_buffer(SpirvShaderTranslator::kConstantBufferFetch,
+                             sizeof(uint32_t) * 6 * 32, [&](uint8_t* mapping) {
+                               std::memcpy(mapping, &regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0],
+                                           sizeof(uint32_t) * 6 * 32);
+                             })) {
+    REXGPU_ERROR("Metal: failed to allocate the constant buffers");
+    return false;
+  }
+
+  // Bind the shared memory and the constant buffers.
+  if (!state.valid || !state.shared_memory_bound) {
+    [encoder setVertexBuffer:shared_memory_->buffer() offset:0 atIndex:kMetalBufferSharedMemory];
+    [encoder setFragmentBuffer:shared_memory_->buffer() offset:0 atIndex:kMetalBufferSharedMemory];
+    state.shared_memory_bound = true;
+    state.vertex_constant_buffers_bound = 0;
+    state.fragment_constant_buffers_bound = 0;
+  }
+  for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+    const UploadAllocation& allocation = current_constant_buffers_[i];
+    if (!(state.vertex_constant_buffers_bound & (UINT32_C(1) << i))) {
+      [encoder setVertexBuffer:allocation.buffer
+                        offset:allocation.offset
+                       atIndex:kMetalBufferConstantsFirst + i];
+      state.vertex_constant_buffers_bound |= UINT32_C(1) << i;
+    }
+    if (pixel_shader && !(state.fragment_constant_buffers_bound & (UINT32_C(1) << i))) {
+      [encoder setFragmentBuffer:allocation.buffer
+                          offset:allocation.offset
+                         atIndex:kMetalBufferConstantsFirst + i];
+      state.fragment_constant_buffers_bound |= UINT32_C(1) << i;
+    }
+  }
+
+  // Buffer sizes for runtime array lengths, if the functions need them.
+  if (vertex_translation->needs_buffer_sizes() ||
+      (pixel_translation && pixel_translation->needs_buffer_sizes())) {
+    uint32_t buffer_sizes[kMetalBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferCount];
+    buffer_sizes[kMetalBufferSharedMemory] = SharedMemory::kBufferSize;
+    for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+      buffer_sizes[kMetalBufferConstantsFirst + i] = uint32_t(
+          current_constant_buffers_[i].buffer.length - current_constant_buffers_[i].offset);
+    }
+    if (vertex_translation->needs_buffer_sizes()) {
+      [encoder setVertexBytes:buffer_sizes length:sizeof(buffer_sizes) atIndex:kMslBufferSizesIndex];
+    }
+    if (pixel_translation && pixel_translation->needs_buffer_sizes()) {
+      [encoder setFragmentBytes:buffer_sizes
+                         length:sizeof(buffer_sizes)
+                        atIndex:kMslBufferSizesIndex];
+    }
+  }
+
+  if (xsc_debug_counters_ && pixel_translation && pixel_translation->is_xsc()) {
+    [encoder setFragmentBuffer:xsc_debug_counters_ offset:0 atIndex:kMetalBufferXscDebugCounters];
+  }
+
+  // Textures and samplers.
+  for (uint32_t stage = 0; stage < 2; ++stage) {
+    const MetalShader* shader = stage ? pixel_shader : vertex_shader;
+    if (!shader) {
+      continue;
+    }
+    const std::vector<SpirvShader::TextureBinding>& texture_bindings =
+        shader->GetTextureBindingsAfterTranslation();
+    const std::vector<SpirvShader::SamplerBinding>& sampler_bindings =
+        shader->GetSamplerBindingsAfterTranslation();
+    if (!texture_bindings.empty()) {
+      binding_textures_.clear();
+      for (const SpirvShader::TextureBinding& texture_binding : texture_bindings) {
+        binding_textures_.push_back(texture_cache_->GetActiveBindingOrNullTexture(
+            texture_binding.fetch_constant, texture_binding.dimension,
+            bool(texture_binding.is_signed)));
+      }
+      NSRange range = NSMakeRange(0, binding_textures_.size());
+      if (stage) {
+        [encoder setFragmentTextures:binding_textures_.data() withRange:range];
+      } else {
+        [encoder setVertexTextures:binding_textures_.data() withRange:range];
+      }
+    }
+    if (!sampler_bindings.empty()) {
+      binding_samplers_.clear();
+      for (const SpirvShader::SamplerBinding& sampler_binding : sampler_bindings) {
+        id<MTLSamplerState> sampler =
+            texture_cache_->GetSampler(texture_cache_->GetSamplerParameters(sampler_binding));
+        if (!sampler) {
+          return false;
+        }
+        binding_samplers_.push_back(sampler);
+      }
+      NSRange range = NSMakeRange(0, binding_samplers_.size());
+      if (stage) {
+        [encoder setFragmentSamplerStates:binding_samplers_.data() withRange:range];
+      } else {
+        [encoder setVertexSamplerStates:binding_samplers_.data() withRange:range];
+      }
+    }
+  }
+  return true;
+}
+
+bool MetalCommandProcessor::IssueCopy() {
+  if (!BeginSubmission(true)) {
+    return false;
+  }
+  PERF_counter_inc(kResolves);
+  uint32_t written_address, written_length;
+  return render_target_cache_->Resolve(*memory_, *shared_memory_, *texture_cache_,
+                                       written_address, written_length);
+}
+
+void MetalCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                                      uint32_t frontbuffer_height) {
+  (void)frontbuffer_ptr;
+  if (!graphics_system_) {
+    return;
+  }
+  ui::Presenter* presenter = graphics_system_->presenter();
+  if (!presenter) {
+    return;
+  }
+
+  // In case the swap command is the only one in the frame.
+  if (!BeginSubmission(true)) {
+    return;
+  }
+
+  // Obtain the actual swap source texture size.
+  uint32_t frontbuffer_width_scaled, frontbuffer_height_scaled;
+  uint32_t frontbuffer_width_unscaled, frontbuffer_height_unscaled;
+  xenos::TextureFormat frontbuffer_format;
+  id<MTLTexture> swap_texture = texture_cache_->RequestSwapTexture(
+      frontbuffer_width_scaled, frontbuffer_height_scaled, frontbuffer_width_unscaled,
+      frontbuffer_height_unscaled, frontbuffer_format);
+  if (!swap_texture) {
+    EndSubmission(true);
+    return;
+  }
+  // The gamma pass reads source texels by pixel index, and swap textures may be padded, so the
+  // output is the front buffer size from the swap packet (in guest pixels), within the texture, in
+  // host texels: a front buffer resolved at the draw resolution scale has that many more.
+  auto get_guest_output_size = [](uint32_t packet_size, uint32_t texture_size_unscaled,
+                                   uint32_t texture_size_scaled) {
+    if (!packet_size || !texture_size_unscaled) {
+      return texture_size_scaled;
+    }
+    return std::min(packet_size, texture_size_unscaled) * texture_size_scaled /
+           texture_size_unscaled;
+  };
+  uint32_t guest_output_width = get_guest_output_size(
+      frontbuffer_width, frontbuffer_width_unscaled, frontbuffer_width_scaled);
+  uint32_t guest_output_height = get_guest_output_size(
+      frontbuffer_height, frontbuffer_height_unscaled, frontbuffer_height_scaled);
+  if (REXCVAR_GET(metal_frame_history_frames) > 0) {
+    RecordFrameHistory(swap_texture, guest_output_width, guest_output_height);
+  }
+
+  system::X_VIDEO_MODE video_mode;
+  kernel::xboxkrnl::VdQueryVideoMode(&video_mode);
+  uint32_t display_width = std::max(uint32_t(1), uint32_t(video_mode.display_width));
+  uint32_t display_height = std::max(uint32_t(1), uint32_t(video_mode.display_height));
+
+  SwapPostEffect swap_post_effect = GetActualSwapPostEffect();
+
+  presenter->RefreshGuestOutput(
+      guest_output_width, guest_output_height, display_width, display_height,
+      [this, guest_output_width, guest_output_height, frontbuffer_format, swap_texture,
+       swap_post_effect](ui::Presenter::GuestOutputRefreshContext& context) -> bool {
+        auto& metal_context =
+            static_cast<MetalPresenter::MetalGuestOutputRefreshContext&>(context);
+
+        // This is according to D3D::InitializePresentationParameters from a game executable,
+        // which initializes the 256-entry table gamma ramp for 8_8_8_8 output and the PWL gamma
+        // ramp for 2_10_10_10.
+        bool use_pwl_gamma_ramp =
+            frontbuffer_format == xenos::TextureFormat::k_2_10_10_10 ||
+            frontbuffer_format == xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16;
+
+        // FXAA goes through an intermediate texture with the luma in alpha.
+        id<MTLComputePipelineState> fxaa_pipeline =
+            swap_post_effect == SwapPostEffect::kFxaa          ? swap_fxaa_pipeline_
+            : swap_post_effect == SwapPostEffect::kFxaaExtreme ? swap_fxaa_extreme_pipeline_
+                                                               : nil;
+        id<MTLComputePipelineState> gamma_pipeline =
+            use_pwl_gamma_ramp ? swap_apply_gamma_pwl_pipeline_ : swap_apply_gamma_table_pipeline_;
+        if (fxaa_pipeline) {
+          id<MTLComputePipelineState> gamma_luma_pipeline =
+              use_pwl_gamma_ramp ? swap_apply_gamma_pwl_fxaa_luma_pipeline_
+                                 : swap_apply_gamma_table_fxaa_luma_pipeline_;
+          if (!swap_fxaa_source_ || swap_fxaa_source_.width != guest_output_width ||
+              swap_fxaa_source_.height != guest_output_height) {
+            MTLTextureDescriptor* descriptor = [MTLTextureDescriptor
+                texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float
+                                             width:guest_output_width
+                                            height:guest_output_height
+                                         mipmapped:NO];
+            descriptor.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+            descriptor.storageMode = MTLStorageModePrivate;
+            swap_fxaa_source_ = [device_ newTextureWithDescriptor:descriptor];
+            swap_fxaa_source_.label = @"FXAA source";
+          }
+          if (gamma_luma_pipeline && swap_fxaa_source_) {
+            gamma_pipeline = gamma_luma_pipeline;
+          } else {
+            fxaa_pipeline = nil;
+          }
+        }
+        // FXAA can result in more than 8 bits of precision.
+        context.SetIs8bpc(!use_pwl_gamma_ramp && !fxaa_pipeline);
+
+        // The ramp as a texel buffer in the upload memory of the submission.
+        constexpr uint32_t kGammaRampSize256EntryTable = sizeof(uint32_t) * 256;
+        constexpr uint32_t kGammaRampSizePWL = sizeof(uint16_t) * 2 * 3 * 128;
+        uint32_t gamma_ramp_size =
+            use_pwl_gamma_ramp ? kGammaRampSizePWL : kGammaRampSize256EntryTable;
+        UploadAllocation ramp_upload = RequestUpload(gamma_ramp_size, 256);
+        if (!ramp_upload.mapping) {
+          return false;
+        }
+        std::memcpy(ramp_upload.mapping,
+                    use_pwl_gamma_ramp ? static_cast<const void*>(gamma_ramp_pwl_rgb())
+                                       : static_cast<const void*>(gamma_ramp_256_entry_table()),
+                    gamma_ramp_size);
+        MTLPixelFormat ramp_format =
+            use_pwl_gamma_ramp ? MTLPixelFormatRG16Uint : MTLPixelFormatRGB10A2Unorm;
+        MTLTextureDescriptor* ramp_descriptor = [MTLTextureDescriptor
+            textureBufferDescriptorWithPixelFormat:ramp_format
+                                             width:use_pwl_gamma_ramp ? 128 * 3 : 256
+                                   resourceOptions:ramp_upload.buffer.resourceOptions
+                                             usage:MTLTextureUsageShaderRead];
+        id<MTLTexture> ramp_texture = [ramp_upload.buffer newTextureWithDescriptor:ramp_descriptor
+                                                                            offset:ramp_upload.offset
+                                                                       bytesPerRow:gamma_ramp_size];
+        if (!ramp_texture) {
+          return false;
+        }
+
+        id<MTLComputeCommandEncoder> compute =
+            GetComputeEncoder(rex::perf::CounterId::kRenderPassEndsOther);
+        compute.label = @"Swap";
+        [compute setComputePipelineState:gamma_pipeline];
+        [compute setTexture:ramp_texture atIndex:kSwapTextureRamp];
+        [compute setTexture:swap_texture atIndex:kSwapTextureSource];
+        [compute setTexture:fxaa_pipeline ? swap_fxaa_source_ : metal_context.texture()
+                    atIndex:kSwapTextureDestination];
+        uint32_t size[2] = {guest_output_width, guest_output_height};
+        [compute setBytes:size length:sizeof(size) atIndex:kSwapBufferConstants];
+        MTLSize group_count = MTLSizeMake((guest_output_width + 15) / 16,
+                                          (guest_output_height + 7) / 8, 1);
+        [compute dispatchThreadgroups:group_count
+                threadsPerThreadgroup:swap_apply_gamma_threads_per_threadgroup_];
+        PERF_counter_inc(kHostDispatches);
+        if (fxaa_pipeline) {
+          struct {
+            uint32_t size[2];
+            float size_inv[2];
+          } fxaa_constants = {{guest_output_width, guest_output_height},
+                              {1.0f / float(guest_output_width),
+                               1.0f / float(guest_output_height)}};
+          [compute setComputePipelineState:fxaa_pipeline];
+          [compute setBytes:&fxaa_constants length:sizeof(fxaa_constants) atIndex:0];
+          [compute setTexture:swap_fxaa_source_ atIndex:0];
+          [compute setSamplerState:swap_fxaa_sampler_ atIndex:0];
+          [compute setTexture:metal_context.texture() atIndex:1];
+          [compute dispatchThreadgroups:group_count threadsPerThreadgroup:MTLSizeMake(16, 8, 1)];
+          PERF_counter_inc(kHostDispatches);
+        }
+        // The presenter paints from another thread with its own command buffers on the same
+        // queue: reserving the place of this one now makes them run after it.
+        [command_buffer_ enqueue];
+        return true;
+      });
+
+  EndSubmission(true);
+}
+
+}  // namespace rex::graphics::metal
