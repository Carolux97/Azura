diff --git a/tests/unit/system/player_identity_test.cpp b/tests/unit/system/player_identity_test.cpp
new file mode 100644
index 0000000..e552449
--- /dev/null
+++ b/tests/unit/system/player_identity_test.cpp
@@ -0,0 +1,116 @@
+/**
+ * @file        player_identity_test.cpp
+ * @brief       Unit tests for the installation's identity (rex/system/xam/player_identity.h).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <filesystem>
+#include <fstream>
+#include <random>
+#include <sstream>
+#include <string>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xam/player_identity.h>
+
+using namespace rex::system::xam;
+
+namespace {
+
+std::filesystem::path FreshFolder(std::string_view name) {
+  auto path = std::filesystem::temp_directory_path() / "rexglue_player_identity_test" / name;
+  std::filesystem::remove_all(path);
+  std::filesystem::create_directories(path);
+  return path;
+}
+
+std::string ReadFile(const std::filesystem::path& path) {
+  std::ifstream in(path, std::ios::binary);
+  std::stringstream text;
+  text << in.rdbuf();
+  return text.str();
+}
+
+}  // namespace
+
+TEST_CASE("Player XUIDs are offline, with room for players 2 to 4", "[player_identity]") {
+  CHECK(IsValidPlayerXuid(0xE000000000000000ull));
+  CHECK(IsValidPlayerXuid(0xE000FFFFFFFFFFFCull));
+  CHECK_FALSE(IsValidPlayerXuid(0xE000FFFFFFFFFFFDull));  // player 4 would leave the range
+  CHECK_FALSE(IsValidPlayerXuid(kContentFolderXuid));
+  CHECK_FALSE(IsValidPlayerXuid(0x0009000000000001ull));  // an online XUID
+  CHECK_FALSE(IsValidPlayerXuid(0xE0C0000000000000ull));  // bits some games refuse
+}
+
+TEST_CASE("Generated identities are valid and differ", "[player_identity]") {
+  std::random_device random;
+  const PlayerIdentity a = GeneratePlayerIdentity(random);
+  const PlayerIdentity b = GeneratePlayerIdentity(random);
+  CHECK(IsValidPlayerXuid(a.xuid));
+  CHECK(IsValidMachineId(a.machine_id));
+  CHECK((a.xuid & 0x00C0000000000000ull) == 0);
+  CHECK(a.xuid != b.xuid);
+  CHECK(a.machine_id != b.machine_id);
+  CHECK(a.key_seed != b.key_seed);
+}
+
+TEST_CASE("Identities survive their file", "[player_identity]") {
+  std::random_device random;
+  const PlayerIdentity identity = GeneratePlayerIdentity(random);
+  const auto parsed = ParsePlayerIdentity(SerializePlayerIdentity(identity));
+  REQUIRE(parsed);
+  CHECK(parsed->xuid == identity.xuid);
+  CHECK(parsed->machine_id == identity.machine_id);
+  CHECK(parsed->key_seed == identity.key_seed);
+}
+
+TEST_CASE("Invalid identity files are refused", "[player_identity]") {
+  std::random_device random;
+  const std::string good = SerializePlayerIdentity(GeneratePlayerIdentity(random));
+  CHECK_FALSE(ParsePlayerIdentity(""));
+  CHECK_FALSE(ParsePlayerIdentity("not toml ["));
+  // The legacy XUID is not an installation's own.
+  auto legacy = good;
+  legacy.replace(legacy.find("xuid = \"") + 8, 16, "B13EBABEBABEBABE");
+  CHECK_FALSE(ParsePlayerIdentity(legacy));
+  // A multicast machine ID.
+  auto multicast = good;
+  multicast.replace(multicast.find("machine_id = \"") + 14, 2, "03");
+  CHECK_FALSE(ParsePlayerIdentity(multicast));
+  // A short key seed.
+  auto short_seed = good;
+  short_seed.replace(short_seed.find("key_seed = \"") + 12, 2, "");
+  CHECK_FALSE(ParsePlayerIdentity(short_seed));
+}
+
+TEST_CASE("The identity is made once and kept", "[player_identity]") {
+  const auto folder = FreshFolder("kept");
+  const PlayerIdentity first = LoadOrCreatePlayerIdentity(folder);
+  REQUIRE(std::filesystem::is_regular_file(folder / kPlayerIdentityFileName));
+  const PlayerIdentity second = LoadOrCreatePlayerIdentity(folder);
+  CHECK(second.xuid == first.xuid);
+  CHECK(second.machine_id == first.machine_id);
+  CHECK(second.key_seed == first.key_seed);
+}
+
+TEST_CASE("An unreadable identity is kept aside and replaced", "[player_identity]") {
+  const auto folder = FreshFolder("replaced");
+  {
+    std::ofstream(folder / kPlayerIdentityFileName) << "xuid = \"broken\"\n";
+  }
+  const PlayerIdentity identity = LoadOrCreatePlayerIdentity(folder);
+  CHECK(IsValidPlayerXuid(identity.xuid));
+  CHECK(ReadFile(folder / "identity.toml.bad") == "xuid = \"broken\"\n");
+  CHECK(ParsePlayerIdentity(ReadFile(folder / kPlayerIdentityFileName)));
+}
+
+TEST_CASE("Tools read the identity but never make one", "[player_identity]") {
+  const auto folder = FreshFolder("tools");
+  LoadPlayerIdentity(folder);
+  CHECK_FALSE(std::filesystem::exists(folder / kPlayerIdentityFileName));
+  const PlayerIdentity kept = LoadOrCreatePlayerIdentity(folder);
+  CHECK(LoadPlayerIdentity(folder).xuid == kept.xuid);
+}
diff --git a/tests/unit/system/system_link_test.cpp b/tests/unit/system/system_link_test.cpp
new file mode 100644
index 0000000..574364e
--- /dev/null
+++ b/tests/unit/system/system_link_test.cpp
@@ -0,0 +1,89 @@
+/**
+ * @file        system_link_test.cpp
+ * @brief       Unit tests for System Link's view of the network (rex/system/xam/system_link.h).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <random>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xam/system_link.h>
+
+using namespace rex::system::xam;
+
+TEST_CASE("An XNADDR holds the address and the machine ID", "[system_link]") {
+  const std::array<uint8_t, 6> machine_id = {0x02, 0x11, 0x22, 0x33, 0x44, 0x55};
+  const XnAddrBytes xnaddr = MakeXnAddr(0xC0A80102, machine_id);
+  // 192.168.1.2 in network byte order, as the title reads an IN_ADDR.
+  CHECK(xnaddr[0] == 192);
+  CHECK(xnaddr[1] == 168);
+  CHECK(xnaddr[2] == 1);
+  CHECK(xnaddr[3] == 2);
+  CHECK(XnAddrIp(xnaddr) == 0xC0A80102);
+  for (size_t i = 0; i < machine_id.size(); ++i) {
+    CHECK(xnaddr[kXnAddrEnetOffset + i] == machine_id[i]);
+  }
+}
+
+TEST_CASE("The address book answers for the XNADDRs it has seen", "[system_link]") {
+  const XnAddrBytes first = MakeXnAddr(0x0A000005, {0x02, 1, 2, 3, 4, 5});
+  const XnAddrBytes second = MakeXnAddr(0x0A000005, {0x06, 1, 2, 3, 4, 5});
+  CHECK_FALSE(FindXnAddr(0x0A000006));
+  RememberXnAddr(first);
+  REQUIRE(FindXnAddr(0x0A000005));
+  CHECK(*FindXnAddr(0x0A000005) == first);
+  // The same address seen again with another machine ID: the newer one is kept.
+  RememberXnAddr(second);
+  CHECK(*FindXnAddr(0x0A000005) == second);
+}
+
+TEST_CASE("Session IDs are System Link ones", "[system_link]") {
+  std::random_device random;
+  const XnKid a = MakeSystemLinkKid(random);
+  const XnKid b = MakeSystemLinkKid(random);
+  CHECK(IsSystemLinkKid(a));
+  CHECK(a != b);
+  CHECK_FALSE(IsSystemLinkKid(XnKid{0x80}));  // an online peer session
+  CHECK(MakeKey(random) != MakeKey(random));
+}
+
+TEST_CASE("Hosting lasts while the hosted session exists", "[system_link]") {
+  std::random_device random;
+  SystemLinkSession hosted;
+  hosted.kid = MakeSystemLinkKid(random);
+  hosted.host = MakeXnAddr(0xC0A80110, {0x02, 0, 0, 0, 0, 1});
+  hosted.hosting = true;
+  SystemLinkSession joined;
+  joined.kid = MakeSystemLinkKid(random);
+  joined.host = MakeXnAddr(0xC0A80120, {0x02, 0, 0, 0, 0, 2});
+
+  CHECK_FALSE(HostingSystemLinkSession());
+  AddSession(0x1000, joined);
+  CHECK_FALSE(HostingSystemLinkSession());
+  AddSession(0x2000, hosted);
+  CHECK(HostingSystemLinkSession());
+  // A session's host is in the address book, and its ID answers for it.
+  CHECK(FindXnAddr(0xC0A80120));
+  CHECK(*FindSessionKid(0xC0A80120) == joined.kid);
+  CHECK(*FindSessionKid(0xC0A80110) == hosted.kid);
+  RemoveSession(0x2000);
+  CHECK_FALSE(HostingSystemLinkSession());
+  RemoveSession(0x1000);
+  CHECK_FALSE(FindSessionKid(0xC0A80120));
+}
+
+TEST_CASE("Privileged ports are moved the same way on every platform", "[system_link]") {
+  CHECK(NetworkPort(1000) == 11000);
+  CHECK(NetworkPort(1019) == 11019);
+  CHECK(NetworkPort(14001) == 14001);
+  CHECK(NetworkPort(0) == 0);
+  CHECK(TitlePort(11000) == 1000);
+  CHECK(TitlePort(14001) == 14001);
+  CHECK(TitlePort(10000) == 10000);
+  for (uint16_t port = 1; port < kFirstUnprivilegedPort; ++port) {
+    CHECK(TitlePort(NetworkPort(port)) == port);
+  }
+}
