+MetalRenderTargetCache::MetalRenderTargetCache(const RegisterFile& register_file,
+                                               const memory::Memory& memory,
+                                               DrawResolutionScale draw_resolution_scale,
+                                               MetalCommandProcessor& command_processor)
+    : RenderTargetCache(register_file, memory, draw_resolution_scale),
+      command_processor_(command_processor) {}
+
+MetalRenderTargetCache::~MetalRenderTargetCache() { Shutdown(true); }
+
+bool MetalRenderTargetCache::Initialize() {
+  id<MTLDevice> device = command_processor_.device();
+
+  gamma_render_target_as_unorm16_ = REXCVAR_GET(gamma_render_target_as_unorm16);
+  depth_float24_round_ = REXCVAR_GET(depth_float24_round);
+  depth_float24_convert_in_pixel_shader_ = REXCVAR_GET(depth_float24_convert_in_pixel_shader);
+
+  // EDRAM contents reinterpretation buffer, for host depth storing and resolves. At a draw
+  // resolution scale, every EDRAM tile has the scale's host samples along each axis (90 MB at 3x3,
+  // 22.5 MB at 3/2): a whole number of samples per tile, as the denominator divides the tile size.
+  DrawResolutionScale scale = draw_resolution_scale();
+  edram_buffer_ = [device
+      newBufferWithLength:NSUInteger(xenos::kEdramSizeBytes) * scale.numerator_x *
+                          scale.numerator_y / (scale.denominator * scale.denominator)
+                  options:MTLResourceStorageModePrivate];
+  if (!edram_buffer_) {
+    REXGPU_ERROR("MetalRenderTargetCache: Failed to create the EDRAM buffer");
+    return false;
+  }
+  edram_buffer_.label = @"EDRAM";
+  if (!scale.IsWhole()) {
+    edram_buffer_guest_ = [device newBufferWithLength:NSUInteger(xenos::kEdramSizeBytes)
+                                              options:MTLResourceStorageModePrivate];
+    if (!edram_buffer_guest_) {
+      REXGPU_ERROR("MetalRenderTargetCache: Failed to create the guest resolution EDRAM buffer");
+      return false;
+    }
+    edram_buffer_guest_.label = @"EDRAM at the guest resolution";
+  }
+
+  // Resolve copy pipelines: the EDRAM buffer (set 0) to the shared memory (set 1).
+  const std::vector<MslBinding> resolve_copy_bindings = {
+      {0, 0, MslBinding::Kind::kBuffer, kComputeBufferEdram},
+      {1, 0, MslBinding::Kind::kBuffer, kComputeBufferDest},
+      {MslBinding::kPushConstantSet, 0, MslBinding::Kind::kBuffer, kComputeBufferConstants},
+  };
+  for (size_t i = 0; i < size_t(draw_util::ResolveCopyShaderIndex::kCount); ++i) {
+    const draw_util::ResolveCopyShaderInfo& resolve_copy_shader_info =
+        draw_util::resolve_copy_shader_info[i];
+    std::array<uint32_t, 3> threadgroup_size;
+    ComputePipeline& pipeline = resolve_copy_pipelines_[i];
+    const ResolveCopyShaderCode& code = kResolveCopyShaders[i];
+    // At a rational scale, the unscaled shaders copy from edram_buffer_guest_.
+    bool scaled = IsDrawResolutionScaled() && draw_resolution_scale().IsWhole();
+    pipeline.pipeline = CreateComputePipelineFromSpirv(
+        device, scaled ? code.scaled : code.unscaled,
+        (scaled ? code.scaled_size_bytes : code.unscaled_size_bytes) / sizeof(uint32_t),
+        resolve_copy_bindings, resolve_copy_shader_info.debug_name, &threadgroup_size);
+    if (!pipeline.pipeline) {
+      REXGPU_ERROR("MetalRenderTargetCache: Failed to create the resolve copy pipeline {}",
+                   resolve_copy_shader_info.debug_name);
+      Shutdown();
+      return false;
+    }
+    pipeline.threads_per_threadgroup =
+        MTLSizeMake(threadgroup_size[0], threadgroup_size[1], threadgroup_size[2]);
+  }
+
+  // Host depth storing: the depth render target (set 1) to the EDRAM buffer (set 0).
+  {
+    const std::vector<MslBinding> host_depth_store_bindings = {
+        {0, 0, MslBinding::Kind::kBuffer, kComputeBufferEdram},
+        {1, 0, MslBinding::Kind::kTexture, kComputeTextureSource},
+        {1, 1, MslBinding::Kind::kTexture, kComputeTextureSourceStencil},
+        {MslBinding::kPushConstantSet, 0, MslBinding::Kind::kBuffer, kComputeBufferConstants},
+    };
+    std::array<uint32_t, 3> threadgroup_size;
+    host_depth_store_pipeline_.pipeline = CreateComputePipelineFromSpirv(
+        device, shaders::host_depth_store_1xmsaa_cs,
+        sizeof(shaders::host_depth_store_1xmsaa_cs) / sizeof(uint32_t), host_depth_store_bindings,
+        "host depth store", &threadgroup_size);
+    if (!host_depth_store_pipeline_.pipeline) {
+      REXGPU_ERROR("MetalRenderTargetCache: Failed to create the host depth storing pipeline");
+      Shutdown();
+      return false;
+    }
+    host_depth_store_pipeline_.threads_per_threadgroup =
+        MTLSizeMake(threadgroup_size[0], threadgroup_size[1], threadgroup_size[2]);
+  }
+
+  // Transfer and clear functions.
+  NSError* error = nil;
+  id<MTLLibrary> library = [device newLibraryWithSource:kRenderTargetShaderSource
+                                                options:nil
+                                                  error:&error];
+  if (!library) {
+    REXGPU_ERROR("MetalRenderTargetCache: Failed to compile the render target shaders: {}",
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+    Shutdown();
+    return false;
+  }
+  transfer_vertex_function_ = [library newFunctionWithName:@"transfer_vertex"];
+  clear_vertex_function_ = [library newFunctionWithName:@"clear_vertex"];
+  clear_fragment_function_float_ = [library newFunctionWithName:@"clear_fragment_float"];
+  clear_fragment_function_uint_ = [library newFunctionWithName:@"clear_fragment_uint"];
+  // Reducing data resolves (kDataTargetMaxSize) at a draw resolution scale.
+  if (IsDrawResolutionScaled()) {
+    resolve_reduce_pipeline_.pipeline = [device
+        newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_reduce"]
+                                      error:&error];
+    if (!resolve_reduce_pipeline_.pipeline) {
+      REXGPU_ERROR("MetalRenderTargetCache: Failed to create the resolve reduction pipeline: {}",
+                   error ? error.localizedDescription.UTF8String : "unknown error");
+      Shutdown();
+      return false;
+    }
+    resolve_reduce_pipeline_.threads_per_threadgroup = MTLSizeMake(64, 1, 1);
+  }
+  // Resolves straight from render targets (gfx = hle).
+  if (hle::HleGraphicsEnabled()) {
+    std::pair<ComputePipeline*, NSString*> resolve_from_render_target_pipelines[] = {
+        {&resolve_from_render_target_float_pipeline_, @"resolve_from_render_target_float"},
+        {&resolve_from_render_target_uint_pipeline_, @"resolve_from_render_target_uint"},
+        {&resolve_from_render_target_64bpp_pipeline_, @"resolve_from_render_target_64bpp"},
+        {&resolve_compare_pipeline_, @"resolve_compare"},
+        {&resolve_from_render_target_depth_pipeline_, @"resolve_from_render_target_depth"},
+    };
+    // Functions with a function constant are specialized, here with resolve_to_texture false.
+    MTLFunctionConstantValues* to_memory_values = [MTLFunctionConstantValues new];
+    bool to_memory_to_texture = false;
+    [to_memory_values setConstantValue:&to_memory_to_texture type:MTLDataTypeBool atIndex:0];
+    for (const auto& [pipeline, name] : resolve_from_render_target_pipelines) {
+      id<MTLFunction> function = [library newFunctionWithName:name
+                                               constantValues:to_memory_values
+                                                        error:&error];
+      pipeline->pipeline =
+          function ? [device newComputePipelineStateWithFunction:function error:&error] : nil;
+      if (!pipeline->pipeline) {
+        REXGPU_ERROR("MetalRenderTargetCache: Failed to create the {} pipeline: {}",
+                     name.UTF8String,
+                     error ? error.localizedDescription.UTF8String : "unknown error");
+        Shutdown();
+        return false;
+      }
+      pipeline->threads_per_threadgroup = MTLSizeMake(8, 8, 1);
+    }
+    // The variants writing textures (resolve_to_texture), with the function constant set.
+    MTLFunctionConstantValues* to_texture_values = [MTLFunctionConstantValues new];
+    bool to_texture = true;
+    [to_texture_values setConstantValue:&to_texture type:MTLDataTypeBool atIndex:0];
+    std::pair<ComputePipeline*, NSString*> resolve_to_texture_pipelines[] = {
+        {&resolve_to_texture_float_pipeline_, @"resolve_from_render_target_float"},
+        {&resolve_to_texture_uint_pipeline_, @"resolve_from_render_target_uint"},
+        {&resolve_to_texture_64bpp_pipeline_, @"resolve_from_render_target_64bpp"},
+        {&resolve_to_texture_depth_pipeline_, @"resolve_from_render_target_depth"},
+    };
+    for (const auto& [pipeline, name] : resolve_to_texture_pipelines) {
+      id<MTLFunction> function = [library newFunctionWithName:name
+                                               constantValues:to_texture_values
+                                                        error:&error];
+      pipeline->pipeline =
+          function ? [device newComputePipelineStateWithFunction:function error:&error] : nil;
+      if (!pipeline->pipeline) {
+        REXGPU_ERROR("MetalRenderTargetCache: Failed to create the {} pipeline writing textures: {}",
+                     name.UTF8String,
+                     error ? error.localizedDescription.UTF8String : "unknown error");
+        Shutdown();
+        return false;
+      }
+      pipeline->threads_per_threadgroup = MTLSizeMake(8, 8, 1);
+    }
+  }
+
+  // Depth transfers write depth and, through stencil export, stencil.
+  {
+    MTLDepthStencilDescriptor* descriptor = [MTLDepthStencilDescriptor new];
+    descriptor.depthCompareFunction = REXCVAR_GET(depth_transfer_not_equal_test)
+                                          ? MTLCompareFunctionNotEqual
+                                          : MTLCompareFunctionAlways;
+    descriptor.depthWriteEnabled = YES;
+    MTLStencilDescriptor* stencil = [MTLStencilDescriptor new];
+    stencil.stencilCompareFunction = MTLCompareFunctionAlways;
+    stencil.stencilFailureOperation = MTLStencilOperationKeep;
+    stencil.depthFailureOperation = MTLStencilOperationReplace;
+    stencil.depthStencilPassOperation = MTLStencilOperationReplace;
+    stencil.readMask = 0xFF;
+    stencil.writeMask = 0xFF;
+    descriptor.frontFaceStencil = stencil;
+    descriptor.backFaceStencil = stencil;
+    transfer_depth_stencil_state_depth_ = [device newDepthStencilStateWithDescriptor:descriptor];
+  }
+  // Resolve clears replace depth and stencil with the clear value (the reference).
+  {
+    MTLDepthStencilDescriptor* descriptor = [MTLDepthStencilDescriptor new];
+    descriptor.depthCompareFunction = MTLCompareFunctionAlways;
+    descriptor.depthWriteEnabled = YES;
+    MTLStencilDescriptor* stencil = [MTLStencilDescriptor new];
+    stencil.stencilCompareFunction = MTLCompareFunctionAlways;
+    stencil.stencilFailureOperation = MTLStencilOperationReplace;
+    stencil.depthFailureOperation = MTLStencilOperationReplace;
+    stencil.depthStencilPassOperation = MTLStencilOperationReplace;
+    stencil.readMask = 0xFF;
+    stencil.writeMask = 0xFF;
+    descriptor.frontFaceStencil = stencil;
+    descriptor.backFaceStencil = stencil;
+    clear_depth_stencil_state_ = [device newDepthStencilStateWithDescriptor:descriptor];
+  }
+
+  last_update_render_pass_ = MetalRenderPass();
+  last_update_render_pass_formats_ = MetalRenderPassFormats();
+
+  InitializeCommon();
+  return true;
+}
+
+void MetalRenderTargetCache::Shutdown(bool from_destructor) {
+  // Render targets are plain textures here, but are destroyed before the rest for the same order
+  // as the other backends.
+  DestroyAllRenderTargets(true);
+
+  dump_pipelines_.clear();
+  clear_pipelines_.clear();
+  transfer_pipelines_.clear();
+  transfer_shaders_.clear();
+  transfer_depth_stencil_state_depth_ = nil;
+  clear_depth_stencil_state_ = nil;
+  transfer_vertex_function_ = nil;
+  clear_vertex_function_ = nil;
+  clear_fragment_function_float_ = nil;
+  clear_fragment_function_uint_ = nil;
+  host_depth_store_pipeline_ = ComputePipeline();
+  resolve_reduce_pipeline_ = ComputePipeline();
+  resolve_from_render_target_float_pipeline_ = ComputePipeline();
+  resolve_from_render_target_uint_pipeline_ = ComputePipeline();
+  resolve_from_render_target_64bpp_pipeline_ = ComputePipeline();
+  resolve_compare_pipeline_ = ComputePipeline();
+  resolve_from_render_target_depth_pipeline_ = ComputePipeline();
+  resolve_to_texture_float_pipeline_ = ComputePipeline();
+  resolve_to_texture_uint_pipeline_ = ComputePipeline();
+  resolve_to_texture_64bpp_pipeline_ = ComputePipeline();
+  resolve_to_texture_depth_pipeline_ = ComputePipeline();
+  resolve_in_render_pass_pipelines_.clear();
+  for (ComputePipeline& pipeline : resolve_copy_pipelines_) {
+    pipeline = ComputePipeline();
+  }
+  edram_buffer_ = nil;
+  edram_buffer_guest_ = nil;
+  last_update_render_pass_ = MetalRenderPass();
+
+  if (!from_destructor) {
+    ShutdownCommon();
+  }
+}
+
+void MetalRenderTargetCache::ClearCache() {
+  // The attachments of the last update may be destroyed by the common ClearCache.
+  last_update_render_pass_ = MetalRenderPass();
+  last_update_render_pass_formats_ = MetalRenderPassFormats();
+  RenderTargetCache::ClearCache();
+}
