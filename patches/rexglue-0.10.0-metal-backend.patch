diff --git a/src/input/pad_remap.cpp b/src/input/pad_remap.cpp
new file mode 100644
index 0000000..27199ec
--- /dev/null
+++ b/src/input/pad_remap.cpp
@@ -0,0 +1,186 @@
+/**
+ * @file        input/pad_remap.cpp
+ * @brief       Controller buttons acting as other buttons (rex/input/pad_remap.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/input/pad_remap.h>
+
+#include <algorithm>
+#include <atomic>
+#include <map>
+#include <mutex>
+
+#include <rex/cvar.h>
+
+REXCVAR_DEFINE_BOOL(pad_custom, false, "Input",
+                    "Controllers use the player's own layout (pad_remap) instead of the game's");
+REXCVAR_DEFINE_STRING(pad_remap, "a,b,x,y,lb,rb,lt,rt,l3,r3,back,start,up,down,left,right", "Input",
+                      "For each control of a controller (A, B, X, Y, LB, RB, LT, RT, L3, R3, Back, "
+                      "Start, D-pad up, down, left, right), the control it acts as while pad_custom "
+                      "is on");
+
+namespace rex::input {
+
+namespace {
+
+constexpr std::string_view kNames[kPadControlCount] = {
+    "a", "b", "x", "y", "lb", "rb", "lt", "rt", "l3", "r3", "back", "start", "up", "down", "left", "right",
+};
+
+// The XInput button of each control; 0 for the triggers, which are axes.
+constexpr uint16_t kButtons[kPadControlCount] = {
+    X_INPUT_GAMEPAD_A,
+    X_INPUT_GAMEPAD_B,
+    X_INPUT_GAMEPAD_X,
+    X_INPUT_GAMEPAD_Y,
+    X_INPUT_GAMEPAD_LEFT_SHOULDER,
+    X_INPUT_GAMEPAD_RIGHT_SHOULDER,
+    0,
+    0,
+    X_INPUT_GAMEPAD_LEFT_THUMB,
+    X_INPUT_GAMEPAD_RIGHT_THUMB,
+    X_INPUT_GAMEPAD_BACK,
+    X_INPUT_GAMEPAD_START,
+    X_INPUT_GAMEPAD_DPAD_UP,
+    X_INPUT_GAMEPAD_DPAD_DOWN,
+    X_INPUT_GAMEPAD_DPAD_LEFT,
+    X_INPUT_GAMEPAD_DPAD_RIGHT,
+};
+
+// XInput's published trigger threshold (XINPUT_GAMEPAD_TRIGGER_THRESHOLD).
+constexpr uint8_t kTriggerThreshold = 30;
+
+std::string_view Trim(std::string_view s) {
+  while (!s.empty() && s.front() == ' ') s.remove_prefix(1);
+  while (!s.empty() && s.back() == ' ') s.remove_suffix(1);
+  return s;
+}
+
+bool IsTrigger(PadControl control) {
+  return control == PadControl::kLeftTrigger || control == PadControl::kRightTrigger;
+}
+
+// Whether physical control `i` is pressed: a button down, or a trigger past the threshold.
+bool IsDown(const X_INPUT_GAMEPAD& pad, size_t i) {
+  const auto control = static_cast<PadControl>(i);
+  if (control == PadControl::kLeftTrigger) return pad.left_trigger > kTriggerThreshold;
+  if (control == PadControl::kRightTrigger) return pad.right_trigger > kTriggerThreshold;
+  return (pad.buttons & kButtons[i]) != 0;
+}
+
+std::atomic<bool (*)()> layout_query{nullptr};
+
+// Per controller: each physical control's press as of the last read, and what it acts as while it
+// stays pressed.
+struct HeldControls {
+  std::array<bool, kPadControlCount> down{};
+  PadLayout acting = IdentityPadLayout();
+};
+std::mutex held_mutex;
+std::map<DeviceId, HeldControls> held;
+
+}  // namespace
+
+PadLayout IdentityPadLayout() {
+  PadLayout layout;
+  for (size_t i = 0; i < kPadControlCount; ++i) {
+    layout[i] = static_cast<PadControl>(i);
+  }
+  return layout;
+}
+
+std::string_view PadControlName(PadControl control) {
+  const size_t i = static_cast<size_t>(control);
+  return i < kPadControlCount ? kNames[i] : std::string_view();
+}
+
+PadLayout ParsePadLayout(std::string_view text) {
+  PadLayout layout = IdentityPadLayout();
+  for (size_t i = 0; i < kPadControlCount && !text.empty(); ++i) {
+    const size_t comma = text.find(',');
+    const std::string_view name = Trim(text.substr(0, comma));
+    text = comma == std::string_view::npos ? std::string_view() : text.substr(comma + 1);
+    const auto* found = std::find(std::begin(kNames), std::end(kNames), name);
+    if (found != std::end(kNames)) {
+      layout[i] = static_cast<PadControl>(found - std::begin(kNames));
+    }
+  }
+  return layout;
+}
+
+std::string FormatPadLayout(const PadLayout& layout) {
+  std::string text;
+  for (size_t i = 0; i < kPadControlCount; ++i) {
+    if (i) text += ',';
+    text += PadControlName(layout[i]);
+  }
+  return text;
+}
+
+PadLayout CurrentPadLayout() {
+  if (!REXCVAR_GET(pad_custom)) {
+    return IdentityPadLayout();
+  }
+  // Parsed again only when the setting changes: this runs on every controller poll.
+  static std::mutex mutex;
+  static std::string parsed_text;
+  static PadLayout parsed = IdentityPadLayout();
+  const std::string& text = REXCVAR_GET(pad_remap);
+  std::lock_guard lock(mutex);
+  if (text != parsed_text) {
+    parsed_text = text;
+    parsed = ParsePadLayout(text);
+  }
+  return parsed;
+}
+
+void ApplyPadLayout(const PadLayout& layout, X_INPUT_GAMEPAD& pad) {
+  const uint16_t in_buttons = pad.buttons;
+  const uint8_t in_triggers[2] = {pad.left_trigger, pad.right_trigger};
+  uint16_t buttons = in_buttons & X_INPUT_GAMEPAD_GUIDE;
+  uint8_t triggers[2] = {0, 0};
+  for (size_t i = 0; i < kPadControlCount; ++i) {
+    const auto physical = static_cast<PadControl>(i);
+    const PadControl logical = layout[i];
+    uint8_t travel = 0;
+    if (IsTrigger(physical)) {
+      travel = in_triggers[physical == PadControl::kRightTrigger];
+    } else if (in_buttons & kButtons[i]) {
+      travel = 0xFF;
+    }
+    if (IsTrigger(logical)) {
+      uint8_t& out = triggers[logical == PadControl::kRightTrigger];
+      out = std::max(out, travel);
+    } else if (travel > kTriggerThreshold) {
+      buttons |= kButtons[static_cast<size_t>(logical)];
+    }
+  }
+  pad.buttons = buttons;
+  pad.left_trigger = triggers[0];
+  pad.right_trigger = triggers[1];
+}
+
+void SetPadLayoutQuery(bool (*in_play)()) {
+  layout_query.store(in_play, std::memory_order_relaxed);
+}
+
+void ApplyPadLayoutInPlay(DeviceId id, const PadLayout& layout, X_INPUT_GAMEPAD& pad) {
+  bool (*const in_play)() = layout_query.load(std::memory_order_relaxed);
+  const bool playing = !in_play || in_play();
+  std::lock_guard lock(held_mutex);
+  HeldControls& controls = held[id];
+  for (size_t i = 0; i < kPadControlCount; ++i) {
+    const bool down = IsDown(pad, i);
+    // A released control follows what is shown now; a held one keeps what it was pressed as.
+    if (!down || !controls.down[i]) {
+      controls.acting[i] = playing ? layout[i] : static_cast<PadControl>(i);
+    }
+    controls.down[i] = down;
+  }
+  ApplyPadLayout(controls.acting, pad);
+}
+
+}  // namespace rex::input
