+uint32_t RenderTargetCache::GetRenderTargetsOverwrittenByClear(
+    uint32_t depth_and_color_rts_used_bits, reg::RB_DEPTHCONTROL normalized_depth_control,
+    uint32_t normalized_color_mask, uint32_t pitch_pixels, uint32_t height_used,
+    const Shader& vertex_shader) {
+  if (!ClearCoversRange(pitch_pixels, height_used, vertex_shader)) {
+    return 0;
+  }
+  return GetRenderTargetsWrittenByClear(depth_and_color_rts_used_bits, normalized_depth_control,
+                                        normalized_color_mask);
+}
+
+uint32_t RenderTargetCache::GetRenderTargetsWrittenByClear(
+    uint32_t depth_and_color_rts_used_bits, reg::RB_DEPTHCONTROL normalized_depth_control,
+    uint32_t normalized_color_mask) const {
+  const RegisterFile& regs = register_file();
+  uint32_t overwritten_bits = 0;
+  // Depth and stencil: both written everywhere the clear draws, whatever was there.
+  if (depth_and_color_rts_used_bits & 1) {
+    auto stencil_ref_mask = regs.Get<reg::RB_STENCILREFMASK>();
+    bool depth_written = normalized_depth_control.z_enable && normalized_depth_control.z_write_enable &&
+                         normalized_depth_control.zfunc == xenos::CompareFunction::kAlways;
+    bool stencil_written = normalized_depth_control.stencil_enable &&
+                           normalized_depth_control.stencilfunc == xenos::CompareFunction::kAlways &&
+                           normalized_depth_control.stencilzpass == xenos::StencilOp::kReplace &&
+                           stencil_ref_mask.stencilwritemask == 0xFF;
+    if (depth_written && stencil_written) {
+      overwritten_bits |= 1;
+    }
+  }
+  // Color: every channel written, without blending, and nothing discarded by alpha testing.
+  auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if (!color_control.alpha_test_enable && !color_control.alpha_to_mask_enable) {
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      uint32_t rt_bit_index = 1 + i;
+      if (!(depth_and_color_rts_used_bits & (uint32_t(1) << rt_bit_index)) ||
+          ((normalized_color_mask >> (4 * i)) & 0b1111) != 0b1111) {
+        continue;
+      }
+      auto blend_control =
+          regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+      if (blend_control.color_srcblend == xenos::BlendFactor::kOne &&
+          blend_control.color_destblend == xenos::BlendFactor::kZero &&
+          blend_control.color_comb_fcn == xenos::BlendOp::kAdd &&
+          blend_control.alpha_srcblend == xenos::BlendFactor::kOne &&
+          blend_control.alpha_destblend == xenos::BlendFactor::kZero &&
+          blend_control.alpha_comb_fcn == xenos::BlendOp::kAdd) {
+        overwritten_bits |= uint32_t(1) << rt_bit_index;
+      }
+    }
+  }
+  return overwritten_bits;
+}
+
+void RenderTargetCache::LogClearKeepingContents(uint32_t rt_bit_index,
+                                                reg::RB_DEPTHCONTROL normalized_depth_control,
+                                                uint32_t normalized_color_mask,
+                                                uint32_t pitch_pixels, uint32_t height_used,
+                                                const Shader& vertex_shader) {
+  // Why the guest's clear still needs the target's old contents, logged once per reason: the cases
+  // the HLE path does not handle yet.
+  const RegisterFile& regs = register_file();
+  const char* reason;
+  if (last_update_has_clear_cutout_) {
+    reason = "the clear covers part of the target: its rectangle is cut out of the transfers";
+  } else if (!hle::InWholeSurfaceClear()) {
+    reason = "the clear has a rectangle";
+  } else if (!ClearCoversRange(pitch_pixels, height_used, vertex_shader)) {
+    reason = "the clear's rectangle or scissor is smaller than the rows that change owner";
+  } else if (rt_bit_index == 0) {
+    bool depth_written = normalized_depth_control.z_enable &&
+                         normalized_depth_control.z_write_enable &&
+                         normalized_depth_control.zfunc == xenos::CompareFunction::kAlways;
+    reason = depth_written ? "depth cleared, stencil kept" : "stencil cleared, depth kept";
+  } else if (((normalized_color_mask >> (4 * (rt_bit_index - 1))) & 0b1111) != 0b1111) {
+    reason = "color cleared with some channels masked";
+  } else if (regs.Get<reg::RB_COLORCONTROL>().alpha_test_enable ||
+             regs.Get<reg::RB_COLORCONTROL>().alpha_to_mask_enable) {
+    reason = "color cleared with alpha testing";
+  } else {
+    reason = "color cleared with blending";
+  }
+  static std::mutex mutex;
+  static std::set<std::string> logged;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (logged.insert(reason).second) {
+    REXGPU_INFO("HLE graphics: a clear keeps the old contents of a render target ({}); its "
+                "transfers stay",
+                reason);
+  }
+}
