+/**
+ * @file        graphics/metal/metal_pipeline_cache.h
+ * @brief       Guest shader translation and render pipeline states for the Metal backend
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <deque>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include <rex/graphics/pipeline/shader/spirv.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/platform.h>
+#include <rex/string/buffer.h>
+#include <rex/thread.h>
+
+#import <Metal/Metal.h>
+
+#include "../pipeline/shader/xsc/xsc_translator.h"
+#include "metal_spirv.h"
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+class MetalRenderTargetCache;
+
+// Argument table indices shared by every translated guest shader, in both stages.
+constexpr uint32_t kMetalBufferSharedMemory = 0;
+// The five constant buffers follow, in SpirvShaderTranslator::ConstantBuffer order.
+constexpr uint32_t kMetalBufferConstantsFirst = 1;
+// SPIRV-Cross's buffer of runtime array sizes, when a shader needs it, is at kMslBufferSizesIndex.
+// The debug counters of XSC pixel shaders with xsc_debug_color_range.
+constexpr uint32_t kMetalBufferXscDebugCounters = 6;
+
+class MetalShader : public SpirvShader {
+ public:
+  class MetalTranslation : public SpirvTranslation {
+   public:
+    explicit MetalTranslation(MetalShader& shader, uint64_t modification)
+        : SpirvTranslation(shader, modification) {}
+    // Converts the translated SPIR-V to MSL and compiles it on first use, from any thread (the
+    // translation must be done). Vertex shaders have a separate variant for pipelines without
+    // rasterization.
+    id<MTLFunction> GetOrCreateFunction(id<MTLDevice> device, bool rasterization_disabled = false);
+    // Whether the function reads buffer sizes at kMslBufferSizesIndex (valid after creation).
+    bool needs_buffer_sizes() const { return needs_buffer_sizes_; }
+    // Whether the translated binary is MSL from the Xenos shader compiler rather than SPIR-V.
+    bool is_xsc() const { return is_xsc_; }
+    void set_is_xsc(bool is_xsc) { is_xsc_ = is_xsc; }
+
+    // Where the translation is: translations may be made on the creation threads, so the command
+    // processor thread reads the translation's results only once this says kTranslated.
+    enum class TranslationState : uint8_t { kNotTranslated, kQueued, kTranslated };
+    std::atomic<TranslationState>& translation_state() { return translation_state_; }
+
+   private:
+    std::atomic<TranslationState> translation_state_{TranslationState::kNotTranslated};
+    // Pipelines may be created on several threads at once.
+    std::mutex function_mutex_;
+    // Indexed by whether rasterization is disabled.
+    id<MTLFunction> functions_[2] = {nil, nil};
+    bool functions_failed_[2] = {false, false};
+    bool needs_buffer_sizes_ = false;
+    bool is_xsc_ = false;
+  };
+
+  MetalShader(xenos::ShaderType shader_type, uint64_t ucode_data_hash,
+              const uint32_t* ucode_dwords, size_t ucode_dword_count)
+      : SpirvShader(shader_type, ucode_data_hash, ucode_dwords, ucode_dword_count) {}
+
+ protected:
+  Translation* CreateTranslationInstance(uint64_t modification) override;
+};
+
+// Render target formats of the render pass a draw goes to.
+struct MetalRenderPassFormats {
+  std::array<MTLPixelFormat, xenos::kMaxColorRenderTargets> color = {
+      MTLPixelFormatInvalid, MTLPixelFormatInvalid, MTLPixelFormatInvalid,
+      MTLPixelFormatInvalid};
+  MTLPixelFormat depth = MTLPixelFormatInvalid;
+  bool depth_has_stencil = false;
+  uint32_t sample_count = 1;
+};
+
+// Fixed-function state that is not part of the pipeline in Metal, set on the encoder per draw.
+struct MetalDrawState {
+  MTLPrimitiveType primitive_type = MTLPrimitiveTypeTriangle;
+  MTLCullMode cull_mode = MTLCullModeNone;
+  MTLWinding winding = MTLWindingCounterClockwise;
+  MTLTriangleFillMode fill_mode = MTLTriangleFillModeFill;
+  MTLDepthClipMode depth_clip_mode = MTLDepthClipModeClip;
+  id<MTLDepthStencilState> depth_stencil_state = nil;
+  // A draw that only has side effects in the vertex shader (memexport).
+  bool rasterization_disabled = false;
+};
+
+class MetalPipelineCache {
+ public:
+  MetalPipelineCache(MetalCommandProcessor& command_processor, const RegisterFile& register_file,
+                     MetalRenderTargetCache& render_target_cache);
+  ~MetalPipelineCache();
+
+  bool Initialize();
+  void Shutdown();
+
+  // Loads the guest shaders and pipelines stored by earlier runs, translates them, and queues their
+  // creation on the pipeline creation threads, so they are ready by the time the game draws with
+  // them. New pipelines are appended to the storage as they appear. Called on the command
+  // processor thread.
+  void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id);
+  void ShutdownShaderStorage();
+
+  MetalShader* LoadShader(xenos::ShaderType shader_type, const uint32_t* host_address,
+                          uint32_t dword_count);
+  void AnalyzeShaderUcode(Shader& shader) {
+    shader.AnalyzeUcode(ucode_disasm_buffer_);
+  }
+  // The Xenos shader compiler, or nullptr if shader_compiler is not xsc.
+  const xsc::XscShaderTranslator* xsc_translator() const { return xsc_translator_.get(); }
+
+  SpirvShaderTranslator::Modification GetCurrentVertexShaderModification(
+      const Shader& shader, Shader::HostVertexShaderType host_vertex_shader_type,
+      uint32_t interpolator_mask, bool ps_param_gen_used) const;
+  SpirvShaderTranslator::Modification GetCurrentPixelShaderModification(
+      const Shader& shader, uint32_t interpolator_mask, uint32_t param_gen_pos,
+      reg::RB_DEPTHCONTROL normalized_depth_control) const;
+
+  // Makes sure a draw's shaders are translated. With allow_async, a shader not translated yet is
+  // left to the creation threads and pending_out is set: the draw is to be skipped. Without it,
+  // they are translated here. Returns false if a shader cannot be translated.
+  bool PrepareShadersForDraw(MetalShader::MetalTranslation* vertex_shader,
+                             MetalShader::MetalTranslation* pixel_shader, bool allow_async,
+                             bool& pending_out);
+
+  // The render pipeline state and the per-draw encoder state for the current guest state. With
+  // allow_async, a pipeline that is not created yet is left to the creation threads and
+  // pending_out is set: the draw is to be skipped.
+  bool ConfigurePipeline(MetalShader::MetalTranslation* vertex_shader,
+                         MetalShader::MetalTranslation* pixel_shader,
+                         const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+                         reg::RB_DEPTHCONTROL normalized_depth_control,
+                         uint32_t normalized_color_mask, const MetalRenderPassFormats& formats,
+                         bool allow_async, __strong id<MTLRenderPipelineState>& pipeline_out,
+                         MetalDrawState& state_out, bool& pending_out);
+
+ private:
+  // Everything that makes a render pipeline state distinct: hashed as raw bytes for the lookup,
+  // and written as is to the pipeline storage. Update kVersion if anything is changed.
+  struct PipelineDescription {
+    uint64_t vertex_shader_hash;
+    uint64_t vertex_shader_modification;
+    // Zero when there is no fragment function (no pixel shader, or rasterization disabled).
+    uint64_t pixel_shader_hash;
+    uint64_t pixel_shader_modification;
+    std::array<uint32_t, xenos::kMaxColorRenderTargets> color_formats;
+    uint32_t depth_format;
+    uint32_t stencil_format;
+    uint32_t sample_count;
+    // Per color target: write mask (4 bits), blending enabled (1), then factors and ops.
+    std::array<uint32_t, xenos::kMaxColorRenderTargets> blend;
+    uint32_t alpha_to_coverage;
+    uint32_t rasterization_disabled;
+    uint32_t topology_class;
+
+    static constexpr uint32_t kVersion = 1;
+  };
+  static_assert(sizeof(PipelineDescription) == 88, "PipelineDescription is stored as raw bytes");
+
+  // A render pipeline state made on the command processor thread or on a creation thread.
+  struct Pipeline {
+    enum class State : uint32_t { kPending, kReady, kFailed };
+
+    PipelineDescription description;
+    MetalShader::MetalTranslation* vertex_shader = nullptr;
+    // nullptr when the description has no pixel shader.
+    MetalShader::MetalTranslation* pixel_shader = nullptr;
+    // Held while the state object is being created.
+    std::mutex creation_mutex;
+    std::atomic<State> state{State::kPending};
+    // Valid once state is kReady.
+    id<MTLRenderPipelineState> state_object = nil;
+    // Queued for a draw that is waiting for it (rather than only preloaded).
+    bool queued_for_draw = false;
+    // Counted in the graphics system's shader compilation progress.
+    std::atomic<bool> counted_in_progress{false};
+  };
+
+  // The guest shader storage (.xsh) record header, shared with the Vulkan backend.
+  REXPACKEDSTRUCT(ShaderStoredHeader, {
+    uint64_t ucode_data_hash;
+
+    uint32_t ucode_dword_count : 31;
+    xenos::ShaderType type : 1;
+
+    static constexpr uint32_t kVersion = 0x20201219;
+  });
+
+  // Translates a shader modification if not done yet, on any thread (one translation at a time).
+  // With compile_function, it then queues the compilation of its Metal function, so the function
+  // is ready before a pipeline needs it; the preload leaves that to the pipelines it queues.
+  bool EnsureTranslated(MetalShader::MetalTranslation& translation, bool compile_function = true);
+  // Creates the state object of a pending pipeline (on any thread). Returns whether it is ready.
+  bool EnsurePipelineCreated(Pipeline& pipeline);
+  // Queues a pending pipeline for the creation threads, a draw's pipelines before preloaded ones.
+  void QueuePipelineCreation(Pipeline& pipeline, bool for_draw);
+  // Queues a shader translation a draw is waiting for, and the compilation of a translated
+  // shader's Metal function, for the creation threads.
+  void QueueTranslation(MetalShader::MetalTranslation& translation);
+  void QueueFunctionCompilation(MetalShader::MetalTranslation& translation);
+  void CreationThread();
+  void StorePipeline(const Pipeline& pipeline);
+  struct DepthStencilKey {
+    uint32_t depth_compare;
+    uint32_t depth_write;
+    uint32_t stencil_enable;
+    uint32_t front;
+    uint32_t back;
+    uint32_t read_mask_front;
+    uint32_t write_mask_front;
+    uint32_t read_mask_back;
+    uint32_t write_mask_back;
+  };
+
+  id<MTLRenderPipelineState> CreatePipeline(const PipelineDescription& description,
+                                            MetalShader::MetalTranslation* vertex_shader,
+                                            MetalShader::MetalTranslation* pixel_shader);
+  id<MTLDepthStencilState> GetDepthStencilState(const DepthStencilKey& key);
+
+  MetalCommandProcessor& command_processor_;
+  const RegisterFile& register_file_;
+  MetalRenderTargetCache& render_target_cache_;
+
+  std::unique_ptr<SpirvShaderTranslator> shader_translator_;
+  // The Xenos shader compiler, if shader_compiler is xsc.
+  std::unique_ptr<xsc::XscShaderTranslator> xsc_translator_;
+  rex::string::StringBuffer ucode_disasm_buffer_;
+  // The translators keep state per translation, so translations are made one at a time, whichever
+  // thread makes them.
+  std::mutex translation_mutex_;
+
+  std::unordered_map<uint64_t, MetalShader*> shaders_;
+  // By the hash of the description. Only the command processor thread adds to it or looks in it;
+  // the creation threads get pointers to the pipelines through the queues.
+  std::unordered_map<uint64_t, std::unique_ptr<Pipeline>> pipelines_;
+  std::unordered_map<uint64_t, id<MTLDepthStencilState>> depth_stencil_states_;
+
+  // Pipeline creation threads (async_shader_compilation and the storage preload).
+  std::vector<std::unique_ptr<rex::thread::Thread>> creation_threads_;
+  std::mutex creation_queue_mutex_;
+  std::condition_variable creation_queue_condition_;
+  // Taken in this order: translations draws wait for, pipelines draws wait for, Metal functions
+  // of translated shaders, preloaded pipelines.
+  std::deque<MetalShader::MetalTranslation*> translation_queue_;
+  std::deque<Pipeline*> creation_queue_for_draws_;
+  std::deque<MetalShader::MetalTranslation*> function_queue_;
+  std::deque<Pipeline*> creation_queue_preload_;
+  bool creation_threads_shutdown_ = false;
+
+  // Shader storage, written as new shaders and pipelines appear.
+  FILE* shader_storage_file_ = nullptr;
+  FILE* pipeline_storage_file_ = nullptr;
+  std::unordered_set<uint64_t> stored_shaders_;
+};
+
+}  // namespace rex::graphics::metal
