+// resolve_store_32bpp for a texture.
+void resolve_texture_32bpp(uint2 pixel, uint value, texture2d<uint, access::write> texture,
+                           constant ResolveFromRenderTargetConstants& constants) {
+  if (constants.swap_red_blue != 0u) {
+    value = (value & 0xFF00FF00u) | ((value >> 16) & 0xFFu) | ((value & 0xFFu) << 16);
+  }
+  resolve_texture_write(pixel, uint4(resolve_swap_endian(value, constants.endian), 0u, 0u, 0u),
+                        texture, constants);
+}
+void resolve_store_32bpp(uint2 pixel, uint value, device uint* dest, device atomic_uint* result,
+                         constant ResolveFromRenderTargetConstants& constants) {
+  if (constants.swap_red_blue != 0u) {
+    value = (value & 0xFF00FF00u) | ((value >> 16) & 0xFFu) | ((value & 0xFFu) << 16);
+  }
+  resolve_store_dword(resolve_dest_address(pixel, 2, constants),
+                      resolve_swap_endian(value, constants.endian), dest, result, constants);
+}
+kernel void resolve_from_render_target_float(
+    uint2 pixel [[thread_position_in_grid]],
+    texture2d<float, access::read> source [[texture(0)]],
+    device uint* dest [[buffer(1)]],
+    constant ResolveFromRenderTargetConstants& constants [[buffer(2)]],
+    device atomic_uint* result [[buffer(3)]],
+    texture2d<uint, access::write> dest_texture [[texture(2)]]) {
+  if (pixel.x >= constants.width || pixel.y >= constants.height) {
+    return;
+  }
+  uint2 source_pixel;
+  if (!resolve_source_pixel(pixel, constants, source_pixel)) {
+    return;
+  }
+  float4 color = source.read(source_pixel);
+  uint value;
+  if (constants.packing == 3u) {
+    uint4 components = uint4(color * float4(1023.0, 1023.0, 1023.0, 3.0) + 0.5);
+    value = components.x | (components.y << 10) | (components.z << 20) | (components.w << 30);
+  } else if (constants.packing == 6u) {
+    value = resolve_pack_2_10_10_10_float(color);
+  } else if (constants.packing == 8u) {
+    // The full 32bpp copy: the EDRAM's 7e3 bits unpacked, scaled, swapped and packed as the
+    // destination format (2_10_10_10 or 8_8_8_8). The swap is done here, not in the store.
+    float4 converted = resolve_unpack_2_10_10_10_float(resolve_pack_2_10_10_10_float(color)) *
+                       constants.exp_scale;
+    if (constants.swap_red_blue != 0u) {
+      converted = converted.zyxw;
+    }
+    if (constants.dest_format == 7u) {
+      uint4 components =
+          uint4(clamp(converted, float4(0.0), float4(1.0)) * float4(1023.0, 1023.0, 1023.0, 3.0) +
+                0.5);
+      value = components.x | (components.y << 10) | (components.z << 20) | (components.w << 30);
+    } else {
+      uint4 bytes = uint4(clamp(converted, float4(0.0), float4(1.0)) * 255.0 + 0.5);
+      value = bytes.x | (bytes.y << 8) | (bytes.z << 16) | (bytes.w << 24);
+    }
+    if (resolve_to_texture) {
+      resolve_texture_write(pixel, uint4(resolve_swap_endian(value, constants.endian), 0u, 0u, 0u),
+                            dest_texture, constants);
+      return;
+    }
+    resolve_store_dword(resolve_dest_address(pixel, 2, constants),
+                        resolve_swap_endian(value, constants.endian), dest, result, constants);
+    return;
+  } else {
+    uint4 bytes = uint4(color * 255.0 + 0.5);
+    value = bytes.x | (bytes.y << 8) | (bytes.z << 16) | (bytes.w << 24);
+  }
+  if (resolve_to_texture) {
+    resolve_texture_32bpp(pixel, value, dest_texture, constants);
+    return;
+  }
+  resolve_store_32bpp(pixel, value, dest, result, constants);
+}
+kernel void resolve_from_render_target_uint(
+    uint2 pixel [[thread_position_in_grid]],
+    texture2d<uint, access::read> source [[texture(0)]],
+    device uint* dest [[buffer(1)]],
+    constant ResolveFromRenderTargetConstants& constants [[buffer(2)]],
+    device atomic_uint* result [[buffer(3)]],
+    texture2d<uint, access::write> dest_texture [[texture(2)]]) {
+  if (pixel.x >= constants.width || pixel.y >= constants.height) {
+    return;
+  }
+  uint2 source_pixel;
+  if (!resolve_source_pixel(pixel, constants, source_pixel)) {
+    return;
+  }
+  uint4 texel = source.read(source_pixel);
+  uint value = constants.packing == 1u ? (texel.x & 0xFFFFu) | (texel.y << 16) : texel.x;
+  if (resolve_to_texture) {
+    resolve_texture_32bpp(pixel, value, dest_texture, constants);
+    return;
+  }
+  resolve_store_32bpp(pixel, value, dest, result, constants);
+}
+// A depth target's EDRAM bits, as the dump packs them (the 24-bit depth, unsigned normalized for
+// D24S8 or float 20e4 for D24FS8, above the 8-bit stencil), copied bitwise as the resolve's
+// format.
+kernel void resolve_from_render_target_depth(
+    uint2 pixel [[thread_position_in_grid]],
+    depth2d<float, access::read> source [[texture(0)]],
+    texture2d<uint, access::read> source_stencil [[texture(1)]],
+    device uint* dest [[buffer(1)]],
+    constant ResolveFromRenderTargetConstants& constants [[buffer(2)]],
+    device atomic_uint* result [[buffer(3)]],
+    texture2d<uint, access::write> dest_texture [[texture(2)]]) {
+  if (pixel.x >= constants.width || pixel.y >= constants.height) {
+    return;
+  }
+  uint2 source_pixel;
+  if (!resolve_source_pixel(pixel, constants, source_pixel)) {
+    return;
+  }
+  float source_depth = source.read(source_pixel);
+  uint depth;
+  if (constants.packing == 7u) {
+    depth = uint(rint(source_depth * 16777215.0));
+  } else {
+    // D24FS8: SpirvShaderTranslator::PreClampedDepthTo20e4 remapping 0...1 to 0...0.5, rounded
+    // to the nearest even (packing 10) or towards zero (9).
+    uint bits = as_type<uint>(source_depth);
+    uint biased = bits < 0x38000000u
+                      ? ((bits & 0x7FFFFFu) | 0x800000u) >> min(112u - (bits >> 23), 24u)
+                      : bits - (111u << 23);
+    if (constants.packing == 10u) {
+      biased += 3u + ((biased >> 3) & 1u);
+    }
+    depth = (biased >> 3) & 0xFFFFFFu;
+  }
+  uint stencil = source_stencil.read(source_pixel).r & 0xFFu;
+  if (resolve_to_texture) {
+    resolve_texture_32bpp(pixel, (depth << 8) | stencil, dest_texture, constants);
+    return;
+  }
+  resolve_store_32bpp(pixel, (depth << 8) | stencil, dest, result, constants);
+}
+// The conversion of the full 64bpp resolve copy, from the unpacked color, before the endianness.
+uint2 resolve_pack_64bpp(float4 color, constant ResolveFromRenderTargetConstants& constants) {
+  color *= constants.exp_scale;
+  if (constants.swap_red_blue != 0u) {
+    color = color.zyxw;
+  }
+  uint2 value;
+  if (constants.dest_format == 26u) {
+    uint4 components = uint4(clamp(color, float4(0.0), float4(1.0)) * 65535.0 + 0.5);
+    value = uint2(components.x | (components.y << 16), components.z | (components.w << 16));
+  } else {
+    value = uint2(as_type<uint>(half2(color.xy)), as_type<uint>(half2(color.zw)));
+  }
+  return value;
+}
+// The conversion and store of the full 64bpp resolve copy, from the unpacked color.
+void resolve_store_64bpp(uint2 pixel, float4 color, device uint* dest, device atomic_uint* result,
+                         constant ResolveFromRenderTargetConstants& constants) {
+  uint2 value = resolve_pack_64bpp(color, constants);
+  uint address = resolve_dest_address(pixel, 3, constants);
+  resolve_store_dword(address, resolve_swap_endian(value.x, constants.endian), dest, result,
+                      constants);
+  resolve_store_dword(address + 4u, resolve_swap_endian(value.y, constants.endian), dest, result,
+                      constants);
+}
+// 64 bits per pixel with a conversion: the 16-bit components (the render target's bits, through
+// an integer view) are unpacked as the EDRAM holds them, scaled by the exponent bias, swapped,
+// and packed in the destination format.
+kernel void resolve_from_render_target_64bpp(
+    uint2 pixel [[thread_position_in_grid]],
+    texture2d<uint, access::read> source [[texture(0)]],
+    device uint* dest [[buffer(1)]],
+    constant ResolveFromRenderTargetConstants& constants [[buffer(2)]],
+    device atomic_uint* result [[buffer(3)]],
+    texture2d<uint, access::write> dest_texture [[texture(2)]]) {
+  if (pixel.x >= constants.width || pixel.y >= constants.height) {
+    return;
+  }
+  uint2 source_pixel;
+  if (!resolve_source_pixel(pixel, constants, source_pixel)) {
+    return;
+  }
+  uint4 texel = source.read(source_pixel);
+  float4 color;
+  if (constants.packing == 4u) {
+    color = max(float4(-1.0), float4(int4(texel << 16) >> 16) * 0.0009765923023223876953125);
+  } else {
+    color = float4(float2(as_type<half2>((texel.x & 0xFFFFu) | (texel.y << 16))),
+                   float2(as_type<half2>((texel.z & 0xFFFFu) | (texel.w << 16))));
+  }
+  if (resolve_to_texture) {
+    uint2 value = resolve_pack_64bpp(color, constants);
+    resolve_texture_write(pixel,
+                          uint4(resolve_swap_endian(value.x, constants.endian),
+                                resolve_swap_endian(value.y, constants.endian), 0u, 0u),
+                          dest_texture, constants);
+    return;
+  }
+  resolve_store_64bpp(pixel, color, dest, result, constants);
+}
+// Compares the destination a resolve wrote with a copy made elsewhere (scratch, starting at the
+// address scratch_base), at the addresses of the resolve's pixels; the mismatches are counted in
+// result as in resolve_store_dword.
+kernel void resolve_compare(
+    uint2 pixel [[thread_position_in_grid]],
+    device uint* dest [[buffer(1)]],
+    constant ResolveFromRenderTargetConstants& constants [[buffer(2)]],
+    device atomic_uint* result [[buffer(3)]],
+    const device uint* scratch [[buffer(4)]]) {
+  if (pixel.x >= constants.width || pixel.y >= constants.height) {
+    return;
+  }
+  bool is_64bpp = constants.packing == 4u || constants.packing == 5u;
+  uint address = resolve_dest_address(pixel, is_64bpp ? 3 : 2, constants);
+  for (uint i = 0u; i < (is_64bpp ? 2u : 1u); ++i) {
+    uint dword_address = address + i * 4u;
+    uint memory_value = dest[dword_address >> 2];
+    uint scratch_value = scratch[(dword_address - constants.scratch_base) >> 2];
+    if (memory_value != scratch_value &&
+        atomic_fetch_add_explicit(result, 1u, memory_order_relaxed) == 0u) {
+      device uint* first_mismatch = (device uint*)result;
+      first_mismatch[1] = dword_address;
+      first_mismatch[2] = memory_value;
+      first_mismatch[3] = scratch_value;
+    }
+  }
+}
+)MSL";
+
+// The constants of resolve_from_render_target_* in kRenderTargetShaderSource.
+struct ResolveFromRenderTargetConstants {
+  uint32_t source_x;
+  uint32_t source_y;
+  uint32_t width;
+  uint32_t height;
+  uint32_t dest_x;
+  uint32_t dest_y;
+  uint32_t dest_pitch;
+  uint32_t dest_base;
+  uint32_t packing;
+  uint32_t endian;
+  uint32_t swap_red_blue;
+  uint32_t verify;
+  float exp_scale;
+  uint32_t dest_format;
+  uint32_t scratch_base;
+  uint32_t scale_x;
+  uint32_t scale_y;
+  uint32_t fill_x;
+  uint32_t fill_y;
+  uint32_t edram_base;
+  uint32_t edram_pitch;
+  uint32_t tile_width;
+  uint32_t tile_height;
+  uint32_t owner_base;
+  uint32_t owner_pitch;
+  uint32_t range_start;
+  uint32_t range_end;
+  uint32_t reduce_num_x;
+  uint32_t reduce_num_y;
+  uint32_t reduce_den;
+  uint32_t texture_endian;
+  uint32_t texture_conversion;
+};
+
+// The tile function of a resolve inside the render pass (appended to kRenderTargetShaderSource):
+// %TYPE% is the type the attachment reads as, %INDEX% its color index, %BODY% packs c (the pixel
+// of the source) and stores it like the resolve_from_render_target_* kernels.
+NSString* const kResolveInRenderPassSource = @R"MSL(
+struct ResolveTileAttachment {
+  %TYPE% color [[color(%INDEX%)]];
+};
+kernel void resolve_in_render_pass(
+    imageblock<ResolveTileAttachment, imageblock_layout_implicit> block,
+    ushort2 lid [[thread_position_in_threadgroup]],
+    ushort2 tile [[threadgroup_position_in_grid]],
+    ushort2 tile_size [[threads_per_threadgroup]],
+    device uint* dest [[buffer(1)]],
+    constant ResolveFromRenderTargetConstants& constants [[buffer(2)]],
+    device atomic_uint* result [[buffer(3)]]) {
+  uint2 position = uint2(tile) * uint2(tile_size) + uint2(lid);
+  uint2 origin = uint2(constants.source_x, constants.source_y);
+  if (any(position < origin)) {
+    return;
+  }
+  uint2 pixel = position - origin;
+  if (pixel.x >= constants.width || pixel.y >= constants.height) {
+    return;
+  }
+  %TYPE% c = block.read(lid).color;
+  %BODY%
+}
+)MSL";
+
+// What a resolve copies, for the encoder labels of GPU traces (gpu_debug_markers): the source
+// format, the size, the destination format and address, and a note.
+NSString* DescribeResolve(const draw_util::ResolveInfo& resolve_info, const char* what) {
+  const draw_util::ResolveEdramInfo& edram_info =
+      resolve_info.IsCopyingDepth() ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  return [NSString
+      stringWithFormat:@"%s: %s %u to %u, %ux%u at 0x%08X", what,
+                       resolve_info.IsCopyingDepth() ? "depth" : "color",
+                       uint32_t(edram_info.format),
+                       uint32_t(resolve_info.copy_dest_info.copy_dest_format),
+                       uint32_t(resolve_info.coordinate_info.width_div_8) << 3,
+                       uint32_t(resolve_info.height_div_8) << 3, resolve_info.copy_dest_base];
+}
+
+// The constants of a resolve written from its render target (see
+// MetalRenderTargetCache::GetNativeResolveSource), or false for a render target format the native
+// path does not handle.
+bool GetResolveFromRenderTargetConstants(const draw_util::ResolveInfo& resolve_info,
+                                         bool is_depth, uint32_t resource_format,
+                                         bool depth_float24_round,
+                                         ResolveFromRenderTargetConstants& constants) {
+  constants = {};
+  if (is_depth) {
+    constants.packing =
+        xenos::DepthRenderTargetFormat(resource_format) == xenos::DepthRenderTargetFormat::kD24S8
+            ? 7
+            : (depth_float24_round ? 10 : 9);
+  } else {
+  switch (xenos::ColorRenderTargetFormat(resource_format)) {
+    case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+      constants.packing = 0;
+      break;
+    case xenos::ColorRenderTargetFormat::k_16_16_FLOAT:
+      constants.packing = 1;
+      break;
+    case xenos::ColorRenderTargetFormat::k_32_FLOAT:
+      constants.packing = 2;
+      break;
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+      constants.packing = 3;
+      break;
+    case xenos::ColorRenderTargetFormat::k_16_16_16_16:
+      constants.packing = 4;
+      break;
+    case xenos::ColorRenderTargetFormat::k_16_16_16_16_FLOAT:
+      constants.packing = 5;
+      break;
+    case xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT:
+      // Bitwise, or the full copy's conversion of the 7e3 bits.
+      constants.packing =
+          resolve_info.copy_dest_info.copy_dest_exp_bias ||
+                  !xenos::IsColorResolveFormatBitwiseEquivalent(
+                      xenos::ColorRenderTargetFormat(resolve_info.color_edram_info.format),
+                      xenos::ColorFormat(resolve_info.copy_dest_info.copy_dest_format))
+              ? 8
+              : 6;
+      break;
+    default:
+      return false;
+  }
+  }
+  const draw_util::ResolveEdramInfo& edram_info =
+      resolve_info.IsCopyingDepth() ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  constants.scale_x = std::max(uint32_t(resolve_info.coordinate_info.draw_resolution_scale_x), 1u);
+  constants.scale_y = std::max(uint32_t(resolve_info.coordinate_info.draw_resolution_scale_y), 1u);
+  if (edram_info.fill_half_pixel_offset) {
+    constants.fill_x = constants.scale_x >> 1;
+    constants.fill_y = constants.scale_y >> 1;
+  }
+  constants.edram_base = edram_info.base_tiles;
+  constants.edram_pitch = edram_info.pitch_tiles;
+  constants.tile_width =
+      (xenos::kEdramTileWidthSamples >> uint32_t(edram_info.format_is_64bpp != 0)) *
+      constants.scale_x;
+  constants.tile_height = xenos::kEdramTileHeightSamples * constants.scale_y;
+  constants.owner_base = edram_info.base_tiles;
+  constants.owner_pitch = edram_info.pitch_tiles;
+  constants.range_start = 0;
+  constants.range_end = UINT32_MAX;
+  constants.source_x = (resolve_info.coordinate_info.edram_offset_x_div_8 << 3) * constants.scale_x;
+  constants.source_y = (resolve_info.coordinate_info.edram_offset_y_div_8 << 3) * constants.scale_y;
+  constants.width = (resolve_info.coordinate_info.width_div_8 << 3) * constants.scale_x;
+  constants.height = (resolve_info.height_div_8 << 3) * constants.scale_y;
+  constants.dest_x = resolve_info.copy_dest_coordinate_info.offset_x_div_8 << 3;
+  constants.dest_y = resolve_info.copy_dest_coordinate_info.offset_y_div_8 << 3;
+  constants.dest_pitch = resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32 << 5;
+  constants.dest_base = resolve_info.copy_dest_base;
+  constants.endian = uint32_t(resolve_info.copy_dest_info.copy_dest_endian);
+  constants.swap_red_blue = resolve_info.copy_dest_info.copy_dest_swap;
+  constants.exp_scale = std::ldexp(1.0f, int(resolve_info.copy_dest_info.copy_dest_exp_bias));
+  constants.dest_format = uint32_t(resolve_info.copy_dest_info.copy_dest_format);
+  return true;
+}
+
+// The attachment type and the packing of kResolveInRenderPassSource for each packing of
+// ResolveFromRenderTargetConstants (the render target's own pixel format, read in the pass).
+struct ResolveInRenderPassVariant {
+  NSString* type;
+  NSString* body;
+};
+ResolveInRenderPassVariant GetResolveInRenderPassVariant(uint32_t packing) {
+  switch (packing) {
+    case 0:
+      return {@"float4",
+              @"uint4 bytes = uint4(c * 255.0 + 0.5);\n"
+              @"  resolve_store_32bpp(pixel, bytes.x | (bytes.y << 8) | (bytes.z << 16) | "
+              @"(bytes.w << 24), dest, result, constants);"};
+    case 1:
+      return {@"half2", @"resolve_store_32bpp(pixel, as_type<uint>(c), dest, result, constants);"};
+    case 2:
+      return {@"float", @"resolve_store_32bpp(pixel, as_type<uint>(c), dest, result, constants);"};
+    case 3:
+      return {@"float4",
+              @"uint4 components = uint4(c * float4(1023.0, 1023.0, 1023.0, 3.0) + 0.5);\n"
+              @"  resolve_store_32bpp(pixel, components.x | (components.y << 10) | "
+              @"(components.z << 20) | (components.w << 30), dest, result, constants);"};
+    case 4:
+      // The normalized value read back to the render target's 16-bit integers.
+      return {@"float4",
+              @"resolve_store_64bpp(pixel, max(float4(-1.0), float4(int4(rint(c * 32767.0))) * "
+              @"0.0009765923023223876953125), dest, result, constants);"};
+    case 5:
+      return {@"half4", @"resolve_store_64bpp(pixel, float4(c), dest, result, constants);"};
+    default:
+      return {@"float4",
+              @"resolve_store_32bpp(pixel, resolve_pack_2_10_10_10_float(c), dest, result, "
+              @"constants);"};
+  }
+}
