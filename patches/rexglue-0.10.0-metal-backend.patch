+
+id<MTLBuffer> MetalCommandProcessor::TransientBufferPool::Request(uint64_t submission,
+                                                                uint64_t completed_submission,
+                                                                size_t size, size_t alignment,
+                                                                size_t& offset_out) {
+  // Continue in the current page if it has space.
+  if (current_page_ < pages_.size()) {
+    Page& page = pages_[current_page_];
+    size_t offset = rex::align(page.used, alignment);
+    if (offset + size <= page.buffer.length) {
+      page.used = offset + size;
+      page.last_submission = submission;
+      offset_out = offset;
+      return page.buffer;
+    }
+  }
+  // Reuse a page the GPU is done with, or create a new one.
+  size_t page_size = std::max(page_size_, rex::align(size, size_t(4096)));
+  for (size_t i = 0; i < pages_.size(); ++i) {
+    Page& page = pages_[i];
+    if (page.last_submission <= completed_submission && page.buffer.length >= size) {
+      page.used = size;
+      page.last_submission = submission;
+      current_page_ = i;
+      offset_out = 0;
+      return page.buffer;
+    }
+  }
+  id<MTLBuffer> buffer = [device_ newBufferWithLength:page_size options:options_];
+  if (!buffer) {
+    return nil;
+  }
+  buffer.label = label_;
+  current_page_ = pages_.size();
+  pages_.push_back({buffer, size, submission});
+  offset_out = 0;
+  return buffer;
+}
