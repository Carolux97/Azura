+// texture_util::GetTiledOffset2D.
+int resolve_tiled_offset_2d(int x, int y, uint pitch, int bytes_per_block_log2) {
+  int macro_offset = ((x >> 5) + (y >> 5) * int(pitch >> 5)) << (bytes_per_block_log2 + 7);
+  int micro_offset = ((x & 7) + ((y & 0xE) << 2)) << bytes_per_block_log2;
+  int offset = macro_offset + ((micro_offset & ~0xF) << 1) + (micro_offset & 0xF) +
+               ((y & 1) << 4);
+  return ((offset & ~0x1FF) << 3) + ((y & 16) << 7) + ((offset & 0x1C0) << 2) +
+         (((((y & 8) >> 2) + (x >> 3)) & 3) << 6) + (offset & 0x3F);
+}
+// SpirvShaderTranslator::UnclampedFloat32To7e3: clamped to 0...31.875, rounded to the nearest
+// even.
+uint resolve_float_to_7e3(float f) {
+  uint u = as_type<uint>(fmin(fmax(f, 0.0), 31.875));
+  uint biased = u < 0x3E800000u ? ((u & 0x7FFFFFu) | 0x800000u) >> min(125u - (u >> 23), 24u)
+                                : u - (124u << 23);
+  return ((biased + 0x7FFFu + ((biased >> 16) & 1u)) >> 16) & 0x3FFu;
+}
+// The EDRAM bits of a 2_10_10_10_FLOAT pixel, as the dump packs them.
+uint resolve_pack_2_10_10_10_float(float4 color) {
+  return resolve_float_to_7e3(color.r) | (resolve_float_to_7e3(color.g) << 10) |
+         (resolve_float_to_7e3(color.b) << 20) |
+         (uint(clamp(color.a, 0.0, 1.0) * 3.0 + 0.5) << 30);
+}
+// The full 32bpp resolve copy's unpacking of a 2_10_10_10_FLOAT pixel (float 7e3 color, 2-bit
+// alpha).
+float resolve_7e3_to_float(uint f10) {
+  if (f10 == 0u) {
+    return 0.0;
+  }
+  uint mantissa = f10 & 127u;
+  uint exponent = f10 >> 7;
+  if (exponent == 0u) {
+    uint msb = uint(31 - clz(mantissa));
+    exponent = msb - 6u;
+    mantissa = (mantissa << (7u - msb)) & 127u;
+  }
+  return as_type<float>(((exponent + 124u) << 23) | (mantissa << 16));
+}
+float4 resolve_unpack_2_10_10_10_float(uint packed) {
+  return float4(resolve_7e3_to_float(packed & 1023u), resolve_7e3_to_float((packed >> 10) & 1023u),
+                resolve_7e3_to_float((packed >> 20) & 1023u),
+                float(packed >> 30) * 0.3333333432674407958984375);
+}
+uint resolve_swap_endian(uint value, uint endian) {
+  if (endian == 1u) {
+    value = ((value & 0x00FF00FFu) << 8) | ((value >> 8) & 0x00FF00FFu);
+  } else if (endian == 2u) {
+    value = (value << 24) | ((value & 0xFF00u) << 8) | ((value >> 8) & 0xFF00u) | (value >> 24);
+  } else if (endian == 3u) {
+    value = (value << 16) | (value >> 16);
+  }
+  return value;
+}
+// Stores (or, with verify, compares) one dword of the destination.
+void resolve_store_dword(uint address, uint value, device uint* dest, device atomic_uint* result,
+                         constant ResolveFromRenderTargetConstants& constants) {
+  if (constants.verify == 0u) {
+    dest[address >> 2] = value;
+    return;
+  }
+  uint memory_value = dest[address >> 2];
+  if (memory_value != value &&
+      atomic_fetch_add_explicit(result, 1u, memory_order_relaxed) == 0u) {
+    device uint* first_mismatch = (device uint*)result;
+    first_mismatch[1] = address;
+    first_mismatch[2] = memory_value;
+    first_mismatch[3] = value;
+  }
