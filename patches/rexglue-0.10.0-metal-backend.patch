+/**
+ * @file        graphics/metal/metal_immediate_drawer.h
+ * @brief       Immediate mode drawing (ImGui overlays) for the Metal presenter
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+#include <rex/ui/immediate_drawer.h>
+#include <rex/ui/presenter.h>
+
+#import <Metal/Metal.h>
+
+namespace rex::graphics::metal {
+
+// What the Metal presenter hands to the UI drawers: the render pass that paints the drawable, open
+// after the guest output is drawn.
+class MetalUIDrawContext final : public ui::UIDrawContext {
+ public:
+  MetalUIDrawContext(ui::Presenter& presenter, uint32_t render_target_width,
+                     uint32_t render_target_height, id<MTLRenderCommandEncoder> encoder,
+                     MTLPixelFormat pixel_format)
+      : ui::UIDrawContext(presenter, render_target_width, render_target_height),
+        encoder_(encoder),
+        pixel_format_(pixel_format) {}
+
+  id<MTLRenderCommandEncoder> encoder() const { return encoder_; }
+  MTLPixelFormat pixel_format() const { return pixel_format_; }
+
+ private:
+  id<MTLRenderCommandEncoder> encoder_;
+  MTLPixelFormat pixel_format_;
+};
+
+// Draws the immediate mode batches of the UI drawers (ImGui) into the presenter's render pass:
+// textured or untextured triangles and lines, alpha blended, with scissor rectangles.
+class MetalImmediateDrawer final : public ui::ImmediateDrawer {
+ public:
+  static std::unique_ptr<MetalImmediateDrawer> Create(id<MTLDevice> device);
+
+  std::unique_ptr<ui::ImmediateTexture> CreateTexture(uint32_t width, uint32_t height,
+                                                      ui::ImmediateTextureFilter filter,
+                                                      bool is_repeated,
+                                                      const uint8_t* data) override;
+
+  void Begin(ui::UIDrawContext& ui_draw_context, float coordinate_space_width,
+             float coordinate_space_height) override;
+  void BeginDrawBatch(const ui::ImmediateDrawBatch& batch) override;
+  void Draw(const ui::ImmediateDraw& draw) override;
+  void EndDrawBatch() override;
+  void End() override;
+
+ private:
+  explicit MetalImmediateDrawer(id<MTLDevice> device) : device_(device) {}
+  bool Initialize();
+  id<MTLRenderPipelineState> GetPipeline(MTLPixelFormat pixel_format);
+
+  id<MTLDevice> device_;
+  id<MTLLibrary> library_ = nil;
+  // The presenter's drawable format is fixed, so one pipeline is enough in practice.
+  MTLPixelFormat pipeline_format_ = MTLPixelFormatInvalid;
+  id<MTLRenderPipelineState> pipeline_ = nil;
+  // Bound for untextured draws, so one pipeline serves both.
+  id<MTLTexture> white_texture_ = nil;
+  id<MTLSamplerState> white_sampler_ = nil;
+
+  // Valid between Begin and End, and between BeginDrawBatch and EndDrawBatch.
+  id<MTLRenderCommandEncoder> encoder_ = nil;
+  id<MTLBuffer> batch_indices_ = nil;
+  bool batch_has_indices_ = false;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_immediate_drawer.mm b/src/graphics/metal/metal_immediate_drawer.mm
new file mode 100644
index 0000000..796de0e
--- /dev/null
+++ b/src/graphics/metal/metal_immediate_drawer.mm
@@ -0,0 +1,258 @@
+/**
+ * @file        graphics/metal/metal_immediate_drawer.mm
+ * @brief       Immediate mode drawing (ImGui overlays) for the Metal presenter
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_immediate_drawer.h"
+
+#include <cstring>
+
+#include <rex/logging.h>
+
+namespace rex::graphics::metal {
+
+namespace {
+
+// Vertex buffer index; the constants follow it.
+constexpr uint32_t kBufferVertices = 0;
+constexpr uint32_t kBufferConstants = 1;
+
+// Vertices are ui::ImmediateVertex: position in the coordinate space, texture coordinates, and the
+// color as RGBA8 (red in the lowest byte, as ImGui packs it).
+NSString* const kImmediateShaderSource = @R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct Vertex {
+  packed_float2 position;
+  packed_float2 texcoord;
+  uint color;
+};
+struct Constants {
+  // Coordinate space to clip space.
+  float2 scale;
+  float2 offset;
+};
+struct Interpolators {
+  float4 position [[position]];
+  float2 texcoord;
+  float4 color;
+};
+vertex Interpolators immediate_vertex(uint vertex_id [[vertex_id]],
+                                      const device Vertex* vertices [[buffer(0)]],
+                                      constant Constants& constants [[buffer(1)]]) {
+  Vertex v = vertices[vertex_id];
+  Interpolators out;
+  out.position = float4(float2(v.position) * constants.scale + constants.offset, 0.0, 1.0);
+  out.texcoord = float2(v.texcoord);
+  out.color = unpack_unorm4x8_to_float(v.color);
+  return out;
+}
+fragment float4 immediate_fragment(Interpolators in [[stage_in]],
+                                   texture2d<float> texture [[texture(0)]],
+                                   sampler texture_sampler [[sampler(0)]]) {
+  return in.color * texture.sample(texture_sampler, in.texcoord);
+}
+)MSL";
+
+class MetalImmediateTexture final : public ui::ImmediateTexture {
+ public:
+  MetalImmediateTexture(uint32_t width, uint32_t height, id<MTLTexture> texture,
+                        id<MTLSamplerState> sampler)
+      : ui::ImmediateTexture(width, height), texture_(texture), sampler_(sampler) {}
+  id<MTLTexture> texture() const { return texture_; }
+  id<MTLSamplerState> sampler() const { return sampler_; }
+
+ private:
+  id<MTLTexture> texture_;
+  id<MTLSamplerState> sampler_;
+};
+
+id<MTLSamplerState> CreateSampler(id<MTLDevice> device, ui::ImmediateTextureFilter filter,
+                                  bool is_repeated) {
+  MTLSamplerDescriptor* descriptor = [MTLSamplerDescriptor new];
+  MTLSamplerMinMagFilter min_mag = filter == ui::ImmediateTextureFilter::kLinear
+                                       ? MTLSamplerMinMagFilterLinear
+                                       : MTLSamplerMinMagFilterNearest;
+  descriptor.minFilter = min_mag;
+  descriptor.magFilter = min_mag;
+  MTLSamplerAddressMode address =
+      is_repeated ? MTLSamplerAddressModeRepeat : MTLSamplerAddressModeClampToEdge;
+  descriptor.sAddressMode = address;
+  descriptor.tAddressMode = address;
+  return [device newSamplerStateWithDescriptor:descriptor];
+}
+
+id<MTLTexture> CreateRgba8Texture(id<MTLDevice> device, uint32_t width, uint32_t height,
+                                  const uint8_t* data) {
+  MTLTextureDescriptor* descriptor =
+      [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                         width:width
+                                                        height:height
+                                                     mipmapped:NO];
+  descriptor.usage = MTLTextureUsageShaderRead;
+  descriptor.storageMode = MTLStorageModeShared;
+  id<MTLTexture> texture = [device newTextureWithDescriptor:descriptor];
+  if (texture && data) {
+    [texture replaceRegion:MTLRegionMake2D(0, 0, width, height)
+               mipmapLevel:0
+                 withBytes:data
+               bytesPerRow:width * 4];
+  }
+  return texture;
+}
+
+}  // namespace
+
+std::unique_ptr<MetalImmediateDrawer> MetalImmediateDrawer::Create(id<MTLDevice> device) {
+  std::unique_ptr<MetalImmediateDrawer> drawer(new MetalImmediateDrawer(device));
+  if (!drawer->Initialize()) {
+    return nullptr;
+  }
+  return drawer;
+}
+
+bool MetalImmediateDrawer::Initialize() {
+  NSError* error = nil;
+  library_ = [device_ newLibraryWithSource:kImmediateShaderSource options:nil error:&error];
+  if (!library_) {
+    REXLOG_ERROR("Metal: failed to compile the immediate drawer shaders: {}",
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+    return false;
+  }
+  const uint8_t white[4] = {0xFF, 0xFF, 0xFF, 0xFF};
+  white_texture_ = CreateRgba8Texture(device_, 1, 1, white);
+  white_sampler_ = CreateSampler(device_, ui::ImmediateTextureFilter::kNearest, false);
+  return white_texture_ && white_sampler_;
+}
+
+id<MTLRenderPipelineState> MetalImmediateDrawer::GetPipeline(MTLPixelFormat pixel_format) {
+  if (pipeline_ && pipeline_format_ == pixel_format) {
+    return pipeline_;
+  }
+  MTLRenderPipelineDescriptor* descriptor = [MTLRenderPipelineDescriptor new];
+  descriptor.label = @"Immediate drawer";
+  descriptor.vertexFunction = [library_ newFunctionWithName:@"immediate_vertex"];
+  descriptor.fragmentFunction = [library_ newFunctionWithName:@"immediate_fragment"];
+  MTLRenderPipelineColorAttachmentDescriptor* attachment = descriptor.colorAttachments[0];
+  attachment.pixelFormat = pixel_format;
+  // Alpha blending for the color and accumulated coverage for the alpha, as ImGui expects.
+  attachment.blendingEnabled = YES;
+  attachment.sourceRGBBlendFactor = MTLBlendFactorSourceAlpha;
+  attachment.destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+  attachment.rgbBlendOperation = MTLBlendOperationAdd;
+  attachment.sourceAlphaBlendFactor = MTLBlendFactorOne;
+  attachment.destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+  attachment.alphaBlendOperation = MTLBlendOperationAdd;
+  NSError* error = nil;
+  pipeline_ = [device_ newRenderPipelineStateWithDescriptor:descriptor error:&error];
+  pipeline_format_ = pixel_format;
+  if (!pipeline_) {
+    REXLOG_ERROR("Metal: failed to create the immediate drawer pipeline: {}",
+                 error ? error.localizedDescription.UTF8String : "unknown error");
+  }
+  return pipeline_;
+}
+
+std::unique_ptr<ui::ImmediateTexture> MetalImmediateDrawer::CreateTexture(
+    uint32_t width, uint32_t height, ui::ImmediateTextureFilter filter, bool is_repeated,
+    const uint8_t* data) {
+  id<MTLTexture> texture = CreateRgba8Texture(device_, width, height, data);
+  id<MTLSamplerState> sampler = CreateSampler(device_, filter, is_repeated);
+  if (!texture || !sampler) {
+    return nullptr;
+  }
+  return std::make_unique<MetalImmediateTexture>(width, height, texture, sampler);
+}
+
+void MetalImmediateDrawer::Begin(ui::UIDrawContext& ui_draw_context, float coordinate_space_width,
+                                 float coordinate_space_height) {
+  ImmediateDrawer::Begin(ui_draw_context, coordinate_space_width, coordinate_space_height);
+  auto& metal_context = static_cast<MetalUIDrawContext&>(ui_draw_context);
+  id<MTLRenderPipelineState> pipeline = GetPipeline(metal_context.pixel_format());
+  if (!pipeline) {
+    return;
+  }
+  encoder_ = metal_context.encoder();
+  [encoder_ pushDebugGroup:@"Immediate drawer"];
+  [encoder_ setRenderPipelineState:pipeline];
+  MTLViewport viewport = {0.0, 0.0, double(ui_draw_context.render_target_width()),
+                          double(ui_draw_context.render_target_height()), 0.0, 1.0};
+  [encoder_ setViewport:viewport];
+  // Coordinate space (origin at the top left, y down) to clip space (y up).
+  float constants[4] = {2.0f / this->coordinate_space_width(),
+                        -2.0f / this->coordinate_space_height(), -1.0f, 1.0f};
+  [encoder_ setVertexBytes:constants length:sizeof(constants) atIndex:kBufferConstants];
+}
+
+void MetalImmediateDrawer::BeginDrawBatch(const ui::ImmediateDrawBatch& batch) {
+  if (!encoder_ || !batch.vertices || batch.vertex_count <= 0) {
+    return;
+  }
+  // Small batches go inline; larger ones in a buffer of their own, kept alive by the command
+  // buffer until it completes.
+  size_t vertices_size = sizeof(ui::ImmediateVertex) * size_t(batch.vertex_count);
+  if (vertices_size <= 4096) {
+    [encoder_ setVertexBytes:batch.vertices length:vertices_size atIndex:kBufferVertices];
+  } else {
+    id<MTLBuffer> vertices = [device_ newBufferWithBytes:batch.vertices
+                                                  length:vertices_size
+                                                 options:MTLResourceStorageModeShared];
+    [encoder_ setVertexBuffer:vertices offset:0 atIndex:kBufferVertices];
+  }
+  batch_has_indices_ = batch.indices && batch.index_count > 0;
+  batch_indices_ =
+      batch_has_indices_
+          ? [device_ newBufferWithBytes:batch.indices
+                                 length:sizeof(uint16_t) * size_t(batch.index_count)
+                                options:MTLResourceStorageModeShared]
+          : nil;
+}
+
+void MetalImmediateDrawer::Draw(const ui::ImmediateDraw& draw) {
+  if (!encoder_ || draw.count <= 0) {
+    return;
+  }
+  uint32_t scissor_left, scissor_top, scissor_width, scissor_height;
+  if (!ScissorToRenderTarget(draw, scissor_left, scissor_top, scissor_width, scissor_height)) {
+    return;
+  }
+  [encoder_ setScissorRect:{scissor_left, scissor_top, scissor_width, scissor_height}];
+  auto* texture = static_cast<MetalImmediateTexture*>(draw.texture);
+  [encoder_ setFragmentTexture:texture ? texture->texture() : white_texture_ atIndex:0];
+  [encoder_ setFragmentSamplerState:texture ? texture->sampler() : white_sampler_ atIndex:0];
+  MTLPrimitiveType primitive_type = draw.primitive_type == ui::ImmediatePrimitiveType::kLines
+                                        ? MTLPrimitiveTypeLine
+                                        : MTLPrimitiveTypeTriangle;
+  if (batch_has_indices_) {
+    [encoder_ drawIndexedPrimitives:primitive_type
+                         indexCount:NSUInteger(draw.count)
+                          indexType:MTLIndexTypeUInt16
+                        indexBuffer:batch_indices_
+                  indexBufferOffset:sizeof(uint16_t) * NSUInteger(draw.index_offset)
+                      instanceCount:1
+                         baseVertex:draw.base_vertex
+                       baseInstance:0];
+  } else {
+    [encoder_ drawPrimitives:primitive_type
+                 vertexStart:NSUInteger(draw.base_vertex)
+                 vertexCount:NSUInteger(draw.count)];
+  }
+}
+
+void MetalImmediateDrawer::EndDrawBatch() {
+  batch_indices_ = nil;
+  batch_has_indices_ = false;
+}
+
+void MetalImmediateDrawer::End() {
+  if (encoder_) {
+    [encoder_ popDebugGroup];
+    encoder_ = nil;
+  }
+  ImmediateDrawer::End();
+}
+
+}  // namespace rex::graphics::metal
