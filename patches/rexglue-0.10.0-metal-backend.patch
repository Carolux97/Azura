+// Argument table of the load shaders: the SPIR-V descriptor sets 0 (destination) and 1 (source),
+// and the push constants (LoadConstants).
+constexpr uint32_t kLoadBufferDestination = 0;
+constexpr uint32_t kLoadBufferSource = 1;
+constexpr uint32_t kLoadBufferConstants = 2;
+
+// The constants of texture_load_direct in kTextureLoadDirectShaderSource.
+struct TextureLoadDirectConstants {
+  uint32_t guest_offset;
+  uint32_t guest_pitch;
+  uint32_t width;
+  uint32_t height;
+  uint32_t tiled;
+  uint32_t endian;
+  uint32_t scale_x;
+  uint32_t scale_y;
+  uint32_t conversion;
+  uint32_t dwords_log2;
+};
+
+// Loads a level and slice of a texture straight into it, a texel per thread, through an unsigned
+// integer view of its host format: the guest texel is read where the load shaders read it (the
+// guest memory, a scaled surface, or the scaled resolve buffer at a whole scale), its bytes swapped
+// as the texture's endianness says, and for the depth formats converted to a 32-bit float as the
+// depth load shaders do. texture_load_compare checks it against the usual load.
+NSString* const kTextureLoadDirectShaderSource = @R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct TextureLoadDirectConstants {
+  // Bytes from the source binding to the level and slice.
+  uint guest_offset;
+  // Tiled: the row pitch in texels (aligned to 32, of the guest texture). Linear: in bytes.
+  uint guest_pitch;
+  // The level's size in host texels.
+  uint width;
+  uint height;
+  uint tiled;
+  // xenos::Endian.
+  uint endian;
+  // The scaled resolve buffer's layout at a whole draw resolution scale (1 otherwise): each 16
+  // bytes of the guest texture are scale_x * scale_y blocks of 16 bytes, as the resolves write it.
+  uint scale_x;
+  uint scale_y;
+  // 0: bits copied, 1: 24-bit unorm depth to float, 2: 20e4 float depth to float.
+  uint conversion;
+  // log2 of the dwords of a texel (0 to 2).
+  uint dwords_log2;
+};
+// texture_util::GetTiledOffset2D.
+uint texture_load_tiled_offset_2d(uint x, uint y, uint pitch, uint bytes_per_block_log2) {
+  int ix = int(x);
+  int iy = int(y);
+  int macro_offset = ((ix >> 5) + (iy >> 5) * int(pitch >> 5)) << (bytes_per_block_log2 + 7);
+  int micro_offset = ((ix & 7) + ((iy & 0xE) << 2)) << bytes_per_block_log2;
+  int offset = macro_offset + ((micro_offset & ~0xF) << 1) + (micro_offset & 0xF) +
+               ((iy & 1) << 4);
+  return uint(((offset & ~0x1FF) << 3) + ((iy & 16) << 7) + ((offset & 0x1C0) << 2) +
+              (((((iy & 8) >> 2) + (ix >> 3)) & 3) << 6) + (offset & 0x3F));
+}
+uint texture_load_source_address(uint2 texel, constant TextureLoadDirectConstants& c) {
+  uint bytes_per_block_log2 = 2u + c.dwords_log2;
+  if (c.tiled == 0u) {
+    return c.guest_offset + texel.y * c.guest_pitch + (texel.x << bytes_per_block_log2);
+  }
+  if (c.scale_x == 1u && c.scale_y == 1u) {
+    return c.guest_offset +
+           texture_load_tiled_offset_2d(texel.x, texel.y, c.guest_pitch, bytes_per_block_log2);
+  }
+  uint2 scale = uint2(c.scale_x, c.scale_y);
+  uint texels_per_block_log2 = 4u - bytes_per_block_log2;
+  uint2 block = uint2(texel.x >> texels_per_block_log2, texel.y);
+  uint2 guest = block / scale;
+  uint2 sub = block - guest * scale;
+  uint tiled = texture_load_tiled_offset_2d(guest.x << texels_per_block_log2, guest.y,
+                                            c.guest_pitch, bytes_per_block_log2);
+  return c.guest_offset + tiled * scale.x * scale.y +
+         ((((sub.x * scale.y + sub.y) << texels_per_block_log2) +
+           (texel.x & ((1u << texels_per_block_log2) - 1u)))
+          << bytes_per_block_log2);
+}
+uint texture_load_swap_endian(uint value, uint endian) {
+  if (endian == 1u) {
+    value = ((value & 0x00FF00FFu) << 8) | ((value >> 8) & 0x00FF00FFu);
+  } else if (endian == 2u) {
+    value = (value << 24) | ((value & 0xFF00u) << 8) | ((value >> 8) & 0xFF00u) | (value >> 24);
+  } else if (endian == 3u) {
+    value = (value << 16) | (value >> 16);
+  }
+  return value;
+}
+// xenos::UNorm24To32: exact, as a division by 2^24 is an exponent shift.
+uint texture_load_unorm24_to_float(uint n24) {
+  return as_type<uint>(float(n24 + (n24 >> 23)) * (1.0 / 16777216.0));
+}
+// xenos::Float20e4To32.
+uint texture_load_float20e4_to_float(uint f24) {
+  f24 &= 0xFFFFFFu;
+  if (f24 == 0u) {
+    return 0u;
+  }
+  uint mantissa = f24 & 0xFFFFFu;
+  uint exponent = f24 >> 20;
+  if (exponent == 0u) {
+    uint mantissa_lzcnt = clz(mantissa) - (32u - 21u);
+    exponent = uint(1 - int(mantissa_lzcnt));
+    mantissa = (mantissa << mantissa_lzcnt) & 0xFFFFFu;
+  }
+  return ((exponent + 112u) << 23) | (mantissa << 3);
+}
+kernel void texture_load_direct(uint2 texel [[thread_position_in_grid]],
+                                const device uint* source [[buffer(0)]],
+                                constant TextureLoadDirectConstants& c [[buffer(1)]],
+                                texture2d<uint, access::write> dest [[texture(0)]]) {
+  if (texel.x >= c.width || texel.y >= c.height) {
+    return;
+  }
+  uint dword_index = texture_load_source_address(texel, c) >> 2;
+  uint4 value = uint4(0u);
+  uint dword_count = 1u << c.dwords_log2;
+  for (uint i = 0u; i < dword_count; ++i) {
+    value[i] = texture_load_swap_endian(source[dword_index + i], c.endian);
+  }
+  if (c.conversion == 1u) {
+    value.x = texture_load_unorm24_to_float(value.x >> 8);
+  } else if (c.conversion == 2u) {
+    value.x = texture_load_float20e4_to_float(value.x >> 8);
+  }
+  dest.write(value, texel);
+}
+// Counts the texels where two integer views differ, with the first one's position and values.
+kernel void texture_load_compare(uint2 texel [[thread_position_in_grid]],
+                                 texture2d<uint, access::read> direct [[texture(0)]],
+                                 texture2d<uint, access::read> reference [[texture(1)]],
+                                 device atomic_uint* result [[buffer(0)]]) {
+  if (texel.x >= direct.get_width() || texel.y >= direct.get_height()) {
+    return;
+  }
+  uint4 a = direct.read(texel);
+  uint4 b = reference.read(texel);
+  if (any(a != b) && atomic_fetch_add_explicit(result, 1u, memory_order_relaxed) == 0u) {
+    device uint* first = (device uint*)result;
+    first[1] = texel.x;
+    first[2] = texel.y;
+    first[3] = a.x;
+    first[4] = b.x;
+    first[5] = a.y;
+    first[6] = b.y;
+  }
+}
+)MSL";
+
+MTLTextureSwizzle GetSwizzleChannel(uint32_t host_swizzle, uint32_t component_index) {
+  switch (xenos::XE_GPU_TEXTURE_SWIZZLE((host_swizzle >> (3 * component_index)) & 0b111)) {
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_R:
+      return MTLTextureSwizzleRed;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_G:
+      return MTLTextureSwizzleGreen;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_B:
+      return MTLTextureSwizzleBlue;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_A:
+      return MTLTextureSwizzleAlpha;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_0:
+      return MTLTextureSwizzleZero;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_1:
+      return MTLTextureSwizzleOne;
+    default:
+      return MTLTextureSwizzleZero;
+  }
+}
+
+MTLTextureSwizzleChannels GetSwizzleChannels(uint32_t host_swizzle) {
+  return MTLTextureSwizzleChannelsMake(
+      GetSwizzleChannel(host_swizzle, 0), GetSwizzleChannel(host_swizzle, 1),
+      GetSwizzleChannel(host_swizzle, 2), GetSwizzleChannel(host_swizzle, 3));
+}
+
+}  // namespace
+
