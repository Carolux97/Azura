+spv::Id SpirvShaderTranslator::CubeLodFromGradients(spv::Id direction, spv::Id gradient_h,
+                                                    spv::Id gradient_v, spv::Id face_size) {
+  // The face is chosen by the major axis ma, and the face coordinates are sc / ma and tc / ma
+  // with sc and tc the two other components, in [-1, 1] across the face. Their gradients come
+  // from the quotient rule, d(sc / ma) = (dsc * ma - sc * dma) / ma^2; the sign of ma does not
+  // matter for the lengths below.
+  auto component = [&](spv::Id vector, uint32_t index) {
+    return builder_->createCompositeExtract(vector, type_float_, index);
+  };
+  auto select = [&](spv::Id condition, spv::Id if_true, spv::Id if_false) {
+    return builder_->createTriOp(spv::OpSelect, type_float_, condition, if_true, if_false);
+  };
+  spv::Id direction_abs =
+      builder_->createUnaryBuiltinCall(type_float3_, ext_inst_glsl_std_450_, GLSLstd450FAbs,
+                                       direction);
+  spv::Id abs_x = component(direction_abs, 0);
+  spv::Id abs_y = component(direction_abs, 1);
+  spv::Id abs_z = component(direction_abs, 2);
+  spv::Id is_x_major = builder_->createBinOp(
+      spv::OpLogicalAnd, type_bool_,
+      builder_->createBinOp(spv::OpFOrdGreaterThanEqual, type_bool_, abs_x, abs_y),
+      builder_->createBinOp(spv::OpFOrdGreaterThanEqual, type_bool_, abs_x, abs_z));
+  spv::Id is_y_major = builder_->createBinOp(
+      spv::OpLogicalAnd, type_bool_, builder_->createUnaryOp(spv::OpLogicalNot, type_bool_,
+                                                            is_x_major),
+      builder_->createBinOp(spv::OpFOrdGreaterThanEqual, type_bool_, abs_y, abs_z));
+  spv::Id is_x_or_y_major =
+      builder_->createBinOp(spv::OpLogicalOr, type_bool_, is_x_major, is_y_major);
+  // Major axis, and the two other axes: (y, z) for X, (x, z) for Y, (x, y) for Z.
+  auto major = [&](spv::Id vector) {
+    return select(is_x_major, component(vector, 0),
+                  select(is_y_major, component(vector, 1), component(vector, 2)));
+  };
+  auto first_minor = [&](spv::Id vector) {
+    return select(is_x_major, component(vector, 1), component(vector, 0));
+  };
+  auto second_minor = [&](spv::Id vector) {
+    return select(is_x_or_y_major, component(vector, 2), component(vector, 1));
+  };
+  spv::Id ma = major(direction);
+  spv::Id sc = first_minor(direction);
+  spv::Id tc = second_minor(direction);
+  // A zero direction has no face; keep the division finite.
+  spv::Id ma_squared = builder_->createBinBuiltinCall(
+      type_float_, ext_inst_glsl_std_450_, GLSLstd450NMax,
+      builder_->createNoContractionBinOp(spv::OpFMul, type_float_, ma, ma),
+      builder_->makeFloatConstant(1.0e-30f));
+  // Squared length of the face coordinate gradient along one screen axis.
+  auto face_gradient_length_squared = [&](spv::Id gradient) {
+    spv::Id gradient_ma = major(gradient);
+    auto face_derivative = [&](spv::Id coordinate, spv::Id gradient_coordinate) {
+      spv::Id numerator = builder_->createNoContractionBinOp(
+          spv::OpFSub, type_float_,
+          builder_->createNoContractionBinOp(spv::OpFMul, type_float_, gradient_coordinate, ma),
+          builder_->createNoContractionBinOp(spv::OpFMul, type_float_, coordinate, gradient_ma));
+      return builder_->createNoContractionBinOp(spv::OpFDiv, type_float_, numerator, ma_squared);
+    };
+    spv::Id ds = face_derivative(sc, first_minor(gradient));
+    spv::Id dt = face_derivative(tc, second_minor(gradient));
+    return builder_->createNoContractionBinOp(
+        spv::OpFAdd, type_float_, builder_->createNoContractionBinOp(spv::OpFMul, type_float_, ds, ds),
+        builder_->createNoContractionBinOp(spv::OpFMul, type_float_, dt, dt));
+  };
+  spv::Id length_squared = builder_->createBinBuiltinCall(
+      type_float_, ext_inst_glsl_std_450_, GLSLstd450NMax,
+      face_gradient_length_squared(gradient_h), face_gradient_length_squared(gradient_v));
+  // The face coordinates span 2 across face_size texels: texels = 0.5 * face_size * length.
+  spv::Id half_size = builder_->createNoContractionBinOp(spv::OpFMul, type_float_, face_size,
+                                                         builder_->makeFloatConstant(0.5f));
+  spv::Id texel_length_squared = builder_->createNoContractionBinOp(
+      spv::OpFMul, type_float_, length_squared,
+      builder_->createNoContractionBinOp(spv::OpFMul, type_float_, half_size, half_size));
+  // log2(sqrt(x)) = 0.5 * log2(x); a zero gradient gives the most detailed level after clamping.
+  spv::Id log2_length_squared = builder_->createUnaryBuiltinCall(
+      type_float_, ext_inst_glsl_std_450_, GLSLstd450Log2,
+      builder_->createBinBuiltinCall(type_float_, ext_inst_glsl_std_450_, GLSLstd450NMax,
+                                     texel_length_squared, builder_->makeFloatConstant(1.0e-30f)));
+  return builder_->createNoContractionBinOp(spv::OpFMul, type_float_, log2_length_squared,
+                                            builder_->makeFloatConstant(0.5f));
+}
