+                spv::OpConvertFToU, type_uint,
+                builder.createBinOp(spv::OpFAdd, type_float,
+                                    builder.createBinOp(spv::OpFMul, type_float, source_color[0][0],
+                                                        builder.makeFloatConstant(255.0f)),
