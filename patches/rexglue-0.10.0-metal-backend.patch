+// Transfer statistics for log_render_target_transfers.
+struct TransferStats {
+  struct Pair {
+    uint32_t count = 0;
+    uint64_t tiles = 0;
+  };
+  std::map<std::pair<uint32_t, uint32_t>, Pair> pairs;  // (source, destination) keys
+  std::map<std::string, Pair> reasons;
+  uint32_t count = 0;
+};
+
+}  // namespace
+
+void RenderTargetCache::LogTransfer(RenderTargetKey source, RenderTargetKey dest, uint32_t tiles,
+                                    bool extends_last) {
+  if (!extends_last) {
+    PERF_counter_inc(kRenderTargetTransfers);
+    if (hle::InClear()) {
+      PERF_counter_inc(kRenderTargetTransfersInClears);
+    } else if (hle::InResolve()) {
+      PERF_counter_inc(kRenderTargetTransfersInResolves);
+    }
+  }
+  PERF_counter_add(kRenderTargetTransferTiles, int64_t(tiles));
+  if (!REXCVAR_GET(log_render_target_transfers)) {
+    return;
+  }
+  static TransferStats stats;
+  auto& pair = stats.pairs[{source.key, dest.key}];
+  pair.tiles += tiles;
+  auto& reason = stats.reasons[GetTransferReason(source.key, dest.key)];
+  reason.tiles += tiles;
+  if (extends_last) {
+    return;
+  }
+  ++pair.count;
+  ++reason.count;
+  if (++stats.count < 4096) {
+    return;
+  }
+  std::string reasons;
+  for (const auto& [name, totals] : stats.reasons) {
+    reasons += fmt::format("{}{} {} ({} tiles)", reasons.empty() ? "" : ", ", name, totals.count,
+                           totals.tiles);
+  }
+  REXGPU_INFO("Render target transfers: {} by reason: {}", stats.count, reasons);
+  std::vector<std::pair<std::pair<uint32_t, uint32_t>, TransferStats::Pair>> sorted(
+      stats.pairs.begin(), stats.pairs.end());
+  std::sort(sorted.begin(), sorted.end(),
+            [](const auto& a, const auto& b) { return a.second.tiles > b.second.tiles; });
+  for (size_t i = 0; i < std::min(sorted.size(), size_t(16)); ++i) {
+    RenderTargetKey source_key, dest_key;
+    source_key.key = sorted[i].first.first;
+    dest_key.key = sorted[i].first.second;
+    REXGPU_INFO("  {:5} x {:5} tiles avg ({:>11}): {} -> {}", sorted[i].second.count,
+                sorted[i].second.tiles / sorted[i].second.count,
+                GetTransferReason(source_key.key, dest_key.key), source_key.GetDebugName(),
+                dest_key.GetDebugName());
+  }
+  stats = TransferStats();
+}
+
+RenderTargetCache::RenderTarget* RenderTargetCache::GetRangeSoleOwner(uint32_t start_tiles,
+                                                                    uint32_t end_tiles) const {
+  if (start_tiles >= end_tiles || end_tiles > xenos::kEdramTileCount) {
+    return nullptr;
+  }
+  // The range that starts at or before start_tiles.
+  auto it = ownership_ranges_.upper_bound(start_tiles);
+  if (it == ownership_ranges_.begin()) {
+    return nullptr;
+  }
+  --it;
+  RenderTargetKey owner = it->second.render_target;
+  if (owner.IsEmpty()) {
+    return nullptr;
+  }
+  for (; it != ownership_ranges_.end() && it->first < end_tiles; ++it) {
+    if (it->second.render_target != owner) {
+      return nullptr;
+    }
+    if (it->second.end_tiles >= end_tiles) {
+      auto render_target_it = render_targets_.find(owner);
+      return render_target_it != render_targets_.end() ? render_target_it->second : nullptr;
+    }
+  }
+  return nullptr;
+}
+
+void RenderTargetCache::FinishTransferAudit(RenderTarget* render_target) {
+  auto it = transfer_audits_.find(render_target);
+  if (it == transfer_audits_.end()) {
+    return;
+  }
+  const TransferAudit& audit = it->second;
+  rex::perf::CounterId counter = audit.read      ? rex::perf::CounterId::kTransferAuditRead
+                                 : audit.written ? rex::perf::CounterId::kTransferAuditWritten
+                                                 : rex::perf::CounterId::kTransferAuditUntouched;
+#ifdef REXGLUE_ENABLE_PERF_COUNTERS
+  for (uint32_t i = 0; i < audit.transfers; ++i) {
+    rex::perf::IncrementCounter(counter);
+  }
+#else
+  (void)counter;
+#endif
+  transfer_audits_.erase(it);
+}
+
+void RenderTargetCache::AuditDrawTransfers(uint32_t depth_and_color_rts_used_bits,
+                                           RenderTarget* const* rts,
+                                           reg::RB_DEPTHCONTROL normalized_depth_control,
+                                           uint32_t normalized_color_mask) {
+  const RegisterFile& regs = register_file();
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    RenderTarget* rt = (depth_and_color_rts_used_bits & (uint32_t(1) << i)) ? rts[i] : nullptr;
+    if (!rt) {
+      continue;
+    }
+    // New transfers into this target: the previous ones are settled, these are followed now. Their
+    // sources had their data read.
+    const std::vector<Transfer>& transfers = last_update_transfers_[i];
+    if (!transfers.empty()) {
+      FinishTransferAudit(rt);
+      TransferAudit& audit = transfer_audits_[rt];
+      audit.transfers = uint32_t(transfers.size());
+      for (const Transfer& transfer : transfers) {
+        if (!transfer.source) {
+          continue;
+        }
+        auto source_it = transfer_audits_.find(transfer.source);
+        if (source_it != transfer_audits_.end()) {
+          source_it->second.read = true;
+        }
+        if (transfer.source->key().is_depth != rt->key().is_depth ||
+            transfer.source->key().resource_format != rt->key().resource_format) {
+          PERF_counter_inc(kTransfersReinterpreting);
+        }
+        // Each pair of render targets once, to know what the transfers carry.
+        static std::unordered_set<std::string> logged_pairs;
+        std::string pair = fmt::format("{} -> {}", transfer.source->key().GetDebugName(),
+                                       rt->key().GetDebugName());
+        if (logged_pairs.insert(pair).second) {
+          REXGPU_INFO("HLE transfer audit: {}, tiles {}..{}", pair, transfer.start_tiles,
+                      transfer.end_tiles);
+        }
+      }
+    }
+    auto it = transfer_audits_.find(rt);
+    if (it == transfer_audits_.end()) {
+      continue;
+    }
+    bool reads, writes;
+    if (!i) {
+      bool depth_test = normalized_depth_control.z_enable &&
+                        normalized_depth_control.zfunc != xenos::CompareFunction::kAlways;
+      reads = depth_test || normalized_depth_control.stencil_enable;
+      writes = (normalized_depth_control.z_enable && normalized_depth_control.z_write_enable) ||
+               normalized_depth_control.stencil_enable;
+    } else {
+      uint32_t mask = (normalized_color_mask >> (4 * (i - 1))) & 0xF;
+      auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i - 1]);
+      auto reads_dest = [](xenos::BlendFactor factor) {
+        return factor == xenos::BlendFactor::kDstColor ||
+               factor == xenos::BlendFactor::kOneMinusDstColor ||
+               factor == xenos::BlendFactor::kDstAlpha ||
+               factor == xenos::BlendFactor::kOneMinusDstAlpha ||
+               factor == xenos::BlendFactor::kSrcAlphaSaturate;
+      };
+      bool blending =
+          blend.color_destblend != xenos::BlendFactor::kZero ||
+          blend.alpha_destblend != xenos::BlendFactor::kZero || reads_dest(blend.color_srcblend) ||
+          reads_dest(blend.alpha_srcblend) || blend.color_comb_fcn == xenos::BlendOp::kMin ||
+          blend.color_comb_fcn == xenos::BlendOp::kMax ||
+          blend.alpha_comb_fcn == xenos::BlendOp::kMin ||
+          blend.alpha_comb_fcn == xenos::BlendOp::kMax;
+      writes = mask != 0;
+      // Channels left out keep the old data, as does blending with it.
+      uint32_t format_mask = (uint32_t(1) << xenos::GetColorRenderTargetFormatComponentCount(
+                                  rt->key().GetColorFormat())) -
+                             1;
+      reads = writes && (blending || (mask & format_mask) != format_mask);
+    }
+    if (reads) {
+      it->second.read = true;
+    } else if (writes) {
+      it->second.written = true;
+    }
+  }
+}
+
+void RenderTargetCache::NoteTransferAuditRangeRead(uint32_t start_tiles, uint32_t end_tiles) {
+  if (transfer_audits_.empty()) {
+    return;
+  }
+  std::vector<RangeOwner> owners;
+  GetRangeOwners(start_tiles, end_tiles, owners);
+  for (const RangeOwner& owner : owners) {
+    auto it = transfer_audits_.find(owner.render_target);
+    if (it != transfer_audits_.end()) {
+      it->second.read = true;
+    }
+  }
+}
+
+bool RenderTargetCache::GetRangeOwners(uint32_t start_tiles, uint32_t end_tiles,
+                                       std::vector<RangeOwner>& owners_out) const {
+  owners_out.clear();
+  if (start_tiles >= end_tiles || end_tiles > xenos::kEdramTileCount) {
+    return false;
+  }
+  auto it = ownership_ranges_.upper_bound(start_tiles);
+  if (it == ownership_ranges_.begin()) {
+    return false;
+  }
+  --it;
+  uint32_t covered = start_tiles;
+  for (; it != ownership_ranges_.end() && it->first < end_tiles; ++it) {
+    if (it->first > covered || it->second.end_tiles <= covered) {
+      return false;
+    }
+    RenderTargetKey owner = it->second.render_target;
+    auto render_target_it = owner.IsEmpty() ? render_targets_.end() : render_targets_.find(owner);
+    if (render_target_it == render_targets_.end()) {
+      return false;
+    }
+    uint32_t range_end = std::min(it->second.end_tiles, end_tiles);
+    if (!owners_out.empty() && owners_out.back().render_target == render_target_it->second) {
+      owners_out.back().end_tiles = range_end;
+    } else {
+      owners_out.push_back({render_target_it->second, covered, range_end});
+    }
+    covered = range_end;
+    if (covered >= end_tiles) {
+      return true;
+    }
+  }
+  return false;
+}
