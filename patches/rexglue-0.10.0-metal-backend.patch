+    texel.x = resolve_texture_unorm24_to_float(texel.x >> 8);
+  } else if (constants.texture_conversion == 2u) {
+    texel.x = resolve_texture_float20e4_to_float(texel.x >> 8);
+  }
+  texture.write(texel, pixel);
