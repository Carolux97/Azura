diff --git a/include/rex/graphics/util/resolution_scale.h b/include/rex/graphics/util/resolution_scale.h
new file mode 100644
index 0000000..b81eb8b
--- /dev/null
+++ b/include/rex/graphics/util/resolution_scale.h
@@ -0,0 +1,89 @@
+/**
+ * @file        graphics/util/resolution_scale.h
+ * @brief       The draw resolution scale as a ratio of host pixels to guest pixels
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <numeric>
+
+#include <rex/assert.h>
+
+namespace rex::graphics {
+
+// The draw resolution scale per axis, as host pixels per guest pixel: numerator / denominator. The
+// denominator is shared by both axes and divides 8, so an EDRAM tile (80x16 samples, 40x16 at 64
+// bits per pixel), the halves of a depth tile and the 8-pixel alignment of resolves stay whole
+// numbers of host pixels at any scale (3/2 makes a tile 120x24 host pixels). Kept reduced: a whole
+// scale always has the denominator 1.
+struct DrawResolutionScale {
+  static constexpr uint32_t kMaxDenominator = 8;
+
+  uint32_t numerator_x = 1;
+  uint32_t numerator_y = 1;
+  uint32_t denominator = 1;
+
+  static DrawResolutionScale Make(uint32_t numerator_x, uint32_t numerator_y,
+                                  uint32_t denominator) {
+    assert_not_zero(numerator_x);
+    assert_not_zero(numerator_y);
+    assert_true(denominator && !(kMaxDenominator % denominator));
+    uint32_t divisor = std::gcd(std::gcd(numerator_x, numerator_y), denominator);
+    return DrawResolutionScale{numerator_x / divisor, numerator_y / divisor,
+                               denominator / divisor};
+  }
+  static DrawResolutionScale Whole(uint32_t x, uint32_t y) { return Make(x, y, 1); }
+
+  // Whether every guest pixel is a whole number of host pixels.
+  bool IsWhole() const { return denominator == 1; }
+  // Whether host pixels differ from guest pixels at all.
+  bool IsScaled() const { return numerator_x != denominator || numerator_y != denominator; }
+
+  float x() const { return float(numerator_x) / float(denominator); }
+  float y() const { return float(numerator_y) / float(denominator); }
+
+  // Host pixels of a guest length the scale maps to a whole number (multiples of the denominator,
+  // such as tiles and 8-pixel blocks).
+  uint32_t ScaleX(uint32_t guest_pixels) const {
+    assert_zero(guest_pixels * numerator_x % denominator);
+    return guest_pixels * numerator_x / denominator;
+  }
+  uint32_t ScaleY(uint32_t guest_pixels) const {
+    assert_zero(guest_pixels * numerator_y % denominator);
+    return guest_pixels * numerator_y / denominator;
+  }
+
+  // Host pixels covering a guest length of any size, rounded up (a texture of an odd size at 3/2).
+  uint32_t ScaleXCeil(uint32_t guest_pixels) const {
