+// The destination address of a host pixel, as the resolve copy shaders compute it: each 16 bytes
+// of the guest's tiled destination (4 pixels at 32bpp, 2 at 64bpp) are scale_x * scale_y blocks of
+// 16 bytes, each holding as many consecutive host pixels of a row (only one block without a
+// scale, where this is the tiled address itself).
+uint resolve_dest_address(uint2 pixel, int bytes_per_block_log2,
+                          constant ResolveFromRenderTargetConstants& constants) {
+  uint2 scale = uint2(constants.scale_x, constants.scale_y);
+  uint2 host = pixel + uint2(constants.dest_x, constants.dest_y) * scale;
+  uint pixels_per_block_log2 = uint(4 - bytes_per_block_log2);
+  uint2 block = uint2(host.x >> pixels_per_block_log2, host.y);
+  uint2 guest = block / scale;
+  uint2 sub = block - guest * scale;
+  uint tiled = uint(resolve_tiled_offset_2d(int(guest.x << pixels_per_block_log2), int(guest.y),
+                                            constants.dest_pitch, bytes_per_block_log2));
+  return constants.dest_base + tiled * scale.x * scale.y +
+         ((((sub.x * scale.y + sub.y) << pixels_per_block_log2) +
+           (host.x & ((1u << pixels_per_block_log2) - 1u)))
+          << uint(bytes_per_block_log2));
+}
+// The pixel of the render target read that a host pixel of the resolve reads, through the EDRAM
+// tile it is in (as the dump places the render targets in the EDRAM), or false when another
+// render target owns that tile.
+bool resolve_source_pixel(uint2 pixel, constant ResolveFromRenderTargetConstants& constants,
+                          thread uint2& source_pixel) {
+  uint2 edram = uint2(constants.source_x, constants.source_y) +
+                max(pixel, uint2(constants.fill_x, constants.fill_y));
+  if (constants.reduce_den != 0u) {
+    // A guest pixel at a rational scale: the host pixel at its centre, floor((x + 1/2) * scale).
+    edram = (edram * 2u + 1u) * uint2(constants.reduce_num_x, constants.reduce_num_y) /
+            (2u * constants.reduce_den);
+  }
+  uint2 tile_size = uint2(constants.tile_width, constants.tile_height);
+  uint2 tile = edram / tile_size;
+  uint tile_index = constants.edram_base + tile.y * constants.edram_pitch + tile.x;
+  if (tile_index < constants.range_start || tile_index >= constants.range_end) {
+    return false;
+  }
+  uint owner_tile = tile_index - constants.owner_base;
+  source_pixel = uint2(owner_tile % constants.owner_pitch, owner_tile / constants.owner_pitch) *
