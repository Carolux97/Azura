diff --git a/src/system/xam/player_identity.cpp b/src/system/xam/player_identity.cpp
new file mode 100644
index 0000000..1cfbf15
--- /dev/null
+++ b/src/system/xam/player_identity.cpp
@@ -0,0 +1,191 @@
+/**
+ * @file        system/xam/player_identity.cpp
+ * @brief       The identity of an installation (rex/system/xam/player_identity.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/system/xam/player_identity.h>
+
+#include <fstream>
+#include <sstream>
+#include <system_error>
+
+#include <fmt/format.h>
+#include <toml++/toml.hpp>
+
+#include <rex/logging.h>
+
+namespace rex::system::xam {
+namespace {
+
+constexpr uint64_t kOfflineXuidPrefix = 0xE000000000000000ull;
+constexpr uint64_t kOfflineXuidPrefixMask = 0xFFFF000000000000ull;
+constexpr uint64_t kXuidRandomMask = 0x0000FFFFFFFFFFFFull;
+// Players 2 to 4 are player 1's XUID plus 1 to 3: the random part leaves room for them.
+constexpr uint64_t kLocalPlayersAfterFirst = 3;
+
+template <size_t N>
+std::string ToHex(const std::array<uint8_t, N>& bytes) {
+  std::string text;
+  text.reserve(N * 2);
+  for (uint8_t byte : bytes) {
+    text += fmt::format("{:02x}", byte);
+  }
+  return text;
+}
+
+template <size_t N>
+std::optional<std::array<uint8_t, N>> FromHex(std::string_view text) {
+  if (text.size() != N * 2) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, N> bytes{};
+  for (size_t i = 0; i < N; ++i) {
+    uint8_t value = 0;
+    for (size_t k = 0; k < 2; ++k) {
+      const char c = text[i * 2 + k];
+      uint8_t digit;
+      if (c >= '0' && c <= '9') {
+        digit = uint8_t(c - '0');
+      } else if (c >= 'a' && c <= 'f') {
+        digit = uint8_t(c - 'a' + 10);
+      } else if (c >= 'A' && c <= 'F') {
+        digit = uint8_t(c - 'A' + 10);
+      } else {
+        return std::nullopt;
+      }
+      value = uint8_t(value << 4 | digit);
+    }
+    bytes[i] = value;
+  }
+  return bytes;
+}
+
+std::optional<uint64_t> ParseXuid(std::string_view text) {
+  const auto bytes = FromHex<8>(text);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  uint64_t xuid = 0;
+  for (uint8_t byte : *bytes) {
+    xuid = xuid << 8 | byte;
+  }
+  return xuid;
+}
+
+// The identity in `path`, if the file exists; `exists` says whether it does.
+std::optional<PlayerIdentity> ReadPlayerIdentity(const std::filesystem::path& path, bool& exists) {
+  std::error_code error;
+  exists = std::filesystem::exists(path, error);
+  if (!exists) {
+    return std::nullopt;
+  }
+  std::ifstream in(path, std::ios::binary);
+  std::stringstream text;
+  text << in.rdbuf();
+  return ParsePlayerIdentity(text.str());
+}
+
+}  // namespace
+
+bool IsValidPlayerXuid(uint64_t xuid) {
+  return (xuid & kOfflineXuidPrefixMask) == kOfflineXuidPrefix &&
+         (xuid & kXuidRandomMask) + kLocalPlayersAfterFirst <= kXuidRandomMask;
+}
+
+bool IsValidMachineId(const std::array<uint8_t, 6>& machine_id) {
+  // Bit 1 of the first byte: locally administered; bit 0: multicast.
+  return (machine_id[0] & 0x03) == 0x02;
+}
+
+PlayerIdentity GeneratePlayerIdentity(std::random_device& random) {
+  PlayerIdentity identity;
+  uint64_t bits = 0;
+  do {
+    bits = (uint64_t(random()) << 32 | random()) & kXuidRandomMask;
+    identity.xuid = kOfflineXuidPrefix | bits;
+  } while (!IsValidPlayerXuid(identity.xuid));
+  for (auto& byte : identity.machine_id) {
+    byte = uint8_t(random());
+  }
+  identity.machine_id[0] = uint8_t((identity.machine_id[0] & 0xFC) | 0x02);
+  for (auto& byte : identity.key_seed) {
+    byte = uint8_t(random());
+  }
+  return identity;
+}
+
+std::string SerializePlayerIdentity(const PlayerIdentity& identity) {
+  return fmt::format(
+      "# This installation's identity for playing with other people. Keep it with the saves;\n"
+      "# deleting it gives the next start a new one.\n"
+      "xuid = \"{:016X}\"\n"
+      "machine_id = \"{}\"\n"
+      "key_seed = \"{}\"\n",
+      identity.xuid, ToHex(identity.machine_id), ToHex(identity.key_seed));
+}
+
+std::optional<PlayerIdentity> ParsePlayerIdentity(std::string_view text) {
+  toml::table table;
+  try {
+    table = toml::parse(text);
+  } catch (const toml::parse_error&) {
+    return std::nullopt;
+  }
+  const auto xuid = ParseXuid(table["xuid"].value_or<std::string>(""));
+  const auto machine_id = FromHex<6>(table["machine_id"].value_or<std::string>(""));
+  const auto key_seed = FromHex<32>(table["key_seed"].value_or<std::string>(""));
+  if (!xuid || !IsValidPlayerXuid(*xuid) || !machine_id || !IsValidMachineId(*machine_id) ||
+      !key_seed) {
+    return std::nullopt;
+  }
+  return PlayerIdentity{*xuid, *machine_id, *key_seed};
+}
+
+PlayerIdentity LoadOrCreatePlayerIdentity(const std::filesystem::path& user_data_root) {
+  std::random_device random;
+  if (user_data_root.empty()) {
+    REXSYS_WARN("Player identity: no user data folder, using one for this run only");
+    return GeneratePlayerIdentity(random);
+  }
+  const auto path = user_data_root / kPlayerIdentityFileName;
+  std::error_code error;
+  bool exists = false;
+  if (auto identity = ReadPlayerIdentity(path, exists)) {
+    REXSYS_INFO("Player identity: XUID {:016X}", identity->xuid);
+    return *identity;
+  }
+  if (exists) {
+    auto bad = path;
+    bad += ".bad";
+    std::filesystem::rename(path, bad, error);
+    REXSYS_WARN("Player identity: {} is not valid, kept as {} and replaced", path.string(),
+                bad.string());
+  }
+  const PlayerIdentity identity = GeneratePlayerIdentity(random);
+  std::filesystem::create_directories(user_data_root, error);
+  std::ofstream out(path, std::ios::binary | std::ios::trunc);
+  out << SerializePlayerIdentity(identity);
+  if (!out) {
+    REXSYS_WARN("Player identity: cannot write {}, using a new one for this run only",
+                path.string());
+  } else {
+    REXSYS_INFO("Player identity: new XUID {:016X}, saved in {}", identity.xuid, path.string());
+  }
+  return identity;
+}
+
+PlayerIdentity LoadPlayerIdentity(const std::filesystem::path& user_data_root) {
+  bool exists = false;
+  if (!user_data_root.empty()) {
+    if (auto identity = ReadPlayerIdentity(user_data_root / kPlayerIdentityFileName, exists)) {
+      return *identity;
+    }
+  }
+  std::random_device random;
+  return GeneratePlayerIdentity(random);
+}
+
+}  // namespace rex::system::xam
diff --git a/src/system/xam/system_link.cpp b/src/system/xam/system_link.cpp
new file mode 100644
index 0000000..20079e5
--- /dev/null
+++ b/src/system/xam/system_link.cpp
@@ -0,0 +1,218 @@
+/**
+ * @file        system/xam/system_link.cpp
+ * @brief       System Link: the local network as XNet and the session services show it to a title
+ *              (rex/system/xam/system_link.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/system/xam/system_link.h>
+
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+
+#if REX_PLATFORM_WIN32
+#include <WinSock2.h>
+
+#include <WS2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+REXCVAR_DEFINE_STRING(network_mode, "offline", "Network",
+                      "offline: the title sees no network link, so System Link stays off; "
+                      "system_link: System Link games with the other computers of the local "
+                      "network")
+    .allowed({"offline", "system_link"})
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::system::xam {
+namespace {
+
+// Top bits of an XNKID that say what kind of session it is; System Link sessions have none set.
+constexpr uint8_t kXnKidTypeMask = 0xF0;
+constexpr uint8_t kXnKidSystemLink = 0x00;
+
+std::mutex g_mutex;
+std::map<uint32_t, XnAddrBytes> g_address_book;  // by IP address
+std::map<uint32_t, SystemLinkSession> g_sessions;  // by the title's session handle
+
+// The local address of a UDP socket "connected" to `ip`: the address of the interface the host
+// would send to it from. A UDP connect sends nothing.
+uint32_t RouteSourceAddress(uint32_t ip) {
+  const auto handle = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+#if REX_PLATFORM_WIN32
+  if (handle == INVALID_SOCKET) return 0;
+#else
+  if (handle < 0) return 0;
+#endif
+  sockaddr_in to{};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(9);
+  to.sin_addr.s_addr = htonl(ip);
+  uint32_t address = 0;
+  if (connect(handle, reinterpret_cast<sockaddr*>(&to), sizeof(to)) == 0) {
+    sockaddr_in local{};
+    socklen_t length = sizeof(local);
+    if (getsockname(handle, reinterpret_cast<sockaddr*>(&local), &length) == 0) {
+      address = ntohl(local.sin_addr.s_addr);
+    }
+  }
+#if REX_PLATFORM_WIN32
+  closesocket(handle);
+#else
+  close(handle);
+#endif
+  return address;
+}
+
+// The first IPv4 address of an interface that is up and is not the loopback one.
+uint32_t FirstInterfaceAddress() {
+#if REX_PLATFORM_WIN32
+  return 0;
+#else
+  ifaddrs* interfaces = nullptr;
+  if (getifaddrs(&interfaces) != 0) return 0;
+  uint32_t address = 0;
+  for (auto* entry = interfaces; entry && !address; entry = entry->ifa_next) {
+    if (!entry->ifa_addr || entry->ifa_addr->sa_family != AF_INET) continue;
+    if (!(entry->ifa_flags & IFF_UP) || (entry->ifa_flags & IFF_LOOPBACK)) continue;
+    address = ntohl(reinterpret_cast<const sockaddr_in*>(entry->ifa_addr)->sin_addr.s_addr);
+  }
+  freeifaddrs(interfaces);
+  return address;
+#endif
+}
+
+uint32_t FindLanAddress() {
+  // The interface of the default route is the one the local network is on; a network without one
+  // (no router to the internet) still has its interfaces.
+  constexpr uint32_t kOutsideAddress = 0xC0000201;  // 192.0.2.1, an address for documentation
+  uint32_t address = RouteSourceAddress(kOutsideAddress);
+  if (!address || (address >> 24) == 127) {
+    address = FirstInterfaceAddress();
+  }
+  if (address) {
+    REXSYS_INFO("System Link: local network address {}.{}.{}.{}", address >> 24,
+                (address >> 16) & 0xFF, (address >> 8) & 0xFF, address & 0xFF);
+  } else {
+    REXSYS_WARN("System Link: no local network address found");
+  }
+  return address;
+}
+
+}  // namespace
+
+bool SystemLinkEnabled() {
+  return REXCVAR_GET(network_mode) == "system_link";
+}
+
+uint32_t LanAddress() {
+  static const uint32_t address = FindLanAddress();
+  return address;
+}
+
+XnAddrBytes MakeXnAddr(uint32_t ip, const std::array<uint8_t, 6>& machine_id) {
+  XnAddrBytes xnaddr{};
+  xnaddr[kXnAddrIpOffset + 0] = uint8_t(ip >> 24);
+  xnaddr[kXnAddrIpOffset + 1] = uint8_t(ip >> 16);
+  xnaddr[kXnAddrIpOffset + 2] = uint8_t(ip >> 8);
+  xnaddr[kXnAddrIpOffset + 3] = uint8_t(ip);
+  std::memcpy(xnaddr.data() + kXnAddrEnetOffset, machine_id.data(), machine_id.size());
+  return xnaddr;
+}
+
+uint32_t XnAddrIp(const XnAddrBytes& xnaddr) {
+  return uint32_t(xnaddr[kXnAddrIpOffset]) << 24 | uint32_t(xnaddr[kXnAddrIpOffset + 1]) << 16 |
+         uint32_t(xnaddr[kXnAddrIpOffset + 2]) << 8 | xnaddr[kXnAddrIpOffset + 3];
+}
+
+void RememberXnAddr(const XnAddrBytes& xnaddr) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_address_book[XnAddrIp(xnaddr)] = xnaddr;
+}
+
+std::optional<XnAddrBytes> FindXnAddr(uint32_t ip) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  const auto it = g_address_book.find(ip);
+  if (it == g_address_book.end()) return std::nullopt;
+  return it->second;
+}
+
+XnKid MakeSystemLinkKid(std::random_device& random) {
+  XnKid kid;
+  for (auto& byte : kid) {
+    byte = uint8_t(random());
+  }
+  kid[0] = uint8_t((kid[0] & ~kXnKidTypeMask) | kXnKidSystemLink);
+  return kid;
+}
+
+XnKey MakeKey(std::random_device& random) {
+  XnKey key;
+  for (auto& byte : key) {
+    byte = uint8_t(random());
+  }
+  return key;
+}
+
+bool IsSystemLinkKid(const XnKid& kid) {
+  return (kid[0] & kXnKidTypeMask) == kXnKidSystemLink;
+}
+
+void AddSession(uint32_t handle, const SystemLinkSession& session) {
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_sessions[handle] = session;
+  }
+  RememberXnAddr(session.host);
+}
+
+void RemoveSession(uint32_t handle) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  g_sessions.erase(handle);
+}
+
+bool HostingSystemLinkSession() {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  for (const auto& [handle, session] : g_sessions) {
+    if (session.hosting) return true;
+  }
+  return false;
+}
+
+std::optional<XnKid> FindSessionKid(uint32_t ip) {
+  std::lock_guard<std::mutex> lock(g_mutex);
+  for (const auto& [handle, session] : g_sessions) {
+    if (XnAddrIp(session.host) == ip) return session.kid;
+  }
+  if (!g_sessions.empty()) return g_sessions.begin()->second.kid;
+  return std::nullopt;
+}
+
+uint16_t NetworkPort(uint16_t title_port) {
+  if (title_port == 0 || title_port >= kFirstUnprivilegedPort) return title_port;
+  return uint16_t(title_port + kPrivilegedPortOffset);
+}
+
+uint16_t TitlePort(uint16_t network_port) {
+  if (network_port > kPrivilegedPortOffset &&
+      network_port < kPrivilegedPortOffset + kFirstUnprivilegedPort) {
+    return uint16_t(network_port - kPrivilegedPortOffset);
+  }
+  return network_port;
+}
+
