+MetalTextureCache::MetalTexture::~MetalTexture() = default;
+
+id<MTLTexture> MetalTextureCache::MetalTexture::GetView(bool is_signed, uint32_t host_swizzle,
+                                                        bool is_array) {
+  xenos::DataDimension dimension = key().dimension;
+  if (dimension == xenos::DataDimension::k3D || dimension == xenos::DataDimension::kCube) {
+    is_array = false;
+  }
+  const MetalTextureCache& metal_texture_cache =
+      static_cast<const MetalTextureCache&>(texture_cache());
+  const HostFormatPair& host_format_pair = metal_texture_cache.GetHostFormatPair(key());
+  MTLPixelFormat format =
+      (is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned).format;
+  if (format == MTLPixelFormatInvalid) {
+    return nil;
+  }
+  // If the unsigned and the signed formats are the same, one view serves both.
+  bool is_signed_separate_view =
+      is_signed && host_format_pair.format_signed.format != host_format_pair.format_unsigned.format;
+  uint32_t view_key = uint32_t(is_signed_separate_view) | ((host_swizzle & 0xFFF) << 1) |
+                      (uint32_t(is_array) << 13);
+  auto it = views_.find(view_key);
+  if (it != views_.end()) {
+    return it->second;
+  }
+  MTLTextureType type;
+  NSRange slices;
+  switch (dimension) {
+    case xenos::DataDimension::k3D:
+      type = MTLTextureType3D;
+      slices = NSMakeRange(0, 1);
+      break;
+    case xenos::DataDimension::kCube:
+      type = MTLTextureTypeCube;
+      slices = NSMakeRange(0, 6);
+      break;
+    default:
+      if (is_array) {
+        type = MTLTextureType2DArray;
+        slices = NSMakeRange(0, texture_.arrayLength);
+      } else {
+        type = MTLTextureType2D;
+        slices = NSMakeRange(0, 1);
+      }
+      break;
+  }
+  id<MTLTexture> view = [texture_ newTextureViewWithPixelFormat:format
+                                                    textureType:type
+                                                         levels:NSMakeRange(0, texture_.mipmapLevelCount)
+                                                         slices:slices
+                                                        swizzle:GetSwizzleChannels(host_swizzle)];
+  if (!view) {
+    REXGPU_ERROR("MetalTextureCache: failed to create a view of format {} ({}signed) with "
+                 "swizzle 0x{:03X}",
+                 uint32_t(format), is_signed ? "" : "un", host_swizzle);
+    return nil;
+  }
+  views_.emplace(view_key, view);
+  return view;
+}
+
+id<MTLTexture> MetalTextureCache::MetalTexture::GetOrCreate3DAs2DView(bool is_signed,
+                                                                      uint32_t host_swizzle) {
+  if (!REXCVAR_GET(gpu_3d_to_2d_texture)) {
+    return nil;
+  }
+  MetalTextureCache& metal_texture_cache = static_cast<MetalTextureCache&>(texture_cache());
+  if (!texture_3d_as_2d_) {
+    const HostFormatPair& host_format_pair = metal_texture_cache.GetHostFormatPair(key());
+    MTLPixelFormat format = host_format_pair.format_unsigned.format;
+    if (format == MTLPixelFormatInvalid) {
+      format = host_format_pair.format_signed.format;
+    }
+    if (format == MTLPixelFormatInvalid) {
+      return nil;
+    }
+    MTLTextureDescriptor* descriptor = [MTLTextureDescriptor new];
+    descriptor.textureType = MTLTextureType2DArray;
+    descriptor.pixelFormat = format;
+    descriptor.width = key().GetWidth();
+    descriptor.height = key().GetHeight();
+    descriptor.arrayLength = 1;
+    descriptor.mipmapLevelCount = 1;
+    descriptor.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+    descriptor.storageMode = MTLStorageModePrivate;
+    id<MTLTexture> texture_2d = [texture_.device newTextureWithDescriptor:descriptor];
+    if (!texture_2d) {
+      REXGPU_ERROR("MetalTextureCache: failed to create a 3D-as-2D wrapper texture");
+      return nil;
+    }
+    TextureKey key_2d = key();
+    key_2d.depth_or_array_size_minus_1 = 0;
+    key_2d.mip_max_level = 0;
+    texture_3d_as_2d_.reset(new MetalTexture(metal_texture_cache, key_2d, texture_2d, false));
+    texture_3d_as_2d_->SetForceLoad3DTiling(true);
+    if (!metal_texture_cache.LoadTextureData(*texture_3d_as_2d_)) {
+      REXGPU_ERROR("MetalTextureCache: failed to load a 3D-as-2D wrapper texture");
+      texture_3d_as_2d_.reset();
+      return nil;
+    }
+  }
+  // The wrapper keeps the 3D key (for loading with 3D tiling), so its view is made here: a 2D
+  // array, as guest shaders declare 2D textures.
+  const HostFormatPair& host_format_pair = metal_texture_cache.GetHostFormatPair(key());
+  MTLPixelFormat view_format =
+      (is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned).format;
+  if (view_format == MTLPixelFormatInvalid) {
+    return nil;
+  }
+  uint32_t view_key = uint32_t(is_signed) | ((host_swizzle & 0xFFF) << 1) | (UINT32_C(1) << 14);
+  auto it = views_.find(view_key);
+  if (it != views_.end()) {
+    return it->second;
+  }
+  id<MTLTexture> view =
+      [texture_3d_as_2d_->texture() newTextureViewWithPixelFormat:view_format
+                                                       textureType:MTLTextureType2DArray
+                                                            levels:NSMakeRange(0, 1)
+                                                            slices:NSMakeRange(0, 1)
+                                                           swizzle:GetSwizzleChannels(host_swizzle)];
+  if (view) {
+    views_.emplace(view_key, view);
+  }
+  return view;
+}
