+void MnkInputDriver::OnMouseWheel(rex::ui::MouseEvent& e) {
+  if (!IsEnabled() || !has_focus_)
+    return;
+  // A trackpad scrolls in fractions of a notch: they add up until they make one.
+  constexpr int32_t kDetent = static_cast<int32_t>(rex::ui::MouseEvent::kScrollPerDetent);
+  std::lock_guard lock(state_mutex_);
+  wheel_scroll_ += e.scroll_y();
+  const int notches = wheel_scroll_ / kDetent;
+  if (notches == 0) {
+    return;
+  }
+  wheel_scroll_ -= notches * kDetent;
+  int& pending = wheel_pending_[notches > 0 ? 0 : 1];
+  pending = std::min(pending + std::abs(notches), kWheelMaxPending);
+}
+
+void MnkInputDriver::UpdateWheelKeys(std::chrono::steady_clock::time_point now) {
+  constexpr VirtualKey kKeys[2] = {VirtualKey::kWheelUp, VirtualKey::kWheelDown};
+  for (int i = 0; i < 2; ++i) {
+    bool& down = key_down_[static_cast<uint16_t>(kKeys[i])];
+    if (down && now >= wheel_release_at_[i]) {
+      down = false;
+      wheel_next_at_[i] = now + kWheelGap;
+    } else if (!down && wheel_pending_[i] > 0 && now >= wheel_next_at_[i]) {
+      down = true;
+      --wheel_pending_[i];
+      wheel_release_at_[i] = now + kWheelPress;
+    }
+  }
+}
+
+void MnkInputDriver::ResetLatches() {
+  wheel_pending_[0] = wheel_pending_[1] = 0;
+  wheel_scroll_ = 0;
+  aim_bind_was_down_ = aim_latched_ = false;
+  run_bind_was_down_ = run_latched_ = false;
+  zoom_bind_was_down_ = zoomed_ = aiming_ = false;
+  zoom_click_until_ = {};
+  held_start_key.store(0, std::memory_order_relaxed);
+}
