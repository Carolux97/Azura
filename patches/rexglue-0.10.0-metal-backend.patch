+  std::unique_ptr<VulkanProvider> provider = Create(true, false, false);
+  std::unique_ptr<VulkanInstance> instance;
+  const VulkanInstance* vulkan_instance;
+  if (provider) {
+    vulkan_instance = provider->vulkan_instance();
+    automatic_uuid_out = GetPhysicalDeviceUuid(*vulkan_instance,
+                                               provider->vulkan_device()->physical_device());
+  } else {
+    instance = VulkanInstance::Create(false, false);
+    if (!instance) {
+      return false;
+    }
+    vulkan_instance = instance.get();
+  }
+  std::vector<VkPhysicalDevice> physical_devices;
+  vulkan_instance->EnumeratePhysicalDevices(physical_devices);
+  for (VkPhysicalDevice physical_device : physical_devices) {
+    VkPhysicalDeviceProperties properties;
+    vulkan_instance->functions().vkGetPhysicalDeviceProperties(physical_device, &properties);
+    devices_out.push_back({properties.deviceName,
+                           GetPhysicalDeviceUuid(*vulkan_instance, physical_device),
+                           properties.deviceType, properties.vendorID});
+  }
+  return true;
