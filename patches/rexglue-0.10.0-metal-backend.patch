+// Adds the microseconds from its construction to its destruction to a per-frame counter, for the
+// work a guest draw does on the command processor thread. Nothing without performance counters.
+class ScopedCounterMicroseconds {
+ public:
+#ifdef REXGLUE_ENABLE_PERF_COUNTERS
+  explicit ScopedCounterMicroseconds(CounterId id)
+      : id_(id), start_(std::chrono::steady_clock::now()) {}
+  ~ScopedCounterMicroseconds() {
+    IncrementCounter(id_, std::chrono::duration_cast<std::chrono::microseconds>(
+                              std::chrono::steady_clock::now() - start_)
+                              .count());
+  }
+
+ private:
+  CounterId id_;
+  std::chrono::steady_clock::time_point start_;
+#else
+  explicit ScopedCounterMicroseconds(CounterId) {}
+#endif
+  ScopedCounterMicroseconds(const ScopedCounterMicroseconds&) = delete;
+  ScopedCounterMicroseconds& operator=(const ScopedCounterMicroseconds&) = delete;
+};
