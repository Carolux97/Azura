+set(REXGLUE_RECOMP_DEBUG_INFO "line-tables-only" CACHE STRING
+    "Debug info level for generated code: line-tables-only, full, or none")
+
+function(rexglue_get_recomp_options out_var)
+    set(_options "")
+    if(WIN32)
+        if(MSVC)
+            list(APPEND _options /EHa)
+        elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+            list(APPEND _options -fasync-exceptions)
+        endif()
+    endif()
+    if(REXGLUE_RECOMP_DEBUG_INFO STREQUAL "none")
+        list(APPEND _options $<$<CXX_COMPILER_ID:Clang,AppleClang,GNU>:-g0>)
+    elseif(REXGLUE_RECOMP_DEBUG_INFO STREQUAL "line-tables-only")
+        list(APPEND _options $<$<CXX_COMPILER_ID:Clang,AppleClang>:-gline-tables-only>)
+    endif()
+    set(${out_var} "${_options}" PARENT_SCOPE)
+endfunction()
 
+#==========================================================
+# rexglue_apply_recomp_settings(<target> <pch_header>) - Generated code settings
+#
+# The options of generated code and, unless <pch_header> is empty, its
+# precompiled header. The options go on the target as well as on the sources:
+# CMake compiles the header from its own cmake_pch.hxx.cxx, which carries none
+# of the source properties, and clang rejects a PCH whose EH mode disagrees
+# with the TU including it.
+#==========================================================
+function(rexglue_apply_recomp_settings target_name pch_header)
+    rexglue_get_recomp_options(_options)
+    target_compile_options(${target_name} PRIVATE ${_options})
+    if(pch_header)
+        target_precompile_headers(${target_name} PRIVATE "${pch_header}")
+    endif()
+endfunction()
+
+#==========================================================
+# rexglue_add_recomp_library(<name> SOURCES ... INCLUDE_DIRS ... [PCH <header>])
+#   - Object library of generated code
+#
+# The generated sources with everything they compile with: the runtime's
+# headers and definitions, the common flags, and the settings of generated
+# code (the options also go on the sources, so they hold for any target that
+# compiles them). Codegen's CMake builds the generated code with it; a project
+# can also use it to learn how generated code compiles without generating any.
+#==========================================================
+function(rexglue_add_recomp_library name)
+    cmake_parse_arguments(ARG "" "PCH" "SOURCES;INCLUDE_DIRS" ${ARGN})
+    rexglue_get_recomp_options(_options)
+    set_source_files_properties(${ARG_SOURCES} PROPERTIES COMPILE_OPTIONS "${_options}")
+    add_library(${name} OBJECT ${ARG_SOURCES})
+    target_include_directories(${name} PRIVATE ${ARG_INCLUDE_DIRS})
+    target_link_libraries(${name} PRIVATE rex::runtime)
+    rexglue_apply_target_settings(${name})
+    rexglue_apply_recomp_settings(${name} "${ARG_PCH}")
+endfunction()
+
+#==========================================================
+# rexglue_add_host_sources(<target>) - SDK sources of a host application
+#
+# Adds the SDL3 entry point (windowed_app_main_sdl.cpp), the ReXApp base class
+# (rex_app.cpp) and the build-config define of the version stamp to <target>,
+# with the common flags. <target> is the host executable itself, or an object
+# library holding the host's code that is linked into it later (see HOST_OBJECTS
+# of rexglue_configure_target): that library compiles without any generated
+# code, so it can be built once and linked with code generated elsewhere.
+#==========================================================
+function(rexglue_add_host_sources target_name)
     target_sources(${target_name} PRIVATE
         ${REXGLUE_SHARE_DIR}/windowed_app_main_sdl.cpp
         ${REXGLUE_SHARE_DIR}/rex_app.cpp)
@@ -84,6 +150,33 @@ function(rexglue_configure_target target_name)
     target_compile_definitions(${target_name} PRIVATE
