+std::unique_ptr<MetalTextureCache> MetalTextureCache::Create(
+    const RegisterFile& register_file, MetalSharedMemory& shared_memory,
+    DrawResolutionScale draw_resolution_scale, MetalCommandProcessor& command_processor) {
+  std::unique_ptr<MetalTextureCache> texture_cache(new MetalTextureCache(
+      register_file, shared_memory, draw_resolution_scale, command_processor));
+  if (!texture_cache->Initialize()) {
+    return nullptr;
+  }
+  return texture_cache;
+}
