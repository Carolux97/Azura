+namespace {
+
+// The constants of resolve_reduce in kRenderTargetShaderSource.
+struct ResolveReduceConstants {
+  uint32_t dword_count;
+  uint32_t element_size_log2;
+  uint32_t scale_area;
+  uint32_t sample_index;
+};
+
+// In draw_util::ResolveCopyShaderIndex order: the shaders for drawing at the guest resolution, and
+// the ones for a draw resolution scale (writing to the scaled resolve buffer, with the destination
