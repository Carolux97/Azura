diff --git a/include/rex/graphics/pipeline/texture/events.h b/include/rex/graphics/pipeline/texture/events.h
new file mode 100644
index 0000000..0868eed
--- /dev/null
+++ b/include/rex/graphics/pipeline/texture/events.h
@@ -0,0 +1,34 @@
+/**
+ * @file        rex/graphics/pipeline/texture/events.h
+ * @brief       A notice for each texture the GPU texture cache creates
+ *
+ * Host code that looks for a guest texture by its contents (to replace it) can wait for the
+ * texture cache to create it instead of scanning guest memory: the cache calls the handler with
+ * where the texture's top level lies and its size, once per texture it creates.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics {
+
+struct CreatedTexture {
+  uint32_t base_address;  // physical address of the top level (mip 0)
+  uint32_t width;
+  uint32_t height;
+  bool tiled;
+};
+
+/// Called on the GPU thread for each texture the texture cache creates: it must be quick (take the
+/// notice and return). Null (the default) turns the notices off.
+using TextureCreatedHandler = void (*)(const CreatedTexture& texture);
+void SetTextureCreatedHandler(TextureCreatedHandler handler);
+
+/// For the texture cache: passes `texture` to the handler, if there is one.
+void NotifyTextureCreated(const CreatedTexture& texture);
+
+}  // namespace rex::graphics
