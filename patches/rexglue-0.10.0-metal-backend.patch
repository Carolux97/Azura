+bool RenderTargetCache::ClearCoversRange(uint32_t pitch_pixels, uint32_t height_used,
+                                         const Shader& vertex_shader) {
+  const RegisterFile& regs = register_file();
+  // Ownership changes whole rows of tiles, the surface pitch wide, down to height_used: only when
+  // the clear's rectangle (within the scissor) covers all of that are the tiles' old contents fully
+  // replaced. The rectangle comes from the clear's vertices run on the CPU: with the viewport
+  // transform off, as Direct3D draws its clears, the viewport registers may belong to another draw.
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  if (scissor.offset[0] || scissor.offset[1] || scissor.extent[0] < pitch_pixels ||
+      scissor.extent[1] < height_used) {
+    return false;
+  }
+  float left, top, right, bottom;
+  if (!draw_extent_estimator_.EstimateVertexRectangle(vertex_shader, left, top, right, bottom,
+                                                      &last_update_clear_vertex_depth_)) {
+    return false;
+  }
+  return left <= 0.0f && top <= 0.0f && right >= float(pitch_pixels) &&
+         bottom >= float(height_used);
+}
+
+bool RenderTargetCache::GetClearCutout(uint32_t pitch_pixels, const Shader& vertex_shader,
+                                       Transfer::Rectangle& cutout_out) {
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(register_file(), scissor);
+  float left, top, right, bottom;
+  if (!draw_extent_estimator_.EstimateVertexRectangle(vertex_shader, left, top, right, bottom)) {
+    return false;
+  }
+  // The pixels the rectangle covers whole (with every sample of them), within the scissor.
+  int64_t x0 = std::max(int64_t(std::ceil(left)), int64_t(scissor.offset[0]));
+  int64_t y0 = std::max(int64_t(std::ceil(top)), int64_t(scissor.offset[1]));
+  int64_t x1 = std::min({int64_t(std::floor(right)), int64_t(scissor.offset[0] + scissor.extent[0]),
+                         int64_t(pitch_pixels)});
+  int64_t y1 =
+      std::min(int64_t(std::floor(bottom)), int64_t(scissor.offset[1] + scissor.extent[1]));
+  if (x1 <= x0 || y1 <= y0) {
+    return false;
+  }
+  cutout_out.x_pixels = uint32_t(x0);
+  cutout_out.y_pixels = uint32_t(y0);
+  cutout_out.width_pixels = uint32_t(x1 - x0);
+  cutout_out.height_pixels = uint32_t(y1 - y0);
+  return true;
+}
