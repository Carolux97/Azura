+  virtual void ClearCaches() {}
+
+  // Groups of caches ClearCacheParts can drop on their own, to find which one holds wrong data.
+  enum CacheClearParts : uint32_t {
+    // Host textures: converted again from the shared memory when next used.
+    kCacheClearTextures = 1u << 0,
+    // The GPU copy of guest memory: every page the CPU wrote is uploaded again, and the textures
