+    kCacheClearSharedMemory = 1u << 1,
+    // Everything else: render targets that own no EDRAM data, framebuffers, primitive and uniform
+    // buffers.
+    kCacheClearOther = 1u << 2,
+    kCacheClearAll = kCacheClearTextures | kCacheClearSharedMemory | kCacheClearOther,
+  };
+  // ClearCaches limited to some CacheClearParts. Backends without the split drop everything.
