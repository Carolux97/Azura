+      // Debugging aid for rendering artifacts: the keys drop GPU caches, so the next frame uploads
+      // their data again from guest memory. An artifact that goes away with all of them was a
+      // stale host copy of data the guest has right; one that stays is in guest memory itself.
+      // The keys for one part each tell which cache holds the wrong copy.
+      if (REXCVAR_GET(debug_clear_gpu_caches_key)) {
+        for (const ClearGpuCachesBind& bind : kClearGpuCachesBinds) {
+          rex::ui::RegisterBind(bind.name, bind.key, bind.description, [graphics_system, bind] {
+            REXLOG_INFO("[Azura] Clearing GPU caches: {} ({})", bind.description, bind.name);
+            graphics_system->ClearCacheParts(bind.parts);
+          });
+          REXLOG_INFO("[Azura] {} ({}): {}", bind.name, bind.key, bind.description);
+        }
+      }
     }
