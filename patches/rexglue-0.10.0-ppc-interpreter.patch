+
+void BuilderContext::emit_unresolved_conditional_tail_call(bool not_, std::string_view cond,
+                                                          uint32_t target) {
+  // The CSR state stays as it was on the path that does not branch.
+  CSRState state = csrState;
+  println("\tif ({}{}.{}) {{", not_ ? "!" : "", cr(insn.operands[0]), cond);
+  emit_unresolved_call(target);
+  println("\t\treturn;");
+  println("\t}}");
+  csrState = state;
+}
+
+void BuilderContext::emit_unresolved_call(uint32_t address) {
+  // No function covers the target, so it has no recompiled code: the dispatcher finds whatever
+  // a module registered there, or runs it with the PowerPC interpreter (ppc_interpreter_fallback).
+  println("\t// unresolved function 0x{:08X}: called through the dispatcher", address);
+  println("\tREX_CALL_INDIRECT_FUNC(0x{:08X}u);", address);
+  csrState = CSRState::Unknown;
+}
+
+void BuilderContext::emit_spill_locals_to_context() {
+  // Registers kept in C++ locals are written back to ctx, where interpreted code reads them.
+  for (size_t i = 0; i < 32; ++i) {
+    if (auto name = r(i); !name.starts_with("ctx."))
+      println("\tctx.r{} = {};", i, name);
+    if (auto name = f(i); !name.starts_with("ctx."))
+      println("\tctx.f{} = {};", i, name);
+  }
+  for (size_t i = 0; i < 128; ++i) {
+    if (auto name = v(i); !name.starts_with("ctx."))
+      println("\tctx.v{} = {};", i, name);
+  }
+  for (size_t i = 0; i < 8; ++i) {
+    if (auto name = cr(i); !name.starts_with("ctx."))
+      println("\tctx.cr{} = {};", i, name);
+  }
+  if (std::string_view name = ctr(); !name.starts_with("ctx."))
+    println("\tctx.ctr = {};", name);
+  if (std::string_view name = xer(); !name.starts_with("ctx."))
+    println("\tctx.xer = {};", name);
+  if (std::string_view name = reserved(); !name.starts_with("ctx."))
+    println("\tctx.reserved = {};", name);
 }
 
