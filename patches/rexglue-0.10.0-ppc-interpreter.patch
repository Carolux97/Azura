+        break;
+      case PPC_INST_STFDX:
+        ctx.fpscr.disableFlushMode();
+        Store64(base, REX_X_EA(), Fpr(ctx, op[0]).u64);
+        break;
+      case PPC_INST_STFDU: {
+        ctx.fpscr.disableFlushMode();
+        uint32_t ea = REX_D_UPDATE_EA();
+        Store64(base, ea, Fpr(ctx, op[0]).u64);
+        Gpr(ctx, op[2]).u32 = ea;
+        break;
+      }
+      case PPC_INST_STFDUX: {
+        ctx.fpscr.disableFlushMode();
+        uint32_t ea = REX_X_UPDATE_EA();
+        Store64(base, ea, Fpr(ctx, op[0]).u64);
+        Gpr(ctx, op[1]).u32 = ea;
+        break;
+      }
+      case PPC_INST_STFIWX:
+        ctx.fpscr.disableFlushMode();
