new file mode 100644
index 0000000..b509f17
--- /dev/null
+++ b/tests/interp_bench/bench_case.h
@@ -0,0 +1,52 @@
+/**
+ * @file        tests/interp_bench/bench_case.h
+ * @brief       The cases of the PowerPC interpreter's differential bench
+ *
+ * `rexglue interp-bench-gen` writes a table of these: one instruction word per case, followed by
+ * `blr` at the case's address, and the code generator's function for it.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/ppc/func.h>
+
+// How the bench sets up registers so that the case's memory access lands in its windows of guest
+// memory.
+enum class BenchAddressing : uint8_t {
+  // No memory access.
+  kNone,
+  // (rA) + displacement, rA != 0.
+  kDForm,
+  // (rA|0) + (rB), rA != rB.
+  kXForm,
+};
+
+struct BenchCase {
+  uint32_t address;
+  uint32_t instruction;
+  // The decoder's name of the form ("add."), and the instruction as it prints it.
+  const char* form;
+  const char* text;
+  BenchAddressing addressing;
+  uint8_t ra;
+  uint8_t rb;
+  int32_t displacement;
+  // Alignment the effective address needs (atomic accesses).
+  uint8_t align;
+  // For stwcx. and stdcx.: size of the reservation, which the bench sometimes makes match memory
+  // so that the store happens.
+  uint8_t reserve_size;
+  // The code generator emitted a trap for this instruction (operand values its builder does not
+  // handle): the interpreter must stop on it rather than run it.
+  bool recompiled_traps;
+  PPCFunc* recompiled;
+};
+
+extern const BenchCase* const kBenchCases[];
+extern const size_t kBenchCaseCount;
diff --git a/tests/interp_bench/bench_main.cpp b/tests/interp_bench/bench_main.cpp
new file mode 100644
index 0000000..a58114e
--- /dev/null
+++ b/tests/interp_bench/bench_main.cpp
@@ -0,0 +1,727 @@
+/**
+ * @file        tests/interp_bench/bench_main.cpp
+ * @brief       Differential bench of the PowerPC interpreter
+ *
+ * Runs every case through the code generator's function for it and through the interpreter, from
+ * the same random state, and compares every field of PPCContext, the host floating point control
+ * register and the touched guest memory bit for bit.
+ *
+ * Usage: ppc_interp_bench [--seeds N] [--seed S] [--filter TEXT] [--report FILE] [--verbose]
+ *                         [--self-check]
+ *
+ * --self-check runs the recompiled code on both sides instead of the interpreter: every run must
+ * match, which shows the bench itself (states, memory windows, host floating point state) is
+ * deterministic.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <csetjmp>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <fstream>
+#include <limits>
+#include <map>
+#include <random>
+#include <string>
+#include <vector>
+
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <fmt/format.h>
+
+#include <rex/logging.h>
+#include <rex/ppc/context.h>
+#include <rex/ppc/context_access.h>
+#include <rex/system/ppc_interpreter.h>
+
+#include "bench_case.h"
+
+namespace {
+
+using rex::runtime::InterpreterResult;
+using rex::runtime::InterpreterStatus;
+
+//=============================================================================
+// Guest memory
+//=============================================================================
+
+// Guest memory is a 4 GB reservation, inaccessible except for the cases' code and two windows the
+// memory cases are pointed at: one at an ordinary address and one in the physical range at
+// 0xE0000000 and above, which the recompiled code maps 0x1000 bytes further on the host. An access
+// anywhere else faults, and the fault is reported for the case.
+constexpr uint64_t kGuestReserve = 0x100000000ull + 0x10000;
+constexpr uint32_t kWindowSize = 0x2000;
+
+struct Window {
+  uint32_t guest;
+  uint32_t host_offset;
+};
+
+constexpr std::array<Window, 2> kWindows = {{{0x40000000u, 0}, {0xE0010000u, 0x1000}}};
+
+uint8_t* gBase = nullptr;
+
+uint8_t* HostWindow(const Window& window) {
+  return gBase + window.guest + window.host_offset;
+}
+
+// Opens [offset, offset + size) of the reservation, rounded out to host pages (16 KB on Apple
+// silicon, so the physical window's 0x1000 shift is not page aligned).
+bool MakeAccessible(uint64_t offset, uint64_t size) {
+  uint64_t page = uint64_t(getpagesize());
+  uint64_t begin = offset & ~(page - 1);
+  uint64_t end = (offset + size + page - 1) & ~(page - 1);
+  return mprotect(gBase + begin, end - begin, PROT_READ | PROT_WRITE) == 0;
+}
+
+bool ReserveGuestMemory() {
+  void* reserved = mmap(nullptr, kGuestReserve, PROT_NONE, MAP_PRIVATE | MAP_ANON | MAP_NORESERVE,
+                        -1, 0);
+  if (reserved == MAP_FAILED) {
+    return false;
+  }
+  gBase = static_cast<uint8_t*>(reserved);
+  for (const Window& window : kWindows) {
+    if (!MakeAccessible(uint64_t(window.guest) + window.host_offset, kWindowSize)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Writes each case's instruction and the blr after it where the interpreter fetches them.
+bool WriteCode() {
+  if (kBenchCaseCount == 0) {
+    return true;
+  }
+  uint32_t first = kBenchCases[0]->address;
+  uint32_t last = kBenchCases[kBenchCaseCount - 1]->address + 8;
+  if (!MakeAccessible(first, last - first)) {
+    return false;
+  }
+  for (size_t i = 0; i < kBenchCaseCount; ++i) {
+    uint32_t words[2] = {__builtin_bswap32(kBenchCases[i]->instruction),
+                         __builtin_bswap32(0x4E800020u)};
+    std::memcpy(gBase + kBenchCases[i]->address, words, sizeof(words));
+  }
+  return true;
+}
+
+//=============================================================================
+// Faults
+//=============================================================================
+
+// A fault inside a case (a stray memory access, an illegal instruction) jumps back to the bench,
+// which reports it for that case and carries on.
+sigjmp_buf gFaultJump;
+volatile sig_atomic_t gInCase = 0;
+
+void OnFault(int signal) {
+  if (gInCase) {
+    gInCase = 0;
+    siglongjmp(gFaultJump, signal);
+  }
+  std::signal(signal, SIG_DFL);
+  std::raise(signal);
+}
+
+void InstallFaultHandlers() {
+  struct sigaction action {};
+  action.sa_handler = OnFault;
+  sigemptyset(&action.sa_mask);
+  for (int signal : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGTRAP}) {
+    sigaction(signal, &action, nullptr);
+  }
+}
+
+//=============================================================================
+// State
+//=============================================================================
+
+struct State {
+  PPCContext ctx;
+  std::array<std::array<uint8_t, kWindowSize>, kWindows.size()> windows;
+  // The host floating point control register after the case ran.
+  uint32_t host_fpcr = 0;
+};
+
+class Random {
+ public:
+  explicit Random(uint64_t seed) : engine_(seed) {}
+
+  uint64_t Next() { return engine_(); }
+  uint32_t Below(uint32_t n) { return uint32_t(engine_() % n); }
+  bool Chance(uint32_t one_in) { return Below(one_in) == 0; }
+
+  // Integer register values: small numbers, sign- and zero-extended words, full doublewords and
+  // the edges of the signed and unsigned ranges.
+  uint64_t Gpr() {
+    static constexpr uint64_t kEdges[] = {0,
+                                          1,
+                                          ~0ull,
+                                          0x7FFFFFFFull,
+                                          0x80000000ull,
+                                          0xFFFFFFFFull,
+                                          0xFFFFFFFF80000000ull,
+                                          0x7FFFFFFFFFFFFFFFull,
+                                          0x8000000000000000ull,
+                                          0x7FFFull,
+                                          0x8000ull,
+                                          0xFFFFull,
+                                          0x100000000ull};
+    switch (Below(6)) {
+      case 0:
+        return uint64_t(int64_t(int32_t(Below(33)) - 16));
+      case 1:
+        return uint64_t(int64_t(int32_t(uint32_t(Next()))));
+      case 2:
+        return uint32_t(Next());
+      case 3:
+        return kEdges[Below(std::size(kEdges))];
+      default:
+        return Next();
+    }
+  }
+
+  // Doubles: zeros, infinities, quiet and signaling NaNs, denormals, values a single holds
+  // exactly, integers around the conversion limits, and random bits.
+  uint64_t Fpr() {
+    static constexpr double kSpecials[] = {0.0,
+                                           -0.0,
+                                           1.0,
+                                           -1.0,
+                                           0.5,
+                                           std::numeric_limits<double>::infinity(),
+                                           -std::numeric_limits<double>::infinity(),
+                                           std::numeric_limits<double>::max(),
+                                           std::numeric_limits<double>::denorm_min(),
+                                           std::numeric_limits<double>::min(),
+                                           2147483647.0,
+                                           2147483648.0,
+                                           -2147483648.0,
+                                           -2147483649.0,
+                                           4294967295.0,
+                                           9223372036854775807.0,
+                                           -9223372036854775808.0,
+                                           1.5,
+                                           2.5,
+                                           -2.5,
+                                           3.4028234663852886e38,
+                                           1.1754943508222875e-38,
+                                           1.401298464324817e-45};
+    switch (Below(8)) {
+      case 0: {
+        static constexpr uint64_t kNans[] = {0x7FF8000000000000ull, 0xFFF8000000000000ull,
+                                             0x7FF0000000000001ull, 0x7FF4000000000000ull,
+                                             0xFFFFFFFFFFFFFFFFull};
+        return kNans[Below(std::size(kNans))];
+      }
+      case 1:
+      case 2: {
+        double value = kSpecials[Below(std::size(kSpecials))];
+        uint64_t bits;
+        std::memcpy(&bits, &value, sizeof(bits));
+        return bits;
+      }
+      case 3: {
+        // A random single, widened.
+        uint32_t single_bits = uint32_t(Next());
+        float single;
+        std::memcpy(&single, &single_bits, sizeof(single));
+        double value = single;
+        uint64_t bits;
+        std::memcpy(&bits, &value, sizeof(bits));
+        return bits;
+      }
+      case 4: {
+        // An ordinary number of moderate magnitude.
+        double value = double(int64_t(Next() % 2000001) - 1000000) / double(1 + Below(1000));
+        uint64_t bits;
+        std::memcpy(&bits, &value, sizeof(bits));
+        return bits;
+      }
+      default:
+        return Next();
+    }
+  }
+
+  // Vector lanes: random bits, float specials, small integers and bytes.
+  void Vr(PPCVRegister& v) {
+    for (int lane = 0; lane < 4; ++lane) {
+      switch (Below(6)) {
+        case 0: {
+          static constexpr uint32_t kFloats[] = {
+              0x00000000, 0x80000000, 0x3F800000, 0xBF800000, 0x7F800000, 0xFF800000,
+              0x7FC00000, 0xFFC00000, 0x7F800001, 0x00000001, 0x007FFFFF, 0x00800000,
+              0x7F7FFFFF, 0x4F000000, 0xCF000000, 0x3F000000, 0x40490FDB};
+          v.u32[lane] = kFloats[Below(std::size(kFloats))];
+          break;
+        }
+        case 1: {
+          float value = float(int32_t(Below(2001)) - 1000) / float(1 + Below(100));
+          std::memcpy(&v.u32[lane], &value, sizeof(value));
+          break;
+        }
+        case 2:
+          v.u32[lane] = uint32_t(int32_t(Below(65)) - 32);
+          break;
+        default:
+          v.u32[lane] = uint32_t(Next());
+          break;
+      }
+    }
+  }
+
+ private:
+  std::mt19937_64 engine_;
+};
+
+// The host floating point control register when the bench starts, with the host's exception
+// policy (PPCFPSCRRegister::InitHost); cases start from it with the guest's bits randomized.
+uint32_t gHostFpcr = 0;
+
+State MakeState(const BenchCase& c, uint64_t seed) {
+  Random random(seed);
+  State state;
+  PPCContext& ctx = state.ctx;
+  for (uint32_t i = 0; i < 32; ++i) {
+    rex::ppc::Gpr(ctx, i).u64 = random.Gpr();
+    rex::ppc::Fpr(ctx, i).u64 = random.Fpr();
+  }
+  for (uint32_t i = 0; i < 128; ++i) {
+    random.Vr(rex::ppc::Vr(ctx, i));
+  }
+  for (uint32_t i = 0; i < 8; ++i) {
+    PPCCRRegister& cr = rex::ppc::Cr(ctx, i);
+    cr.lt = random.Below(2);
+    cr.gt = random.Below(2);
+    cr.eq = random.Below(2);
+    cr.so = random.Below(2);
+  }
+  ctx.lr = random.Next();
+  ctx.ctr.u64 = random.Gpr();
+  ctx.xer.so = random.Below(2);
+  ctx.xer.ov = random.Below(2);
+  ctx.xer.ca = random.Below(2);
+  ctx.reserved.u64 = random.Next();
+  ctx.msr = random.Chance(2) ? 0x200A000u : uint32_t(random.Next());
+  ctx.vscr_sat = random.Below(2);
+  ctx.last_indirect_target = uint32_t(random.Next());
+  // Rounding mode and flush-to-zero are the guest's bits of the host register.
+  uint32_t guest_bits = 0;
+  guest_bits |= PPCFPSCRRegister::Platform::GuestToHost[random.Below(4)];
+  if (random.Chance(2)) {
+    guest_bits |= uint32_t(PPCFPSCRRegister::FlushMask);
+  }
+  ctx.fpscr.csr = (gHostFpcr & ~PPCFPSCRRegister::GuestMask) | guest_bits;
+
+  for (auto& window : state.windows) {
+    for (size_t i = 0; i < window.size(); i += 8) {
+      uint64_t bits = random.Next();
+      std::memcpy(window.data() + i, &bits, 8);
+    }
+  }
+
+  // Point the access at the middle of a window, leaving room for the largest one (stmw, dcbzl).
+  if (c.addressing != BenchAddressing::kNone) {
+    size_t window_index = random.Below(kWindows.size());
+    const Window& window = kWindows[window_index];
+    uint32_t offset = (0x800 + random.Below(0x800)) & ~uint32_t(c.align - 1);
+    uint32_t ea = window.guest + offset;
+    // The effective address is 32 bits; the upper half of a base register does not take part.
+    uint64_t upper = random.Chance(4) ? (random.Next() << 32) : 0;
+    if (c.addressing == BenchAddressing::kDForm) {
+      rex::ppc::Gpr(ctx, c.ra).u64 = upper | uint32_t(ea - uint32_t(c.displacement));
+    } else if (c.ra == 0) {
+      rex::ppc::Gpr(ctx, c.rb).u64 = upper | ea;
+    } else {
+      int32_t index = int32_t(random.Below(0x201)) - 0x100;
+      rex::ppc::Gpr(ctx, c.rb).u64 = uint64_t(int64_t(index));
+      rex::ppc::Gpr(ctx, c.ra).u64 = upper | uint32_t(ea - uint32_t(index));
+    }
+    // The reservation holds memory as loaded (big-endian); matching it lets the store happen.
+    if (c.reserve_size && random.Chance(2)) {
+      const uint8_t* memory = state.windows[window_index].data() + offset;
+      ctx.reserved.u64 = 0;
+      std::memcpy(&ctx.reserved.u64, memory, c.reserve_size);
+    }
+  }
+  return state;
+}
+
+//=============================================================================
+// Running a side
+//=============================================================================
+
+struct Outcome {
+  // Signal of a fault, or 0.
+  int fault = 0;
+  std::string exception;
+  InterpreterResult interpreter;
+};
+
+void LoadWindows(const State& state) {
+  for (size_t i = 0; i < kWindows.size(); ++i) {
+    std::memcpy(HostWindow(kWindows[i]), state.windows[i].data(), kWindowSize);
+  }
+}
+
+void StoreWindows(State& state) {
+  for (size_t i = 0; i < kWindows.size(); ++i) {
+    std::memcpy(state.windows[i].data(), HostWindow(kWindows[i]), kWindowSize);
+  }
+}
+
+// Runs one side on `state` in place: memory and the host register are set from it before, and
+// read back into it after.
+template <typename Body>
+Outcome RunSide(State& state, Body&& body) {
+  Outcome outcome;
+  LoadWindows(state);
+  PPCFPSCRRegister::Platform::setcsr(state.ctx.fpscr.csr);
+  int fault = sigsetjmp(gFaultJump, 1);
+  if (fault == 0) {
+    gInCase = 1;
+    try {
+      body(state.ctx, outcome);
+    } catch (const std::exception& e) {
+      outcome.exception = e.what();
+    }
+    gInCase = 0;
+  } else {
+    outcome.fault = fault;
+  }
+  state.host_fpcr = PPCFPSCRRegister::Platform::getcsr();
+  PPCFPSCRRegister::Platform::setcsr(gHostFpcr);
+  StoreWindows(state);
+  return outcome;
+}
+
+//=============================================================================
+// Comparison
+//=============================================================================
+
+struct Field {
+  std::string name;
+  size_t offset;
+  size_t size;
+};
+
+std::vector<Field> ContextFields() {
+  std::vector<Field> fields;
+  PPCContext probe;
+  auto offset = [&](const void* field) {
+    return size_t(static_cast<const uint8_t*>(field) - reinterpret_cast<const uint8_t*>(&probe));
+  };
+  for (uint32_t i = 0; i < 32; ++i) {
+    fields.push_back({fmt::format("r{}", i), offset(&rex::ppc::Gpr(probe, i)), 8});
+  }
+  fields.push_back({"lr", offset(&probe.lr), 8});
+  fields.push_back({"ctr", offset(&probe.ctr), 8});
+  fields.push_back({"xer.so", offset(&probe.xer.so), 1});
+  fields.push_back({"xer.ov", offset(&probe.xer.ov), 1});
+  fields.push_back({"xer.ca", offset(&probe.xer.ca), 1});
+  fields.push_back({"reserved", offset(&probe.reserved), 8});
+  fields.push_back({"msr", offset(&probe.msr), 4});
+  for (uint32_t i = 0; i < 8; ++i) {
+    PPCCRRegister& cr = rex::ppc::Cr(probe, i);
+    fields.push_back({fmt::format("cr{}.lt", i), offset(&cr.lt), 1});
+    fields.push_back({fmt::format("cr{}.gt", i), offset(&cr.gt), 1});
+    fields.push_back({fmt::format("cr{}.eq", i), offset(&cr.eq), 1});
+    fields.push_back({fmt::format("cr{}.so", i), offset(&cr.so), 1});
+  }
+  fields.push_back({"fpscr.csr", offset(&probe.fpscr.csr), 4});
+  fields.push_back({"vscr_sat", offset(&probe.vscr_sat), 1});
+  fields.push_back({"last_indirect_target", offset(&probe.last_indirect_target), 4});
+  for (uint32_t i = 0; i < 32; ++i) {
+    fields.push_back({fmt::format("f{}", i), offset(&rex::ppc::Fpr(probe, i)), 8});
+  }
+  for (uint32_t i = 0; i < 128; ++i) {
+    fields.push_back({fmt::format("v{}", i), offset(&rex::ppc::Vr(probe, i)), 16});
+  }
+  return fields;
+}
+
+const std::vector<Field>& Fields() {
+  static const std::vector<Field> fields = ContextFields();
+  return fields;
+}
+
+std::string Hex(const uint8_t* bytes, size_t size) {
+  // Registers are little-endian host values: print them most significant byte first.
+  std::string out = "0x";
+  for (size_t i = size; i-- > 0;) {
+    out += fmt::format("{:02X}", bytes[i]);
+  }
+  return out;
+}
+
+// The first difference between the two sides' results, or an empty string.
+std::string Compare(const State& recompiled, const State& interpreted) {
+  auto* a = reinterpret_cast<const uint8_t*>(&recompiled.ctx);
+  auto* b = reinterpret_cast<const uint8_t*>(&interpreted.ctx);
+  for (const Field& field : Fields()) {
+    if (std::memcmp(a + field.offset, b + field.offset, field.size) != 0) {
+      return fmt::format("{}: recompiled {}, interpreted {}", field.name,
+                         Hex(a + field.offset, field.size), Hex(b + field.offset, field.size));
+    }
+  }
+  if (recompiled.host_fpcr != interpreted.host_fpcr) {
+    return fmt::format("host FPCR: recompiled 0x{:08X}, interpreted 0x{:08X}",
+                       recompiled.host_fpcr, interpreted.host_fpcr);
+  }
+  for (size_t w = 0; w < kWindows.size(); ++w) {
+    const auto& ma = recompiled.windows[w];
+    const auto& mb = interpreted.windows[w];
+    auto diff = std::mismatch(ma.begin(), ma.end(), mb.begin());
+    if (diff.first != ma.end()) {
+      size_t at = size_t(diff.first - ma.begin());
+      return fmt::format("memory 0x{:08X}: recompiled {:02X}, interpreted {:02X}",
+                         kWindows[w].guest + uint32_t(at), *diff.first, *diff.second);
+    }
+  }
+  return {};
+}
+
+//=============================================================================
+// Bench
+//=============================================================================
+
+struct Options {
+  int seeds = 32;
+  uint64_t seed = 1;
+  std::string filter;
+  std::string report;
+  bool verbose = false;
+  bool self_check = false;
+};
+
+struct FormStats {
+  int cases = 0;
+  int runs = 0;
+  int passed = 0;
+  int mismatched = 0;
+  int unsupported = 0;
+  int invalid = 0;
+  // Cases where the recompiled code traps and the interpreter stopped too.
+  int stopped = 0;
+  // Faults or exceptions in the recompiled code: a problem of the bench's setup, not of the
+  // interpreter.
+  int recompiled_failed = 0;
+  int interpreter_failed = 0;
+  std::string first_failure;
+};
+
+std::string DescribeFault(const Outcome& outcome) {
+  if (outcome.fault) {
+    return fmt::format("signal {}", outcome.fault);
+  }
+  return fmt::format("exception: {}", outcome.exception);
+}
+
+// A case whose recompiled code traps is not run there: the interpreter must refuse it.
+void RunTrappingCase(const BenchCase& c, FormStats& stats) {
+  ++stats.runs;
+  State state = MakeState(c, 0);
+  Outcome outcome = RunSide(state, [&](PPCContext& ctx, Outcome& o) {
+    o.interpreter = rex::runtime::InterpretFunction(ctx, gBase, c.address);
+  });
+  if (!outcome.fault && outcome.exception.empty() &&
+      outcome.interpreter.status != InterpreterStatus::kReturned) {
+    ++stats.stopped;
+    return;
+  }
+  ++stats.interpreter_failed;
+  if (stats.first_failure.empty()) {
+    stats.first_failure = fmt::format("{}: the recompiled code traps, the interpreter {}", c.text,
+                                      outcome.fault || !outcome.exception.empty()
+                                          ? DescribeFault(outcome)
+                                          : std::string("ran it"));
+  }
+}
+
+void RunCase(const BenchCase& c, const Options& options, FormStats& stats) {
+  ++stats.cases;
+  if (c.recompiled_traps) {
+    if (!options.self_check) {
+      RunTrappingCase(c, stats);
+    }
+    return;
+  }
+  for (int s = 0; s < options.seeds; ++s) {
+    uint64_t seed = options.seed * 0x9E3779B97F4A7C15ull + uint64_t(c.address) * 1000003u + s;
+    State initial = MakeState(c, seed);
+    ++stats.runs;
+
+    State recompiled = initial;
+    Outcome a = RunSide(recompiled, [&](PPCContext& ctx, Outcome&) { c.recompiled(ctx, gBase); });
+    if (a.fault || !a.exception.empty()) {
+      ++stats.recompiled_failed;
+      if (stats.first_failure.empty()) {
+        stats.first_failure =
+            fmt::format("{} (seed {}): recompiled code failed, {}", c.text, seed, DescribeFault(a));
+      }
+      continue;
+    }
+
+    State interpreted = initial;
+    Outcome b = RunSide(interpreted, [&](PPCContext& ctx, Outcome& outcome) {
+      if (options.self_check) {
+        c.recompiled(ctx, gBase);
+      } else {
+        outcome.interpreter = rex::runtime::InterpretFunction(ctx, gBase, c.address);
+      }
+    });
+    if (b.fault || !b.exception.empty()) {
+      ++stats.interpreter_failed;
+      if (stats.first_failure.empty()) {
+        stats.first_failure =
+            fmt::format("{} (seed {}): interpreter failed, {}", c.text, seed, DescribeFault(b));
+      }
+      continue;
+    }
+    if (b.interpreter.status == InterpreterStatus::kUnsupported) {
+      // The rest of the seeds would say the same.
+      ++stats.unsupported;
+      return;
+    }
+    if (b.interpreter.status == InterpreterStatus::kInvalid) {
+      ++stats.invalid;
+      if (stats.first_failure.empty()) {
+        stats.first_failure = fmt::format("{}: the interpreter cannot decode 0x{:08X} at 0x{:08X}",
+                                          c.text, b.interpreter.instruction, b.interpreter.address);
+      }
+      return;
+    }
+    std::string difference = Compare(recompiled, interpreted);
+    if (difference.empty()) {
+      ++stats.passed;
+      continue;
+    }
+    ++stats.mismatched;
+    if (stats.first_failure.empty()) {
+      stats.first_failure = fmt::format("{} (seed {}): {}", c.text, seed, difference);
+    }
+  }
+}
+
+bool ParseOptions(int argc, char** argv, Options& options) {
+  for (int i = 1; i < argc; ++i) {
+    std::string arg = argv[i];
+    auto value = [&]() -> const char* { return i + 1 < argc ? argv[++i] : nullptr; };
+    if (arg == "--seeds") {
+      const char* v = value();
+      if (!v) return false;
+      options.seeds = std::max(1, std::atoi(v));
+    } else if (arg == "--seed") {
+      const char* v = value();
+      if (!v) return false;
+      options.seed = std::strtoull(v, nullptr, 0);
+    } else if (arg == "--filter") {
+      const char* v = value();
+      if (!v) return false;
+      options.filter = v;
+    } else if (arg == "--report") {
+      const char* v = value();
+      if (!v) return false;
+      options.report = v;
+    } else if (arg == "--verbose") {
+      options.verbose = true;
+    } else if (arg == "--self-check") {
+      options.self_check = true;
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  Options options;
+  if (!ParseOptions(argc, argv, options)) {
+    std::fprintf(stderr,
+                 "Usage: %s [--seeds N] [--seed S] [--filter TEXT] [--report FILE] [--verbose] "
+                 "[--self-check]\n",
+                 argv[0]);
+    return 2;
+  }
+  // Only errors: the cases' traps log a warning each.
+  rex::InitLogging(nullptr, spdlog::level::err);
+  {
+    PPCFPSCRRegister host{};
+    host.InitHost();
+    gHostFpcr = host.csr;
+  }
+  if (!ReserveGuestMemory() || !WriteCode()) {
+    std::fprintf(stderr, "Cannot set up guest memory\n");
+    return 2;
+  }
+  InstallFaultHandlers();
+
+  auto start = std::chrono::steady_clock::now();
+  // Forms in the order of the opcode table, as the cases are.
+  std::vector<std::string> order;
+  std::map<std::string, FormStats> forms;
+  for (size_t i = 0; i < kBenchCaseCount; ++i) {
+    const BenchCase& c = *kBenchCases[i];
+    if (!options.filter.empty() && std::string(c.form).find(options.filter) == std::string::npos) {
+      continue;
+    }
+    auto [it, inserted] = forms.try_emplace(c.form);
+    if (inserted) {
+      order.push_back(c.form);
+    }
+    RunCase(c, options, it->second);
+  }
+  double seconds =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+
+  int forms_passed = 0, forms_unsupported = 0, forms_failed = 0;
+  int cases = 0, runs = 0, runs_passed = 0;
+  std::ofstream report;
+  if (!options.report.empty()) {
+    report.open(options.report);
+    report << "form\tcases\truns\tpassed\tmismatched\tunsupported\tinvalid\tstopped\t"
+              "recompiled_failed\tinterpreter_failed\tfirst_failure\n";
+  }
+  for (const std::string& name : order) {
+    const FormStats& s = forms[name];
+    cases += s.cases;
+    runs += s.runs;
+    runs_passed += s.passed;
+    bool failed = s.mismatched || s.invalid || s.recompiled_failed || s.interpreter_failed;
+    if (failed) {
+      ++forms_failed;
+    } else if (s.unsupported && !s.passed) {
+      ++forms_unsupported;
+    } else {
+      ++forms_passed;
+    }
+    if (failed || options.verbose) {
+      std::printf("%-12s %s\n", name.c_str(),
+                  s.first_failure.empty() ? "ok" : s.first_failure.c_str());
+    }
+    if (report.is_open()) {
+      report << fmt::format("{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\n", name, s.cases,
+                            s.runs, s.passed, s.mismatched, s.unsupported, s.invalid, s.stopped,
+                            s.recompiled_failed, s.interpreter_failed, s.first_failure);
+    }
+  }
+  std::printf(
+      "Forms: %zu (passed %d, unsupported %d, failed %d). Cases: %d. Runs: %d, %d passed. "
+      "%.2f s.\n",
+      order.size(), forms_passed, forms_unsupported, forms_failed, cases, runs, runs_passed,
+      seconds);
+  return forms_failed ? 1 : 0;
+}
