+      }
+      case PPC_INST_STFSX: {
+        ctx.fpscr.disableFlushMode();
+        PPCRegister temp;
+        temp.f32 = float(Fpr(ctx, op[0]).f64);
+        Store32(base, REX_X_EA(), temp.u32);
+        break;
+      }
+      case PPC_INST_STFSU: {
+        ctx.fpscr.disableFlushMode();
+        uint32_t ea = REX_D_UPDATE_EA();
+        PPCRegister temp;
+        temp.f32 = float(Fpr(ctx, op[0]).f64);
+        Store32(base, ea, temp.u32);
+        Gpr(ctx, op[2]).u32 = ea;
+        break;
+      }
+      case PPC_INST_STFSUX: {
+        ctx.fpscr.disableFlushMode();
+        PPCRegister temp;
+        temp.f32 = float(Fpr(ctx, op[0]).f64);
