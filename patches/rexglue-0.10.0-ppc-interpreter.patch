new file mode 100644
index 0000000..d9d2d1a
--- /dev/null
+++ b/include/rex/ppc/context_access.h
@@ -0,0 +1,72 @@
+/**
+ * @file        rex/ppc/context_access.h
+ * @brief       Register access by number in PPCContext
+ *
+ * PPCContext names every register as a field of its own (r0..r31, f0..f31, v0..v127, cr0..cr7)
+ * because the recompiled code addresses them by name. Code that picks a register from an
+ * instruction's operand at run time (the interpreter, its differential bench) goes through these
+ * tables instead.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/ppc/context.h>
+
+namespace rex::ppc {
+
+namespace detail {
+
+template <typename T, size_t N>
+using MemberTable = std::array<T PPCContext::*, N>;
+
+inline constexpr MemberTable<PPCRegister, 32> kGprs = {
+    &PPCContext::r0,  &PPCContext::r1,  &PPCContext::r2,  &PPCContext::r3,  &PPCContext::r4,
+    &PPCContext::r5,  &PPCContext::r6,  &PPCContext::r7,  &PPCContext::r8,  &PPCContext::r9,
+    &PPCContext::r10, &PPCContext::r11, &PPCContext::r12, &PPCContext::r13, &PPCContext::r14,
+    &PPCContext::r15, &PPCContext::r16, &PPCContext::r17, &PPCContext::r18, &PPCContext::r19,
+    &PPCContext::r20, &PPCContext::r21, &PPCContext::r22, &PPCContext::r23, &PPCContext::r24,
+    &PPCContext::r25, &PPCContext::r26, &PPCContext::r27, &PPCContext::r28, &PPCContext::r29,
+    &PPCContext::r30, &PPCContext::r31};
+
+inline constexpr MemberTable<PPCRegister, 32> kFprs = {
+    &PPCContext::f0,  &PPCContext::f1,  &PPCContext::f2,  &PPCContext::f3,  &PPCContext::f4,
+    &PPCContext::f5,  &PPCContext::f6,  &PPCContext::f7,  &PPCContext::f8,  &PPCContext::f9,
+    &PPCContext::f10, &PPCContext::f11, &PPCContext::f12, &PPCContext::f13, &PPCContext::f14,
+    &PPCContext::f15, &PPCContext::f16, &PPCContext::f17, &PPCContext::f18, &PPCContext::f19,
+    &PPCContext::f20, &PPCContext::f21, &PPCContext::f22, &PPCContext::f23, &PPCContext::f24,
+    &PPCContext::f25, &PPCContext::f26, &PPCContext::f27, &PPCContext::f28, &PPCContext::f29,
+    &PPCContext::f30, &PPCContext::f31};
+
+inline constexpr MemberTable<PPCCRRegister, 8> kCrs = {
+    &PPCContext::cr0, &PPCContext::cr1, &PPCContext::cr2, &PPCContext::cr3,
+    &PPCContext::cr4, &PPCContext::cr5, &PPCContext::cr6, &PPCContext::cr7};
+
+}  // namespace detail
+
+inline PPCRegister& Gpr(PPCContext& ctx, uint32_t index) {
+  return ctx.*detail::kGprs[index & 31];
+}
+
+inline PPCRegister& Fpr(PPCContext& ctx, uint32_t index) {
+  return ctx.*detail::kFprs[index & 31];
+}
+
+inline PPCCRRegister& Cr(PPCContext& ctx, uint32_t index) {
+  return ctx.*detail::kCrs[index & 7];
+}
+
+// v0..v127 are consecutive fields of the same type, so they are indexed from v0.
+inline PPCVRegister& Vr(PPCContext& ctx, uint32_t index) {
+  static_assert(offsetof(PPCContext, v127) - offsetof(PPCContext, v0) ==
+                127 * sizeof(PPCVRegister));
+  return (&ctx.v0)[index & 127];
+}
+
+}  // namespace rex::ppc
diff --git a/include/rex/system/ppc_interpreter.h b/include/rex/system/ppc_interpreter.h
new file mode 100644
index 0000000..9d7c34a
--- /dev/null
+++ b/include/rex/system/ppc_interpreter.h
@@ -0,0 +1,66 @@
+/**
+ * @file        rex/system/ppc_interpreter.h
+ * @brief       PowerPC interpreter for guest functions the code generator did not find
+ *
+ * The recompiled code covers the functions the code generator found ahead of time. A call to any
+ * other guest code (a pointer to a function the analysis never saw) is run here, from the original
+ * instructions in guest memory, with the same semantics and calling convention as the recompiled
+ * code. See docs/ppc-interpreter-design.md in the project for the design.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include <rex/ppc/context.h>
+#include <rex/ppc/func.h>
+
+namespace rex::runtime {
+
+// Why the interpreter stopped.
+enum class InterpreterStatus : uint8_t {
+  // The function returned to its caller (`blr` at its own level).
+  kReturned,
+  // An instruction the interpreter does not implement yet.
+  kUnsupported,
+  // A word the decoder does not know.
+  kInvalid,
+};
+
+struct InterpreterResult {
+  InterpreterStatus status = InterpreterStatus::kReturned;
+  // The instruction that stopped the interpreter, when it did not return.
+  uint32_t address = 0;
+  uint32_t instruction = 0;
+};
+
+// Runs the guest function at `address` until it returns to its caller, as a recompiled function
+// would: registers in `ctx`, guest memory at `base`. Calls and branches to recompiled functions
+// run them; calls to any other code are interpreted too.
+InterpreterResult InterpretFunction(PPCContext& ctx, uint8_t* base, uint32_t address);
+
+// Finds the recompiled function at a guest address, or nullptr.
+using GuestFunctionResolver = PPCFunc* (*)(uint32_t address);
+
+// The function dispatcher's lookup (every loaded module), which the interpreter uses by default.
+PPCFunc* FindGuestFunction(uint32_t address);
+
+// Replaces how the interpreter finds recompiled functions (the differential bench has no
+// dispatcher); nullptr restores FindGuestFunction. Call it before interpreting anything, from the
+// thread that interprets.
+void SetGuestFunctionResolver(GuestFunctionResolver resolver);
+
+// The function dispatcher's fallback for a guest function that has no recompiled code: interprets
+// the function at ctx.last_indirect_target, which the caller sets before resolving the call, and
+// stops the game with a description if the interpreter cannot run it. Logs each function once, so
+// it can be added to the manifest as a function hint.
+void InterpretMissingFunction(PPCContext& ctx, uint8_t* base);
+
+// The instruction word as the decoder prints it ("addi r3,r1,16"), for reports.
+std::string DescribeInstruction(uint32_t address, uint32_t instruction);
+
+}  // namespace rex::runtime
