+  size_t blocking = ctx_.errors.Count() -
+                    ctx_.errors.Count(AnalysisErrors::Category::UnresolvedCall);
+  if (blocking && !force) {
     REXCODEGEN_ERROR("Code generation blocked: {} validation errors. Use --force to override.",
-                     ctx_.errors.Count());
+                     blocking);
     return false;
   }
 
@@ -233,6 +258,7 @@ bool CodegenWriter::write(bool force) {
