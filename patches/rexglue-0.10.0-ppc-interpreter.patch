+        break;
+      }
+      case PPC_INST_LFSX: {
+        ctx.fpscr.disableFlushMode();
+        PPCRegister temp;
+        temp.u32 = Load32(base, REX_X_EA());
+        Fpr(ctx, op[0]).f64 = double(temp.f32);
+        break;
+      }
+      case PPC_INST_LFSU: {
+        ctx.fpscr.disableFlushMode();
+        uint32_t ea = REX_D_UPDATE_EA();
+        PPCRegister temp;
+        temp.u32 = Load32(base, ea);
+        Fpr(ctx, op[0]).f64 = double(temp.f32);
+        Gpr(ctx, op[2]).u32 = ea;
+        break;
+      }
+      case PPC_INST_LFSUX: {
+        ctx.fpscr.disableFlushMode();
+        uint32_t ea = REX_X_UPDATE_EA();
+        PPCRegister temp;
+        temp.u32 = Load32(base, ea);
+        Fpr(ctx, op[0]).f64 = double(temp.f32);
+        Gpr(ctx, op[1]).u32 = ea;
+        break;
+      }
+      case PPC_INST_STFD:
+        ctx.fpscr.disableFlushMode();
