+/**
+ * @file        system/ppc_interpreter.cpp
+ * @brief       PowerPC interpreter for guest functions the code generator did not find
+ *
+ * Instructions are decoded by the code generator's own decoder (binutils, thirdparty/disasm), so
+ * the forms and operands are the ones the code generator's builders see. Each implemented form
+ * follows its builder in src/codegen/builders/ statement by statement, including the C++ integer
+ * promotions of the emitted expressions; the differential bench (tests/interp_bench) runs both on
+ * the same states and requires the same result bit for bit.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/system/ppc_interpreter.h>
+
+#include <atomic>
+#include <climits>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+
+#include <fmt/format.h>
+
+#include <rex/chrono/clock.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/ppc/context_access.h>
+
+#include <dis-asm.h>
+#include <ppc.h>
+
+namespace rex::runtime {
+
+namespace {
+
+using rex::ppc::Cr;
+using rex::ppc::Fpr;
+using rex::ppc::Gpr;
+
+//=============================================================================
+// Decoding
+//=============================================================================
+
+// Binutils PPC_OPCODE_* dialect bits of the Xenon CPU, the same set the code generator decodes
+// with (kXenonDialect in src/codegen/ppc/disasm.h).
+constexpr uintptr_t kXenonDialect = 0x1          // PPC
+                                    | 0x4        // 64
+                                    | 0x4000     // POWER4
+                                    | 0x8000000  // CELL
+                                    | 0x200      // ALTIVEC
+                                    | 0x1000000  // VMX_128
+                                    | 0x10000;   // CLASSIC
+
+// The binutils decoder keeps its configuration in a disassemble_info, one per thread.
+struct Decoder {
+  disassemble_info info{};
+
+  Decoder() {
+    INIT_DISASSEMBLE_INFO(info, stdout, fprintf);
+    info.arch = bfd_arch_powerpc;
+    info.endian = BFD_ENDIAN_BIG;
+    info.private_data = reinterpret_cast<void*>(kXenonDialect);
+  }
+
+  // Decodes one instruction word. Returns false for a word no form of the dialect matches.
+  bool Decode(uint32_t address, uint32_t instruction, ppc_insn& out) {
+    uint32_t big_endian = __builtin_bswap32(instruction);
+    info.buffer = reinterpret_cast<bfd_byte*>(&big_endian);
+    info.buffer_vma = address;
+    info.buffer_length = 4;
+    out.opcode = nullptr;
+    return decode_insn_ppc(address, &info, &out) == 4 && out.opcode != nullptr;
+  }
+};
+
+thread_local Decoder tDecoder;
+
+// A decoded instruction, as the builders see it.
+struct Instruction {
+  uint32_t word = 0;
+  // PPC_INST_*, or 0 for a word the decoder does not know.
+  int id = 0;
+  // Record form (the name has a '.'), which some builders follow with a cr0 update.
+  bool record = false;
+  const char* name = nullptr;
+  uint32_t op[8] = {};
+};
+
+// Decoded instructions by address. Relative branch targets depend on the address, so the cache is
+// keyed by it; the word is compared on every fetch in case the code changed.
+thread_local std::unordered_map<uint32_t, Instruction> tDecoded;
+
+//=============================================================================
+// Guest memory, as the generated code's REX_LOAD_* and REX_STORE_* macros access it
+//=============================================================================
+
+inline uint32_t PhysicalHostOffset(uint32_t address) {
+#if REX_PLATFORM_WIN32 || (REX_PLATFORM_MAC && REX_ARCH_ARM64)
+  return address >= 0xE0000000u ? 0x1000u : 0u;
+#else
+  (void)address;
+  return 0;
+#endif
+}
+
+inline uint8_t* RawAddress(uint8_t* base, uint32_t address) {
+  return base + address + PhysicalHostOffset(address);
+}
+
+inline uint8_t Load8(uint8_t* base, uint32_t ea) {
+  return *reinterpret_cast<volatile uint8_t*>(RawAddress(base, ea));
+}
+inline uint16_t Load16(uint8_t* base, uint32_t ea) {
+  return __builtin_bswap16(*reinterpret_cast<volatile uint16_t*>(RawAddress(base, ea)));
+}
+inline uint32_t Load32(uint8_t* base, uint32_t ea) {
+  return __builtin_bswap32(*reinterpret_cast<volatile uint32_t*>(RawAddress(base, ea)));
+}
+inline uint64_t Load64(uint8_t* base, uint32_t ea) {
+  return __builtin_bswap64(*reinterpret_cast<volatile uint64_t*>(RawAddress(base, ea)));
+}
+inline void Store8(uint8_t* base, uint32_t ea, uint8_t value) {
+  *reinterpret_cast<volatile uint8_t*>(RawAddress(base, ea)) = value;
+}
+inline void Store16(uint8_t* base, uint32_t ea, uint16_t value) {
+  *reinterpret_cast<volatile uint16_t*>(RawAddress(base, ea)) = __builtin_bswap16(value);
+}
+inline void Store32(uint8_t* base, uint32_t ea, uint32_t value) {
+  *reinterpret_cast<volatile uint32_t*>(RawAddress(base, ea)) = __builtin_bswap32(value);
+}
+inline void Store64(uint8_t* base, uint32_t ea, uint64_t value) {
+  *reinterpret_cast<volatile uint64_t*>(RawAddress(base, ea)) = __builtin_bswap64(value);
+}
+
+//=============================================================================
+// Helpers shared with the builders
+//=============================================================================
+
+// compute_mask in src/codegen/builders/helpers.h.
+inline uint64_t ComputeMask(uint32_t mstart, uint32_t mstop) {
+  mstart &= 0x3F;
+  mstop &= 0x3F;
+  uint64_t value = (UINT64_MAX >> mstart) ^ ((mstop >= 63) ? 0 : UINT64_MAX >> (mstop + 1));
+  return mstart <= mstop ? value : ~value;
+}
+
+// Bit `bit` (0-31) of the condition register: field bit / 4, in the order lt, gt, eq, so.
+inline uint8_t& CrBit(PPCContext& ctx, uint32_t bit) {
+  return reinterpret_cast<uint8_t*>(&Cr(ctx, bit / 4))[bit % 4];
+}
+
+// emitRecordFormCompare: record forms compare the low word of the result with 0 into cr0.
+inline void RecordForm(PPCContext& ctx, const Instruction& in) {
+  if (in.record) {
+    ctx.cr0.compare<int32_t>(Gpr(ctx, in.op[0]).s32, 0, ctx.xer);
+  }
+}
+
+// ppc_trap in the generated code's configuration header.
+void Trap(PPCContext& ctx, uint8_t* base, uint16_t trap_type) {
+  switch (trap_type) {
+    case 20:
+    case 26: {
+      auto str = std::string_view(reinterpret_cast<const char*>(RawAddress(base, ctx.r3.u32)),
+                                  ctx.r4.u16);
+      REXCPU_DEBUG("(service trap) {}", str);
+      break;
+    }
+    case 0:
+    case 22:
+      REXCPU_WARN("tw/td trap hit (type {})", trap_type);
+      break;
+    case 25:
+      break;
+    default:
+      REXCPU_WARN("Unknown trap type {}", trap_type);
+      break;
+  }
+}
+
+// emitTrap: the TO field selects signed less, signed greater, equal, unsigned less and unsigned
+// greater; all five is an unconditional trap.
+template <typename S, typename U>
+void ConditionalTrap(PPCContext& ctx, uint8_t* base, uint32_t to, S a_signed, U a_unsigned,
+                     S b_signed, U b_unsigned) {
+  if (to == 0) {
+    return;
+  }
+  if (to == 0x1F) {
+    Trap(ctx, base, 0);
+    return;
+  }
+  if (((to & 0x10) && a_signed < b_signed) || ((to & 0x08) && a_signed > b_signed) ||
+      ((to & 0x04) && a_signed == b_signed) || ((to & 0x02) && a_unsigned < b_unsigned) ||
+      ((to & 0x01) && a_unsigned > b_unsigned)) {
+    Trap(ctx, base, 0);
+  }
+}
+
+//=============================================================================
+// Calls
+//=============================================================================
+
+GuestFunctionResolver gResolver = &FindGuestFunction;
+
+// Recompiled functions found by address. Functions are only ever added, so a hit stays valid; a
+// miss is looked up again next time, since a module may have registered it since.
+thread_local std::unordered_map<uint32_t, PPCFunc*> tResolved;
+
+PPCFunc* Resolve(uint32_t address) {
+  auto it = tResolved.find(address);
+  if (it != tResolved.end()) {
+    return it->second;
+  }
+  PPCFunc* function = gResolver(address);
+  if (function) {
+    tResolved.emplace(address, function);
+  }
+  return function;
+}
+
+InterpreterResult Run(PPCContext& ctx, uint8_t* base, uint32_t entry);
+
+// REX_CALL_INDIRECT_FUNC: the recompiled function at the address, or, when there is none, the
+// guest code there, interpreted (what the dispatcher's fallback does), with last_indirect_target
+// set as the generated code sets it before resolving.
+InterpreterResult CallIndirect(PPCContext& ctx, uint8_t* base, uint32_t target) {
+  if (PPCFunc* function = Resolve(target)) {
+    function(ctx, base);
+    return {};
+  }
+  ctx.last_indirect_target = target;
+  return Run(ctx, base, target);
+}
+
+const Instruction& Fetch(uint8_t* base, uint32_t pc) {
+  uint32_t word = Load32(base, pc);
+  Instruction& in = tDecoded[pc];
+  if (in.name && in.word == word) {
+    return in;
+  }
+  in = {};
+  in.word = word;
+  ppc_insn insn;
+  if (tDecoder.Decode(pc, word, insn)) {
+    in.id = insn.opcode->id;
+    in.name = insn.opcode->name;
+    in.record = std::strchr(insn.opcode->name, '.') != nullptr;
+    std::memcpy(in.op, insn.operands, sizeof(in.op));
+  } else {
+    in.name = "";
+  }
+  return in;
+}
+
+//=============================================================================
+// The interpreter loop
+//=============================================================================
+
+// Runs guest code from `entry` until it returns to its caller. Each case follows the builder of
+// the same name in src/codegen/builders/.
+InterpreterResult Run(PPCContext& ctx, uint8_t* base, uint32_t entry) {
+  uint32_t pc = entry;
+  for (;;) {
+    const Instruction& in = Fetch(base, pc);
+    const uint32_t* op = in.op;
+    uint32_t next = pc + 4;
+
+    // Taken branches: a recompiled function at the target is a tail call, anything else a jump
+    // within the code being interpreted (what the generated code does with internal labels).
+    auto branch = [&](uint32_t target) -> bool {
+      if (target != entry) {
+        if (PPCFunc* function = Resolve(target)) {
+          function(ctx, base);
+          return true;
+        }
+      }
+      next = target;
+      return false;
+    };
+
+    switch (in.id) {
+      //=======================================================================
+      // Arithmetic (arithmetic.cpp)
+      //=======================================================================
+      case PPC_INST_ADD:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 + Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_ADDE: {
+        uint32_t a = Gpr(ctx, op[1]).u32, b = Gpr(ctx, op[2]).u32;
+        uint8_t ca = ctx.xer.ca;
+        uint8_t temp = uint8_t((uint32_t(a + b) < a) | (uint32_t(a + b + ca) < uint32_t(ca)));
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 + Gpr(ctx, op[2]).u64 + ca;
+        ctx.xer.ca = temp;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_ADDI:
+        Gpr(ctx, op[0]).u64 = (op[1] != 0 ? Gpr(ctx, op[1]).u64 : 0) + uint64_t(int64_t(int32_t(op[2])));
+        break;
+      case PPC_INST_ADDIC:
+        ctx.xer.ca = Gpr(ctx, op[1]).u32 > uint32_t(~op[2]);
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 + uint64_t(int64_t(int32_t(op[2])));
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_ADDIS:
+        Gpr(ctx, op[0]).u64 =
+            (op[1] != 0 ? Gpr(ctx, op[1]).u64 : 0) + uint64_t(int64_t(int32_t(op[2] << 16)));
+        break;
+      case PPC_INST_ADDZE: {
+        uint64_t temp = Gpr(ctx, op[1]).u64 + ctx.xer.ca;
+        ctx.xer.ca = uint32_t(temp) < Gpr(ctx, op[1]).u32;
+        Gpr(ctx, op[0]).u64 = temp;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_ADDME: {
+        uint32_t a = Gpr(ctx, op[1]).u32;
+        uint8_t ca = ctx.xer.ca;
+        uint8_t temp = uint8_t((uint32_t(a + 0xFFFFFFFFu) < a) |
+                               (uint32_t(a + 0xFFFFFFFFu + ca) < uint32_t(ca)));
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 + ca + 0xFFFFFFFFFFFFFFFFull;
+        ctx.xer.ca = temp;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_ADDC: {
+        uint32_t a = Gpr(ctx, op[1]).u32;
+        ctx.xer.ca = uint32_t(a + Gpr(ctx, op[2]).u32) < a;
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 + Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_DIVD: {
+        int64_t a = Gpr(ctx, op[1]).s64, b = Gpr(ctx, op[2]).s64;
+        Gpr(ctx, op[0]).s64 = (b && !(a == INT64_MIN && b == -1)) ? a / b : 0;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_DIVDU: {
+        uint64_t a = Gpr(ctx, op[1]).u64, b = Gpr(ctx, op[2]).u64;
+        Gpr(ctx, op[0]).u64 = b ? a / b : 0;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_DIVW: {
+        int32_t a = Gpr(ctx, op[1]).s32, b = Gpr(ctx, op[2]).s32;
+        Gpr(ctx, op[0]).u64 = uint32_t((b && !(a == INT32_MIN && b == -1)) ? a / b : 0);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_DIVWU: {
+        uint32_t a = Gpr(ctx, op[1]).u32, b = Gpr(ctx, op[2]).u32;
+        Gpr(ctx, op[0]).u64 = uint32_t(b ? a / b : 0);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_MULHW:
+        Gpr(ctx, op[0]).s64 =
+            (int64_t(Gpr(ctx, op[1]).s32) * int64_t(Gpr(ctx, op[2]).s32)) >> 32;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_MULHWU:
+        Gpr(ctx, op[0]).u64 =
+            (uint64_t(Gpr(ctx, op[1]).u32) * uint64_t(Gpr(ctx, op[2]).u32)) >> 32;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_MULLD:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 * Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_MULLI:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 * uint64_t(int64_t(int32_t(op[2])));
+        break;
+      case PPC_INST_MULLW:
+        Gpr(ctx, op[0]).s64 = int64_t(Gpr(ctx, op[1]).s32) * int64_t(Gpr(ctx, op[2]).s32);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_MULHD:
+        Gpr(ctx, op[0]).s64 = int64_t((__int128(Gpr(ctx, op[1]).s64) *
+                                       __int128(Gpr(ctx, op[2]).s64)) >> 64);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_MULHDU:
+        Gpr(ctx, op[0]).u64 = uint64_t((__uint128_t(Gpr(ctx, op[1]).u64) *
+                                        __uint128_t(Gpr(ctx, op[2]).u64)) >> 64);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_NEG:
+        Gpr(ctx, op[0]).u64 = -Gpr(ctx, op[1]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_SUBF:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[2]).u64 - Gpr(ctx, op[1]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_SUBFC:
+        ctx.xer.ca = Gpr(ctx, op[2]).u32 >= Gpr(ctx, op[1]).u32;
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[2]).u64 - Gpr(ctx, op[1]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_SUBFE: {
+        uint32_t not_a = ~Gpr(ctx, op[1]).u32, b = Gpr(ctx, op[2]).u32;
+        uint8_t ca = ctx.xer.ca;
+        uint8_t temp = uint8_t((uint32_t(not_a + b) < not_a) |
+                               (uint32_t(not_a + b + ca) < uint32_t(ca)));
+        Gpr(ctx, op[0]).u64 = ~Gpr(ctx, op[1]).u64 + Gpr(ctx, op[2]).u64 + ca;
+        ctx.xer.ca = temp;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_SUBFIC:
+        ctx.xer.ca = Gpr(ctx, op[1]).u32 <= op[2];
+        Gpr(ctx, op[0]).u64 = uint64_t(int64_t(int32_t(op[2]))) - Gpr(ctx, op[1]).u64;
+        break;
+      case PPC_INST_SUBFZE: {
+        uint32_t not_a = ~Gpr(ctx, op[1]).u32;
+        uint8_t ca = ctx.xer.ca;
+        uint8_t temp = uint8_t(uint32_t(not_a + ca) < not_a);
+        Gpr(ctx, op[0]).u64 = ~Gpr(ctx, op[1]).u64 + ca;
+        ctx.xer.ca = temp;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_SUBFME: {
+        uint32_t not_a = ~Gpr(ctx, op[1]).u32;
+        uint8_t ca = ctx.xer.ca;
+        uint8_t temp = uint8_t((uint32_t(not_a + 0xFFFFFFFFu) < not_a) |
+                               (uint32_t(not_a + 0xFFFFFFFFu + ca) < uint32_t(ca)));
+        Gpr(ctx, op[0]).u64 = ~Gpr(ctx, op[1]).u64 + ca + 0xFFFFFFFFFFFFFFFFull;
+        ctx.xer.ca = temp;
+        RecordForm(ctx, in);
+        break;
+      }
+
+      //=======================================================================
+      // Logical, shifts and rotates (logical.cpp)
+      //=======================================================================
+      case PPC_INST_AND:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 & Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_ANDC:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 & ~Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_ANDI:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 & op[2];
+        ctx.cr0.compare<int32_t>(Gpr(ctx, op[0]).s32, 0, ctx.xer);
+        break;
+      case PPC_INST_ANDIS:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 & uint32_t(op[2] << 16);
+        ctx.cr0.compare<int32_t>(Gpr(ctx, op[0]).s32, 0, ctx.xer);
+        break;
+      case PPC_INST_NAND:
+        Gpr(ctx, op[0]).u64 = ~(Gpr(ctx, op[1]).u64 & Gpr(ctx, op[2]).u64);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_NOR:
+        Gpr(ctx, op[0]).u64 = ~(Gpr(ctx, op[1]).u64 | Gpr(ctx, op[2]).u64);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_NOT:
+        Gpr(ctx, op[0]).u64 = ~Gpr(ctx, op[1]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_OR:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 | Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_ORC:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 | ~Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_ORI:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 | op[2];
+        break;
+      case PPC_INST_ORIS:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 | uint32_t(op[2] << 16);
+        break;
+      case PPC_INST_XOR:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 ^ Gpr(ctx, op[2]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_XORI:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 ^ op[2];
+        break;
+      case PPC_INST_XORIS:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 ^ uint32_t(op[2] << 16);
+        break;
+      case PPC_INST_EQV:
+        Gpr(ctx, op[0]).u64 = ~(Gpr(ctx, op[1]).u64 ^ Gpr(ctx, op[2]).u64);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_CNTLZD: {
+        uint64_t s = Gpr(ctx, op[1]).u64;
+        Gpr(ctx, op[0]).u64 = s == 0 ? 64 : __builtin_clzll(s);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_CNTLZW: {
+        uint32_t s = Gpr(ctx, op[1]).u32;
+        Gpr(ctx, op[0]).u64 = s == 0 ? 32 : __builtin_clz(s);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_EXTSB:
+        Gpr(ctx, op[0]).s64 = Gpr(ctx, op[1]).s8;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_EXTSH:
+        Gpr(ctx, op[0]).s64 = Gpr(ctx, op[1]).s16;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_EXTSW:
+        Gpr(ctx, op[0]).s64 = Gpr(ctx, op[1]).s32;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_CLRLWI:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u32 & ((1ull << (32 - op[2])) - 1);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_CLRLDI:
+        // The builder computes 1 << (64 - n) on the host, whose shifts take the amount modulo 64.
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64 & ((1ull << ((64 - op[2]) & 63)) - 1);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_RLDICL:
+        Gpr(ctx, op[0]).u64 =
+            __builtin_rotateleft64(Gpr(ctx, op[1]).u64, op[2]) & ComputeMask(op[3], 63);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_RLDICR:
+        Gpr(ctx, op[0]).u64 =
+            __builtin_rotateleft64(Gpr(ctx, op[1]).u64, op[2]) & ComputeMask(0, op[3]);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_RLDIC: {
+        uint32_t sh = op[2];
+        uint64_t mask = ComputeMask(op[3], 63 - sh);
+        Gpr(ctx, op[0]).u64 =
+            (sh ? __builtin_rotateleft64(Gpr(ctx, op[1]).u64, sh) : Gpr(ctx, op[1]).u64) & mask;
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_RLDCL:
+        Gpr(ctx, op[0]).u64 =
+            __builtin_rotateleft64(Gpr(ctx, op[1]).u64, Gpr(ctx, op[2]).u8 & 0x3F) &
+            ComputeMask(op[3], 63);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_RLDCR:
+        Gpr(ctx, op[0]).u64 =
+            __builtin_rotateleft64(Gpr(ctx, op[1]).u64, Gpr(ctx, op[2]).u8 & 0x3F) &
+            ComputeMask(0, op[3]);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_RLDIMI: {
+        uint64_t mask = ComputeMask(op[3], ~op[2]);
+        Gpr(ctx, op[0]).u64 = (__builtin_rotateleft64(Gpr(ctx, op[1]).u64, op[2]) & mask) |
+                              (Gpr(ctx, op[0]).u64 & ~mask);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_ROTLDI:
+        Gpr(ctx, op[0]).u64 = __builtin_rotateleft64(Gpr(ctx, op[1]).u64, op[2]);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_RLWIMI: {
+        uint64_t mask = ComputeMask(op[3] + 32, op[4] + 32);
+        uint64_t s = Gpr(ctx, op[1]).u32 | (Gpr(ctx, op[1]).u64 << 32);
+        Gpr(ctx, op[0]).u64 =
+            (__builtin_rotateleft64(s, op[2]) & mask) | (Gpr(ctx, op[0]).u64 & ~mask);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_RLWINM: {
+        uint64_t s = Gpr(ctx, op[1]).u32 | (Gpr(ctx, op[1]).u64 << 32);
+        Gpr(ctx, op[0]).u64 =
+            __builtin_rotateleft64(s, op[2]) & ComputeMask(op[3] + 32, op[4] + 32);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_RLWNM: {
+        uint64_t s = Gpr(ctx, op[1]).u32 | (Gpr(ctx, op[1]).u64 << 32);
+        Gpr(ctx, op[0]).u64 = __builtin_rotateleft64(s, Gpr(ctx, op[2]).u8 & 0x1F) &
+                              ComputeMask(op[3] + 32, op[4] + 32);
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_ROTLW:
+        Gpr(ctx, op[0]).u64 =
+            __builtin_rotateleft32(Gpr(ctx, op[1]).u32, Gpr(ctx, op[2]).u8 & 0x1F);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_ROTLWI:
+        Gpr(ctx, op[0]).u64 = __builtin_rotateleft32(Gpr(ctx, op[1]).u32, op[2]);
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_SLD: {
+        uint8_t n = Gpr(ctx, op[2]).u8;
+        Gpr(ctx, op[0]).u64 = (n & 0x40) ? 0 : (Gpr(ctx, op[1]).u64 << (n & 0x7F));
+        RecordForm(ctx, in);
+        break;
+      }
+      case PPC_INST_SLW: {
+        uint8_t n = Gpr(ctx, op[2]).u8;
+        Gpr(ctx, op[0]).u64 = (n & 0x20) ? 0 : uint32_t(Gpr(ctx, op[1]).u32 << (n & 0x3F));
