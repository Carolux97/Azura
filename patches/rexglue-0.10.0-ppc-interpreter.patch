diff --git a/src/system/ppc_interpreter.cpp b/src/system/ppc_interpreter.cpp
new file mode 100644
index 0000000..9f33f5e
--- /dev/null
+++ b/src/system/ppc_interpreter.cpp
@@ -0,0 +1,91 @@
+/**
+ * @file        system/ppc_interpreter.cpp
+ * @brief       PowerPC interpreter for guest functions the code generator did not find
+ *
+ * Instructions are decoded by the code generator's own decoder (binutils, thirdparty/disasm), so
+ * the forms and operands are the ones the code generator's builders see. Each implemented form
+ * follows its builder in src/codegen/builders/; the differential bench (tests/interp_bench) runs
+ * both on the same states and requires the same result bit for bit.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/system/ppc_interpreter.h>
+
+#include <cstdio>
+#include <cstring>
+
+#include <fmt/format.h>
+
+#include <dis-asm.h>
+#include <ppc.h>
+
+namespace rex::runtime {
+
+namespace {
+
+// Binutils PPC_OPCODE_* dialect bits of the Xenon CPU, the same set the code generator decodes
+// with (kXenonDialect in src/codegen/ppc/disasm.h).
+constexpr uintptr_t kXenonDialect = 0x1          // PPC
+                                    | 0x4        // 64
+                                    | 0x4000     // POWER4
+                                    | 0x8000000  // CELL
+                                    | 0x200      // ALTIVEC
+                                    | 0x1000000  // VMX_128
+                                    | 0x10000;   // CLASSIC
+
+// The binutils decoder keeps its configuration in a disassemble_info, one per thread.
+struct Decoder {
+  disassemble_info info{};
+
+  Decoder() {
+    INIT_DISASSEMBLE_INFO(info, stdout, fprintf);
+    info.arch = bfd_arch_powerpc;
+    info.endian = BFD_ENDIAN_BIG;
+    info.private_data = reinterpret_cast<void*>(kXenonDialect);
+  }
+
+  // Decodes one instruction word. Returns false for a word no form of the dialect matches.
+  bool Decode(uint32_t address, uint32_t instruction, ppc_insn& out) {
+    uint32_t big_endian = __builtin_bswap32(instruction);
+    info.buffer = reinterpret_cast<bfd_byte*>(&big_endian);
+    info.buffer_vma = address;
+    info.buffer_length = 4;
+    out.opcode = nullptr;
+    return decode_insn_ppc(address, &info, &out) == 4 && out.opcode != nullptr;
+  }
+};
+
+thread_local Decoder tDecoder;
+
+uint32_t FetchInstruction(const uint8_t* base, uint32_t address) {
+  uint32_t big_endian;
+  std::memcpy(&big_endian, base + address, sizeof(big_endian));
+  return __builtin_bswap32(big_endian);
+}
+
+}  // namespace
+
+InterpreterResult InterpretFunction(PPCContext& ctx, uint8_t* base, uint32_t address) {
+  (void)ctx;
+  uint32_t pc = address;
+  uint32_t instruction = FetchInstruction(base, pc);
+  ppc_insn insn;
+  if (!tDecoder.Decode(pc, instruction, insn)) {
+    return {InterpreterStatus::kInvalid, pc, instruction};
+  }
+  // No form is implemented yet.
+  return {InterpreterStatus::kUnsupported, pc, instruction};
+}
+
+std::string DescribeInstruction(uint32_t address, uint32_t instruction) {
+  ppc_insn insn;
+  if (!tDecoder.Decode(address, instruction, insn)) {
+    return fmt::format(".long 0x{:08X}", instruction);
+  }
+  return insn.op_str[0] ? fmt::format("{} {}", insn.opcode->name, insn.op_str)
+                        : std::string(insn.opcode->name);
+}
+
+}  // namespace rex::runtime
diff --git a/tests/interp_bench/CMakeLists.txt b/tests/interp_bench/CMakeLists.txt
new file mode 100644
index 0000000..61b84c4
--- /dev/null
+++ b/tests/interp_bench/CMakeLists.txt
@@ -0,0 +1,56 @@
+# Differential bench of the PowerPC interpreter (src/system/ppc_interpreter.cpp): every instruction
+# form the code generator builds runs through its recompiled code and through the interpreter from
+# the same random states, and the results must match bit for bit. Not part of the normal build:
+#   cmake --build <build dir> --target ppc_interp_bench
+#   <bin dir>/ppc_interp_bench [--seeds N] [--filter TEXT] [--report FILE] [--verbose]
+
+set(INTERP_BENCH_GEN_DIR ${CMAKE_CURRENT_BINARY_DIR}/generated)
+set(INTERP_BENCH_FUNCTION_SOURCES "")
+foreach(chunk RANGE 0 7)
+    list(APPEND INTERP_BENCH_FUNCTION_SOURCES ${INTERP_BENCH_GEN_DIR}/bench_functions_${chunk}.cpp)
+endforeach()
+
+# The recompiled side, written by the real code generator.
+add_custom_command(
+    OUTPUT ${INTERP_BENCH_GEN_DIR}/ppc_config.h
+           ${INTERP_BENCH_GEN_DIR}/bench_cases.cpp
+           ${INTERP_BENCH_FUNCTION_SOURCES}
+    COMMAND $<TARGET_FILE:rexglue> interp-bench-gen --output=${INTERP_BENCH_GEN_DIR}
+    DEPENDS rexglue
+    COMMENT "Generating the interpreter bench cases with rexglue"
+    VERBATIM
+)
+
+add_executable(ppc_interp_bench EXCLUDE_FROM_ALL
+    bench_main.cpp
+    ${INTERP_BENCH_GEN_DIR}/bench_cases.cpp
+    ${INTERP_BENCH_FUNCTION_SOURCES}
+)
+
+# The game's generated code is compiled without the SDK's strict floating point model (see
+# REXGLUE_RECOMP_OPTIONS in the generated rexglue.cmake), so the compiler may fuse a multiply and an
+# add there. The bench compiles its recompiled side the same way, so the interpreter is compared
+# with what the game actually runs.
+set_source_files_properties(${INTERP_BENCH_FUNCTION_SOURCES}
+    PROPERTIES COMPILE_OPTIONS "-ffp-model=precise;-O2")
+
+target_include_directories(ppc_interp_bench PRIVATE
+    ${REXGLUE_ROOT}/include
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${INTERP_BENCH_GEN_DIR}
+)
+
+target_link_libraries(ppc_interp_bench PRIVATE
+    simde
+    rexruntime
+    fmt::fmt
+)
+
+target_compile_options(ppc_interp_bench PRIVATE
+    -UTRACY_ENABLE -UREXGLUE_ENABLE_PROFILING
+    -UREXGLUE_ENABLE_PERF_COUNTERS -UREXGLUE_PROFILE_GUEST_FUNCTIONS
+)
+
+set_target_properties(ppc_interp_bench PROPERTIES
+    RUNTIME_OUTPUT_DIRECTORY $<TARGET_FILE_DIR:rexruntime>
+)
