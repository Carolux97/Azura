 namespace {
 
+// SetFunction calls per function of the generated registration. A compiler's time for a single
+// function grows faster than linearly with its size: one function holding every call (about
+// 57,000 in a large game) takes clang close to ten minutes, while functions of this size take
+// about a second and a half each.
+constexpr size_t kRegisterChunkSize = 2000;
+
+// The functions the registration hands to the dispatcher (the ones inside the code range, and the
+// imports), in chunks of kRegisterChunkSize, each written as its own function.
+nlohmann::json buildRegisterChunks(const nlohmann::json& functionsJson) {
+  nlohmann::json chunks = nlohmann::json::array();
+  for (const auto& fn : functionsJson) {
+    if (fn["below_code_base"].get<bool>() && !fn["is_import"].get<bool>()) {
+      continue;
+    }
+    if (chunks.empty() || chunks.back().size() == kRegisterChunkSize) {
+      chunks.push_back(nlohmann::json::array());
+    }
+    chunks.back().push_back({{"address", fn["address"]}, {"name", fn["name"]}});
+  }
+  return chunks;
+}
+
