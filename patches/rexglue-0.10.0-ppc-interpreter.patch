+      //=======================================================================
+      // System, cache and special registers (system.cpp)
+      //=======================================================================
+      case PPC_INST_NOP:
+      case PPC_INST_ATTN:
+      case PPC_INST_EIEIO:
+      case PPC_INST_DB16CYC:
+      case PPC_INST_CCTPL:
+      case PPC_INST_CCTPM:
+      case PPC_INST_CCTPH:
+      case PPC_INST_DCBF:
+      case PPC_INST_DCBT:
+      case PPC_INST_DCBTST:
+      case PPC_INST_DCBST:
+        break;
+      case PPC_INST_SYNC:
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        break;
+      case PPC_INST_LWSYNC:
+        std::atomic_thread_fence(std::memory_order_acq_rel);
+        break;
+      case PPC_INST_DCBZ: {
+        uint32_t ea = ((op[0] != 0 ? Gpr(ctx, op[0]).u32 : 0u) + Gpr(ctx, op[1]).u32) & ~31u;
+        std::memset(RawAddress(base, ea), 0, 32);
+        break;
+      }
+      case PPC_INST_DCBZL: {
+        uint32_t ea = ((op[0] != 0 ? Gpr(ctx, op[0]).u32 : 0u) + Gpr(ctx, op[1]).u32) & ~127u;
+        std::memset(RawAddress(base, ea), 0, 128);
+        break;
+      }
+
+      // Traps take their fields from the word, so the generic and simplified forms (tweq, ...)
+      // share one implementation, as they share one builder.
+      case PPC_INST_TDI:
+      case PPC_INST_TDLGTI:
+      case PPC_INST_TDLLTI:
+      case PPC_INST_TDEQI:
+      case PPC_INST_TDLGEI:
+      case PPC_INST_TDLNLI:
+      case PPC_INST_TDLLEI:
+      case PPC_INST_TDLNGI:
+      case PPC_INST_TDGTI:
+      case PPC_INST_TDGEI:
+      case PPC_INST_TDNLI:
+      case PPC_INST_TDLTI:
+      case PPC_INST_TDLEI:
+      case PPC_INST_TDNGI:
+      case PPC_INST_TDNEI: {
+        uint32_t to = (in.word >> 21) & 0x1F;
+        PPCRegister& a = Gpr(ctx, (in.word >> 16) & 0x1F);
+        int64_t simm = int16_t(in.word & 0xFFFF);
+        ConditionalTrap<int64_t, uint64_t>(ctx, base, to, a.s64, a.u64, simm, uint64_t(simm));
+        break;
+      }
+      case PPC_INST_TWI:
+      case PPC_INST_TWLGTI:
+      case PPC_INST_TWLLTI:
+      case PPC_INST_TWEQI:
+      case PPC_INST_TWLGEI:
+      case PPC_INST_TWLNLI:
+      case PPC_INST_TWLLEI:
+      case PPC_INST_TWLNGI:
+      case PPC_INST_TWGTI:
+      case PPC_INST_TWGEI:
+      case PPC_INST_TWNLI:
+      case PPC_INST_TWLTI:
+      case PPC_INST_TWLEI:
+      case PPC_INST_TWNGI:
+      case PPC_INST_TWNEI: {
+        uint32_t to = (in.word >> 21) & 0x1F;
+        uint32_t ra = (in.word >> 16) & 0x1F;
+        int32_t simm = int16_t(in.word & 0xFFFF);
+        if (to == 0x1F && ra == 0) {
+          // twi 31, r0, <code>: an unconditional trap with a service code.
+          Trap(ctx, base, uint16_t(simm));
+          break;
+        }
+        PPCRegister& a = Gpr(ctx, ra);
+        ConditionalTrap<int32_t, uint32_t>(ctx, base, to, a.s32, a.u32, simm, uint32_t(simm));
+        break;
+      }
+      case PPC_INST_TD:
+      case PPC_INST_TDGE:
+      case PPC_INST_TDGT:
+      case PPC_INST_TDLE:
+      case PPC_INST_TDLT:
+      case PPC_INST_TDEQ:
+      case PPC_INST_TDNE:
+      case PPC_INST_TDLGE:
+      case PPC_INST_TDLGT:
+      case PPC_INST_TDLLE:
+      case PPC_INST_TDLLT: {
+        uint32_t to = (in.word >> 21) & 0x1F;
+        PPCRegister& a = Gpr(ctx, (in.word >> 16) & 0x1F);
+        PPCRegister& b = Gpr(ctx, (in.word >> 11) & 0x1F);
+        ConditionalTrap<int64_t, uint64_t>(ctx, base, to, a.s64, a.u64, b.s64, b.u64);
+        break;
+      }
+      case PPC_INST_TW:
+      case PPC_INST_TWGE:
+      case PPC_INST_TWGT:
+      case PPC_INST_TWLE:
+      case PPC_INST_TWLT:
+      case PPC_INST_TWEQ:
+      case PPC_INST_TWNE:
+      case PPC_INST_TWLGE:
+      case PPC_INST_TWLGT:
+      case PPC_INST_TWLLE:
+      case PPC_INST_TWLLT: {
+        uint32_t to = (in.word >> 21) & 0x1F;
+        PPCRegister& a = Gpr(ctx, (in.word >> 16) & 0x1F);
+        PPCRegister& b = Gpr(ctx, (in.word >> 11) & 0x1F);
+        ConditionalTrap<int32_t, uint32_t>(ctx, base, to, a.s32, a.u32, b.s32, b.u32);
+        break;
+      }
+
+      case PPC_INST_MR:
+        Gpr(ctx, op[0]).u64 = Gpr(ctx, op[1]).u64;
+        RecordForm(ctx, in);
+        break;
+      case PPC_INST_MCRF:
+        Cr(ctx, op[0]) = Cr(ctx, op[1]);
+        break;
+      case PPC_INST_MFXER:
+        // The builder shifts the bytes as int: so << 31 is negative and sign-extends.
+        Gpr(ctx, op[0]).u64 = uint64_t(int64_t(int32_t(
+            (uint32_t(ctx.xer.so) << 31) | (uint32_t(ctx.xer.ov) << 30) |
+            (uint32_t(ctx.xer.ca) << 29))));
+        break;
+      case PPC_INST_MFCTR:
+        Gpr(ctx, op[0]).u64 = ctx.ctr.u64;
+        break;
+      case PPC_INST_MFCR: {
+        uint32_t value = 0;
+        for (uint32_t i = 0; i < 32; ++i) {
+          value |= CrBit(ctx, i) ? (1u << (31 - i)) : 0;
+        }
+        Gpr(ctx, op[0]).u64 = value;
+        break;
+      }
+      case PPC_INST_MFOCRF: {
+        uint32_t fxm = op[1];
+        uint32_t field = 0;
+        for (uint32_t i = 0; i < 8; ++i) {
+          if (fxm & (0x80u >> i)) {
+            field = i;
+            break;
+          }
+        }
+        uint32_t shift = 28 - 4 * field;
+        const PPCCRRegister& cr = Cr(ctx, field);
+        // Shifted as int, like mfxer: lt of cr0 lands in bit 31 and sign-extends.
+        Gpr(ctx, op[0]).u64 = uint64_t(int64_t(int32_t(
+            (uint32_t(cr.lt) << (shift + 3)) | (uint32_t(cr.gt) << (shift + 2)) |
+            (uint32_t(cr.eq) << (shift + 1)) | (uint32_t(cr.so) << shift))));
+        break;
+      }
+      case PPC_INST_MFLR:
+        Gpr(ctx, op[0]).u64 = ctx.lr;
+        break;
+      case PPC_INST_MFTB:
+        Gpr(ctx, op[0]).u64 = rex::chrono::Clock::QueryGuestTickCount();
+        break;
+      case PPC_INST_MFTBU:
+        Gpr(ctx, op[0]).u64 = rex::chrono::Clock::QueryGuestTickCount() >> 32;
+        break;
+      case PPC_INST_MTCR: {
+        uint32_t value = Gpr(ctx, op[0]).u32;
+        for (uint32_t i = 0; i < 32; ++i) {
+          CrBit(ctx, i) = (value & (1u << (31 - i))) != 0;
+        }
+        break;
+      }
+      case PPC_INST_MTCRF:
+      case PPC_INST_MTOCRF: {
+        uint32_t fxm = op[0];
+        uint32_t value = Gpr(ctx, op[1]).u32;
+        for (uint32_t field = 0; field < 8; ++field) {
+          if (fxm & (0x80u >> field)) {
+            uint32_t base_bit = 28 - 4 * field;
+            for (uint32_t b = 0; b < 4; ++b) {
+              CrBit(ctx, field * 4 + b) = (value & (1u << (base_bit + 3 - b))) != 0;
+            }
+          }
+        }
+        break;
+      }
+      case PPC_INST_MTCTR:
+        ctx.ctr.u64 = Gpr(ctx, op[0]).u64;
+        break;
+      case PPC_INST_MTLR:
+        ctx.lr = Gpr(ctx, op[0]).u64;
+        break;
+      case PPC_INST_MTXER: {
+        uint64_t value = Gpr(ctx, op[0]).u64;
+        ctx.xer.so = (value & 0x80000000) != 0;
+        ctx.xer.ov = (value & 0x40000000) != 0;
+        ctx.xer.ca = (value & 0x20000000) != 0;
+        break;
+      }
+
+      //=======================================================================
+      // Branches (control_flow.cpp). The generated code returns to its C++ caller on blr
+      // whatever lr holds, and continues after a call when the callee returns; so does the
+      // interpreter.
+      //=======================================================================
+      case PPC_INST_B:
+        if (branch(op[0])) {
+          return {};
+        }
+        break;
+      case PPC_INST_BL: {
+        uint32_t target = op[0];
+        ctx.lr = next;
+        if (PPCFunc* function = Resolve(target)) {
+          function(ctx, base);
+        } else if (target != next) {
+          InterpreterResult result = Run(ctx, base, target);
+          if (result.status != InterpreterStatus::kReturned) {
+            return result;
+          }
+        }
+        // bl to the next instruction only reads the program counter into lr.
+        break;
+      }
+      case PPC_INST_BLR:
+        return {};
+      case PPC_INST_BLRL: {
+        uint64_t old_lr = ctx.lr;
+        ctx.lr = next;
+        InterpreterResult result = CallIndirect(ctx, base, uint32_t(old_lr));
+        if (result.status != InterpreterStatus::kReturned) {
+          return result;
+        }
+        break;
+      }
+      case PPC_INST_BCTR: {
+        // A recompiled function is a tail call; anything else is a jump, which covers the jump
+        // tables the generated code turns into a switch.
+        uint32_t target = ctx.ctr.u32;
+        if (PPCFunc* function = Resolve(target)) {
+          function(ctx, base);
+          return {};
+        }
+        next = target;
+        break;
+      }
+      case PPC_INST_BCTRL: {
+        ctx.lr = next;
+        InterpreterResult result = CallIndirect(ctx, base, ctx.ctr.u32);
+        if (result.status != InterpreterStatus::kReturned) {
+          return result;
+        }
+        break;
+      }
+      case PPC_INST_BNECTR:
+        if (!Cr(ctx, op[0]).eq) {
+          return CallIndirect(ctx, base, ctx.ctr.u32);
+        }
+        break;
+
+      case PPC_INST_BDZ:
+        --ctx.ctr.u64;
+        if (ctx.ctr.u32 == 0 && branch(op[0])) {
+          return {};
+        }
+        break;
+      case PPC_INST_BDNZ:
+        --ctx.ctr.u64;
+        if (ctx.ctr.u32 != 0 && branch(op[0])) {
+          return {};
+        }
+        break;
+      case PPC_INST_BDZLR:
+        --ctx.ctr.u64;
+        if (ctx.ctr.u32 == 0) {
+          return {};
+        }
+        break;
+      case PPC_INST_BDNZLR:
+        --ctx.ctr.u64;
+        if (ctx.ctr.u32 != 0) {
+          return {};
+        }
+        break;
+      case PPC_INST_BDNZF:
+        --ctx.ctr.u64;
+        if (ctx.ctr.u32 != 0 && !CrBit(ctx, op[0]) && branch(op[1])) {
+          return {};
+        }
+        break;
+      case PPC_INST_BDNZT:
+        --ctx.ctr.u64;
+        if (ctx.ctr.u32 != 0 && CrBit(ctx, op[0]) && branch(op[1])) {
+          return {};
+        }
+        break;
+      case PPC_INST_BDZF:
+        --ctx.ctr.u64;
+        if (ctx.ctr.u32 == 0 && !CrBit(ctx, op[0]) && branch(op[1])) {
+          return {};
+        }
+        break;
+
+#define REX_CONDITIONAL_BRANCH(id, condition)        \
+  case id:                                           \
+    if ((condition) && branch(op[1])) {              \
+      return {};                                     \
+    }                                                \
+    break;
+#define REX_CONDITIONAL_RETURN(id, condition) \
+  case id:                                    \
+    if (condition) {                          \
+      return {};                              \
+    }                                         \
+    break;
+
+        REX_CONDITIONAL_BRANCH(PPC_INST_BEQ, Cr(ctx, op[0]).eq)
+        REX_CONDITIONAL_BRANCH(PPC_INST_BNE, !Cr(ctx, op[0]).eq)
+        REX_CONDITIONAL_BRANCH(PPC_INST_BLT, Cr(ctx, op[0]).lt)
+        REX_CONDITIONAL_BRANCH(PPC_INST_BGE, !Cr(ctx, op[0]).lt)
+        REX_CONDITIONAL_BRANCH(PPC_INST_BGT, Cr(ctx, op[0]).gt)
+        REX_CONDITIONAL_BRANCH(PPC_INST_BLE, !Cr(ctx, op[0]).gt)
+        REX_CONDITIONAL_BRANCH(PPC_INST_BSO, Cr(ctx, op[0]).so)
+        REX_CONDITIONAL_BRANCH(PPC_INST_BNS, !Cr(ctx, op[0]).so)
+        REX_CONDITIONAL_RETURN(PPC_INST_BEQLR, Cr(ctx, op[0]).eq)
+        REX_CONDITIONAL_RETURN(PPC_INST_BNELR, !Cr(ctx, op[0]).eq)
+        REX_CONDITIONAL_RETURN(PPC_INST_BLTLR, Cr(ctx, op[0]).lt)
+        REX_CONDITIONAL_RETURN(PPC_INST_BGELR, !Cr(ctx, op[0]).lt)
+        REX_CONDITIONAL_RETURN(PPC_INST_BGTLR, Cr(ctx, op[0]).gt)
+        REX_CONDITIONAL_RETURN(PPC_INST_BLELR, !Cr(ctx, op[0]).gt)
+        REX_CONDITIONAL_RETURN(PPC_INST_BSOLR, Cr(ctx, op[0]).so)
+        REX_CONDITIONAL_RETURN(PPC_INST_BNSLR, !Cr(ctx, op[0]).so)
+
+#undef REX_CONDITIONAL_BRANCH
+#undef REX_CONDITIONAL_RETURN
+
+      default:
+        if (in.vector) {
+          in.vector(ctx, base, op);
+          break;
+        }
+        // Not implemented yet, not built by the code generator either, or not decodable.
+        return {in.id ? InterpreterStatus::kUnsupported : InterpreterStatus::kInvalid, pc,
+                in.word};
+    }
+    pc = next;
+  }
+}
+
+}  // namespace
+
+InterpreterResult InterpretFunction(PPCContext& ctx, uint8_t* base, uint32_t address) {
+  return Run(ctx, base, address);
+}
+
+void SetGuestFunctionResolver(GuestFunctionResolver resolver) {
+  gResolver = resolver ? resolver : &FindGuestFunction;
+  tResolved.clear();
+}
+
+namespace {
+
+// What the fallback has run, per guest function, reported to the log every 10 seconds while it
+// runs anything. Times include the recompiled functions an interpreted one calls.
+struct FallbackStats {
+  uint64_t calls = 0;
+  uint64_t instructions = 0;
+  uint64_t nanoseconds = 0;
+};
+
+std::mutex gFallbackMutex;
+std::map<uint32_t, FallbackStats> gFallbackStats;
+std::chrono::steady_clock::time_point gFallbackLastReport;
+
+// Logs a function the first time the fallback runs it, before running it.
+void AnnounceFallback(uint32_t address, uint32_t caller) {
+  std::lock_guard<std::mutex> lock(gFallbackMutex);
+  if (gFallbackStats.try_emplace(address).second) {
+    REXCPU_WARN(
+        "Interpreting guest function 0x{:08X} (called from 0x{:08X}), which the code generator "
+        "did not find; add it to the manifest's function hints to recompile it",
+        address, caller);
+  }
+}
+
+void RecordFallback(uint32_t address, uint64_t instructions, uint64_t nanoseconds) {
+  std::lock_guard<std::mutex> lock(gFallbackMutex);
+  auto it = gFallbackStats.try_emplace(address).first;
+  it->second.calls++;
+  it->second.instructions += instructions;
+  it->second.nanoseconds += nanoseconds;
+  auto now = std::chrono::steady_clock::now();
+  if (now - gFallbackLastReport < std::chrono::seconds(10)) {
+    return;
+  }
+  gFallbackLastReport = now;
+  for (const auto& [function, stats] : gFallbackStats) {
+    REXCPU_INFO(
+        "Interpreter: 0x{:08X}: {} calls, {} instructions, {:.3f} ms in total, {:.1f} ns per "
+        "instruction",
+        function, stats.calls, stats.instructions, stats.nanoseconds / 1e6,
+        stats.instructions ? double(stats.nanoseconds) / double(stats.instructions) : 0.0);
+  }
+}
+
+}  // namespace
+
+void InterpretMissingFunction(PPCContext& ctx, uint8_t* base) {
+  uint32_t address = ctx.last_indirect_target;
+  AnnounceFallback(address, uint32_t(ctx.lr));
+  uint64_t instructions = tInstructions;
+  auto start = std::chrono::steady_clock::now();
+  InterpreterResult result = InterpretFunction(ctx, base, address);
+  RecordFallback(address, tInstructions - instructions,
+                 uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                              std::chrono::steady_clock::now() - start)
+                              .count()));
+  if (result.status != InterpreterStatus::kReturned) {
+    REX_FATAL("The PowerPC interpreter cannot run {} at 0x{:08X} ({}), in guest function 0x{:08X}",
+              result.status == InterpreterStatus::kInvalid ? "the unknown instruction"
+                                                           : "the unsupported instruction",
+              result.address, DescribeInstruction(result.address, result.instruction), address);
+  }
+}
+
+std::string DescribeInstruction(uint32_t address, uint32_t instruction) {
+  ppc_insn insn;
+  if (!tDecoder.Decode(address, instruction, insn)) {
+    return fmt::format(".long 0x{:08X}", instruction);
+  }
+  return insn.op_str[0] ? fmt::format("{} {}", insn.opcode->name, insn.op_str)
+                        : std::string(insn.opcode->name);
+}
+
+}  // namespace rex::runtime
