+      case PPC_INST_LFDU: {
+        ctx.fpscr.disableFlushMode();
+        uint32_t ea = REX_D_UPDATE_EA();
+        Fpr(ctx, op[0]).u64 = Load64(base, ea);
+        Gpr(ctx, op[2]).u32 = ea;
+        break;
+      }
+      case PPC_INST_LFDUX: {
+        ctx.fpscr.disableFlushMode();
+        uint32_t ea = REX_X_UPDATE_EA();
+        Fpr(ctx, op[0]).u64 = Load64(base, ea);
+        Gpr(ctx, op[1]).u32 = ea;
+        break;
+      }
+      case PPC_INST_LFS: {
