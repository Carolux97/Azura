+/**
+ * @file        rexglue/commands/interp_bench.cpp
+ * @brief       Case generator of the PowerPC interpreter's differential bench
+ *
+ * Every instruction form the code generator builds is run through the recompiled code and through
+ * the interpreter from the same state, and the results must match bit for bit (see
+ * tests/interp_bench). This command writes the recompiled side: for each form of the decoder's
+ * opcode table, a few instruction words with random operand fields, each followed by `blr` (or, for
+ * branches, laid out with internal labels and a callee) and recompiled by the real code generator
+ * as a function of its own, plus the table of cases and the image the bench runs. No assembler is
+ * needed: a word belongs to a form when the decoder decodes it to that form.
+ *
+ * @license     BSD 3-Clause License
+ */
+
+#include "interp_bench.h"
+#include "../ui/ui.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <optional>
+#include <memory>
+#include <random>
+#include <set>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#include <CLI/CLI.hpp>
+#include <fmt/format.h>
+#include <nlohmann/json.hpp>
+
+#include <rex/codegen/binary_view.h>
+#include <rex/codegen/codegen_context.h>
+#include <rex/codegen/function_graph.h>
+#include <rex/codegen/template_registry.h>
+#include <rex/codegen/test_support.h>
+#include <rex/logging.h>
+
+#include "codegen/builders.h"
+#include "codegen/ppc/disasm.h"
+#include "codegen/template_registry_internal.h"
+
+// The decoder's opcode table (thirdparty/disasm/ppc-dis.c).
+extern "C" {
+extern const struct powerpc_opcode powerpc_opcodes[];
+extern const int powerpc_num_opcodes;
+}
+
+namespace rexglue::cli {
+
+namespace {
+
+namespace fs = std::filesystem;
+namespace codegen = rex::codegen;
+
+// Where the image is linked, as for the recompiler tests: the callee, then the cases.
+constexpr uint32_t kBenchBaseAddress = 0x82010000;
+constexpr uint32_t kBlr = 0x4E800020;
+// The generated functions are split over this many source files, so they compile in parallel.
+constexpr int kFunctionChunks = 8;
+// Random words tried per form before giving up on finding more cases for it.
+constexpr int kAttemptsPerForm = 4000;
+
+// How the bench must set up registers so that a memory access lands in its windows of guest
+// memory. Mirrors BenchAddressing in tests/interp_bench/bench_case.h.
+enum class Addressing { kNone, kDForm, kXForm };
+
+struct MemoryForm {
+  Addressing addressing;
+  // D-form instructions whose displacement's two low bits are part of the opcode (DS-form).
+  bool ds_form = false;
+  // Alignment the effective address needs on the host (atomic accesses).
+  uint8_t align = 1;
+  // Size of the reservation stwcx./stdcx. compare with memory.
+  uint8_t reserve_size = 0;
+  // Forms that write the effective address back to rA, where rA = 0 is an invalid form that the
+  // recompiled code reads as r0 rather than as the literal 0.
+  bool update = false;
+};
+
+// Instructions that access memory, by how their effective address is formed.
+const std::map<int, MemoryForm>& MemoryForms() {
+  static const std::map<int, MemoryForm> forms = [] {
+    std::map<int, MemoryForm> m;
+    for (int id : {PPC_INST_LBZ,  PPC_INST_LBZU,  PPC_INST_LHA,  PPC_INST_LHAU, PPC_INST_LHZ,
+                   PPC_INST_LHZU, PPC_INST_LWZ,   PPC_INST_LWZU, PPC_INST_LFD,  PPC_INST_LFDU,
+                   PPC_INST_LFS,  PPC_INST_LFSU,  PPC_INST_STB,  PPC_INST_STBU, PPC_INST_STH,
+                   PPC_INST_STHU, PPC_INST_STW,   PPC_INST_STWU, PPC_INST_STMW, PPC_INST_STFD,
+                   PPC_INST_STFDU, PPC_INST_STFS, PPC_INST_STFSU}) {
+      m[id] = {Addressing::kDForm};
+    }
+    for (int id : {PPC_INST_LWA, PPC_INST_LD, PPC_INST_LDU, PPC_INST_STD, PPC_INST_STDU}) {
+      m[id] = {Addressing::kDForm, true};
+    }
+    for (int id :
+         {PPC_INST_LBZX,    PPC_INST_LBZUX,    PPC_INST_LHAX,     PPC_INST_LHAUX,   PPC_INST_LHBRX,
+          PPC_INST_LHZX,    PPC_INST_LHZUX,    PPC_INST_LWAX,     PPC_INST_LWAUX,   PPC_INST_LWZX,
+          PPC_INST_LWZUX,   PPC_INST_LWBRX,    PPC_INST_LDX,      PPC_INST_LDUX,    PPC_INST_LFDX,
+          PPC_INST_LFDUX,   PPC_INST_LFSX,     PPC_INST_LFSUX,    PPC_INST_STBX,    PPC_INST_STBUX,
+          PPC_INST_STHBRX,  PPC_INST_STHX,     PPC_INST_STHUX,    PPC_INST_STWX,    PPC_INST_STWUX,
+          PPC_INST_STWBRX,  PPC_INST_STDX,     PPC_INST_STDUX,    PPC_INST_STFDX,   PPC_INST_STFDUX,
+          PPC_INST_STFIWX,  PPC_INST_STFSX,    PPC_INST_STFSUX,   PPC_INST_LVX,     PPC_INST_LVX128,
+          PPC_INST_LVXL,    PPC_INST_LVXL128,  PPC_INST_LVLX,     PPC_INST_LVLX128, PPC_INST_LVRX,
+          PPC_INST_LVRX128, PPC_INST_LVSL,     PPC_INST_LVSR,     PPC_INST_LVEBX,   PPC_INST_LVEHX,
+          PPC_INST_LVEWX,   PPC_INST_LVEWX128, PPC_INST_STVEBX,   PPC_INST_STVEHX,  PPC_INST_STVEWX,
+          PPC_INST_STVEWX128, PPC_INST_STVLX,  PPC_INST_STVLX128, PPC_INST_STVLXL128,
+          PPC_INST_STVRX,   PPC_INST_STVRX128, PPC_INST_STVX,     PPC_INST_STVX128, PPC_INST_STVXL,
+          PPC_INST_DCBF,    PPC_INST_DCBT,     PPC_INST_DCBTST,   PPC_INST_DCBZ,    PPC_INST_DCBZL,
+          PPC_INST_DCBST}) {
+      m[id] = {Addressing::kXForm};
+    }
+    for (int id : {PPC_INST_LBZUX, PPC_INST_LHAUX, PPC_INST_LHZUX, PPC_INST_LWAUX, PPC_INST_LWZUX,
+                   PPC_INST_LDUX, PPC_INST_LFDUX, PPC_INST_LFSUX, PPC_INST_STBUX, PPC_INST_STHUX,
+                   PPC_INST_STWUX, PPC_INST_STDUX, PPC_INST_STFDUX, PPC_INST_STFSUX}) {
+      m[id].update = true;
+    }
+    m[PPC_INST_LWARX] = {Addressing::kXForm, false, 8, 0};
+    m[PPC_INST_LDARX] = {Addressing::kXForm, false, 8, 0};
+    m[PPC_INST_STWCX] = {Addressing::kXForm, false, 8, 4};
+    m[PPC_INST_STDCX] = {Addressing::kXForm, false, 8, 8};
+    return m;
+  }();
+  return forms;
+}
+
+// Why a form of the opcode table has no cases.
+enum class Exclusion { kNone, kDialect, kNotBuilt, kAbsoluteBranch, kNondeterministic };
+
+// How a branch form is laid out in its cases (see BranchLayout).
+enum class Branch {
+  kNone,
+  // bc forms testing a CR bit (beq, bne, ...): to an internal label, or a tail call to the
+  // callee.
+  kConditional,
+  // bc forms that decrement CTR (bdnz, bdz, ...): to an internal label. The generated code turns a
+  // CTR branch out of its function into a return, so the callee is not a target.
+  kCounterConditional,
+  // bclr forms without link (blr, beqlr, bdnzlr, ...).
+  kReturn,
+  // blrl, with LR pointing at the callee.
+  kReturnAndLink,
+  // bcctr forms without link (bctr, bnectr), with CTR pointing at the callee.
+  kCounter,
+  // bctrl, with CTR pointing at the callee.
+  kCounterAndLink,
+  // b: to an internal label, or a tail call to the callee.
+  kBranch,
+  // bl: a call to the callee. (A bl to the next instruction, which only reads the program
+  // counter, does not compile: the code generator emits a goto to a label it never defines.)
+  kBranchAndLink,
+};
+
+Branch ClassifyBranch(const powerpc_opcode& form) {
+  uint32_t opcode = uint32_t(form.opcode);
+  uint32_t primary = opcode >> 26;
+  uint32_t extended = (opcode >> 1) & 0x3FF;
+  bool link = opcode & 1;
+  if (primary == 16) {
+    switch (form.id) {
+      case PPC_INST_BDZ:
+      case PPC_INST_BDNZ:
+      case PPC_INST_BDZF:
+      case PPC_INST_BDNZF:
+      case PPC_INST_BDNZT:
+        return Branch::kCounterConditional;
+      default:
+        return Branch::kConditional;
+    }
+  }
+  if (primary == 18) {
+    return link ? Branch::kBranchAndLink : Branch::kBranch;
+  }
+  if (primary == 19 && extended == 16) {
+    return link ? Branch::kReturnAndLink : Branch::kReturn;
+  }
+  if (primary == 19 && extended == 528) {
+    return link ? Branch::kCounterAndLink : Branch::kCounter;
+  }
+  return Branch::kNone;
+}
+
+// The time base differs between two runs, and mtmsrd takes and releases the global lock. Absolute
+// branches would need code at addresses below 32 KB.
+Exclusion ExcludeForm(const powerpc_opcode& form) {
+  if ((form.flags & codegen::ppc::kXenonDialect) == 0) {
+    return Exclusion::kDialect;
+  }
+  if (!codegen::IsInstructionImplemented(form.id)) {
+    return Exclusion::kNotBuilt;
+  }
+  uint32_t primary = uint32_t(form.opcode) >> 26;
+  if ((primary == 16 || primary == 18) && (uint32_t(form.opcode) & 2)) {
+    return Exclusion::kAbsoluteBranch;
+  }
+  if (form.id == PPC_INST_MFTB || form.id == PPC_INST_MFTBU || form.id == PPC_INST_MTMSRD) {
+    return Exclusion::kNondeterministic;
+  }
+  return Exclusion::kNone;
+}
+
+// What the bench sets up before a branch case. Mirrors BenchSetup in tests/interp_bench.
+enum class Setup { kNone, kCtrToCallee, kLrToCallee };
+
+struct Case {
+  uint32_t address = 0;
+  // The case's code: the instruction under test first.
+  std::vector<uint32_t> words;
+  const powerpc_opcode* form = nullptr;
+  std::string text;
+  Addressing addressing = Addressing::kNone;
+  uint32_t ra = 0;
+  uint32_t rb = 0;
+  int32_t displacement = 0;
+  uint8_t align = 1;
+  uint8_t reserve_size = 0;
+  Setup setup = Setup::kNone;
+  // A b or bc to the callee, which the code generator emits as a tail call.
+  bool tail_call = false;
+};
+
+// Builders emit a debug trap for operand values they do not handle (some vpkd3d128 and vupkd3d128
+// types); the interpreter must stop on those too.
+bool RecompiledCodeTraps(const std::string& code) {
+  return code.find("__builtin_debugtrap") != std::string::npos ||
+         code.find("__builtin_trap") != std::string::npos ||
+         code.find("REX_UNIMPLEMENTED") != std::string::npos;
+}
+
+// Fills the addressing of a memory case from its word. Returns false for words the bench cannot
+// point at its windows: a D-form access without a base register (an absolute address), an X-form
+// access adding a register to itself, or an update form with rA = 0.
+bool SetAddressing(Case& c) {
+  auto it = MemoryForms().find(c.form->id);
+  if (it == MemoryForms().end()) {
+    return true;
+  }
+  const MemoryForm& memory = it->second;
+  uint32_t word = c.words[0];
+  c.addressing = memory.addressing;
+  c.align = memory.align;
+  c.reserve_size = memory.reserve_size;
+  c.ra = (word >> 16) & 0x1F;
+  c.rb = (word >> 11) & 0x1F;
+  if (memory.addressing == Addressing::kDForm) {
+    c.displacement = int16_t(word & (memory.ds_form ? 0xFFFC : 0xFFFF));
+    return c.ra != 0;
+  }
+  if (c.ra == 0) {
+    return !memory.update;
+  }
+  return c.ra != c.rb;
+}
+
+// A service trap reads a string from guest memory at r3 to log it, which no case sets up.
+bool IsServiceTrap(uint32_t word) {
+  uint32_t to = (word >> 21) & 0x1F;
+  uint32_t ra = (word >> 16) & 0x1F;
+  uint16_t code = uint16_t(word & 0xFFFF);
+  return (word >> 26) == 3 && to == 0x1F && ra == 0 && (code == 20 || code == 26);
+}
+
+// The decoder's text of a word at an address, or nullopt if it does not decode to `form`.
+std::optional<std::string> DecodesTo(uint32_t word, uint32_t address, const powerpc_opcode& form) {
+  uint32_t big_endian = __builtin_bswap32(word);
+  ppc_insn insn;
+  if (codegen::ppc::Disassemble(&big_endian, 4, address, insn) != 4 || insn.opcode != &form) {
+    return std::nullopt;
+  }
+  return insn.op_str[0] ? fmt::format("{} {}", form.name, insn.op_str) : std::string(form.name);
+}
+
+// Places a branch displacement: bits 2-25 for b and bl, bits 2-15 for bc.
+uint32_t WithDisplacement(uint32_t word, int32_t displacement) {
+  uint32_t mask = (word >> 26) == 18 ? 0x03FFFFFCu : 0x0000FFFCu;
+  return (word & ~mask) | (uint32_t(displacement) & mask);
+}
+
+// `li r3, value`: marks which path a branch case took.
+uint32_t LoadImmediateR3(int16_t value) {
+  return 0x38600000u | uint16_t(value);
+}
+
+// Lays out a branch case at `address`. `variant` picks between the two layouts of a kind. Returns
+// false when the patched word no longer decodes to the form (the displacement can change which
+// table entry matches, through the branch prediction hint).
+bool BranchLayout(Case& c, Branch kind, uint32_t address, uint32_t callee, bool variant) {
+  uint32_t word = c.words[0];
+  auto to = [&](uint32_t target) {
+    return WithDisplacement(word, int32_t(target - address));
+  };
+  switch (kind) {
+    case Branch::kConditional:
+    case Branch::kCounterConditional:
+      if (variant && kind == Branch::kConditional) {
+        c.words = {to(callee), LoadImmediateR3(1), kBlr};
+        c.tail_call = true;
+      } else {
+        c.words = {to(address + 12), LoadImmediateR3(1), kBlr, LoadImmediateR3(2), kBlr};
+      }
+      break;
+    case Branch::kReturn:
+      c.words = {word, LoadImmediateR3(1), kBlr};
+      break;
+    case Branch::kReturnAndLink:
+      c.words = {word, LoadImmediateR3(1), kBlr};
+      c.setup = Setup::kLrToCallee;
+      break;
+    case Branch::kCounter:
+    case Branch::kCounterAndLink:
+      c.words = {word, LoadImmediateR3(1), kBlr};
+      c.setup = Setup::kCtrToCallee;
+      break;
+    case Branch::kBranch:
+      if (variant) {
+        c.words = {to(callee), kBlr};
+        c.tail_call = true;
+      } else {
+        c.words = {to(address + 8), LoadImmediateR3(1), LoadImmediateR3(2), kBlr};
+      }
+      break;
+    case Branch::kBranchAndLink:
+      c.words = {to(callee), LoadImmediateR3(1), kBlr};
+      break;
+    case Branch::kNone:
+      break;
+  }
+  auto text = DecodesTo(c.words[0], address, *c.form);
+  if (!text) {
+    return false;
+  }
+  c.text = *text;
+  return true;
+}
+
+std::string CppString(std::string_view text) {
+  std::string out = "\"";
+  for (char ch : text) {
+    if (ch == '"' || ch == '\\') {
+      out += '\\';
+    }
+    out += ch;
+  }
+  return out + "\"";
+}
+
+const char* AddressingName(Addressing addressing) {
+  switch (addressing) {
+    case Addressing::kDForm:
+      return "BenchAddressing::kDForm";
+    case Addressing::kXForm:
+      return "BenchAddressing::kXForm";
+    default:
+      return "BenchAddressing::kNone";
+  }
+}
+
+const char* SetupName(Setup setup) {
+  switch (setup) {
+    case Setup::kCtrToCallee:
+      return "BenchSetup::kCtrToCallee";
+    case Setup::kLrToCallee:
+      return "BenchSetup::kLrToCallee";
+    default:
+      return "BenchSetup::kNone";
+  }
+}
+
+bool GenerateInterpBench(const std::string& outDir, int casesPerForm, uint64_t seed) {
+  std::array<ui::KeyValueRow, 3> header_rows = {{
+      {"Output dir", outDir},
+      {"Cases per form", std::to_string(casesPerForm)},
+      {"Seed", std::to_string(seed)},
+  }};
+  ui::KeyValueBlock("Generating the interpreter bench cases:", header_rows);
+  fs::create_directories(outDir);
+
+  // The callee, a recompiled function the branch cases call and jump to: xori r5,r5,0x1234; blr.
+  const uint32_t callee = kBenchBaseAddress;
+  const std::vector<uint32_t> callee_words = {0x68A51234, kBlr};
+
+  std::mt19937_64 rng(seed);
+  std::vector<Case> cases;
+  uint32_t next_address = callee + uint32_t(callee_words.size()) * 4;
+  std::map<Exclusion, int> excluded;
+  std::vector<std::string> unreachable;
+  int forms_with_cases = 0;
+
+  for (int i = 0; i < powerpc_num_opcodes; ++i) {
+    const powerpc_opcode& form = powerpc_opcodes[i];
+    Exclusion exclusion = ExcludeForm(form);
+    if (exclusion != Exclusion::kNone) {
+      ++excluded[exclusion];
+      continue;
+    }
+    Branch branch = ClassifyBranch(form);
+    // Operand fields are the bits outside the form's mask. The decoder takes the first table
+    // entry that matches, so a word only counts for this form if it decodes to this entry.
+    std::unordered_set<uint32_t> words;
+    int found = 0;
+    for (int attempt = 0; attempt < kAttemptsPerForm && found < casesPerForm; ++attempt) {
+      uint32_t word = uint32_t(form.opcode) | (uint32_t(rng()) & ~uint32_t(form.mask));
+      if (!words.insert(word).second || IsServiceTrap(word)) {
+        continue;
+      }
+      auto text = DecodesTo(word, next_address, form);
+      if (!text) {
+        continue;
+      }
+      Case c;
+      c.address = next_address;
+      c.words = {word, kBlr};
+      c.form = &form;
+      c.text = *text;
+      if (branch != Branch::kNone) {
+        if (!BranchLayout(c, branch, c.address, callee, found % 2 == 1)) {
+          continue;
+        }
+      } else if (!SetAddressing(c)) {
+        continue;
+      }
+      next_address += uint32_t(c.words.size()) * 4;
+      cases.push_back(std::move(c));
+      ++found;
+    }
+    if (found) {
+      ++forms_with_cases;
+    } else {
+      unreachable.push_back(form.name);
+    }
+  }
+
+  // The test binary, big-endian, with a test_ symbol per function so AnalyzeTestBinary makes
+  // each one a function: the callee, then the cases.
+  std::vector<uint32_t> image_words = callee_words;
+  std::map<size_t, std::string> symbols;
+  symbols[callee] = "test_callee";
+  for (size_t i = 0; i < cases.size(); ++i) {
+    symbols[cases[i].address] = fmt::format("test_{}", i);
+    image_words.insert(image_words.end(), cases[i].words.begin(), cases[i].words.end());
+  }
+  std::vector<uint8_t> image(image_words.size() * 4);
+  for (size_t i = 0; i < image_words.size(); ++i) {
+    uint32_t big_endian = __builtin_bswap32(image_words[i]);
+    std::memcpy(image.data() + i * 4, &big_endian, 4);
+  }
+
+  codegen::TestModule module;
+  module.Load(kBenchBaseAddress, image.data(), image.size());
+  module.set_name("bench");
+  codegen::RecompilerConfig config;
+  config.outDirectoryPath = outDir;
+  auto ctx =
+      codegen::CodegenContext::Create(codegen::BinaryView::fromModule(module), std::move(config));
+  codegen::AnalyzeTestBinary(ctx, "bench", symbols, kBenchBaseAddress, image.data(), image.size());
+  // AnalyzeTestBinary records bl calls; b and bc to the callee are tail calls.
+  codegen::FunctionNode* callee_node = ctx.graph.getFunction(callee);
+  for (const Case& c : cases) {
+    if (c.tail_call) {
+      ctx.graph.addTailCallToFunction(c.address, c.address,
+                                      codegen::CallTarget::function(callee_node));
+    }
+  }
+  codegen::EmitContext emitCtx{ctx.binary(), ctx.Config(), ctx.graph, 0, nullptr};
+
+  std::array<std::string, kFunctionChunks> chunks;
+  chunks[0] += callee_node->emitCpp(emitCtx) + "\n";
+  std::string table = fmt::format("REX_EXTERN(bench_{:X});\n", callee);
+  std::vector<size_t> emitted;
+  for (size_t i = 0; i < cases.size(); ++i) {
+    const Case& c = cases[i];
+    const codegen::FunctionNode* fn = ctx.graph.getFunction(c.address);
+    std::string code = fn ? fn->emitCpp(emitCtx) : std::string();
+    if (code.empty()) {
+      REXLOG_WARN("No code emitted for case {} ({})", i, c.text);
+      continue;
+    }
+    std::string name = fmt::format("bench_{:X}", c.address);
+    chunks[i * kFunctionChunks / cases.size()] += code + "\n";
+    table += fmt::format("REX_EXTERN({});\n", name);
+    table += fmt::format(
+        "static const BenchCase kCase{} = {{0x{:08X}, 0x{:08X}, {}, {}, {}, {}, {}, {}, {}, {}, "
+        "{}, {}, {}}};\n",
+        i, c.address, c.words[0], CppString(c.form->name), CppString(c.text),
+        AddressingName(c.addressing), c.ra, c.rb, c.displacement, c.align, c.reserve_size,
+        SetupName(c.setup), RecompiledCodeTraps(code), name);
+    emitted.push_back(i);
+  }
+
+  // The configuration header recompiled test code expects, with the bench's image. The image
+  // size also places the table of functions for indirect calls, right after the image.
+  size_t image_size = std::max<size_t>((image.size() + 0xFFF) & ~size_t(0xFFF), 0x1000);
+  codegen::TemplateRegistry registry;
+  nlohmann::json templateData;
+  templateData["image_base"] = fmt::format("{:X}", kBenchBaseAddress);
+  templateData["image_size"] = fmt::format("{:X}", image_size);
+  templateData["code_base"] = fmt::format("{:X}", kBenchBaseAddress);
+  templateData["code_size"] = fmt::format("{:X}", image_size);
+  {
+    std::ofstream out(fmt::format("{}/ppc_config.h", outDir));
+    out << codegen::renderWithJson(registry, "test/ppc_config_h", templateData);
+  }
+
+  for (int chunk = 0; chunk < kFunctionChunks; ++chunk) {
+    std::ofstream out(fmt::format("{}/bench_functions_{}.cpp", outDir, chunk));
+    out << "// Generated by rexglue interp-bench-gen\n\n"
+        << "#include \"ppc_config.h\"\n#include <rex/ppc.h>\n#include <rex/logging.h>\n\n"
+        << fmt::format("DECLARE_REX_FUNC(bench_{:X});\n\n", callee) << chunks[chunk];
+  }
+
+  {
+    std::ofstream out(fmt::format("{}/bench_cases.cpp", outDir));
+    out << "// Generated by rexglue interp-bench-gen\n\n"
+        << "#include <rex/ppc.h>\n\n#include \"bench_case.h\"\n\n"
+        << table << "\nconst BenchCase* const kBenchCases[] = {\n";
+    for (size_t i : emitted) {
+      out << fmt::format("    &kCase{},\n", i);
+    }
+    out << "};\nconst size_t kBenchCaseCount = sizeof(kBenchCases) / sizeof(kBenchCases[0]);\n\n";
+    out << fmt::format("const BenchImage kBenchImage = {{0x{:08X}, 0x{:X}, {}, kBenchImageWords, "
+                       "{{0x{:08X}, bench_{:X}}}}};\n",
+                       kBenchBaseAddress, image_size, image_words.size(), callee, callee);
+    out << "const uint32_t kBenchImageWords[] = {";
+    for (size_t i = 0; i < image_words.size(); ++i) {
+      out << (i % 8 == 0 ? "\n    " : " ") << fmt::format("0x{:08X},", image_words[i]);
+    }
+    out << "\n};\n";
+  }
+
+  std::array<ui::KeyValueRow, 7> summary = {{
+      {"Forms with cases", std::to_string(forms_with_cases)},
+      {"Cases", std::to_string(emitted.size())},
+      {"Unreachable forms", std::to_string(unreachable.size())},
+      {"Excluded: other dialects", std::to_string(excluded[Exclusion::kDialect])},
+      {"Excluded: no builder", std::to_string(excluded[Exclusion::kNotBuilt])},
+      {"Excluded: absolute branches", std::to_string(excluded[Exclusion::kAbsoluteBranch])},
+      {"Excluded: nondeterministic", std::to_string(excluded[Exclusion::kNondeterministic])},
+  }};
+  ui::KeyValueBlock("Interpreter bench cases:", summary);
+  if (!unreachable.empty()) {
+    // Forms another table entry always decodes first (aliases), or whose valid words this
+    // generator does not produce.
+    std::string list;
+    for (const auto& name : unreachable) {
+      list += (list.empty() ? "" : " ") + name;
+    }
+    REXLOG_INFO("Forms without cases: {}", list);
+  }
+  return !emitted.empty();
+}
+
+struct InterpBenchArgs {
+  std::string output;
+  int cases_per_form = 6;
+  uint64_t seed = 1;
+};
+
+}  // namespace
+
+void RegisterInterpBenchGen(CLI::App& parent, const CliContext& ctx, DeferredAction& pending) {
+  (void)ctx;
+  auto args = std::make_shared<InterpBenchArgs>();
+  auto* sub = parent
+                  .add_subcommand("interp-bench-gen",
+                                  "Generate the recompiled side of the PPC interpreter bench")
+                  ->fallthrough();
+  sub->add_option("--output", args->output, "Output directory")->type_name("PATH")->required();
+  sub->add_option("--cases-per-form", args->cases_per_form, "Instruction words per form")
+      ->type_name("N");
+  sub->add_option("--seed", args->seed, "Seed of the random operand fields")->type_name("N");
+  sub->callback([args, &pending]() {
+    pending = [args]() -> rex::Result<void> {
+      if (!GenerateInterpBench(args->output, args->cases_per_form, args->seed)) {
+        return Err<void>(rex::ErrorCategory::Validation, "Interpreter bench generation failed");
+      }
+      return rex::Ok();
+    };
+  });
+}
+
+}  // namespace rexglue::cli
