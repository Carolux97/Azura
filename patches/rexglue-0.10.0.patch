+// The guest relies on these barriers to publish data between threads (lock-free queues, the
+// render command ring). x86 orders memory strongly enough that they cost nothing, but ARM64
+// reorders loads and stores, so they must become real fences there. The fences also keep the
+// compiler from moving guest memory accesses across them.
 bool build_sync(BuilderContext& ctx) {
-  // Memory barrier, x86 has strong ordering so this is a no-op
-  (void)ctx;
+  // Full barrier: orders every earlier access before every later one.
+  ctx.println("\tstd::atomic_thread_fence(std::memory_order_seq_cst);");
   return true;
 }
 
 bool build_lwsync(BuilderContext& ctx) {
-  // Lightweight memory barrier, x86 has strong ordering so this is a no-op
-  (void)ctx;
+  // Lightweight barrier: orders load-load, load-store and store-store (not store-load), which an
+  // acquire-release fence covers.
+  ctx.println("\tstd::atomic_thread_fence(std::memory_order_acq_rel);");
   return true;
 }
 
