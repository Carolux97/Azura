 namespace rex::string {
 
 std::string to_utf8(const std::u16string_view source) {
-  return utfcpp::utf16to8(source);
+  try {
+    return utfcpp::utf16to8(source);
+  } catch (...) {
+    std::string result;
+    result.reserve(source.size());
+    for (char16_t c : source) {
+      if (c < 128) {
+        result.push_back(static_cast<char>(c));
+      } else {
+        result.push_back('?');
+      }
+    }
+    return result;
+  }
 }
 
 std::u16string to_utf16(const std::string_view source) {
-  return utfcpp::utf8to16(source);
+  try {
+    return utfcpp::utf8to16(source);
+  } catch (...) {
+    // Fallback: decode as Latin-1 / Windows-1252 directly into UTF-16 codepoints
+    // so characters like á, é, í, ó, ú, ñ (0x80-0xFF) are preserved without throwing.
+    std::u16string result;
+    result.reserve(source.size());
+    for (unsigned char c : source) {
+      result.push_back(static_cast<char16_t>(c));
+    }
+    return result;
+  }
 }
 
