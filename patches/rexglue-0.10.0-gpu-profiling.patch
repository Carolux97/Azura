+  kRenderPassEndsTransfer,      // Render target ownership transfers and resolve clears
+  kRenderPassEndsTextureLoad,   // Texture loading and untiling
+  kRenderPassEndsUpload,        // Guest memory uploads to the GPU
+  kRenderPassEndsOther,         // Anything else (swap, end of submission, queries...)
+
+  // Guest memory uploads to the host GPU (shared memory)
+  kUploads,                  // Upload batches (each ends the open render pass)
+  kUploadBytes,              // Bytes uploaded
+  kDrawsWithUploads,         // Guest draws that needed at least one upload
+  kDrawsWithSeveralUploads,  // Guest draws that needed more than one
+  kUploadsBeforeTextures,    // Uploads in a draw before its textures (index data and setup)
+  kUploadsForTextures,       // Uploads in a draw while its textures are requested
+  kUploadsAfterTextures,     // Uploads in a draw after its textures (vertex data and others)
+
+  // Guest draws that continue a render pass begun for a render target transfer
+  kDrawsInTransferPasses,
+
   kCount  // sentinel -- must be last
 };
 
