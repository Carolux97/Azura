diff --git a/src/graphics/pipeline/shader/xsc/xsc_spirv.cpp b/src/graphics/pipeline/shader/xsc/xsc_spirv.cpp
new file mode 100644
index 0000000..ccc8e43
--- /dev/null
+++ b/src/graphics/pipeline/shader/xsc/xsc_spirv.cpp
@@ -0,0 +1,1069 @@
+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_spirv.cpp
+ * @brief       SPIR-V emitter of the Xenos shader compiler
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * Writes every IR operation as one SPIR-V instruction. The float arithmetic is decorated with
+ * NoContraction (unless SpirvOptions::no_contraction is off), which drivers honour per
+ * instruction, so the results follow the Xenos rules without the per-statement trick the MSL
+ * emitter needs. The structured IR maps directly to SPIR-V structured control flow: an if is a
+ * selection with OpPhi in its merge block, a loop has its own continue block, and a switch case
+ * falls through by branching to the next case.
+ *
+ * The interface matches the SPIR-V translator's pixel shaders (spirv_translator.cpp) on the
+ * Vulkan backend: the constant buffers are declared as arrays of 4-component vectors with the
+ * same layout, textures and samplers in the order of the shader's bindings, samplers after the
+ * textures in the same descriptor set.
+ */
+
+#include "xsc_spirv.h"
+
+#include <cstring>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <utility>
+
+#include <SPIRV/GLSL.std.450.h>
+#include <fmt/format.h>
+
+#include <rex/assert.h>
+#include <rex/graphics/pipeline/shader/spirv_builder.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+
+namespace rex::graphics::xsc {
+
+namespace {
+
+using SystemConstants = SpirvShaderTranslator::SystemConstants;
+static_assert(sizeof(SystemConstants) % (sizeof(uint32_t) * 4) == 0,
+              "The system constants are declared as an array of uint4");
+
+class SpirvEmitter {
+ public:
+  SpirvEmitter(const Program& program, const SpirvOptions& options)
+      : program_(program),
+        options_(options),
+        // The SPIR-V translator's generator magic number, with 2 as the tool's version to tell
+        // XSC modules apart.
+        builder_(options.spirv_version, (SpirvShaderTranslator::kSpirvMagicToolId << 16) | 2,
+                 nullptr) {
+    values_.resize(program.value_types.size() + 1, spv::NoResult);
+    constants_.resize(program.value_types.size() + 1, nullptr);
+    variables_.resize(program.variables.size() + 1, spv::NoResult);
+    CollectConstants(program.body);
+  }
+
+  std::vector<uint32_t> Emit() {
+    builder_.addCapability(spv::CapabilityShader);
+    bool float_controls = options_.signed_zero_inf_nan_preserve_float32 ||
+                          options_.denorm_flush_to_zero_float32 ||
+                          options_.rounding_mode_rte_float32;
+    if (float_controls && options_.spirv_version < spv::Spv_1_4) {
+      builder_.addExtension("SPV_KHR_float_controls");
+    }
+    glsl_std_450_ = builder_.import("GLSL.std.450");
+    builder_.setMemoryModel(spv::AddressingModelLogical, spv::MemoryModelGLSL450);
+    builder_.setSource(spv::SourceLanguageUnknown, 0);
+
+    DeclareInterface();
+
+    spv::Block* entry_block;
+    function_ = builder_.makeFunctionEntry(spv::NoPrecision, builder_.makeVoidType(), "main", {},
+                                           {}, &entry_block);
+    for (size_t i = 0; i < program_.variables.size(); ++i) {
+      const Variable& variable = program_.variables[i];
+      if (variable.storage != Storage::kFunction) {
+        continue;
+      }
+      spv::Id type = VariableType(variable);
+      spv::Id initializer = spv::NoResult;
+      if (variable.initializer != kNoValue) {
+        initializer = Value(variable.initializer);
+        if (variable.array_size) {
+          initializer = builder_.makeCompositeConstant(
+              type, std::vector<spv::Id>(variable.array_size, initializer));
+        }
+      }
+      variables_[i + 1] = builder_.createVariable(spv::NoPrecision, spv::StorageClassFunction,
+                                                  type, variable.name.c_str(), initializer);
+    }
+
+    WriteBody(program_.body);
+    builder_.leaveFunction();
+
+    spv::Instruction* entry_point = builder_.addEntryPoint(
+        program_.is_pixel_shader ? spv::ExecutionModelFragment : spv::ExecutionModelVertex,
+        function_, "main");
+    for (spv::Id interface_id : interface_) {
+      entry_point->addIdOperand(interface_id);
+    }
+    if (program_.is_pixel_shader) {
+      builder_.addExecutionMode(function_, spv::ExecutionModeOriginUpperLeft);
+      if (program_.fragment.early_fragment_tests) {
+        builder_.addExecutionMode(function_, spv::ExecutionModeEarlyFragmentTests);
+      }
+      if (program_.fragment.depth) {
+        builder_.addExecutionMode(function_, spv::ExecutionModeDepthReplacing);
+      }
+    }
+    if (options_.denorm_flush_to_zero_float32) {
+      builder_.addCapability(spv::CapabilityDenormFlushToZero);
+      builder_.addExecutionMode(function_, spv::ExecutionModeDenormFlushToZero, 32);
+    }
+    if (options_.signed_zero_inf_nan_preserve_float32) {
+      builder_.addCapability(spv::CapabilitySignedZeroInfNanPreserve);
+      builder_.addExecutionMode(function_, spv::ExecutionModeSignedZeroInfNanPreserve, 32);
+    }
+    if (options_.rounding_mode_rte_float32) {
+      builder_.addCapability(spv::CapabilityRoundingModeRTE);
+      builder_.addExecutionMode(function_, spv::ExecutionModeRoundingModeRTE, 32);
+    }
+
+    std::vector<unsigned int> words;
+    builder_.dump(words);
+    return std::vector<uint32_t>(words.begin(), words.end());
+  }
+
+ private:
+  void CollectConstants(const Body& body) {
+    for (const Node& node : body) {
+      if (node.kind == Node::Kind::kInstruction && node.instruction.op == Op::kConstant) {
+        constants_[node.instruction.result] = &node.instruction;
+      }
+      for (const Body& child : node.bodies) {
+        CollectConstants(child);
+      }
+      for (const SwitchCase& switch_case : node.cases) {
+        CollectConstants(switch_case.body);
+      }
+    }
+  }
+
+  // Types.
+
+  spv::Id ScalarTypeId(ScalarType scalar) {
+    switch (scalar) {
+      case ScalarType::kBool:
+        return builder_.makeBoolType();
+      case ScalarType::kInt:
+        return builder_.makeIntType(32);
+      case ScalarType::kUint:
+        return builder_.makeUintType(32);
+      case ScalarType::kFloat:
+        return builder_.makeFloatType(32);
+    }
+    return builder_.makeFloatType(32);
+  }
+  spv::Id TypeId(Type type) {
+    spv::Id scalar = ScalarTypeId(type.scalar);
+    return type.components == 1 ? scalar : builder_.makeVectorType(scalar, type.components);
+  }
+  spv::Id VariableType(const Variable& variable) {
+    spv::Id type = TypeId(variable.type);
+    if (variable.array_size) {
+      type = builder_.makeArrayType(type, builder_.makeUintConstant(variable.array_size), 0);
+    }
+    return type;
+  }
+  Type TypeOf(ValueId value) const { return program_.value_types[value - 1]; }
+
+  // Values.
+
+  spv::Id ScalarConstant(ScalarType scalar, uint32_t bits) {
+    switch (scalar) {
+      case ScalarType::kBool:
+        return builder_.makeBoolConstant(bits != 0);
+      case ScalarType::kInt:
+        return builder_.makeIntConstant(int32_t(bits));
+      case ScalarType::kUint:
+        return builder_.makeUintConstant(bits);
+      case ScalarType::kFloat: {
+        // makeFloatConstant deduplicates by the bits, so -0 and NaN payloads are kept.
+        float value;
+        std::memcpy(&value, &bits, sizeof(value));
+        return builder_.makeFloatConstant(value);
+      }
+    }
+    return spv::NoResult;
+  }
+
+  spv::Id Value(ValueId value) {
+    assert_true(value != kNoValue);
+    if (values_[value] != spv::NoResult) {
+      return values_[value];
+    }
+    const Instruction* constant = constants_[value];
+    assert_not_null(constant);
+    Type type = constant->type;
+    spv::Id id;
+    if (type.components == 1) {
+      id = ScalarConstant(type.scalar, constant->imm[0]);
+    } else {
+      std::vector<spv::Id> components;
+      for (uint32_t i = 0; i < type.components; ++i) {
+        components.push_back(ScalarConstant(type.scalar, constant->imm[i]));
+      }
+      id = builder_.makeCompositeConstant(TypeId(type), components);
+    }
+    values_[value] = id;
+    return id;
+  }
+
+  // Interface.
+
+  spv::Id CreateInterfaceVariable(spv::StorageClass storage_class, spv::Id type, const char* name) {
+    spv::Id variable = builder_.createVariable(spv::NoPrecision, storage_class, type, name);
+    // Before SPIR-V 1.4, the entry point lists only the inputs and the outputs.
+    if (storage_class == spv::StorageClassInput || storage_class == spv::StorageClassOutput ||
+        options_.spirv_version >= spv::Spv_1_4) {
+      interface_.push_back(variable);
+    }
+    return variable;
+  }
+
+  // The vertex shader's built-in input and outputs: the vertex index, gl_PerVertex with the
+  // position and the clip distances, and the interpolator and point outputs at their locations.
+  void DeclareVertexInterface() {
+    input_vertex_index_ =
+        CreateInterfaceVariable(spv::StorageClassInput, TypeId(kInt), "gl_VertexIndex");
+    builder_.addDecoration(input_vertex_index_, spv::DecorationBuiltIn, spv::BuiltInVertexIndex);
+    std::vector<spv::Id> per_vertex_members = {TypeId(kFloat4)};
+    uint32_t clip_distance_count = program_.vertex.clip_distance_count;
+    if (clip_distance_count) {
+      builder_.addCapability(spv::CapabilityClipDistance);
+      spv::Id type_clip_distance = builder_.makeArrayType(
+          TypeId(kFloat), builder_.makeUintConstant(clip_distance_count), 0);
+      builder_.addDecoration(type_clip_distance, spv::DecorationArrayStride, sizeof(float));
+      per_vertex_members.push_back(type_clip_distance);
+    }
+    spv::Id type_per_vertex = builder_.makeStructType(per_vertex_members, "gl_PerVertex");
+    builder_.addMemberName(type_per_vertex, 0, "gl_Position");
+    builder_.addMemberDecoration(type_per_vertex, 0, spv::DecorationBuiltIn, spv::BuiltInPosition);
+    if (clip_distance_count) {
+      builder_.addMemberName(type_per_vertex, 1, "gl_ClipDistance");
+      builder_.addMemberDecoration(type_per_vertex, 1, spv::DecorationBuiltIn,
+                                   spv::BuiltInClipDistance);
+    }
+    builder_.addDecoration(type_per_vertex, spv::DecorationBlock);
+    output_per_vertex_ = CreateInterfaceVariable(spv::StorageClassOutput, type_per_vertex, "");
+    // Invariant like the SPIR-V translator's outputs, for the same positions in every pass.
+    builder_.addDecoration(output_per_vertex_, spv::DecorationInvariant);
+    for (size_t i = 0; i < program_.variables.size(); ++i) {
+      const Variable& variable = program_.variables[i];
+      if (variable.storage != Storage::kOutputInterpolator &&
+          variable.storage != Storage::kOutputPointSize &&
+          variable.storage != Storage::kOutputPointCoordinates) {
+        continue;
+      }
+      spv::Id output = CreateInterfaceVariable(spv::StorageClassOutput, TypeId(variable.type),
+                                               variable.name.c_str());
+      builder_.addDecoration(output, spv::DecorationLocation, int(variable.location));
+      builder_.addDecoration(output, spv::DecorationInvariant);
+      variables_[i + 1] = output;
+    }
+  }
+
+  void DeclareInterface() {
+    if (!program_.is_pixel_shader) {
+      DeclareVertexInterface();
+      DeclareTexturesAndSamplers();
+      return;
+    }
+    const FragmentInterface& fragment = program_.fragment;
+    spv::Id type_float4 = TypeId(kFloat4);
+    for (size_t i = 0; i < fragment.interpolators.size(); ++i) {
+      uint32_t interpolator = fragment.interpolators[i];
+      spv::Id input = CreateInterfaceVariable(
+          spv::StorageClassInput, type_float4,
+          fmt::format("xe_in_interpolator_{}", interpolator).c_str());
+      builder_.addDecoration(input, spv::DecorationLocation, int(i));
+      if (fragment.interpolators_centroid & (UINT32_C(1) << interpolator)) {
+        builder_.addDecoration(input, spv::DecorationCentroid);
+      }
+      input_interpolators_.push_back(input);
+    }
+    if (fragment.point_coord) {
+      input_point_coordinates_ = CreateInterfaceVariable(spv::StorageClassInput, TypeId(kFloat2),
+                                                         "xe_in_point_coordinates");
+      builder_.addDecoration(input_point_coordinates_, spv::DecorationLocation,
+                             int(fragment.interpolators.size()));
+    }
+    if (fragment.frag_coord) {
+      input_frag_coord_ =
+          CreateInterfaceVariable(spv::StorageClassInput, type_float4, "gl_FragCoord");
+      builder_.addDecoration(input_frag_coord_, spv::DecorationBuiltIn, spv::BuiltInFragCoord);
+    }
+    if (fragment.front_facing) {
+      input_front_facing_ =
+          CreateInterfaceVariable(spv::StorageClassInput, TypeId(kBool), "gl_FrontFacing");
+      builder_.addDecoration(input_front_facing_, spv::DecorationBuiltIn,
+                             spv::BuiltInFrontFacing);
+    }
+
+    for (size_t i = 0; i < program_.variables.size(); ++i) {
+      const Variable& variable = program_.variables[i];
+      spv::Id output = spv::NoResult;
+      switch (variable.storage) {
+        case Storage::kOutputColor:
+          output = CreateInterfaceVariable(
+              spv::StorageClassOutput, type_float4,
+              fmt::format("xe_out_fragment_data_{}", variable.location).c_str());
+          builder_.addDecoration(output, spv::DecorationLocation, int(variable.location));
+          // Invariant like the SPIR-V translator's outputs.
+          builder_.addDecoration(output, spv::DecorationInvariant);
+          break;
+        case Storage::kOutputDepth:
+          output = CreateInterfaceVariable(spv::StorageClassOutput, TypeId(kFloat), "gl_FragDepth");
+          builder_.addDecoration(output, spv::DecorationBuiltIn, spv::BuiltInFragDepth);
+          break;
+        case Storage::kOutputSampleMask:
+          output = CreateInterfaceVariable(
+              spv::StorageClassOutput,
+              builder_.makeArrayType(TypeId(kInt), builder_.makeUintConstant(1), 0),
+              "gl_SampleMask");
+          builder_.addDecoration(output, spv::DecorationBuiltIn, spv::BuiltInSampleMask);
+          // SampleMask depends on SampleRateShading in some SPIR-V revisions.
+          builder_.addCapability(spv::CapabilitySampleRateShading);
+          break;
+        default:
+          // Function variables, and no vertex outputs in a pixel shader.
+          continue;
+      }
+      variables_[i + 1] = output;
+    }
+
+    DeclareTexturesAndSamplers();
+  }
+
+  // Textures, then samplers, in the descriptor set of the stage.
+  void DeclareTexturesAndSamplers() {
+    int texture_set = int(program_.is_pixel_shader
+                              ? SpirvShaderTranslator::kDescriptorSetTexturesPixel
+                              : SpirvShaderTranslator::kDescriptorSetTexturesVertex);
+    for (size_t i = 0; i < program_.textures.size(); ++i) {
+      const TextureBindingInfo& texture = program_.textures[i];
+      spv::Dim dimension = spv::Dim2D;
+      bool arrayed = false;
+      const char* dimension_name = "2d";
+      switch (texture.dimension) {
+        case TextureDimension::k2DArray:
+          arrayed = true;
+          break;
+        case TextureDimension::k3D:
+          dimension = spv::Dim3D;
+          dimension_name = "3d";
+          break;
+        case TextureDimension::kCube:
+          dimension = spv::DimCube;
+          dimension_name = "cube";
+          break;
+      }
+      spv::Id image_type = builder_.makeImageType(TypeId(kFloat), dimension, false, arrayed, false,
+                                                  1, spv::ImageFormatUnknown);
+      spv::Id variable = CreateInterfaceVariable(
+          spv::StorageClassUniformConstant, image_type,
+          fmt::format("xe_texture{}_{}_{}", texture.fetch_constant, dimension_name,
+                      texture.is_signed ? 's' : 'u')
+              .c_str());
+      builder_.addDecoration(variable, spv::DecorationDescriptorSet, texture_set);
+      builder_.addDecoration(variable, spv::DecorationBinding, int(i));
+      textures_.push_back({variable, image_type});
+    }
+    for (uint32_t i = 0; i < program_.sampler_count; ++i) {
+      spv::Id variable = CreateInterfaceVariable(spv::StorageClassUniformConstant,
+                                                 builder_.makeSamplerType(),
+                                                 fmt::format("xe_sampler{}", i).c_str());
+      builder_.addDecoration(variable, spv::DecorationDescriptorSet, texture_set);
+      builder_.addDecoration(variable, spv::DecorationBinding,
+                             int(program_.textures.size() + i));
+      samplers_.push_back(variable);
+    }
+  }
+
+  // A uniform buffer of `count` 4-component vectors of `scalar` at the binding of the constant
+  // buffer, declared on first use.
+  spv::Id UniformBuffer(SpirvShaderTranslator::ConstantBuffer buffer, ScalarType scalar,
+                        uint32_t count, const char* name) {
+    spv::Id& variable = uniform_buffers_[buffer];
+    if (variable != spv::NoResult) {
+      return variable;
+    }
+    spv::Id array_type = builder_.makeArrayType(TypeId(Type(scalar, 4)),
+                                                builder_.makeUintConstant(count),
+                                                sizeof(uint32_t) * 4);
+    builder_.addDecoration(array_type, spv::DecorationArrayStride, sizeof(uint32_t) * 4);
+    spv::Id struct_type = builder_.makeStructType({array_type}, name);
+    builder_.addMemberName(struct_type, 0, "data");
+    builder_.addMemberDecoration(struct_type, 0, spv::DecorationOffset, 0);
+    builder_.addDecoration(struct_type, spv::DecorationBlock);
+    variable = CreateInterfaceVariable(spv::StorageClassUniform, struct_type,
+                                       fmt::format("{}_uniform", name).c_str());
+    builder_.addDecoration(variable, spv::DecorationDescriptorSet,
+                           int(SpirvShaderTranslator::kDescriptorSetConstants));
+    builder_.addDecoration(variable, spv::DecorationBinding, int(buffer));
+    return variable;
+  }
+
+  // The shared memory storage buffer (uint[] in one binding), declared on first use.
+  spv::StorageClass SharedMemoryStorageClass() const {
+    return options_.spirv_version >= spv::Spv_1_3 ? spv::StorageClassStorageBuffer
+                                                  : spv::StorageClassUniform;
+  }
+  spv::Id SharedMemory() {
+    if (shared_memory_ != spv::NoResult) {
+      return shared_memory_;
+    }
+    spv::Id type_array = builder_.makeRuntimeArray(TypeId(kUint));
+    // Storage buffers have std430 packing, no padding to 4-component vectors.
+    builder_.addDecoration(type_array, spv::DecorationArrayStride, sizeof(uint32_t));
+    spv::Id type_shared_memory = builder_.makeStructType({type_array}, "XeSharedMemory");
+    builder_.addMemberName(type_shared_memory, 0, "shared_memory");
+    builder_.addMemberDecoration(type_shared_memory, 0, spv::DecorationRestrict);
+    builder_.addMemberDecoration(type_shared_memory, 0, spv::DecorationNonWritable);
+    builder_.addMemberDecoration(type_shared_memory, 0, spv::DecorationOffset, 0);
+    builder_.addDecoration(type_shared_memory, options_.spirv_version >= spv::Spv_1_3
+                                                   ? spv::DecorationBlock
+                                                   : spv::DecorationBufferBlock);
+    shared_memory_ = CreateInterfaceVariable(SharedMemoryStorageClass(), type_shared_memory,
+                                             "xe_shared_memory");
+    builder_.addDecoration(shared_memory_, spv::DecorationDescriptorSet,
+                           int(SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram));
+    builder_.addDecoration(shared_memory_, spv::DecorationBinding, 0);
+    return shared_memory_;
+  }
+
+  spv::Id LoadUniformWord(spv::Id buffer, uint32_t dword) {
+    spv::Id pointer = builder_.createAccessChain(
+        spv::StorageClassUniform, buffer,
+        {builder_.makeIntConstant(0), builder_.makeIntConstant(int(dword >> 2)),
+         builder_.makeIntConstant(int(dword & 3))});
+    return builder_.createLoad(pointer, spv::NoPrecision);
+  }
+
+  // Control flow.
+
+  spv::Block* NewBlock() { return new spv::Block(builder_.getUniqueId(), *function_); }
+  void EnterBlock(spv::Block* block) {
+    function_->addBlock(block);
+    builder_.setBuildPoint(block);
+  }
+  bool IsTerminated() const { return builder_.getBuildPoint()->isTerminated(); }
+
+  void WriteBody(const Body& body) {
+    for (const Node& node : body) {
+      // Nothing after a branch or a kill is reachable.
+      if (IsTerminated()) {
+        break;
+      }
+      WriteNode(node);
+    }
+  }
+
+  // Zero of a type, for the values that are never used: glslang's OpUndef would be placed in the
+  // current block, before the OpPhi instructions that must start it.
+  spv::Id Zero(Type type) {
+    spv::Id scalar = ScalarConstant(type.scalar, 0);
+    return type.components == 1
+               ? scalar
+               : builder_.makeCompositeConstant(TypeId(type),
+                                                std::vector<spv::Id>(type.components, scalar));
+  }
+
+  // The phi values of a merge block: for every predecessor, its value from `source_blocks` (pairs
+  // of the index in Phi::sources and the block it comes from), or an unused zero if it branched
+  // there otherwise (a break from a switch case before its end).
+  void WritePhis(const Node& node, spv::Block* merge,
+                 const std::vector<std::pair<size_t, spv::Block*>>& source_blocks) {
+    for (const Phi& phi : node.phis) {
+      spv::Id type = TypeId(phi.type);
+      const std::vector<spv::Block*>& predecessors = merge->getPredecessors();
+      if (predecessors.empty()) {
+        // An unreachable merge block.
+        values_[phi.result] = Zero(phi.type);
+        continue;
+      }
+      std::vector<spv::Id> operands;
+      for (spv::Block* predecessor : predecessors) {
+        spv::Id value = spv::NoResult;
+        for (const auto& [source_index, source_block] : source_blocks) {
+          if (source_block == predecessor) {
+            value = Value(phi.sources[source_index]);
+            break;
+          }
+        }
+        if (value == spv::NoResult) {
+          value = Zero(phi.type);
+        }
+        operands.push_back(value);
+        operands.push_back(predecessor->getId());
+      }
+      values_[phi.result] = builder_.createOp(spv::OpPhi, type, operands);
+    }
+  }
+
+  void WriteIf(const Node& node) {
+    spv::Block* then_block = NewBlock();
+    spv::Block* merge = NewBlock();
+    bool else_needed = !node.bodies[1].empty() || !node.phis.empty();
+    spv::Block* else_block = else_needed ? NewBlock() : merge;
+    builder_.createSelectionMerge(merge, spv::SelectionControlMaskNone);
+    builder_.createConditionalBranch(Value(node.condition), then_block, else_block);
+    std::vector<std::pair<size_t, spv::Block*>> source_blocks;
+    EnterBlock(then_block);
+    WriteBody(node.bodies[0]);
+    if (!IsTerminated()) {
+      source_blocks.emplace_back(0, builder_.getBuildPoint());
+      builder_.createBranch(merge);
+    }
+    if (else_needed) {
+      EnterBlock(else_block);
+      WriteBody(node.bodies[1]);
+      if (!IsTerminated()) {
+        source_blocks.emplace_back(1, builder_.getBuildPoint());
+        builder_.createBranch(merge);
+      }
+    }
+    EnterBlock(merge);
+    WritePhis(node, merge, source_blocks);
+  }
+
+  void WriteLoop(const Node& node) {
+    spv::Block* header = NewBlock();
+    spv::Block* body = NewBlock();
+    spv::Block* continue_block = NewBlock();
+    spv::Block* merge = NewBlock();
+    builder_.createBranch(header);
+    EnterBlock(header);
+    builder_.createLoopMerge(merge, continue_block, spv::LoopControlDontUnrollMask, {});
+    builder_.createBranch(body);
+    EnterBlock(body);
+    break_targets_.push_back(merge);
+    continue_targets_.push_back(continue_block);
+    WriteBody(node.bodies[0]);
+    if (!IsTerminated()) {
+      builder_.createBranch(continue_block);
+    }
+    continue_targets_.pop_back();
+    break_targets_.pop_back();
+    EnterBlock(continue_block);
+    builder_.createBranch(header);
+    EnterBlock(merge);
+  }
+
+  void WriteSwitch(const Node& node) {
+    spv::Block* header = builder_.getBuildPoint();
+    spv::Block* merge = NewBlock();
+    bool default_needed = !node.bodies[0].empty() || !node.phis.empty();
+    spv::Block* default_block = default_needed ? NewBlock() : merge;
+    std::vector<spv::Block*> case_blocks;
+    for (size_t i = 0; i < node.cases.size(); ++i) {
+      case_blocks.push_back(NewBlock());
+    }
+    builder_.createSelectionMerge(merge, spv::SelectionControlMaskNone);
+    auto switch_instruction = std::make_unique<spv::Instruction>(spv::OpSwitch);
+    switch_instruction->addIdOperand(Value(node.condition));
+    switch_instruction->addIdOperand(default_block->getId());
+    default_block->addPredecessor(header);
+    for (size_t i = 0; i < node.cases.size(); ++i) {
+      switch_instruction->addImmediateOperand(uint32_t(node.cases[i].literal));
+      switch_instruction->addIdOperand(case_blocks[i]->getId());
+      case_blocks[i]->addPredecessor(header);
+    }
+    header->addInstruction(std::move(switch_instruction));
+
+    std::vector<std::pair<size_t, spv::Block*>> source_blocks;
+    break_targets_.push_back(merge);
+    for (size_t i = 0; i < node.cases.size(); ++i) {
+      EnterBlock(case_blocks[i]);
+      WriteBody(node.cases[i].body);
+      if (IsTerminated()) {
+        continue;
+      }
+      if (node.cases[i].falls_through) {
+        // Into the next case, or into the default after the last one (both listed next in the
+        // OpSwitch targets as far as SPIR-V requires: the main switch has an empty default).
+        builder_.createBranch(i + 1 < node.cases.size() ? case_blocks[i + 1] : default_block);
+      } else {
+        source_blocks.emplace_back(i, builder_.getBuildPoint());
+        builder_.createBranch(merge);
+      }
+    }
+    if (default_needed) {
+      EnterBlock(default_block);
+      WriteBody(node.bodies[0]);
+      if (!IsTerminated()) {
+        source_blocks.emplace_back(node.cases.size(), builder_.getBuildPoint());
+        builder_.createBranch(merge);
+      }
+    }
+    break_targets_.pop_back();
+    EnterBlock(merge);
+    WritePhis(node, merge, source_blocks);
+  }
+
+  void WriteNode(const Node& node) {
+    switch (node.kind) {
+      case Node::Kind::kInstruction:
+        WriteInstruction(node.instruction);
+        break;
+      case Node::Kind::kIf:
+        WriteIf(node);
+        break;
+      case Node::Kind::kLoop:
+        WriteLoop(node);
+        break;
+      case Node::Kind::kSwitch:
+        WriteSwitch(node);
+        break;
+      case Node::Kind::kBreak:
+        assert_false(break_targets_.empty());
+        builder_.createBranch(break_targets_.back());
+        break;
+      case Node::Kind::kContinue:
+        assert_false(continue_targets_.empty());
+        builder_.createBranch(continue_targets_.back());
+        break;
+    }
+  }
+
+  // Instructions.
+
+  void Define(const Instruction& instruction, spv::Id id) { values_[instruction.result] = id; }
+
+  spv::Id Arithmetic(spv::Op op, const Instruction& instruction) {
+    spv::Id result = builder_.createBinOp(op, TypeId(instruction.type),
+                                          Value(instruction.operands[0]),
+                                          Value(instruction.operands[1]));
+    if (options_.no_contraction) {
+      builder_.addDecoration(result, spv::DecorationNoContraction);
+    }
+    return result;
+  }
+
+  spv::Id Builtin(GLSLstd450 function, const Instruction& instruction) {
+    std::vector<spv::Id> operands;
+    for (ValueId operand : instruction.operands) {
+      operands.push_back(Value(operand));
+    }
+    return builder_.createBuiltinCall(TypeId(instruction.type), glsl_std_450_, int(function),
+                                      operands);
+  }
+
+  // A scalar component of a value (the value itself if it is a scalar).
+  spv::Id Component(ValueId value, uint32_t component) {
+    Type type = TypeOf(value);
+    if (type.components == 1) {
+      return Value(value);
+    }
+    return builder_.createCompositeExtract(Value(value), ScalarTypeId(type.scalar), component);
+  }
+
+  spv::Id VariablePointer(const Instruction& instruction, ValueId dynamic_index) {
+    const Variable& variable = program_.variables[instruction.variable - 1];
+    spv::Id pointer = variables_[instruction.variable];
+    spv::StorageClass storage_class =
+        variable.storage == Storage::kFunction ? spv::StorageClassFunction : spv::StorageClassOutput;
+    // Members of gl_PerVertex.
+    if (variable.storage == Storage::kOutputPosition) {
+      return builder_.createAccessChain(storage_class, output_per_vertex_,
+                                        {builder_.makeIntConstant(0)});
+    }
+    if (variable.storage == Storage::kOutputClipDistance) {
+      spv::Id index = dynamic_index != kNoValue ? Value(dynamic_index)
+                                                : builder_.makeIntConstant(int(instruction.imm[0]));
+      return builder_.createAccessChain(storage_class, output_per_vertex_,
+                                        {builder_.makeIntConstant(1), index});
+    }
+    if (variable.storage == Storage::kOutputSampleMask) {
+      return builder_.createAccessChain(storage_class, pointer, {builder_.makeIntConstant(0)});
+    }
+    if (variable.array_size) {
+      spv::Id index = dynamic_index != kNoValue ? Value(dynamic_index)
+                                                : builder_.makeIntConstant(int(instruction.imm[0]));
+      return builder_.createAccessChain(storage_class, pointer, {index});
+    }
+    return pointer;
+  }
+
+  void WriteInstruction(const Instruction& instruction) {
+    const std::vector<ValueId>& operands = instruction.operands;
+    spv::Id type = instruction.result != kNoValue ? TypeId(instruction.type) : spv::NoResult;
+    switch (instruction.op) {
+      case Op::kConstant:
+        // Created where used.
+        return;
+      case Op::kLoadVariable:
+        Define(instruction,
+               builder_.createLoad(VariablePointer(instruction, operands.empty() ? kNoValue
+                                                                                 : operands[0]),
+                                   spv::NoPrecision));
+        return;
+      case Op::kStoreVariable:
+        builder_.createStore(Value(operands[0]),
+                             VariablePointer(instruction, operands.size() > 1 ? operands[1]
+                                                                              : kNoValue));
+        return;
+      case Op::kLoadSystemConstantWord:
+        Define(instruction,
+               LoadUniformWord(UniformBuffer(SpirvShaderTranslator::kConstantBufferSystem,
+                                             ScalarType::kUint,
+                                             sizeof(SystemConstants) / (sizeof(uint32_t) * 4),
+                                             "XeSystemConstants"),
+                               instruction.imm[0]));
+        return;
+      case Op::kLoadBoolLoopConstantWord:
+        // 8 dwords of bool constants, then 32 loop constants.
+        Define(instruction,
+               LoadUniformWord(UniformBuffer(SpirvShaderTranslator::kConstantBufferBoolLoop,
+                                             ScalarType::kUint, (8 + 32) / 4,
+                                             "XeBoolLoopConstants"),
+                               instruction.imm[0]));
+        return;
+      case Op::kLoadFetchConstantWord:
+        Define(instruction,
+               LoadUniformWord(UniformBuffer(SpirvShaderTranslator::kConstantBufferFetch,
+                                             ScalarType::kUint, 32 * 6 / 4, "XeFetchConstants"),
+                               instruction.imm[0]));
+        return;
+      case Op::kLoadFloatConstant: {
+        spv::Id buffer = UniformBuffer(program_.is_pixel_shader
+                                           ? SpirvShaderTranslator::kConstantBufferFloatPixel
+                                           : SpirvShaderTranslator::kConstantBufferFloatVertex,
+                                       ScalarType::kFloat, program_.float_constant_count,
+                                       "XeFloatConstants");
+        spv::Id pointer = builder_.createAccessChain(
+            spv::StorageClassUniform, buffer, {builder_.makeIntConstant(0), Value(operands[0])});
+        Define(instruction, builder_.createLoad(pointer, spv::NoPrecision));
+      } return;
+      case Op::kLoadInterpolator:
+        Define(instruction,
+               builder_.createLoad(input_interpolators_[instruction.imm[0]], spv::NoPrecision));
+        return;
+      case Op::kLoadFragCoord:
+        Define(instruction, builder_.createLoad(input_frag_coord_, spv::NoPrecision));
+        return;
+      case Op::kLoadFrontFacing:
+        Define(instruction, builder_.createLoad(input_front_facing_, spv::NoPrecision));
+        return;
+      case Op::kLoadPointCoord:
+        Define(instruction, builder_.createLoad(input_point_coordinates_, spv::NoPrecision));
+        return;
+      case Op::kLoadVertexIndex:
+        Define(instruction,
+               builder_.createUnaryOp(spv::OpBitcast, type,
+                                      builder_.createLoad(input_vertex_index_, spv::NoPrecision)));
+        return;
+      case Op::kLoadSharedMemoryWord:
+        Define(instruction,
+               builder_.createLoad(
+                   builder_.createAccessChain(SharedMemoryStorageClass(), SharedMemory(),
+                                              {builder_.makeIntConstant(0), Value(operands[0])}),
+                   spv::NoPrecision));
+        return;
+      case Op::kDot:
+        Define(instruction, builder_.createBinOp(spv::OpDot, type, Value(operands[0]),
+                                                 Value(operands[1])));
+        return;
+      case Op::kUnpackHalf2x16:
+        Define(instruction, Builtin(GLSLstd450UnpackHalf2x16, instruction));
+        return;
+
+      case Op::kFAdd:
+        Define(instruction, Arithmetic(spv::OpFAdd, instruction));
+        return;
+      case Op::kFSub:
+        Define(instruction, Arithmetic(spv::OpFSub, instruction));
+        return;
+      case Op::kFMul:
+        Define(instruction, Arithmetic(spv::OpFMul, instruction));
+        return;
+      case Op::kFDiv:
+        Define(instruction, Arithmetic(spv::OpFDiv, instruction));
+        return;
+      case Op::kVectorTimesScalar:
+        Define(instruction,
+               Arithmetic(TypeOf(operands[0]).components == 1 ? spv::OpFMul
+                                                               : spv::OpVectorTimesScalar,
+                          instruction));
+        return;
+      case Op::kFNeg:
+        Define(instruction, builder_.createUnaryOp(spv::OpFNegate, type, Value(operands[0])));
+        return;
+      case Op::kFAbs:
+        Define(instruction, Builtin(GLSLstd450FAbs, instruction));
+        return;
+      case Op::kNMin:
+        Define(instruction, Builtin(GLSLstd450NMin, instruction));
+        return;
+      case Op::kNMax:
+        Define(instruction, Builtin(GLSLstd450NMax, instruction));
+        return;
+      case Op::kNClamp:
+        Define(instruction, Builtin(GLSLstd450NClamp, instruction));
+        return;
+      case Op::kFloor:
+        Define(instruction, Builtin(GLSLstd450Floor, instruction));
+        return;
+      case Op::kTrunc:
+        Define(instruction, Builtin(GLSLstd450Trunc, instruction));
+        return;
+      case Op::kFract:
+        Define(instruction, Builtin(GLSLstd450Fract, instruction));
+        return;
+      case Op::kExp2:
+        Define(instruction, Builtin(GLSLstd450Exp2, instruction));
+        return;
+      case Op::kLog2:
+        Define(instruction, Builtin(GLSLstd450Log2, instruction));
+        return;
+      case Op::kInverseSqrt:
+        Define(instruction, Builtin(GLSLstd450InverseSqrt, instruction));
+        return;
+      case Op::kSqrt:
+        Define(instruction, Builtin(GLSLstd450Sqrt, instruction));
+        return;
+      case Op::kSin:
+        Define(instruction, Builtin(GLSLstd450Sin, instruction));
+        return;
+      case Op::kCos:
+        Define(instruction, Builtin(GLSLstd450Cos, instruction));
+        return;
+      case Op::kLdexp:
+        Define(instruction, Builtin(GLSLstd450Ldexp, instruction));
+        return;
+
+      case Op::kFOrdEqual:
+      case Op::kFOrdNotEqual:
+      case Op::kFUnordNotEqual:
+      case Op::kFOrdLessThan:
+      case Op::kFOrdLessThanEqual:
+      case Op::kFOrdGreaterThan:
+      case Op::kFOrdGreaterThanEqual:
+      case Op::kIEqual:
+      case Op::kINotEqual:
+      case Op::kULessThan:
+      case Op::kUGreaterThanEqual:
+      case Op::kLogicalAnd:
+      case Op::kLogicalOr:
+      case Op::kIAdd:
+      case Op::kISub:
+      case Op::kIMul:
+      case Op::kShiftLeftLogical:
+      case Op::kShiftRightLogical:
+      case Op::kBitwiseAnd:
+      case Op::kBitwiseOr:
+      case Op::kBitwiseXor:
+      case Op::kUMod: {
+        static const std::unordered_map<Op, spv::Op> kBinaryOps = {
+            {Op::kFOrdEqual, spv::OpFOrdEqual},
+            {Op::kFOrdNotEqual, spv::OpFOrdNotEqual},
+            {Op::kFUnordNotEqual, spv::OpFUnordNotEqual},
+            {Op::kFOrdLessThan, spv::OpFOrdLessThan},
+            {Op::kFOrdLessThanEqual, spv::OpFOrdLessThanEqual},
+            {Op::kFOrdGreaterThan, spv::OpFOrdGreaterThan},
+            {Op::kFOrdGreaterThanEqual, spv::OpFOrdGreaterThanEqual},
+            {Op::kIEqual, spv::OpIEqual},
+            {Op::kINotEqual, spv::OpINotEqual},
+            {Op::kULessThan, spv::OpULessThan},
+            {Op::kUGreaterThanEqual, spv::OpUGreaterThanEqual},
+            {Op::kLogicalAnd, spv::OpLogicalAnd},
+            {Op::kLogicalOr, spv::OpLogicalOr},
+            {Op::kIAdd, spv::OpIAdd},
+            {Op::kISub, spv::OpISub},
+            {Op::kIMul, spv::OpIMul},
+            {Op::kShiftLeftLogical, spv::OpShiftLeftLogical},
+            {Op::kShiftRightLogical, spv::OpShiftRightLogical},
+            {Op::kBitwiseAnd, spv::OpBitwiseAnd},
+            {Op::kBitwiseOr, spv::OpBitwiseOr},
+            {Op::kBitwiseXor, spv::OpBitwiseXor},
+            {Op::kUMod, spv::OpUMod},
+        };
+        Define(instruction, builder_.createBinOp(kBinaryOps.at(instruction.op), type,
+                                                 Value(operands[0]), Value(operands[1])));
+      } return;
+      case Op::kLogicalNot:
+        Define(instruction, builder_.createUnaryOp(spv::OpLogicalNot, type, Value(operands[0])));
+        return;
+      case Op::kAny:
+        // OpAny takes a vector.
+        Define(instruction, TypeOf(operands[0]).components == 1
+                                ? Value(operands[0])
+                                : builder_.createUnaryOp(spv::OpAny, type, Value(operands[0])));
+        return;
+      case Op::kSelect: {
+        spv::Id condition = Value(operands[0]);
+        // A scalar condition for a vector needs SPIR-V 1.4.
+        if (TypeOf(operands[0]).components != instruction.type.components &&
+            options_.spirv_version < spv::Spv_1_4) {
+          condition = builder_.createCompositeConstruct(
+              TypeId(kBool.WithComponents(instruction.type.components)),
+              std::vector<spv::Id>(instruction.type.components, condition));
+        }
+        Define(instruction, builder_.createTriOp(spv::OpSelect, type, condition, Value(operands[1]),
+                                                 Value(operands[2])));
+      } return;
+
+      case Op::kBitFieldUExtract:
+      case Op::kBitFieldSExtract:
+        Define(instruction,
+               builder_.createTriOp(instruction.op == Op::kBitFieldUExtract
+                                        ? spv::OpBitFieldUExtract
+                                        : spv::OpBitFieldSExtract,
+                                    type, Value(operands[0]), Value(operands[1]),
+                                    Value(operands[2])));
+        return;
+      case Op::kBitFieldInsert:
+        Define(instruction,
+               builder_.createQuadOp(spv::OpBitFieldInsert, type, Value(operands[0]),
+                                     Value(operands[1]), Value(operands[2]), Value(operands[3])));
+        return;
+      case Op::kUMin:
+        Define(instruction, Builtin(GLSLstd450UMin, instruction));
+        return;
+      case Op::kUMax:
+        Define(instruction, Builtin(GLSLstd450UMax, instruction));
+        return;
+      case Op::kSMin:
+        Define(instruction, Builtin(GLSLstd450SMin, instruction));
+        return;
+      case Op::kSMax:
+        Define(instruction, Builtin(GLSLstd450SMax, instruction));
+        return;
+
+      case Op::kConvertFToS:
+        Define(instruction, builder_.createUnaryOp(spv::OpConvertFToS, type, Value(operands[0])));
+        return;
+      case Op::kConvertFToU:
+        Define(instruction, builder_.createUnaryOp(spv::OpConvertFToU, type, Value(operands[0])));
+        return;
+      case Op::kConvertSToF:
+        Define(instruction, builder_.createUnaryOp(spv::OpConvertSToF, type, Value(operands[0])));
+        return;
+      case Op::kConvertUToF:
+        Define(instruction, builder_.createUnaryOp(spv::OpConvertUToF, type, Value(operands[0])));
+        return;
+      case Op::kBitcast:
+        Define(instruction, builder_.createUnaryOp(spv::OpBitcast, type, Value(operands[0])));
+        return;
+
+      case Op::kConstruct: {
+        std::vector<spv::Id> constituents;
+        for (ValueId operand : operands) {
+          constituents.push_back(Value(operand));
+        }
+        Define(instruction, builder_.createCompositeConstruct(type, constituents));
+      } return;
+      case Op::kExtract:
+        Define(instruction, builder_.createCompositeExtract(Value(operands[0]), type,
+                                                            instruction.imm[0]));
+        return;
+      case Op::kShuffle: {
+        uint32_t first_components = TypeOf(operands[0]).components;
+        if (first_components > 1 && TypeOf(operands[1]).components > 1) {
+          spv::Instruction* shuffle = new spv::Instruction(builder_.getUniqueId(), type,
+                                                           spv::OpVectorShuffle);
+          shuffle->addIdOperand(Value(operands[0]));
+          shuffle->addIdOperand(Value(operands[1]));
+          for (uint32_t i = 0; i < instruction.type.components; ++i) {
+            shuffle->addImmediateOperand(instruction.imm[i]);
+          }
+          builder_.getBuildPoint()->addInstruction(std::unique_ptr<spv::Instruction>(shuffle));
+          Define(instruction, shuffle->getResultId());
+        } else {
+          // A scalar operand: gather the components.
+          std::vector<spv::Id> constituents;
+          for (uint32_t i = 0; i < instruction.type.components; ++i) {
+            uint32_t index = instruction.imm[i];
+            constituents.push_back(index < first_components
+                                       ? Component(operands[0], index)
+                                       : Component(operands[1], index - first_components));
+          }
+          Define(instruction, builder_.createCompositeConstruct(type, constituents));
+        }
+      } return;
+      case Op::kInsert:
+        Define(instruction, builder_.createCompositeInsert(Value(operands[1]), Value(operands[0]),
+                                                           type, instruction.imm[0]));
+        return;
+
+      case Op::kDpdxCoarse:
+      case Op::kDpdyCoarse:
+        builder_.addCapability(spv::CapabilityDerivativeControl);
+        Define(instruction,
+               builder_.createUnaryOp(
+                   instruction.op == Op::kDpdxCoarse ? spv::OpDPdxCoarse : spv::OpDPdyCoarse, type,
+                   Value(operands[0])));
+        return;
+
+      case Op::kTextureSample: {
+        const auto& [texture_variable, image_type] = textures_[instruction.imm[0]];
+        spv::Id image = builder_.createLoad(texture_variable, spv::NoPrecision);
+        spv::Id sampler = builder_.createLoad(samplers_[instruction.imm[1]], spv::NoPrecision);
+        spv::Id sampled_image = builder_.createBinOp(
+            spv::OpSampledImage, builder_.makeSampledImageType(image_type), image, sampler);
+        std::vector<spv::IdImmediate> sample_operands = {{true, sampled_image},
+                                                         {true, Value(operands[0])}};
+        if (TextureSampleMode(instruction.imm[2]) == TextureSampleMode::kLod) {
+          sample_operands.push_back({false, spv::ImageOperandsLodMask});
+          sample_operands.push_back({true, Value(operands[1])});
+        } else {
+          sample_operands.push_back({false, spv::ImageOperandsGradMask});
+          sample_operands.push_back({true, Value(operands[1])});
+          sample_operands.push_back({true, Value(operands[2])});
+        }
+        Define(instruction, builder_.createOp(spv::OpImageSampleExplicitLod, type, sample_operands));
+      } return;
+
+      case Op::kDemote:
+        builder_.addExtension("SPV_EXT_demote_to_helper_invocation");
+        builder_.addCapability(spv::CapabilityDemoteToHelperInvocationEXT);
+        builder_.createNoResultOp(spv::OpDemoteToHelperInvocationEXT);
+        return;
+      case Op::kKill:
+        // Terminates the block; WriteBody skips what follows.
+        builder_.createNoResultOp(spv::OpKill);
+        return;
+      case Op::kDebugCount:
+        // The debug counters exist only on Metal.
+        return;
+    }
+    assert_unhandled_case(instruction.op);
+  }
+
+  const Program& program_;
+  const SpirvOptions& options_;
+  SpirvBuilder builder_;
+  spv::Id glsl_std_450_ = spv::NoResult;
+  spv::Function* function_ = nullptr;
+
+  std::vector<spv::Id> values_;
+  std::vector<const Instruction*> constants_;
+  std::vector<spv::Id> variables_;
+
+  std::vector<spv::Id> interface_;
+  std::vector<spv::Id> input_interpolators_;
+  spv::Id input_point_coordinates_ = spv::NoResult;
+  spv::Id input_frag_coord_ = spv::NoResult;
+  spv::Id input_front_facing_ = spv::NoResult;
+  spv::Id input_vertex_index_ = spv::NoResult;
+  spv::Id output_per_vertex_ = spv::NoResult;
+  spv::Id shared_memory_ = spv::NoResult;
+  std::unordered_map<uint32_t, spv::Id> uniform_buffers_;
+  // The variable and the image type of each texture.
+  std::vector<std::pair<spv::Id, spv::Id>> textures_;
+  std::vector<spv::Id> samplers_;
+
+  std::vector<spv::Block*> break_targets_;
+  std::vector<spv::Block*> continue_targets_;
+};
+
+}  // namespace
+
+std::vector<uint32_t> EmitSpirv(const Program& program, const SpirvOptions& options) {
+  return SpirvEmitter(program, options).Emit();
+}
+
+}  // namespace rex::graphics::xsc
