+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_translator_fetch.cpp
+ * @brief       Xenos shader compiler: texture fetch instructions
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The same sampling as the SPIR-V translator (spirv_translator_fetch.cpp): 1D and 2D textures
+ * (stacked too) are 2D arrays, 3D and stacked textures share a fetch with a run-time choice by
+ * the fetch constant's dimension, both the unsigned and the signed view are sampled where a
+ * component may need it, and the signedness, the gamma conversion and the exponent bias are
+ * applied per result component.
+ */
+
+#include <cmath>
+#include <cstring>
+
+#include <rex/assert.h>
+#include <rex/math.h>
+
+#include "xsc_translator.h"
+
+namespace rex::graphics::xsc {
+
+using SystemConstants = SpirvShaderTranslator::SystemConstants;
+
+void XscShaderTranslator::ProcessVertexFetchInstruction(
+    const ParsedVertexFetchInstruction& instr) {
+  Builder& b = *builder_;
+  UpdateInstructionPredication(instr.is_predicated, instr.predicate_condition);
+
+  uint32_t used_result_components = instr.result.GetUsedResultComponents();
+  uint32_t needed_words =
+      xenos::GetVertexFormatNeededWords(instr.attributes.data_format, used_result_components);
+  // vfetch_full computes the address for the following vfetch_mini even if it loads nothing.
+  if (!needed_words && instr.is_mini_fetch) {
+    // Only constant 0 and 1 writes, or components the format does not have (written as zero).
+    StoreResult(instr.result, kNoValue);
+    return;
+  }
+
+  // Each vertex fetch constant is 2 dwords of the fetch constant buffer.
+  uint32_t fetch_constant_word_0_index = instr.operands[1].storage_index << 1;
+
+  ValueId address;
+  if (instr.is_mini_fetch) {
+    // `base + index * stride` from vfetch_full.
+    address = b.Load(var_vfetch_address_);
+  } else {
+    // The base address in dwords in bits 2:31 of the first word of the fetch constant.
+    address = b.Emit(
+        Op::kBitcast, kInt,
+        {b.Binary(Op::kShiftRightLogical,
+                  b.Emit(Op::kLoadFetchConstantWord, kUint, {}, {fetch_constant_word_0_index}),
+                  b.ConstUint(2))});
+    if (instr.attributes.stride) {
+      // The index floored, or rounded to the nearest as floor(index + 0.5).
+      ValueId index =
+          GetOperandComponents(LoadOperandStorage(instr.operands[0]), instr.operands[0], 0b0001);
+      if (instr.attributes.is_index_rounded) {
+        index = b.Binary(Op::kFAdd, index, b.ConstFloat(0.5f));
+      }
+      index = b.Emit(Op::kConvertFToS, kInt, {b.Unary(Op::kFloor, index)});
+      if (instr.attributes.stride > 1) {
+        index = b.Binary(Op::kIMul, index, b.ConstInt(int32_t(instr.attributes.stride)));
+      }
+      address = b.Binary(Op::kIAdd, address, index);
+    }
+    b.Store(var_vfetch_address_, address);
+  }
+
+  if (!needed_words) {
+    StoreResult(instr.result, kNoValue);
+    return;
+  }
+
+  // The needed words: the instruction's signed word offset plus the word's offset in the element.
+  uint32_t word_composite_indices[4] = {};
+  std::vector<ValueId> word_values;
+  uint32_t words_remaining = needed_words;
+  uint32_t word_index;
+  while (rex::bit_scan_forward(words_remaining, &word_index)) {
+    words_remaining &= ~(UINT32_C(1) << word_index);
+    ValueId word_address = address;
+    int32_t word_offset = instr.attributes.offset + int32_t(word_index);
+    if (word_offset) {
+      word_address = b.Binary(Op::kIAdd, word_address, b.ConstInt(word_offset));
+    }
+    word_composite_indices[word_index] = uint32_t(word_values.size());
+    word_values.push_back(b.Emit(Op::kLoadSharedMemoryWord, kUint, {word_address}));
+  }
+  uint32_t word_count = uint32_t(word_values.size());
+  ValueId words = b.Construct(kUint.WithComponents(uint8_t(word_count)), word_values);
+
+  // Endian swap, with the endianness in bits 0:1 of the second word of the fetch constant.
+  words = EndianSwap32Uint(
+      words,
+      b.Binary(Op::kBitwiseAnd,
+               b.Emit(Op::kLoadFetchConstantWord, kUint, {}, {fetch_constant_word_0_index + 1}),
+               b.ConstUint(0b11)));
+
+  // The format conversion.
+  ValueId result = kNoValue;
+  uint32_t used_format_components =
+      used_result_components &
+      ((UINT32_C(1) << xenos::GetVertexFormatComponentCount(instr.attributes.data_format)) - 1);
+  assert_not_zero(used_format_components);
+  uint8_t used_format_component_count = uint8_t(rex::bit_count(used_format_components));
+  Type result_type = kFloat.WithComponents(used_format_component_count);
+  bool is_signed = instr.attributes.is_signed;
+  bool format_is_packed = false;
+  int packed_widths[4] = {}, packed_offsets[4] = {};
+  uint32_t packed_words[4] = {};
+  auto word_component = [&](uint32_t word) {
+    return word_count > 1 ? b.Extract(words, word_composite_indices[word]) : words;
+  };
+  switch (instr.attributes.data_format) {
+    case xenos::VertexFormat::k_8_8_8_8:
+      format_is_packed = true;
+      packed_widths[0] = packed_widths[1] = packed_widths[2] = packed_widths[3] = 8;
+      packed_offsets[1] = 8;
+      packed_offsets[2] = 16;
+      packed_offsets[3] = 24;
+      break;
+    case xenos::VertexFormat::k_2_10_10_10:
+      format_is_packed = true;
+      packed_widths[0] = packed_widths[1] = packed_widths[2] = 10;
+      packed_widths[3] = 2;
+      packed_offsets[1] = 10;
+      packed_offsets[2] = 20;
+      packed_offsets[3] = 30;
+      break;
+    case xenos::VertexFormat::k_10_11_11:
+      format_is_packed = true;
+      packed_widths[0] = packed_widths[1] = 11;
+      packed_widths[2] = 10;
+      packed_offsets[1] = 11;
+      packed_offsets[2] = 22;
+      break;
+    case xenos::VertexFormat::k_11_11_10:
+      format_is_packed = true;
+      packed_widths[0] = 10;
+      packed_widths[1] = packed_widths[2] = 11;
+      packed_offsets[1] = 10;
+      packed_offsets[2] = 21;
+      break;
+    case xenos::VertexFormat::k_16_16:
+      format_is_packed = true;
+      packed_widths[0] = packed_widths[1] = 16;
+      packed_offsets[1] = 16;
+      break;
+    case xenos::VertexFormat::k_16_16_16_16:
+      format_is_packed = true;
+      packed_widths[0] = packed_widths[1] = packed_widths[2] = packed_widths[3] = 16;
+      packed_offsets[1] = packed_offsets[3] = 16;
+      packed_words[2] = packed_words[3] = 1;
+      break;
+
+    case xenos::VertexFormat::k_16_16_FLOAT:
+    case xenos::VertexFormat::k_16_16_16_16_FLOAT: {
+      // As the SPIR-V translator: host float16 with NaNs, not the Xbox 360 one with an extended
+      // range.
+      ValueId word_needed_component_values[2] = {};
+      for (uint32_t i = 0; i < 2; ++i) {
+        uint32_t word_needed_components = (used_format_components >> (i * 2)) & 0b11;
+        if (!word_needed_components) {
+          continue;
+        }
+        ValueId word = b.Emit(Op::kUnpackHalf2x16, kFloat2, {word_component(i)});
+        if (word_needed_components != 0b11) {
+          word = b.Extract(word, (word_needed_components & 0b01) ? 0 : 1);
+        }
+        word_needed_component_values[i] = word;
+      }
+      if (word_needed_component_values[1] == kNoValue) {
+        result = word_needed_component_values[0];
+      } else if (word_needed_component_values[0] == kNoValue) {
+        result = word_needed_component_values[1];
+      } else {
+        result = b.Construct(result_type,
+                             {word_needed_component_values[0], word_needed_component_values[1]});
+      }
+    } break;
+
+    case xenos::VertexFormat::k_32:
+    case xenos::VertexFormat::k_32_32:
+    case xenos::VertexFormat::k_32_32_32_32:
+      assert_true(used_format_components == needed_words);
+      if (is_signed) {
+        result = b.Emit(Op::kConvertSToF, result_type,
+                        {b.Emit(Op::kBitcast, kInt.WithComponents(used_format_component_count),
+                                {words})});
+      } else {
+        result = b.Emit(Op::kConvertUToF, result_type, {words});
+      }
+      if (!instr.attributes.is_integer) {
+        auto scale = [&](ValueId value, float factor) {
+          return used_format_component_count > 1
+                     ? b.Emit(Op::kVectorTimesScalar, result_type, {value, b.ConstFloat(factor)})
+                     : b.Binary(Op::kFMul, value, b.ConstFloat(factor));
+        };
+        if (is_signed) {
+          switch (instr.attributes.signed_rf_mode) {
+            case xenos::SignedRepeatingFractionMode::kZeroClampMinusOne:
+              // 1/(2^31-1) rounds to 1/2^31 as float32, so no clamp to -1 is needed.
+              result = scale(result, 1.0f / 2147483647.0f);
+              break;
+            case xenos::SignedRepeatingFractionMode::kNoZero:
+              result = scale(result, 1.0f / 2147483647.5f);
+              result = b.Binary(Op::kFAdd, result,
+                                b.ConstFloat(0.5f / 2147483647.5f, used_format_component_count));
+              break;
+            default:
+              assert_unhandled_case(instr.attributes.signed_rf_mode);
+          }
+        } else {
+          result = scale(result, 1.0f / 4294967295.0f);
+        }
+      }
+      break;
+
+    case xenos::VertexFormat::k_32_FLOAT:
+    case xenos::VertexFormat::k_32_32_FLOAT:
+    case xenos::VertexFormat::k_32_32_32_32_FLOAT:
+    case xenos::VertexFormat::k_32_32_32_FLOAT:
+      assert_true(used_format_components == needed_words);
+      result = b.Emit(Op::kBitcast, kFloat.WithComponents(uint8_t(word_count)), {words});
+      break;
+
+    default:
+      Unsupported("this vertex format");
+      StoreResult(instr.result, kNoValue);
+      return;
+  }
+
+  if (format_is_packed) {
+    // Extract the components as ints (sign-extending) or uints.
+    Type component_type = is_signed ? kInt : kUint;
+    if (is_signed) {
+      words = b.Emit(Op::kBitcast, kInt.WithComponents(uint8_t(word_count)), {words});
+    }
+    int extracted_widths[4] = {};
+    std::vector<ValueId> extracted_components;
+    uint32_t extraction_word_current_index = UINT32_MAX;
+    ValueId extraction_word_current = words;
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (!(used_format_components & (UINT32_C(1) << i))) {
+        continue;
+      }
+      if (word_count > 1) {
+        uint32_t extraction_word_new_index = word_composite_indices[packed_words[i]];
+        if (extraction_word_current_index != extraction_word_new_index) {
+          extraction_word_current_index = extraction_word_new_index;
+          extraction_word_current = b.Extract(words, extraction_word_new_index);
+        }
+      }
+      int extraction_width = packed_widths[i];
+      assert_not_zero(extraction_width);
+      extracted_widths[extracted_components.size()] = extraction_width;
+      extracted_components.push_back(b.Emit(
+          is_signed ? Op::kBitFieldSExtract : Op::kBitFieldUExtract, component_type,
+          {extraction_word_current, b.ConstInt(packed_offsets[i]), b.ConstInt(extraction_width)}));
+    }
+    assert_true(extracted_components.size() == used_format_component_count);
+    result = b.Construct(component_type.WithComponents(used_format_component_count),
+                         extracted_components);
+    result = b.Emit(is_signed ? Op::kConvertSToF : Op::kConvertUToF, result_type, {result});
+    // Normalization.
+    if (!instr.attributes.is_integer) {
+      std::array<uint32_t, 4> packed_scales = {};
+      std::array<uint32_t, 4> packed_no_zero_offsets = {};
+      for (uint32_t i = 0; i < used_format_component_count; ++i) {
+        int extracted_width = extracted_widths[i];
+        assert_true(extracted_width >= 2);
+        float packed_scale_inv;
+        if (is_signed) {
+          packed_scale_inv = float((UINT32_C(1) << (extracted_width - 1)) - 1);
+          if (instr.attributes.signed_rf_mode == xenos::SignedRepeatingFractionMode::kNoZero) {
+            packed_scale_inv += 0.5f;
+          }
+        } else {
+          packed_scale_inv = float((UINT32_C(1) << extracted_width) - 1);
+        }
+        float packed_scale = 1.0f / packed_scale_inv;
+        float packed_no_zero_offset = 0.5f * packed_scale;
+        std::memcpy(&packed_scales[i], &packed_scale, sizeof(uint32_t));
+        std::memcpy(&packed_no_zero_offsets[i], &packed_no_zero_offset, sizeof(uint32_t));
+      }
+      // Per-component scales (the SPIR-V translator multiplies by a vector of them).
+      result = b.Binary(Op::kFMul, result, b.Constant(result_type, packed_scales));
+      if (is_signed) {
+        switch (instr.attributes.signed_rf_mode) {
+          case xenos::SignedRepeatingFractionMode::kZeroClampMinusOne:
+            // Both -(2^(n-1)) and -(2^(n-1)-1) are -1 (no NaN here, so NMax is FMax).
+            result = b.Binary(Op::kNMax, result,
+                              b.ConstFloat(-1.0f, used_format_component_count));
+            break;
+          case xenos::SignedRepeatingFractionMode::kNoZero:
+            result = b.Binary(Op::kFAdd, result, b.Constant(result_type, packed_no_zero_offsets));
+            break;
+          default:
+            assert_unhandled_case(instr.attributes.signed_rf_mode);
+        }
+      }
+    }
+  }
+
+  // The exponent bias.
+  if (instr.attributes.exp_adjust) {
+    ValueId factor = b.ConstFloat(std::ldexp(1.0f, instr.attributes.exp_adjust));
+    result = b.TypeOf(result).components > 1
+                 ? b.Emit(Op::kVectorTimesScalar, b.TypeOf(result), {result, factor})
+                 : b.Binary(Op::kFMul, result, factor);
+  }
+
+  // Components requested that the format does not have are zero.
+  uint32_t used_missing_components = used_result_components & ~used_format_components;
+  if (used_missing_components) {
+    result = b.Construct(
+        kFloat.WithComponents(uint8_t(rex::bit_count(used_result_components))),
+        {result, b.ConstFloat(0.0f, uint8_t(rex::bit_count(used_missing_components)))});
+  }
+  StoreResult(instr.result, result);
+}
+
+size_t XscShaderTranslator::FindOrAddTextureBinding(uint32_t fetch_constant,
+                                                    xenos::FetchOpDimension dimension,
+                                                    bool is_signed) {
+  // 1D and 2D textures (including stacked ones) are 2D arrays.
+  if (dimension == xenos::FetchOpDimension::k1D) {
+    dimension = xenos::FetchOpDimension::k2D;
+  }
+  for (size_t i = 0; i < texture_bindings_.size(); ++i) {
+    const TextureBinding& binding = texture_bindings_[i];
+    if (binding.fetch_constant == fetch_constant && binding.dimension == dimension &&
+        binding.is_signed == is_signed) {
+      return i;
+    }
+  }
+  texture_bindings_.push_back({fetch_constant, dimension, is_signed});
+  return texture_bindings_.size() - 1;
+}
+
+size_t XscShaderTranslator::FindOrAddSamplerBinding(uint32_t fetch_constant,
+                                                    xenos::TextureFilter mag_filter,
+                                                    xenos::TextureFilter min_filter,
+                                                    xenos::TextureFilter mip_filter,
+                                                    xenos::AnisoFilter aniso_filter) {
+  if (aniso_filter != xenos::AnisoFilter::kUseFetchConst) {
+    aniso_filter = std::min(aniso_filter, xenos::AnisoFilter::kMax_16_1);
+  }
+  for (size_t i = 0; i < sampler_bindings_.size(); ++i) {
+    const SamplerBinding& binding = sampler_bindings_[i];
+    if (binding.fetch_constant == fetch_constant && binding.mag_filter == mag_filter &&
+        binding.min_filter == min_filter && binding.mip_filter == mip_filter &&
+        binding.aniso_filter == aniso_filter) {
+      return i;
+    }
+  }
+  sampler_bindings_.push_back({fetch_constant, mag_filter, min_filter, mip_filter, aniso_filter});
+  return sampler_bindings_.size() - 1;
+}
+
+void XscShaderTranslator::SampleTexture(TextureSampleMode mode, TextureDimension dimension,
+                                        ValueId coordinates, ValueId lod_or_gradient_x,
+                                        ValueId gradient_y, size_t texture_unsigned,
+                                        size_t texture_signed, size_t sampler,
+                                        ValueId is_any_unsigned, ValueId is_any_signed,
+                                        ValueId& result_unsigned_out, ValueId& result_signed_out,
+                                        ValueId lerp_factor, ValueId lerp_first_unsigned,
+                                        ValueId lerp_first_signed) {
+  Builder& b = *builder_;
+  for (uint32_t i = 0; i < 2; ++i) {
+    Builder::If sign_if(b, i ? is_any_signed : is_any_unsigned);
+    ValueId sign_result;
+    {
+      std::vector<ValueId> operands = {coordinates, lod_or_gradient_x};
+      if (mode == TextureSampleMode::kGradients) {
+        operands.push_back(gradient_y);
+      }
+      sign_result = b.EmitWithOperands(
+          Op::kTextureSample, kFloat4, operands,
+          {uint32_t(i ? texture_signed : texture_unsigned), uint32_t(sampler), uint32_t(mode),
+           uint32_t(dimension)});
+      if (lerp_factor != kNoValue) {
+        ValueId lerp_first = i ? lerp_first_signed : lerp_first_unsigned;
+        if (lerp_first != kNoValue) {
+          // As in the SPIR-V translator: result + (result - first) * factor.
+          ValueId lerp_difference = b.Emit(Op::kVectorTimesScalar, kFloat4,
+                                           {b.Binary(Op::kFSub, sign_result, lerp_first), lerp_factor});
+          sign_result = b.Binary(Op::kFAdd, sign_result, lerp_difference);
+        }
+      }
+    }
+    sign_if.End();
+    (i ? result_signed_out : result_unsigned_out) =
+        sign_if.MergePhi(sign_result, b.ConstFloat(0.0f, 4));
+  }
+}
+
+void XscShaderTranslator::ProcessTextureFetchInstruction(
+    const ParsedTextureFetchInstruction& instr) {
+  Builder& b = *builder_;
+  if (instr.opcode == ucode::FetchOpcode::kTextureFetch && !features_.image_view_format_swizzle) {
+    // The SPIR-V translator swizzles the results in the shader without view format swizzles.
+    Unsupported("texture swizzles without view format swizzles");
+  }
+  UpdateInstructionPredication(instr.is_predicated, instr.predicate_condition);
+
+  // The instructions setting the register LOD and gradients.
+  switch (instr.opcode) {
+    case ucode::FetchOpcode::kSetTextureLod:
+      b.Store(var_tfetch_lod_,
+              GetOperandComponents(LoadOperandStorage(instr.operands[0]), instr.operands[0], 0b0001));
+      return;
+    case ucode::FetchOpcode::kSetTextureGradientsHorz:
+      b.Store(var_tfetch_gradients_h_,
+              GetOperandComponents(LoadOperandStorage(instr.operands[0]), instr.operands[0], 0b0111));
+      return;
+    case ucode::FetchOpcode::kSetTextureGradientsVert:
+      b.Store(var_tfetch_gradients_v_,
+              GetOperandComponents(LoadOperandStorage(instr.operands[0]), instr.operands[0], 0b0111));
+      return;
+    default:
+      break;
+  }
+
+  uint32_t used_result_components = instr.result.GetUsedResultComponents();
+  uint32_t used_result_nonzero_components = instr.GetNonZeroResultComponents();
+  switch (instr.opcode) {
+    case ucode::FetchOpcode::kTextureFetch:
+    case ucode::FetchOpcode::kGetTextureGradients:
+      break;
+    case ucode::FetchOpcode::kGetTextureComputedLod:
+      Unsupported("getCompTexLOD");
+      return;
+    case ucode::FetchOpcode::kGetTextureBorderColorFrac:
+      Unsupported("getBCF");
+      return;
+    case ucode::FetchOpcode::kGetTextureWeights:
+      // The LOD (W, the mip lerp factor) is disregarded, as in the SPIR-V translator.
+      used_result_nonzero_components &= ~uint32_t(0b1000);
+      break;
+    default:
+      Unsupported("an unknown texture fetch operation");
+      return;
+  }
+  uint8_t used_result_component_count = uint8_t(rex::bit_count(used_result_components));
+  if (!used_result_nonzero_components) {
+    // Only constant 0/1 writes.
+    if (used_result_components) {
+      StoreResult(instr.result, b.ConstFloat(0.0f, used_result_component_count));
+    }
+    return;
+  }
+
+  ValueId zero = b.ConstFloat(0.0f);
+  ValueId result[] = {zero, zero, zero, zero};
+
+  if (instr.opcode == ucode::FetchOpcode::kGetTextureGradients) {
+    // Doesn't need the texture.
+    ValueId operand_0_storage = LoadOperandStorage(instr.operands[0]);
+    bool derivative_function_x_used = (used_result_nonzero_components & 0b0011) != 0;
+    bool derivative_function_y_used = (used_result_nonzero_components & 0b1100) != 0;
+    ValueId derivative_function_x = kNoValue;
+    ValueId derivative_function_y = kNoValue;
+    if (derivative_function_x_used && derivative_function_y_used) {
+      ValueId derivative_function =
+          GetOperandComponents(operand_0_storage, instr.operands[0], 0b0011);
+      derivative_function_x = b.Extract(derivative_function, 0);
+      derivative_function_y = b.Extract(derivative_function, 1);
+    } else {
+      if (derivative_function_x_used) {
+        derivative_function_x = GetOperandComponents(operand_0_storage, instr.operands[0], 0b0001);
+      }
+      if (derivative_function_y_used) {
+        derivative_function_y = GetOperandComponents(operand_0_storage, instr.operands[0], 0b0010);
+      }
+    }
+    uint32_t components_remaining = used_result_nonzero_components;
+    uint32_t component_index;
+    while (rex::bit_scan_forward(components_remaining, &component_index)) {
+      components_remaining &= ~(UINT32_C(1) << component_index);
+      result[component_index] =
+          b.Unary((component_index & 0b01) ? Op::kDpdyCoarse : Op::kDpdxCoarse,
+                  (component_index & 0b10) ? derivative_function_y : derivative_function_x);
+    }
+  } else {
+    // kTextureFetch or kGetTextureWeights.
+    bool use_computed_lod = instr.attributes.use_computed_lod &&
+                            (is_pixel_shader() || instr.attributes.use_register_gradients);
+    uint32_t fetch_constant_index = instr.operands[1].storage_index;
+
+    size_t sampler_index = SIZE_MAX;
+    size_t texture_2d_array_or_cube_unsigned = SIZE_MAX;
+    size_t texture_2d_array_or_cube_signed = SIZE_MAX;
+    size_t texture_3d_unsigned = SIZE_MAX;
+    size_t texture_3d_signed = SIZE_MAX;
+    if (instr.opcode != ucode::FetchOpcode::kGetTextureWeights) {
+      // Anisotropic filtering is disabled with explicit LOD, as in the SPIR-V translator.
+      sampler_index = FindOrAddSamplerBinding(
+          fetch_constant_index, instr.attributes.mag_filter, instr.attributes.min_filter,
+          instr.attributes.mip_filter,
+          use_computed_lod ? instr.attributes.aniso_filter : xenos::AnisoFilter::kDisabled);
+      xenos::FetchOpDimension dimension_2d_array_or_cube =
+          instr.dimension == xenos::FetchOpDimension::k3DOrStacked ? xenos::FetchOpDimension::k2D
+                                                                   : instr.dimension;
+      texture_2d_array_or_cube_unsigned =
+          FindOrAddTextureBinding(fetch_constant_index, dimension_2d_array_or_cube, false);
+      texture_2d_array_or_cube_signed =
+          FindOrAddTextureBinding(fetch_constant_index, dimension_2d_array_or_cube, true);
+      if (instr.dimension == xenos::FetchOpDimension::k3DOrStacked) {
+        texture_3d_unsigned = FindOrAddTextureBinding(
+            fetch_constant_index, xenos::FetchOpDimension::k3DOrStacked, false);
+        texture_3d_signed = FindOrAddTextureBinding(fetch_constant_index,
+                                                    xenos::FetchOpDimension::k3DOrStacked, true);
+      }
+    }
+
+    // Offsets applied to the coordinates before sampling, with the rounding epsilon of the
+    // SPIR-V translator (1.5/4 of the 8-bit subtexel ULP) to resolve point sampling between
+    // texels.
+    float offset_values[3] = {};
+    const float kRoundingOffset = 1.5f / 1024.0f;
+    bool weights = instr.opcode == ucode::FetchOpcode::kGetTextureWeights;
+    switch (instr.dimension) {
+      case xenos::FetchOpDimension::k1D:
+        offset_values[0] = instr.attributes.offset_x + kRoundingOffset;
+        if (weights) {
+          offset_values[0] -= 0.5f;
+        }
+        break;
+      case xenos::FetchOpDimension::k2D:
+        offset_values[0] = instr.attributes.offset_x + kRoundingOffset;
+        offset_values[1] = instr.attributes.offset_y + kRoundingOffset;
+        if (weights) {
+          offset_values[0] -= 0.5f;
+          offset_values[1] -= 0.5f;
+        }
+        break;
+      case xenos::FetchOpDimension::k3DOrStacked:
+        offset_values[0] = instr.attributes.offset_x + kRoundingOffset;
+        offset_values[1] = instr.attributes.offset_y + kRoundingOffset;
+        offset_values[2] = instr.attributes.offset_z + kRoundingOffset;
+        if (weights) {
+          offset_values[0] -= 0.5f;
+          offset_values[1] -= 0.5f;
+          offset_values[2] -= 0.5f;
+        }
+        break;
+      case xenos::FetchOpDimension::kCube:
+        offset_values[0] = instr.attributes.offset_x + kRoundingOffset;
+        offset_values[1] = instr.attributes.offset_y + kRoundingOffset;
+        if (weights) {
+          offset_values[0] -= 0.5f;
+          offset_values[1] -= 0.5f;
+        } else {
+          offset_values[2] = instr.attributes.offset_z;
+        }
+        break;
+    }
+    uint32_t offsets_not_zero = 0b000;
+    for (uint32_t i = 0; i < 3; ++i) {
+      if (offset_values[i]) {
+        offsets_not_zero |= 1 << i;
+      }
+    }
+
+    // The texture size and whether the texture is 3D or stacked, where needed.
+    uint32_t size_needed_components = 0b000;
+    bool data_is_3d_needed = false;
+    if (weights) {
+      if (!instr.attributes.unnormalized_coordinates) {
+        switch (instr.dimension) {
+          case xenos::FetchOpDimension::k1D:
+            size_needed_components |= used_result_nonzero_components & 0b0001;
+            break;
+          case xenos::FetchOpDimension::k2D:
+          case xenos::FetchOpDimension::kCube:
+            size_needed_components |= used_result_nonzero_components & 0b0011;
+            break;
+          case xenos::FetchOpDimension::k3DOrStacked:
+            size_needed_components |= used_result_nonzero_components & 0b0111;
+            break;
+        }
+      }
+    } else {
+      size_needed_components |= offsets_not_zero;
+      switch (instr.dimension) {
+        case xenos::FetchOpDimension::k1D:
+          if (instr.attributes.unnormalized_coordinates) {
+            size_needed_components |= 0b0001;
+          }
+          break;
+        case xenos::FetchOpDimension::k2D:
+          if (instr.attributes.unnormalized_coordinates) {
+            size_needed_components |= 0b0011;
+          }
+          break;
+        case xenos::FetchOpDimension::k3DOrStacked:
+          data_is_3d_needed = true;
+          size_needed_components |= instr.attributes.unnormalized_coordinates ? 0b0111 : 0b0100;
+          break;
+        case xenos::FetchOpDimension::kCube:
+          if (instr.attributes.unnormalized_coordinates) {
+            size_needed_components |= 0b0011;
+          }
+          // The size is not needed for the face ID offset.
+          size_needed_components &= 0b0011;
+          break;
+      }
+    }
+    if (instr.dimension == xenos::FetchOpDimension::k3DOrStacked && size_needed_components) {
+      data_is_3d_needed = true;
+    }
+    ValueId data_is_3d = kNoValue;
+    if (data_is_3d_needed) {
+      // Bits 9:10 of the word 5.
+      ValueId data_dimension = b.Emit(
+          Op::kBitFieldUExtract, kUint,
+          {LoadFetchConstantWord(fetch_constant_index, 5), b.ConstUint(9), b.ConstUint(2)});
+      data_is_3d = b.Compare(Op::kIEqual, data_dimension,
+                             b.ConstUint(uint32_t(xenos::DataDimension::k3D)));
+    }
+    ValueId size[3] = {};
+    if (size_needed_components) {
+      ValueId word_2 = LoadFetchConstantWord(fetch_constant_index, 2);
+      auto extract = [&](uint32_t offset, uint32_t count) {
+        return b.Emit(Op::kBitFieldUExtract, kUint,
+                      {word_2, b.ConstUint(offset), b.ConstUint(count)});
+      };
+      switch (instr.dimension) {
+        case xenos::FetchOpDimension::k1D:
+          if (size_needed_components & 0b1) {
+            size[0] = extract(0, xenos::kTexture1DMaxWidthLog2);
+          }
+          break;
+        case xenos::FetchOpDimension::k2D:
+        case xenos::FetchOpDimension::kCube:
+          if (size_needed_components & 0b1) {
+            size[0] = extract(0, xenos::kTexture2DCubeMaxWidthHeightLog2);
+          }
+          if (size_needed_components & 0b10) {
+            size[1] = extract(xenos::kTexture2DCubeMaxWidthHeightLog2,
+                              xenos::kTexture2DCubeMaxWidthHeightLog2);
+          }
+          break;
+        case xenos::FetchOpDimension::k3DOrStacked:
+          if (size_needed_components & 0b1) {
+            ValueId size_3d = extract(0, xenos::kTexture3DMaxWidthHeightLog2);
+            ValueId size_2d = extract(0, xenos::kTexture2DCubeMaxWidthHeightLog2);
+            size[0] = b.Select(data_is_3d, size_3d, size_2d);
+          }
+          if (size_needed_components & 0b10) {
+            ValueId size_3d = extract(xenos::kTexture3DMaxWidthHeightLog2,
+                                      xenos::kTexture3DMaxWidthHeightLog2);
+            ValueId size_2d = extract(xenos::kTexture2DCubeMaxWidthHeightLog2,
+                                      xenos::kTexture2DCubeMaxWidthHeightLog2);
+            size[1] = b.Select(data_is_3d, size_3d, size_2d);
+          }
+          if (size_needed_components & 0b100) {
+            ValueId size_3d =
+                extract(xenos::kTexture3DMaxWidthHeightLog2 * 2, xenos::kTexture3DMaxDepthLog2);
+            ValueId size_2d = extract(xenos::kTexture2DCubeMaxWidthHeightLog2 * 2,
+                                      xenos::kTexture2DMaxStackDepthLog2);
+            size[2] = b.Select(data_is_3d, size_3d, size_2d);
+          }
+          break;
+      }
+      uint32_t size_remaining_components = size_needed_components;
+      uint32_t size_component_index;
+      while (rex::bit_scan_forward(size_remaining_components, &size_component_index)) {
+        size_remaining_components &= ~(UINT32_C(1) << size_component_index);
+        // The fetch constants store the size minus 1.
+        ValueId& size_component = size[size_component_index];
+        size_component = b.Emit(Op::kConvertUToF, kFloat,
+                                {b.Emit(Op::kIAdd, kUint, {size_component, b.ConstUint(1)})});
+      }
+    }
+
+    // The coordinates.
+    uint32_t coordinates_needed_components =
+        weights ? used_result_nonzero_components
+                : ((UINT32_C(1) << xenos::GetFetchOpDimensionComponentCount(instr.dimension)) - 1);
+    ValueId coordinates_operand = GetOperandComponents(
+        LoadOperandStorage(instr.operands[0]), instr.operands[0], coordinates_needed_components);
+    ValueId coordinates[] = {zero, zero, zero};
+    if (rex::bit_count(coordinates_needed_components) > 1) {
+      uint32_t coordinates_remaining_components = coordinates_needed_components;
+      uint32_t coordinate_component_index;
+      uint32_t coordinate_operand_component_index = 0;
+      while (rex::bit_scan_forward(coordinates_remaining_components, &coordinate_component_index)) {
+        coordinates_remaining_components &= ~(UINT32_C(1) << coordinate_component_index);
+        coordinates[coordinate_component_index] =
+            b.Extract(coordinates_operand, coordinate_operand_component_index++);
+      }
+    } else {
+      uint32_t coordinate_component_index;
+      rex::bit_scan_forward(coordinates_needed_components, &coordinate_component_index);
+      coordinates[coordinate_component_index] = coordinates_operand;
+    }
+    // Textures resolved from render targets drawn at the draw resolution scale: the fetch constant
+    // has the guest size, so unnormalized coordinates and sizes for the weights, and the offsets,
+    // are scaled like in the SPIR-V translator.
+    ValueId texture_resolution_scaled = kNoValue;
+    uint32_t revert_resolution_scale_axes =
+        uint32_t(draw_resolution_scale_x_ > 1) | (uint32_t(draw_resolution_scale_y_ > 1) << 1);
+    const float texture_resolution_scale[] = {float(draw_resolution_scale_x_),
+                                              float(draw_resolution_scale_y_)};
+    if (revert_resolution_scale_axes) {
+      texture_resolution_scaled = b.Compare(
+          Op::kINotEqual,
+          b.Binary(Op::kBitwiseAnd,
+                   LoadSystemConstantWord(offsetof(SystemConstants, textures_resolution_scaled)),
+                   b.ConstUint(UINT32_C(1) << fetch_constant_index)),
+          b.ConstUint(0));
+    }
+
+    if (weights) {
+      uint32_t resolution_scaled_result_components =
+          used_result_nonzero_components & revert_resolution_scale_axes;
+      uint32_t resolution_scaled_coord_components =
+          instr.attributes.unnormalized_coordinates ? resolution_scaled_result_components : 0b000;
+      uint32_t resolution_scaled_size_components =
+          size_needed_components & resolution_scaled_result_components;
+      if (texture_resolution_scaled != kNoValue &&
+          (resolution_scaled_coord_components || resolution_scaled_size_components)) {
+        for (uint32_t i = 0; i < 2; ++i) {
+          ValueId scale = b.ConstFloat(texture_resolution_scale[i]);
+          if (resolution_scaled_coord_components & (UINT32_C(1) << i)) {
+            coordinates[i] = b.Select(texture_resolution_scaled,
+                                      b.Binary(Op::kFMul, coordinates[i], scale), coordinates[i]);
+          }
+          if (resolution_scaled_size_components & (UINT32_C(1) << i)) {
+            assert_true(size[i] != kNoValue);
+            size[i] = b.Select(texture_resolution_scaled, b.Binary(Op::kFMul, size[i], scale),
+                               size[i]);
+          }
+        }
+      }
+
+      uint32_t coordinates_remaining_components = coordinates_needed_components;
+      uint32_t coordinate_component_index;
+      while (rex::bit_scan_forward(coordinates_remaining_components, &coordinate_component_index)) {
+        coordinates_remaining_components &= ~(UINT32_C(1) << coordinate_component_index);
+        ValueId result_component = coordinates[coordinate_component_index];
+        // Unnormalized coordinates are needed.
+        if (!instr.attributes.unnormalized_coordinates) {
+          ValueId size_component = size[coordinate_component_index];
+          assert_true(size_component != kNoValue);
+          result_component = b.Binary(Op::kFMul, result_component, size_component);
+        }
+        float component_offset = offset_values[coordinate_component_index];
+        if (component_offset) {
+          result_component = b.Binary(Op::kFAdd, result_component, b.ConstFloat(component_offset));
+        }
+        // 0.5 has already been subtracted with the offsets.
+        result[coordinate_component_index] = b.Unary(Op::kFract, result_component);
+      }
+    } else {
+      // kTextureFetch: normalize the XY coordinates and apply the offset.
+      for (uint32_t i = 0; i <= uint32_t(instr.dimension != xenos::FetchOpDimension::k1D); ++i) {
+        ValueId& coordinate = coordinates[i];
+        ValueId component_offset =
+            offset_values[i] ? b.ConstFloat(offset_values[i]) : kNoValue;
+        if (component_offset != kNoValue && texture_resolution_scaled != kNoValue &&
+            (revert_resolution_scale_axes & (UINT32_C(1) << i))) {
+          component_offset = b.Select(
+              texture_resolution_scaled,
+              b.Binary(Op::kFMul, component_offset,
+                       b.ConstFloat(1.0f / texture_resolution_scale[i])),
+              component_offset);
+        }
+        ValueId size_component = size[i];
+        if (instr.attributes.unnormalized_coordinates) {
+          if (component_offset != kNoValue) {
+            coordinate = b.Binary(Op::kFAdd, coordinate, component_offset);
+          }
+          assert_true(size_component != kNoValue);
+          coordinate = b.Binary(Op::kFDiv, coordinate, size_component);
+        } else if (component_offset != kNoValue) {
+          assert_true(size_component != kNoValue);
+          coordinate =
+              b.Binary(Op::kFAdd, coordinate, b.Binary(Op::kFDiv, component_offset, size_component));
+        }
+      }
+      if (instr.dimension == xenos::FetchOpDimension::k3DOrStacked) {
+        ValueId& z_coordinate = coordinates[2];
+        ValueId z_offset = offset_values[2] ? b.ConstFloat(offset_values[2]) : kNoValue;
+        ValueId z_size = size[2];
+        if (instr.attributes.unnormalized_coordinates) {
+          // Apply the offset, and normalize Z for a 3D texture.
+          if (z_offset != kNoValue) {
+            z_coordinate = b.Binary(Op::kFAdd, z_coordinate, z_offset);
+          }
+          Builder::If if_data_is_3d(b, data_is_3d);
+          ValueId z_3d = b.Binary(Op::kFDiv, z_coordinate, z_size);
+          if_data_is_3d.End();
+          z_coordinate = if_data_is_3d.MergePhi(z_3d, z_coordinate);
+        } else {
+          // Denormalize Z for a stacked texture, and apply the offset.
+          Builder::If if_data_is_3d(b, data_is_3d);
+          ValueId z_3d = z_coordinate;
+          if (z_offset != kNoValue) {
+            z_3d = b.Binary(Op::kFAdd, z_3d, b.Binary(Op::kFDiv, z_offset, z_size));
+          }
+          if_data_is_3d.BeginElse();
+          ValueId z_stacked = b.Binary(Op::kFMul, z_coordinate, z_size);
+          if (z_offset != kNoValue) {
+            z_stacked = b.Binary(Op::kFAdd, z_stacked, z_offset);
+          }
+          if_data_is_3d.End();
+          z_coordinate = if_data_is_3d.MergePhi(z_3d, z_stacked);
+        }
+      } else if (instr.dimension == xenos::FetchOpDimension::kCube) {
+        // From the 2D Xenos cube coordinates to 3D: SC/TC from 1...2 to -1...1.
+        for (uint32_t i = 0; i < 2; ++i) {
+          coordinates[i] = b.Binary(Op::kFAdd, b.Binary(Op::kFMul, coordinates[i], b.ConstFloat(2.0f)),
+                                    b.ConstFloat(-3.0f));
+        }
+        // The face index, floored, within 0...5.
+        ValueId face = coordinates[2];
+        if (offset_values[2]) {
+          face = b.Binary(Op::kFAdd, face, b.ConstFloat(offset_values[2]));
+        }
+        face = b.Emit(Op::kConvertFToU, kUint,
+                      {b.Emit(Op::kNClamp, kFloat, {face, zero, b.ConstFloat(5.0f)})});
+        ValueId const_uint_1 = b.ConstUint(1);
+        ValueId face_axis = b.Binary(Op::kShiftRightLogical, face, const_uint_1);
+        ValueId face_is_negative = b.Compare(
+            Op::kINotEqual, b.Binary(Op::kBitwiseAnd, face, const_uint_1), b.ConstUint(0));
+        ValueId face_sign = b.Select(face_is_negative, b.ConstFloat(-1.0f), b.ConstFloat(1.0f));
+        // Remap the axes in a way opposite to the ALU cube instruction.
+        ValueId sc_negated = b.Unary(Op::kFNeg, coordinates[0]);
+        ValueId tc_negated = b.Unary(Op::kFNeg, coordinates[1]);
+        Builder::Switch ma_switch(b, face_axis);
+        // X is the major axis.
+        ma_switch.BeginCase(0);
+        ValueId ma_x_y = tc_negated;
+        ValueId ma_x_z = b.Select(face_is_negative, coordinates[0], sc_negated);
+        // Y is the major axis.
+        ma_switch.BeginCase(1);
+        ValueId ma_y_x = coordinates[0];
+        ValueId ma_y_z = b.Select(face_is_negative, tc_negated, coordinates[1]);
+        // Z is the major axis (the default).
+        ma_switch.BeginDefault();
+        ValueId ma_z_x = b.Select(face_is_negative, sc_negated, coordinates[0]);
+        ValueId ma_z_y = tc_negated;
+        ma_switch.End();
+        coordinates[0] = ma_switch.MergePhi({face_sign, ma_y_x, ma_z_x});
+        coordinates[1] = ma_switch.MergePhi({ma_x_y, face_sign, ma_z_y});
+        coordinates[2] = ma_switch.MergePhi({ma_x_z, ma_y_z, face_sign});
+      }
+
+      // The post-swizzle signedness of every component of this fetch constant: 8 bits per fetch
+      // constant in the system constants.
+      ValueId swizzled_signs_word = LoadSystemConstantWord(
+          offsetof(SystemConstants, texture_swizzled_signs) +
+          sizeof(uint32_t) * (fetch_constant_index >> 2));
+      uint32_t swizzled_signs_word_offset = 8 * (fetch_constant_index & 3);
+
+      ValueId swizzled_signs[4] = {};
+      ValueId result_is_signed[4] = {};
+      ValueId is_all_signed = kNoValue;
+      ValueId is_any_signed = kNoValue;
+      ValueId const_uint_2 = b.ConstUint(2);
+      ValueId const_uint_sign_signed = b.ConstUint(uint32_t(xenos::TextureSign::kSigned));
+      {
+        uint32_t result_remaining_components = used_result_nonzero_components;
+        uint32_t result_component_index;
+        while (rex::bit_scan_forward(result_remaining_components, &result_component_index)) {
+          result_remaining_components &= ~(UINT32_C(1) << result_component_index);
+          ValueId result_component_sign = b.Emit(
+              Op::kBitFieldUExtract, kUint,
+              {swizzled_signs_word,
+               b.ConstUint(swizzled_signs_word_offset + 2 * result_component_index), const_uint_2});
+          swizzled_signs[result_component_index] = result_component_sign;
+          ValueId is_component_signed =
+              b.Compare(Op::kIEqual, result_component_sign, const_uint_sign_signed);
+          result_is_signed[result_component_index] = is_component_signed;
+          is_all_signed = is_all_signed != kNoValue
+                              ? b.Emit(Op::kLogicalAnd, kBool, {is_all_signed, is_component_signed})
+                              : is_component_signed;
+          is_any_signed = is_any_signed != kNoValue
+                              ? b.Emit(Op::kLogicalOr, kBool, {is_any_signed, is_component_signed})
+                              : is_component_signed;
+        }
+      }
+      ValueId is_any_unsigned = b.Unary(Op::kLogicalNot, is_all_signed);
+
+      // The word 4: LOD and gradient biases, the result exponent bias, stacked filtering.
+      ValueId fetch_constant_word_4 = LoadFetchConstantWord(fetch_constant_index, 4);
+      ValueId fetch_constant_word_4_signed = b.Emit(Op::kBitcast, kInt, {fetch_constant_word_4});
+
+      // The LOD (D3D11.3 order: specified LOD + sampler LOD bias + instruction LOD bias). The fetch
+      // constant LOD bias is in bits 12:21 of the word 4.
+      ValueId lod = b.Binary(
+          Op::kFMul,
+          b.Emit(Op::kConvertSToF, kFloat,
+                 {b.Emit(Op::kBitFieldSExtract, kInt,
+                         {fetch_constant_word_4_signed, b.ConstUint(12), b.ConstUint(10)})}),
+          b.ConstFloat(1.0f / 32.0f));
+      if (instr.attributes.use_register_lod) {
+        lod = b.Binary(Op::kFAdd, b.Load(var_tfetch_lod_), lod);
+      }
+      if (instr.attributes.lod_bias) {
+        lod = b.Binary(Op::kFAdd, lod, b.ConstFloat(instr.attributes.lod_bias));
+      }
+
+      // The gradients for sampling, scaled by 2^LOD bias.
+      ValueId gradients_h = kNoValue, gradients_v = kNoValue;
+      if (use_computed_lod) {
+        ValueId lod_gradient_scale = b.Unary(Op::kExp2, lod);
+        switch (instr.dimension) {
+          case xenos::FetchOpDimension::k1D: {
+            ValueId gradient_h_1d, gradient_v_1d;
+            if (instr.attributes.use_register_gradients) {
+              gradient_h_1d = b.Extract(b.Load(var_tfetch_gradients_h_), 0);
+              gradient_v_1d = b.Extract(b.Load(var_tfetch_gradients_v_), 0);
+              if (instr.attributes.unnormalized_coordinates) {
+                gradient_h_1d = b.Binary(Op::kFDiv, gradient_h_1d, size[0]);
+                gradient_v_1d = b.Binary(Op::kFDiv, gradient_v_1d, size[0]);
+              }
+            } else {
+              gradient_h_1d = b.Unary(Op::kDpdxCoarse, coordinates[0]);
+              gradient_v_1d = b.Unary(Op::kDpdyCoarse, coordinates[0]);
+            }
+            gradient_h_1d = b.Binary(Op::kFMul, gradient_h_1d, lod_gradient_scale);
+            gradient_v_1d = b.Binary(Op::kFMul, gradient_v_1d, lod_gradient_scale);
+            // 1D textures are 2D arrays.
+            gradients_h = b.Construct(kFloat2, {gradient_h_1d, zero});
+            gradients_v = b.Construct(kFloat2, {gradient_v_1d, zero});
+          } break;
+          case xenos::FetchOpDimension::k2D: {
+            if (instr.attributes.use_register_gradients) {
+              for (uint32_t i = 0; i < 2; ++i) {
+                ValueId register_gradient_3d =
+                    b.Load(i ? var_tfetch_gradients_h_ : var_tfetch_gradients_v_);
+                ValueId register_gradient_x = b.Extract(register_gradient_3d, 0);
+                ValueId register_gradient_y = b.Extract(register_gradient_3d, 1);
+                if (instr.attributes.unnormalized_coordinates) {
+                  register_gradient_x = b.Binary(Op::kFDiv, register_gradient_x, size[0]);
+                  register_gradient_y = b.Binary(Op::kFDiv, register_gradient_y, size[1]);
+                }
+                // As in the SPIR-V translator, i = 0 is vertical and i = 1 horizontal.
+                (i ? gradients_v : gradients_h) =
+                    b.Construct(kFloat2, {register_gradient_x, register_gradient_y});
+              }
+            } else {
+              ValueId gradient_coordinate_vector =
+                  b.Construct(kFloat2, {coordinates[0], coordinates[1]});
+              gradients_h = b.Unary(Op::kDpdxCoarse, gradient_coordinate_vector);
+              gradients_v = b.Unary(Op::kDpdyCoarse, gradient_coordinate_vector);
+            }
+            gradients_h = b.Emit(Op::kVectorTimesScalar, kFloat2, {gradients_h, lod_gradient_scale});
+            gradients_v = b.Emit(Op::kVectorTimesScalar, kFloat2, {gradients_v, lod_gradient_scale});
+          } break;
+          case xenos::FetchOpDimension::k3DOrStacked: {
+            if (instr.attributes.use_register_gradients) {
+              gradients_h = b.Load(var_tfetch_gradients_h_);
+              gradients_v = b.Load(var_tfetch_gradients_v_);
+              if (instr.attributes.unnormalized_coordinates) {
+                for (uint32_t i = 0; i < 2; ++i) {
+                  ValueId& gradient = i ? gradients_v : gradients_h;
+                  std::vector<ValueId> components;
+                  for (uint32_t j = 0; j < 3; ++j) {
+                    components.push_back(b.Binary(Op::kFDiv, b.Extract(gradient, j), size[j]));
+                  }
+                  gradient = b.Construct(kFloat3, components);
+                }
+              }
+            } else {
+              ValueId gradient_coordinate_vector =
+                  b.Construct(kFloat3, {coordinates[0], coordinates[1], coordinates[2]});
+              gradients_h = b.Unary(Op::kDpdxCoarse, gradient_coordinate_vector);
+              gradients_v = b.Unary(Op::kDpdyCoarse, gradient_coordinate_vector);
+            }
+            gradients_h = b.Emit(Op::kVectorTimesScalar, kFloat3, {gradients_h, lod_gradient_scale});
+            gradients_v = b.Emit(Op::kVectorTimesScalar, kFloat3, {gradients_v, lod_gradient_scale});
+          } break;
+          case xenos::FetchOpDimension::kCube: {
+            if (instr.attributes.use_register_gradients) {
+              // Register gradients are in the cube space already.
+              gradients_h = b.Load(var_tfetch_gradients_h_);
+              gradients_v = b.Load(var_tfetch_gradients_v_);
+            } else {
+              ValueId gradient_coordinate_vector =
+                  b.Construct(kFloat3, {coordinates[0], coordinates[1], coordinates[2]});
+              gradients_h = b.Unary(Op::kDpdxCoarse, gradient_coordinate_vector);
+              gradients_v = b.Unary(Op::kDpdyCoarse, gradient_coordinate_vector);
+            }
+            gradients_h = b.Emit(Op::kVectorTimesScalar, kFloat3, {gradients_h, lod_gradient_scale});
+            gradients_v = b.Emit(Op::kVectorTimesScalar, kFloat3, {gradients_v, lod_gradient_scale});
+          } break;
+        }
+      }
+
+      // Sample the texture.
+      TextureSampleMode mode = use_computed_lod ? TextureSampleMode::kGradients
+                                                : TextureSampleMode::kLod;
+      ValueId sample_result_unsigned, sample_result_signed;
+      ValueId lod_or_gradient_x = use_computed_lod ? gradients_h : lod;
+      ValueId gradient_y = use_computed_lod ? gradients_v : kNoValue;
+      if (instr.dimension == xenos::FetchOpDimension::k3DOrStacked) {
+        // 3D (one fetch) or 2D stacked (two fetches if Z is linearly filtered).
+        Builder::If if_data_is_3d(b, data_is_3d);
+        ValueId sample_result_unsigned_3d, sample_result_signed_3d;
+        SampleTexture(mode, TextureDimension::k3D,
+                      b.Construct(kFloat3, {coordinates[0], coordinates[1], coordinates[2]}),
+                      lod_or_gradient_x, gradient_y, texture_3d_unsigned, texture_3d_signed,
+                      sampler_index, is_any_unsigned, is_any_signed, sample_result_unsigned_3d,
+                      sample_result_signed_3d);
+        if_data_is_3d.BeginElse();
+        ValueId sample_result_unsigned_stacked, sample_result_signed_stacked;
+        {
+          ValueId stacked_gradient_x = lod_or_gradient_x, stacked_gradient_y = gradient_y;
+          if (use_computed_lod) {
+            stacked_gradient_x = b.Swizzle(gradients_h, {0, 1});
+            stacked_gradient_y = b.Swizzle(gradients_v, {0, 1});
+          }
+          // Whether the layers are linearly filtered.
+          bool vol_mag_filter_is_fetch_const =
+              instr.attributes.vol_mag_filter == xenos::TextureFilter::kUseFetchConst;
+          bool vol_min_filter_is_fetch_const =
+              instr.attributes.vol_min_filter == xenos::TextureFilter::kUseFetchConst;
+          bool vol_mag_filter_is_linear =
+              instr.attributes.vol_mag_filter == xenos::TextureFilter::kLinear;
+          bool vol_min_filter_is_linear =
+              instr.attributes.vol_min_filter == xenos::TextureFilter::kLinear;
+          ValueId vol_filter_is_linear = kNoValue;
+          ValueId const_uint_0 = b.ConstUint(0);
+          if (use_computed_lod && (vol_mag_filter_is_fetch_const || vol_min_filter_is_fetch_const ||
+                                   vol_mag_filter_is_linear != vol_min_filter_is_linear)) {
+            // Minifying along the layers (a derivative over 1 along any axis)?
+            ValueId layer_max_gradient =
+                b.Binary(Op::kNMax, b.Extract(gradients_h, 2), b.Extract(gradients_v, 2));
+            if (!instr.attributes.unnormalized_coordinates) {
+              layer_max_gradient = b.Binary(Op::kFMul, layer_max_gradient, size[2]);
+            }
+            // NaN: magnifying.
+            ValueId is_minifying_z =
+                b.Compare(Op::kFOrdLessThan, layer_max_gradient, b.ConstFloat(1.0f));
+            ValueId vol_mag_filter_is_linear_loaded =
+                vol_mag_filter_is_fetch_const
+                    ? b.Compare(Op::kINotEqual,
+                                b.Binary(Op::kBitwiseAnd, fetch_constant_word_4, b.ConstUint(1)),
+                                const_uint_0)
+                    : b.ConstBool(vol_mag_filter_is_linear);
+            ValueId vol_min_filter_is_linear_loaded =
+                vol_min_filter_is_fetch_const
+                    ? b.Compare(Op::kINotEqual,
+                                b.Binary(Op::kBitwiseAnd, fetch_constant_word_4, b.ConstUint(2)),
+                                const_uint_0)
+                    : b.ConstBool(vol_min_filter_is_linear);
+            vol_filter_is_linear = b.Select(is_minifying_z, vol_min_filter_is_linear_loaded,
+                                            vol_mag_filter_is_linear_loaded);
+          } else if (vol_mag_filter_is_fetch_const) {
+            // No gradients, or the same filter for both: assume magnifying.
+            vol_filter_is_linear = b.Compare(
+                Op::kINotEqual, b.Binary(Op::kBitwiseAnd, fetch_constant_word_4, b.ConstUint(1)),
+                const_uint_0);
+          }
+          ValueId layer_coordinate = coordinates[2];
+          // With linear filtering, 0.5 is in the middle of the first layer.
+          if (vol_filter_is_linear != kNoValue) {
+            layer_coordinate = b.Select(
+                vol_filter_is_linear, b.Binary(Op::kFSub, layer_coordinate, b.ConstFloat(0.5f)),
+                layer_coordinate);
+          } else if (vol_mag_filter_is_linear) {
+            layer_coordinate = b.Binary(Op::kFSub, layer_coordinate, b.ConstFloat(0.5f));
+          }
+          // The first layer, floored like a 3D texture address.
+          ValueId layer_0_coordinate = b.Unary(Op::kFloor, layer_coordinate);
+          SampleTexture(mode, TextureDimension::k2DArray,
+                        b.Construct(kFloat3, {coordinates[0], coordinates[1], layer_0_coordinate}),
+                        stacked_gradient_x, stacked_gradient_y, texture_2d_array_or_cube_unsigned,
+                        texture_2d_array_or_cube_signed, sampler_index, is_any_unsigned,
+                        is_any_signed, sample_result_unsigned_stacked,
+                        sample_result_signed_stacked);
+          // The second layer and the filtering if linear filtering may be needed.
+          if (vol_filter_is_linear != kNoValue || vol_mag_filter_is_linear) {
+            std::optional<Builder::If> if_z_linear;
+            if (vol_filter_is_linear != kNoValue) {
+              if_z_linear.emplace(b, vol_filter_is_linear);
+            }
+            ValueId layer_1_coordinate =
+                b.Binary(Op::kFAdd, layer_0_coordinate, b.ConstFloat(1.0f));
+            ValueId layer_lerp_factor = b.Unary(Op::kFract, layer_coordinate);
+            ValueId filtered_unsigned, filtered_signed;
+            SampleTexture(mode, TextureDimension::k2DArray,
+                          b.Construct(kFloat3, {coordinates[0], coordinates[1], layer_1_coordinate}),
+                          stacked_gradient_x, stacked_gradient_y,
+                          texture_2d_array_or_cube_unsigned, texture_2d_array_or_cube_signed,
+                          sampler_index, is_any_unsigned, is_any_signed, filtered_unsigned,
+                          filtered_signed, layer_lerp_factor, sample_result_unsigned_stacked,
+                          sample_result_signed_stacked);
+            if (if_z_linear) {
+              if_z_linear->End();
+              sample_result_unsigned_stacked =
+                  if_z_linear->MergePhi(filtered_unsigned, sample_result_unsigned_stacked);
+              sample_result_signed_stacked =
+                  if_z_linear->MergePhi(filtered_signed, sample_result_signed_stacked);
+            } else {
+              sample_result_unsigned_stacked = filtered_unsigned;
+              sample_result_signed_stacked = filtered_signed;
+            }
+          }
+        }
+        if_data_is_3d.End();
+        sample_result_unsigned =
+            if_data_is_3d.MergePhi(sample_result_unsigned_3d, sample_result_unsigned_stacked);
+        sample_result_signed =
+            if_data_is_3d.MergePhi(sample_result_signed_3d, sample_result_signed_stacked);
+      } else {
+        SampleTexture(mode,
+                      instr.dimension == xenos::FetchOpDimension::kCube ? TextureDimension::kCube
+                                                                         : TextureDimension::k2DArray,
+                      b.Construct(kFloat3, {coordinates[0], coordinates[1], coordinates[2]}),
+                      lod_or_gradient_x, gradient_y, texture_2d_array_or_cube_unsigned,
+                      texture_2d_array_or_cube_signed, sampler_index, is_any_unsigned,
+                      is_any_signed, sample_result_unsigned, sample_result_signed);
+      }
+
+      // The signedness of each component: signed from the signed view, unsigned biased to
+      // -1...1, gamma to linear; the view format swizzle is done by the host texture views.
+      ValueId const_float_2 = b.ConstFloat(2.0f);
+      ValueId const_float_minus_1 = b.ConstFloat(-1.0f);
+      {
+        uint32_t result_remaining_components = used_result_nonzero_components;
+        uint32_t result_component_index;
+        while (rex::bit_scan_forward(result_remaining_components, &result_component_index)) {
+          result_remaining_components &= ~(UINT32_C(1) << result_component_index);
+          ValueId component_unsigned = b.Extract(sample_result_unsigned, result_component_index);
+          Builder::Switch sign_switch(b, swizzled_signs[result_component_index]);
+          sign_switch.BeginCase(int32_t(xenos::TextureSign::kSigned));
+          ValueId component_signed = b.Extract(sample_result_signed, result_component_index);
+          sign_switch.BeginCase(int32_t(xenos::TextureSign::kUnsignedBiased));
+          ValueId component_unsigned_biased =
+              b.Binary(Op::kFAdd, b.Binary(Op::kFMul, component_unsigned, const_float_2),
+                       const_float_minus_1);
+          sign_switch.BeginCase(int32_t(xenos::TextureSign::kGamma));
+          ValueId component_gamma = PWLGammaToLinear(component_unsigned, false);
+          sign_switch.BeginDefault();
+          sign_switch.End();
+          result[result_component_index] = sign_switch.MergePhi(
+              {component_signed, component_unsigned_biased, component_gamma, component_unsigned});
+        }
+      }
+
+      // The exponent bias in bits 13:18 of the word 4.
+      ValueId result_exponent_bias = b.Emit(
+          Op::kLdexp, kFloat,
+          {b.ConstFloat(1.0f), b.Emit(Op::kBitFieldSExtract, kInt,
+                                      {fetch_constant_word_4_signed, b.ConstUint(13),
+                                       b.ConstUint(6)})});
+      {
+        uint32_t result_remaining_components = used_result_nonzero_components;
+        uint32_t result_component_index;
+        while (rex::bit_scan_forward(result_remaining_components, &result_component_index)) {
+          result_remaining_components &= ~(UINT32_C(1) << result_component_index);
+          result[result_component_index] =
+              b.Binary(Op::kFMul, result[result_component_index], result_exponent_bias);
+        }
+      }
+    }
+  }
+
+  // Store the needed components of the result.
+  std::vector<ValueId> components;
+  uint32_t result_components_remaining = used_result_components;
+  uint32_t result_component_index;
+  while (rex::bit_scan_forward(result_components_remaining, &result_component_index)) {
+    result_components_remaining &= ~(UINT32_C(1) << result_component_index);
+    components.push_back(result[result_component_index]);
+  }
+  StoreResult(instr.result, b.Construct(kFloat.WithComponents(used_result_component_count),
+                                        components));
+}
