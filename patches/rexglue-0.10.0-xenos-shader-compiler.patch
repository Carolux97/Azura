diff --git a/src/graphics/pipeline/shader/xsc/xsc_translator_ps.cpp b/src/graphics/pipeline/shader/xsc/xsc_translator_ps.cpp
new file mode 100644
index 0000000..4549386
--- /dev/null
+++ b/src/graphics/pipeline/shader/xsc/xsc_translator_ps.cpp
@@ -0,0 +1,432 @@
+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_translator_ps.cpp
+ * @brief       Xenos shader compiler: pixel shader prologue and epilogue, gamma conversions
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The host render target path of the SPIR-V translator (spirv_translator.cpp
+ * StartFragmentShaderInMain, spirv_translator_rb.cpp CompleteFragmentShaderInMain): interpolators
+ * copied to registers, the pixel parameters, then the alpha test, alpha to coverage, the color
+ * exponent bias and the Xenos piecewise linear gamma for render targets with gamma.
+ */
+
+#include <limits>
+
+#include <rex/assert.h>
+#include <rex/math.h>
+
+#include "xsc_translator.h"
+
+namespace rex::graphics::xsc {
+
+using SystemConstants = SpirvShaderTranslator::SystemConstants;
+
+void XscShaderTranslator::StartFragmentShaderInMain() {
+  Builder& b = *builder_;
+  const Shader& shader = current_shader();
+  Modification modification = GetModification();
+  FragmentInterface& fragment = program_->fragment;
+
+  uint32_t param_gen_interpolator = GetPsParamGenInterpolator();
+  bool param_gen_needed = param_gen_interpolator != UINT32_MAX;
+
+  // Interpolators, in input location order.
+  uint32_t interpolator_mask = modification.pixel.interpolator_mask;
+  {
+    uint32_t interpolators_remaining = interpolator_mask;
+    uint32_t interpolator_index;
+    while (rex::bit_scan_forward(interpolators_remaining, &interpolator_index)) {
+      interpolators_remaining &= ~(UINT32_C(1) << interpolator_index);
+      fragment.interpolators.push_back(interpolator_index);
+    }
+  }
+  fragment.interpolators_centroid = modification.pixel.interpolators_centroid;
+  if (modification.pixel.param_gen_point && param_gen_needed) {
+    fragment.point_coord = true;
+  }
+
+  bool alpha_to_coverage_possible = shader.writes_color_target(0) && !IsEarlyFragmentTests();
+  fragment.early_fragment_tests = IsEarlyFragmentTests();
+  fragment.frag_coord = param_gen_needed || alpha_to_coverage_possible;
+  fragment.front_facing = param_gen_needed && !modification.pixel.param_gen_point;
+  fragment.color_targets = shader.writes_color_targets();
+  fragment.depth = shader.writes_depth();
+  // The coverage output for alpha to coverage needs sample rate shading (always on Metal).
+  fragment.sample_mask = alpha_to_coverage_possible && features_.sample_rate_shading;
+
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (fragment.color_targets & (1u << i)) {
+      var_color_[i] = b.CreateVariable(kFloat4, "", 0, Storage::kOutputColor, i);
+    }
+  }
+  if (fragment.depth) {
+    var_depth_ = b.CreateVariable(kFloat, "", 0, Storage::kOutputDepth);
+  }
+  if (fragment.sample_mask) {
+    var_sample_mask_ = b.CreateVariable(kInt, "", 0, Storage::kOutputSampleMask);
+  }
+
+  if (fragment.frag_coord) {
+    frag_coord_ = b.Emit(Op::kLoadFragCoord, kFloat4, {});
+  }
+  if (fragment.front_facing) {
+    front_facing_ = b.Emit(Op::kLoadFrontFacing, kBool, {});
+  }
+
+  // Zero the registers (games may read registers they only initialize conditionally), and copy
+  // the interpolators.
+  for (uint32_t i = 0; i < register_count(); ++i) {
+    if (i == param_gen_interpolator) {
+      continue;
+    }
+    ValueId value;
+    if (i < xenos::kMaxInterpolators && (interpolator_mask & (UINT32_C(1) << i))) {
+      uint32_t location = rex::bit_count(interpolator_mask & ((UINT32_C(1) << i) - 1));
+      value = b.Emit(Op::kLoadInterpolator, kFloat4, {},
+                     {location, (fragment.interpolators_centroid >> i) & 1});
+    } else {
+      value = b.ConstFloat(0.0f, 4);
+    }
+    b.Store(var_registers_, value, kNoValue, i);
+  }
+
+  // The pixel parameters.
+  if (param_gen_needed) {
+    ValueId const_sign_bit = b.ConstUint(UINT32_C(1) << 31);
+    // X: pixel X .0 in the magnitude, back-facing in the sign bit.
+    ValueId param_gen_x = b.Unary(Op::kFloor, b.Extract(frag_coord_, 0));
+    uint32_t param_gen_scale_x = draw_resolution_scale_x_ << modification.pixel.sample_space_x_log2;
+    if (param_gen_scale_x > 1) {
+      param_gen_x =
+          b.Binary(Op::kFMul, param_gen_x, b.ConstFloat(1.0f / float(param_gen_scale_x)));
+    }
+    param_gen_x = b.Unary(Op::kFAbs, param_gen_x);
+    if (!modification.pixel.param_gen_point) {
+      ValueId not_polygonal = b.Compare(
+          Op::kIEqual,
+          b.Binary(Op::kBitwiseAnd, system_constant_flags_,
+                   b.ConstUint(SpirvShaderTranslator::kSysFlag_PrimitivePolygonal)),
+          b.ConstUint(0));
+      param_gen_x = b.Select(
+          b.Emit(Op::kLogicalOr, kBool, {not_polygonal, front_facing_}), param_gen_x,
+          b.Emit(Op::kBitcast, kFloat,
+                 {b.Binary(Op::kBitwiseXor, b.Emit(Op::kBitcast, kUint, {param_gen_x}),
+                           const_sign_bit)}));
+    }
+    // Y: pixel Y .0 in the magnitude, point in the sign bit.
+    ValueId param_gen_y = b.Unary(Op::kFloor, b.Extract(frag_coord_, 1));
+    uint32_t param_gen_scale_y = draw_resolution_scale_y_ << modification.pixel.sample_space_y_log2;
+    if (param_gen_scale_y > 1) {
+      param_gen_y =
+          b.Binary(Op::kFMul, param_gen_y, b.ConstFloat(1.0f / float(param_gen_scale_y)));
+    }
+    param_gen_y = b.Unary(Op::kFAbs, param_gen_y);
+    if (modification.pixel.param_gen_point) {
+      param_gen_y = b.Emit(Op::kBitcast, kFloat,
+                           {b.Binary(Op::kBitwiseXor, b.Emit(Op::kBitcast, kUint, {param_gen_y}),
+                                     const_sign_bit)});
+    }
+    // Z: point S in the magnitude, line in the sign bit; W: point T in the magnitude.
+    ValueId param_gen_z, param_gen_w;
+    if (modification.pixel.param_gen_point) {
+      // Saturated against extrapolation when the center of the pixel is not covered.
+      ValueId point_coordinates =
+          b.Emit(Op::kNClamp, kFloat2,
+                 {b.Emit(Op::kLoadPointCoord, kFloat2, {}), b.ConstFloat(0.0f, 2),
+                  b.ConstFloat(1.0f, 2)});
+      param_gen_z = b.Extract(point_coordinates, 0);
+      param_gen_w = b.Extract(point_coordinates, 1);
+    } else {
+      param_gen_z = b.Emit(
+          Op::kBitcast, kFloat,
+          {b.Select(b.Compare(Op::kINotEqual,
+                              b.Binary(Op::kBitwiseAnd, system_constant_flags_,
+                                       b.ConstUint(SpirvShaderTranslator::kSysFlag_PrimitiveLine)),
+                              b.ConstUint(0)),
+                    const_sign_bit, b.ConstUint(0))});
+      param_gen_w = b.ConstFloat(0.0f);
+    }
+    b.Store(var_registers_, b.Construct(kFloat4, {param_gen_x, param_gen_y, param_gen_z, param_gen_w}),
+            kNoValue, param_gen_interpolator);
+  }
+
+  // Initialize the outputs for safety (and deterministic depth if oDepth is not written on a
+  // path).
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (var_color_[i]) {
+      b.Store(var_color_[i], b.ConstFloat(0.0f, 4));
+    }
+  }
+  if (var_depth_) {
+    b.Store(var_depth_, b.ConstFloat(0.0f));
+  }
+}
+
+void XscShaderTranslator::CompleteFragmentShaderInMain() {
+  Builder& b = *builder_;
+  const Shader& shader = current_shader();
+  uint32_t color_targets_written = shader.writes_color_targets();
+
+  if ((color_targets_written & 0b1) && !IsEarlyFragmentTests()) {
+    if (var_sample_mask_) {
+      // Full coverage if alpha to coverage is disabled.
+      b.Store(var_sample_mask_, b.Emit(Op::kBitcast, kInt, {b.ConstUint(UINT32_MAX)}));
+    }
+
+    // Alpha test: less, equal and greater bits of the comparison function.
+    ValueId alpha_test_function =
+        b.Emit(Op::kBitFieldUExtract, kUint,
+               {system_constant_flags_,
+                b.ConstUint(SpirvShaderTranslator::kSysFlag_AlphaPassIfLess_Shift),
+                b.ConstUint(3)});
+    // "Always" should pass even for NaN, unlike "less, equal or greater".
+    Builder::If if_alpha_test_non_always(
+        b, b.Compare(Op::kINotEqual, alpha_test_function,
+                     b.ConstUint(uint32_t(xenos::CompareFunction::kAlways))));
+    {
+      ValueId alpha_test_alpha = b.Extract(b.Load(var_color_[0]), 3);
+      ValueId alpha_test_reference =
+          LoadSystemConstantFloat(offsetof(SystemConstants, alpha_test_reference));
+      // "Not equal" is true for NaN, unlike "less or greater".
+      Builder::If if_not_equal(
+          b, b.Compare(Op::kIEqual, alpha_test_function,
+                       b.ConstUint(uint32_t(xenos::CompareFunction::kNotEqual))),
+          2);
+      ValueId result_not_equal =
+          b.Compare(Op::kFUnordNotEqual, alpha_test_alpha, alpha_test_reference);
+      if_not_equal.BeginElse();
+      static const Op kAlphaTestOps[] = {Op::kFOrdLessThan, Op::kFOrdEqual, Op::kFOrdGreaterThan};
+      ValueId result_non_not_equal = kNoValue;
+      for (uint32_t i = 0; i < 3; ++i) {
+        ValueId comparison_result = b.Emit(
+            Op::kLogicalAnd, kBool,
+            {b.Compare(kAlphaTestOps[i], alpha_test_alpha, alpha_test_reference),
+             b.Compare(Op::kINotEqual,
+                       b.Binary(Op::kBitwiseAnd, alpha_test_function, b.ConstUint(UINT32_C(1) << i)),
+                       b.ConstUint(0))});
+        result_non_not_equal =
+            i ? b.Emit(Op::kLogicalOr, kBool, {result_non_not_equal, comparison_result})
+              : comparison_result;
+      }
+      if_not_equal.End();
+      ValueId alpha_test_result = if_not_equal.MergePhi(result_not_equal, result_non_not_equal);
+      // Discard if failed.
+      Builder::If alpha_test_kill_if(b, b.Unary(Op::kLogicalNot, alpha_test_result));
+      b.Kill();
+      alpha_test_kill_if.End();
+    }
+    if_alpha_test_non_always.End();
+
+    // Alpha to coverage.
+    if (var_sample_mask_) {
+      ValueId alpha_to_mask = LoadSystemConstantWord(offsetof(SystemConstants, alpha_to_mask));
+      Builder::If if_alpha_to_coverage(b, b.Compare(Op::kINotEqual, alpha_to_mask, b.ConstUint(0)));
+      {
+        ValueId alpha = b.Extract(b.Load(var_color_[0]), 3);
+        ValueId const_uint_1 = b.ConstUint(1);
+        ValueId const_uint_2 = b.ConstUint(2);
+        ValueId position_x = b.Emit(Op::kConvertFToU, kUint, {b.Extract(frag_coord_, 0)});
+        ValueId position_y = b.Emit(Op::kConvertFToU, kUint, {b.Extract(frag_coord_, 1)});
+        ValueId offset = b.Emit(
+            Op::kBitFieldUExtract, kUint,
+            {alpha_to_mask,
+             b.Binary(Op::kShiftLeftLogical,
+                      b.Binary(Op::kBitwiseOr, b.Binary(Op::kBitwiseAnd, position_x, const_uint_1),
+                               b.Binary(Op::kShiftLeftLogical,
+                                        b.Binary(Op::kBitwiseAnd, position_y, const_uint_1),
+                                        const_uint_1)),
+                      const_uint_1),
+             const_uint_2});
+        ValueId offset_float = b.Emit(Op::kConvertUToF, kFloat, {offset});
+        ValueId msaa_samples = b.Emit(
+            Op::kBitFieldUExtract, kUint,
+            {system_constant_flags_, b.ConstUint(SpirvShaderTranslator::kSysFlag_MsaaSamples_Shift),
+             b.ConstUint(xenos::kMsaaSamplesBits)});
+        auto apply_sample = [&](ValueId sample_mask, uint32_t host_sample_index,
+                                float threshold_base, float threshold_offset_scale) {
+          ValueId threshold =
+              b.Binary(Op::kFSub, b.ConstFloat(threshold_base),
+                       b.Binary(Op::kFMul, offset_float, b.ConstFloat(threshold_offset_scale)));
+          ValueId covered = b.Compare(Op::kFOrdGreaterThanEqual, alpha, threshold);
+          return b.Select(covered,
+                          b.Binary(Op::kBitwiseOr, sample_mask,
+                                   b.ConstUint(UINT32_C(1) << host_sample_index)),
+                          sample_mask);
+        };
+        ValueId const_uint_0 = b.ConstUint(0);
+        Builder::Switch msaa_switch(b, msaa_samples);
+        msaa_switch.BeginCase(int32_t(xenos::MsaaSamples::k2X));
+        // Guest top and bottom to host samples 1 and 0 with native 2x MSAA, to 0 and 3 in the 4x
+        // fallback.
+        uint32_t host_sample_top = native_2x_msaa_with_attachments_ ? 1 : 0;
+        uint32_t host_sample_bottom = native_2x_msaa_with_attachments_ ? 0 : 3;
+        ValueId mask_2x = apply_sample(const_uint_0, host_sample_top, 0.5f, 1.0f / 8.0f);
+        mask_2x = apply_sample(mask_2x, host_sample_bottom, 1.0f, 1.0f / 8.0f);
+        msaa_switch.BeginCase(int32_t(xenos::MsaaSamples::k4X));
+        // Guest TL, BL, TR, BR to host TL, TR, BL, BR.
+        ValueId mask_4x = apply_sample(const_uint_0, 0, 0.75f, 1.0f / 16.0f);
+        mask_4x = apply_sample(mask_4x, 2, 0.25f, 1.0f / 16.0f);
+        mask_4x = apply_sample(mask_4x, 1, 0.5f, 1.0f / 16.0f);
+        mask_4x = apply_sample(mask_4x, 3, 1.0f, 1.0f / 16.0f);
+        // 1x is the default.
+        msaa_switch.BeginDefault();
+        ValueId mask_1x = apply_sample(const_uint_0, 0, 1.0f, 1.0f / 4.0f);
+        msaa_switch.End();
+        ValueId coverage_mask = msaa_switch.MergePhi({mask_2x, mask_4x, mask_1x});
+        Builder::If coverage_kill_if(b, b.Compare(Op::kIEqual, coverage_mask, const_uint_0));
+        b.Kill();
+        coverage_kill_if.End();
+        b.Store(var_sample_mask_, b.Emit(Op::kBitcast, kInt, {coverage_mask}));
+      }
+      if_alpha_to_coverage.End();
+    }
+  }
+
+  // The exponent bias after the alpha tests (which need the unbiased alpha), the gamma conversion
+  // (done after blending on the Xbox 360, here before, like the D3D12 backend), and the clamp to
+  // the range of a 7e3 render target.
+  uint32_t color_targets_remaining = color_targets_written;
+  uint32_t color_target_index;
+  while (rex::bit_scan_forward(color_targets_remaining, &color_target_index)) {
+    color_targets_remaining &= ~(UINT32_C(1) << color_target_index);
+    ValueId color = b.Load(var_color_[color_target_index]);
+    color = b.Emit(Op::kVectorTimesScalar, kFloat4,
+                   {color, LoadSystemConstantFloat(offsetof(SystemConstants, color_exp_bias) +
+                                                   sizeof(float) * color_target_index)});
+    ValueId color_rgb = b.Swizzle(color, {0, 1, 2});
+    ValueId is_gamma = b.Compare(
+        Op::kINotEqual,
+        b.Binary(Op::kBitwiseAnd, system_constant_flags_,
+                 b.ConstUint(SpirvShaderTranslator::kSysFlag_ConvertColor0ToGamma
+                             << color_target_index)),
+        b.ConstUint(0));
+    Builder::If if_gamma(b, is_gamma);
+    ValueId color_rgb_gamma = LinearToPWLGamma(color_rgb, false);
+    if_gamma.End();
+    color_rgb = if_gamma.MergePhi(color_rgb_gamma, color_rgb);
+    color = b.Emit(Op::kShuffle, kFloat4, {color_rgb, color}, {0, 1, 2, 3 + 3});
+    ValueId is_7e3 = IsColorTarget7e3(color_target_index);
+    if (debug_color_range_) {
+      color = PaintColorOutOfRange(color, is_7e3);
+    }
+    // The Xbox 360 converts the color to the 7e3 format (RGB in [0, 31.875], NaN as 0, and a
+    // fixed-point alpha) before blending, but the host render target is float16 and would keep
+    // negative and larger values, which later passes such as bloom turn into bright flashes. Only
+    // the source color can be clamped here: the host blending result is not.
+    color = b.Select(is_7e3,
+                     b.Emit(Op::kNClamp, kFloat4,
+                            {color, b.ConstFloat(0.0f, 4),
+                             b.ConstFloats({31.875f, 31.875f, 31.875f, 1.0f})}),
+                     color);
+    b.Store(var_color_[color_target_index], color);
+  }
+}
+
+ValueId XscShaderTranslator::IsColorTarget7e3(uint32_t color_target_index) {
+  Builder& b = *builder_;
+  ValueId format = b.Emit(
+      Op::kBitFieldUExtract, kUint,
+      {LoadSystemConstantWord(offsetof(SystemConstants, edram_rt_format_flags) +
+                              sizeof(uint32_t) * color_target_index),
+       b.ConstUint(0), b.ConstUint(xenos::kColorRenderTargetFormatBits)});
+  return b.Emit(
+      Op::kLogicalOr, kBool,
+      {b.Compare(Op::kIEqual, format,
+                 b.ConstUint(uint32_t(xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT))),
+       b.Compare(Op::kIEqual, format,
+                 b.ConstUint(uint32_t(
+                     xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT_AS_16_16_16_16)))});
+}
+
+ValueId XscShaderTranslator::PaintColorOutOfRange(ValueId color, ValueId is_7e3) {
+  Builder& b = *builder_;
+  // NaN (the only value not equal to itself) or infinity in any component.
+  ValueId is_nan = b.Emit(Op::kAny, kBool, {b.Compare(Op::kFUnordNotEqual, color, color)});
+  ValueId is_infinity =
+      b.Emit(Op::kAny, kBool,
+             {b.Compare(Op::kFOrdEqual, b.Unary(Op::kFAbs, color),
+                        b.Smear(b.ConstFloat(std::numeric_limits<float>::infinity()), 4))});
+  ValueId is_non_finite = b.Emit(Op::kLogicalOr, kBool, {is_nan, is_infinity});
+  // A 7e3 render target holds RGB in [0, 31.875] on the Xbox 360 but is a float16 one on the host,
+  // which keeps negative and larger values.
+  ValueId color_rgb = b.Swizzle(color, {0, 1, 2});
+  ValueId is_above_7e3 = b.Emit(
+      Op::kLogicalAnd, kBool,
+      {is_7e3, b.Emit(Op::kAny, kBool,
+                      {b.Compare(Op::kFOrdGreaterThan, color_rgb, b.ConstFloat(31.875f, 3))})});
+  ValueId is_negative_7e3 = b.Emit(
+      Op::kLogicalAnd, kBool,
+      {is_7e3, b.Emit(Op::kAny, kBool,
+                      {b.Compare(Op::kFOrdLessThan, color_rgb, b.ConstFloat(0.0f, 3))})});
+  // Per-shader pixel counts for the log of MetalCommandProcessor (kDebugCounter* order).
+  if (program_->debug_counter_slot != UINT32_MAX) {
+    b.EmitVoid(Op::kDebugCount, {is_non_finite}, {kDebugCounterNonFinite});
+    b.EmitVoid(Op::kDebugCount, {is_above_7e3}, {kDebugCounterAbove7e3});
+    b.EmitVoid(Op::kDebugCount, {is_negative_7e3}, {kDebugCounterNegative7e3});
+    b.EmitVoid(Op::kDebugCount, {is_7e3}, {kDebugCounter7e3});
+  }
+  // Magenta for NaN or infinity, cyan above the 7e3 range, yellow below it.
+  return b.Select(
+      is_non_finite, b.ConstFloats({1.0f, 0.0f, 1.0f, 1.0f}),
+      b.Select(is_above_7e3, b.ConstFloats({0.0f, 1.0f, 1.0f, 1.0f}),
+               b.Select(is_negative_7e3, b.ConstFloats({1.0f, 1.0f, 0.0f, 1.0f}), color)));
+}
+
+ValueId XscShaderTranslator::PWLGammaToLinear(ValueId gamma, bool gamma_pre_saturated) {
+  Builder& b = *builder_;
+  uint8_t n = b.TypeOf(gamma).components;
+  bool is_vector = n > 1;
+  auto c = [&](float value) { return b.ConstFloat(value, n); };
+  if (!gamma_pre_saturated) {
+    // Saturate, flushing NaN to 0.
+    gamma = b.Emit(Op::kNClamp, b.TypeOf(gamma), {gamma, c(0.0f), c(1.0f)});
+  }
+  ValueId is_piece_at_least_3 = b.Compare(Op::kFOrdGreaterThanEqual, gamma, c(192.0f / 255.0f));
+  ValueId scale_3_or_2 = b.Select(is_piece_at_least_3, c(8.0f / 1024.0f), c(4.0f / 1024.0f));
+  ValueId offset_3_or_2 = b.Select(is_piece_at_least_3, c(-1024.0f), c(-256.0f));
+  ValueId is_piece_at_least_1 = b.Compare(Op::kFOrdGreaterThanEqual, gamma, c(64.0f / 255.0f));
+  ValueId scale_1_or_0 = b.Select(is_piece_at_least_1, c(2.0f / 1024.0f), c(1.0f / 1024.0f));
+  ValueId offset_1_or_0 = b.Select(is_piece_at_least_1, c(-64.0f), c(0.0f));
+  ValueId is_piece_at_least_2 = b.Compare(Op::kFOrdGreaterThanEqual, gamma, c(96.0f / 255.0f));
+  ValueId scale = b.Select(is_piece_at_least_2, scale_3_or_2, scale_1_or_0);
+  ValueId offset = b.Select(is_piece_at_least_2, offset_3_or_2, offset_1_or_0);
+  Op times_scalar = is_vector ? Op::kVectorTimesScalar : Op::kFMul;
+  // linear = gamma * (255.0f * 1024.0f) * scale + offset
+  ValueId linear = b.Binary(
+      Op::kFAdd,
+      b.Binary(Op::kFMul, b.Emit(times_scalar, b.TypeOf(gamma), {gamma, b.ConstFloat(255.0f * 1024.0f)}),
+               scale),
+      offset);
+  // linear += trunc(linear * scale)
+  linear = b.Binary(Op::kFAdd, linear, b.Unary(Op::kTrunc, b.Binary(Op::kFMul, linear, scale)));
+  // linear *= 1.0f / 1023.0f
+  return b.Emit(times_scalar, b.TypeOf(linear), {linear, b.ConstFloat(1.0f / 1023.0f)});
+}
+
+ValueId XscShaderTranslator::LinearToPWLGamma(ValueId linear, bool linear_pre_saturated) {
+  Builder& b = *builder_;
+  uint8_t n = b.TypeOf(linear).components;
+  bool is_vector = n > 1;
+  auto c = [&](float value) { return b.ConstFloat(value, n); };
+  if (!linear_pre_saturated) {
+    linear = b.Emit(Op::kNClamp, b.TypeOf(linear), {linear, c(0.0f), c(1.0f)});
+  }
+  ValueId is_piece_at_least_3 = b.Compare(Op::kFOrdGreaterThanEqual, linear, c(512.0f / 1023.0f));
+  ValueId scale_3_or_2 = b.Select(is_piece_at_least_3, c(1023.0f / 8.0f), c(1023.0f / 4.0f));
+  ValueId offset_3_or_2 = b.Select(is_piece_at_least_3, c(128.0f / 255.0f), c(64.0f / 255.0f));
+  ValueId is_piece_at_least_1 = b.Compare(Op::kFOrdGreaterThanEqual, linear, c(64.0f / 1023.0f));
+  ValueId scale_1_or_0 = b.Select(is_piece_at_least_1, c(1023.0f / 2.0f), c(1023.0f));
+  ValueId offset_1_or_0 = b.Select(is_piece_at_least_1, c(32.0f / 255.0f), c(0.0f));
+  ValueId is_piece_at_least_2 = b.Compare(Op::kFOrdGreaterThanEqual, linear, c(128.0f / 1023.0f));
+  ValueId scale = b.Select(is_piece_at_least_2, scale_3_or_2, scale_1_or_0);
+  ValueId offset = b.Select(is_piece_at_least_2, offset_3_or_2, offset_1_or_0);
+  // gamma = trunc(linear * scale) * (1.0f / 255.0f) + offset
+  return b.Binary(
+      Op::kFAdd,
+      b.Emit(is_vector ? Op::kVectorTimesScalar : Op::kFMul, b.TypeOf(linear),
+             {b.Unary(Op::kTrunc, b.Binary(Op::kFMul, linear, scale)), b.ConstFloat(1.0f / 255.0f)}),
+      offset);
+}
