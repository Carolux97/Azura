+  void SampleTexture(TextureSampleMode mode, TextureDimension dimension, ValueId coordinates,
+                     ValueId lod_or_gradient_x, ValueId gradient_y, size_t texture_unsigned,
+                     size_t texture_signed, size_t sampler, ValueId is_any_unsigned,
