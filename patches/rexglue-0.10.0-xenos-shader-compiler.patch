+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_translator_alu.cpp
+ * @brief       Xenos shader compiler: ALU instructions
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The vector and the scalar operation of an instruction read their operands before either
+ * result is stored. Multiplications follow Shader Model 3 (+-0 times anything, including infinity
+ * and NaN, is +0); max, min and the comparisons keep the a op b ? a : b NaN behaviour, as in the
+ * SPIR-V translator (spirv_translator_alu.cpp).
+ */
+
+#include <cfloat>
+#include <cmath>
+
+#include <rex/assert.h>
+#include <rex/math.h>
+
+#include "xsc_translator.h"
+
+namespace rex::graphics::xsc {
+
+void XscShaderTranslator::KillPixel(ValueId condition) {
+  // Demote to a helper invocation: the pixel is discarded, derivatives keep working. Without
+  // demote (some Vulkan devices), the pixel stops like with the SPIR-V translator.
+  Builder::If kill_if(*builder_, condition);
+  if (target_ == Target::kSpirv && !features_.demote_to_helper_invocation) {
+    builder_->Kill();
+  } else {
+    builder_->EmitVoid(Op::kDemote);
+  }
+  kill_if.End();
+}
+
+void XscShaderTranslator::ProcessAluInstruction(const ParsedAluInstruction& instr,
+                                                uint8_t memexport_eM_potentially_written_before) {
+  if (instr.IsNop()) {
+    return;
+  }
+  Builder& b = *builder_;
+
+  UpdateInstructionPredication(instr.is_predicated, instr.predicate_condition);
+
+  bool predicate_written_vector = false;
+  ValueId vector_result = ProcessVectorAluOperation(instr, predicate_written_vector);
+  bool predicate_written_scalar = false;
+  ValueId scalar_result = ProcessScalarAluOperation(instr, predicate_written_scalar);
+  if (scalar_result != kNoValue) {
+    b.Store(var_previous_scalar_, scalar_result);
+  } else if (instr.scalar_result.GetUsedWriteMask()) {
+    // retain_prev: load ps only if it's written somewhere.
+    scalar_result = b.Load(var_previous_scalar_);
+  }
+
+  StoreResult(instr.vector_and_constant_result, vector_result);
+  StoreResult(instr.scalar_result, scalar_result);
+
+  if (predicate_written_vector || predicate_written_scalar) {
+    cf_exec_predicate_written_ = true;
+    CloseInstructionPredication();
+  }
+}
+
+ValueId XscShaderTranslator::ProcessVectorAluOperation(const ParsedAluInstruction& instr,
+                                                       bool& predicate_written) {
+  Builder& b = *builder_;
+  predicate_written = false;
+
+  uint32_t used_result_components = instr.vector_and_constant_result.GetUsedResultComponents();
+  if (!used_result_components &&
+      !ucode::GetAluVectorOpcodeInfo(instr.vector_opcode).changed_state) {
+    return kNoValue;
+  }
+  uint8_t used_result_component_count = uint8_t(rex::bit_count(used_result_components));
+
+  // Operands of cube are the same, but swizzled.
+  uint32_t operand_count = instr.vector_opcode == ucode::AluVectorOpcode::kCube
+                               ? 1
+                               : instr.vector_operand_count;
+  ValueId operand_storage[3] = {};
+  for (uint32_t i = 0; i < operand_count; ++i) {
+    operand_storage[i] = LoadOperandStorage(instr.vector_operands[i]);
+  }
+  Type result_type = kFloat.WithComponents(used_result_component_count);
+
+  // Comparison for each opcode with the select-based semantics.
+  auto comparison_op = [](ucode::AluVectorOpcode opcode) -> Op {
+    switch (opcode) {
+      case ucode::AluVectorOpcode::kMax:
+      case ucode::AluVectorOpcode::kSge:
+      case ucode::AluVectorOpcode::kCndGe:
+      case ucode::AluVectorOpcode::kSetpGePush:
+      case ucode::AluVectorOpcode::kKillGe:
+      case ucode::AluVectorOpcode::kMaxA:
+        return Op::kFOrdGreaterThanEqual;
+      case ucode::AluVectorOpcode::kMin:
+        return Op::kFOrdLessThan;
+      case ucode::AluVectorOpcode::kSeq:
+      case ucode::AluVectorOpcode::kCndEq:
+      case ucode::AluVectorOpcode::kSetpEqPush:
+      case ucode::AluVectorOpcode::kKillEq:
+        return Op::kFOrdEqual;
+      case ucode::AluVectorOpcode::kSgt:
+      case ucode::AluVectorOpcode::kCndGt:
+      case ucode::AluVectorOpcode::kSetpGtPush:
+      case ucode::AluVectorOpcode::kKillGt:
+        return Op::kFOrdGreaterThan;
+      case ucode::AluVectorOpcode::kSne:
+      case ucode::AluVectorOpcode::kSetpNePush:
+      case ucode::AluVectorOpcode::kKillNe:
+        return Op::kFUnordNotEqual;
+      default:
+        return Op::kFOrdEqual;
+    }
+  };
+
+  switch (instr.vector_opcode) {
+    case ucode::AluVectorOpcode::kAdd:
+      return b.Emit(Op::kFAdd, result_type,
+                    {GetOperandComponents(operand_storage[0], instr.vector_operands[0],
+                                          used_result_components),
+                     GetOperandComponents(operand_storage[1], instr.vector_operands[1],
+                                          used_result_components)});
+
+    case ucode::AluVectorOpcode::kMul:
+    case ucode::AluVectorOpcode::kMad: {
+      ValueId multiplicands[2];
+      for (uint32_t i = 0; i < 2; ++i) {
+        multiplicands[i] = GetOperandComponents(operand_storage[i], instr.vector_operands[i],
+                                                used_result_components);
+      }
+      ValueId result = b.Emit(Op::kFMul, result_type, {multiplicands[0], multiplicands[1]});
+      uint32_t multiplicands_different =
+          used_result_components &
+          ~instr.vector_operands[0].GetIdenticalComponents(instr.vector_operands[1]);
+      if (multiplicands_different) {
+        // Shader Model 3: +0 or denormal * anything = +-0.
+        ValueId different_operands[2] = {multiplicands[0], multiplicands[1]};
+        ValueId different_result = result;
+        uint8_t different_count = uint8_t(rex::bit_count(multiplicands_different));
+        std::vector<uint32_t> different_indices;
+        if (multiplicands_different != used_result_components) {
+          uint32_t components_remaining = used_result_components;
+          for (uint32_t i = 0; i < used_result_component_count; ++i) {
+            uint32_t component;
+            rex::bit_scan_forward(components_remaining, &component);
+            components_remaining &= ~(uint32_t(1) << component);
+            if (multiplicands_different & (1 << component)) {
+              different_indices.push_back(i);
+            }
+          }
+          for (uint32_t i = 0; i < 2; ++i) {
+            different_operands[i] = b.Swizzle(different_operands[i], different_indices);
+          }
+          different_result = b.Swizzle(different_result, different_indices);
+        }
+        // Zero if min(|a|, |b|) is 0, even if the other is NaN.
+        for (uint32_t i = 0; i < 2; ++i) {
+          different_operands[i] = GetAbsoluteOperand(different_operands[i], instr.vector_operands[i]);
+        }
+        ValueId zero = b.ConstFloat(0.0f, different_count);
+        ValueId different_zero = b.Compare(
+            Op::kFOrdEqual, b.Binary(Op::kNMin, different_operands[0], different_operands[1]), zero);
+        different_result = b.Select(different_zero, zero, different_result);
+        if (multiplicands_different != used_result_components) {
+          if (different_count > 1) {
+            std::array<uint32_t, 4> indices = {};
+            uint32_t components_remaining = used_result_components;
+            uint32_t different_shuffle_index = used_result_component_count;
+            for (uint32_t i = 0; i < used_result_component_count; ++i) {
+              uint32_t component;
+              rex::bit_scan_forward(components_remaining, &component);
+              components_remaining &= ~(uint32_t(1) << component);
+              indices[i] =
+                  (multiplicands_different & (1 << component)) ? different_shuffle_index++ : i;
+            }
+            result = b.Emit(Op::kShuffle, result_type, {result, different_result}, indices);
+          } else {
+            result = b.Emit(
+                Op::kInsert, result_type, {result, different_result},
+                {uint32_t(rex::bit_count(used_result_components & (multiplicands_different - 1)))});
+          }
+        } else {
+          result = different_result;
+        }
+      }
+      if (instr.vector_opcode == ucode::AluVectorOpcode::kMad) {
+        // Not replacing `0 + term` with the term because +0 + -0 must be +0.
+        result = b.Emit(Op::kFAdd, result_type,
+                        {result, GetOperandComponents(operand_storage[2], instr.vector_operands[2],
+                                                      used_result_components)});
+      }
+      return result;
+    }
+
+    case ucode::AluVectorOpcode::kMax:
+    case ucode::AluVectorOpcode::kMin:
+    case ucode::AluVectorOpcode::kMaxA: {
+      bool is_maxa = instr.vector_opcode == ucode::AluVectorOpcode::kMaxA;
+      ValueId operand_0 =
+          GetOperandComponents(operand_storage[0], instr.vector_operands[0],
+                               used_result_components | (is_maxa ? 0b1000 : 0b0000));
+      ValueId maxa_operand_0_w = kNoValue;
+      if (is_maxa) {
+        // a0 = (int)clamp(floor(src0.w + 0.5), -256.0, 255.0)
+        uint32_t operand_0_num_components = b.TypeOf(operand_0).components;
+        maxa_operand_0_w = operand_0_num_components > 1
+                               ? b.Extract(operand_0, operand_0_num_components - 1)
+                               : operand_0;
+        b.Store(var_address_register_,
+                b.Emit(Op::kConvertFToS, kInt,
+                       {b.Emit(Op::kNClamp, kFloat,
+                               {b.Unary(Op::kFloor,
+                                        b.Binary(Op::kFAdd, maxa_operand_0_w, b.ConstFloat(0.5f))),
+                                b.ConstFloat(-256.0f), b.ConstFloat(255.0f)})}));
+      }
+      if (!used_result_components) {
+        // maxa returning nothing - can't load src1.
+        return kNoValue;
+      }
+      // max is commonly used as mov.
+      uint32_t identical =
+          instr.vector_operands[0].GetIdenticalComponents(instr.vector_operands[1]) &
+          used_result_components;
+      ValueId operand_0_per_component;
+      if (is_maxa && !(used_result_components & 0b1000) &&
+          (identical == used_result_components || !identical)) {
+        // src0.w was only loaded for a0: drop it.
+        if (used_result_component_count > 1) {
+          std::vector<uint32_t> indices;
+          for (uint32_t i = 0; i < used_result_component_count; ++i) {
+            indices.push_back(i);
+          }
+          operand_0_per_component = b.Swizzle(operand_0, indices);
+        } else {
+          operand_0_per_component = b.Extract(operand_0, 0);
+        }
+      } else {
+        operand_0_per_component = operand_0;
+      }
+      if (identical == used_result_components) {
+        return operand_0_per_component;
+      }
+      ValueId operand_1 = GetOperandComponents(operand_storage[1], instr.vector_operands[1],
+                                               used_result_components);
+      Op op = comparison_op(instr.vector_opcode);
+      if (!identical) {
+        return b.Select(b.Compare(op, operand_0_per_component, operand_1), operand_0_per_component,
+                        operand_1);
+      }
+      // Mixed identical and different components.
+      std::vector<ValueId> components;
+      uint32_t components_remaining = used_result_components;
+      for (uint32_t i = 0; i < used_result_component_count; ++i) {
+        ValueId result_component =
+            ((used_result_components & 0b1000) && i + 1 >= used_result_component_count &&
+             maxa_operand_0_w != kNoValue)
+                ? maxa_operand_0_w
+                : b.Extract(operand_0, i);
+        uint32_t component_index;
+        rex::bit_scan_forward(components_remaining, &component_index);
+        components_remaining &= ~(uint32_t(1) << component_index);
+        if (!(identical & (1 << component_index))) {
+          ValueId operand_1_component = b.Extract(operand_1, i);
+          result_component = b.Select(b.Compare(op, result_component, operand_1_component),
+                                      result_component, operand_1_component);
+        }
+        components.push_back(result_component);
+      }
+      return b.Construct(result_type, components);
+    }
+
+    case ucode::AluVectorOpcode::kSeq:
+    case ucode::AluVectorOpcode::kSgt:
+    case ucode::AluVectorOpcode::kSge:
+    case ucode::AluVectorOpcode::kSne:
+      return b.Select(
+          b.Compare(comparison_op(instr.vector_opcode),
+                    GetOperandComponents(operand_storage[0], instr.vector_operands[0],
+                                         used_result_components),
+                    GetOperandComponents(operand_storage[1], instr.vector_operands[1],
+                                         used_result_components)),
+          b.ConstFloat(1.0f, used_result_component_count),
+          b.ConstFloat(0.0f, used_result_component_count));
+
+    case ucode::AluVectorOpcode::kFrc:
+    case ucode::AluVectorOpcode::kTrunc:
+    case ucode::AluVectorOpcode::kFloor: {
+      Op op = instr.vector_opcode == ucode::AluVectorOpcode::kFrc
+                  ? Op::kFract
+                  : (instr.vector_opcode == ucode::AluVectorOpcode::kTrunc ? Op::kTrunc
+                                                                            : Op::kFloor);
+      return b.Emit(op, result_type,
+                    {GetOperandComponents(operand_storage[0], instr.vector_operands[0],
+                                          used_result_components)});
+    }
+
+    case ucode::AluVectorOpcode::kCndEq:
+    case ucode::AluVectorOpcode::kCndGe:
+    case ucode::AluVectorOpcode::kCndGt:
+      return b.Select(
+          b.Compare(comparison_op(instr.vector_opcode),
+                    GetOperandComponents(operand_storage[0], instr.vector_operands[0],
+                                         used_result_components),
+                    b.ConstFloat(0.0f, used_result_component_count)),
+          GetOperandComponents(operand_storage[1], instr.vector_operands[1],
+                               used_result_components),
+          GetOperandComponents(operand_storage[2], instr.vector_operands[2],
+                               used_result_components));
+
+    case ucode::AluVectorOpcode::kDp4:
+    case ucode::AluVectorOpcode::kDp3:
+    case ucode::AluVectorOpcode::kDp2Add: {
+      // Not a dot product instruction, for a predictable order of the additions.
+      uint32_t component_count = instr.vector_opcode == ucode::AluVectorOpcode::kDp2Add
+                                     ? 2
+                                     : (instr.vector_opcode == ucode::AluVectorOpcode::kDp3 ? 3 : 4);
+      uint32_t component_mask = (1 << component_count) - 1;
+      ValueId operands[2];
+      for (uint32_t i = 0; i < 2; ++i) {
+        operands[i] =
+            GetOperandComponents(operand_storage[i], instr.vector_operands[i], component_mask);
+      }
+      uint32_t different = component_mask & ~instr.vector_operands[0].GetIdenticalComponents(
+                                                instr.vector_operands[1]);
+      ValueId result = kNoValue;
+      for (uint32_t i = 0; i < component_count; ++i) {
+        ValueId operand_components[2] = {b.Extract(operands[0], i), b.Extract(operands[1], i)};
+        ValueId product = b.Binary(Op::kFMul, operand_components[0], operand_components[1]);
+        if (different & (1 << i)) {
+          product = ZeroIfAnyOperandIsZero(
+              product, GetAbsoluteOperand(operand_components[0], instr.vector_operands[0]),
+              GetAbsoluteOperand(operand_components[1], instr.vector_operands[1]));
+        }
+        result = i ? b.Binary(Op::kFAdd, result, product) : product;
+      }
+      if (instr.vector_opcode == ucode::AluVectorOpcode::kDp2Add) {
+        result = b.Binary(Op::kFAdd, result,
+                          GetOperandComponents(operand_storage[2], instr.vector_operands[2], 0b0001));
+      }
+      return result;
+    }
+
+    case ucode::AluVectorOpcode::kCube: {
+      // operands[0] is .z_xy. The result is T, S, 2 * major axis, face ID.
+      ValueId operand_vector =
+          GetOperandComponents(operand_storage[0], instr.vector_operands[0], 0b1101);
+      // Remapped from ZXY to XYZ.
+      ValueId operand[3];
+      for (uint32_t i = 0; i < 3; ++i) {
+        operand[i] = b.Extract(operand_vector, (i + 1) % 3);
+      }
+      ValueId operand_abs[3];
+      bool abs_needed =
+          !instr.vector_operands[0].is_absolute_value || instr.vector_operands[0].is_negated;
+      for (uint32_t i = 0; i < 3; ++i) {
+        operand_abs[i] = abs_needed ? b.Unary(Op::kFAbs, operand[i]) : operand[i];
+      }
+      ValueId operand_neg[3] = {};
+      if (used_result_components & 0b0001) {
+        operand_neg[1] = b.Unary(Op::kFNeg, operand[1]);
+      }
+      if (used_result_components & 0b0010) {
+        operand_neg[0] = b.Unary(Op::kFNeg, operand[0]);
+        operand_neg[2] = b.Unary(Op::kFNeg, operand[2]);
+      }
+      ValueId zero = b.ConstFloat(0.0f);
+
+      ValueId ma_z_result[4] = {}, ma_yx_result[4] = {};
+      // Is the major axis Z (abs(z) >= abs(x) && abs(z) >= abs(y))?
+      Builder::If ma_z_if(
+          b, b.Emit(Op::kLogicalAnd, kBool,
+                    {b.Compare(Op::kFOrdGreaterThanEqual, operand_abs[2], operand_abs[0]),
+                     b.Compare(Op::kFOrdGreaterThanEqual, operand_abs[2], operand_abs[1])}));
+      {
+        // tc = -y, ma/2 = z.
+        ma_z_result[0] = operand_neg[1];
+        ma_z_result[2] = operand[2];
+        if (used_result_components & 0b1010) {
+          ValueId z_is_neg = b.Compare(Op::kFOrdLessThan, operand[2], zero);
+          if (used_result_components & 0b0010) {
+            // sc = z < 0.0 ? -x : x
+            ma_z_result[1] = b.Select(z_is_neg, operand_neg[0], operand[0]);
+          }
+          if (used_result_components & 0b1000) {
+            // id = z < 0.0 ? 5.0 : 4.0
+            ma_z_result[3] = b.Select(z_is_neg, b.ConstFloat(5.0f), b.ConstFloat(4.0f));
+          }
+        }
+      }
+      ma_z_if.BeginElse();
+      {
+        ValueId ma_y_result[4] = {}, ma_x_result[4] = {};
+        // Is the major axis Y (abs(y) >= abs(x))?
+        Builder::If ma_y_if(b, b.Compare(Op::kFOrdGreaterThanEqual, operand_abs[1], operand_abs[0]));
+        {
+          // sc = x, ma/2 = y.
+          ma_y_result[1] = operand[0];
+          ma_y_result[2] = operand[1];
+          if (used_result_components & 0b1001) {
+            ValueId y_is_neg = b.Compare(Op::kFOrdLessThan, operand[1], zero);
+            if (used_result_components & 0b0001) {
+              // tc = y < 0.0 ? -z : z, id = y < 0.0 ? 3.0 : 2.0
+              ma_y_result[0] = b.Select(y_is_neg, operand_neg[2], operand[2]);
+              ma_y_result[3] = b.Select(y_is_neg, b.ConstFloat(3.0f), b.ConstFloat(2.0f));
+            }
+          }
+        }
+        ma_y_if.BeginElse();
+        {
+          // The major axis is X: tc = -y, ma/2 = x.
+          ma_x_result[0] = operand_neg[1];
+          ma_x_result[2] = operand[0];
+          if (used_result_components & 0b1010) {
+            ValueId x_is_neg = b.Compare(Op::kFOrdLessThan, operand[0], zero);
+            if (used_result_components & 0b0010) {
+              // sc = x < 0.0 ? z : -z
+              ma_x_result[1] = b.Select(x_is_neg, operand[2], operand_neg[2]);
+            }
+            if (used_result_components & 0b1000) {
+              // id = x < 0.0 ? 1.0 : 0.0
+              ma_x_result[3] = b.Select(x_is_neg, b.ConstFloat(1.0f), zero);
+            }
+          }
+        }
+        ma_y_if.End();
+        for (uint32_t i = 0; i < 4; ++i) {
+          if (!(used_result_components & (1 << i))) {
+            continue;
+          }
+          // The SPIR-V translator leaves the face ID of the Y case undefined when only W is used;
+          // it is only computed with X.
+          ValueId y_value = ma_y_result[i] != kNoValue ? ma_y_result[i] : zero;
+          ValueId x_value = ma_x_result[i] != kNoValue ? ma_x_result[i] : zero;
+          ma_yx_result[i] = ma_y_if.MergePhi(y_value, x_value);
+        }
+      }
+      ma_z_if.End();
+      std::vector<ValueId> components;
+      for (uint32_t i = 0; i < 4; ++i) {
+        if (!(used_result_components & (1 << i))) {
+          continue;
+        }
+        ValueId z_value = ma_z_result[i] != kNoValue ? ma_z_result[i] : zero;
+        components.push_back(ma_z_if.MergePhi(z_value, ma_yx_result[i]));
+      }
+      if (used_result_components & 0b0100) {
+        // Multiply the major axis by 2.
+        ValueId& ma2 = components[rex::bit_count(used_result_components & ((1 << 2) - 1))];
+        ma2 = b.Binary(Op::kFMul, b.ConstFloat(2.0f), ma2);
+      }
+      return b.Construct(result_type, components);
+    }
+
+    case ucode::AluVectorOpcode::kMax4: {
+      // The max of the different components of the first operand, with NMax (no defined NaN
+      // order).
+      uint32_t components_remaining = 0b0000;
+      for (uint32_t i = 0; i < 4; ++i) {
+        SwizzleSource swizzle_source = instr.vector_operands[0].GetComponent(i);
+        components_remaining |= 1 << (uint32_t(swizzle_source) - uint32_t(SwizzleSource::kX));
+      }
+      ValueId operand = ApplyOperandModifiers(operand_storage[0], instr.vector_operands[0]);
+      uint32_t component;
+      rex::bit_scan_forward(components_remaining, &component);
+      components_remaining &= ~(uint32_t(1) << component);
+      ValueId result = b.Extract(operand, component);
+      while (rex::bit_scan_forward(components_remaining, &component)) {
+        components_remaining &= ~(uint32_t(1) << component);
+        result = b.Binary(Op::kNMax, result, b.Extract(operand, component));
+      }
+      return result;
+    }
+
+    case ucode::AluVectorOpcode::kSetpEqPush:
+    case ucode::AluVectorOpcode::kSetpNePush:
+    case ucode::AluVectorOpcode::kSetpGtPush:
+    case ucode::AluVectorOpcode::kSetpGePush: {
+      // X is only needed for the result, W for the predicate.
+      ValueId operands[2];
+      ValueId operands_w[2];
+      for (uint32_t i = 0; i < 2; ++i) {
+        operands[i] = GetOperandComponents(operand_storage[i], instr.vector_operands[i],
+                                           used_result_components ? 0b1001 : 0b1000);
+        operands_w[i] = used_result_components ? b.Extract(operands[i], 1) : operands[i];
+      }
+      Op op = comparison_op(instr.vector_opcode);
+      ValueId zero = b.ConstFloat(0.0f);
+      // p0 = src0.w == 0.0 && src1.w op 0.0
+      b.Store(var_predicate_, b.Emit(Op::kLogicalAnd, kBool,
+                                     {b.Compare(Op::kFOrdEqual, operands_w[0], zero),
+                                      b.Compare(op, operands_w[1], zero)}));
+      predicate_written = true;
+      if (!used_result_components) {
+        return kNoValue;
+      }
+      // result = ((src0.x == 0.0 && src1.x op 0.0) ? -1.0 : src0.x) + 1.0
+      ValueId operands_x[2] = {b.Extract(operands[0], 0), b.Extract(operands[1], 0)};
+      ValueId condition = b.Emit(Op::kLogicalAnd, kBool,
+                                 {b.Compare(Op::kFOrdEqual, operands_x[0], zero),
+                                  b.Compare(op, operands_x[1], zero)});
+      return b.Binary(Op::kFAdd, b.Select(condition, b.ConstFloat(-1.0f), operands_x[0]),
+                      b.ConstFloat(1.0f));
+    }
+
+    case ucode::AluVectorOpcode::kKillEq:
+    case ucode::AluVectorOpcode::kKillGt:
+    case ucode::AluVectorOpcode::kKillGe:
+    case ucode::AluVectorOpcode::kKillNe: {
+      KillPixel(b.Emit(
+          Op::kAny, kBool,
+          {b.Compare(comparison_op(instr.vector_opcode),
+                     GetOperandComponents(operand_storage[0], instr.vector_operands[0], 0b1111),
+                     GetOperandComponents(operand_storage[1], instr.vector_operands[1], 0b1111))}));
+      return b.ConstFloat(0.0f);
+    }
+
+    case ucode::AluVectorOpcode::kDst: {
+      ValueId operands[2] = {};
+      if (used_result_components & 0b0110) {
+        operands[0] = GetOperandComponents(operand_storage[0], instr.vector_operands[0],
+                                           used_result_components & 0b0110);
+      }
+      if (used_result_components & 0b1010) {
+        operands[1] = GetOperandComponents(operand_storage[1], instr.vector_operands[1],
+                                           used_result_components & 0b1010);
+      }
+      // y = src0.y * src1.y
+      ValueId result_y = kNoValue;
+      if (used_result_components & 0b0010) {
+        ValueId operands_y[2];
+        operands_y[0] =
+            (used_result_components & 0b0100) ? b.Extract(operands[0], 0) : operands[0];
+        operands_y[1] =
+            (used_result_components & 0b1000) ? b.Extract(operands[1], 0) : operands[1];
+        result_y = b.Binary(Op::kFMul, operands_y[0], operands_y[1]);
+        if (!(instr.vector_operands[0].GetIdenticalComponents(instr.vector_operands[1]) & 0b0010)) {
+          result_y = ZeroIfAnyOperandIsZero(
+              result_y, GetAbsoluteOperand(operands_y[0], instr.vector_operands[0]),
+              GetAbsoluteOperand(operands_y[1], instr.vector_operands[1]));
+        }
+      }
+      std::vector<ValueId> components;
+      if (used_result_components & 0b0001) {
+        // x = 1.0
+        components.push_back(b.ConstFloat(1.0f));
+      }
+      if (used_result_components & 0b0010) {
+        components.push_back(result_y);
+      }
+      if (used_result_components & 0b0100) {
+        // z = src0.z
+        components.push_back((used_result_components & 0b0010) ? b.Extract(operands[0], 1)
+                                                                : operands[0]);
+      }
+      if (used_result_components & 0b1000) {
+        // w = src1.w
+        components.push_back((used_result_components & 0b0010) ? b.Extract(operands[1], 1)
+                                                                : operands[1]);
+      }
+      return b.Construct(result_type, components);
+    }
+  }
+
+  Unsupported("an unknown ALU vector operation");
+  return kNoValue;
+}
+
+ValueId XscShaderTranslator::ProcessScalarAluOperation(const ParsedAluInstruction& instr,
+                                                       bool& predicate_written) {
+  Builder& b = *builder_;
+  predicate_written = false;
+
+  ValueId operand_storage[2] = {};
+  for (uint32_t i = 0; i < instr.scalar_operand_count; ++i) {
+    operand_storage[i] = LoadOperandStorage(instr.scalar_operands[i]);
+  }
+  ValueId zero = b.ConstFloat(0.0f);
+  ValueId one = b.ConstFloat(1.0f);
+  auto operand_x = [&](uint32_t index) {
+    return GetOperandComponents(operand_storage[index], instr.scalar_operands[index], 0b0001);
+  };
+
+  switch (instr.scalar_opcode) {
+    case ucode::AluScalarOpcode::kAdds:
+    case ucode::AluScalarOpcode::kSubs: {
+      ValueId a, c;
+      GetOperandScalarXY(operand_storage[0], instr.scalar_operands[0], a, c);
+      return b.Binary(instr.scalar_opcode == ucode::AluScalarOpcode::kAdds ? Op::kFAdd : Op::kFSub,
+                      a, c);
+    }
+    case ucode::AluScalarOpcode::kAddsPrev:
+    case ucode::AluScalarOpcode::kSubsPrev:
+      return b.Binary(
+          instr.scalar_opcode == ucode::AluScalarOpcode::kAddsPrev ? Op::kFAdd : Op::kFSub,
+          operand_x(0), b.Load(var_previous_scalar_));
+    case ucode::AluScalarOpcode::kMuls: {
+      ValueId a, c;
+      GetOperandScalarXY(operand_storage[0], instr.scalar_operands[0], a, c);
+      ValueId result = b.Binary(Op::kFMul, a, c);
+      if (a != c) {
+        result = ZeroIfAnyOperandIsZero(result, GetAbsoluteOperand(a, instr.scalar_operands[0]),
+                                        GetAbsoluteOperand(c, instr.scalar_operands[0]));
+      }
+      return result;
+    }
+    case ucode::AluScalarOpcode::kMulsPrev: {
+      ValueId a = operand_x(0);
+      ValueId ps = b.Load(var_previous_scalar_);
+      ValueId result = b.Binary(Op::kFMul, a, ps);
+      return ZeroIfAnyOperandIsZero(result, GetAbsoluteOperand(a, instr.scalar_operands[0]),
+                                    b.Unary(Op::kFAbs, ps));
+    }
+    case ucode::AluScalarOpcode::kMulsPrev2: {
+      // src0.a * ps if ps != -FLT_MAX, ps and src0.b are finite and src0.b > 0, else -FLT_MAX.
+      ValueId ps = b.Load(var_previous_scalar_);
+      ValueId const_float_max_neg = b.ConstFloat(-FLT_MAX);
+      ValueId condition = b.Compare(Op::kFUnordNotEqual, ps, const_float_max_neg);
+      ValueId ps_abs = b.Unary(Op::kFAbs, ps);
+      ValueId ps_abs_neg = b.Unary(Op::kFNeg, ps_abs);
+      condition = b.Emit(Op::kLogicalAnd, kBool,
+                         {condition, b.Compare(Op::kFOrdGreaterThanEqual, ps_abs_neg,
+                                               const_float_max_neg)});
+      ValueId c = GetOperandComponents(operand_storage[0], instr.scalar_operands[0], 0b0010);
+      ValueId c_abs_neg = c;
+      if (!instr.scalar_operands[0].is_absolute_value) {
+        c_abs_neg = b.Unary(Op::kFAbs, c_abs_neg);
+      }
+      if (!instr.scalar_operands[0].is_absolute_value || !instr.scalar_operands[0].is_negated) {
+        c_abs_neg = b.Unary(Op::kFNeg, c_abs_neg);
+      }
+      condition = b.Emit(Op::kLogicalAnd, kBool,
+                         {condition, b.Compare(Op::kFOrdGreaterThanEqual, c_abs_neg,
+                                               const_float_max_neg)});
+      condition = b.Emit(Op::kLogicalAnd, kBool,
+                         {condition, b.Compare(Op::kFOrdGreaterThan, c, zero)});
+      Builder::If multiply_if(b, condition);
+      ValueId product;
+      {
+        ValueId a = instr.scalar_operands[0].GetComponent(0) !=
+                            instr.scalar_operands[0].GetComponent(1)
+                        ? operand_x(0)
+                        : c;
+        product = b.Binary(Op::kFMul, a, ps);
+        product =
+            ZeroIfAnyOperandIsZero(product, GetAbsoluteOperand(a, instr.scalar_operands[0]), ps_abs);
+      }
+      multiply_if.End();
+      return multiply_if.MergePhi(product, const_float_max_neg);
+    }
+
+    case ucode::AluScalarOpcode::kMaxs:
+    case ucode::AluScalarOpcode::kMins:
+    case ucode::AluScalarOpcode::kMaxAs:
+    case ucode::AluScalarOpcode::kMaxAsf: {
+      ValueId a, c;
+      GetOperandScalarXY(operand_storage[0], instr.scalar_operands[0], a, c);
+      if (instr.scalar_opcode == ucode::AluScalarOpcode::kMaxAs ||
+          instr.scalar_opcode == ucode::AluScalarOpcode::kMaxAsf) {
+        // maxas: a0 = (int)clamp(floor(src0.a + 0.5), -256.0, 255.0)
+        // maxasf: a0 = (int)clamp(floor(src0.a), -256.0, 255.0)
+        ValueId maxa_address = instr.scalar_opcode == ucode::AluScalarOpcode::kMaxAs
+                                   ? b.Binary(Op::kFAdd, a, b.ConstFloat(0.5f))
+                                   : a;
+        b.Store(var_address_register_,
+                b.Emit(Op::kConvertFToS, kInt,
+                       {b.Emit(Op::kNClamp, kFloat,
+                               {b.Unary(Op::kFloor, maxa_address), b.ConstFloat(-256.0f),
+                                b.ConstFloat(255.0f)})}));
+      }
+      if (a == c) {
+        // max is commonly used as mov.
+        return a;
+      }
+      Op op = instr.scalar_opcode == ucode::AluScalarOpcode::kMins ? Op::kFOrdLessThan
+                                                                   : Op::kFOrdGreaterThanEqual;
+      return b.Select(b.Compare(op, a, c), a, c);
+    }
+
+    case ucode::AluScalarOpcode::kSeqs:
+    case ucode::AluScalarOpcode::kSgts:
+    case ucode::AluScalarOpcode::kSges:
+    case ucode::AluScalarOpcode::kSnes: {
+      Op op;
+      switch (instr.scalar_opcode) {
+        case ucode::AluScalarOpcode::kSeqs:
+          op = Op::kFOrdEqual;
+          break;
+        case ucode::AluScalarOpcode::kSgts:
+          op = Op::kFOrdGreaterThan;
+          break;
+        case ucode::AluScalarOpcode::kSges:
+          op = Op::kFOrdGreaterThanEqual;
+          break;
+        default:
+          op = Op::kFUnordNotEqual;
+      }
+      return b.Select(b.Compare(op, operand_x(0), zero), one, zero);
+    }
+
+    case ucode::AluScalarOpcode::kFrcs:
+      return b.Unary(Op::kFract, operand_x(0));
+    case ucode::AluScalarOpcode::kTruncs:
+      return b.Unary(Op::kTrunc, operand_x(0));
+    case ucode::AluScalarOpcode::kFloors:
+      return b.Unary(Op::kFloor, operand_x(0));
+    case ucode::AluScalarOpcode::kExp:
+      return b.Unary(Op::kExp2, operand_x(0));
+    case ucode::AluScalarOpcode::kLog:
+      return b.Unary(Op::kLog2, operand_x(0));
+    case ucode::AluScalarOpcode::kRsq:
+      return b.Unary(Op::kInverseSqrt, operand_x(0));
+    case ucode::AluScalarOpcode::kSqrt:
+      return b.Unary(Op::kSqrt, operand_x(0));
+    case ucode::AluScalarOpcode::kSin:
+      return b.Unary(Op::kSin, operand_x(0));
+    case ucode::AluScalarOpcode::kCos:
+      return b.Unary(Op::kCos, operand_x(0));
+    case ucode::AluScalarOpcode::kLogc: {
+      ValueId result = b.Unary(Op::kLog2, operand_x(0));
+      return b.Select(b.Compare(Op::kFOrdEqual, result, b.ConstFloat(-INFINITY)),
+                      b.ConstFloat(-FLT_MAX), result);
+    }
+    case ucode::AluScalarOpcode::kRcpc:
+    case ucode::AluScalarOpcode::kRsqc: {
+      ValueId result = instr.scalar_opcode == ucode::AluScalarOpcode::kRcpc
+                           ? b.Binary(Op::kFDiv, one, operand_x(0))
+                           : b.Unary(Op::kInverseSqrt, operand_x(0));
+      result = b.Select(b.Compare(Op::kFOrdEqual, result, b.ConstFloat(-INFINITY)),
+                        b.ConstFloat(-FLT_MAX), result);
+      return b.Select(b.Compare(Op::kFOrdEqual, result, b.ConstFloat(INFINITY)),
+                      b.ConstFloat(FLT_MAX), result);
+    }
+    case ucode::AluScalarOpcode::kRcpf:
+    case ucode::AluScalarOpcode::kRsqf: {
+      ValueId result = instr.scalar_opcode == ucode::AluScalarOpcode::kRcpf
+                           ? b.Binary(Op::kFDiv, one, operand_x(0))
+                           : b.Unary(Op::kInverseSqrt, operand_x(0));
+      result = b.Select(b.Compare(Op::kFOrdEqual, result, b.ConstFloat(INFINITY)), zero, result);
+      // -0.0 for -infinity, selected as a bit pattern.
+      ValueId bits = b.Select(b.Compare(Op::kFOrdEqual, result, b.ConstFloat(-INFINITY)),
+                              b.ConstUint(uint32_t(INT32_MIN)), b.Emit(Op::kBitcast, kUint, {result}));
+      return b.Emit(Op::kBitcast, kFloat, {bits});
+    }
+    case ucode::AluScalarOpcode::kRcp:
+      return b.Binary(Op::kFDiv, one, operand_x(0));
+
+    case ucode::AluScalarOpcode::kSetpEq:
+    case ucode::AluScalarOpcode::kSetpNe:
+    case ucode::AluScalarOpcode::kSetpGt:
+    case ucode::AluScalarOpcode::kSetpGe: {
+      Op op;
+      switch (instr.scalar_opcode) {
+        case ucode::AluScalarOpcode::kSetpEq:
+          op = Op::kFOrdEqual;
+          break;
+        case ucode::AluScalarOpcode::kSetpNe:
+          op = Op::kFUnordNotEqual;
+          break;
+        case ucode::AluScalarOpcode::kSetpGt:
+          op = Op::kFOrdGreaterThan;
+          break;
+        default:
+          op = Op::kFOrdGreaterThanEqual;
+      }
+      ValueId predicate = b.Compare(op, operand_x(0), zero);
+      b.Store(var_predicate_, predicate);
+      predicate_written = true;
+      return b.Select(predicate, zero, one);
+    }
+    case ucode::AluScalarOpcode::kSetpInv: {
+      ValueId a = operand_x(0);
+      ValueId predicate = b.Compare(Op::kFOrdEqual, a, one);
+      b.Store(var_predicate_, predicate);
+      predicate_written = true;
+      return b.Select(predicate, zero, b.Select(b.Compare(Op::kFOrdEqual, a, zero), one, a));
+    }
+    case ucode::AluScalarOpcode::kSetpPop: {
+      ValueId a_minus_1 = b.Binary(Op::kFSub, operand_x(0), one);
+      ValueId predicate = b.Compare(Op::kFOrdLessThanEqual, a_minus_1, zero);
+      b.Store(var_predicate_, predicate);
+      predicate_written = true;
+      return b.Select(predicate, zero, a_minus_1);
+    }
+    case ucode::AluScalarOpcode::kSetpClr:
+      b.Store(var_predicate_, b.ConstBool(false));
+      return b.ConstFloat(FLT_MAX);
+    case ucode::AluScalarOpcode::kSetpRstr: {
+      ValueId a = operand_x(0);
+      ValueId predicate = b.Compare(Op::kFOrdEqual, a, zero);
+      b.Store(var_predicate_, predicate);
+      predicate_written = true;
+      return b.Select(predicate, zero, a);
+    }
+
+    case ucode::AluScalarOpcode::kKillsEq:
+    case ucode::AluScalarOpcode::kKillsGt:
+    case ucode::AluScalarOpcode::kKillsGe:
+    case ucode::AluScalarOpcode::kKillsNe:
+    case ucode::AluScalarOpcode::kKillsOne: {
+      Op op;
+      switch (instr.scalar_opcode) {
+        case ucode::AluScalarOpcode::kKillsGt:
+          op = Op::kFOrdGreaterThan;
+          break;
+        case ucode::AluScalarOpcode::kKillsGe:
+          op = Op::kFOrdGreaterThanEqual;
+          break;
+        case ucode::AluScalarOpcode::kKillsNe:
+          op = Op::kFUnordNotEqual;
+          break;
+        default:
+          op = Op::kFOrdEqual;
+      }
+      KillPixel(b.Compare(op, operand_x(0),
+                          instr.scalar_opcode == ucode::AluScalarOpcode::kKillsOne ? one : zero));
+      return zero;
+    }
+
+    case ucode::AluScalarOpcode::kMulsc0:
+    case ucode::AluScalarOpcode::kMulsc1: {
+      ValueId operand_0 = operand_x(0);
+      ValueId operand_1 = operand_x(1);
+      ValueId result = b.Binary(Op::kFMul, operand_0, operand_1);
+      if (!(instr.scalar_operands[0].GetIdenticalComponents(instr.scalar_operands[1]) & 0b0001)) {
+        result =
+            ZeroIfAnyOperandIsZero(result, GetAbsoluteOperand(operand_0, instr.scalar_operands[0]),
+                                   GetAbsoluteOperand(operand_1, instr.scalar_operands[1]));
+      }
+      return result;
+    }
+    case ucode::AluScalarOpcode::kAddsc0:
+    case ucode::AluScalarOpcode::kAddsc1:
+      return b.Binary(Op::kFAdd, operand_x(0), operand_x(1));
+    case ucode::AluScalarOpcode::kSubsc0:
+    case ucode::AluScalarOpcode::kSubsc1:
+      return b.Binary(Op::kFSub, operand_x(0), operand_x(1));
+
+    case ucode::AluScalarOpcode::kRetainPrev:
+      // Handled in ProcessAluInstruction, loading ps only if written anywhere.
+      return kNoValue;
+  }
+
+  Unsupported("an unknown ALU scalar operation");
+  return kNoValue;
+}
