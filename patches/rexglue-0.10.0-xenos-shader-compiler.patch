+/**
+ * @file        graphics/pipeline/shader/xsc/bench/xsc_bench.mm
+ * @brief       Offline bench for the Xenos shader compiler: translates the game's real shaders
+ *              with each translator, compiles them with Metal, draws them with the same generated
+ *              inputs and compares the outputs
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * Input: a corpus folder with ucode/ (dumped with dump_shaders) and msl/ (dumped with
+ * metal_shader_dump_path, whose file names give the variants the game used: shader hash and
+ * modification). Usage:
+ *   xsc-bench <corpus> [--mode translate|compare|perf] [--filter <hash>] [--limit <n>]
+ *             [--seeds <n>] [--size <pixels>] [--translators <a>,<b>]
+ * Translators: "spirv" (the SPIR-V translator and SPIRV-Cross, as the Metal backend does), "xsc"
+ * (XSC's MSL) and "xsc-spirv" (XSC's SPIR-V, converted by SPIRV-Cross like the first).
+ */
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <optional>
+#include <regex>
+#include <string>
+#include <vector>
