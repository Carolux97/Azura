+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_spirv.h
+ * @brief       SPIR-V emitter of the Xenos shader compiler
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "xsc_ir.h"
+
+namespace rex::graphics::xsc {
+
+struct SpirvOptions {
+  // The SPIR-V version of the module (SpirvShaderTranslator::Features::spirv_version).
+  unsigned int spirv_version = 0x10000;
+  // Float controls execution modes, as the SPIR-V translator requests them from the device.
+  bool signed_zero_inf_nan_preserve_float32 = false;
+  bool denorm_flush_to_zero_float32 = false;
+  bool rounding_mode_rte_float32 = false;
+  // Decorates the float arithmetic with NoContraction, so the driver cannot fuse a multiplication
+  // and an addition into one rounding (the Xenos rounds after each operation).
+  bool no_contraction = true;
+};
+
+// The SPIR-V module of a pixel shader, with the interface of the SPIR-V translator's shaders on
+// the Vulkan backend: the descriptor sets and bindings of SpirvShaderTranslator, the interpolators
+// at consecutive locations, and the entry point "main".
+std::vector<uint32_t> EmitSpirv(const Program& program, const SpirvOptions& options);
+
+}  // namespace rex::graphics::xsc
