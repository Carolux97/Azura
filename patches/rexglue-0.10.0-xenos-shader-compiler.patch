+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_translator.cpp
+ * @brief       Xenos shader compiler: translation setup, control flow, operands and results
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The rules follow the SPIR-V translator (spirv_translator.cpp), whose behaviour is the
+ * reference the offline bench compares with; where it is subtle, the comment says what the
+ * Xenos hardware or Direct3D 9 requires.
+ */
+
+#include "xsc_translator.h"
+
+#include <cstddef>
+
+#include <fmt/format.h>
+
+#include <rex/assert.h>
+#include <rex/graphics/pipeline/shader/spirv.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+
+#include "xsc_msl.h"
+#include "xsc_spirv.h"
+
+namespace rex::graphics::xsc {
+
+using SystemConstants = SpirvShaderTranslator::SystemConstants;
+
+std::string XscShaderTranslator::GetEntryPointName(const Shader& shader, uint64_t modification) {
+  std::string flags;
+  if (shader.type() == xenos::ShaderType::kPixel) {
+    if (Modification(modification).pixel.depth_stencil_mode ==
+        Modification::DepthStencilMode::kEarlyHint) {
+      flags += 'e';
+    }
+    if (shader.kills_pixels()) {
+      flags += 'k';
+    }
+    if (shader.writes_depth()) {
+      flags += 'z';
+    }
+  }
+  return fmt::format("{}_{:016x}_{:016x}{}{}_x",
+                     shader.type() == xenos::ShaderType::kVertex ? "vs" : "ps",
+                     shader.ucode_data_hash(), modification, flags.empty() ? "" : "_", flags);
+}
+
+void XscShaderTranslator::Reset() {
+  ShaderTranslator::Reset();
+  unsupported_reason_.clear();
+  program_.reset();
+  builder_.reset();
+  var_registers_ = 0;
+  var_predicate_ = 0;
+  var_loop_count_ = 0;
+  var_address_register_ = 0;
+  var_loop_address_ = 0;
+  var_previous_scalar_ = 0;
+  var_tfetch_lod_ = 0;
+  var_tfetch_gradients_h_ = 0;
+  var_tfetch_gradients_v_ = 0;
+  var_pc_ = 0;
+  var_color_.fill(0);
+  var_depth_ = 0;
+  var_sample_mask_ = 0;
+  var_vfetch_address_ = 0;
+  var_point_size_edge_flag_kill_vertex_ = 0;
+  var_interpolators_.fill(0);
+  var_position_ = 0;
+  var_point_size_ = 0;
+  var_point_coordinates_ = 0;
+  var_clip_distances_ = 0;
+  system_constant_flags_ = kNoValue;
+  frag_coord_ = kNoValue;
+  front_facing_ = kNoValue;
+  main_switch_.reset();
+  cf_exec_conditional_.reset();
+  cf_exec_bool_constant_or_predicate_ = 0;
+  cf_exec_condition_ = false;
+  cf_exec_predicate_written_ = false;
+  cf_instruction_predicate_.reset();
+  cf_instruction_predicate_condition_ = false;
+  texture_bindings_.clear();
+  sampler_bindings_.clear();
+  translated_source_.clear();
+}
+
+uint32_t XscShaderTranslator::GetModificationRegisterCount() const {
+  Modification modification = GetModification();
+  return is_vertex_shader() ? modification.vertex.dynamic_addressable_register_count
+                            : modification.pixel.dynamic_addressable_register_count;
+}
+
+void XscShaderTranslator::Unsupported(const char* what) {
+  if (unsupported_reason_.empty()) {
+    unsupported_reason_ = what;
+    RecordTranslationError(fmt::format("XSC does not support {} yet", what).c_str());
+  }
+}
+
+bool XscShaderTranslator::IsEarlyFragmentTests() const {
+  return is_pixel_shader() &&
+         GetModification().pixel.depth_stencil_mode == Modification::DepthStencilMode::kEarlyHint &&
+         current_shader().implicit_early_z_write_allowed();
+}
+
+uint32_t XscShaderTranslator::GetPsParamGenInterpolator() const {
+  Modification modification = GetModification();
+  return (modification.pixel.param_gen_enable &&
+          modification.pixel.param_gen_interpolator < register_count())
+             ? modification.pixel.param_gen_interpolator
+             : UINT32_MAX;
+}
+
+ValueId XscShaderTranslator::LoadSystemConstantWord(size_t offset_bytes) {
+  return builder_->Emit(Op::kLoadSystemConstantWord, kUint, {},
+                        {uint32_t(offset_bytes / sizeof(uint32_t))});
+}
+
+ValueId XscShaderTranslator::LoadSystemConstantFloat(size_t offset_bytes) {
+  return builder_->Emit(Op::kBitcast, kFloat, {LoadSystemConstantWord(offset_bytes)});
+}
+
+ValueId XscShaderTranslator::LoadFetchConstantWord(uint32_t fetch_constant, uint32_t word) {
+  return builder_->Emit(Op::kLoadFetchConstantWord, kUint, {}, {6 * fetch_constant + word});
+}
+
+void XscShaderTranslator::StartTranslation() {
+  program_ = std::make_unique<Program>();
+  builder_ = std::make_unique<Builder>(*program_);
+  Builder& b = *builder_;
+  const Shader& shader = current_shader();
+
+  if (shader.memexport_eM_written()) {
+    Unsupported("memory export");
+  }
+  Modification modification = GetModification();
+  if (is_vertex_shader()) {
+    // Host vertex shader types: the vertex and point sprites (4 host vertices per guest point);
+    // rectangle lists (3 guest vertices per invocation), tessellation and the memory export
+    // compute shader go to the SPIR-V translator.
+    Shader::HostVertexShaderType host_vertex_shader_type =
+        modification.vertex.host_vertex_shader_type;
+    if (host_vertex_shader_type != Shader::HostVertexShaderType::kVertex &&
+        host_vertex_shader_type != Shader::HostVertexShaderType::kPointListAsTriangleStrip) {
+      Unsupported("this host vertex shader type");
+    }
+    if (modification.GetVertexCullDistanceCount()) {
+      Unsupported("cull distances");
+    }
+    if (target_ == Target::kSpirv &&
+        SpirvShaderTranslator::GetSharedMemoryStorageBufferCountLog2(
+            features_.max_storage_buffer_range)) {
+      Unsupported("shared memory split into several storage buffers");
+    }
+  }
+  if (is_pixel_shader() &&
+      (modification.pixel.depth_stencil_mode == Modification::DepthStencilMode::kFloat24Truncating ||
+       modification.pixel.depth_stencil_mode == Modification::DepthStencilMode::kFloat24Rounding)) {
+    Unsupported("float24 depth conversion");
+  }
+
+  program_->is_pixel_shader = is_pixel_shader();
+  program_->entry_point = GetEntryPointName(shader, current_translation().modification());
+  program_->float_constant_count = std::max(shader.constant_register_map().float_count, 1u);
+  if (debug_color_range_ && is_pixel_shader() &&
+      debug_counter_shaders_.size() < kDebugCounterMaxShaders) {
+    program_->debug_counter_slot = uint32_t(debug_counter_shaders_.size()) * kDebugCountersPerShader;
+    debug_counter_shaders_.push_back(
+        {shader.ucode_data_hash(), current_translation().modification()});
+  }
+
+  // The Xenos state, initialized like the SPIR-V translator does for safety.
+  var_predicate_ = b.CreateVariable(kBool, "xe_var_predicate", 0, Storage::kFunction, 0,
+                                    b.ConstBool(false));
+  var_loop_count_ = b.CreateVariable(kUint4, "xe_var_loop_count", 0, Storage::kFunction, 0,
+                                     b.ConstUint(0, 4));
+  var_address_register_ = b.CreateVariable(kInt, "xe_var_address_register", 0,
+                                           Storage::kFunction, 0, b.ConstInt(0));
+  var_loop_address_ = b.CreateVariable(kInt4, "xe_var_loop_address", 0, Storage::kFunction, 0,
+                                       b.ConstInt(0, 4));
+  var_previous_scalar_ = b.CreateVariable(kFloat, "xe_var_previous_scalar", 0,
+                                          Storage::kFunction, 0, b.ConstFloat(0.0f));
+  var_tfetch_lod_ = b.CreateVariable(kFloat, "xe_var_tfetch_lod", 0, Storage::kFunction, 0,
+                                     b.ConstFloat(0.0f));
+  var_tfetch_gradients_h_ = b.CreateVariable(kFloat3, "xe_var_tfetch_gradients_h", 0,
+                                             Storage::kFunction, 0, b.ConstFloat(0.0f, 3));
+  var_tfetch_gradients_v_ = b.CreateVariable(kFloat3, "xe_var_tfetch_gradients_v", 0,
+                                             Storage::kFunction, 0, b.ConstFloat(0.0f, 3));
+  // The address of vfetch_full in dwords, for the following vfetch_mini.
+  var_vfetch_address_ = b.CreateVariable(kInt, "xe_var_vfetch_address", 0, Storage::kFunction, 0,
+                                         b.ConstInt(0));
+  if (register_count()) {
+    var_registers_ = b.CreateVariable(kFloat4, "xe_var_registers", register_count());
+  }
+
+  // Loaded once since many parts of the shader use it.
+  system_constant_flags_ = LoadSystemConstantWord(offsetof(SystemConstants, flags));
+
+  if (is_pixel_shader()) {
+    StartFragmentShaderInMain();
+  } else {
+    StartVertexShaderInMain();
+  }
+
+  // The main loop, with a switch over the labels if there are jumps or loops.
+  bool has_main_switch = !shader.label_addresses().empty();
+  if (has_main_switch) {
+    var_pc_ = b.CreateVariable(kInt, "xe_var_pc", 0, Storage::kFunction, 0, b.ConstInt(0));
+  }
+  b.BeginLoop();
+  if (has_main_switch) {
+    main_switch_.emplace(b, b.Load(var_pc_));
+    main_switch_->BeginCase(0, true);
+  }
+}
+
+std::vector<uint8_t> XscShaderTranslator::CompleteTranslation() {
+  Builder& b = *builder_;
+  CloseExecConditionals();
+  if (main_switch_) {
+    main_switch_->End();
+    main_switch_.reset();
+  }
+  // Leave the main loop after falling through the end or leaving the switch (only continued by
+  // jumps and loops).
+  b.Break();
+  b.EndLoop();
+
+  if (is_pixel_shader()) {
+    CompleteFragmentShaderInMain();
+  } else {
+    CompleteVertexShaderInMain();
+  }
+
+  program_->body = b.TakeBody();
+  if (!unsupported_reason_.empty()) {
+    return {};
+  }
+  for (const TextureBinding& binding : texture_bindings_) {
+    TextureBindingInfo info;
+    info.fetch_constant = binding.fetch_constant;
+    info.is_signed = binding.is_signed;
+    switch (binding.dimension) {
+      case xenos::FetchOpDimension::k3DOrStacked:
+        info.dimension = TextureDimension::k3D;
+        break;
+      case xenos::FetchOpDimension::kCube:
+        info.dimension = TextureDimension::kCube;
+        break;
+      default:
+        info.dimension = TextureDimension::k2DArray;
+    }
+    program_->textures.push_back(info);
+  }
+  program_->sampler_count = uint32_t(sampler_bindings_.size());
+
+  switch (target_) {
+    case Target::kMsl:
+      translated_source_ = EmitMsl(*program_);
+      return std::vector<uint8_t>(translated_source_.begin(), translated_source_.end());
+    case Target::kSpirv: {
+      SpirvOptions options;
+      options.spirv_version = features_.spirv_version;
+      options.signed_zero_inf_nan_preserve_float32 = features_.signed_zero_inf_nan_preserve_float32;
+      options.denorm_flush_to_zero_float32 = features_.denorm_flush_to_zero_float32;
+      options.rounding_mode_rte_float32 = features_.rounding_mode_rte_float32;
+      std::vector<uint32_t> words = EmitSpirv(*program_, options);
+      const uint8_t* bytes = reinterpret_cast<const uint8_t*>(words.data());
+      return std::vector<uint8_t>(bytes, bytes + sizeof(uint32_t) * words.size());
+    }
+  }
+  return {};
+}
+
+void XscShaderTranslator::PostTranslation() {
+  Shader::Translation& translation = current_translation();
+  if (!translation.is_valid()) {
+    if (!unsupported_reason_.empty()) {
+      REXGPU_INFO("XSC: shader {:016X} uses {}, translated by the SPIR-V translator",
+                  current_shader().ucode_data_hash(), unsupported_reason_);
+    }
+    return;
+  }
+  // The same texture and sampler bindings as the SPIR-V translator, in the same order.
+  SpirvShader* spirv_shader = dynamic_cast<SpirvShader*>(&translation.shader());
+  if (spirv_shader &&
+      !spirv_shader->bindings_setup_entered_.test_and_set(std::memory_order_relaxed)) {
+    spirv_shader->texture_bindings_.clear();
+    spirv_shader->texture_bindings_.reserve(texture_bindings_.size());
+    for (const TextureBinding& translator_binding : texture_bindings_) {
+      SpirvShader::TextureBinding& shader_binding = spirv_shader->texture_bindings_.emplace_back();
+      // For a stable hash.
+      std::memset(&shader_binding, 0, sizeof(shader_binding));
+      shader_binding.fetch_constant = translator_binding.fetch_constant;
+      shader_binding.dimension = translator_binding.dimension;
+      shader_binding.is_signed = translator_binding.is_signed;
+      spirv_shader->used_texture_mask_ |= UINT32_C(1) << translator_binding.fetch_constant;
+    }
+    spirv_shader->sampler_bindings_.clear();
+    spirv_shader->sampler_bindings_.reserve(sampler_bindings_.size());
+    for (const SamplerBinding& translator_binding : sampler_bindings_) {
+      SpirvShader::SamplerBinding& shader_binding = spirv_shader->sampler_bindings_.emplace_back();
+      shader_binding.fetch_constant = translator_binding.fetch_constant;
+      shader_binding.mag_filter = translator_binding.mag_filter;
+      shader_binding.min_filter = translator_binding.min_filter;
+      shader_binding.mip_filter = translator_binding.mip_filter;
+      shader_binding.aniso_filter = translator_binding.aniso_filter;
+    }
+  }
+}
+
+// Control flow.
+
+void XscShaderTranslator::ProcessLabel(uint32_t cf_index) {
+  if (cf_index == 0) {
+    // Case 0 is opened at the start.
+    return;
+  }
+  assert_true(main_switch_.has_value());
+  CloseExecConditionals();
+  // The previous case falls through into this one, unless it has already left (exece, jumps).
+  main_switch_->BeginCase(int32_t(cf_index), true);
+}
+
+void XscShaderTranslator::BreakFromMain() {
+  // Leaves the main switch, after which the main loop is left too; without labels, leaves the
+  // main loop directly. Guest loops are jumps, so no host loop or switch is in between.
+  builder_->Break();
+}
+
+void XscShaderTranslator::JumpToAddress(uint32_t cf_index) {
+  Builder& b = *builder_;
+  b.Store(var_pc_, b.ConstInt(int32_t(cf_index)));
+  b.Continue();
+}
+
+void XscShaderTranslator::ProcessExecInstructionBegin(const ParsedExecInstruction& instr) {
+  UpdateExecConditionals(instr.type, instr.bool_constant_index, instr.condition);
+}
+
+void XscShaderTranslator::ProcessExecInstructionEnd(const ParsedExecInstruction& instr) {
+  if (instr.is_end) {
+    CloseInstructionPredication();
+    if (!builder_->IsTerminated()) {
+      BreakFromMain();
+    }
+  }
+  UpdateExecConditionals(instr.type, instr.bool_constant_index, instr.condition);
+}
+
+void XscShaderTranslator::ProcessLoopStartInstruction(const ParsedLoopStartInstruction& instr) {
+  Builder& b = *builder_;
+  // Loop control is outside execs.
+  CloseExecConditionals();
+
+  // Count in bits 0:7 of the loop constant, the initial aL in bits 8:15.
+  ValueId loop_constant =
+      b.Emit(Op::kLoadBoolLoopConstantWord, kUint, {}, {8 + instr.loop_constant_index});
+  ValueId const_8 = b.ConstUint(8);
+
+  // Push the count to the loop count stack: XYZ to YZW, X the new count.
+  ValueId loop_count_stack_old = b.Load(var_loop_count_);
+  ValueId loop_count_new = b.Emit(Op::kBitFieldUExtract, kUint, {loop_constant, b.ConstUint(0), const_8});
+  b.Store(var_loop_count_,
+          b.Construct(kUint4, {loop_count_new, b.Extract(loop_count_stack_old, 0),
+                               b.Extract(loop_count_stack_old, 1),
+                               b.Extract(loop_count_stack_old, 2)}));
+
+  // Push aL: the previous loop's value if repeating, the new one otherwise.
+  ValueId address_relative_stack_old = b.Load(var_loop_address_);
+  ValueId address_new =
+      instr.is_repeat
+          ? b.Extract(address_relative_stack_old, 0)
+          : b.Emit(Op::kBitcast, kInt,
+                   {b.Emit(Op::kBitFieldUExtract, kUint, {loop_constant, const_8, const_8})});
+  b.Store(var_loop_address_,
+          b.Construct(kInt4, {address_new, b.Extract(address_relative_stack_old, 0),
+                              b.Extract(address_relative_stack_old, 1),
+                              b.Extract(address_relative_stack_old, 2)}));
+
+  // Skip the loop if the count is 0 (the condition is checked at the end).
+  Builder::If skip_if(b, b.Compare(Op::kIEqual, loop_count_new, b.ConstUint(0)), 2);
+  JumpToAddress(instr.loop_skip_address);
+  skip_if.End();
+}
+
+void XscShaderTranslator::ProcessLoopEndInstruction(const ParsedLoopEndInstruction& instr) {
+  Builder& b = *builder_;
+  CloseExecConditionals();
+
+  ValueId loop_count_stack_old = b.Load(var_loop_count_);
+  ValueId loop_count = b.Emit(Op::kISub, kUint, {b.Extract(loop_count_stack_old, 0), b.ConstUint(1)});
+  ValueId address_relative_stack_old = b.Load(var_loop_address_);
+
+  // Continue if (loop_count != 0), or with a predicated break, (loop_count != 0 && p0) when
+  // breaking if !p0, or break if (loop_count == 0 || p0) when breaking if p0.
+  bool break_is_true = instr.is_predicated_break && instr.predicate_condition;
+  ValueId condition =
+      b.Compare(break_is_true ? Op::kIEqual : Op::kINotEqual, loop_count, b.ConstUint(0));
+  if (instr.is_predicated_break) {
+    condition = b.Emit(instr.predicate_condition ? Op::kLogicalOr : Op::kLogicalAnd, kBool,
+                       {condition, b.Load(var_predicate_)});
+  }
+
+  Builder::If continue_if(b, condition, break_is_true ? 2 : 1);
+  auto continue_loop = [&]() {
+    // Store the count with 1 subtracted, add the step (signed, bits 16:23) to aL.
+    b.Store(var_loop_count_, b.Emit(Op::kInsert, kUint4, {loop_count_stack_old, loop_count}, {0}));
+    ValueId loop_constant =
+        b.Emit(Op::kLoadBoolLoopConstantWord, kUint, {}, {8 + instr.loop_constant_index});
+    ValueId step = b.Emit(Op::kBitFieldSExtract, kInt,
+                          {b.Emit(Op::kBitcast, kInt, {loop_constant}), b.ConstUint(16),
+                           b.ConstUint(8)});
+    b.Store(var_loop_address_,
+            b.Emit(Op::kInsert, kInt4,
+                   {address_relative_stack_old,
+                    b.Emit(Op::kIAdd, kInt, {b.Extract(address_relative_stack_old, 0), step})},
+                   {0}));
+    JumpToAddress(instr.loop_body_address);
+  };
+  auto break_loop = [&]() {
+    // Pop the loop: YZW to XYZ, W 0.
+    b.Store(var_loop_count_,
+            b.Construct(kUint4, {b.Extract(loop_count_stack_old, 1),
+                                 b.Extract(loop_count_stack_old, 2),
+                                 b.Extract(loop_count_stack_old, 3), b.ConstUint(0)}));
+    b.Store(var_loop_address_,
+            b.Construct(kInt4, {b.Extract(address_relative_stack_old, 1),
+                                b.Extract(address_relative_stack_old, 2),
+                                b.Extract(address_relative_stack_old, 3), b.ConstInt(0)}));
+  };
+  if (break_is_true) {
+    break_loop();
+    continue_if.BeginElse();
+    continue_loop();
+  } else {
+    continue_loop();
+    continue_if.BeginElse();
+    break_loop();
+  }
+  continue_if.End();
+  // Falls through to the next control flow instruction after the break.
+}
+
+void XscShaderTranslator::ProcessCallInstruction(const ParsedCallInstruction& instr) {
+  // Not implemented by the SPIR-V translator either (no call stack).
+  Unsupported("call");
+}
+
+void XscShaderTranslator::ProcessReturnInstruction(const ParsedReturnInstruction& instr) {
+  Unsupported("return");
+}
+
+void XscShaderTranslator::ProcessJumpInstruction(const ParsedJumpInstruction& instr) {
+  // Like an exec: merged with execs if possible, since it's an if too.
+  ParsedExecInstruction::Type type;
+  if (instr.type == ParsedJumpInstruction::Type::kConditional) {
+    type = ParsedExecInstruction::Type::kConditional;
+  } else if (instr.type == ParsedJumpInstruction::Type::kPredicated) {
+    type = ParsedExecInstruction::Type::kPredicated;
+  } else {
+    type = ParsedExecInstruction::Type::kUnconditional;
+  }
+  UpdateExecConditionals(type, instr.bool_constant_index, instr.condition);
+  // The instruction itself is on the control flow level.
+  CloseInstructionPredication();
+  if (builder_->IsTerminated()) {
+    return;
+  }
+  JumpToAddress(instr.target_address);
+}
+
+void XscShaderTranslator::ProcessAllocInstruction(const ParsedAllocInstruction& instr,
+                                                  uint8_t export_eM) {
+  if (export_eM) {
+    Unsupported("memory export");
+  }
+}
+
+void XscShaderTranslator::UpdateExecConditionals(ParsedExecInstruction::Type type,
+                                                 uint32_t bool_constant_index, bool condition) {
+  // Merge with the previous exec if possible (also merging the instruction-level predicate).
+  if (type == ParsedExecInstruction::Type::kConditional) {
+    if (cf_exec_conditional_ && cf_exec_bool_constant_or_predicate_ == bool_constant_index &&
+        cf_exec_condition_ == condition) {
+      return;
+    }
+  } else if (type == ParsedExecInstruction::Type::kPredicated) {
+    // Only if the previous exec hasn't modified the predicate.
+    if (!cf_exec_predicate_written_ && cf_exec_conditional_ &&
+        cf_exec_bool_constant_or_predicate_ == kCfExecBoolConstantPredicate &&
+        cf_exec_condition_ == condition) {
+      return;
+    }
+  } else {
+    if (!cf_exec_conditional_) {
+      return;
+    }
+  }
+
+  CloseExecConditionals();
+
+  if (type == ParsedExecInstruction::Type::kUnconditional) {
+    return;
+  }
+
+  Builder& b = *builder_;
+  ValueId condition_id;
+  if (type == ParsedExecInstruction::Type::kConditional) {
+    ValueId bool_constant_word =
+        b.Emit(Op::kLoadBoolLoopConstantWord, kUint, {}, {bool_constant_index >> 5});
+    condition_id = b.Compare(
+        Op::kINotEqual,
+        b.Emit(Op::kBitwiseAnd, kUint,
+               {bool_constant_word, b.ConstUint(uint32_t(1) << (bool_constant_index & 31))}),
+        b.ConstUint(0));
+    cf_exec_bool_constant_or_predicate_ = bool_constant_index;
+  } else {
+    condition_id = b.Load(var_predicate_);
+    cf_exec_bool_constant_or_predicate_ = kCfExecBoolConstantPredicate;
+  }
+  cf_exec_condition_ = condition;
+  if (!condition) {
+    condition_id = b.Unary(Op::kLogicalNot, condition_id);
+  }
+  cf_exec_conditional_.emplace(b, condition_id);
+}
+
+void XscShaderTranslator::UpdateInstructionPredication(bool predicated, bool condition) {
+  if (!predicated) {
+    CloseInstructionPredication();
+    return;
+  }
+  if (cf_instruction_predicate_) {
+    if (cf_instruction_predicate_condition_ == condition) {
+      return;
+    }
+    CloseInstructionPredication();
+  }
+  // If the exec's predicate condition is the same, no need to check again, unless a setp in the
+  // exec may have changed the predicate.
+  if (!cf_exec_predicate_written_ && cf_exec_conditional_ &&
+      cf_exec_bool_constant_or_predicate_ == kCfExecBoolConstantPredicate &&
+      cf_exec_condition_ == condition) {
+    return;
+  }
+  Builder& b = *builder_;
+  cf_instruction_predicate_condition_ = condition;
+  ValueId predicate = b.Load(var_predicate_);
+  if (!condition) {
+    predicate = b.Unary(Op::kLogicalNot, predicate);
+  }
+  cf_instruction_predicate_.emplace(b, predicate);
+}
+
+void XscShaderTranslator::CloseInstructionPredication() {
+  if (!cf_instruction_predicate_) {
+    return;
+  }
+  cf_instruction_predicate_->End();
+  cf_instruction_predicate_.reset();
+}
+
+void XscShaderTranslator::CloseExecConditionals() {
+  CloseInstructionPredication();
+  if (cf_exec_conditional_) {
+    cf_exec_conditional_->End();
+    cf_exec_conditional_.reset();
+  }
+  cf_exec_predicate_written_ = false;
+}
+
+// Operands and results.
+
+ValueId XscShaderTranslator::GetStorageAddressingIndex(
+    InstructionStorageAddressingMode addressing_mode, uint32_t storage_index,
+    bool is_float_constant, uint32_t* constant_index_out) {
+  Builder& b = *builder_;
+  const Shader::ConstantRegisterMap& constant_register_map =
+      current_shader().constant_register_map();
+  ValueId base = kNoValue;
+  switch (addressing_mode) {
+    case InstructionStorageAddressingMode::kAbsolute: {
+      uint32_t static_storage_index = storage_index;
+      if (is_float_constant) {
+        static_storage_index = constant_register_map.GetPackedFloatConstantIndex(storage_index);
+        assert_true(static_storage_index != UINT32_MAX);
+        if (static_storage_index == UINT32_MAX) {
+          static_storage_index = 0;
+        }
+      }
+      if (constant_index_out) {
+        *constant_index_out = static_storage_index;
+      }
+      return kNoValue;
+    }
+    case InstructionStorageAddressingMode::kAddressRegisterRelative:
+      base = b.Load(var_address_register_);
+      break;
+    case InstructionStorageAddressingMode::kLoopRelative:
+      base = b.Extract(b.Load(var_loop_address_), 0);
+      break;
+  }
+  if (storage_index) {
+    base = b.Emit(Op::kIAdd, kInt, {base, b.ConstInt(int32_t(storage_index))});
+  }
+  return base;
+}
+
+ValueId XscShaderTranslator::LoadOperandStorage(const InstructionOperand& operand) {
+  Builder& b = *builder_;
+  bool is_float_constant = operand.storage_source == InstructionStorageSource::kConstantFloat;
+  uint32_t constant_index = 0;
+  ValueId dynamic_index = GetStorageAddressingIndex(
+      operand.storage_addressing_mode, operand.storage_index, is_float_constant, &constant_index);
+  switch (operand.storage_source) {
+    case InstructionStorageSource::kRegister:
+      assert_true(var_registers_ != 0);
+      return b.Load(var_registers_, dynamic_index, constant_index);
+    case InstructionStorageSource::kConstantFloat:
+      return b.Emit(Op::kLoadFloatConstant, kFloat4,
+                    {dynamic_index != kNoValue ? dynamic_index
+                                               : b.ConstInt(int32_t(constant_index))});
+    default:
+      assert_unhandled_case(operand.storage_source);
+      return b.ConstFloat(0.0f, 4);
+  }
+}
+
+ValueId XscShaderTranslator::ApplyOperandModifiers(ValueId value, const InstructionOperand& operand,
+                                                   bool invert_negate, bool force_absolute) {
+  Builder& b = *builder_;
+  if (operand.is_absolute_value || force_absolute) {
+    value = b.Unary(Op::kFAbs, value);
+  }
+  if (operand.is_negated != invert_negate) {
+    value = b.Unary(Op::kFNeg, value);
+  }
+  return value;
+}
+
+ValueId XscShaderTranslator::GetUnmodifiedOperandComponents(ValueId storage,
+                                                            const InstructionOperand& operand,
+                                                            uint32_t components) {
+  assert_true(components && components <= 0b1111);
+  if (components == 0b1111 && operand.IsStandardSwizzle()) {
+    return storage;
+  }
+  std::vector<uint32_t> indices;
+  uint32_t components_remaining = components;
+  uint32_t component_index;
+  while (rex::bit_scan_forward(components_remaining, &component_index)) {
+    components_remaining &= ~(uint32_t(1) << component_index);
+    indices.push_back(uint32_t(operand.GetComponent(component_index)) -
+                      uint32_t(SwizzleSource::kX));
+  }
+  return builder_->Swizzle(storage, indices);
+}
+
+void XscShaderTranslator::GetOperandScalarXY(ValueId storage, const InstructionOperand& operand,
+                                             ValueId& a_out, ValueId& b_out) {
+  ValueId a = GetOperandComponents(storage, operand, 0b0001);
+  a_out = a;
+  b_out = operand.GetComponent(0) != operand.GetComponent(1)
+              ? GetOperandComponents(storage, operand, 0b0010)
+              : a;
+}
+
+ValueId XscShaderTranslator::GetAbsoluteOperand(ValueId value, const InstructionOperand& operand) {
+  if (operand.is_absolute_value && !operand.is_negated) {
+    return value;
+  }
+  return builder_->Unary(Op::kFAbs, value);
+}
+
+ValueId XscShaderTranslator::ZeroIfAnyOperandIsZero(ValueId value, ValueId operand_0_abs,
+                                                    ValueId operand_1_abs) {
+  Builder& b = *builder_;
+  uint8_t components = b.TypeOf(value).components;
+  ValueId zero = b.ConstFloat(0.0f, components);
+  return b.Select(
+      b.Compare(Op::kFOrdEqual, b.Binary(Op::kNMin, operand_0_abs, operand_1_abs), zero), zero,
+      value);
+}
+
+void XscShaderTranslator::StoreResult(const InstructionResult& result, ValueId value) {
+  Builder& b = *builder_;
+  uint32_t used_write_mask = result.GetUsedWriteMask();
+  if (!used_write_mask) {
+    return;
+  }
+  bool is_clamped = result.is_clamped;
+
+  VariableId target = 0;
+  ValueId target_dynamic_index = kNoValue;
+  uint32_t target_constant_index = 0;
+  switch (result.storage_target) {
+    case InstructionStorageTarget::kNone:
+      break;
+    case InstructionStorageTarget::kRegister:
+      assert_true(var_registers_ != 0);
+      target = var_registers_;
+      target_dynamic_index = GetStorageAddressingIndex(
+          result.storage_addressing_mode, result.storage_index, false, &target_constant_index);
+      break;
+    case InstructionStorageTarget::kInterpolator:
+      assert_true(is_vertex_shader());
+      // Interpolators the pixel shader does not need have no variable.
+      target = var_interpolators_[result.storage_index];
+      break;
+    case InstructionStorageTarget::kPosition:
+      assert_true(is_vertex_shader());
+      target = var_position_;
+      break;
+    case InstructionStorageTarget::kPointSizeEdgeFlagKillVertex:
+      assert_true(is_vertex_shader());
+      assert_zero(used_write_mask & 0b1000);
+      target = var_point_size_edge_flag_kill_vertex_;
+      break;
+    case InstructionStorageTarget::kColor:
+      assert_true(is_pixel_shader());
+      target = var_color_[result.storage_index];
+      break;
+    case InstructionStorageTarget::kDepth:
+      assert_true(is_pixel_shader());
+      assert_true(used_write_mask == 0b0001);
+      target = var_depth_;
+      // Guest depth output is expected to be [0, 1].
+      is_clamped = true;
+      break;
+    case InstructionStorageTarget::kExportAddress:
+    case InstructionStorageTarget::kExportData:
+      Unsupported("memory export");
+      return;
+    default:
+      Unsupported("this export target");
+      return;
+  }
+  if (!target) {
+    return;
+  }
+
+  uint32_t constant_values;
+  uint32_t constant_components = result.GetUsedConstantComponents(constant_values);
+  if (value == kNoValue) {
+    // Nothing useful to store, but the guest components must still be written: zeros.
+    constant_components = used_write_mask;
+  }
+  uint32_t non_constant_components = used_write_mask & ~constant_components;
+
+  uint32_t value_num_components = value != kNoValue ? b.TypeOf(value).components : 0;
+
+  if (is_clamped && non_constant_components) {
+    // The saturation modifier, flushing NaN to 0.
+    value = b.Emit(Op::kNClamp, b.TypeOf(value),
+                   {value, b.ConstFloat(0.0f, uint8_t(value_num_components)),
+                    b.ConstFloat(1.0f, uint8_t(value_num_components))});
+  }
+
+  // The value has the used result components condensed, or a scalar to replicate: map the guest
+  // result components to the components of the value.
+  uint32_t used_result_components = result.GetUsedResultComponents();
+  uint32_t result_unswizzled_value_components[4] = {};
+  if (value_num_components > 1) {
+    uint32_t value_component = 0;
+    uint32_t used_result_components_remaining = used_result_components;
+    uint32_t result_component;
+    while (rex::bit_scan_forward(used_result_components_remaining, &result_component)) {
+      used_result_components_remaining &= ~(uint32_t(1) << result_component);
+      result_unswizzled_value_components[result_component] =
+          std::min(value_component++, value_num_components - 1);
+    }
+  }
+  uint32_t result_swizzled_value_components[4] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (!(non_constant_components & (1 << i))) {
+      continue;
+    }
+    SwizzleSource swizzle = result.components[i];
+    assert_true(swizzle >= SwizzleSource::kX && swizzle <= SwizzleSource::kW);
+    result_swizzled_value_components[i] =
+        result_unswizzled_value_components[uint32_t(swizzle) - uint32_t(SwizzleSource::kX)];
+  }
+
+  Type target_type = b.GetVariable(target).type;
+  uint32_t target_num_components = target_type.components;
+  uint32_t target_component_mask = (1 << target_num_components) - 1;
+  assert_zero(used_write_mask & ~target_component_mask);
+
+  ValueId const_float2_0_1 = b.ConstFloats({0.0f, 1.0f});
+  ValueId value_to_store;
+  if (target_component_mask == used_write_mask) {
+    // All components are overwritten.
+    if (!constant_components) {
+      if (target_num_components > 1) {
+        if (value_num_components > 1) {
+          bool is_identity_swizzle = target_num_components == value_num_components;
+          for (uint32_t i = 0; is_identity_swizzle && i < target_num_components; ++i) {
+            is_identity_swizzle &= result_swizzled_value_components[i] == i;
+          }
+          if (is_identity_swizzle) {
+            value_to_store = value;
+          } else {
+            value_to_store = b.Swizzle(
+                value, std::vector<uint32_t>(result_swizzled_value_components,
+                                             result_swizzled_value_components + target_num_components));
+          }
+        } else {
+          value_to_store = b.Smear(value, uint8_t(target_num_components));
+        }
+      } else {
+        value_to_store =
+            value_num_components > 1 ? b.Extract(value, result_swizzled_value_components[0]) : value;
+      }
+    } else if (!non_constant_components) {
+      std::array<uint32_t, 4> bits = {};
+      for (uint32_t i = 0; i < target_num_components; ++i) {
+        float component = (constant_values & (1 << i)) ? 1.0f : 0.0f;
+        std::memcpy(&bits[i], &component, sizeof(uint32_t));
+      }
+      value_to_store = b.Constant(target_type, bits);
+    } else {
+      assert_true(target_num_components > 1);
+      if (value_num_components > 1) {
+        std::array<uint32_t, 4> indices = {};
+        for (uint32_t i = 0; i < target_num_components; ++i) {
+          indices[i] = (constant_components & (1 << i))
+                           ? value_num_components + ((constant_values >> i) & 1)
+                           : result_swizzled_value_components[i];
+        }
+        value_to_store = b.Emit(Op::kShuffle, target_type, {value, const_float2_0_1}, indices);
+      } else {
+        std::vector<ValueId> components;
+        for (uint32_t i = 0; i < target_num_components; ++i) {
+          if (constant_components & (1 << i)) {
+            components.push_back(b.ConstFloat((constant_values & (1 << i)) ? 1.0f : 0.0f));
+          } else {
+            components.push_back(value);
+          }
+        }
+        value_to_store = b.Construct(target_type, components);
+      }
+    }
+  } else {
+    // Only certain components are overwritten: constants first, then the value components.
+    assert_true(target_num_components > 1);
+    value_to_store = b.Load(target, target_dynamic_index, target_constant_index);
+    if (constant_components) {
+      std::array<uint32_t, 4> indices = {};
+      for (uint32_t i = 0; i < target_num_components; ++i) {
+        indices[i] = (constant_components & (1 << i))
+                         ? target_num_components + ((constant_values >> i) & 1)
+                         : i;
+      }
+      value_to_store = b.Emit(Op::kShuffle, target_type, {value_to_store, const_float2_0_1}, indices);
+    }
+    if (non_constant_components) {
+      if (value_num_components > 1) {
+        std::array<uint32_t, 4> indices = {};
+        for (uint32_t i = 0; i < target_num_components; ++i) {
+          indices[i] = (non_constant_components & (1 << i))
+                           ? target_num_components + result_swizzled_value_components[i]
+                           : i;
+        }
+        value_to_store = b.Emit(Op::kShuffle, target_type, {value_to_store, value}, indices);
+      } else {
+        for (uint32_t i = 0; i < target_num_components; ++i) {
+          if (non_constant_components & (1 << i)) {
+            value_to_store = b.Emit(Op::kInsert, target_type, {value_to_store, value}, {i});
+          }
+        }
+      }
+    }
+  }
+  b.Store(target, value_to_store, target_dynamic_index, target_constant_index);
+}
+
