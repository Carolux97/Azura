+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_translator_vs.cpp
+ * @brief       Xenos shader compiler: vertex shader prologue and epilogue
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The vertex path of the SPIR-V translator (spirv_translator.cpp StartVertexOrTessEvalShader*,
+ * CompleteVertexOrTessEvalShaderInMain) for the host vertex shader types XSC supports, the vertex
+ * and point sprites: the guest vertex index in r0.x (from the host index, the guest index buffer
+ * for point sprites, endian swapped, offset and clamped), and at the end the position from the
+ * guest's format to the host clip space, user clip planes, vertex kill, the point size and the
+ * expansion of point sprites.
+ */
+
+#include <fmt/format.h>
+
+#include <rex/assert.h>
+#include <rex/math.h>
+
+#include "xsc_translator.h"
+
+namespace rex::graphics::xsc {
+
+using SystemConstants = SpirvShaderTranslator::SystemConstants;
+
+ValueId XscShaderTranslator::LoadSystemConstantFloats(size_t offset_bytes, uint8_t count) {
+  Builder& b = *builder_;
+  std::vector<ValueId> components;
+  for (uint8_t i = 0; i < count; ++i) {
+    components.push_back(LoadSystemConstantFloat(offset_bytes + sizeof(float) * i));
+  }
+  return b.Construct(kFloat.WithComponents(count), std::move(components));
+}
+
+ValueId XscShaderTranslator::EndianSwap32Uint(ValueId value, ValueId endian) {
+  Builder& b = *builder_;
+  uint8_t n = b.TypeOf(value).components;
+  ValueId is_8in16 = b.Compare(Op::kIEqual, endian, b.ConstUint(uint32_t(xenos::Endian::k8in16)));
+  ValueId is_8in32 = b.Compare(Op::kIEqual, endian, b.ConstUint(uint32_t(xenos::Endian::k8in32)));
+  ValueId is_16in32 =
+      b.Compare(Op::kIEqual, endian, b.ConstUint(uint32_t(xenos::Endian::k16in32)));
+  // 8-in-16, or the first half of 8-in-32.
+  ValueId const_8 = b.ConstUint(8, n);
+  ValueId const_00ff00ff = b.ConstUint(0x00FF00FF, n);
+  ValueId swapped_8in16 = b.Binary(
+      Op::kBitwiseOr,
+      b.Binary(Op::kBitwiseAnd, b.Binary(Op::kShiftRightLogical, value, const_8), const_00ff00ff),
+      b.Binary(Op::kShiftLeftLogical, b.Binary(Op::kBitwiseAnd, value, const_00ff00ff), const_8));
+  value = b.Select(b.Emit(Op::kLogicalOr, kBool, {is_8in16, is_8in32}), swapped_8in16, value);
+  // 16-in-32, or the second half of 8-in-32.
+  ValueId swapped_16in32 = b.EmitWithOperands(
+      Op::kBitFieldInsert, b.TypeOf(value),
+      {b.Binary(Op::kShiftRightLogical, value, b.ConstUint(16, n)), value, b.ConstUint(16),
+       b.ConstUint(16)});
+  return b.Select(b.Emit(Op::kLogicalOr, kBool, {is_8in32, is_16in32}), swapped_16in32, value);
+}
+
+void XscShaderTranslator::StartVertexShaderInMain() {
+  Builder& b = *builder_;
+  const Shader& shader = current_shader();
+  Modification modification = GetModification();
+  Shader::HostVertexShaderType host_vertex_shader_type =
+      modification.vertex.host_vertex_shader_type;
+  bool point_sprites =
+      host_vertex_shader_type == Shader::HostVertexShaderType::kPointListAsTriangleStrip;
+
+  // The outputs: the interpolators the pixel shader needs at consecutive locations, then the point
+  // coordinates (point sprites) or the point size (other primitives), the position, the clip
+  // distances.
+  uint32_t output_location = 0;
+  {
+    uint32_t interpolators_remaining = modification.vertex.interpolator_mask;
+    uint32_t interpolator_index;
+    while (rex::bit_scan_forward(interpolators_remaining, &interpolator_index)) {
+      interpolators_remaining &= ~(UINT32_C(1) << interpolator_index);
+      var_interpolators_[interpolator_index] = b.CreateVariable(
+          kFloat4, fmt::format("xe_out_interpolator_{}", interpolator_index).c_str(), 0,
+          Storage::kOutputInterpolator, output_location++);
+    }
+  }
+  if (modification.vertex.output_point_parameters) {
+    if (point_sprites) {
+      var_point_coordinates_ = b.CreateVariable(kFloat2, "xe_out_point_coordinates", 0,
+                                                Storage::kOutputPointCoordinates, output_location++);
+    } else {
+      // Not the host point size, which must be positive: a varying the point sprite expansion of
+      // the backend reads, negative when the shader does not set it.
+      var_point_size_ = b.CreateVariable(kFloat, "xe_out_point_size", 0, Storage::kOutputPointSize,
+                                         output_location++);
+    }
+  }
+  var_position_ = b.CreateVariable(kFloat4, "gl_Position", 0, Storage::kOutputPosition);
+  uint32_t clip_distance_count = modification.GetVertexClipDistanceCount();
+  if (clip_distance_count) {
+    var_clip_distances_ = b.CreateVariable(kFloat, "gl_ClipDistance", clip_distance_count,
+                                           Storage::kOutputClipDistance);
+    program_->vertex.clip_distance_count = clip_distance_count;
+  }
+
+  // The point size (X, negative unless the shader overrides it), the edge flag (Y, ignored) and
+  // the vertex kill (Z, not killed unless bits 0:30 are set).
+  if (shader.writes_point_size_edge_flag_kill_vertex() & 0b101) {
+    var_point_size_edge_flag_kill_vertex_ =
+        b.CreateVariable(kFloat3, "xe_var_point_size_edge_flag_kill_vertex", 0, Storage::kFunction,
+                         0, b.ConstFloats({-1.0f, 0.0f, 0.0f}));
+  }
+
+  // Zero the registers (games may read registers they only initialize conditionally), the
+  // interpolators and the position.
+  ValueId const_float4_0 = b.ConstFloat(0.0f, 4);
+  for (uint32_t i = 0; i < register_count(); ++i) {
+    b.Store(var_registers_, const_float4_0, kNoValue, i);
+  }
+  for (VariableId interpolator : var_interpolators_) {
+    if (interpolator) {
+      b.Store(interpolator, const_float4_0);
+    }
+  }
+  b.Store(var_position_, const_float4_0);
+
+  // The guest vertex index in r0.x.
+  if (!register_count()) {
+    return;
+  }
+  ValueId const_uint_0 = b.ConstUint(0);
+  ValueId vertex_index = b.Emit(Op::kLoadVertexIndex, kUint, {});
+  // The closing vertex of a line loop is vertex 0.
+  vertex_index = b.Select(
+      b.Compare(Op::kINotEqual, vertex_index,
+                LoadSystemConstantWord(offsetof(SystemConstants, line_loop_closing_index))),
+      vertex_index, const_uint_0);
+  auto flag_set = [&](uint32_t flag) {
+    return b.Compare(Op::kINotEqual,
+                     b.Binary(Op::kBitwiseAnd, system_constant_flags_, b.ConstUint(flag)),
+                     const_uint_0);
+  };
+  ValueId vertex_index_endian =
+      LoadSystemConstantWord(offsetof(SystemConstants, vertex_index_endian));
+  if (point_sprites) {
+    // 4 host vertices per guest point.
+    vertex_index = b.Binary(Op::kShiftRightLogical, vertex_index, b.ConstUint(2));
+    // The guest index from the guest index buffer if it is indexed.
+    Builder::If load_vertex_index_if(
+        b, flag_set(SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad));
+    ValueId loaded_vertex_index;
+    {
+      ValueId vertex_index_is_32bit =
+          flag_set(SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit);
+      ValueId const_uint_2 = b.ConstUint(2);
+      ValueId vertex_index_address = b.Binary(
+          Op::kIAdd, LoadSystemConstantWord(offsetof(SystemConstants, vertex_index_load_address)),
+          b.Binary(Op::kShiftLeftLogical, vertex_index,
+                   b.Select(vertex_index_is_32bit, const_uint_2, b.ConstUint(1))));
+      // The 32 bits with the whole index or two 16-bit indices.
+      loaded_vertex_index = b.Emit(
+          Op::kLoadSharedMemoryWord, kUint,
+          {b.Binary(Op::kShiftRightLogical, vertex_index_address, const_uint_2)});
+      loaded_vertex_index = b.Select(
+          vertex_index_is_32bit, loaded_vertex_index,
+          b.Emit(Op::kBitFieldUExtract, kUint,
+                 {loaded_vertex_index,
+                  b.Binary(Op::kShiftLeftLogical,
+                           b.Binary(Op::kBitwiseAnd, vertex_index_address, const_uint_2),
+                           b.ConstUint(4 - 1)),
+                  b.ConstUint(16)}));
+      loaded_vertex_index = EndianSwap32Uint(loaded_vertex_index, vertex_index_endian);
+    }
+    load_vertex_index_if.End();
+    vertex_index = load_vertex_index_if.MergePhi(loaded_vertex_index, vertex_index);
+  } else {
+    if (!features_.full_draw_index_uint32) {
+      // The full 32-bit index loaded from the guest index buffer when the host can't take it.
+      Builder::If load_vertex_index_if(b, flag_set(SpirvShaderTranslator::kSysFlag_VertexIndexLoad));
+      ValueId loaded_vertex_index = b.Emit(
+          Op::kLoadSharedMemoryWord, kUint,
+          {b.Binary(Op::kIAdd,
+                    b.Binary(Op::kShiftRightLogical,
+                             LoadSystemConstantWord(
+                                 offsetof(SystemConstants, vertex_index_load_address)),
+                             b.ConstUint(2)),
+                    vertex_index)});
+      load_vertex_index_if.End();
+      vertex_index = load_vertex_index_if.MergePhi(loaded_vertex_index, vertex_index);
+    }
+    vertex_index = EndianSwap32Uint(vertex_index, vertex_index_endian);
+  }
+  // The base index, the 24-bit index mask and the clamp to the draw's index range.
+  vertex_index = b.Binary(Op::kIAdd, vertex_index,
+                          LoadSystemConstantWord(offsetof(SystemConstants, vertex_base_index)));
+  vertex_index =
+      b.Binary(Op::kBitwiseAnd, vertex_index, b.ConstUint(xenos::kVertexIndexMask));
+  vertex_index = b.Binary(
+      Op::kUMin,
+      b.Binary(Op::kUMax, vertex_index,
+               LoadSystemConstantWord(offsetof(SystemConstants, vertex_index_min))),
+      LoadSystemConstantWord(offsetof(SystemConstants, vertex_index_max)));
+  ValueId const_float_0 = b.ConstFloat(0.0f);
+  b.Store(var_registers_,
+          b.Construct(kFloat4, {b.Emit(Op::kConvertUToF, kFloat, {vertex_index}), const_float_0,
+                                const_float_0, const_float_0}),
+          kNoValue, 0);
+}
+
+void XscShaderTranslator::CompleteVertexShaderInMain() {
+  Builder& b = *builder_;
+  const Shader& shader = current_shader();
+  Modification modification = GetModification();
+  ValueId const_uint_0 = b.ConstUint(0);
+  auto flag_set = [&](uint32_t flag) {
+    return b.Compare(Op::kINotEqual,
+                     b.Binary(Op::kBitwiseAnd, system_constant_flags_, b.ConstUint(flag)),
+                     const_uint_0);
+  };
+
+  ValueId guest_position = b.Load(var_position_);
+
+  // W, from 1/W if the shader returns that.
+  ValueId position_w = b.Extract(guest_position, 3);
+  position_w =
+      b.Select(flag_set(SpirvShaderTranslator::kSysFlag_WNotReciprocal), position_w,
+               b.Binary(Op::kFDiv, b.ConstFloat(1.0f), position_w));
+  // XY and Z multiplied back by W if the shader returns them divided by W.
+  ValueId position_xy = b.Swizzle(guest_position, {0, 1});
+  position_xy = b.Select(flag_set(SpirvShaderTranslator::kSysFlag_XYDividedByW),
+                         b.Emit(Op::kVectorTimesScalar, kFloat2, {position_xy, position_w}),
+                         position_xy);
+  ValueId position_z = b.Extract(guest_position, 2);
+  position_z = b.Select(flag_set(SpirvShaderTranslator::kSysFlag_ZDividedByW),
+                        b.Binary(Op::kFMul, position_z, position_w), position_z);
+  ValueId position_xyz = b.Construct(kFloat3, {position_xy, position_z});
+
+  // User clip planes, with the guest position (before the guest to host NDC transform).
+  uint32_t clip_distance_count = modification.GetVertexClipDistanceCount();
+  auto write_clip_distances = [&](ValueId position) {
+    for (uint32_t i = 0; i < clip_distance_count; ++i) {
+      ValueId user_clip_plane =
+          LoadSystemConstantFloats(offsetof(SystemConstants, user_clip_planes) +
+                                       sizeof(float) * 4 * i,
+                                   4);
+      b.Store(var_clip_distances_, b.Emit(Op::kDot, kFloat, {position, user_clip_plane}),
+              kNoValue, i);
+    }
+  };
+  write_clip_distances(b.Construct(kFloat4, {position_xyz, position_w}));
+
+  // The guest to host viewport transformation.
+  ValueId ndc_scale = LoadSystemConstantFloats(offsetof(SystemConstants, ndc_scale), 3);
+  ValueId ndc_offset = LoadSystemConstantFloats(offsetof(SystemConstants, ndc_offset), 3);
+  position_xyz = b.Binary(Op::kFMul, position_xyz, ndc_scale);
+  position_xyz = b.Binary(Op::kFAdd, position_xyz,
+                          b.Emit(Op::kVectorTimesScalar, kFloat3, {ndc_offset, position_w}));
+
+  // Vertex kill: the primitive is dropped by a NaN W ("or" mode; the "and" mode needs cull
+  // distances, not supported).
+  if (shader.writes_point_size_edge_flag_kill_vertex() & 0b100) {
+    ValueId kill_vertex_bits =
+        b.Emit(Op::kBitcast, kUint, {b.Extract(b.Load(var_point_size_edge_flag_kill_vertex_), 2)});
+    ValueId kill_vertex = b.Compare(
+        Op::kINotEqual, b.Binary(Op::kBitwiseAnd, kill_vertex_bits, b.ConstUint(0x7FFFFFFF)),
+        const_uint_0);
+    position_w = b.Select(kill_vertex, b.Emit(Op::kBitcast, kFloat, {b.ConstUint(0x7FC00000)}),
+                          position_w);
+  }
+
+  // The point size for the backend's point sprite expansion.
+  ValueId point_vertex_diameter = kNoValue;
+  if (shader.writes_point_size_edge_flag_kill_vertex() & 0b001) {
+    point_vertex_diameter = b.Extract(b.Load(var_point_size_edge_flag_kill_vertex_), 0);
+  }
+  if (var_point_size_) {
+    b.Store(var_point_size_,
+            point_vertex_diameter != kNoValue ? point_vertex_diameter : b.ConstFloat(-1.0f));
+  }
+
+  if (modification.vertex.host_vertex_shader_type !=
+      Shader::HostVertexShaderType::kPointListAsTriangleStrip) {
+    b.Store(var_position_, b.Construct(kFloat4, {position_xyz, position_w}));
+    return;
+  }
+
+  // Point sprites: top-left, bottom-left, top-right, bottom-right host vertices.
+  ValueId host_vertex_index = b.Emit(Op::kLoadVertexIndex, kUint, {});
+  ValueId point_vertex_positive = b.Compare(
+      Op::kINotEqual,
+      b.Binary(Op::kBitwiseAnd, b.Construct(kUint.WithComponents(2), {host_vertex_index,
+                                                                       host_vertex_index}),
+               b.Constant(kUint.WithComponents(2), {0b10, 0b01, 0, 0})),
+      b.ConstUint(0, 2));
+  // The diameter in guest pixels: the constant one, or the vertex shader's if it wrote a
+  // non-negative one (the prologue sets -1).
+  ValueId point_guest_diameter =
+      LoadSystemConstantFloats(offsetof(SystemConstants, point_constant_diameter), 2);
+  if (point_vertex_diameter != kNoValue) {
+    point_guest_diameter =
+        b.Select(b.Compare(Op::kFOrdGreaterThanEqual, point_vertex_diameter, b.ConstFloat(0.0f)),
+                 b.Smear(point_vertex_diameter, 2), point_guest_diameter);
+  }
+  // The radius in the normalized device coordinates, then in the clip space.
+  ValueId point_radius = b.Binary(
+      Op::kFMul, point_guest_diameter,
+      LoadSystemConstantFloats(offsetof(SystemConstants, point_screen_diameter_to_ndc_radius), 2));
+  point_radius = b.Emit(Op::kVectorTimesScalar, kFloat2, {point_radius, position_w});
+  ValueId point_position_xy =
+      b.Binary(Op::kFAdd, b.Swizzle(position_xyz, {0, 1}),
+               b.Select(point_vertex_positive, point_radius, b.Unary(Op::kFNeg, point_radius)));
+  ValueId point_position_z = b.Extract(position_xyz, 2);
+  b.Store(var_position_, b.Construct(kFloat4, {point_position_xy, point_position_z, position_w}));
+  if (var_point_coordinates_) {
+    b.Store(var_point_coordinates_,
+            b.Select(point_vertex_positive, b.ConstFloat(1.0f, 2), b.ConstFloat(0.0f, 2)));
+  }
+  // The clip distances again for the expanded vertex with PA_CL_CLIP_CNTL::ps_ucp_mode 2 and 3,
+  // with the host position transformed back to the guest clip space.
+  if (clip_distance_count && modification.vertex.point_ps_ucp_mode >= 2) {
+    ValueId point_guest_position_xyz = b.Binary(
+        Op::kFSub, b.Construct(kFloat3, {point_position_xy, point_position_z}),
+        b.Emit(Op::kVectorTimesScalar, kFloat3, {ndc_offset, position_w}));
+    point_guest_position_xyz = b.Binary(Op::kFDiv, point_guest_position_xyz, ndc_scale);
+    write_clip_distances(b.Construct(kFloat4, {point_guest_position_xyz, position_w}));
+  }
+}
