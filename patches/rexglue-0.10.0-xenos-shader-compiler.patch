+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_translator.h
+ * @brief       Xenos shader compiler (XSC): lowers Xenos microcode into the XSC IR and emits it
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * A ShaderTranslator like the SPIR-V and DXBC ones: the shader analysis drives the Process*
+ * calls, which build the IR with the Xenos semantics (the same rules as the SPIR-V translator,
+ * which the offline bench compares it with), and CompleteTranslation emits the target language.
+ * It takes the SPIR-V translator's modification bits and fills the same texture and sampler
+ * bindings, so the backends bind its shaders like the SPIR-V translator's.
+ *
+ * Shaders it does not support yet (vertex shaders, memory export, some fetch modes) fail the
+ * translation with a non-fatal log line, and the backend uses the SPIR-V translator for them.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/graphics/pipeline/shader/translator.h>
+
+#include "xsc_builder.h"
+#include "xsc_ir.h"
+
+namespace rex::graphics::xsc {
+
+class XscShaderTranslator : public ShaderTranslator {
+ public:
+  using Modification = SpirvShaderTranslator::Modification;
+
+  enum class Target {
+    // Metal Shading Language source text.
+    kMsl,
+    // A SPIR-V module for Vulkan.
+    kSpirv,
+  };
+
+  // The same host configuration as the SPIR-V translator of the backend: the device features (the
+  // SPIR-V version and float controls, demote, the sample mask output for alpha to coverage),
+  // whether 2x MSAA is native (the host samples of alpha to coverage), and the draw resolution
+  // scale (the pixel position and the textures resolved at that scale).
+  XscShaderTranslator(Target target, const SpirvShaderTranslator::Features& features,
+                      bool native_2x_msaa_with_attachments, uint32_t draw_resolution_scale_x,
+                      uint32_t draw_resolution_scale_y)
+      : target_(target),
+        features_(features),
+        native_2x_msaa_with_attachments_(native_2x_msaa_with_attachments),
+        draw_resolution_scale_x_(draw_resolution_scale_x ? draw_resolution_scale_x : 1),
+        draw_resolution_scale_y_(draw_resolution_scale_y ? draw_resolution_scale_y : 1) {}
+
+  // Debugging aid: pixel shaders paint the color outputs that the guest render target could not
+  // hold magenta (NaN or infinity) or cyan (outside [0, 31.875] for a 7e3 render target), before
+  // the clamp to that range. Applies to the translations made afterwards.
+  void set_debug_color_range(bool enabled) { debug_color_range_ = enabled; }
+
+  // With debug_color_range, every pixel shader translation also counts its pixels on the GPU in
+  // kDebugCountersPerShader counters of a buffer (bound at Metal buffer index 6), in a slot of its
+  // own: the counter index of the first is the slot index times kDebugCountersPerShader.
+  enum DebugCounter : uint32_t {
+    // Any color component NaN or infinite.
+    kDebugCounterNonFinite,
+    // A 7e3 render target with RGB above 31.875.
+    kDebugCounterAbove7e3,
+    // A 7e3 render target with negative RGB.
+    kDebugCounterNegative7e3,
+    // Any pixel written to a 7e3 render target.
+    kDebugCounter7e3,
+    kDebugCountersPerShader,
+  };
+  static constexpr uint32_t kDebugCounterMaxShaders = 4096;
+  struct DebugCounterShader {
+    uint64_t ucode_data_hash;
+    uint64_t modification;
+  };
+  // The shader of each debug counter slot, in slot order.
+  const std::vector<DebugCounterShader>& debug_counter_shaders() const {
+    return debug_counter_shaders_;
+  }
+
+  // The name of the entry point of a translation: the shader type, the ucode hash, the
+  // modification, and for pixel shaders e (early depth and stencil tests), k (kill
+  // instructions) and z (depth output), ending with _x for XSC.
+  static std::string GetEntryPointName(const Shader& shader, uint64_t modification);
+
+  // Why the last translation failed, if it did because something is not supported yet.
+  const std::string& unsupported_reason() const { return unsupported_reason_; }
+
+ protected:
+  void Reset() override;
+  uint32_t GetModificationRegisterCount() const override;
+  void StartTranslation() override;
+  std::vector<uint8_t> CompleteTranslation() override;
+  void PostTranslation() override;
+
