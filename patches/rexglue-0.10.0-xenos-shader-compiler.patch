+namespace {
+
+// The Metal backend's argument table indices (metal_pipeline_cache.h).
+constexpr uint32_t kBufferSharedMemory = 0;
+constexpr uint32_t kBufferConstantsFirst = 1;
+constexpr uint32_t kBufferSizes = rex::graphics::metal::kMslBufferSizesIndex;
+
+struct Variant {
+  xenos::ShaderType type;
+  uint64_t hash;
+  uint64_t modification;
+  std::string name;  // The MSL dump file name without the extension.
+};
+
+// One translation of a variant: the MSL and the shader's resource bindings.
+struct Translated {
+  bool ok = false;
+  std::string error;
+  MslShader msl;
+  std::vector<SpirvShader::TextureBinding> textures;
+  std::vector<SpirvShader::SamplerBinding> samplers;
+  uint32_t float_constant_count = 0;
+  uint32_t writes_color_targets = 0;
+  bool writes_depth = false;
+  // Vertex shaders: the vertex fetch constants used (0-95).
+  std::vector<uint32_t> vertex_fetch_constants;
+  double translate_ms = 0;
+  double compile_ms = 0;
+  id<MTLFunction> function = nil;
+};
+
+struct Options {
+  fs::path corpus;
+  std::string mode = "translate";
+  std::string filter;
+  size_t limit = SIZE_MAX;
+  uint32_t seeds = 4;
+  uint32_t size = 32;
+  std::vector<std::string> translators = {"spirv"};
+  // "fixed": dfdx and dfdy are replaced by a fixed function of the value in every translation, so
+  // results do not depend on the other pixels of the 2x2 quad (derivatives inside control flow
+  // that differs between the pixels of a quad are undefined, and each compilation resolves them
+  // in its own way). "hardware": the real derivatives.
+  std::string derivatives = "fixed";
+};
+
+// XSC_BENCH_VS_SYNTHETIC: vertex shader variants changed to cover point sprites, the point size,
+// user clip planes and index loads from the guest memory (LoadVariants, GenerateVertexInputs).
+bool g_vertex_synthetic = false;
+
+std::vector<uint32_t> ReadUcode(const fs::path& path) {
+  std::ifstream file(path, std::ios::binary);
+  std::vector<char> bytes((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+  std::vector<uint32_t> dwords(bytes.size() / sizeof(uint32_t));
+  std::memcpy(dwords.data(), bytes.data(), dwords.size() * sizeof(uint32_t));
+  return dwords;
+}
+
+std::vector<Variant> LoadVariants(const Options& options) {
+  std::vector<Variant> variants;
+  std::regex name_regex("^(ps|vs)_([0-9a-f]{16})_([0-9a-f]{16})(_[a-z]+)?(_norast)?$");
+  for (const auto& entry : fs::directory_iterator(options.corpus / "msl")) {
+    std::string stem = entry.path().stem().string();
+    std::smatch match;
+    if (entry.path().extension() != ".metal" || !std::regex_match(stem, match, name_regex)) {
+      continue;
+    }
+    if (match[5].matched || match[4].str() == "_norast") {
+      // The variant without rasterization of a vertex shader shares the translation.
+      continue;
+    }
+    if (!options.filter.empty() && match[2].str().find(options.filter) == std::string::npos) {
+      continue;
+    }
+    Variant variant;
+    variant.type = match[1] == "ps" ? xenos::ShaderType::kPixel : xenos::ShaderType::kVertex;
+    variant.hash = std::stoull(match[2].str(), nullptr, 16);
+    variant.modification = std::stoull(match[3].str(), nullptr, 16);
+    variant.name = stem;
+    if (g_vertex_synthetic && variant.type == xenos::ShaderType::kVertex) {
+      // Vertex shader paths the game's variants do not take: point sprites for half of the
+      // shaders, the point size output for the others, user clip planes for all.
+      SpirvShaderTranslator::Modification modification(variant.modification);
+      if (modification.vertex.host_vertex_shader_type != Shader::HostVertexShaderType::kVertex) {
+        continue;
+      }
+      if (variant.hash & 1) {
+        modification.vertex.host_vertex_shader_type =
+            Shader::HostVertexShaderType::kPointListAsTriangleStrip;
+      }
+      modification.vertex.output_point_parameters = 1;
+      modification.vertex.user_clip_plane_count = 1 + uint32_t(variant.hash % 6);
+      modification.vertex.point_ps_ucp_mode = uint32_t((variant.hash >> 3) % 4);
+      variant.modification = modification.value;
+      variant.name += "_synthetic";
+    }
+    variants.push_back(variant);
+  }
+  std::sort(variants.begin(), variants.end(),
+            [](const Variant& a, const Variant& b) { return a.name < b.name; });
+  if (variants.size() > options.limit) {
+    variants.resize(options.limit);
+  }
+  return variants;
+}
+
+// The same as GetGuestShaderBindings in metal_pipeline_cache.mm.
+std::vector<MslBinding> GetGuestShaderBindings(const SpirvShader& shader) {
+  std::vector<MslBinding> bindings;
+  bindings.push_back({SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram, 0,
+                      MslBinding::Kind::kBuffer, kBufferSharedMemory});
+  for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+    bindings.push_back({SpirvShaderTranslator::kDescriptorSetConstants, i,
+                        MslBinding::Kind::kBuffer, kBufferConstantsFirst + i});
+  }
+  uint32_t texture_set = shader.type() == xenos::ShaderType::kVertex
+                             ? SpirvShaderTranslator::kDescriptorSetTexturesVertex
+                             : SpirvShaderTranslator::kDescriptorSetTexturesPixel;
+  uint32_t texture_count = uint32_t(shader.GetTextureBindingsAfterTranslation().size());
+  uint32_t sampler_count = uint32_t(shader.GetSamplerBindingsAfterTranslation().size());
+  for (uint32_t i = 0; i < texture_count; ++i) {
+    bindings.push_back({texture_set, i, MslBinding::Kind::kTexture, i});
+  }
+  for (uint32_t i = 0; i < sampler_count; ++i) {
+    bindings.push_back({texture_set, texture_count + i, MslBinding::Kind::kSampler, i});
+  }
+  return bindings;
+}
+
+// The translator the Metal backend creates (MetalPipelineCache::Initialize).
+// The features of the Metal backend's SPIR-V translator, also given to XSC for its SPIR-V.
+SpirvShaderTranslator::Features BenchSpirvFeatures() {
+  SpirvShaderTranslator::Features features(true);
+  features.cull_distance = false;
+  features.fragment_shader_sample_interlock = false;
+  features.signed_zero_inf_nan_preserve_float32 = false;
+  features.denorm_flush_to_zero_float32 = false;
+  features.rounding_mode_rte_float32 = false;
+  // The synthetic vertex variants also cover the indices loaded by the shader.
+  features.full_draw_index_uint32 = !g_vertex_synthetic;
+  return features;
+}
+
+// XSC_BENCH_RESOLUTION_SCALE: the draw resolution scale of every translator (1 by default), with
+// every texture marked as resolved at that scale.
+uint32_t BenchResolutionScale() {
+  const char* scale = std::getenv("XSC_BENCH_RESOLUTION_SCALE");
+  return scale ? std::max(std::atoi(scale), 1) : 1;
+}
+
+std::unique_ptr<SpirvShaderTranslator> CreateSpirvTranslator() {
+  return std::make_unique<SpirvShaderTranslator>(BenchSpirvFeatures(), true, true, false,
+                                                 BenchResolutionScale(), BenchResolutionScale());
+}
+
+double MsSince(std::chrono::steady_clock::time_point start) {
+  return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start)
+      .count();
+}
+
+bool g_fixed_derivatives = true;
+// Compare mode: vertex shaders are translated without rasterization, with their outputs written to
+// a buffer (InjectVertexCapture).
+bool g_vertex_capture = false;
+constexpr uint32_t kBufferVertexCapture = 28;
+// XSC_BENCH_RT_7E3: every color target is a 7e3 one (XSC clamps to its range, and the reference
+// output of another translator is clamped the same way before the comparison).
+bool g_render_targets_7e3 = false;
+
+// Replaces dfdx and dfdy with fixed functions of the value (see Options::derivatives).
+void FixDerivatives(std::string& source) {
+  static const char kPrelude[] =
+      "\ntemplate <typename T> T xe_bench_dfdx(T value) { return value * 0.0625; }\n"
+      "template <typename T> T xe_bench_dfdy(T value) { return value * 0.03125; }\n";
+  size_t namespace_position = source.find("using namespace metal;");
+  if (namespace_position == std::string::npos) {
+    return;
+  }
+  for (const char* name : {"dfdx(", "dfdy("}) {
+    size_t position = 0;
+    while ((position = source.find(name, position)) != std::string::npos) {
+      // Only whole identifiers.
+      if (position && (std::isalnum(uint8_t(source[position - 1])) || source[position - 1] == '_')) {
+        position += 5;
+        continue;
+      }
+      source.replace(position, 4, std::string("xe_bench_") + std::string(name, 4));
+      position += 13;
+    }
+  }
+  namespace_position = source.find("using namespace metal;");
+  source.insert(namespace_position + std::strlen("using namespace metal;"), kPrelude);
+}
+
+id<MTLFunction> CompileFunction(id<MTLDevice> device, Translated& translated) {
+  if (g_fixed_derivatives) {
+    FixDerivatives(translated.msl.source);
+  }
+  auto start = std::chrono::steady_clock::now();
+  MTLCompileOptions* options = [MTLCompileOptions new];
+  options.languageVersion = MTLLanguageVersion3_0;
+  options.mathMode = MTLMathModeSafe;
+  NSError* error = nil;
+  id<MTLLibrary> library = [device newLibraryWithSource:@(translated.msl.source.c_str())
+                                                options:options
+                                                  error:&error];
+  translated.compile_ms = MsSince(start);
+  if (!library) {
+    translated.error = error ? error.localizedDescription.UTF8String : "MSL compilation failed";
+    return nil;
+  }
+  return [library newFunctionWithName:@(translated.msl.entry_point.c_str())];
+}
+
+// The vertex shader outputs written to the capture buffer, in order, for a modification: the
+// position, the interpolators the modification outputs, the point size or coordinates, the clip
+// distances. Each entry is the MSL expression of the output struct member and its float count.
+std::vector<std::pair<std::string, uint32_t>> VertexCaptureLayout(uint64_t modification_bits) {
+  SpirvShaderTranslator::Modification modification(modification_bits);
+  std::vector<std::pair<std::string, uint32_t>> layout = {{"gl_Position", 4}};
+  uint32_t interpolators_remaining = modification.vertex.interpolator_mask;
+  uint32_t interpolator_index;
+  while (rex::bit_scan_forward(interpolators_remaining, &interpolator_index)) {
+    interpolators_remaining &= ~(UINT32_C(1) << interpolator_index);
+    layout.emplace_back(fmt::format("xe_out_interpolator_{}", interpolator_index), 4);
+  }
+  if (modification.vertex.output_point_parameters) {
+    if (modification.vertex.host_vertex_shader_type ==
+        Shader::HostVertexShaderType::kPointListAsTriangleStrip) {
+      layout.emplace_back("xe_out_point_coordinates", 2);
+    } else {
+      layout.emplace_back("xe_out_point_size", 1);
+    }
+  }
+  for (uint32_t i = 0; i < modification.GetVertexClipDistanceCount(); ++i) {
+    layout.emplace_back(fmt::format("gl_ClipDistance[{}]", i), 1);
+  }
+  return layout;
+}
+
+uint32_t VertexCaptureStride(uint64_t modification) {
+  uint32_t stride = 0;
+  for (const auto& [name, count] : VertexCaptureLayout(modification)) {
+    stride += count;
+  }
+  return stride;
+}
+
+// Makes the vertex function without rasterization write its outputs (`out`, named as SPIRV-Cross
+// names them, which XSC follows) to a buffer, one record per vertex: a capture buffer parameter is
+// added, and the writes are inserted at the end of the function (the last one in the source).
+bool InjectVertexCapture(std::string& source, const std::string& entry_point,
+                         uint64_t modification) {
+  size_t signature = source.find("vertex void " + entry_point + "(");
+  if (signature == std::string::npos) {
+    return false;
+  }
+  size_t body = source.find("\n{", signature);
+  size_t parameters_end = source.rfind(')', body);
+  if (body == std::string::npos || parameters_end == std::string::npos ||
+      parameters_end < signature) {
+    return false;
+  }
+  std::string extra_parameters =
+      fmt::format(", device float* xe_bench_capture [[buffer({})]]", kBufferVertexCapture);
+  if (source.substr(signature, parameters_end - signature).find("[[vertex_id]]") ==
+      std::string::npos) {
+    extra_parameters += ", uint gl_VertexIndex [[vertex_id]]";
+  }
+  source.insert(parameters_end, extra_parameters);
+  std::string writes = fmt::format("    {{\n        uint xe_bench_base = gl_VertexIndex * {};\n",
+                                   VertexCaptureStride(modification));
+  uint32_t offset = 0;
+  for (const auto& [name, count] : VertexCaptureLayout(modification)) {
+    for (uint32_t i = 0; i < count; ++i) {
+      writes += fmt::format("        xe_bench_capture[xe_bench_base + {}] = out.{}{};\n",
+                            offset + i, name,
+                            count > 1 ? std::string(".") + "xyzw"[i] : std::string());
+    }
+    offset += count;
+  }
+  writes += "    }\n";
+  size_t function_end = source.rfind('}');
+  if (function_end == std::string::npos || function_end < parameters_end) {
+    return false;
+  }
+  source.insert(function_end, writes);
+  return true;
+}
+
+// Translates the variant to SPIR-V (with the SPIR-V translator, or with XSC for "xsc-spirv") and
+// converts it with SPIRV-Cross, as the Metal backend does.
+Translated TranslateSpirv(id<MTLDevice> device, ShaderTranslator& translator,
+                          const Variant& variant, const std::vector<uint32_t>& ucode) {
+  Translated translated;
+  auto start = std::chrono::steady_clock::now();
+  // dump_shaders writes the ucode in host byte order.
+  SpirvShader shader(variant.type, variant.hash, ucode.data(), ucode.size(), std::endian::native);
+  rex::string::StringBuffer disassembly;
+  shader.AnalyzeUcode(disassembly);
+  Shader::Translation* translation = shader.GetOrCreateTranslation(variant.modification);
+  auto* xsc_translator = dynamic_cast<xsc::XscShaderTranslator*>(&translator);
+  if (!translator.TranslateAnalyzedShader(*translation) || !translation->is_valid()) {
+    translated.error = xsc_translator && !xsc_translator->unsupported_reason().empty()
+                           ? "unsupported: " + xsc_translator->unsupported_reason()
+                           : "SPIR-V translation failed";
+    return translated;
+  }
+  const std::vector<uint8_t>& spirv = translation->translated_binary();
+  // XSC_BENCH_DUMP_SPIRV: a folder for the SPIR-V modules of XSC (for spirv-val).
+  if (const char* dump = std::getenv("XSC_BENCH_DUMP_SPIRV"); dump && xsc_translator) {
+    std::ofstream(fs::path(dump) / (variant.name + ".spv"), std::ios::binary)
+        .write(reinterpret_cast<const char*>(spirv.data()), std::streamsize(spirv.size()));
+  }
+  bool vertex = variant.type == xenos::ShaderType::kVertex;
+  if (!rex::graphics::metal::SpirvToMsl(
+          reinterpret_cast<const uint32_t*>(spirv.data()), spirv.size() / sizeof(uint32_t),
+          vertex ? MslStage::kVertex : MslStage::kFragment, GetGuestShaderBindings(shader),
+          translated.msl, vertex && g_vertex_capture, variant.name)) {
+    translated.error = "SPIRV-Cross conversion failed";
+    return translated;
+  }
+  translated.translate_ms = MsSince(start);
+  if (std::getenv("XSC_BENCH_SPIRV_DEFER_DISCARD")) {
+    // Replaces the kills inside the shader (not the alpha test ones, which are after the main
+    // loop) with a flag discarded at the end, like XSC, to check whether a difference comes from
+    // how Metal treats the derivatives of discarded pixels.
+    std::string& source = translated.msl.source;
+    size_t loop = source.find("for (;;)");
+    size_t loop_end = source.rfind("xe_out_fragment_data_0 * xe_uniform_system_constants");
+    if (loop != std::string::npos && loop_end != std::string::npos) {
+      size_t position = loop;
+      while ((position = source.find("discard_fragment();", position)) != std::string::npos &&
+             position < loop_end) {
+        source.replace(position, std::strlen("discard_fragment();"), "xe_deferred_kill = true;");
+        loop_end += std::strlen("xe_deferred_kill = true;") - std::strlen("discard_fragment();");
+      }
+      size_t main_start = source.find("{", source.find(" main0(") != std::string::npos
+                                               ? source.find(" main0(")
+                                               : source.find(variant.name + "("));
+      source.insert(main_start + 1, "\n    bool xe_deferred_kill = false;");
+      size_t return_position = source.rfind("return out;");
+      source.insert(return_position, "if (xe_deferred_kill) { discard_fragment(); }\n    ");
+    }
+  }
+  if (std::getenv("XSC_BENCH_SPIRV_CONTRACT_OFF")) {
+    // Forbids the Metal compiler to fuse the multiplications and additions SPIRV-Cross writes in
+    // one expression, to check whether a difference comes from such fusion.
+    translated.msl.source = "#pragma METAL fp contract(off)\n" + translated.msl.source;
+  }
+  if (variant.type == xenos::ShaderType::kVertex) {
+    for (const Shader::VertexBinding& binding : shader.vertex_bindings()) {
+      translated.vertex_fetch_constants.push_back(binding.fetch_constant);
+    }
+    if (g_vertex_capture && !InjectVertexCapture(translated.msl.source,
+                                                 translated.msl.entry_point,
+                                                 variant.modification)) {
+      translated.error = "the vertex capture could not be inserted";
+      return translated;
+    }
+  }
+  translated.textures = shader.GetTextureBindingsAfterTranslation();
+  translated.samplers = shader.GetSamplerBindingsAfterTranslation();
+  translated.float_constant_count = shader.constant_register_map().float_count;
+  translated.writes_color_targets = shader.writes_color_targets();
+  translated.writes_depth = shader.writes_depth();
+  translated.function = CompileFunction(device, translated);
+  translated.ok = translated.function != nil;
+  return translated;
+}
+
+// Deterministic values from a seed, so both translators see the same inputs.
+struct Random {
+  uint64_t state;
+  explicit Random(uint64_t seed) : state(seed * 0x9E3779B97F4A7C15ull + 1) {}
+  uint32_t Next() {
+    state ^= state << 13;
+    state ^= state >> 7;
+    state ^= state << 17;
+    return uint32_t(state >> 32);
+  }
+  float Unit() { return float(Next() >> 8) / float(1 << 24); }
+  // Mostly ordinary values, with the special ones the Xenos rules are about.
+  float Value(bool specials) {
+    uint32_t kind = Next() % 16;
+    if (kind == 0) {
+      return 0.0f;
+    }
+    if (kind == 1) {
+      return 1.0f;
+    }
+    if (specials && kind == 2) {
+      return INFINITY;
+    }
+    if (specials && kind == 3) {
+      return -0.0f;
+    }
+    if (specials && kind == 4) {
+      return NAN;
+    }
+    return Unit() * 4.0f - 2.0f;
+  }
+};
+
+// The inputs of one draw.
+struct DrawInputs {
+  SpirvShaderTranslator::SystemConstants system = {};
+  std::vector<float> float_constants;
+  uint32_t bool_loop[8 + 32] = {};
+  xenos::xe_gpu_texture_fetch_t fetch[32] = {};
+  std::vector<id<MTLTexture>> textures;
+  std::vector<id<MTLSamplerState>> samplers;
+  float interpolator_scale[16][4];
+  float interpolator_bias[16][4];
+};
+
+id<MTLTexture> CreateTexture(id<MTLDevice> device, xenos::FetchOpDimension dimension,
+                             bool is_signed, Random& random) {
+  MTLTextureDescriptor* descriptor = [MTLTextureDescriptor new];
+  descriptor.pixelFormat = MTLPixelFormatRGBA16Float;
+  descriptor.width = 16;
+  descriptor.height = 16;
+  descriptor.mipmapLevelCount = 5;
+  descriptor.usage = MTLTextureUsageShaderRead;
+  descriptor.storageMode = MTLStorageModeShared;
+  uint32_t slices = 1;
+  switch (dimension) {
+    case xenos::FetchOpDimension::k3DOrStacked:
+      descriptor.textureType = MTLTextureType3D;
+      descriptor.depth = 16;
+      break;
+    case xenos::FetchOpDimension::kCube:
+      descriptor.textureType = MTLTextureTypeCube;
+      slices = 6;
+      break;
+    default:
+      descriptor.textureType = MTLTextureType2DArray;
+      descriptor.arrayLength = 4;
+      slices = 4;
+  }
+  id<MTLTexture> texture = [device newTextureWithDescriptor:descriptor];
+  for (uint32_t level = 0; level < descriptor.mipmapLevelCount; ++level) {
+    uint32_t extent = std::max(16u >> level, 1u);
+    uint32_t depth = descriptor.textureType == MTLTextureType3D ? extent : 1;
+    std::vector<__fp16> texels(size_t(extent) * extent * depth * 4);
+    for (uint32_t slice = 0; slice < slices; ++slice) {
+      for (__fp16& texel : texels) {
+        float value = random.Unit();
+        texel = __fp16(is_signed ? value * 2.0f - 1.0f : value);
+      }
+      [texture replaceRegion:MTLRegionMake3D(0, 0, 0, extent, extent, depth)
+                 mipmapLevel:level
+                       slice:slice
+                   withBytes:texels.data()
+                 bytesPerRow:extent * 4 * sizeof(__fp16)
+               bytesPerImage:extent * extent * 4 * sizeof(__fp16)];
+    }
+  }
+  return texture;
+}
+
+DrawInputs GenerateInputs(id<MTLDevice> device, const Translated& translated, uint32_t seed) {
+  DrawInputs inputs;
+  Random random(seed);
+  bool specials = (seed % 2) == 1;
+  // Every other pair of seeds keeps interpolators and constants in [0, 1], like texture
+  // coordinates and colors, which kill conditions written for real data often need.
+  bool unit_range = (seed / 2) % 2 == 1;
+  auto& system = inputs.system;
+  // Output gamma, the alpha test function (pass if less / equal / greater) and the exponent bias.
+  system.flags = (random.Next() % 2 ? SpirvShaderTranslator::kSysFlag_ConvertColor0ToGamma : 0) |
+                 (random.Next() % 4 == 0 ? 0 : (random.Next() % 8)) *
+                     SpirvShaderTranslator::kSysFlag_AlphaPassIfLess;
+  if (!specials) {
+    // Even seeds always pass the alpha test and have no special values, so that most pixels are
+    // compared; odd seeds exercise the alpha test functions and the special values.
+    system.flags |= SpirvShaderTranslator::kSysFlag_AlphaPassIfLess |
+                    SpirvShaderTranslator::kSysFlag_AlphaPassIfEqual |
+                    SpirvShaderTranslator::kSysFlag_AlphaPassIfGreater;
+  }
+  system.alpha_test_reference = random.Unit();
+  for (uint32_t i = 0; i < 4; ++i) {
+    system.color_exp_bias[i] = random.Next() % 2 ? 1.0f : std::ldexp(1.0f, int(random.Next() % 5) - 2);
+  }
+  for (uint32_t& signs : system.texture_swizzled_signs) {
+    signs = random.Next();
+  }
+  for (uint32_t i = 0; i < 16; ++i) {
+    // Identity swizzles, as the backend uses with view format swizzles.
+    system.texture_swizzles[i] = 0x688 | (0x688 << 12);
+  }
+  system.ndc_scale[0] = system.ndc_scale[1] = system.ndc_scale[2] = 1.0f;
+  if (BenchResolutionScale() > 1) {
+    system.textures_resolution_scaled = UINT32_MAX;
+  }
+  if (g_render_targets_7e3) {
+    for (uint32_t& format_flags : system.edram_rt_format_flags) {
+      format_flags =
+          RenderTargetCache::AddPSIColorFormatFlags(xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT);
+    }
+  }
+  inputs.float_constants.resize(size_t(std::max(translated.float_constant_count, 1u)) * 4);
+  for (float& value : inputs.float_constants) {
+    value = unit_range ? random.Unit() : random.Value(specials);
+  }
+  for (uint32_t i = 0; i < 8; ++i) {
+    inputs.bool_loop[i] = random.Next();
+  }
+  for (uint32_t i = 0; i < 32; ++i) {
+    // Count 0-4, start 0-3, step 1.
+    inputs.bool_loop[8 + i] = (random.Next() % 5) | ((random.Next() % 4) << 8) | (1 << 16);
+  }
+  for (uint32_t i = 0; i < 32; ++i) {
+    xenos::xe_gpu_texture_fetch_t& fetch = inputs.fetch[i];
+    fetch.type = xenos::FetchConstantType::kTexture;
+    fetch.format = xenos::TextureFormat::k_8_8_8_8;
+    fetch.size_2d.width = 15;
+    fetch.size_2d.height = 15;
+    fetch.size_2d.stack_depth = 3;
+    fetch.swizzle = 0x688;
+    fetch.exp_adjust = random.Next() % 4 == 0 ? int32_t(random.Next() % 3) - 1 : 0;
+    fetch.mag_filter = xenos::TextureFilter::kLinear;
+    fetch.min_filter = xenos::TextureFilter::kLinear;
+    fetch.mip_filter = xenos::TextureFilter::kLinear;
+    fetch.mip_max_level = 4;
+    fetch.lod_bias = int32_t(random.Next() % 32) - 16;
+    fetch.dimension = xenos::DataDimension::k2DOrStacked;
+    fetch.stacked = random.Next() % 2;
+  }
+  for (const SpirvShader::TextureBinding& binding : translated.textures) {
+    if (binding.dimension == xenos::FetchOpDimension::k3DOrStacked) {
+      inputs.fetch[binding.fetch_constant].dimension = xenos::DataDimension::k3D;
+      inputs.fetch[binding.fetch_constant].stacked = 0;
+    } else if (binding.dimension == xenos::FetchOpDimension::kCube) {
+      inputs.fetch[binding.fetch_constant].dimension = xenos::DataDimension::kCube;
+      inputs.fetch[binding.fetch_constant].stacked = 0;
+    }
+    inputs.textures.push_back(
+        CreateTexture(device, xenos::FetchOpDimension(binding.dimension), binding.is_signed, random));
+  }
+  for (size_t i = 0; i < translated.samplers.size(); ++i) {
+    MTLSamplerDescriptor* descriptor = [MTLSamplerDescriptor new];
+    descriptor.minFilter = MTLSamplerMinMagFilterLinear;
+    descriptor.magFilter = MTLSamplerMinMagFilterLinear;
+    descriptor.mipFilter = MTLSamplerMipFilterLinear;
+    descriptor.sAddressMode = MTLSamplerAddressModeRepeat;
+    descriptor.tAddressMode = MTLSamplerAddressModeRepeat;
+    descriptor.rAddressMode = MTLSamplerAddressModeRepeat;
+    inputs.samplers.push_back([device newSamplerStateWithDescriptor:descriptor]);
+  }
+  for (uint32_t i = 0; i < 16; ++i) {
+    for (uint32_t j = 0; j < 4; ++j) {
+      inputs.interpolator_scale[i][j] = unit_range ? random.Unit() : random.Unit() * 4.0f - 2.0f;
+      inputs.interpolator_bias[i][j] = unit_range ? random.Unit() * 0.5f : random.Value(false);
+    }
+  }
+  return inputs;
+}
+
+// The vertex function feeding the pixel shaders under test: a triangle covering the target, with
+// all 16 interpolators varying over it.
+const char* kVertexSource = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct Interpolators { float4 v[32]; };
+struct Out {
+  float4 position [[position]];
+  float4 i0 [[user(locn0)]]; float4 i1 [[user(locn1)]]; float4 i2 [[user(locn2)]];
+  float4 i3 [[user(locn3)]]; float4 i4 [[user(locn4)]]; float4 i5 [[user(locn5)]];
+  float4 i6 [[user(locn6)]]; float4 i7 [[user(locn7)]]; float4 i8 [[user(locn8)]];
+  float4 i9 [[user(locn9)]]; float4 i10 [[user(locn10)]]; float4 i11 [[user(locn11)]];
+  float4 i12 [[user(locn12)]]; float4 i13 [[user(locn13)]]; float4 i14 [[user(locn14)]];
+  float4 i15 [[user(locn15)]];
+};
+vertex Out bench_vertex(uint id [[vertex_id]], constant Interpolators& in [[buffer(0)]]) {
+  float2 uv = float2(float((id << 1) & 2), float(id & 2));
+  Out out;
+  out.position = float4(uv * 2.0 - 1.0, 0.5, 1.0);
+  float t = uv.x * 0.37 + uv.y * 0.61;
+#define XE_I(n) out.i##n = in.v[n] * t + in.v[16 + n] * uv.y;
+  XE_I(0) XE_I(1) XE_I(2) XE_I(3) XE_I(4) XE_I(5) XE_I(6) XE_I(7)
+  XE_I(8) XE_I(9) XE_I(10) XE_I(11) XE_I(12) XE_I(13) XE_I(14) XE_I(15)
+  return out;
+}
+)MSL";
+
+struct Output {
+  bool ok = false;
+  std::string error;
+  std::vector<float> colors[4];
+  std::vector<float> depth;
+  double gpu_ms = 0;
+};
+
+// Draws a pixel shader into float render targets (all four color targets and depth) with the
+// inputs, repeating the draw for the perf mode.
+Output DrawPixelShader(id<MTLDevice> device, id<MTLCommandQueue> queue,
+                       id<MTLFunction> vertex_function, const Translated& translated,
+                       const DrawInputs& inputs, uint32_t size, uint32_t repeats) {
+  Output output;
+  MTLRenderPipelineDescriptor* descriptor = [MTLRenderPipelineDescriptor new];
+  descriptor.vertexFunction = vertex_function;
+  descriptor.fragmentFunction = translated.function;
+  for (uint32_t i = 0; i < 4; ++i) {
+    descriptor.colorAttachments[i].pixelFormat = MTLPixelFormatRGBA32Float;
+  }
+  descriptor.depthAttachmentPixelFormat = MTLPixelFormatDepth32Float;
+  NSError* error = nil;
+  id<MTLRenderPipelineState> pipeline = [device newRenderPipelineStateWithDescriptor:descriptor
+                                                                               error:&error];
+  if (!pipeline) {
+    output.error = error ? error.localizedDescription.UTF8String : "pipeline creation failed";
+    return output;
+  }
+  MTLDepthStencilDescriptor* depth_descriptor = [MTLDepthStencilDescriptor new];
+  depth_descriptor.depthCompareFunction = MTLCompareFunctionAlways;
+  depth_descriptor.depthWriteEnabled = YES;
+  id<MTLDepthStencilState> depth_state =
+      [device newDepthStencilStateWithDescriptor:depth_descriptor];
+
+  MTLTextureDescriptor* color_descriptor =
+      [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float
+                                                         width:size
+                                                        height:size
+                                                     mipmapped:NO];
+  color_descriptor.usage = MTLTextureUsageRenderTarget;
+  color_descriptor.storageMode = MTLStorageModeShared;
+  id<MTLTexture> colors[4];
+  for (uint32_t i = 0; i < 4; ++i) {
+    colors[i] = [device newTextureWithDescriptor:color_descriptor];
+  }
+  MTLTextureDescriptor* depth_texture_descriptor =
+      [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatDepth32Float
+                                                         width:size
+                                                        height:size
+                                                     mipmapped:NO];
+  depth_texture_descriptor.usage = MTLTextureUsageRenderTarget;
+  depth_texture_descriptor.storageMode = MTLStorageModePrivate;
+  id<MTLTexture> depth = [device newTextureWithDescriptor:depth_texture_descriptor];
+  id<MTLBuffer> depth_readback = [device newBufferWithLength:size * size * sizeof(float)
+                                                     options:MTLResourceStorageModeShared];
+
+  id<MTLBuffer> shared_memory = [device newBufferWithLength:1 << 20
+                                                    options:MTLResourceStorageModeShared];
+  float interpolators[32][4];
+  std::memcpy(interpolators, inputs.interpolator_scale, sizeof(inputs.interpolator_scale));
+  std::memcpy(interpolators[16], inputs.interpolator_bias, sizeof(inputs.interpolator_bias));
+
+  id<MTLCommandBuffer> command_buffer = [queue commandBuffer];
+  for (uint32_t repeat = 0; repeat < repeats; ++repeat) {
+    MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    for (uint32_t i = 0; i < 4; ++i) {
+      pass.colorAttachments[i].texture = colors[i];
+      pass.colorAttachments[i].loadAction = MTLLoadActionClear;
+      // A value no shader computes by chance marks the pixels that were discarded.
+      pass.colorAttachments[i].clearColor = MTLClearColorMake(-12345.0, -12345.0, -12345.0, -12345.0);
+      pass.colorAttachments[i].storeAction = MTLStoreActionStore;
+    }
+    pass.depthAttachment.texture = depth;
+    pass.depthAttachment.loadAction = MTLLoadActionClear;
+    pass.depthAttachment.clearDepth = 0.25;
+    pass.depthAttachment.storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> encoder = [command_buffer renderCommandEncoderWithDescriptor:pass];
+    [encoder setRenderPipelineState:pipeline];
+    [encoder setDepthStencilState:depth_state];
+    [encoder setVertexBytes:interpolators length:sizeof(interpolators) atIndex:0];
+    [encoder setFragmentBuffer:shared_memory offset:0 atIndex:kBufferSharedMemory];
+    [encoder setFragmentBytes:&inputs.system
+                       length:sizeof(inputs.system)
+                      atIndex:kBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferSystem];
+    [encoder setFragmentBytes:inputs.float_constants.data()
+                       length:inputs.float_constants.size() * sizeof(float)
+                      atIndex:kBufferConstantsFirst +
+                              SpirvShaderTranslator::kConstantBufferFloatPixel];
+    [encoder setFragmentBytes:inputs.bool_loop
+                       length:sizeof(inputs.bool_loop)
+                      atIndex:kBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferBoolLoop];
+    [encoder setFragmentBytes:inputs.fetch
+                       length:sizeof(inputs.fetch)
+                      atIndex:kBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferFetch];
+    if (translated.msl.needs_buffer_sizes) {
+      uint32_t sizes[32] = {};
+      sizes[kBufferSharedMemory] = uint32_t(shared_memory.length);
+      [encoder setFragmentBytes:sizes length:sizeof(sizes) atIndex:kBufferSizes];
+    }
+    for (size_t i = 0; i < inputs.textures.size(); ++i) {
+      [encoder setFragmentTexture:inputs.textures[i] atIndex:i];
+    }
+    for (size_t i = 0; i < inputs.samplers.size(); ++i) {
+      [encoder setFragmentSamplerState:inputs.samplers[i] atIndex:i];
+    }
+    [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    [encoder endEncoding];
+  }
+  id<MTLBlitCommandEncoder> blit = [command_buffer blitCommandEncoder];
+  [blit copyFromTexture:depth
+                   sourceSlice:0
+                   sourceLevel:0
+                  sourceOrigin:MTLOriginMake(0, 0, 0)
+                    sourceSize:MTLSizeMake(size, size, 1)
+                      toBuffer:depth_readback
+             destinationOffset:0
+        destinationBytesPerRow:size * sizeof(float)
+      destinationBytesPerImage:size * size * sizeof(float)];
+  [blit endEncoding];
+  [command_buffer commit];
+  [command_buffer waitUntilCompleted];
+  if (command_buffer.status != MTLCommandBufferStatusCompleted) {
+    output.error = command_buffer.error ? command_buffer.error.localizedDescription.UTF8String
+                                        : "the command buffer failed";
+    return output;
+  }
+  output.gpu_ms = (command_buffer.GPUEndTime - command_buffer.GPUStartTime) * 1000.0 / repeats;
+  for (uint32_t i = 0; i < 4; ++i) {
+    output.colors[i].resize(size_t(size) * size * 4);
+    [colors[i] getBytes:output.colors[i].data()
+            bytesPerRow:size * 4 * sizeof(float)
+             fromRegion:MTLRegionMake2D(0, 0, size, size)
+            mipmapLevel:0];
+  }
+  output.depth.resize(size_t(size) * size);
+  std::memcpy(output.depth.data(), depth_readback.contents, output.depth.size() * sizeof(float));
+  output.ok = true;
+  return output;
+}
+
+// The inputs of a vertex shader draw: those of a pixel shader, plus the guest memory the vertex
+// fetches read (random words) with vertex fetch constants pointing into it, and the vertex
+// processing system constants.
+struct VertexDrawInputs {
+  DrawInputs common;
+  std::vector<uint32_t> shared_memory;
+};
+
+VertexDrawInputs GenerateVertexInputs(id<MTLDevice> device, const Translated& translated,
+                                      uint32_t seed) {
+  VertexDrawInputs inputs;
+  inputs.common = GenerateInputs(device, translated, seed);
+  Random random(seed ^ 0x5EED5EEDu);
+  // 16 MB of guest memory; fetches start in the first 4 MB, so index * stride stays inside.
+  inputs.shared_memory.resize(size_t(4) << 20);
+  bool specials = (seed % 2) == 1;
+  for (uint32_t& word : inputs.shared_memory) {
+    if (specials) {
+      word = random.Next();
+    } else {
+      // Mostly finite floats and small integers.
+      float value = random.Value(false);
+      std::memcpy(&word, &value, sizeof(word));
+      if (random.Next() % 4 == 0) {
+        word = random.Next() & 0xFFFF;
+      }
+    }
+  }
+  uint32_t* fetch_words = reinterpret_cast<uint32_t*>(inputs.common.fetch);
+  for (uint32_t fetch_constant : translated.vertex_fetch_constants) {
+    xenos::xe_gpu_vertex_fetch_t vertex_fetch = {};
+    vertex_fetch.type = xenos::FetchConstantType::kVertex;
+    vertex_fetch.address = random.Next() % (uint32_t(1) << 20);
+    vertex_fetch.endian = xenos::Endian(random.Next() % 4);
+    vertex_fetch.size = 1 << 20;
+    fetch_words[fetch_constant * 2] = vertex_fetch.dword_0;
+    fetch_words[fetch_constant * 2 + 1] = vertex_fetch.dword_1;
+  }
+  SpirvShaderTranslator::SystemConstants& system = inputs.common.system;
+  // The position format flags, at random.
+  system.flags = (random.Next() % 2 ? SpirvShaderTranslator::kSysFlag_WNotReciprocal : 0) |
+                 (random.Next() % 2 ? SpirvShaderTranslator::kSysFlag_XYDividedByW : 0) |
+                 (random.Next() % 2 ? SpirvShaderTranslator::kSysFlag_ZDividedByW : 0);
+  system.line_loop_closing_index = UINT32_MAX;
+  system.vertex_index_endian = xenos::Endian::kNone;
+  system.vertex_base_index = int32_t(random.Next() % 64);
+  system.vertex_index_min = 0;
+  system.vertex_index_max = xenos::kVertexIndexMask;
+  if (g_vertex_synthetic) {
+    // Indices from the guest memory (random words, clamped to a range that keeps the vertex
+    // fetches inside the buffer), 16 or 32 bits, any endianness.
+    system.flags |= SpirvShaderTranslator::kSysFlag_VertexIndexLoad |
+                    SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    if (random.Next() % 2) {
+      system.flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+    }
+    system.vertex_index_load_address = (random.Next() % (uint32_t(1) << 18)) * 4;
+    system.vertex_index_endian = xenos::Endian(random.Next() % 4);
+    system.vertex_index_min = random.Next() % 16;
+    system.vertex_index_max = 4095;
+    system.line_loop_closing_index = random.Next() % 1024;
+  }
+  for (uint32_t i = 0; i < 3; ++i) {
+    system.ndc_scale[i] = 0.5f + random.Unit() * 1.5f;
+    system.ndc_offset[i] = random.Unit() * 2.0f - 1.0f;
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    system.point_constant_diameter[i] = random.Unit() * 8.0f;
+    system.point_screen_diameter_to_ndc_radius[i] = random.Unit() * 0.01f;
+  }
+  for (auto& plane : system.user_clip_planes) {
+    for (float& component : plane) {
+      component = random.Unit() * 2.0f - 1.0f;
+    }
+  }
+  return inputs;
+}
+
+struct VertexOutput {
+  bool ok = false;
+  std::string error;
+  std::vector<float> values;
+  double gpu_ms = 0;
+};
+
+// Runs a vertex shader (its function without rasterization, with the capture inserted) for
+// `vertex_count` points and reads its outputs back.
+VertexOutput DrawVertexShader(id<MTLDevice> device, id<MTLCommandQueue> queue,
+                              const Translated& translated, const VertexDrawInputs& inputs,
+                              uint32_t vertex_count, uint32_t stride) {
+  VertexOutput output;
+  MTLRenderPipelineDescriptor* descriptor = [MTLRenderPipelineDescriptor new];
+  descriptor.vertexFunction = translated.function;
+  descriptor.rasterizationEnabled = NO;
+  NSError* error = nil;
+  id<MTLRenderPipelineState> pipeline = [device newRenderPipelineStateWithDescriptor:descriptor
+                                                                               error:&error];
+  if (!pipeline) {
+    output.error = error ? error.localizedDescription.UTF8String : "pipeline creation failed";
+    return output;
+  }
+  id<MTLBuffer> shared_memory =
+      [device newBufferWithBytes:inputs.shared_memory.data()
+                          length:inputs.shared_memory.size() * sizeof(uint32_t)
+                         options:MTLResourceStorageModeShared];
+  size_t capture_size = size_t(vertex_count) * stride * sizeof(float);
+  id<MTLBuffer> capture = [device newBufferWithLength:std::max(capture_size, sizeof(float))
+                                              options:MTLResourceStorageModeShared];
+  // A value no shader writes by chance.
+  std::fill_n(static_cast<float*>(capture.contents), size_t(vertex_count) * stride, -12345.0f);
+
+  id<MTLCommandBuffer> command_buffer = [queue commandBuffer];
+  MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+  pass.renderTargetWidth = 1;
+  pass.renderTargetHeight = 1;
+  pass.defaultRasterSampleCount = 1;
+  id<MTLRenderCommandEncoder> encoder = [command_buffer renderCommandEncoderWithDescriptor:pass];
+  [encoder setRenderPipelineState:pipeline];
+  const DrawInputs& common = inputs.common;
+  [encoder setVertexBuffer:shared_memory offset:0 atIndex:kBufferSharedMemory];
+  [encoder setVertexBytes:&common.system
+                   length:sizeof(common.system)
+                  atIndex:kBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferSystem];
+  [encoder setVertexBytes:common.float_constants.data()
+                   length:common.float_constants.size() * sizeof(float)
+                  atIndex:kBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferFloatVertex];
+  [encoder setVertexBytes:common.bool_loop
+                   length:sizeof(common.bool_loop)
+                  atIndex:kBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferBoolLoop];
+  [encoder setVertexBytes:common.fetch
+                   length:sizeof(common.fetch)
+                  atIndex:kBufferConstantsFirst + SpirvShaderTranslator::kConstantBufferFetch];
+  if (translated.msl.needs_buffer_sizes) {
+    uint32_t sizes[32] = {};
+    sizes[kBufferSharedMemory] = uint32_t(shared_memory.length);
+    [encoder setVertexBytes:sizes length:sizeof(sizes) atIndex:kBufferSizes];
+  }
+  [encoder setVertexBuffer:capture offset:0 atIndex:kBufferVertexCapture];
+  for (size_t i = 0; i < common.textures.size(); ++i) {
+    [encoder setVertexTexture:common.textures[i] atIndex:i];
+  }
+  for (size_t i = 0; i < common.samplers.size(); ++i) {
+    [encoder setVertexSamplerState:common.samplers[i] atIndex:i];
+  }
+  [encoder drawPrimitives:MTLPrimitiveTypePoint vertexStart:0 vertexCount:vertex_count];
+  [encoder endEncoding];
+  [command_buffer commit];
+  [command_buffer waitUntilCompleted];
+  if (command_buffer.status != MTLCommandBufferStatusCompleted) {
+    output.error = command_buffer.error ? command_buffer.error.localizedDescription.UTF8String
+                                        : "the command buffer failed";
+    return output;
+  }
+  output.gpu_ms = (command_buffer.GPUEndTime - command_buffer.GPUStartTime) * 1000.0;
+  const float* values = static_cast<const float*>(capture.contents);
+  output.values.assign(values, values + size_t(vertex_count) * stride);
+  output.ok = true;
+  return output;
+}
+
+// The color as a 7e3 render target holds it (what XSC pixel shaders clamp to): RGB in
+// [0, 31.875], alpha in [0, 1], NaN as 0. The marker of discarded pixels is kept.
+void ClampColorsTo7e3(Output& output) {
+  for (std::vector<float>& color : output.colors) {
+    for (size_t i = 0; i < color.size(); ++i) {
+      float& value = color[i];
+      if (value == -12345.0f) {
+        continue;
+      }
+      value = std::isnan(value) ? 0.0f : std::clamp(value, 0.0f, i % 4 == 3 ? 1.0f : 31.875f);
+    }
+  }
+}
+
+// Bit-exact comparison; returns the number of mismatching values.
+uint32_t CompareOutputs(const Output& a, const Output& b, uint32_t color_mask, bool depth,
+                        std::string& first_mismatch) {
+  uint32_t mismatches = 0;
+  auto same = [](float x, float y) {
+    uint32_t xb, yb;
+    std::memcpy(&xb, &x, 4);
+    std::memcpy(&yb, &y, 4);
+    // NaNs of any payload are equal, and so are +0 and -0: SPIRV-Cross writes multiplications as
+    // fma(a, b, 0), which turns a -0 product into +0, while the Xenos rules give -0 there.
+    return xb == yb || (std::isnan(x) && std::isnan(y)) || (x == 0.0f && y == 0.0f);
+  };
+  for (uint32_t rt = 0; rt < 4; ++rt) {
+    if (!(color_mask & (1u << rt))) {
+      continue;
+    }
+    for (size_t i = 0; i < a.colors[rt].size(); ++i) {
+      if (!same(a.colors[rt][i], b.colors[rt][i])) {
+        if (!mismatches++) {
+          first_mismatch = fmt::format("color {} pixel {} component {}: {} vs {}", rt, i / 4, i % 4,
+                                       a.colors[rt][i], b.colors[rt][i]);
+        }
+      }
+    }
+  }
+  if (depth) {
+    for (size_t i = 0; i < a.depth.size(); ++i) {
+      if (!same(a.depth[i], b.depth[i]) && !mismatches++) {
+        first_mismatch = fmt::format("depth pixel {}: {} vs {}", i, a.depth[i], b.depth[i]);
+      }
+    }
+  }
+  return mismatches;
+}
+
+// Translates the variant with the Xenos shader compiler to MSL.
+Translated TranslateXsc(id<MTLDevice> device, xsc::XscShaderTranslator& translator,
+                        const Variant& variant, const std::vector<uint32_t>& ucode) {
+  Translated translated;
+  auto start = std::chrono::steady_clock::now();
+  SpirvShader shader(variant.type, variant.hash, ucode.data(), ucode.size(), std::endian::native);
+  rex::string::StringBuffer disassembly;
+  shader.AnalyzeUcode(disassembly);
+  Shader::Translation* translation = shader.GetOrCreateTranslation(variant.modification);
+  if (!translator.TranslateAnalyzedShader(*translation) || !translation->is_valid()) {
+    translated.error = translator.unsupported_reason().empty()
+                           ? "XSC translation failed"
+                           : "unsupported: " + translator.unsupported_reason();
+    return translated;
+  }
+  const std::vector<uint8_t>& source = translation->translated_binary();
+  translated.msl.source.assign(source.begin(), source.end());
+  // XSC_BENCH_MSL_OVERRIDE: a folder of hand-edited MSL for experiments, used instead of XSC's
+  // when a file is named after the variant.
+  if (const char* override_dir = std::getenv("XSC_BENCH_MSL_OVERRIDE")) {
+    std::ifstream file(fs::path(override_dir) / (variant.name + ".metal"));
+    if (file) {
+      translated.msl.source.assign(std::istreambuf_iterator<char>(file),
+                                   std::istreambuf_iterator<char>());
+    }
+  }
+  translated.msl.entry_point =
+      xsc::XscShaderTranslator::GetEntryPointName(shader, variant.modification);
+  if (variant.type == xenos::ShaderType::kVertex && g_vertex_capture) {
+    // The entry point without rasterization.
+    translated.msl.entry_point += "_norast";
+  }
+  translated.translate_ms = MsSince(start);
+  if (variant.type == xenos::ShaderType::kVertex) {
+    for (const Shader::VertexBinding& binding : shader.vertex_bindings()) {
+      translated.vertex_fetch_constants.push_back(binding.fetch_constant);
+    }
+    if (g_vertex_capture && !InjectVertexCapture(translated.msl.source,
+                                                 translated.msl.entry_point,
+                                                 variant.modification)) {
+      translated.error = "the vertex capture could not be inserted";
+      return translated;
+    }
+  }
+  translated.textures = shader.GetTextureBindingsAfterTranslation();
+  translated.samplers = shader.GetSamplerBindingsAfterTranslation();
+  translated.float_constant_count = shader.constant_register_map().float_count;
+  translated.writes_color_targets = shader.writes_color_targets();
+  translated.writes_depth = shader.writes_depth();
+  translated.function = CompileFunction(device, translated);
+  translated.ok = translated.function != nil;
+  // XSC_BENCH_DUMP_FAILED: a folder for the MSL that fails to compile; XSC_BENCH_DUMP: for all.
+  const char* dump = std::getenv(translated.ok ? "XSC_BENCH_DUMP" : "XSC_BENCH_DUMP_FAILED");
+  if (dump) {
+    std::ofstream(fs::path(dump) / (translated.msl.entry_point + ".metal")) << translated.msl.source;
+  }
+  return translated;
+}
+
+std::optional<Translated> Translate(const std::string& translator_name, id<MTLDevice> device,
+                                    SpirvShaderTranslator& spirv_translator,
+                                    xsc::XscShaderTranslator& xsc_translator,
+                                    xsc::XscShaderTranslator& xsc_spirv_translator,
+                                    const Variant& variant, const std::vector<uint32_t>& ucode) {
+  if (translator_name == "spirv") {
+    return TranslateSpirv(device, spirv_translator, variant, ucode);
+  }
+  if (translator_name == "xsc-spirv") {
+    return TranslateSpirv(device, xsc_spirv_translator, variant, ucode);
+  }
+  if (translator_name == "xsc") {
+    return TranslateXsc(device, xsc_translator, variant, ucode);
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  @autoreleasepool {
+    Options options;
+    for (int i = 1; i < argc; ++i) {
+      std::string arg = argv[i];
+      auto value = [&]() -> std::string { return i + 1 < argc ? argv[++i] : ""; };
+      if (arg == "--mode") {
+        options.mode = value();
+      } else if (arg == "--filter") {
+        options.filter = value();
+      } else if (arg == "--limit") {
+        options.limit = std::stoull(value());
+      } else if (arg == "--seeds") {
+        options.seeds = uint32_t(std::stoul(value()));
+      } else if (arg == "--size") {
+        options.size = uint32_t(std::stoul(value()));
+      } else if (arg == "--derivatives") {
+        options.derivatives = value();
+      } else if (arg == "--translators") {
+        options.translators.clear();
+        std::string list = value();
+        for (size_t start = 0; start <= list.size();) {
+          size_t end = list.find(',', start);
+          options.translators.push_back(list.substr(start, end - start));
+          start = end == std::string::npos ? list.size() + 1 : end + 1;
+        }
+      } else {
+        options.corpus = arg;
+      }
+    }
+    if (options.corpus.empty()) {
+      std::fprintf(stderr,
+                   "usage: xsc-bench <corpus> [--mode translate|compare|perf] [--filter <hash>]"
+                   " [--limit <n>] [--seeds <n>] [--size <pixels>] [--translators a,b]\n");
+      return 1;
+    }
+
+    g_fixed_derivatives = options.derivatives == "fixed" && options.mode == "compare";
+    g_render_targets_7e3 = std::getenv("XSC_BENCH_RT_7E3") != nullptr;
+    g_vertex_capture = options.mode == "compare";
+    g_vertex_synthetic = std::getenv("XSC_BENCH_VS_SYNTHETIC") != nullptr;
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    MTLCompileOptions* vertex_options = [MTLCompileOptions new];
+    NSError* error = nil;
+    id<MTLLibrary> vertex_library = [device newLibraryWithSource:@(kVertexSource)
+                                                         options:vertex_options
+                                                           error:&error];
+    id<MTLFunction> vertex_function = [vertex_library newFunctionWithName:@"bench_vertex"];
+    auto spirv_translator = CreateSpirvTranslator();
+    xsc::XscShaderTranslator xsc_translator(xsc::XscShaderTranslator::Target::kMsl,
+                                            BenchSpirvFeatures(), true, BenchResolutionScale(),
+                                            BenchResolutionScale());
+    // XSC_BENCH_DEBUG_COLOR_RANGE: translate with the out-of-range color markers (to check that
+    // they compile; the comparison then differs wherever a marker is painted).
+    xsc_translator.set_debug_color_range(std::getenv("XSC_BENCH_DEBUG_COLOR_RANGE") != nullptr);
+    xsc::XscShaderTranslator xsc_spirv_translator(xsc::XscShaderTranslator::Target::kSpirv,
+                                                  BenchSpirvFeatures(), true,
+                                                  BenchResolutionScale(), BenchResolutionScale());
+
+    std::vector<Variant> variants = LoadVariants(options);
+    std::printf("%zu variants, mode %s, translators", variants.size(), options.mode.c_str());
+    for (const std::string& name : options.translators) {
+      std::printf(" %s", name.c_str());
+    }
+    std::printf("\n");
+
+    struct Totals {
+      uint32_t translated = 0, failed = 0, drawn = 0, compared = 0, mismatched = 0;
+      double translate_ms = 0, compile_ms = 0, gpu_ms = 0;
+      // Draws by the share of the written color values that are not discarded and not NaN, to
+      // know how much the comparisons cover: none, under half, at least half.
+      uint32_t coverage[3] = {};
+    };
+    std::map<std::string, Totals> totals;
+    std::map<uint64_t, std::vector<uint32_t>> ucode_cache;
+    size_t index = 0;
+    for (const Variant& variant : variants) {
+      ++index;
+      if (index % 50 == 0) {
+        std::fprintf(stderr, "\r%zu / %zu", index, variants.size());
+      }
+      auto& ucode = ucode_cache[variant.hash];
+      if (ucode.empty()) {
+        fs::path path = options.corpus / "ucode" /
+                        fmt::format("shader_{:016X}.ucode.bin.{}", variant.hash,
+                                    variant.type == xenos::ShaderType::kVertex ? "vert" : "frag");
+        ucode = ReadUcode(path);
+        if (ucode.empty()) {
+          std::printf("%s: no ucode at %s\n", variant.name.c_str(), path.string().c_str());
+          continue;
+        }
+      }
+      std::vector<Translated> translations;
+      for (const std::string& name : options.translators) {
+        std::optional<Translated> translated =
+            Translate(name, device, *spirv_translator, xsc_translator, xsc_spirv_translator,
+                      variant, ucode);
+        if (!translated) {
+          std::printf("unknown translator %s\n", name.c_str());
+          return 1;
+        }
+        Totals& t = totals[name];
+        if (translated->ok) {
+          ++t.translated;
+          t.translate_ms += translated->translate_ms;
+          t.compile_ms += translated->compile_ms;
+        } else {
+          ++t.failed;
+          std::printf("%s [%s]: %s\n", variant.name.c_str(), name.c_str(),
+                      translated->error.c_str());
+        }
+        translations.push_back(std::move(*translated));
+      }
+      if (options.mode == "translate") {
+        continue;
+      }
+      if (variant.type == xenos::ShaderType::kVertex) {
+        if (options.mode == "perf") {
+          // Pixel shaders only.
+          continue;
+        }
+        // Every translation run for the same vertices with the same inputs, compared with the
+        // first one value by value.
+        uint32_t vertex_count = options.size * options.size;
+        uint32_t stride = VertexCaptureStride(variant.modification);
+        for (uint32_t seed = 0; seed < options.seeds; ++seed) {
+          std::vector<VertexOutput> outputs;
+          for (size_t i = 0; i < translations.size(); ++i) {
+            if (!translations[i].ok) {
+              outputs.emplace_back();
+              continue;
+            }
+            VertexDrawInputs inputs = GenerateVertexInputs(
+                device, translations[0].ok ? translations[0] : translations[i],
+                uint32_t(variant.hash) ^ (seed * 7919));
+            VertexOutput output =
+                DrawVertexShader(device, queue, translations[i], inputs, vertex_count, stride);
+            if (!output.ok) {
+              std::printf("%s [%s] seed %u: %s\n", variant.name.c_str(),
+                          options.translators[i].c_str(), seed, output.error.c_str());
+            } else {
+              Totals& t = totals[options.translators[i]];
+              ++t.drawn;
+              t.gpu_ms += output.gpu_ms;
+            }
+            outputs.push_back(std::move(output));
+          }
+          for (size_t i = 1; i < outputs.size(); ++i) {
+            if (!outputs[0].ok || !outputs[i].ok) {
+              continue;
+            }
+            Totals& t = totals[options.translators[i]];
+            ++t.compared;
+            uint32_t mismatches = 0;
+            std::string first_mismatch;
+            for (size_t j = 0; j < outputs[0].values.size(); ++j) {
+              float a = outputs[0].values[j], v = outputs[i].values[j];
+              if (std::memcmp(&a, &v, sizeof(float)) == 0 || (std::isnan(a) && std::isnan(v)) ||
+                  (a == 0.0f && v == 0.0f)) {
+                continue;
+              }
+              if (!mismatches++) {
+                first_mismatch = fmt::format("vertex {} value {}: {} vs {}", j / stride, j % stride,
+                                             a, v);
+              }
+            }
+            if (mismatches) {
+              ++t.mismatched;
+              std::printf("%s seed %u: %s differs from %s in %u values, first %s\n",
+                          variant.name.c_str(), seed, options.translators[i].c_str(),
+                          options.translators[0].c_str(), mismatches, first_mismatch.c_str());
+            }
+          }
+        }
+        continue;
+      }
+      // Draw every translation with the same inputs and compare each with the first. Seeds whose
+      // inputs make the first translation write no color value (kill instructions and the alpha
+      // test can discard every pixel) are skipped, up to 8 tries per kept seed.
+      if (options.mode == "perf") {
+        // The GPU time of each translation varies a lot from one draw to the next (clocks), so
+        // each one is drawn in 5 rounds alternating the translations, keeping the minimum.
+        DrawInputs inputs = GenerateInputs(
+            device, translations[0].ok ? translations[0] : translations.back(), uint32_t(variant.hash));
+        std::vector<double> best(translations.size(), 0.0);
+        for (uint32_t round = 0; round < 5; ++round) {
+          for (size_t i = 0; i < translations.size(); ++i) {
+            if (!translations[i].ok) {
+              continue;
+            }
+            Output output = DrawPixelShader(device, queue, vertex_function, translations[i],
+                                            inputs, 512, 20);
+            if (output.ok && (!best[i] || output.gpu_ms < best[i])) {
+              best[i] = output.gpu_ms;
+            }
+          }
+        }
+        for (size_t i = 0; i < translations.size(); ++i) {
+          if (!best[i]) {
+            continue;
+          }
+          Totals& t = totals[options.translators[i]];
+          ++t.drawn;
+          t.gpu_ms += best[i];
+          std::printf("perf %s %s %.4f ms\n", variant.name.c_str(), options.translators[i].c_str(),
+                      best[i]);
+        }
+        continue;
+      }
+      uint32_t seeds_wanted = options.seeds;
+      uint32_t seeds_kept = 0;
+      for (uint32_t seed = 0; seeds_kept < seeds_wanted && seed < seeds_wanted * 8; ++seed) {
+        bool last_try = seed + 1 >= seeds_wanted * 8;
+        std::vector<Output> outputs;
+        for (size_t i = 0; i < translations.size(); ++i) {
+          if (!translations[i].ok) {
+            outputs.emplace_back();
+            continue;
+          }
+          DrawInputs inputs = GenerateInputs(device, translations[0].ok ? translations[0]
+                                                                        : translations[i],
+                                             uint32_t(variant.hash) ^ (seed * 7919));
+          Output output = DrawPixelShader(device, queue, vertex_function, translations[i], inputs,
+                                          options.size, 1);
+          if (!output.ok) {
+            std::printf("%s [%s] seed %u: %s\n", variant.name.c_str(),
+                        options.translators[i].c_str(), seed, output.error.c_str());
+            outputs.push_back(std::move(output));
+            continue;
+          }
+          size_t written = 0, total = 0;
+          for (uint32_t rt = 0; rt < 4; ++rt) {
+            if (!(translations[i].writes_color_targets & (1u << rt))) {
+              continue;
+            }
+            for (float value : output.colors[rt]) {
+              ++total;
+              written += value != -12345.0f && !std::isnan(value);
+            }
+          }
+          if (i == 0 && total && !written && !last_try) {
+            // Try other inputs.
+            break;
+          }
+          Totals& t = totals[options.translators[i]];
+          ++t.drawn;
+          t.gpu_ms += output.gpu_ms;
+          if (total) {
+            ++t.coverage[!written ? 0 : (written * 2 < total ? 1 : 2)];
+          }
+          outputs.push_back(std::move(output));
+        }
+        if (outputs.size() != translations.size()) {
+          continue;
+        }
+        ++seeds_kept;
+        if (g_render_targets_7e3 && options.translators[0] == "spirv" && outputs[0].ok) {
+          // The reference translator does not clamp to the render target format.
+          ClampColorsTo7e3(outputs[0]);
+        }
+        for (size_t i = 1; i < outputs.size(); ++i) {
+          if (!outputs[0].ok || !outputs[i].ok) {
+            continue;
+          }
+          Totals& t = totals[options.translators[i]];
+          ++t.compared;
+          std::string first_mismatch;
+          uint32_t mismatches =
+              CompareOutputs(outputs[0], outputs[i], translations[0].writes_color_targets,
+                             translations[0].writes_depth, first_mismatch);
+          if (mismatches && std::getenv("XSC_BENCH_MAP")) {
+            // A map of color 0: '.' equal, 'X' different, 'd' discarded in the first translation
+            // only, 'D' discarded in both.
+            uint32_t size = options.size;
+            for (uint32_t y = 0; y < size; ++y) {
+              std::string line;
+              for (uint32_t x = 0; x < size; ++x) {
+                size_t pixel = (size_t(y) * size + x) * 4;
+                bool discarded_0 = outputs[0].colors[0][pixel] == -12345.0f;
+                bool discarded_i = outputs[i].colors[0][pixel] == -12345.0f;
+                bool different = false;
+                for (uint32_t c = 0; c < 4; ++c) {
+                  float a = outputs[0].colors[0][pixel + c], v = outputs[i].colors[0][pixel + c];
+                  different |= !(std::memcmp(&a, &v, 4) == 0 || (std::isnan(a) && std::isnan(v)) ||
+                                 (a == 0.0f && v == 0.0f));
+                }
+                line += discarded_0 && discarded_i ? 'D'
+                        : discarded_0 != discarded_i ? 'd'
+                        : different ? 'X'
+                                    : '.';
+              }
+              std::printf("  %s\n", line.c_str());
+            }
+          }
+          if (mismatches) {
+            ++t.mismatched;
+            std::printf("%s seed %u: %s differs from %s in %u values, first %s\n",
+                        variant.name.c_str(), seed, options.translators[i].c_str(),
+                        options.translators[0].c_str(), mismatches, first_mismatch.c_str());
+          }
+        }
+      }
+    }
+    std::fprintf(stderr, "\n");
+    for (const std::string& name : options.translators) {
+      const Totals& t = totals[name];
+      std::printf(
+          "%-6s translated %u, failed %u, translation %.1f ms, Metal compilation %.1f ms, drawn %u,"
+          " compared %u, mismatched %u, GPU %.3f ms\n"
+          "       draws with no / under half / at least half of the color values written: %u / %u /"
+          " %u\n",
+          name.c_str(), t.translated, t.failed, t.translate_ms, t.compile_ms, t.drawn, t.compared,
+          t.mismatched, t.gpu_ms, t.coverage[0], t.coverage[1], t.coverage[2]);
+    }
+  }
+  return 0;
+}
diff --git a/src/graphics/pipeline/shader/xsc/xsc_builder.h b/src/graphics/pipeline/shader/xsc/xsc_builder.h
new file mode 100644
index 0000000..5148592
--- /dev/null
+++ b/src/graphics/pipeline/shader/xsc/xsc_builder.h
@@ -0,0 +1,381 @@
+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_builder.h
+ * @brief       Builds the XSC IR: values, variables and structured control flow
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstring>
+#include <initializer_list>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <rex/assert.h>
+
+#include "xsc_ir.h"
+
+namespace rex::graphics::xsc {
+
+class Builder {
+ public:
+  explicit Builder(Program& program) : program_(program) { frames_.emplace_back(); }
+
+  Program& program() { return program_; }
+  Type TypeOf(ValueId value) const {
+    assert_true(value != kNoValue && value <= program_.value_types.size());
+    return program_.value_types[value - 1];
+  }
+
+  // Constants.
+  ValueId Constant(Type type, std::array<uint32_t, 4> bits) {
+    Instruction instruction;
+    instruction.op = Op::kConstant;
+    instruction.type = type;
+    instruction.imm = bits;
+    return Emit(std::move(instruction));
+  }
+  ValueId ConstFloat(float value, uint8_t components = 1) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    return Constant(kFloat.WithComponents(components), {bits, bits, bits, bits});
+  }
+  ValueId ConstFloats(std::initializer_list<float> values) {
+    std::array<uint32_t, 4> bits = {};
+    uint8_t count = 0;
+    for (float value : values) {
+      std::memcpy(&bits[count++], &value, sizeof(uint32_t));
+    }
+    return Constant(kFloat.WithComponents(count), bits);
+  }
+  ValueId ConstUint(uint32_t value, uint8_t components = 1) {
+    return Constant(kUint.WithComponents(components), {value, value, value, value});
+  }
+  ValueId ConstInt(int32_t value, uint8_t components = 1) {
+    return Constant(kInt.WithComponents(components),
+                    {uint32_t(value), uint32_t(value), uint32_t(value), uint32_t(value)});
+  }
+  ValueId ConstBool(bool value, uint8_t components = 1) {
+    uint32_t bits = value ? 1 : 0;
+    return Constant(kBool.WithComponents(components), {bits, bits, bits, bits});
+  }
+  // Whether the value is a constant, and its bits.
+  bool IsConstant(ValueId value, std::array<uint32_t, 4>* bits_out = nullptr) const {
+    auto it = constants_.find(value);
+    if (it == constants_.end()) {
+      return false;
+    }
+    if (bits_out) {
+      *bits_out = it->second;
+    }
+    return true;
+  }
+
+  // Variables.
+  VariableId CreateVariable(Type type, const char* name, uint32_t array_size = 0,
+                            Storage storage = Storage::kFunction, uint32_t location = 0,
+                            ValueId initializer = kNoValue) {
+    Variable variable;
+    variable.type = type;
+    variable.name = name;
+    variable.array_size = array_size;
+    variable.storage = storage;
+    variable.location = location;
+    variable.initializer = initializer;
+    program_.variables.push_back(std::move(variable));
+    return VariableId(program_.variables.size());
+  }
+  const Variable& GetVariable(VariableId variable) const {
+    return program_.variables[variable - 1];
+  }
+  ValueId Load(VariableId variable, ValueId dynamic_index = kNoValue, uint32_t constant_index = 0) {
+    Instruction instruction;
+    instruction.op = Op::kLoadVariable;
+    instruction.type = GetVariable(variable).type;
+    instruction.variable = variable;
+    instruction.operands.push_back(dynamic_index);
+    instruction.imm[0] = constant_index;
+    return Emit(std::move(instruction));
+  }
+  void Store(VariableId variable, ValueId value, ValueId dynamic_index = kNoValue,
+             uint32_t constant_index = 0) {
+    assert_true(TypeOf(value) == GetVariable(variable).type);
+    Instruction instruction;
+    instruction.op = Op::kStoreVariable;
+    instruction.variable = variable;
+    instruction.operands.push_back(value);
+    instruction.operands.push_back(dynamic_index);
+    instruction.imm[0] = constant_index;
+    Emit(std::move(instruction));
+  }
+
+  // Generic operations.
+  ValueId Emit(Op op, Type type, std::initializer_list<ValueId> operands,
+               std::array<uint32_t, 4> imm = {}) {
+    Instruction instruction;
+    instruction.op = op;
+    instruction.type = type;
+    instruction.operands.assign(operands.begin(), operands.end());
+    instruction.imm = imm;
+    return Emit(std::move(instruction));
+  }
+  ValueId EmitWithOperands(Op op, Type type, std::vector<ValueId> operands,
+                           std::array<uint32_t, 4> imm = {}) {
+    Instruction instruction;
+    instruction.op = op;
+    instruction.type = type;
+    instruction.operands = std::move(operands);
+    instruction.imm = imm;
+    return Emit(std::move(instruction));
+  }
+  // An operation with no result (stores, kills).
+  void EmitVoid(Op op, std::initializer_list<ValueId> operands = {},
+                std::array<uint32_t, 4> imm = {}) {
+    Instruction instruction;
+    instruction.op = op;
+    instruction.operands.assign(operands.begin(), operands.end());
+    instruction.imm = imm;
+    Emit(std::move(instruction));
+  }
+
+  // Shorthands with the result type of the first operand.
+  ValueId Unary(Op op, ValueId a) { return Emit(op, TypeOf(a), {a}); }
+  ValueId Binary(Op op, ValueId a, ValueId b) { return Emit(op, TypeOf(a), {a, b}); }
+  ValueId Compare(Op op, ValueId a, ValueId b) {
+    return Emit(op, kBool.WithComponents(TypeOf(a).components), {a, b});
+  }
+  ValueId Select(ValueId condition, ValueId a, ValueId b) {
+    return Emit(Op::kSelect, TypeOf(a), {condition, a, b});
+  }
+  ValueId Extract(ValueId vector, uint32_t component) {
+    if (TypeOf(vector).components == 1) {
+      assert_zero(component);
+      return vector;
+    }
+    return Emit(Op::kExtract, TypeOf(vector).Scalar(), {vector}, {component});
+  }
+  // A vector of the components of `vector` at `indices` (a scalar for one index).
+  ValueId Swizzle(ValueId vector, const std::vector<uint32_t>& indices) {
+    assert_true(!indices.empty() && indices.size() <= 4);
+    if (indices.size() == 1) {
+      return Extract(vector, indices[0]);
+    }
+    std::array<uint32_t, 4> imm = {};
+    for (size_t i = 0; i < indices.size(); ++i) {
+      imm[i] = indices[i];
+    }
+    return Emit(Op::kShuffle, TypeOf(vector).WithComponents(uint8_t(indices.size())),
+                {vector, vector}, imm);
+  }
+  ValueId Construct(Type type, std::vector<ValueId> components) {
+    if (components.size() == 1 && TypeOf(components[0]) == type) {
+      return components[0];
+    }
+    return EmitWithOperands(Op::kConstruct, type, std::move(components));
+  }
+  // Replicates a scalar to a vector of the given component count.
+  ValueId Smear(ValueId scalar, uint8_t components) {
+    if (components == 1) {
+      return scalar;
+    }
+    std::array<uint32_t, 4> bits;
+    if (IsConstant(scalar, &bits)) {
+      return Constant(TypeOf(scalar).WithComponents(components), {bits[0], bits[0], bits[0], bits[0]});
+    }
+    return Construct(TypeOf(scalar).WithComponents(components),
+                     std::vector<ValueId>(components, scalar));
+  }
+
+  // Whether the current body has ended with break, continue or kill, so code added after it is
+  // unreachable.
+  bool IsTerminated() const { return frames_.back().terminated; }
+  void Break() { AddControl(Node::Kind::kBreak); }
+  void Continue() { AddControl(Node::Kind::kContinue); }
+  void Kill() {
+    EmitVoid(Op::kKill);
+    frames_.back().terminated = true;
+  }
+
+  // if (condition) { ... } else { ... }.
+  class If {
+   public:
+    If(Builder& builder, ValueId condition, uint8_t likely = 0) : builder_(builder) {
+      Node node;
+      node.kind = Node::Kind::kIf;
+      node.condition = condition;
+      node.likely = likely;
+      node.bodies.resize(2);
+      builder_.PushFrame(std::move(node));
+    }
+    void BeginElse() {
+      assert_false(in_else_);
+      builder_.SwitchFrameBody(1);
+      in_else_ = true;
+    }
+    void End() {
+      assert_false(ended_);
+      node_location_ = builder_.PopFrame();
+      ended_ = true;
+    }
+    // The value of `then_value` if the then branch was taken, `else_value` otherwise.
+    ValueId MergePhi(ValueId then_value, ValueId else_value) {
+      assert_true(ended_);
+      return builder_.AddPhi(node_location_, builder_.TypeOf(then_value), {then_value, else_value});
+    }
+
+   private:
+    Builder& builder_;
+    bool in_else_ = false;
+    bool ended_ = false;
+    std::pair<size_t, size_t> node_location_;
+  };
+
+  // for (;;) { ... } left with Break.
+  void BeginLoop() {
+    Node node;
+    node.kind = Node::Kind::kLoop;
+    node.bodies.resize(1);
+    PushFrame(std::move(node));
+  }
+  void EndLoop() { PopFrame(); }
+
+  // switch (selector) { case literal: ... default: ... }.
+  class Switch {
+   public:
+    Switch(Builder& builder, ValueId selector) : builder_(builder) {
+      Node node;
+      node.kind = Node::Kind::kSwitch;
+      node.condition = selector;
+      node.bodies.resize(1);
+      builder_.PushFrame(std::move(node));
+      builder_.frames_.back().current_case = SIZE_MAX;
+    }
+    // Starts a case; the default (body 0) is used until the first case.
+    void BeginCase(int32_t literal, bool falls_through = false) {
+      builder_.BeginSwitchCase(literal, falls_through);
+    }
+    void BeginDefault() { builder_.BeginSwitchDefault(); }
+    void End() { node_location_ = builder_.PopFrame(); }
+    // One value per case in order, then the default's.
+    ValueId MergePhi(std::vector<ValueId> sources) {
+      return builder_.AddPhi(node_location_, builder_.TypeOf(sources[0]), std::move(sources));
+    }
+
+   private:
+    Builder& builder_;
+    std::pair<size_t, size_t> node_location_;
+  };
+
+ private:
+  struct Frame {
+    Body body;
+    // The pending control node whose bodies this frame fills (not used by the root frame).
+    Node node;
+    size_t current_body = 0;
+    size_t current_case = SIZE_MAX;
+    bool terminated = false;
+  };
+
+  ValueId NewValue(Type type) {
+    program_.value_types.push_back(type);
+    return ValueId(program_.value_types.size());
+  }
+
+  ValueId Emit(Instruction instruction) {
+    bool has_result = instruction.op != Op::kStoreVariable && instruction.op != Op::kDemote &&
+                      instruction.op != Op::kKill && instruction.op != Op::kDebugCount;
+    if (has_result) {
+      instruction.result = NewValue(instruction.type);
+      if (instruction.op == Op::kConstant) {
+        constants_[instruction.result] = instruction.imm;
+      }
+    }
+    ValueId result = instruction.result;
+    Node node;
+    node.kind = Node::Kind::kInstruction;
+    node.instruction = std::move(instruction);
+    CurrentBody().push_back(std::move(node));
+    return result;
+  }
+
+  void AddControl(Node::Kind kind) {
+    Node node;
+    node.kind = kind;
+    CurrentBody().push_back(std::move(node));
+    frames_.back().terminated = true;
+  }
+
+  Body& CurrentBody() { return frames_.back().body; }
+
+  void PushFrame(Node node) {
+    Frame frame;
+    frame.node = std::move(node);
+    frames_.push_back(std::move(frame));
+  }
+  // Moves the body being built into the pending node.
+  void FlushFrameBody() {
+    Frame& frame = frames_.back();
+    if (frame.node.kind == Node::Kind::kSwitch && frame.current_case != SIZE_MAX) {
+      frame.node.cases[frame.current_case].body = std::move(frame.body);
+      frame.node.cases[frame.current_case].terminated = frame.terminated;
+    } else {
+      frame.node.bodies[frame.current_body] = std::move(frame.body);
+      frame.node.bodies_terminated.resize(frame.node.bodies.size());
+      frame.node.bodies_terminated[frame.current_body] = frame.terminated;
+    }
+    frame.body.clear();
+    frame.terminated = false;
+  }
+  void SwitchFrameBody(size_t body_index) {
+    FlushFrameBody();
+    frames_.back().current_body = body_index;
+  }
+  void BeginSwitchCase(int32_t literal, bool falls_through) {
+    FlushFrameBody();
+    Frame& frame = frames_.back();
+    SwitchCase switch_case;
+    switch_case.literal = literal;
+    switch_case.falls_through = falls_through;
+    frame.node.cases.push_back(std::move(switch_case));
+    frame.current_case = frame.node.cases.size() - 1;
+  }
+  void BeginSwitchDefault() {
+    FlushFrameBody();
+    Frame& frame = frames_.back();
+    frame.current_case = SIZE_MAX;
+    frame.current_body = 0;
+  }
+  // Closes the frame and appends its node to the parent body; returns where the node is.
+  std::pair<size_t, size_t> PopFrame() {
+    FlushFrameBody();
+    Node node = std::move(frames_.back().node);
+    frames_.pop_back();
+    Body& parent = frames_.back().body;
+    parent.push_back(std::move(node));
+    return {frames_.size() - 1, parent.size() - 1};
+  }
+  ValueId AddPhi(std::pair<size_t, size_t> location, Type type, std::vector<ValueId> sources) {
+    Phi phi;
+    phi.result = NewValue(type);
+    phi.type = type;
+    phi.sources = std::move(sources);
+    frames_[location.first].body[location.second].phis.push_back(phi);
+    return phi.result;
+  }
+
+  Program& program_;
+  std::vector<Frame> frames_;
+  std::unordered_map<ValueId, std::array<uint32_t, 4>> constants_;
+
+ public:
+  // The root body, once every construct is closed.
+  Body TakeBody() {
+    assert_true(frames_.size() == 1);
+    return std::move(frames_.back().body);
+  }
+};
+
+}  // namespace rex::graphics::xsc
diff --git a/src/graphics/pipeline/shader/xsc/xsc_ir.h b/src/graphics/pipeline/shader/xsc/xsc_ir.h
new file mode 100644
index 0000000..6d2d864
--- /dev/null
+++ b/src/graphics/pipeline/shader/xsc/xsc_ir.h
@@ -0,0 +1,333 @@
+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_ir.h
+ * @brief       Intermediate representation of the Xenos shader compiler (XSC)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * The IR is the common part of the compiler: the Xenos semantics of a shader (the arithmetic
+ * rules, the control flow, fetches and exports) are lowered into it once, and each emitter (MSL
+ * for Metal, SPIR-V for Vulkan) writes every IR operation as one statement or instruction of its
+ * language. Values are immutable and typed; storage that changes (the Xenos registers, the
+ * predicate, the address registers, the outputs) is held in variables that are loaded and stored.
+ * Control flow is structured: if, loop and switch nodes, with phi values where a value comes from
+ * either branch, and break and continue.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace rex::graphics::xsc {
+
+enum class ScalarType : uint8_t { kBool, kInt, kUint, kFloat };
+
+struct Type {
+  ScalarType scalar = ScalarType::kFloat;
+  // 1 for scalars, 2-4 for vectors.
+  uint8_t components = 1;
+
+  constexpr Type() = default;
+  constexpr Type(ScalarType scalar_type, uint8_t component_count = 1)
+      : scalar(scalar_type), components(component_count) {}
+  bool operator==(const Type& other) const {
+    return scalar == other.scalar && components == other.components;
+  }
+  bool operator!=(const Type& other) const { return !(*this == other); }
+  Type WithComponents(uint8_t component_count) const { return Type(scalar, component_count); }
+  Type Scalar() const { return Type(scalar, 1); }
+};
+
+constexpr Type kBool(ScalarType::kBool), kInt(ScalarType::kInt), kUint(ScalarType::kUint),
+    kFloat(ScalarType::kFloat);
+constexpr Type kFloat2(ScalarType::kFloat, 2), kFloat3(ScalarType::kFloat, 3),
+    kFloat4(ScalarType::kFloat, 4), kUint4(ScalarType::kUint, 4), kInt4(ScalarType::kInt, 4),
+    kBool2(ScalarType::kBool, 2), kBool3(ScalarType::kBool, 3), kBool4(ScalarType::kBool, 4);
+
+using ValueId = uint32_t;
+constexpr ValueId kNoValue = 0;
+using VariableId = uint32_t;
+
+enum class Op : uint16_t {
+  // imm[0..3]: the bits of each component.
+  kConstant,
+
+  // operand 0: the dynamic array index (or kNoValue), imm[0]: the constant index.
+  kLoadVariable,
+  // operand 0: the value, operand 1: the dynamic array index (or kNoValue), imm[0]: the constant
+  // index. No result.
+  kStoreVariable,
+
+  // Uniform buffer words: imm[0] is the dword index in the buffer, the result a uint.
+  kLoadSystemConstantWord,
+  kLoadBoolLoopConstantWord,
+  kLoadFetchConstantWord,
+  // operand 0: the float4 index in the float constants of the stage (int). Result float4.
+  kLoadFloatConstant,
+
+  // Fragment shader inputs. kLoadInterpolator: imm[0] the input location, imm[1] 1 if centroid.
+  kLoadInterpolator,
+  kLoadFragCoord,
+  kLoadFrontFacing,
+  kLoadPointCoord,
+  // Vertex shader input: the host vertex index as a uint.
+  kLoadVertexIndex,
+  // operand 0: the dword index (int or uint) in the shared memory (the guest memory). Result uint.
+  kLoadSharedMemoryWord,
+
+  // Float arithmetic, per component. The emitters keep each one as a separate operation, so the
+  // host compiler does not fuse or reorder them.
+  kFAdd,
+  kFSub,
+  kFMul,
+  kFDiv,
+  kFNeg,
+  // Vector times a scalar (operand 1).
+  kVectorTimesScalar,
+  kFAbs,
+  // Minimum and maximum returning the non-NaN operand (GLSL.std.450 NMin and NMax), clamp with
+  // NaN flushed to the low bound (NClamp).
+  kNMin,
+  kNMax,
+  kNClamp,
+  kFloor,
+  kTrunc,
+  kFract,
+  kExp2,
+  kLog2,
+  kInverseSqrt,
+  kSqrt,
+  kSin,
+  kCos,
+  // operand 0 * 2^operand 1 (int).
+  kLdexp,
+  // Dot product of two vectors (GLSL dot, SPIR-V OpDot).
+  kDot,
+  // uint operand 0 to the float2 of its two float16 halves (GLSL unpackHalf2x16).
+  kUnpackHalf2x16,
+
+  // Comparisons with bool results, per component.
+  kFOrdEqual,
+  kFOrdNotEqual,
+  kFUnordNotEqual,
+  kFOrdLessThan,
+  kFOrdLessThanEqual,
+  kFOrdGreaterThan,
+  kFOrdGreaterThanEqual,
+  kIEqual,
+  kINotEqual,
+  kULessThan,
+  kUGreaterThanEqual,
+
+  kLogicalAnd,
+  kLogicalOr,
+  kLogicalNot,
+  // Whether any component of a bool vector is true.
+  kAny,
+
+  // operand 0: bool condition (scalar or per component), operands 1 and 2: the values.
+  kSelect,
+
+  // Integer arithmetic and bit operations.
+  kIAdd,
+  kISub,
+  kIMul,
+  kShiftLeftLogical,
+  kShiftRightLogical,
+  kBitwiseAnd,
+  kBitwiseOr,
+  kBitwiseXor,
+  // operands: value, offset, count (uint).
+  kBitFieldUExtract,
+  kBitFieldSExtract,
+  // operands: base, insert, offset, count.
+  kBitFieldInsert,
+  kUMin,
+  kUMax,
+  kSMin,
+  kSMax,
+  kUMod,
+
+  kConvertFToS,
+  kConvertFToU,
+  kConvertSToF,
+  kConvertUToF,
+  kBitcast,
+
+  // Composites. kConstruct: operands are the components (scalars or vectors, in order).
+  kConstruct,
+  // operand 0: the vector, imm[0]: the component.
+  kExtract,
+  // operand 0, operand 1: vectors, imm[i]: the component of the concatenation of both for each
+  // result component (SPIR-V OpVectorShuffle).
+  kShuffle,
+  // operand 0: the vector, operand 1: the scalar, imm[0]: the component.
+  kInsert,
+
+  kDpdxCoarse,
+  kDpdyCoarse,
+
+  // Texture sampling, result float4. operand 0: coordinates (float2 for 2D arrays without the
+  // layer... see TextureSample), operand 1: LOD or gradient X, operand 2: gradient Y.
+  // imm[0]: texture binding, imm[1]: sampler binding, imm[2]: TextureSampleMode, imm[3]:
+  // TextureDimension.
+  kTextureSample,
+
+  // Discards the fragment and keeps it running as a helper for derivatives (demote).
+  kDemote,
+  // Discards the fragment and stops it.
+  kKill,
+
+  // Debugging aid: if operand 0 (bool) is true, increments the counter imm[0] of the shader's
+  // slot (Program::debug_counter_slot) in the debug counter buffer. No result.
+  kDebugCount,
+};
+
+// How kTextureSample takes its level of detail.
+enum class TextureSampleMode : uint32_t { kLod, kGradients };
+
+// The host texture type a sample reads.
+enum class TextureDimension : uint32_t {
+  // Coordinates float3: XY and the layer.
+  k2DArray,
+  // Coordinates float3.
+  k3D,
+  // Coordinates float3 (direction).
+  kCube,
+};
+
+struct Instruction {
+  Op op;
+  Type type;
+  // The value it defines, or kNoValue.
+  ValueId result = kNoValue;
+  std::vector<ValueId> operands;
+  std::array<uint32_t, 4> imm = {};
+  VariableId variable = 0;
+};
+
+// Storage of variables.
+enum class Storage : uint8_t {
+  kFunction,
+  // Fragment color output imm (location in Variable::location).
+  kOutputColor,
+  kOutputDepth,
+  kOutputSampleMask,
+  // Vertex outputs: interpolators, the point size and the point coordinates at Variable::location,
+  // the position, and the clip distances (an array).
+  kOutputInterpolator,
+  kOutputPointSize,
+  kOutputPointCoordinates,
+  kOutputPosition,
+  kOutputClipDistance,
+};
+
+struct Variable {
+  Type type;
+  // 0 for a single value, otherwise the element count of an array of `type`.
+  uint32_t array_size = 0;
+  Storage storage = Storage::kFunction;
+  uint32_t location = 0;
+  std::string name;
+  // Initial value of every element (a constant), or kNoValue for none.
+  ValueId initializer = kNoValue;
+};
+
+struct Node;
+using Body = std::vector<Node>;
+
+// A value chosen by the branch the control flow came from (SPIR-V OpPhi).
+struct Phi {
+  ValueId result;
+  Type type;
+  // For if: { then value, else value }; for switch: one per case, then the default.
+  std::vector<ValueId> sources;
+};
+
+struct SwitchCase {
+  int32_t literal;
+  Body body;
+  // Whether the case falls through into the next one instead of leaving the switch.
+  bool falls_through = false;
+  // Whether the body ends with break, continue or kill.
+  bool terminated = false;
+};
+
+struct Node {
+  enum class Kind : uint8_t {
+    kInstruction,
+    // condition: value; bodies[0]: then, bodies[1]: else; phis.
+    kIf,
+    // An infinite loop left by break.
+    kLoop,
+    // selector: value; cases; bodies[0]: the default; phis.
+    kSwitch,
+    // Leaves the innermost loop or switch.
+    kBreak,
+    // Goes to the next iteration of the innermost loop.
+    kContinue,
+  };
+  Kind kind = Kind::kInstruction;
+  Instruction instruction;
+  ValueId condition = kNoValue;
+  std::vector<Body> bodies;
+  // Per body: whether it ends with break, continue or kill.
+  std::vector<uint8_t> bodies_terminated;
+  std::vector<SwitchCase> cases;
+  std::vector<Phi> phis;
+  // Optional hint for if: 1 if the then branch is more likely, 2 if the else branch is.
+  uint8_t likely = 0;
+};
+
+// What a pixel shader writes, for the interface of the emitted function.
+struct FragmentInterface {
+  // Interpolators in input location order: the Xenos interpolator indices.
+  std::vector<uint32_t> interpolators;
+  uint32_t interpolators_centroid = 0;
+  bool frag_coord = false;
+  bool front_facing = false;
+  bool point_coord = false;
+  uint32_t color_targets = 0;
+  bool depth = false;
+  bool sample_mask = false;
+  bool early_fragment_tests = false;
+};
+
+// What a vertex shader writes, for the interface of the emitted function (the outputs themselves
+// are the variables with vertex output storage).
+struct VertexInterface {
+  // The clip distances written (the array size of the kOutputClipDistance variable).
+  uint32_t clip_distance_count = 0;
+};
+
+// A texture or sampler binding the emitted code reads, in the order of the shader's bindings.
+struct TextureBindingInfo {
+  uint32_t fetch_constant;
+  TextureDimension dimension;
+  bool is_signed;
+};
+
+struct Program {
+  bool is_pixel_shader = true;
+  std::string entry_point;
+  FragmentInterface fragment;
+  VertexInterface vertex;
+  std::vector<TextureBindingInfo> textures;
+  uint32_t sampler_count = 0;
+  // float4 elements of the float constant buffer of the stage (at least 1).
+  uint32_t float_constant_count = 1;
+  // The first counter of the shader in the debug counter buffer used by kDebugCount, or
+  // UINT32_MAX if the shader does not count.
+  uint32_t debug_counter_slot = UINT32_MAX;
+
+  std::vector<Variable> variables;  // VariableId is the index + 1.
+  // Types of the values (ValueId is the index + 1).
+  std::vector<Type> value_types;
+  Body body;
+};
+
+}  // namespace rex::graphics::xsc
diff --git a/src/graphics/pipeline/shader/xsc/xsc_msl.cpp b/src/graphics/pipeline/shader/xsc/xsc_msl.cpp
new file mode 100644
index 0000000..1c0bb7f
--- /dev/null
+++ b/src/graphics/pipeline/shader/xsc/xsc_msl.cpp
@@ -0,0 +1,812 @@
+/**
+ * @file        graphics/pipeline/shader/xsc/xsc_msl.cpp
+ * @brief       MSL emitter of the Xenos shader compiler
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * Writes every IR operation as one MSL statement into a local constant, so the Metal compiler
+ * cannot fuse a multiplication and an addition (it only contracts within an expression with
+ * MTLMathModeSafe, measured on an M4) and the results match the Xenos rules bit for bit. The
+ * interface is the one the Metal backend binds for the SPIR-V translator's shaders: buffer 0 the
+ * shared memory, 1-5 the constant buffers, textures and samplers in binding order, and the vertex
+ * outputs named as SPIRV-Cross names them. A vertex shader has a second entry point, with the
+ * name suffixed by _norast, for pipelines without rasterization (returning nothing, as Metal
+ * requires there).
+ */
+
+#include "xsc_msl.h"
+
+#include <cmath>
+#include <cstring>
+
+#include <fmt/format.h>
+
+#include <rex/assert.h>
+
+namespace rex::graphics::xsc {
+
+namespace {
+
+// The Metal backend's argument table indices (metal_pipeline_cache.h, MetalCommandProcessor).
+constexpr uint32_t kBufferSystemConstants = 1;
+constexpr uint32_t kBufferFloatConstantsVertex = 2;
+constexpr uint32_t kBufferFloatConstantsPixel = 3;
+constexpr uint32_t kBufferBoolLoopConstants = 4;
+constexpr uint32_t kBufferFetchConstants = 5;
+// The debug counters of kDebugCount (MetalCommandProcessor, xsc_debug_color_range).
+constexpr uint32_t kBufferDebugCounters = 6;
+
+const char* ScalarName(ScalarType scalar) {
+  switch (scalar) {
+    case ScalarType::kBool:
+      return "bool";
+    case ScalarType::kInt:
+      return "int";
+    case ScalarType::kUint:
+      return "uint";
+    case ScalarType::kFloat:
+      return "float";
+  }
+  return "float";
+}
+
+std::string TypeName(Type type) {
+  if (type.components == 1) {
+    return ScalarName(type.scalar);
+  }
+  return fmt::format("{}{}", ScalarName(type.scalar), type.components);
+}
+
+std::string FloatLiteral(uint32_t bits) {
+  float value;
+  std::memcpy(&value, &bits, sizeof(value));
+  if (std::isnan(value)) {
+    return "NAN";
+  }
+  if (std::isinf(value)) {
+    return value < 0 ? "(-INFINITY)" : "INFINITY";
+  }
+  if (value == 0.0f) {
+    return std::signbit(value) ? "(-0.0)" : "0.0";
+  }
+  // 9 significant digits round-trip every float exactly.
+  std::string text = fmt::format("{:.9g}", value);
+  if (text.find_first_of(".e") == std::string::npos) {
+    text += ".0";
+  }
+  return value < 0 ? "(" + text + ")" : text;
+}
+
+std::string ScalarLiteral(ScalarType scalar, uint32_t bits) {
+  switch (scalar) {
+    case ScalarType::kBool:
+      return bits ? "true" : "false";
+    case ScalarType::kInt:
+      if (int32_t(bits) == INT32_MIN) {
+        return "int(0x80000000u)";
+      }
+      return int32_t(bits) < 0 ? fmt::format("({})", int32_t(bits)) : fmt::format("{}", int32_t(bits));
+    case ScalarType::kUint:
+      return fmt::format("{}u", bits);
+    case ScalarType::kFloat:
+      return FloatLiteral(bits);
+  }
+  return "0";
+}
+
+const char* kComponentNames = "xyzw";
+
+class Emitter {
+ public:
+  explicit Emitter(const Program& program) : program_(program) {
+    constants_.resize(program.value_types.size() + 1, nullptr);
+    CollectConstants(program.body);
+  }
+
+  std::string Emit() {
+    out_ +=
+        "#include <metal_stdlib>\n"
+        "using namespace metal;\n\n";
+    if (!program_.is_pixel_shader) {
+      return EmitVertex();
+    }
+    WriteFragmentHeader();
+    WriteLocals();
+    WriteBody(program_.body, 1);
+    out_ += "    return out;\n}\n";
+    return std::move(out_);
+  }
+
+ private:
+  void CollectConstants(const Body& body) {
+    for (const Node& node : body) {
+      if (node.kind == Node::Kind::kInstruction && node.instruction.op == Op::kConstant) {
+        constants_[node.instruction.result] = &node.instruction;
+      }
+      for (const Body& child : node.bodies) {
+        CollectConstants(child);
+      }
+      for (const SwitchCase& switch_case : node.cases) {
+        CollectConstants(switch_case.body);
+      }
+    }
+  }
+
+  // A value as an expression: constants inline, everything else by name.
+  std::string Value(ValueId value) const {
+    assert_true(value != kNoValue);
+    const Instruction* constant = constants_[value];
+    if (!constant) {
+      return fmt::format("v{}", value);
+    }
+    Type type = constant->type;
+    if (type.components == 1) {
+      return ScalarLiteral(type.scalar, constant->imm[0]);
+    }
+    std::string text = TypeName(type) + "(";
+    for (uint32_t i = 0; i < type.components; ++i) {
+      text += (i ? ", " : "") + ScalarLiteral(type.scalar, constant->imm[i]);
+    }
+    return text + ")";
+  }
+
+  Type TypeOf(ValueId value) const { return program_.value_types[value - 1]; }
+
+  std::string VariableName(VariableId variable_id) const {
+    const Variable& variable = program_.variables[variable_id - 1];
+    switch (variable.storage) {
+      case Storage::kFunction:
+        return variable.name;
+      case Storage::kOutputColor:
+        return fmt::format("out.xe_out_fragment_data_{}", variable.location);
+      case Storage::kOutputDepth:
+        return "out.gl_FragDepth";
+      case Storage::kOutputSampleMask:
+        return "out.gl_SampleMask";
+      case Storage::kOutputInterpolator:
+      case Storage::kOutputPointSize:
+      case Storage::kOutputPointCoordinates:
+      case Storage::kOutputPosition:
+      case Storage::kOutputClipDistance:
+        // Vertex outputs are named in their variables, as SPIRV-Cross names them.
+        return "out." + variable.name;
+    }
+    return variable.name;
+  }
+
+  // The parameters with the buffers, textures and samplers, as the Metal backend binds them.
+  std::vector<std::string> ResourceParameters() const {
+    std::vector<std::string> parameters;
+    parameters.push_back("const device uint* xe_shared_memory [[buffer(0)]]");
+    parameters.push_back(
+        fmt::format("constant uint4* xe_system [[buffer({})]]", kBufferSystemConstants));
+    parameters.push_back(fmt::format(
+        "constant float4* xe_float_constants [[buffer({})]]",
+        program_.is_pixel_shader ? kBufferFloatConstantsPixel : kBufferFloatConstantsVertex));
+    parameters.push_back(
+        fmt::format("constant uint4* xe_bool_loop [[buffer({})]]", kBufferBoolLoopConstants));
+    parameters.push_back(
+        fmt::format("constant uint4* xe_fetch [[buffer({})]]", kBufferFetchConstants));
+    if (program_.debug_counter_slot != UINT32_MAX) {
+      parameters.push_back(fmt::format("device atomic_uint* xe_debug_counters [[buffer({})]]",
+                                       kBufferDebugCounters));
+    }
+    for (size_t i = 0; i < program_.textures.size(); ++i) {
+      const char* type = "texture2d_array<float>";
+      if (program_.textures[i].dimension == TextureDimension::k3D) {
+        type = "texture3d<float>";
+      } else if (program_.textures[i].dimension == TextureDimension::kCube) {
+        type = "texturecube<float>";
+      }
+      parameters.push_back(fmt::format("{} xe_texture{} [[texture({})]]", type, i, i));
+    }
+    for (uint32_t i = 0; i < program_.sampler_count; ++i) {
+      parameters.push_back(fmt::format("sampler xe_sampler{} [[sampler({})]]", i, i));
+    }
+    return parameters;
+  }
+
+  static std::string JoinParameters(const std::vector<std::string>& parameters) {
+    std::string text;
+    for (size_t i = 0; i < parameters.size(); ++i) {
+      text += (i ? ",\n        " : "") + parameters[i];
+    }
+    return text;
+  }
+
+  std::string EmitVertex() {
+    // The outputs.
+    out_ += "struct XeVertexOut {\n";
+    for (const Variable& variable : program_.variables) {
+      switch (variable.storage) {
+        case Storage::kOutputInterpolator:
+        case Storage::kOutputPointSize:
+        case Storage::kOutputPointCoordinates:
+          out_ += fmt::format("    {} {} [[user(locn{})]];\n", TypeName(variable.type),
+                              variable.name, variable.location);
+          break;
+        case Storage::kOutputPosition:
+          out_ += fmt::format("    float4 {} [[position]];\n", variable.name);
+          break;
+        case Storage::kOutputClipDistance:
+          out_ += fmt::format("    float {} [[clip_distance]] [{}];\n", variable.name,
+                              variable.array_size);
+          break;
+        default:
+          break;
+      }
+    }
+    out_ += "};\n\n";
+    std::vector<std::string> parameters = {"uint gl_VertexIndex [[vertex_id]]"};
+    std::vector<std::string> resources = ResourceParameters();
+    parameters.insert(parameters.end(), resources.begin(), resources.end());
+    std::string parameter_text = JoinParameters(parameters);
+    // The body, shared by both entry points.
+    std::string head = std::move(out_);
+    out_.clear();
+    out_ += "    XeVertexOut out = {};\n";
+    WriteLocals();
+    WriteBody(program_.body, 1);
+    std::string body = std::move(out_);
+    out_ = std::move(head);
+    // The SPIR-V shaders follow Vulkan clip space, where -Y is the top: flipped for Metal as
+    // SPIRV-Cross does for the SPIR-V translator's vertex shaders.
+    out_ += fmt::format(
+        "vertex XeVertexOut {}({})\n{{\n{}    out.gl_Position.y = -(out.gl_Position.y);\n"
+        "    return out;\n}}\n\n",
+        program_.entry_point, parameter_text, body);
+    // Flipped there too, like SPIRV-Cross, though nothing reads it.
+    out_ += fmt::format(
+        "vertex void {}_norast({})\n{{\n{}    out.gl_Position.y = -(out.gl_Position.y);\n}}\n",
+        program_.entry_point, parameter_text, body);
+    return std::move(out_);
+  }
+
+  void WriteFragmentHeader() {
+    const FragmentInterface& fragment = program_.fragment;
+    // Inputs.
+    out_ += "struct XeIn {\n";
+    for (size_t i = 0; i < fragment.interpolators.size(); ++i) {
+      uint32_t interpolator = fragment.interpolators[i];
+      out_ += fmt::format("    float4 xe_in_interpolator_{} [[user(locn{})]]{};\n", interpolator,
+                          i,
+                          (fragment.interpolators_centroid & (1u << interpolator))
+                              ? " [[centroid_perspective]]"
+                              : "");
+    }
+    if (fragment.point_coord) {
+      out_ += fmt::format("    float2 xe_in_point_coordinates [[user(locn{})]];\n",
+                          fragment.interpolators.size());
+    }
+    if (fragment.interpolators.empty() && !fragment.point_coord) {
+      // Metal needs a member in the stage-in struct only when there are inputs.
+    }
+    out_ += "};\n\n";
+    // Outputs.
+    out_ += "struct XeOut {\n";
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (fragment.color_targets & (1u << i)) {
+        out_ += fmt::format("    float4 xe_out_fragment_data_{} [[color({})]];\n", i, i);
+      }
+    }
+    if (fragment.depth) {
+      out_ += "    float gl_FragDepth [[depth(any)]];\n";
+    }
+    if (fragment.sample_mask) {
+      out_ += "    uint gl_SampleMask [[sample_mask]];\n";
+    }
+    if (!fragment.color_targets && !fragment.depth && !fragment.sample_mask) {
+      out_ += "    float4 xe_unused [[color(0)]];\n";
+    }
+    out_ += "};\n\n";
+
+    if (fragment.early_fragment_tests) {
+      out_ += "[[early_fragment_tests]] ";
+    }
+    out_ += fmt::format("fragment XeOut {}(", program_.entry_point);
+    std::vector<std::string> parameters;
+    bool has_inputs = !fragment.interpolators.empty() || fragment.point_coord;
+    if (has_inputs) {
+      parameters.push_back("XeIn in [[stage_in]]");
+    }
+    if (fragment.frag_coord) {
+      parameters.push_back("float4 gl_FragCoord [[position]]");
+    }
+    if (fragment.front_facing) {
+      parameters.push_back("bool gl_FrontFacing [[front_facing]]");
+    }
+    std::vector<std::string> resources = ResourceParameters();
+    parameters.insert(parameters.end(), resources.begin(), resources.end());
+    out_ += JoinParameters(parameters);
+    out_ += ")\n{\n";
+    out_ += "    XeOut out = {};\n";
+  }
+
+  // The local variables: the function variables.
+  void WriteLocals() {
+    for (const Variable& variable : program_.variables) {
+      if (variable.storage != Storage::kFunction) {
+        continue;
+      }
+      std::string initializer;
+      if (variable.initializer != kNoValue) {
+        if (variable.array_size) {
+          initializer = " = {";
+          for (uint32_t i = 0; i < variable.array_size; ++i) {
+            initializer += (i ? ", " : "") + Value(variable.initializer);
+          }
+          initializer += "}";
+        } else {
+          initializer = " = " + Value(variable.initializer);
+        }
+      }
+      if (variable.array_size) {
+        out_ += fmt::format("    {} {}[{}]{};\n", TypeName(variable.type), variable.name,
+                            variable.array_size, initializer);
+      } else {
+        out_ += fmt::format("    {} {}{};\n", TypeName(variable.type), variable.name, initializer);
+      }
+    }
+  }
+
+  void Indent(uint32_t depth) { out_.append(size_t(depth) * 4, ' '); }
+
+  void WriteBody(const Body& body, uint32_t depth) {
+    for (const Node& node : body) {
+      WriteNode(node, depth);
+    }
+  }
+
+  void DeclarePhis(const Node& node, uint32_t depth) {
+    for (const Phi& phi : node.phis) {
+      Indent(depth);
+      out_ += fmt::format("{} v{};\n", TypeName(phi.type), phi.result);
+    }
+  }
+  void AssignPhis(const Node& node, size_t source_index, uint32_t depth) {
+    for (const Phi& phi : node.phis) {
+      Indent(depth);
+      out_ += fmt::format("v{} = {};\n", phi.result, Value(phi.sources[source_index]));
+    }
+  }
+
+  void WriteNode(const Node& node, uint32_t depth) {
+    switch (node.kind) {
+      case Node::Kind::kInstruction:
+        WriteInstruction(node.instruction, depth);
+        break;
+      case Node::Kind::kIf: {
+        DeclarePhis(node, depth);
+        Indent(depth);
+        out_ += fmt::format("if ({})\n", Value(node.condition));
+        Indent(depth);
+        out_ += "{\n";
+        WriteBody(node.bodies[0], depth + 1);
+        if (!node.bodies_terminated.empty() && !node.bodies_terminated[0]) {
+          AssignPhis(node, 0, depth + 1);
+        }
+        Indent(depth);
+        out_ += "}\n";
+        bool else_needed = !node.bodies[1].empty() || !node.phis.empty();
+        if (else_needed) {
+          Indent(depth);
+          out_ += "else\n";
+          Indent(depth);
+          out_ += "{\n";
+          WriteBody(node.bodies[1], depth + 1);
+          if (node.bodies_terminated.size() < 2 || !node.bodies_terminated[1]) {
+            AssignPhis(node, 1, depth + 1);
+          }
+          Indent(depth);
+          out_ += "}\n";
+        }
+      } break;
+      case Node::Kind::kLoop:
+        Indent(depth);
+        out_ += "for (;;)\n";
+        Indent(depth);
+        out_ += "{\n";
+        WriteBody(node.bodies[0], depth + 1);
+        Indent(depth);
+        out_ += "}\n";
+        break;
+      case Node::Kind::kSwitch: {
+        DeclarePhis(node, depth);
+        Indent(depth);
+        out_ += fmt::format("switch ({})\n", Value(node.condition));
+        Indent(depth);
+        out_ += "{\n";
+        for (size_t i = 0; i < node.cases.size(); ++i) {
+          const SwitchCase& switch_case = node.cases[i];
+          Indent(depth);
+          out_ += fmt::format("case {}:\n", switch_case.literal);
+          Indent(depth);
+          out_ += "{\n";
+          WriteBody(switch_case.body, depth + 1);
+          if (!switch_case.terminated) {
+            AssignPhis(node, i, depth + 1);
+            if (!switch_case.falls_through) {
+              Indent(depth + 1);
+              out_ += "break;\n";
+            }
+          }
+          Indent(depth);
+          out_ += "}\n";
+        }
+        Indent(depth);
+        out_ += "default:\n";
+        Indent(depth);
+        out_ += "{\n";
+        WriteBody(node.bodies[0], depth + 1);
+        if (node.bodies_terminated.empty() || !node.bodies_terminated[0]) {
+          AssignPhis(node, node.cases.size(), depth + 1);
+          Indent(depth + 1);
+          out_ += "break;\n";
+        }
+        Indent(depth);
+        out_ += "}\n";
+        Indent(depth);
+        out_ += "}\n";
+      } break;
+      case Node::Kind::kBreak:
+        Indent(depth);
+        out_ += "break;\n";
+        break;
+      case Node::Kind::kContinue:
+        Indent(depth);
+        out_ += "continue;\n";
+        break;
+    }
+  }
+
+  // Declares the result of an instruction with the expression.
+  void Define(const Instruction& instruction, uint32_t depth, const std::string& expression) {
+    Indent(depth);
+    out_ += fmt::format("{} v{} = {};\n", TypeName(instruction.type), instruction.result,
+                        expression);
+  }
+
+  static const char* BinaryOperator(Op op) {
+    switch (op) {
+      case Op::kFAdd:
+      case Op::kIAdd:
+        return "+";
+      case Op::kFSub:
+      case Op::kISub:
+        return "-";
+      case Op::kFMul:
+      case Op::kVectorTimesScalar:
+      case Op::kIMul:
+        return "*";
+      case Op::kFDiv:
+        return "/";
+      case Op::kFOrdEqual:
+      case Op::kIEqual:
+        return "==";
+      case Op::kFUnordNotEqual:
+      case Op::kINotEqual:
+        return "!=";
+      case Op::kFOrdLessThan:
+      case Op::kULessThan:
+        return "<";
+      case Op::kFOrdLessThanEqual:
+        return "<=";
+      case Op::kFOrdGreaterThan:
+        return ">";
+      case Op::kFOrdGreaterThanEqual:
+      case Op::kUGreaterThanEqual:
+        return ">=";
+      case Op::kLogicalAnd:
+        return "&&";
+      case Op::kLogicalOr:
+        return "||";
+      case Op::kShiftLeftLogical:
+        return "<<";
+      case Op::kShiftRightLogical:
+        return ">>";
+      case Op::kBitwiseAnd:
+        return "&";
+      case Op::kBitwiseOr:
+        return "|";
+      case Op::kBitwiseXor:
+        return "^";
+      case Op::kUMod:
+        return "%";
+      default:
+        return nullptr;
+    }
+  }
+
+  static const char* Function(Op op) {
+    switch (op) {
+      case Op::kFAbs:
+        return "abs";
+      case Op::kNMin:
+        return "precise::min";
+      case Op::kNMax:
+        return "precise::max";
+      case Op::kNClamp:
+        return "precise::clamp";
+      case Op::kFloor:
+        return "floor";
+      case Op::kTrunc:
+        return "trunc";
+      case Op::kFract:
+        return "fract";
+      case Op::kExp2:
+        return "exp2";
+      case Op::kLog2:
+        return "log2";
+      case Op::kInverseSqrt:
+        return "rsqrt";
+      case Op::kSqrt:
+        return "sqrt";
+      case Op::kSin:
+        return "sin";
+      case Op::kCos:
+        return "cos";
+      case Op::kLdexp:
+        return "ldexp";
+      case Op::kAny:
+        return "any";
+      case Op::kBitFieldUExtract:
+      case Op::kBitFieldSExtract:
+        return "extract_bits";
+      case Op::kBitFieldInsert:
+        return "insert_bits";
+      case Op::kUMin:
+      case Op::kSMin:
+        return "min";
+      case Op::kSMax:
+      case Op::kUMax:
+        return "max";
+      case Op::kDot:
+        return "dot";
+      case Op::kDpdxCoarse:
+        return "dfdx";
+      case Op::kDpdyCoarse:
+        return "dfdy";
+      default:
+        return nullptr;
+    }
+  }
+
+  // Bit field offsets and counts are uint in MSL.
+  std::string UintOperand(ValueId value) const {
+    if (TypeOf(value).scalar == ScalarType::kUint) {
+      return Value(value);
+    }
+    return fmt::format("uint({})", Value(value));
+  }
+
+  void WriteInstruction(const Instruction& instruction, uint32_t depth) {
+    const std::vector<ValueId>& operands = instruction.operands;
+    if (const char* op = BinaryOperator(instruction.op)) {
+      Define(instruction, depth,
+             fmt::format("{} {} {}", Value(operands[0]), op, Value(operands[1])));
+      return;
+    }
+    switch (instruction.op) {
+      case Op::kConstant:
+        // Written inline where used.
+        return;
+      case Op::kLoadVariable: {
+        std::string name = VariableName(instruction.variable);
+        const Variable& variable = program_.variables[instruction.variable - 1];
+        if (variable.array_size) {
+          name += operands[0] != kNoValue ? fmt::format("[{}]", Value(operands[0]))
+                                          : fmt::format("[{}]", instruction.imm[0]);
+        }
+        Define(instruction, depth, name);
+      } return;
+      case Op::kStoreVariable: {
+        std::string name = VariableName(instruction.variable);
+        const Variable& variable = program_.variables[instruction.variable - 1];
+        if (variable.array_size) {
+          name += operands[1] != kNoValue ? fmt::format("[{}]", Value(operands[1]))
+                                          : fmt::format("[{}]", instruction.imm[0]);
+        }
+        Indent(depth);
+        if (variable.storage == Storage::kOutputSampleMask) {
+          out_ += fmt::format("{} = as_type<uint>({});\n", name, Value(operands[0]));
+        } else {
+          out_ += fmt::format("{} = {};\n", name, Value(operands[0]));
+        }
+      } return;
+      case Op::kLoadSystemConstantWord:
+        Define(instruction, depth,
+               fmt::format("xe_system[{}].{}", instruction.imm[0] >> 2,
+                           kComponentNames[instruction.imm[0] & 3]));
+        return;
+      case Op::kLoadBoolLoopConstantWord:
+        Define(instruction, depth,
+               fmt::format("xe_bool_loop[{}].{}", instruction.imm[0] >> 2,
+                           kComponentNames[instruction.imm[0] & 3]));
+        return;
+      case Op::kLoadFetchConstantWord:
+        Define(instruction, depth,
+               fmt::format("xe_fetch[{}].{}", instruction.imm[0] >> 2,
+                           kComponentNames[instruction.imm[0] & 3]));
+        return;
+      case Op::kLoadFloatConstant:
+        Define(instruction, depth, fmt::format("xe_float_constants[{}]", Value(operands[0])));
+        return;
+      case Op::kLoadInterpolator:
+        Define(instruction, depth,
+               fmt::format("in.xe_in_interpolator_{}",
+                           program_.fragment.interpolators[instruction.imm[0]]));
+        return;
+      case Op::kLoadFragCoord:
+        Define(instruction, depth, "gl_FragCoord");
+        return;
+      case Op::kLoadFrontFacing:
+        Define(instruction, depth, "gl_FrontFacing");
+        return;
+      case Op::kLoadPointCoord:
+        Define(instruction, depth, "in.xe_in_point_coordinates");
+        return;
+      case Op::kLoadVertexIndex:
+        Define(instruction, depth, "gl_VertexIndex");
+        return;
+      case Op::kLoadSharedMemoryWord:
+        Define(instruction, depth, fmt::format("xe_shared_memory[{}]", Value(operands[0])));
+        return;
+      case Op::kUnpackHalf2x16:
+        Define(instruction, depth, fmt::format("float2(as_type<half2>({}))", Value(operands[0])));
+        return;
+      case Op::kFNeg:
+        Define(instruction, depth, fmt::format("-{}", Value(operands[0])));
+        return;
+      case Op::kLogicalNot:
+        Define(instruction, depth, fmt::format("!{}", Value(operands[0])));
+        return;
+      case Op::kSelect: {
+        Type condition_type = TypeOf(operands[0]);
+        if (condition_type.components == 1 && instruction.type.components == 1) {
+          Define(instruction, depth,
+                 fmt::format("{} ? {} : {}", Value(operands[0]), Value(operands[1]),
+                             Value(operands[2])));
+        } else {
+          std::string condition = Value(operands[0]);
+          if (condition_type.components != instruction.type.components) {
+            condition = fmt::format("bool{}({})", instruction.type.components, condition);
+          }
+          Define(instruction, depth,
+                 fmt::format("select({}, {}, {})", Value(operands[2]), Value(operands[1]),
+                             condition));
+        }
+      } return;
+      case Op::kConvertFToS:
+      case Op::kConvertFToU:
+      case Op::kConvertSToF:
+      case Op::kConvertUToF:
+        Define(instruction, depth,
+               fmt::format("{}({})", TypeName(instruction.type), Value(operands[0])));
+        return;
+      case Op::kBitcast:
+        Define(instruction, depth,
+               fmt::format("as_type<{}>({})", TypeName(instruction.type), Value(operands[0])));
+        return;
+      case Op::kConstruct: {
+        std::string expression = TypeName(instruction.type) + "(";
+        for (size_t i = 0; i < operands.size(); ++i) {
+          expression += (i ? ", " : "") + Value(operands[i]);
+        }
+        Define(instruction, depth, expression + ")");
+      } return;
+      case Op::kExtract:
+        Define(instruction, depth,
+               fmt::format("{}.{}", Value(operands[0]), kComponentNames[instruction.imm[0]]));
+        return;
+      case Op::kShuffle: {
+        uint32_t first_components = TypeOf(operands[0]).components;
+        if (operands[0] == operands[1]) {
+          std::string swizzle;
+          for (uint32_t i = 0; i < instruction.type.components; ++i) {
+            swizzle += kComponentNames[instruction.imm[i] % first_components];
+          }
+          Define(instruction, depth, fmt::format("{}.{}", Value(operands[0]), swizzle));
+        } else {
+          std::string expression = TypeName(instruction.type) + "(";
+          for (uint32_t i = 0; i < instruction.type.components; ++i) {
+            uint32_t index = instruction.imm[i];
+            ValueId source = index < first_components ? operands[0] : operands[1];
+            uint32_t component = index < first_components ? index : index - first_components;
+            std::string component_text =
+                TypeOf(source).components == 1
+                    ? Value(source)
+                    : fmt::format("{}.{}", Value(source), kComponentNames[component]);
+            expression += (i ? ", " : "") + component_text;
+          }
+          Define(instruction, depth, expression + ")");
+        }
+      } return;
+      case Op::kInsert:
+        Indent(depth);
+        out_ += fmt::format("{} v{} = {};\n", TypeName(instruction.type), instruction.result,
+                            Value(operands[0]));
+        Indent(depth);
+        out_ += fmt::format("v{}.{} = {};\n", instruction.result,
+                            kComponentNames[instruction.imm[0]], Value(operands[1]));
+        return;
+      case Op::kTextureSample: {
+        uint32_t texture = instruction.imm[0];
+        uint32_t sampler = instruction.imm[1];
+        auto mode = TextureSampleMode(instruction.imm[2]);
+        auto dimension = TextureDimension(instruction.imm[3]);
+        std::string coordinates = Value(operands[0]);
+        std::string location;
+        std::string options;
+        switch (dimension) {
+          case TextureDimension::k2DArray:
+            location = fmt::format("{}.xy, uint(rint({}.z))", coordinates, coordinates);
+            options = mode == TextureSampleMode::kLod
+                          ? fmt::format("level({})", Value(operands[1]))
+                          : fmt::format("gradient2d({}, {})", Value(operands[1]), Value(operands[2]));
+            break;
+          case TextureDimension::k3D:
+            location = coordinates;
+            options = mode == TextureSampleMode::kLod
+                          ? fmt::format("level({})", Value(operands[1]))
+                          : fmt::format("gradient3d({}, {})", Value(operands[1]), Value(operands[2]));
+            break;
+          case TextureDimension::kCube:
+            location = coordinates;
+            options = mode == TextureSampleMode::kLod
+                          ? fmt::format("level({})", Value(operands[1]))
+                          : fmt::format("gradientcube({}, {})", Value(operands[1]),
+                                        Value(operands[2]));
+            break;
+        }
+        Define(instruction, depth,
+               fmt::format("xe_texture{}.sample(xe_sampler{}, {}, {})", texture, sampler, location,
+                           options));
+      } return;
+      case Op::kDemote:
+        // Since MSL 2.3, discard_fragment demotes the pixel to a helper: it writes nothing but
+        // keeps running for the derivatives of its quad neighbours, as a Xenos kill does, and a
+        // quad discarded entirely stops early.
+        Indent(depth);
+        out_ += "discard_fragment();\n";
+        return;
+      case Op::kKill:
+        Indent(depth);
+        out_ += "discard_fragment();\n";
+        return;
+      case Op::kDebugCount:
+        Indent(depth);
+        out_ += fmt::format(
+            "if ({}) {{ atomic_fetch_add_explicit(&xe_debug_counters[{}], 1u, "
+            "memory_order_relaxed); }}\n",
+            Value(operands[0]), program_.debug_counter_slot + instruction.imm[0]);
+        return;
+      default:
+        break;
+    }
+    if (const char* function = Function(instruction.op)) {
+      std::string expression = std::string(function) + "(";
+      bool bit_field = instruction.op == Op::kBitFieldUExtract ||
+                       instruction.op == Op::kBitFieldSExtract ||
+                       instruction.op == Op::kBitFieldInsert;
+      for (size_t i = 0; i < operands.size(); ++i) {
+        // The offset and the count of the bit field functions are uint.
+        bool uint_operand = bit_field && i + 2 >= operands.size();
+        expression += (i ? ", " : "") + (uint_operand ? UintOperand(operands[i]) : Value(operands[i]));
+      }
+      Define(instruction, depth, expression + ")");
+      return;
+    }
+    assert_unhandled_case(instruction.op);
+  }
+
+  const Program& program_;
+  std::vector<const Instruction*> constants_;
+  std::string out_;
+};
+
+}  // namespace
+
+std::string EmitMsl(const Program& program) { return Emitter(program).Emit(); }
+
+}  // namespace rex::graphics::xsc
