@@ -69,6 +69,7 @@ int RunWindowedApp(int argc, char** argv) {
     result = app->OnInitialize() ? app_context.RunMainMessageLoop() : EXIT_FAILURE;
 
     app->InvokeOnDestroy();
+    result = app_context.GetExitCode(result);
   }
 
