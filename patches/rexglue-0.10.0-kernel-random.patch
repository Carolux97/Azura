 }
 
+// Random bytes from a per-thread generator seeded by the host. Titles use XeCryptRandom and
+// XNetRandom for GUIDs, nonces and keys, which must differ between calls and between consoles.
+void FillRandomBytes(void* buffer, uint32_t length) {
+  thread_local std::mt19937_64 generator{[] {
+    std::random_device device;
+    return (uint64_t(device()) << 32) | device();
+  }()};
+  auto* bytes = static_cast<uint8_t*>(buffer);
+  for (uint32_t i = 0; i < length; i += 8) {
+    const uint64_t value = generator();
+    std::memcpy(bytes + i, &value, std::min<uint32_t>(8, length - i));
+  }
+}
+
 void XeCryptRandom_entry(mapped_void buf, u32 buf_size) {
-  std::memset(buf, 0xFD, buf_size);
+  if (REXCVAR_GET(kernel_deterministic_random)) {
+    std::memset(buf, 0xFD, buf_size);
+    return;
+  }
+  FillRandomBytes(buf, buf_size);
 }
 
