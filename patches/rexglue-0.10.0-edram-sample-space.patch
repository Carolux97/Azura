   virtual Path GetPath() const = 0;
 
+  // Sample-space render targets (edram_sample_space, host render target path only): every host
+  // render target texel is one EDRAM sample, as the EDRAM itself stores multisampled surfaces
+  // (twice as tall with 2x MSAA, also twice as wide with 4x). Host render targets are then
+  // single-sampled and keyed without the MSAA mode, so using the same EDRAM region with 1x, 2x
+  // and 4x MSAA needs no transfer, and draws to multisampled surfaces rasterize every sample as
+  // a host pixel.
+  bool IsSampleSpace() const;
+  // Backends that only implement sample-space render targets (Metal) use them regardless of the
+  // setting.
+  virtual bool IsSampleSpaceRequired() const { return false; }
+  // MSAA mode of the host render target for a guest one.
+  xenos::MsaaSamples GetHostMsaaSamples(xenos::MsaaSamples guest_msaa_samples) const {
+    return IsSampleSpace() ? xenos::MsaaSamples::k1X : guest_msaa_samples;
+  }
+  // log2 of the host pixels per guest pixel on each axis for the current guest MSAA mode, 0 when
+  // not in sample space.
+  uint32_t GetSampleSpaceXLog2(xenos::MsaaSamples guest_msaa_samples) const {
+    return IsSampleSpace() && guest_msaa_samples >= xenos::MsaaSamples::k4X ? 1 : 0;
+  }
+  uint32_t GetSampleSpaceYLog2(xenos::MsaaSamples guest_msaa_samples) const {
+    return IsSampleSpace() && guest_msaa_samples >= xenos::MsaaSamples::k2X ? 1 : 0;
+  }
+
