+// Hash of the running rexglue executable. The generated code depends on the generator's builders
+// and analysis as much as on its inputs, so a rebuilt generator must not find its old output up
+// to date. Computed once per run.
+const std::string& GeneratorHash() {
+  static const std::string hash = [] {
+    std::filesystem::path executable = rex::filesystem::GetExecutablePath();
+    std::string digest = executable.empty() ? std::string() : rex::hash_file(executable);
+    if (digest.empty()) {
+      // Without it the stamp could keep stale output: make every run regenerate instead.
+      REXCODEGEN_WARN("Could not hash the rexglue executable; codegen will not skip modules");
+      digest = fmt::format("<unknown:{}>",
+                           std::chrono::steady_clock::now().time_since_epoch().count());
+    }
+    return digest;
+  }();
+  return hash;
+}
